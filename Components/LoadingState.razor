<div class="app-loading-card" role="status" aria-live="polite">
    <div class="app-loading-content">
        <div class="app-loading-icon" aria-hidden="true">
            <span class="app-loading-spinner"></span>
        </div>
        <strong>@Title</strong>
        <span>@Message</span>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Cargando información";
    [Parameter] public string Message { get; set; } = "Preparando los datos solicitados.";
}
