@inject SessionStateService Session
@inject IAuthService AuthService
@inject NavigationManager Navigation

@if (_evaluando)
{
    <LayoutView Layout="typeof(Layout.MainLayout)">
        <p class="p-4 text-muted" role="status">Verificando acceso...</p>
    </LayoutView>
}
else if (_esPublica || _autorizado)
{
    <RouteView RouteData="RouteData" DefaultLayout="typeof(Layout.MainLayout)" />
}
else if (!_autenticado)
{
    <RedirectToLogin />
}
else
{
    <LayoutView Layout="typeof(Layout.MainLayout)">
        <div class="alert alert-danger m-4" role="alert">
            No tienes permiso para acceder a este módulo.
        </div>
    </LayoutView>
}

@code {
    [Parameter, EditorRequired]
    public RouteData RouteData { get; set; } = default!;

    private bool _evaluando = true;
    private bool _esPublica;
    private bool _autenticado;
    private bool _autorizado;

    protected override async Task OnParametersSetAsync()
    {
        _evaluando = true;
        _esPublica = EsPaginaPublica(RouteData.PageType);
        _autenticado = _esPublica || Session.ValidateAndTouch();
        _autorizado = _esPublica || (_autenticado && await AuthService.TieneAccesoRutaAsync(Navigation.ToBaseRelativePath(Navigation.Uri)));
        _evaluando = false;
    }

    private static bool EsPaginaPublica(Type pageType) => pageType == typeof(Pages.Landing)
        || pageType == typeof(Pages.Login)
        || pageType == typeof(Pages.OlvideContrasena)
        || pageType == typeof(Pages.RecuperarContrasena)
        || pageType == typeof(Pages.Registro)
        || pageType == typeof(Pages.Error);
}
