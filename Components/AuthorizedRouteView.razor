@using System.Reflection
@inject SessionStateService Session
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<AuthorizedRouteView> Logger

@if (_esPublica || _autorizado)
{
    <CascadingValue Value="_permisos">
        <RouteView RouteData="RouteData" DefaultLayout="typeof(Layout.MainLayout)" />
    </CascadingValue>
}
else if (!_autenticado)
{
    <RedirectToLogin />
}
else
{
    <CascadingValue Value="_permisos">
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="alert alert-danger m-4" role="alert">
                @(_errorPermisos ? "No se pudieron verificar los permisos. Vuelva a intentar." : "No tienes permiso para acceder a este módulo.")
            </div>
        </LayoutView>
    </CascadingValue>
}

@code {
    [Parameter, EditorRequired]
    public RouteData RouteData { get; set; } = default!;

    private int _revision;
    private bool _esPublica;
    private bool _autenticado;
    private bool _autorizado;
    private bool _errorPermisos;
    private PermisosNavegacion _permisos = new(0, []);

    protected override async Task OnParametersSetAsync()
    {
        var revision = ++_revision;
        var esPublica = EsPaginaPublica(RouteData.PageType);
        var ruta = RutaDePermiso();
        if (!esPublica)
            await Session.RestoreAsync();

        if (revision != _revision) return;

        _esPublica = esPublica;
        _autenticado = esPublica || Session.ValidateAndTouch();
        if (!_esPublica && !_autenticado)
        {
            _autorizado = false;
            return;
        }

        var autenticado = _autenticado;
        var permisos = new PermisosNavegacion(0, []);
        var errorPermisos = false;
        if (!esPublica && autenticado)
        {
            try
            {
                permisos = await AuthService.ObtenerPermisosNavegacionAsync(ruta);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "No se pudieron verificar los permisos para {Ruta}", ruta);
                errorPermisos = true;
            }
        }

        if (revision != _revision) return;

        _esPublica = esPublica;
        _autenticado = autenticado;
        _permisos = permisos;
        _errorPermisos = errorPermisos;
        _autorizado = esPublica || permisos.Permite(ruta);
    }

    private string RutaDePermiso()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        var segmentos = ruta.Split('/');
        foreach (var atributo in RouteData.PageType.GetCustomAttributes<RouteAttribute>())
        {
            var plantilla = atributo.Template.Trim('/').Split('/');
            int parametro = Array.FindIndex(plantilla, parte => parte.StartsWith('{'));
            if (parametro <= 0 || plantilla.Length != segmentos.Length)
                continue;

            if (plantilla.Take(parametro).SequenceEqual(segmentos.Take(parametro), StringComparer.OrdinalIgnoreCase))
                return string.Join("/", plantilla.Take(parametro));
        }
        return ruta;
    }

    private static bool EsPaginaPublica(Type pageType) => pageType == typeof(Pages.Landing)
        || pageType == typeof(Pages.Login)
        || pageType == typeof(Pages.OlvideContrasena)
        || pageType == typeof(Pages.RecuperarContrasena)
        || pageType == typeof(Pages.Registro)
        || pageType == typeof(Pages.Error);
}
