@page "/hospitalizacion/ficha"
@page "/hospitalizacion/ficha/{IdOrden:int}/{Nhcl:int}"
@inject IKardexService KardexService
@inject IHospitalizacionService HospService
@inject IBusinessCentralService BcService
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject IJSRuntime JS

<PageTitle>Ficha de Hospitalización 24h — e-ForVets</PageTitle>

<div class="container-fluid py-3">
    <!-- BARRA DE SELECCIÓN DE PACIENTE Y ACCIONES -->
    <div class="card shadow-sm border-0 mb-3 no-print">
        <div class="card-body py-2 px-3 bg-light rounded">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-bold mb-1 text-primary">Buscar Paciente Hospitalizado (Pre-Ficha):</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" placeholder="Nombre mascota, propietario o NHCL..."
                               @bind="_filtroOrden" @bind:event="oninput" />
                        <button class="btn btn-outline-primary" @onclick="BuscarOrdenesAsync">Buscar</button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">Seleccionar Orden:</label>
                    <select class="form-select form-select-sm" value="@IdOrden" @onchange="OnOrdenChangedAsync">
                        <option value="0">-- Seleccione Paciente --</option>
                        @foreach (var ord in _ordenesActivas)
                        {
                            <option value="@ord.IdOrdenAtencion">#@ord.IdOrdenAtencion | NHCL:@ord.Nhcl - @ord.Paciente (@ord.Cliente)</option>
                        }
                    </select>
                </div>
                <div class="col-md-5 text-end pt-3">
                    @if (_paciente is not null)
                    {
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-primary fw-semibold" @onclick="GuardarFichaAsync" disabled="@(_guardando || _sheet.Cerrada)">
                                💾 @(_guardando ? "Guardando..." : "Guardar Hoja")
                            </button>
                            <button class="btn btn-outline-primary" @onclick="NuevaHojaAsync" disabled="@_sheet.Cerrada">
                                ➕ Nueva Hoja
                            </button>
                            <button class="btn btn-outline-warning text-dark" @onclick="CerrarFichaAsync" disabled="@_sheet.Cerrada">
                                🔒 Cerrar Ficha
                            </button>
                            <button class="btn btn-danger" @onclick="ExportarPdfAsync">
                                📄 PDF
                            </button>
                            <button class="btn btn-success" @onclick="ExportarExcelAsync">
                                📊 Excel
                            </button>
                            <button class="btn btn-dark" @onclick="ImprimirVistaAsync">
                                🖨️ Imprimir
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensajeAlerta))
    {
        <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small no-print">
            @_mensajeAlerta
            <button type="button" class="btn-close py-2" @onclick="() => _mensajeAlerta = null"></button>
        </div>
    }

    @if (_cargandoInicial)
    {
        <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="fw-semibold small">Cargando Ficha de Hospitalización 24h...</span>
        </div>
    }
    else if (_paciente is null)
    {
        <div class="alert alert-info shadow-sm">
            Seleccione un paciente en la parte superior para abrir su <strong>Ficha de Hospitalización 24 Horas (Medicación, Alimentación y Fluidoterapia)</strong>.
        </div>
    }
    else
    {
        <div id="area-impresion-ficha">
            <!-- CABECERA DEL PACIENTE Y METADATOS DE LA HOJA -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-primary text-white py-2 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold">🏥 FICHA DE HOSPITALIZACIÓN 24 HORAS</span>
                        @if (_sheet.Cerrada)
                        {
                            <span class="badge bg-danger ms-2">FICHA CERRADA</span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small">N° Hoja:</span>
                        <select class="form-select form-select-sm w-auto bg-white text-dark fw-bold"
                                value="@_sheet.Hoja" @onchange="CambiarHojaAsync">
                            @foreach (var h in _sheet.HojasDisponibles)
                            {
                                <option value="@h">Hoja #@h</option>
                            }
                        </select>
                        <a href="/hospitalizacion/monitoreo/@IdOrden/@Nhcl" class="btn btn-sm btn-warning fw-semibold no-print">
                            🩺 Ir a Monitoreo 24h
                        </a>
                    </div>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="row text-center small g-2 align-items-center">
                        <div class="col-md-2 border-end">
                            <div class="text-muted">Historia / Orden</div>
                            <div class="fw-bold text-danger fs-6">@_paciente.Nhcl <span class="text-secondary">(#@_paciente.OrdenAtencionId)</span></div>
                        </div>
                        <div class="col-md-2 border-end">
                            <div class="text-muted">Paciente / Especie</div>
                            <div class="fw-bold">@_paciente.PacienteNombre <span class="text-success">(@_paciente.Especie)</span></div>
                        </div>
                        <div class="col-md-2 border-end">
                            <div class="text-muted">Propietario</div>
                            <div class="fw-semibold">@_paciente.ClienteNombre</div>
                        </div>
                        <div class="col-md-2 border-end">
                            <label class="text-muted d-block">Condición Clínica</label>
                            <select class="form-select form-select-sm" @bind="_sheet.CondicionId" disabled="@_sheet.Cerrada">
                                <option value="">-- Seleccione --</option>
                                @foreach (var c in _condiciones)
                                {
                                    <option value="@c.Id">@c.Condicion</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-1 border-end">
                            <label class="text-muted d-block">Peso (kg)</label>
                            <input type="number" step="0.1" class="form-control form-control-sm text-center fw-bold"
                                   @bind="_sheet.Peso" disabled="@_sheet.Cerrada" />
                        </div>
                        <div class="col-md-1 border-end">
                            <label class="text-muted d-block">Día Hosp.</label>
                            <input type="number" class="form-control form-control-sm text-center fw-bold"
                                   @bind="_sheet.DiasHospitalizacion" disabled="@_sheet.Cerrada" />
                        </div>
                        <div class="col-md-2">
                            <label class="text-muted d-block">Fecha Hoja</label>
                            <input type="date" class="form-control form-control-sm text-center"
                                   @bind="_sheet.Fecha" disabled="@_sheet.Cerrada" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- BUSCADOR RÁPIDO DE FÁRMACOS / INSUMOS BC PARA ASIGNAR A FILAS -->
            <div class="card shadow-sm border-0 mb-3 no-print">
                <div class="card-body py-2 px-3 bg-secondary bg-opacity-10">
                    <div class="row g-2 align-items-center small">
                        <div class="col-md-4">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text fw-bold">🔎 Catálogo BC:</span>
                                <input type="text" class="form-control" placeholder="Buscar fármaco, alimento o fluido..."
                                       @bind="_busquedaBc" />
                                <button class="btn btn-primary" @onclick="BuscarCatalogoBcAsync">Buscar</button>
                            </div>
                        </div>
                        @if (_resultadosBc.Count > 0)
                        {
                            <div class="col-md-8">
                                <div class="d-flex gap-2 align-items-center">
                                    <select class="form-select form-select-sm" @bind="_productoBcSeleccionado">
                                        @foreach (var p in _resultadosBc)
                                        {
                                            <option value="@p.DisplayName">@p.DisplayName (Stock: @p.Inventory @p.BaseUnitOfMeasureCode | $@p.UnitPrice)</option>
                                        }
                                    </select>
                                    <button class="btn btn-sm btn-outline-primary text-nowrap" @onclick="AsignarProductoABloque1">
                                        ➕ A Medicación
                                    </button>
                                    <button class="btn btn-sm btn-outline-success text-nowrap" @onclick="AsignarProductoABloque2">
                                        ➕ A Alimentación
                                    </button>
                                    <button class="btn btn-sm btn-outline-info text-dark text-nowrap" @onclick="AsignarProductoABloque3">
                                        ➕ A Fluidoterapia
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- BLOQUE 1: MEDICACIÓN (12 FILAS X 24 HORAS: 07h..24h, 01h..06h) -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-indigo text-white py-1 px-3" style="background-color:#1e3a8a;">
                    <span class="fw-bold small">1. MEDICACIÓN — PRINCIPIO ACTIVO, DOSIS Y MATRIZ HORARIA (07:00 A 06:00)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size: 0.74rem;">
                        <thead class="table-light">
                            <tr>
                                <th style="width:28px;">#</th>
                                <th style="min-width:170px;">Principio Activo / Medicamento</th>
                                <th style="width:62px;">mg/kg</th>
                                <th style="width:58px;">ml</th>
                                <th style="min-width:85px;">Vía</th>
                                <th style="min-width:90px;">Ritmo</th>
                                @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                {
                                    <th class="@(hr >= 19 || hr <= 6 ? "bg-dark text-white" : "bg-info bg-opacity-25")" style="min-width:34px;">@hr</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _sheet.Bloque1Medicacion)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">@row.Fila</td>
                                    <td class="p-1">
                                        <input type="text" class="form-control form-control-sm px-1 py-0"
                                               @bind="row.Medicacion" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="number" step="0.01" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.MgKg" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="number" step="0.01" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.Ml" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <select class="form-select form-select-sm px-1 py-0" @bind="row.Via" disabled="@_sheet.Cerrada">
                                            <option value="">-</option>
                                            @foreach (var v in _vias)
                                            {
                                                <option value="@v.Id">@v.Via</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="p-1">
                                        <select class="form-select form-select-sm px-1 py-0" @bind="row.Ritmo" disabled="@_sheet.Cerrada">
                                            <option value="">-</option>
                                            @foreach (var rt in _ritmos)
                                            {
                                                <option value="@rt.Id">@rt.Des_Ritmo</option>
                                            }
                                        </select>
                                    </td>
                                    @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                    {
                                        int hLocal = hr;
                                        <td class="p-0">
                                            <input type="text" class="form-control form-control-sm border-0 px-0 py-1 text-center fw-bold"
                                                   style="font-size:0.72rem;"
                                                   value="@row.GetValorHora(hLocal)"
                                                   @onchange="e => row.SetValorHora(hLocal, e.Value?.ToString())"
                                                   disabled="@_sheet.Cerrada" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- BLOQUE 2: ALIMENTACIÓN (5 FILAS X 24 HORAS) -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-success text-white py-1 px-3">
                    <span class="fw-bold small">2. ALIMENTACIÓN — CÁLCULO CALÓRICO Y MATRIZ HORARIA (07:00 A 06:00)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size: 0.74rem;">
                        <thead class="table-light">
                            <tr>
                                <th style="width:28px;">#</th>
                                <th style="min-width:170px;">Alimentación / Dieta</th>
                                <th style="width:62px;">Kcal/d</th>
                                <th style="width:58px;">Kcal/v</th>
                                <th style="min-width:85px;">gr</th>
                                <th style="min-width:90px;">Ritmo</th>
                                @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                {
                                    <th class="@(hr >= 19 || hr <= 6 ? "bg-dark text-white" : "bg-success bg-opacity-25")" style="min-width:34px;">@hr</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _sheet.Bloque2Alimentacion)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">@row.Fila</td>
                                    <td class="p-1">
                                        <input type="text" class="form-control form-control-sm px-1 py-0"
                                               @bind="row.Alimentacion" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="number" step="0.1" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.Cald" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="number" step="0.1" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.Calv" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="text" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.Gr" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <select class="form-select form-select-sm px-1 py-0" @bind="row.Ritmo" disabled="@_sheet.Cerrada">
                                            <option value="">-</option>
                                            @foreach (var rt in _ritmos)
                                            {
                                                <option value="@rt.Id">@rt.Des_Ritmo</option>
                                            }
                                        </select>
                                    </td>
                                    @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                    {
                                        int hLocal = hr;
                                        <td class="p-0">
                                            <input type="text" class="form-control form-control-sm border-0 px-0 py-1 text-center fw-bold"
                                                   style="font-size:0.72rem;"
                                                   value="@row.GetValorHora(hLocal)"
                                                   @onchange="e => row.SetValorHora(hLocal, e.Value?.ToString())"
                                                   disabled="@_sheet.Cerrada" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- BLOQUE 3: FLUIDOTERAPIA (7 FILAS X 24 HORAS) -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-info text-dark py-1 px-3">
                    <span class="fw-bold small">3. FLUIDOTERAPIA — INFUSIÓN CONTINUA Y MATRIZ HORARIA (07:00 A 06:00)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size: 0.74rem;">
                        <thead class="table-light">
                            <tr>
                                <th style="width:28px;">#</th>
                                <th style="min-width:170px;">Fluido / Solución</th>
                                <th style="width:62px;">M+P+D</th>
                                <th style="width:58px;">ml/día</th>
                                <th style="min-width:85px;">ml/h</th>
                                <th style="min-width:90px;">gotas/min</th>
                                @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                {
                                    <th class="@(hr >= 19 || hr <= 6 ? "bg-dark text-white" : "bg-info bg-opacity-25")" style="min-width:34px;">@hr</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _sheet.Bloque3Fluidoterapia)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">@row.Fila</td>
                                    <td class="p-1">
                                        <input type="text" class="form-control form-control-sm px-1 py-0"
                                               @bind="row.Fluidoterapia" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="text" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.Mpd" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="text" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.MlDia" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="text" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.MlH" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="text" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.Gotas" disabled="@_sheet.Cerrada" />
                                    </td>
                                    @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                    {
                                        int hLocal = hr;
                                        <td class="p-0">
                                            <input type="text" class="form-control form-control-sm border-0 px-0 py-1 text-center fw-bold"
                                                   style="font-size:0.72rem;"
                                                   value="@row.GetValorHora(hLocal)"
                                                   @onchange="e => row.SetValorHora(hLocal, e.Value?.ToString())"
                                                   disabled="@_sheet.Cerrada" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- BLOQUE 4: NOTAS IMPORTANTES Y OBSERVACIONES DE HOSPITALIZACIÓN -->
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-warning bg-opacity-25 py-1 px-3 fw-bold small text-dark">
                            ⚠️ ALERTAS Y NOTAS IMPORTANTES
                        </div>
                        <div class="card-body p-2">
                            <div class="input-group input-group-sm mb-2 no-print">
                                <input type="text" class="form-control" placeholder="Agregar nota importante..."
                                       @bind="_nuevaNotaImportante" disabled="@_sheet.Cerrada" />
                                <button class="btn btn-warning fw-semibold" @onclick='() => AgregarNotaAsync("I")' disabled="@_sheet.Cerrada">
                                    Agregar
                                </button>
                            </div>
                            <table class="table table-sm table-striped small mb-0">
                                <thead>
                                    <tr>
                                        <th>Fecha / Hora</th>
                                        <th>Importante</th>
                                        <th class="no-print"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var n in _sheet.NotasImportantes)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@n.Fecha.ToString("yyyy-MM-dd") @n.Hora</td>
                                            <td class="fw-semibold text-danger">@n.Observacion</td>
                                            <td class="text-end no-print">
                                                <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => EliminarNotaAsync(n.Id)">✕</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-secondary bg-opacity-25 py-1 px-3 fw-bold small text-dark">
                            📝 OBSERVACIONES CLÍNICAS DE LA FICHA
                        </div>
                        <div class="card-body p-2">
                            <div class="input-group input-group-sm mb-2 no-print">
                                <input type="text" class="form-control" placeholder="Agregar observación clínica..."
                                       @bind="_nuevaObservacion" disabled="@_sheet.Cerrada" />
                                <button class="btn btn-secondary" @onclick='() => AgregarNotaAsync("O")' disabled="@_sheet.Cerrada">
                                    Agregar
                                </button>
                            </div>
                            <table class="table table-sm table-striped small mb-0">
                                <thead>
                                    <tr>
                                        <th>Fecha / Hora</th>
                                        <th>Observación</th>
                                        <th class="no-print"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var n in _sheet.ObservacionesGenerales)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@n.Fecha.ToString("yyyy-MM-dd") @n.Hora</td>
                                            <td>@n.Observacion</td>
                                            <td class="text-end no-print">
                                                <button class="btn btn-link btn-sm text-danger p-0" @onclick="() => EliminarNotaAsync(n.Id)">✕</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }

    private string _filtroOrden = string.Empty;
    private List<OrdenActivaResumenDto> _ordenesActivas = [];
    private PacienteHeaderDto? _paciente;
    private FichaHospitalizacionSheetDto _sheet = new();

    private List<ViaAdministracionDto> _vias = [];
    private List<RitmoHorarioDto> _ritmos = [];
    private List<CondicionHospitalDto> _condiciones = [];

    private string _busquedaBc = string.Empty;
    private List<FarmacoStockDto> _resultadosBc = [];
    private string _productoBcSeleccionado = string.Empty;

    private string _nuevaNotaImportante = string.Empty;
    private string _nuevaObservacion = string.Empty;
    private bool _cargandoInicial = true;
    private bool _guardando;
    private string? _mensajeAlerta;
    private bool _esError;

    protected override async Task OnInitializedAsync()
    {
        _cargandoInicial = true;
        await Task.Yield();
        var tVias = KardexService.ObtenerViasAdministracionAsync();
        var tRitmos = HospService.ObtenerRitmosHorariosAsync();
        var tCond = HospService.ObtenerCondicionesAsync();
        var tOrd = KardexService.ObtenerOrdenesActivasAsync();
        await Task.WhenAll(tVias, tRitmos, tCond, tOrd);

        _vias = await tVias;
        _ritmos = await tRitmos;
        _condiciones = await tCond;
        _ordenesActivas = await tOrd;

        if (IdOrden <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
        {
            IdOrden = Session.OrdenActiva.Value;
            Nhcl = Session.NhclActivo ?? 0;
        }
        else if (IdOrden <= 0 && _ordenesActivas.Count > 0)
        {
            var primera = _ordenesActivas[0];
            IdOrden = primera.IdOrdenAtencion;
            Nhcl = primera.Nhcl;
        }

        if (IdOrden > 0)
        {
            await CargarFichaCompletaAsync(IdOrden, Nhcl, 1);
        }
        _cargandoInicial = false;
    }

    private async Task BuscarOrdenesAsync()
    {
        _ordenesActivas = await KardexService.ObtenerOrdenesActivasAsync(_filtroOrden);
    }

    private async Task OnOrdenChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idOrd) && idOrd > 0)
        {
            var ord = _ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == idOrd);
            if (ord is not null)
            {
                IdOrden = ord.IdOrdenAtencion;
                Nhcl = ord.Nhcl;
                await CargarFichaCompletaAsync(IdOrden, Nhcl, 1);
            }
        }
    }

    private async Task CargarFichaCompletaAsync(int idOrden, int nhcl, int hoja)
    {
        var tPac = KardexService.ObtenerCabeceraPacienteAsync(idOrden, nhcl);
        var tSheet = HospService.CargarFichaHospitalizacionAsync(idOrden, nhcl, hoja, Session.IdUser);
        await Task.WhenAll(tPac, tSheet);

        _paciente = await tPac;
        if (_paciente is not null)
        {
            Nhcl = _paciente.Nhcl;
            Session.SeleccionarOrden(idOrden, Nhcl, _paciente.PacienteNombre);
            _sheet = await tSheet;
        }
    }

    private async Task CambiarHojaAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int h))
        {
            await CargarFichaCompletaAsync(IdOrden, Nhcl, h);
        }
    }

    private async Task GuardarFichaAsync()
    {
        if (_paciente is null) return;
        _guardando = true;
        try
        {
            await HospService.GuardarFichaHospitalizacionAsync(_sheet, Session.IdUser);
            _esError = false;
            _mensajeAlerta = $"Hoja #{_sheet.Hoja} de la Ficha de Hospitalización guardada correctamente.";
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al guardar la ficha: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task NuevaHojaAsync()
    {
        if (_paciente is null) return;
        int nueva = await HospService.CrearNuevaHojaFichaAsync(IdOrden, Nhcl, Session.IdUser);
        await CargarFichaCompletaAsync(IdOrden, Nhcl, nueva);
        _esError = false;
        _mensajeAlerta = $"Se creó la Hoja #{nueva} de la Ficha de Hospitalización.";
    }

    private async Task CerrarFichaAsync()
    {
        if (_paciente is null) return;
        await HospService.CerrarFichaHospitalizacionAsync(IdOrden);
        _sheet.Cerrada = true;
        _esError = false;
        _mensajeAlerta = "La Ficha de Hospitalización ha sido cerrada.";
    }

    private async Task BuscarCatalogoBcAsync()
    {
        if (string.IsNullOrWhiteSpace(_busquedaBc)) return;
        _resultadosBc = await BcService.BuscarMedicamentosConStockAsync(_busquedaBc, Session.Localidad, Session.Apostrofe);
        _productoBcSeleccionado = _resultadosBc.FirstOrDefault()?.DisplayName ?? string.Empty;
    }

    private void AsignarProductoABloque1()
    {
        if (string.IsNullOrWhiteSpace(_productoBcSeleccionado)) return;
        var libre = _sheet.Bloque1Medicacion.FirstOrDefault(x => string.IsNullOrWhiteSpace(x.Medicacion));
        if (libre is not null) libre.Medicacion = _productoBcSeleccionado;
    }

    private void AsignarProductoABloque2()
    {
        if (string.IsNullOrWhiteSpace(_productoBcSeleccionado)) return;
        var libre = _sheet.Bloque2Alimentacion.FirstOrDefault(x => string.IsNullOrWhiteSpace(x.Alimentacion));
        if (libre is not null) libre.Alimentacion = _productoBcSeleccionado;
    }

    private void AsignarProductoABloque3()
    {
        if (string.IsNullOrWhiteSpace(_productoBcSeleccionado)) return;
        var libre = _sheet.Bloque3Fluidoterapia.FirstOrDefault(x => string.IsNullOrWhiteSpace(x.Fluidoterapia));
        if (libre is not null) libre.Fluidoterapia = _productoBcSeleccionado;
    }

    private async Task AgregarNotaAsync(string tipo)
    {
        string texto = tipo == "I" ? _nuevaNotaImportante : _nuevaObservacion;
        if (string.IsNullOrWhiteSpace(texto)) return;

        await HospService.AgregarNotaImportanteAsync(
            IdOrden, Nhcl, texto, tipo,
            Session.IdUser,
            Session.Localidad);

        if (tipo == "I") _nuevaNotaImportante = string.Empty;
        else _nuevaObservacion = string.Empty;

        await CargarFichaCompletaAsync(IdOrden, Nhcl, _sheet.Hoja);
    }

    private async Task EliminarNotaAsync(int idNota)
    {
        await HospService.EliminarNotaImportanteAsync(idNota);
        await CargarFichaCompletaAsync(IdOrden, Nhcl, _sheet.Hoja);
    }

    private async Task ExportarPdfAsync()
    {
        if (_paciente is null) return;
        var bytes = ReportService.GenerarFichaHospitalizacionPdf(_paciente, _sheet, _vias, _ritmos);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"FichaHospitalizacion_Orden{IdOrden}_Hoja{_sheet.Hoja}.pdf", "application/pdf", Convert.ToBase64String(bytes));
    }

    private async Task ExportarExcelAsync()
    {
        if (_paciente is null) return;
        var bytes = ReportService.GenerarFichaHospitalizacionExcel(_paciente, _sheet, _vias, _ritmos);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"FichaHospitalizacion_Orden{IdOrden}_Hoja{_sheet.Hoja}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
    }

    private async Task ImprimirVistaAsync()
    {
        await JS.InvokeVoidAsync("hosvetPrintElement", "area-impresion-ficha");
    }
}
