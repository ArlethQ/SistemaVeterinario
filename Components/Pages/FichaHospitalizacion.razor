@page "/hospitalizacion/ficha"
@page "/hospitalizacion/ficha/{IdOrden:int}/{Nhcl:int}"
@using System.Text.Json
@inject IKardexService KardexService
@inject IHospitalizacionService HospService
@inject IInventarioService InventarioService
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject IJSRuntime JS

<PageTitle>@Titulo — e-ForVets</PageTitle>

<div class="ficha-view @(FormatoActualizado ? "ficha-ajustada" : "") @(ModoModal ? "ficha-embedded" : "")">
    <header class="ficha-hero no-print">
        <div class="ficha-heading">
            <i class="bi bi-hospital" aria-hidden="true"></i>
            <div>
                <h1>@Titulo</h1>
                <p>Seguimiento del paciente y registro de cuidados por turno.</p>
            </div>
        </div>
        @if (_paciente is not null)
        {
            <div class="ficha-actions">
                <button type="button" class="app-doc-action app-doc-pdf" @onclick="ExportarPdfAsync">
                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Descargar PDF
                </button>
                <button type="button" class="app-doc-action app-doc-excel" @onclick="ExportarExcelAsync">
                    <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i> Exportar Excel
                </button>
                <button type="button" class="app-doc-action app-doc-print" @onclick="ImprimirVistaAsync">
                    <i class="bi bi-printer" aria-hidden="true"></i> Imprimir
                </button>
            </div>
        }
    </header>
    <!-- BARRA DE SELECCIÓN DE PACIENTE Y ACCIONES -->
    <div class="card ficha-panel mb-3 no-print">
        <div class="card-body py-2 px-3">
            <div class="row g-2 align-items-center">
                @if (!ModoModal && !FormatoActualizado)
                {
                    <div class="col-12 text-end">
                        <a class="btn btn-sm btn-outline-primary" href="@(_paciente is null
                            ? "/hospitalizacion/ficha-actualizada"
                            : $"/hospitalizacion/ficha-actualizada/{IdOrden}/{Nhcl}")">
                            Ficha actualizada
                        </a>
                    </div>
                }
                @if (!ModoModal)
                {
                    <div class="col-md-4 position-relative">
                        <label class="form-label small fw-bold mb-1 text-primary">Buscar Paciente Hospitalizado (Pre-Ficha):</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" autocomplete="off" placeholder="Nombre mascota, propietario o NHCL..."
                                   @bind="_filtroOrden" @bind:event="oninput" @bind:after="BuscarOrdenesAutoAsync"
                                   @onfocus="() => _mostrarSugerenciasOrden = !string.IsNullOrWhiteSpace(_filtroOrden)"
                                   @onblur="CerrarSugerenciasOrdenConRetrasoAsync"
                                   @onkeydown="BuscarOrdenesConEnterAsync" />
                        </div>
                        @if (_mostrarSugerenciasOrden && _ordenesActivas.Count > 0 && !string.IsNullOrWhiteSpace(_filtroOrden))
                        {
                            <div class="list-group position-absolute bg-white border rounded shadow-sm mt-1 w-100" style="z-index: 1050; max-height: 220px; overflow-y: auto;">
                                @foreach (var ord in _ordenesActivas)
                                {
                                    <button type="button" class="list-group-item list-group-item-action py-1 px-2 small text-start"
                                            @onmousedown="() => SeleccionarOrdenSugeridaAsync(ord)">
                                        <strong>#@ord.IdOrdenAtencion</strong> | NHCL:@ord.Nhcl — @ord.Paciente <small class="text-muted">(@ord.Cliente)</small>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Seleccionar Orden:</label>
                        <select class="form-select form-select-sm" value="@IdOrden" @onchange="OnOrdenChangedAsync">
                            <option value="0">-- Seleccione Paciente --</option>
                            @foreach (var ord in _ordenesActivas)
                            {
                                <option value="@ord.IdOrdenAtencion">#@ord.IdOrdenAtencion | NHCL:@ord.Nhcl - @ord.Paciente (@ord.Cliente)</option>
                            }
                        </select>
                    </div>
                }
                <div class="@(ModoModal ? "col-12 text-end" : "col-md-5 text-end")">
                    @if (_paciente is not null)
                    {
                        <div class="ficha-actions justify-content-end">
                            <SaveButton class="btn btn-primary fw-semibold" OnClick="GuardarFichaAsync" Disabled="@(_guardando || _sheet.Cerrada)">
                                💾 @(_guardando ? "Guardando..." : "Guardar Hoja")
                            </SaveButton>
                            <button class="btn btn-outline-primary" @onclick="NuevaHojaAsync" disabled="@(_sheet.Cerrada || _guardando)">
                                ➕ Nueva Hoja
                            </button>
                            <button class="btn btn-outline-warning text-dark" @onclick="CerrarFichaAsync" disabled="@(_sheet.Cerrada || _guardando)">
                                🔒 Cerrar Ficha
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensajeAlerta))
    {
        <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small no-print">
            @_mensajeAlerta
            <button type="button" class="btn-close py-2" @onclick="() => _mensajeAlerta = null"></button>
        </div>
    }

    @if (_cargandoInicial)
    {
        <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="fw-semibold small">Cargando @Titulo…</span>
        </div>
    }
    else
    {
        @if (_paciente is null)
        {
            <div class="alert alert-info shadow-sm">Vista previa de la ficha. Seleccione un paciente para habilitar el ingreso y guardado de información.</div>
        }
        @if (_borradorRestaurado)
        {
            <div class="alert alert-warning py-2 small d-flex justify-content-between align-items-center mb-2 no-print" role="status">
                <span><i class="bi bi-journal-check me-1"></i><strong>Borrador recuperado automáticamente.</strong> Presiona <strong>Guardar Hoja</strong> para confirmarlo en el sistema.</span>
                <button type="button" class="btn btn-xs btn-outline-dark py-0 px-2" @onclick="DescartarBorradorAsync">Descartar borrador</button>
            </div>
        }
        <fieldset disabled="@(_paciente is null)" class="m-0 p-0 border-0">
        <div id="area-impresion-ficha" @onfocusout="GuardarBorradorAutoAsync" @oninput="ProgramarBorradorAutoAsync">
            <!-- CABECERA DEL PACIENTE Y METADATOS DE LA HOJA -->
            <div class="card ficha-panel mb-3">
                <div class="card-header ficha-section ficha-sheet-header">
                    <div>
                        <span class="fw-bold"><i class="bi bi-clipboard2-pulse me-1" aria-hidden="true"></i> Ficha de hospitalización</span>
                        @if (_sheet.Cerrada)
                        {
                            <span class="badge bg-danger ms-2">FICHA CERRADA</span>
                        }
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="small">N° Hoja:</span>
                        <select class="form-select form-select-sm w-auto bg-white text-dark fw-bold"
                                value="@_sheet.Hoja" @onchange="CambiarHojaAsync">
                            @foreach (var h in _sheet.HojasDisponibles)
                            {
                                <option value="@h">Hoja #@h</option>
                            }
                        </select>
                        @if (!ModoModal && Permisos.Permite("hospitalizacion/monitoreo"))
                        {
                            <a href="/hospitalizacion/monitoreo/@IdOrden/@Nhcl" class="btn btn-sm btn-warning fw-semibold no-print">
                            🩺 Ir a Monitoreo 24h
                        </a>
                        }
                    </div>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="row small g-2 align-items-center ficha-patient">
                        <div class="col-md-2 border-end">
                            <div class="text-muted">Historia / Orden</div>
                            <div class="fw-bold text-danger fs-6">@_pacienteVista.Nhcl <span class="text-secondary">(#@_pacienteVista.OrdenAtencionId)</span></div>
                        </div>
                        <div class="col-md-2 border-end">
                            <div class="text-muted">Paciente / Especie</div>
                            <div class="fw-bold">@(_pacienteVista.PacienteNombre.Length > 0 ? _pacienteVista.PacienteNombre : "—") <span class="text-success">@(_paciente is null ? "" : $"({_pacienteVista.Especie})")</span></div>
                            @if (_paciente is not null)
                            {
                                <small class="ficha-age">Edad: @(_pacienteVista.FechaNacimiento.HasValue ? _pacienteVista.EdadTexto : "Sin registrar")</small>
                            }
                        </div>
                        <div class="col-md-2 border-end">
                            <div class="text-muted">Propietario</div>
                            <div class="fw-semibold">@(_pacienteVista.ClienteNombre.Length > 0 ? _pacienteVista.ClienteNombre : "—")</div>
                        </div>
                        <div class="col-md-2 border-end">
                            <label class="text-muted d-block">Condición Clínica</label>
                            <select class="form-select form-select-sm" @bind="_sheet.CondicionId" disabled="@(_sheet.Cerrada || _guardando)">
                                <option value="">-- Seleccione --</option>
                                @foreach (var c in _condiciones)
                                {
                                    <option value="@c.Id">@c.Condicion</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-1 border-end">
                            <label class="text-muted d-block">Peso (kg)</label>
                            <input type="number" min="0" step="0.1" class="form-control form-control-sm text-center fw-bold"
                                   @bind="_sheet.Peso" disabled="@_sheet.Cerrada" />
                        </div>
                        <div class="col-md-1 border-end">
                            <label class="text-muted d-block">Día Hosp.</label>
                            <input type="number" min="1" class="form-control form-control-sm text-center fw-bold"
                                   @bind="_sheet.DiasHospitalizacion" disabled="@_sheet.Cerrada" />
                        </div>
                        <div class="col-md-2">
                            <label class="text-muted d-block">Fecha Hoja</label>
                            <input type="date" class="form-control form-control-sm text-center"
                                   @bind="_sheet.Fecha" disabled="@_sheet.Cerrada" />
                        </div>
                    </div>
                    @if (FormatoActualizado && _paciente is not null)
                    {
                        <div class="row row-cols-md-5 small g-2 mt-2 ficha-patient">
                            <div class="col"><div class="text-muted">Teléfono del tutor</div>@(string.IsNullOrWhiteSpace(_pacienteVista.ClienteTelefono) ? "—" : _pacienteVista.ClienteTelefono)</div>
                            <div class="col"><div class="text-muted">Raza / Sexo</div>@_pacienteVista.Raza / @_pacienteVista.Sexo</div>
                            <div class="col"><div class="text-muted">Fecha de ingreso</div>@(_fechaIngreso?.ToString("dd/MM/yyyy") ?? "—")</div>

                            <div class="col"><div class="text-muted">Hora de ingreso</div>@(_fechaIngreso?.ToString("HH:mm") ?? "—")</div>
                            <div class="col"><div class="text-muted">Médico tratante</div>@_sheet.MedicoResponsable</div>
                        </div>
                    }
                </div>
            </div>

            @if (_sheet.DetalleActualizado is { } datosCabecera)
            {
                @foreach (var seccion in DetalleFichaHospitalizacion.Secciones.Take(2))
                {
                    @SeccionActualizada(seccion, datosCabecera)
                }
            }
            <!-- BUSCADOR RÁPIDO DE FÁRMACOS / INSUMOS PARA ASIGNAR A FILAS -->
            <div class="card ficha-panel mb-3 no-print">
                <div class="card-body py-2 px-3">
                    <div class="row g-2 align-items-center small">
                        <div class="col-md-4">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text fw-bold">🔎 Catálogo:</span>
                                <input type="text" class="form-control" autocomplete="off" placeholder="Buscar por nombre o código..."
                                       @bind="_busquedaBc" @bind:event="oninput" @bind:after="BuscarCatalogoAutoAsync" @onkeydown="BuscarCatalogoConEnterAsync" />
                            </div>
                        </div>
                        @if (_buscandoCatalogo)
                        {
                            <div class="col-md-8 text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Buscando en catálogo...</div>
                        }
                        else if (_resultadosBc.Count > 0)
                        {
                            <div class="col-md-8">
                                <div class="d-flex gap-2 align-items-center">
                                    <select class="form-select form-select-sm" @bind="_productoBcSeleccionadoId">
                                        @foreach (var p in _resultadosBc)
                                        {
                                            <option value="@ProductoKey(p)">@p.DisplayName (Stock: @p.Inventory @p.BaseUnitOfMeasureCode | $@p.UnitPrice)</option>
                                        }
                                    </select>
                                    <button class="btn btn-sm btn-outline-primary text-nowrap" @onclick="AsignarProductoABloque1">
                                        ➕ A Medicación
                                    </button>
                                    <button class="btn btn-sm btn-outline-success text-nowrap" @onclick="AsignarProductoABloque2">
                                        ➕ A Alimentación
                                    </button>
                                    <button class="btn btn-sm btn-outline-info text-dark text-nowrap" @onclick="AsignarProductoABloque3">
                                        ➕ A Fluidoterapia
                                    </button>
                                </div>
                            </div>
                        }
                        else if (_catalogoBuscado && !_buscandoCatalogo)
                        {
                            <div class="col-md-8 text-muted">No se encontraron productos para la búsqueda.</div>
                        }
                    </div>
                </div>
            </div>

            <!-- BLOQUE 1: MEDICACIÓN (12 FILAS X 24 HORAS: 07h..24h, 01h..06h) -->
            <div class="card ficha-panel mb-3">
                <div class="card-header ficha-section">
                    <span class="fw-bold small">1. MEDICACIÓN — PRINCIPIO ACTIVO, DOSIS@(SufijoMatriz)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size: 0.74rem;">
                        <thead class="table-light">
                            <tr>
                                <th class="ficha-col-indice" style="width:28px;">#</th>
                                <th class="ficha-col-nombre" style="min-width:170px;">Medicamento</th>
                                <th style="width:62px;">mg/kg</th>
                                <th style="width:58px;">ml</th>
                                <th style="min-width:85px;">Vía</th>
                                <th style="min-width:90px;">Ritmo</th>
                                @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                {
                                    <th class="ficha-col-hora @(hr >= 19 || hr <= 6 ? "ficha-col-noche bg-dark text-white" : "bg-info bg-opacity-25")" style="min-width:34px;">@hr</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _sheet.Bloque1Medicacion)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">@row.Fila</td>
                                    <td class="p-1">
                                        <input type="text" class="form-control form-control-sm px-1 py-0"
                                               @bind="row.Medicacion" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="number" min="0" step="0.01" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.MgKg" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="number" min="0" step="0.01" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.Ml" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <select class="form-select form-select-sm px-1 py-0" @bind="row.Via" disabled="@(_sheet.Cerrada || _guardando)">
                                            <option value="">-</option>
                                            @foreach (var v in _vias)
                                            {
                                                <option value="@v.Id">@v.Via</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="p-1">
                                        <select class="form-select form-select-sm px-1 py-0" @bind="row.Ritmo" disabled="@(_sheet.Cerrada || _guardando)">
                                            <option value="">-</option>
                                            @foreach (var rt in _ritmos)
                                            {
                                                <option value="@rt.Id">@rt.Des_Ritmo</option>
                                            }
                                        </select>
                                    </td>
                                    @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                    {
                                        int hLocal = hr;
                                        <td class="p-0">
                                            <input type="text" class="form-control form-control-sm border-0 px-0 py-1 text-center fw-bold"
                                                   style="font-size:0.72rem;"
                                                   value="@row.GetValorHora(hLocal)"
                                                   @onchange="e => row.SetValorHora(hLocal, e.Value?.ToString())"
                                                   disabled="@_sheet.Cerrada" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- BLOQUE 2: ALIMENTACIÓN (5 FILAS X 24 HORAS) -->
            <div class="card ficha-panel mb-3">
                <div class="card-header ficha-section">
                    <span class="fw-bold small">2. ALIMENTACIÓN — CÁLCULO CALÓRICO@(SufijoMatriz)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size: 0.74rem;">
                        <thead class="table-light">
                            <tr>
                                <th class="ficha-col-indice" style="width:28px;">#</th>
                                <th class="ficha-col-nombre" style="min-width:170px;">Alimentación</th>
                                <th style="width:62px;">Kcal/d</th>
                                <th style="width:58px;">Kcal/v</th>
                                <th style="min-width:85px;">gr</th>
                                <th style="min-width:90px;">Ritmo</th>
                                @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                {
                                    <th class="ficha-col-hora @(hr >= 19 || hr <= 6 ? "ficha-col-noche bg-dark text-white" : "bg-success bg-opacity-25")" style="min-width:34px;">@hr</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _sheet.Bloque2Alimentacion)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">@row.Fila</td>
                                    <td class="p-1">
                                        <input type="text" class="form-control form-control-sm px-1 py-0"
                                               @bind="row.Alimentacion" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="number" min="0" step="0.1" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.Cald" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="number" min="0" step="0.1" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.Calv" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <input type="number" min="0" step="0.01" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="row.Gr" disabled="@_sheet.Cerrada" />
                                    </td>
                                    <td class="p-1">
                                        <select class="form-select form-select-sm px-1 py-0" @bind="row.Ritmo" disabled="@(_sheet.Cerrada || _guardando)">
                                            <option value="">-</option>
                                            @foreach (var rt in _ritmos)
                                            {
                                                <option value="@rt.Id">@rt.Des_Ritmo</option>
                                            }
                                        </select>
                                    </td>
                                    @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                    {
                                        int hLocal = hr;
                                        <td class="p-0">
                                            <input type="text" class="form-control form-control-sm border-0 px-0 py-1 text-center fw-bold"
                                                   style="font-size:0.72rem;"
                                                   value="@row.GetValorHora(hLocal)"
                                                   @onchange="e => row.SetValorHora(hLocal, e.Value?.ToString())"
                                                   disabled="@_sheet.Cerrada" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!FormatoActualizado)
            {
                <!-- BLOQUE 3: FLUIDOTERAPIA (7 FILAS X 24 HORAS) -->
                <div class="card ficha-panel mb-3">
                    <div class="card-header ficha-section">
                        <span class="fw-bold small">3. FLUIDOTERAPIA — INFUSIÓN CONTINUA@(SufijoMatriz)</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size: 0.74rem;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ficha-col-indice" style="width:28px;">#</th>
                                    <th class="ficha-col-nombre" style="min-width:170px;">Fluido</th>
                                    <th style="width:62px;">M+P+D</th>
                                    <th style="width:58px;">ml/día</th>
                                    <th style="min-width:85px;">ml/h</th>
                                    <th style="min-width:90px;">gotas/min</th>
                                    @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                    {
                                        <th class="ficha-col-hora @(hr >= 19 || hr <= 6 ? "ficha-col-noche bg-dark text-white" : "bg-info bg-opacity-25")" style="min-width:34px;">@hr</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _sheet.Bloque3Fluidoterapia)
                                {
                                    <tr>
                                        <td class="fw-bold text-muted">@row.Fila</td>
                                        <td class="p-1">
                                            <input type="text" class="form-control form-control-sm px-1 py-0"
                                                   @bind="row.Fluidoterapia" disabled="@_sheet.Cerrada" />
                                        </td>
                                        <td class="p-1">
                                            <input type="number" min="0" step="0.01" class="form-control form-control-sm px-1 py-0 text-center"
                                                   @bind="row.Mpd" disabled="@_sheet.Cerrada" />
                                        </td>
                                        <td class="p-1">
                                            <input type="number" min="0" step="0.01" class="form-control form-control-sm px-1 py-0 text-center"
                                                   @bind="row.MlDia" disabled="@_sheet.Cerrada" />
                                        </td>
                                        <td class="p-1">
                                            <input type="number" min="0" step="0.01" class="form-control form-control-sm px-1 py-0 text-center"
                                                   @bind="row.MlH" disabled="@_sheet.Cerrada" />
                                        </td>
                                        <td class="p-1">
                                            <input type="number" min="0" step="0.01" class="form-control form-control-sm px-1 py-0 text-center"
                                                   @bind="row.Gotas" disabled="@_sheet.Cerrada" />
                                        </td>
                                        @foreach (var hr in Matriz24HorasBaseDto.HorasOrden)
                                        {
                                            int hLocal = hr;
                                            <td class="p-0">
                                                <input type="text" class="form-control form-control-sm border-0 px-0 py-1 text-center fw-bold"
                                                       style="font-size:0.72rem;"
                                                       value="@row.GetValorHora(hLocal)"
                                                       @onchange="e => row.SetValorHora(hLocal, e.Value?.ToString())"
                                                       disabled="@_sheet.Cerrada" />
                                            </td>
                                        }
                                    </tr>
                                }
