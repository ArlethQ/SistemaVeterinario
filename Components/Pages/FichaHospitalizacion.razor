        </fieldset>
    }
</div>

@code {
    private RenderFragment SeccionActualizada(SeccionFichaHospitalizacion seccion, DetalleFichaHospitalizacion detalle) =>
        @<section class="card ficha-panel mb-3">
            <div class="card-header ficha-section">@seccion.Titulo</div>
            @if (seccion.Titulo == "Control ecográfico torácico")
            {
                <p class="small text-muted px-3 my-2">
                    LBL, LBM, LBS: líneas B leves, moderadas o severas.
                    SAIL, SAIM, SAIS: síndrome alveolo-intersticial leve, moderado o severo.
                    DPL, DPM, DPS: derrame pleural leve, moderado o severo.
                    CSP: consolidación subpleural. NP: nódulo pulmonar. NT: neumotórax.
                    PI: pleura irregular. HI y HD: hemitórax izquierdo y derecho. EDP: edema pulmonar.
                </p>
            }
            @{ var etiquetas = DetalleFichaHospitalizacion.EtiquetasDeFila(seccion); }
            @if (seccion.TextoLargo || (!seccion.Horaria && seccion.Filas == 1 && etiquetas.Length == 0))
            {
                <div class="card-body row g-2">
                    @for (int columna = 0; columna < seccion.Campos.Length; columna++)
                    {
                        var etiqueta = seccion.Campos[columna];
                        var clave = seccion.Clave(0, columna);
                        <label class="@(seccion.TextoLargo ? "col-md-6" : "col-md-4") small fw-semibold">
                            @etiqueta
                            @if (seccion.TextoLargo)
                            {
                                <textarea rows="2" maxlength="2000" class="form-control form-control-sm"
                                          disabled="@(_sheet.Cerrada || _guardando)"
                                          @bind:get="detalle.Obtener(clave)" @bind:set="v => detalle.Registrar(clave, v)"></textarea>
                            }
                            else
                            {
                                <input maxlength="200" class="form-control form-control-sm"
                                       disabled="@(_sheet.Cerrada || _guardando)"
                                       @bind:get="detalle.Obtener(clave)" @bind:set="v => detalle.Registrar(clave, v)" />
                            }
                        </label>
                    }
                </div>
            }
            else
            {
                var encabezados = seccion.Encabezados;
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 ficha-tabla-ampliada">
                        <thead>
                            <tr>
                                @for (int columna = 0; columna < encabezados.Length; columna++)
                                {

                                    var esHorario = columna >= seccion.Campos.Length;
                                    var hora = esHorario ? Matriz24HorasBaseDto.HorasOrden[columna - seccion.Campos.Length] : 0;
                                    var clase = esHorario
                                        ? hora >= 19 || hora <= 6 ? "ficha-col-hora ficha-col-noche" : "ficha-col-hora"
                                        : "ficha-col-campo";
                                    <th scope="col" class="@clase @(EsColumnaNumerica(encabezados[columna]) ? "ficha-col-numero" : "")">@encabezados[columna]</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (int fila = 0; fila < Math.Max(detalle.FilasDisponibles(seccion), etiquetas.Length); fila++)
                            {
                                var etiqueta = etiquetas.Length > 0 ? etiquetas[fila] : $"Fila {fila + 1}";
                                <tr>
                                    @for (int columna = 0; columna < encabezados.Length; columna++)
                                    {
                                        var clave = seccion.Clave(fila, columna);
                                        if (columna == 0 && etiquetas.Length > 0)
                                        {
                                            <th scope="row">@etiqueta</th>
                                        }
                                        else
                                        {
                                            <td>
                                                @{
                                                    var numerico = EsColumnaNumerica(encabezados[columna]);
                                                    var valor = detalle.Obtener(clave);
                                                    var tipo = numerico && (valor.Length == 0 || decimal.TryParse(valor,
                                                        System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _))
                                                        ? "number" : "text";
                                                }
                                                <input type="@tipo" step="@(tipo == "number" ? "any" : null)"
                                                       inputmode="@(numerico ? "decimal" : null)" maxlength="200"
                                                       class="form-control form-control-sm @(numerico ? "ficha-numero" : "")"
                                                       disabled="@(_sheet.Cerrada || _guardando)" aria-label="@($"{etiqueta} · {encabezados[columna]}")"
                                                       @bind:get="detalle.Obtener(clave)" @bind:set="v => detalle.Registrar(clave, v)" />
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>;
}

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }
    [Parameter] public bool ModoModal { get; set; }
    [Parameter] public bool FormatoActualizado { get; set; }

    private static bool EsColumnaNumerica(string etiqueta) => etiqueta is
        "ml" or "ml/h" or "ml/día" or "Dosis (ml/h)" or "Bureta (ml)" or
        "Reposición por deshidratación (%)" or "Kcal/d" or "Kcal/1000 g" or "g/día" or
        "% RER" or "N.º de raciones" or "ml o g por ración";

    private string Titulo => FormatoActualizado ? "Ficha de Hospitalización actualizada" : "Ficha de Hospitalización 24h";
    private string SufijoMatriz => FormatoActualizado ? "" : " Y MATRIZ HORARIA (07:00 A 06:00)";
    private DateTime? _fechaIngreso;

    private string _filtroOrden = string.Empty;
    private List<OrdenActivaResumenDto> _ordenesActivas = [];
    private PacienteHeaderDto? _paciente;
    private PacienteHeaderDto _pacienteVista => _paciente ?? new();
    private FichaHospitalizacionSheetDto _sheet = CrearFichaVacia();

    private List<ViaAdministracionDto> _vias = [];
    private List<RitmoHorarioDto> _ritmos = [];
    private List<CondicionHospitalDto> _condiciones = [];

    private string _busquedaBc = string.Empty;
    private List<FarmacoStockDto> _resultadosBc = [];
    private string _productoBcSeleccionadoId = string.Empty;

    private string _nuevaNotaImportante = string.Empty;
    private string _nuevaObservacion = string.Empty;
    private bool _cargandoInicial = true;
    private bool _guardando;
    private bool _buscandoOrdenes;
    private bool _buscandoCatalogo;
    private bool _catalogoBuscado;
    private bool _borradorRestaurado;
    private bool _pendienteRestaurarBorrador;
    private int _versionBorrador;
    private int _versionCarga;
    private string _jsonInicial = string.Empty;
    private int _versionCatalogo;
    private string? _mensajeAlerta;
    private bool _esError;

    private static FichaHospitalizacionSheetDto CrearFichaVacia() => new()
    {
        Bloque1Medicacion = Enumerable.Range(1, 12).Select(i => new FichaBloque1MedicacionDto { Fila = i }).ToList(),
        Bloque2Alimentacion = Enumerable.Range(1, 12).Select(i => new FichaBloque2AlimentacionDto { Fila = i }).ToList(),
        Bloque3Fluidoterapia = Enumerable.Range(1, 12).Select(i => new FichaBloque3FluidoterapiaDto { Fila = i }).ToList()
    };

    protected override async Task OnInitializedAsync()
    {
        _cargandoInicial = true;
        if (FormatoActualizado)
            _sheet.DetalleActualizado = new();

        try
        {
            var tVias = KardexService.ObtenerViasAdministracionAsync();
            var tRitmos = HospService.ObtenerRitmosHorariosAsync();
            var tCond = HospService.ObtenerCondicionesAsync();
            var tOrd = ModoModal ? Task.FromResult<List<OrdenActivaResumenDto>>([]) : KardexService.ObtenerOrdenesActivasAsync();
            await Task.WhenAll(tVias, tRitmos, tCond, tOrd);

            _vias = await tVias;
            _ritmos = await tRitmos;
            _condiciones = await tCond;
            _ordenesActivas = await tOrd;

            if (IdOrden > 0)
                await CargarFichaCompletaAsync(IdOrden, Nhcl, 1);
        }
        catch (Exception ex)
        {
            _paciente = null;
            MostrarError(ex, "No se pudo cargar la ficha de hospitalización");
        }
        finally
        {
            _cargandoInicial = false;
        }
    }

    private bool _mostrarSugerenciasOrden;

    private async Task BuscarOrdenesAutoAsync()
    {
        _buscandoOrdenes = true;
        try
        {
            _ordenesActivas = await KardexService.ObtenerOrdenesActivasAsync(_filtroOrden.Trim());
            _mostrarSugerenciasOrden = !string.IsNullOrWhiteSpace(_filtroOrden) && _ordenesActivas.Count > 0;
        }
        catch { }
        finally { _buscandoOrdenes = false; }
    }

    private async Task SeleccionarOrdenSugeridaAsync(OrdenActivaResumenDto ord)
    {
        _mostrarSugerenciasOrden = false;
        try { await CargarFichaCompletaAsync(ord.IdOrdenAtencion, ord.Nhcl, 1); }
        catch (Exception ex) { MostrarError(ex, "No se pudo abrir la ficha seleccionada"); }
    }

    private async Task CerrarSugerenciasOrdenConRetrasoAsync()
    {
        await Task.Delay(180);
        _mostrarSugerenciasOrden = false;
    }

    private async Task BuscarOrdenesAsync()
    {
        _buscandoOrdenes = true;
        try
        {
            _ordenesActivas = await KardexService.ObtenerOrdenesActivasAsync(_filtroOrden.Trim());
            if (_ordenesActivas.Count == 0)
            {
                _esError = true;
                _mensajeAlerta = "No se encontraron órdenes activas con ese criterio.";
            }
        }
        catch (Exception ex) { MostrarError(ex, "No se pudo buscar pacientes"); }
        finally { _buscandoOrdenes = false; }
    }

    private async Task BuscarOrdenesConEnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarOrdenesAsync();
    }

    private async Task OnOrdenChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idOrd) && idOrd > 0)
        {
            var ord = _ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == idOrd);
            if (ord is not null)
            {
                try { await CargarFichaCompletaAsync(ord.IdOrdenAtencion, ord.Nhcl, 1); }
                catch (Exception ex) { MostrarError(ex, "No se pudo abrir la ficha seleccionada"); }
            }
        }
    }

    private async Task CargarFichaCompletaAsync(int idOrden, int nhcl, int hoja)
    {
        var version = ++_versionCarga;
        var tPac = KardexService.ObtenerCabeceraPacienteAsync(idOrden, nhcl);
        var tSheet = HospService.CargarFichaHospitalizacionAsync(idOrden, nhcl, hoja, Session.IdUser, FormatoActualizado);
        await Task.WhenAll(tPac, tSheet);

        var paciente = await tPac;
        if (paciente is not null)
        {
            var ingreso = FormatoActualizado
                ? await HospService.ObtenerIngresoHospitalizacionAsync(idOrden, paciente.Nhcl)
                : null;
            if (version != _versionCarga) return;
            _fechaIngreso = ingreso?.FechaIngreso;

            _paciente = paciente;
            IdOrden = idOrden;
            Nhcl = paciente.Nhcl;
            Session.SeleccionarOrden(idOrden, Nhcl, _paciente.PacienteNombre);
            _sheet = await tSheet;
            _jsonInicial = JsonSerializer.Serialize(_sheet);
            _pendienteRestaurarBorrador = true;
            _borradorRestaurado = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendienteRestaurarBorrador && _paciente is not null && !_cargandoInicial)
        {
            _pendienteRestaurarBorrador = false;
            await IntentarRestaurarBorradorAsync();
        }
    }

    private string ClaveBorrador => $"ficha24h{(FormatoActualizado ? "_actualizada" : "")}_{_paciente?.OrdenAtencionId ?? IdOrden}_{_sheet.Hoja}";

    private async Task ProgramarBorradorAutoAsync()
    {
        var v = ++_versionBorrador;
        await Task.Delay(250);
        if (v != _versionBorrador) return;
        await GuardarBorradorAutoAsync();
    }

    private async Task GuardarBorradorAutoAsync()
    {
        if (_paciente is null || IdOrden <= 0 || _sheet.Cerrada) return;
        try
        {
            var json = JsonSerializer.Serialize(_sheet);
            if (json == _jsonInicial)
            {
                await JS.InvokeVoidAsync("hosvetDraft.remove", ClaveBorrador);
                _borradorRestaurado = false;
                return;
            }
            await JS.InvokeVoidAsync("hosvetDraft.save", ClaveBorrador, json);
        }
        catch { }
    }

    private async Task IntentarRestaurarBorradorAsync()
    {
        if (_sheet.Cerrada) return;
        try
        {
            var json = await JS.InvokeAsync<string?>("hosvetDraft.load", ClaveBorrador);
            if (string.IsNullOrWhiteSpace(json)) return;
            var borrador = JsonSerializer.Deserialize<FichaHospitalizacionSheetDto>(json);
            if (borrador is not null && borrador.Hoja == _sheet.Hoja)
            {
                if (JsonSerializer.Serialize(borrador) == _jsonInicial)
                {
                    await JS.InvokeVoidAsync("hosvetDraft.remove", ClaveBorrador);
                    _borradorRestaurado = false;
                    return;
                }
                borrador.DetalleActualizado?.IntegrarFluidoterapia(borrador.Bloque3Fluidoterapia);
                _sheet = borrador;
                _borradorRestaurado = true;
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task DescartarBorradorAsync()
    {
        try { await JS.InvokeVoidAsync("hosvetDraft.remove", ClaveBorrador); } catch { }
        _borradorRestaurado = false;
        if (_paciente is not null)
        {
            await CargarFichaCompletaAsync(_paciente.OrdenAtencionId, _paciente.Nhcl, _sheet.Hoja);
            _pendienteRestaurarBorrador = false;
        }
    }

    private async Task CambiarHojaAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int h))
        {
            try { await CargarFichaCompletaAsync(IdOrden, Nhcl, h); }
            catch (Exception ex) { MostrarError(ex, "No se pudo cargar la hoja seleccionada"); }
        }
    }

    private async Task GuardarFichaAsync()
    {
        if (_paciente is null || _sheet.Cerrada || _guardando) return;
        _guardando = true;
        try
        {
            await HospService.GuardarFichaHospitalizacionAsync(_sheet, Session.IdUser);
            _jsonInicial = JsonSerializer.Serialize(_sheet);
            try { await JS.InvokeVoidAsync("hosvetDraft.remove", ClaveBorrador); } catch { }
            _borradorRestaurado = false;
            _esError = false;
            _mensajeAlerta = $"Hoja #{_sheet.Hoja} de la Ficha de Hospitalización guardada correctamente.";
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al guardar la ficha: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task NuevaHojaAsync()
    {
        if (_paciente is null || _sheet.Cerrada || _guardando) return;
        _guardando = true;
        try
        {
            await HospService.GuardarFichaHospitalizacionAsync(_sheet, Session.IdUser);
            int nueva = await HospService.CrearNuevaHojaFichaAsync(IdOrden, Nhcl, Session.IdUser);
            await CargarFichaCompletaAsync(IdOrden, Nhcl, nueva);
            _esError = false;
            _mensajeAlerta = $"Se guardó la hoja anterior y se creó la Hoja #{nueva}.";
        }
        catch (Exception ex) { MostrarError(ex, "No se pudo crear una nueva hoja"); }
        finally { _guardando = false; }
    }

    private async Task CerrarFichaAsync()
    {
        if (_paciente is null || _sheet.Cerrada || _guardando) return;
        _guardando = true;
        try
        {
            await HospService.GuardarFichaHospitalizacionAsync(_sheet, Session.IdUser);
            await HospService.CerrarFichaHospitalizacionAsync(IdOrden);
            _sheet.Cerrada = true;
            _esError = false;
            _mensajeAlerta = "La ficha se guardó y cerró correctamente.";
        }
        catch (Exception ex) { MostrarError(ex, "No se pudo cerrar la ficha"); }
        finally { _guardando = false; }
    }

    private async Task BuscarCatalogoAutoAsync()
    {
        var version = ++_versionCatalogo;
        if (string.IsNullOrWhiteSpace(_busquedaBc))
        {
            _resultadosBc = [];
            _catalogoBuscado = false;
            _buscandoCatalogo = false;
            return;
        }

        _buscandoCatalogo = true;
        _catalogoBuscado = true;
        try
        {
            await Task.Delay(220);
            if (version != _versionCatalogo) return;

            var resultados = await InventarioService.BuscarMedicamentosConStockAsync(_busquedaBc.Trim(), Session.Localidad, Session.Apostrofe);
            if (version != _versionCatalogo) return;

            _resultadosBc = resultados;
            _productoBcSeleccionadoId = _resultadosBc.Count > 0 ? ProductoKey(_resultadosBc[0]) : string.Empty;
        }
        catch { }
        finally
        {
            if (version == _versionCatalogo)
            {
                _buscandoCatalogo = false;
                StateHasChanged();
            }
        }
    }

    private async Task BuscarCatalogoBcAsync()
    {
        if (string.IsNullOrWhiteSpace(_busquedaBc))
        {
            _resultadosBc = [];
            _catalogoBuscado = false;
            return;
        }

        _buscandoCatalogo = true;
        _catalogoBuscado = true;
        try
        {
            _resultadosBc = await InventarioService.BuscarMedicamentosConStockAsync(_busquedaBc.Trim(), Session.Localidad, Session.Apostrofe);
            _productoBcSeleccionadoId = _resultadosBc.Count > 0 ? ProductoKey(_resultadosBc[0]) : string.Empty;
        }
        catch (Exception ex) { MostrarError(ex, "No se pudo consultar el catálogo"); }
        finally { _buscandoCatalogo = false; }
    }

    private async Task BuscarCatalogoConEnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarCatalogoBcAsync();
    }

    private static string ProductoKey(FarmacoStockDto producto) => $"{producto.Number}|{producto.Id}|{producto.Location}";

    private FarmacoStockDto? ProductoSeleccionado() =>
        _resultadosBc.FirstOrDefault(x => ProductoKey(x) == _productoBcSeleccionadoId);

    private void AsignarProductoABloque1()
    {
        var producto = ProductoSeleccionado();
        if (producto is null) return;
        var libre = _sheet.Bloque1Medicacion.FirstOrDefault(x => string.IsNullOrWhiteSpace(x.Medicacion));
        if (libre is not null) libre.Medicacion = producto.DisplayName;
        else MostrarError(null, "No existen filas libres en medicación");
    }

    private void AsignarProductoABloque2()
    {
        var producto = ProductoSeleccionado();
        if (producto is null) return;
        var libre = _sheet.Bloque2Alimentacion.FirstOrDefault(x => string.IsNullOrWhiteSpace(x.Alimentacion));
        if (libre is not null) libre.Alimentacion = producto.DisplayName;
        else MostrarError(null, "No existen filas libres en alimentación");
    }

    private void AsignarProductoABloque3()
    {
        var producto = ProductoSeleccionado();
        if (producto is null) return;
        if (_sheet.DetalleActualizado is { } detalle)
        {
            var plan = DetalleFichaHospitalizacion.PlanFluidoterapia;
            for (int fila = 0; fila < detalle.FilasDisponibles(plan); fila++)
            {
                var clave = plan.Clave(fila, 0);
                if (!string.IsNullOrWhiteSpace(detalle.Obtener(clave))) continue;
                detalle.Registrar(clave, producto.DisplayName);
                return;
            }

            MostrarError(null, "No existen filas libres en el plan de fluidoterapia");
            return;
        }

        var libre = _sheet.Bloque3Fluidoterapia.FirstOrDefault(x => string.IsNullOrWhiteSpace(x.Fluidoterapia));
        if (libre is not null) libre.Fluidoterapia = producto.DisplayName;
        else MostrarError(null, "No existen filas libres en fluidoterapia");
    }

    private async Task AgregarNotaAsync(string tipo)
    {
        string texto = tipo == "I" ? _nuevaNotaImportante : _nuevaObservacion;
        if (string.IsNullOrWhiteSpace(texto)) return;

        try
        {
            await HospService.AgregarNotaImportanteAsync(
                IdOrden, Nhcl, texto, tipo,
                Session.IdUser,
                Session.Localidad);

            if (tipo == "I") _nuevaNotaImportante = string.Empty;
            else _nuevaObservacion = string.Empty;

            await ActualizarNotasAsync();
        }
        catch (Exception ex) { MostrarError(ex, "No se pudo guardar la nota"); }
    }

    private async Task EliminarNotaAsync(int idNota)
    {
        try
        {
            await HospService.EliminarNotaImportanteAsync(idNota);
            await ActualizarNotasAsync();
        }
        catch (Exception ex) { MostrarError(ex, "No se pudo eliminar la nota"); }
    }

    private async Task ActualizarNotasAsync()
    {
        var hoja = _sheet;
        var datos = await HospService.CargarFichaHospitalizacionAsync(hoja.IdOrden, hoja.Nhcl, hoja.Hoja, Session.IdUser);
        hoja.NotasImportantes = datos.NotasImportantes;
        hoja.ObservacionesGenerales = datos.ObservacionesGenerales;
    }

    private string NombreExportacion => $"FichaHospitalizacion{(FormatoActualizado ? "_Actualizada" : "")}_Orden{IdOrden}_Hoja{_sheet.Hoja}";

    private async Task ExportarPdfAsync()
    {
        if (_paciente is null) return;
        var bytes = ReportService.GenerarFichaHospitalizacionPdf(_paciente, _sheet, _vias, _ritmos);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"{NombreExportacion}.pdf", "application/pdf", Convert.ToBase64String(bytes));
    }

    private async Task ExportarExcelAsync()
    {
        if (_paciente is null) return;
        var bytes = ReportService.GenerarFichaHospitalizacionExcel(_paciente, _sheet, _vias, _ritmos);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"{NombreExportacion}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
    }

    private async Task ImprimirVistaAsync()
    {
        await JS.InvokeVoidAsync("hosvetPrintElement", "area-impresion-ficha", FormatoActualizado ? "landscape" : "portrait");
    }

    private void MostrarError(Exception? ex, string mensaje)
    {
        _esError = true;
        _mensajeAlerta = ex is null ? mensaje : $"{mensaje}: {ex.GetBaseException().Message}";
    }
}
