                                <button class="btn btn-secondary" @onclick='() => AgregarNotaAsync("O")' disabled="@(_sheet.Cerrada || _guardando)">
                                    Agregar
                                </button>
                            </div>
                            <table class="table table-sm table-striped small mb-0">
                                <thead>
                                    <tr>
                                        <th>Fecha / Hora</th>
                                        <th>Observación</th>
                                        <th class="no-print"></th>
