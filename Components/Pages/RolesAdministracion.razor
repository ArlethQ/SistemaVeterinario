@page "/administracion/roles"
@using HosvetKardex.Web.Components.Layout
@inject SessionStateService Session
@inject IAuthService AuthService
@inject NavigationManager Nav
<PageTitle>Roles | e-ForVets</PageTitle>
@if(_autorizado){<div class="catalog-page"><SecurityNav /><header><div><span>Seguridad</span><h1>Roles</h1><p>Crea y edita los perfiles utilizados para clasificar usuarios.</p></div><button @onclick="Nuevo">+ Nuevo rol</button></header>@if(!string.IsNullOrWhiteSpace(_mensaje)){<div class="message @(_error?"error":"success")">@_mensaje</div>}<div class="catalog-layout"><section><h2>Roles disponibles</h2>@if(_cargando){<p>Cargando...</p>}else{@foreach(var rol in _roles){<button class="catalog-row @(rol.Id==_edit.Id?"active":"")" @onclick="()=>Editar(rol)"><span><strong>@rol.Descripcion</strong><small>Identificador @rol.Id</small></span><i>Editar</i></button>}}</section><aside><h2>@(_edit.Id>0?"Editar rol":"Crear rol")</h2><label>Nombre del rol<input maxlength="100" @bind="_edit.Descripcion" placeholder="Ej. Recepción" /></label><small>Después de crearlo podrás asignarlo a usuarios y configurar sus permisos.</small><button class="save" disabled="@_guardando" @onclick="Guardar">@(_guardando?"Guardando...":"Guardar rol")</button></aside></div></div>}
@code{private bool _autorizado,_cargando=true,_guardando,_error;private string _mensaje="";private List<RolUsuarioModel>_roles=[];private RolUsuarioModel _edit=new();protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated||Session.TipoUser!=1){Nav.NavigateTo("/dashboard");return;}_autorizado=true;await Cargar();}private async Task Cargar(){_cargando=true;_roles=await AuthService.ObtenerRolesAsync();_cargando=false;}private void Nuevo(){_edit=new();_mensaje="";}private void Editar(RolUsuarioModel r){_edit=new(){Id=r.Id,Descripcion=r.Descripcion};_mensaje="";}private async Task Guardar(){if(string.IsNullOrWhiteSpace(_edit.Descripcion)){_error=true;_mensaje="El nombre del rol es obligatorio.";return;}_guardando=true;var ok=await AuthService.GuardarRolAsync(_edit,Session.IdUser);_guardando=false;_error=!ok;_mensaje=ok?"Rol guardado correctamente.":"No se pudo guardar el rol.";if(ok){Nuevo();_mensaje="Rol guardado correctamente.";await Cargar();}}}
