@page "/kardex/signos"
@page "/kardex/signos/{IdOrden:int}/{Nhcl:int}"
@inject IKardexService KardexService
@inject IHospitalizacionService HospService
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Signos Vitales y Balance Hídrico — e-ForVets</PageTitle>

<div class="container-fluid py-3">
    <!-- BARRA SUPERIOR DE SELECCIÓN Y ACCIONES -->
    <div class="card shadow-sm border-0 mb-3 no-print">
        <div class="card-body py-2 px-3 bg-light rounded">
            <div class="row g-2 align-items-center">
                <div class="col-md-5 position-relative">
                    <label class="form-label small fw-bold mb-1 text-primary">Paciente / Orden Activa:</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" autocomplete="off" placeholder="Filtrar paciente o historia..."
                               @bind="_filtroOrden" @bind:event="oninput" @bind:after="BuscarOrdenesAutoAsync"
                               @onfocus="() => _mostrarSugerenciasOrden = !string.IsNullOrWhiteSpace(_filtroOrden)"
                               @onblur="CerrarSugerenciasOrdenConRetrasoAsync"
                               @onkeydown="OnFiltroKeyDown" />
                        <button class="btn btn-outline-primary" @onclick="BuscarOrdenesAsync">Buscar</button>
                        <button class="btn btn-outline-secondary" @onclick="LimpiarBusquedaAsync">🔄 Limpiar</button>
                    </div>
                    @if (_mostrarSugerenciasOrden && _ordenesActivas.Count > 0 && !string.IsNullOrWhiteSpace(_filtroOrden))
                    {
                        <div class="list-group position-absolute bg-white border rounded shadow-sm mt-1 w-100" style="z-index: 1050; max-height: 220px; overflow-y: auto;">
                            @foreach (var ord in _ordenesActivas)
                            {
                                <button type="button" class="list-group-item list-group-item-action py-1 px-2 small text-start"
                                        @onmousedown="() => SeleccionarOrdenSugeridaAsync(ord)">
                                    <strong>#@ord.IdOrdenAtencion</strong> | NHCL:@ord.Nhcl — @ord.Paciente <small class="text-muted">(@ord.Cliente)</small>
                                </button>
                            }
                        </div>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">Seleccionar Orden:</label>
                    <select class="form-select form-select-sm" value="@IdOrden" @onchange="OnOrdenChangedAsync">
                        <option value="0">-- Seleccione Paciente --</option>
                        @foreach (var ord in _ordenesActivas)
                        {
                            <option value="@ord.IdOrdenAtencion">#@ord.IdOrdenAtencion | NHCL:@ord.Nhcl - @ord.Paciente (@ord.Cliente)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 text-end pt-3">
                    @if (_paciente is not null)
                    {
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-primary fw-semibold" @onclick="GuardarFormularioAsync" disabled="@_guardando">
                                💾 @(_guardando ? "Guardando..." : "Guardar Formulario")
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="CrearNuevoFormularioAsync" disabled="@_guardando">
                                ➕ @(_guardando ? "Procesando..." : "Nueva Hoja")
                            </button>
                            <button class="btn btn-danger" @onclick="ExportarPdfAsync">
                                📄 PDF
                            </button>
                            <button class="btn btn-success" @onclick="ExportarExcelAsync">
                                📊 Excel
                            </button>
                            <button class="btn btn-dark" @onclick="ImprimirVistaAsync">
                                🖨️ Imprimir
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensajeAlerta))
    {
        <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small no-print">
            @_mensajeAlerta
            <button type="button" class="btn-close py-2" @onclick="() => _mensajeAlerta = null"></button>
        </div>
    }

    @if (_cargandoInicial)
    {
        <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="fw-semibold small">Cargando signos vitales y balance hídrico...</span>
        </div>
    }
    else
    {
        @if (_paciente is null)
        {
            <div class="alert alert-info shadow-sm">Vista previa de la hoja. Seleccione un paciente para habilitar el ingreso y guardado de información.</div>
        }
        <fieldset disabled="@(_paciente is null)" class="m-0 p-0 border-0">
        <div id="area-impresion-signos">
            <!-- CABECERA DEL PACIENTE -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-primary text-white py-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold fs-6">📈 SIGNOS VITALES Y BALANCE HÍDRICO</span>
                        <span class="badge bg-warning text-dark fw-bold fs-6 px-3 py-1 shadow-sm">HOJA #@_form.NumFormulario</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small fw-semibold text-white">N° Formulario:</span>
                        <select class="form-select form-select-sm w-auto bg-white text-dark fw-bold border-2 border-warning shadow-sm"
                                @bind:get="_form.NumFormulario"
                                @bind:set="CambiarHojaPorNumeroAsync">
                            @foreach (var nf in _form.FormulariosDisponibles)
                            {
                                <option value="@nf">Hoja #@nf</option>
                            }
                        </select>
                        @if (Permisos.Permite("kardex/enfermeria"))
                        {
                            <a href="/kardex/enfermeria/@IdOrden/@Nhcl" class="btn btn-sm btn-warning fw-semibold no-print">
                            💊 Ir a Kardex Medicación
                        </a>
                        }
                    </div>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="row text-center small g-2">
                        <div class="col-md-2 border-end">
                            <div class="text-muted">Historia (NHCL) / Orden</div>
                            <div class="fw-bold text-danger fs-6">@_pacienteVista.Nhcl <span class="text-secondary">(#@_pacienteVista.OrdenAtencionId)</span></div>
                        </div>
                        <div class="col-md-2 border-end">
                            <div class="text-muted">Paciente</div>
                            <div class="fw-bold fs-6">@(_pacienteVista.PacienteNombre.Length > 0 ? _pacienteVista.PacienteNombre : "—")</div>
                        </div>
                        <div class="col-md-2 border-end">
                            <div class="text-muted">Especie / Sexo</div>
                            <div class="fw-semibold text-success">@(_paciente is null ? "—" : $"{_pacienteVista.Especie} — {_pacienteVista.Sexo}")</div>
                        </div>
                        <div class="col-md-2 border-end">
                            <div class="text-muted">Edad</div>
                            <div class="fw-semibold">@(_paciente is null ? "—" : $"{_pacienteVista.Anios} años, {_pacienteVista.Meses} meses")</div>
                        </div>
                        <div class="col-md-3 border-end">
                            <div class="text-muted">Propietario</div>
                            <div class="fw-semibold">@(_pacienteVista.ClienteNombre.Length > 0 ? _pacienteVista.ClienteNombre : "—")</div>
                        </div>
                        <div class="col-md-1">
                            <div class="text-muted">Origen</div>
                            <span class="badge bg-danger">@(_pacienteVista.TipoOrigen.Length > 0 ? _pacienteVista.TipoOrigen : "—")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- GRÁFICA INTERACTIVA SVG DE PULSO Y TEMPERATURA (18 TURNOS) -->
            <div class="card shadow-sm border-0 mb-3" @key="@($"curva_{_form.NumFormulario}")">
                <div class="card-header bg-light py-1 px-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold small text-uppercase text-secondary">Curva Clínica de Pulso (Rojo) y Temperatura (Azul) — 9 Días (AM/PM)</span>
                    <div class="small">
                        <span class="badge bg-danger me-2">● Pulso (lpm)</span>
                        <span class="badge bg-primary">■ Temperatura (°C)</span>
                    </div>
                </div>
                <div class="card-body p-2 text-center">
                    <svg viewBox="0 0 900 190" style="width:100%; max-height:195px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px;">
                        @for (int g = 0; g <= 4; g++)
                        {
                            int y = 25 + (g * 32);
                            int pulsoLabel = 160 - (g * 30);
                            int tempLabel = 41 - g;
                            <line x1="55" y1="@y" x2="855" y2="@y" stroke="#cbd5e1" stroke-dasharray="3,3" stroke-width="1" />
                            <svg:text x="48" y="@(y + 4)" text-anchor="end" font-size="10" fill="#dc2626" font-weight="bold">@pulsoLabel</svg:text>
                            <svg:text x="862" y="@(y + 4)" text-anchor="start" font-size="10" fill="#2563eb" font-weight="bold">@(tempLabel)°C</svg:text>
                        }

                        @{
                            var puntosPulso = new List<string>();
                            var puntosTemp = new List<string>();
                            for (int i = 0; i < _form.SignosVitales.Count && i < 18; i++)
                            {
                                var slot = _form.SignosVitales[i];
                                double x = 75 + (i * 44.5);
                                <line x1="@x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y1="20"
                                      x2="@x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y2="155"
                                      stroke="#e2e8f0" stroke-width="1" />
                                <svg:text x="@x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" y="175"
                                          text-anchor="middle" font-size="9" fill="#475569">
                                    D@(slot.DiaIndice)@(slot.Turno)
                                </svg:text>

                                if (slot.Pulso.HasValue && slot.Pulso.Value > 0)
                                {
                                    double yp = 153 - ((Math.Clamp(slot.Pulso.Value, 40, 160) - 40) / 120.0 * 128.0);
                                    string pt = $"{x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)},{yp.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}";
                                    puntosPulso.Add(pt);
                                    <circle cx="@x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                            cy="@yp.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                            r="4" fill="#dc2626" />
                                }

                                if (slot.Temperatura.HasValue && slot.Temperatura.Value > 0)
                                {
                                    double yt = 153 - ((double)(Math.Clamp(slot.Temperatura.Value, 35m, 41m) - 35m) / 6.0 * 128.0);
                                    string ptT = $"{x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)},{yt.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}";
                                    puntosTemp.Add(ptT);
                                    <rect x="@((x - 3.5).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                                          y="@((yt - 3.5).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))"
                                          width="7" height="7" fill="#2563eb" />
                                }
                            }
                        }

                        @if (puntosPulso.Count > 1)
                        {
                            <polyline fill="none" stroke="#dc2626" stroke-width="2.2" points="@string.Join(" ", puntosPulso)" />
                        }
                        @if (puntosTemp.Count > 1)
                        {
                            <polyline fill="none" stroke="#2563eb" stroke-width="2.2" points="@string.Join(" ", puntosTemp)" />
                        }
                    </svg>
                </div>
            </div>

            <!-- 1. MATRIZ DE FECHAS Y SIGNOS VITALES (9 DÍAS / 18 TURNOS) -->
            <div class="card shadow-sm border-0 mb-3" @key="@($"signos_{_form.NumFormulario}")">
                <div class="card-header bg-primary bg-opacity-10 py-1 px-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold small text-primary">1. CUADRO DE SIGNOS VITALES (HOJA #@_form.NumFormulario — 9 DÍAS AM/PM)</span><span class="badge bg-primary">Hoja #@_form.NumFormulario</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size: 0.78rem;">
                        <thead class="table-light">
                            <tr>
                                <th class="text-start bg-secondary bg-opacity-10" style="min-width:155px;">FECHAS (9 Días)</th>
                                @foreach (var f in _form.Fechas)
                                {
                                    <th colspan="2" class="p-1">
                                        <input type="date" class="form-control form-control-sm px-1 py-0 text-center"
                                               style="font-size:0.74rem;" @bind="f.Fecha" />
                                    </th>
                                }
                            </tr>
                            <tr>
                                <th class="text-start bg-secondary bg-opacity-10">Días Internación</th>
                                @foreach (var f in _form.Fechas)
                                {
                                    <td colspan="2" class="p-1">
                                        <input type="number" min="0" class="form-control form-control-sm px-1 py-0 text-center fw-bold"
                                               @bind="f.DiasInternacion" />
                                    </td>
                                }
                            </tr>
                            <tr>
                                <th class="text-start bg-secondary bg-opacity-10">Días PostQuirúrgico</th>
                                @foreach (var f in _form.Fechas)
                                {
                                    <td colspan="2" class="p-1">
                                        <input type="number" min="0" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="f.DiasPostQuirurgico" />
                                    </td>
                                }
                            </tr>
                            <tr class="table-primary">
                                <th class="text-start">Turno (Mañana / Tarde)</th>
                                @foreach (var s in _form.SignosVitales)
                                {
                                    <th class="@(s.Turno == "AM" ? "text-primary" : "text-danger")">@s.Turno</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-start fw-bold text-danger bg-light">Pulso (lpm)</td>
                                @foreach (var s in _form.SignosVitales)
                                {
                                    <td class="p-1">
                                        <input type="number" class="form-control form-control-sm px-1 py-0 text-center text-danger fw-semibold"
                                               @bind="s.Pulso" @bind:event="oninput" />
                                    </td>
                                }
                            </tr>
                            <tr>
                                <td class="text-start fw-bold text-primary bg-light">Temperatura (°C)</td>
                                @foreach (var s in _form.SignosVitales)
                                {
                                    <td class="p-1">
                                        <input type="number" step="0.1" class="form-control form-control-sm px-1 py-0 text-center text-primary fw-semibold"
                                               @bind="s.Temperatura" @bind:event="oninput" />
                                    </td>
                                }
                            </tr>
                            <tr>
                                <td class="text-start fw-semibold bg-light">Frec. Respiratoria (rpm)</td>
                                @foreach (var s in _form.SignosVitales)
                                {
                                    <td class="p-1">
                                        <input type="number" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="s.FrecuenciaRespiratoria" @bind:event="oninput" />
                                    </td>
                                }
                            </tr>
                            <tr>
                                <td class="text-start fw-semibold bg-light">Presión Sistólica (mmHg)</td>
                                @foreach (var s in _form.SignosVitales)
                                {
                                    <td class="p-1">
                                        <input type="number" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="s.PresionSistolica" @bind:event="oninput" />
                                    </td>
                                }
                            </tr>
                            <tr>
                                <td class="text-start fw-semibold bg-light">Presión Diastólica (mmHg)</td>
                                @foreach (var s in _form.SignosVitales)
                                {
                                    <td class="p-1">
                                        <input type="number" class="form-control form-control-sm px-1 py-0 text-center"
                                               @bind="s.PresionDiastolica" @bind:event="oninput" />
                                    </td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. BALANCE HÍDRICO Y MEDICIONES (9 DÍAS) -->
            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 h-100" @key="@($"balance_{_form.NumFormulario}")">
                        <div class="card-header bg-success bg-opacity-10 py-1 px-3 d-flex justify-content-between align-items-center">
                            <span class="fw-bold small text-success">2. BALANCE HÍDRICO DIARIO — HOJA #@_form.NumFormulario (cc / ml)</span><span class="badge bg-success">Hoja #@_form.NumFormulario</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size: 0.78rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-start" style="min-width:135px;">Concepto</th>
                                        @for (int d = 1; d <= 9; d++)
                                        {
                                            <th>Día @d</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="text-start fw-semibold">Parenteral (cc)</td>
                                        @foreach (var b in _form.BalanceHidrico)
                                        {
                                            <td class="p-1"><input type="number" min="0" step="0.1" class="form-control form-control-sm px-1 py-0 text-center" @bind="b.Parenteral" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr>
                                        <td class="text-start fw-semibold">Vía Oral (cc)</td>
                                        @foreach (var b in _form.BalanceHidrico)
                                        {
                                            <td class="p-1"><input type="number" min="0" step="0.1" class="form-control form-control-sm px-1 py-0 text-center" @bind="b.ViaOral" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr class="table-success fw-bold">
                                        <td class="text-start">Total Ingresos</td>
                                        @foreach (var b in _form.BalanceHidrico)
                                        {
                                            <td>@b.TotalIngresos.ToString("N1")</td>
                                        }
                                    </tr>
                                    <tr>
                                        <td class="text-start fw-semibold">Orina (cc)</td>
                                        @foreach (var b in _form.BalanceHidrico)
                                        {
                                            <td class="p-1"><input type="number" min="0" step="0.1" class="form-control form-control-sm px-1 py-0 text-center" @bind="b.Orina" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr>
                                        <td class="text-start fw-semibold">Drenaje (cc)</td>
                                        @foreach (var b in _form.BalanceHidrico)
                                        {
                                            <td class="p-1"><input type="number" min="0" step="0.1" class="form-control form-control-sm px-1 py-0 text-center" @bind="b.Drenaje" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr>
                                        <td class="text-start fw-semibold">Otros (cc)</td>
                                        @foreach (var b in _form.BalanceHidrico)
                                        {
                                            <td class="p-1"><input type="number" min="0" step="0.1" class="form-control form-control-sm px-1 py-0 text-center" @bind="b.Otros" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr class="table-warning fw-bold">
                                        <td class="text-start">Total Eliminación</td>
                                        @foreach (var b in _form.BalanceHidrico)
                                        {
                                            <td>@b.TotalEliminaciones.ToString("N1")</td>
                                        }
                                    </tr>
                                    <tr class="table-info fw-bold">
                                        <td class="text-start">Balance Neto</td>
                                        @foreach (var b in _form.BalanceHidrico)
                                        {
                                            <td class="@(b.BalanceNeto < 0 ? "text-danger" : "text-primary")">@b.BalanceNeto.ToString("N1")</td>
                                        }
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 3. MEDICIONES Y ACTIVIDADES DE ENFERMERÍA -->
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 h-100" @key="@($"mediciones_{_form.NumFormulario}")">
                        <div class="card-header bg-info bg-opacity-10 py-1 px-3 d-flex justify-content-between align-items-center">
                            <span class="fw-bold small text-dark">3. MEDICIONES Y CUIDADOS DIARIOS — HOJA #@_form.NumFormulario</span><span class="badge bg-info text-dark">Hoja #@_form.NumFormulario</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size: 0.78rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th class="text-start" style="min-width:135px;">Actividad / Medición</th>
                                        @for (int d = 1; d <= 9; d++)
                                        {
                                            <th>Día @d</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="text-start fw-semibold">Peso (kg)</td>
                                        @foreach (var m in _form.Mediciones.Take(9))
                                        {
                                            <td class="p-1"><input type="number" step="0.1" class="form-control form-control-sm px-1 py-0 text-center" @bind="m.Peso" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr>
                                        <td class="text-start fw-semibold">Dieta Indicada</td>
                                        @foreach (var m in _form.Mediciones.Take(9))
                                        {
                                            <td class="p-1"><input type="text" class="form-control form-control-sm px-1 py-0 text-center" @bind="m.DietaIndicada" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr>
                                        <td class="text-start fw-semibold">N° Comidas</td>
                                        @foreach (var m in _form.Mediciones.Take(9))
                                        {
                                            <td class="p-1"><input type="text" class="form-control form-control-sm px-1 py-0 text-center" @bind="m.NumeroComidas" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr>
                                        <td class="text-start fw-semibold">Baño / Aseo</td>
                                        @foreach (var m in _form.Mediciones.Take(9))
                                        {
                                            <td class="p-1"><input type="text" class="form-control form-control-sm px-1 py-0 text-center" @bind="m.Banio" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr>
                                        <td class="text-start fw-semibold">Movilización</td>
                                        @foreach (var m in _form.Mediciones.Take(9))
                                        {
                                            <td class="p-1"><input type="text" class="form-control form-control-sm px-1 py-0 text-center" @bind="m.Movilizacion" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr>
                                        <td class="text-start fw-semibold">Vendajes / Curación</td>
                                        @foreach (var m in _form.Mediciones.Take(9))
                                        {
                                            <td class="p-1"><input type="text" class="form-control form-control-sm px-1 py-0 text-center" @bind="m.Vendajes" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr>
                                        <td class="text-start fw-semibold">Cambio de Sonda</td>
                                        @foreach (var m in _form.Mediciones.Take(9))
                                        {
                                            <td class="p-1"><input type="text" class="form-control form-control-sm px-1 py-0 text-center" @bind="m.CambioSonda" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                    <tr>
                                        <td class="text-start fw-semibold">Responsable (Inic.)</td>
                                        @foreach (var m in _form.Mediciones.Take(9))
                                        {
                                            <td class="p-1"><input type="text" class="form-control form-control-sm px-1 py-0 text-center fw-bold" @bind="m.Responsable" @bind:event="oninput" /></td>
                                        }
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </fieldset>
    }
</div>

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }

    private string _filtroOrden = string.Empty;
    private List<OrdenActivaResumenDto> _ordenesActivas = [];
    private PacienteHeaderDto? _paciente;
    private PacienteHeaderDto _pacienteVista => _paciente ?? new();
    private FormularioSignosEnfermeriaDto _form = CrearFormularioVacio();
    private bool _cargandoInicial = true;
    private bool _guardando;
    private string? _mensajeAlerta;
    private bool _esError;
    private int _ultimoIdOrdenCargado;
    private int _ultimoNhclCargado;

    private static FormularioSignosEnfermeriaDto CrearFormularioVacio() => new()
    {
        Fechas = Enumerable.Range(1, 9).Select(i => new EnfFechaDiaDto { Orden = i }).ToList(),
        SignosVitales = Enumerable.Range(1, 18).Select(i => new SignoVitalSlotDto { Orden = i }).ToList(),
        BalanceHidrico = Enumerable.Range(1, 9).Select(i => new EnfBalanceHidricoDiaDto { Orden = i }).ToList(),
        Mediciones = Enumerable.Range(1, 18).Select(i => new EnfMedicionDiaDto { Orden = i }).ToList()
    };

    protected override async Task OnInitializedAsync()
    {
        _cargandoInicial = true;
        await Task.Yield();
        _ordenesActivas = await KardexService.ObtenerOrdenesActivasAsync();

        if (IdOrden > 0)
        {
            _ultimoIdOrdenCargado = IdOrden;
            _ultimoNhclCargado = Nhcl;
            await CargarDatosPacienteAsync(IdOrden, Nhcl, 1);
        }
        _cargandoInicial = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_cargandoInicial && IdOrden > 0 && (IdOrden != _ultimoIdOrdenCargado || Nhcl != _ultimoNhclCargado))
        {
            _ultimoIdOrdenCargado = IdOrden;
            _ultimoNhclCargado = Nhcl;
            await CargarDatosPacienteAsync(IdOrden, Nhcl, 1);
        }
    }

    private bool _mostrarSugerenciasOrden;

    private async Task BuscarOrdenesAutoAsync()
    {
        await BuscarOrdenesAsync();
        _mostrarSugerenciasOrden = !string.IsNullOrWhiteSpace(_filtroOrden) && _ordenesActivas.Count > 0;
    }

    private async Task SeleccionarOrdenSugeridaAsync(OrdenActivaResumenDto ord)
    {
        _mostrarSugerenciasOrden = false;
        IdOrden = ord.IdOrdenAtencion;
        Nhcl = ord.Nhcl;
        _ultimoIdOrdenCargado = IdOrden;
        _ultimoNhclCargado = Nhcl;
        _mensajeAlerta = null;
        await CargarDatosPacienteAsync(IdOrden, Nhcl, 1);
    }

    private async Task CerrarSugerenciasOrdenConRetrasoAsync()
    {
        await Task.Delay(180);
        _mostrarSugerenciasOrden = false;
    }

    private async Task BuscarOrdenesAsync()
    {
        _mensajeAlerta = null;
        _ordenesActivas = await KardexService.ObtenerOrdenesActivasAsync(_filtroOrden);
    }

    private async Task LimpiarBusquedaAsync()
    {
        _mensajeAlerta = null;
        _filtroOrden = string.Empty;
        _mostrarSugerenciasOrden = false;
        _ordenesActivas = await KardexService.ObtenerOrdenesActivasAsync();
    }

    private async Task OnFiltroKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarOrdenesAsync();
        }
    }

    private async Task OnOrdenChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idOrd) && idOrd > 0)
        {
            var ord = _ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == idOrd);
            if (ord is not null)
            {
                IdOrden = ord.IdOrdenAtencion;
                Nhcl = ord.Nhcl;
                _ultimoIdOrdenCargado = IdOrden;
                _ultimoNhclCargado = Nhcl;
                _mensajeAlerta = null;
                await CargarDatosPacienteAsync(IdOrden, Nhcl, 1);
            }
        }
    }

    private async Task CargarDatosPacienteAsync(int idOrden, int nhcl, int numFormulario)
    {
        var tPac = KardexService.ObtenerCabeceraPacienteAsync(idOrden, nhcl);
        var tForm = HospService.CargarSignosEnfermeriaAsync(idOrden, nhcl, numFormulario);
        await Task.WhenAll(tPac, tForm);

        _paciente = await tPac;
        _form = await tForm;

        if (_paciente is null && idOrden > 0)
        {
            var ord = _ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == idOrden);
            if (ord is not null)
            {
                _paciente = new PacienteHeaderDto
                {
                    OrdenAtencionId = ord.IdOrdenAtencion,
                    Nhcl = ord.Nhcl,
                    PacienteNombre = ord.Paciente,
                    ClienteNombre = ord.Cliente,
                    Especie = ord.Especie,
                    Sexo = ord.Sexo,
                    MedicoResponsable = ord.Medico
                };
            }
        }

        if (_paciente is not null)
        {
            Nhcl = _paciente.Nhcl;
            Session.SeleccionarOrden(idOrden, Nhcl, _paciente.PacienteNombre);
        }
    }

    private async Task CambiarHojaPorNumeroAsync(int numForm)
    {
        if (_paciente is null) return;
        if (numForm == _form.NumFormulario && _form.SignosVitales.Count > 0) return;

        int idOrd = _paciente.OrdenAtencionId;
        int nhcl = _paciente.Nhcl;

        _mensajeAlerta = null;

        // 1. Guardar la hoja actual antes de cambiar
        if (_form is not null && _form.NumFormulario > 0)
        {
            _form.IdOrdenAtencion = idOrd;
            _form.Nhcl = nhcl;
            try
            {
                await HospService.GuardarSignosEnfermeriaAsync(_form, Session.IdUser);
            }
            catch (Exception ex)
            {
                _esError = true;
                _mensajeAlerta = $"No se pudo guardar la hoja actual. No se cambió de hoja: {ex.Message}";
                return;
            }
        }

        // 2. Cargar la hoja seleccionada en el dropdown
        try
        {
            _form = await HospService.CargarSignosEnfermeriaAsync(idOrd, nhcl, numForm);
            _esError = false;
            _mensajeAlerta = null;
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al cargar la Hoja #{numForm}: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task GuardarFormularioAsync()
    {
        if (_paciente is null) return;
        int idOrd = _paciente.OrdenAtencionId;
        int nhcl = _paciente.Nhcl;

        _guardando = true;
        _mensajeAlerta = null;
        try
        {
            _form.IdOrdenAtencion = idOrd;
            _form.Nhcl = nhcl;
            await HospService.GuardarSignosEnfermeriaAsync(_form, Session.IdUser);

            int numGuardado = _form.NumFormulario;
            _esError = false;
            _mensajeAlerta = $"Formulario #{numGuardado} de Signos Vitales y Balance Hídrico guardado correctamente en el sistema.";
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"No se pudo guardar el formulario: {ex.Message}";
        }
        finally
        {
            _guardando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CrearNuevoFormularioAsync()
    {
        if (_paciente is null) return;
        int idOrd = _paciente.OrdenAtencionId;
        int nhcl = _paciente.Nhcl;

        _guardando = true;
        try
        {
            if (_form is not null && _form.NumFormulario > 0)
            {
                _form.IdOrdenAtencion = idOrd;
                _form.Nhcl = nhcl;
                await HospService.GuardarSignosEnfermeriaAsync(_form, Session.IdUser);
            }

            int nuevo = await HospService.CrearNuevoFormularioSignosAsync(idOrd, nhcl, Session.IdUser);
            _form = await HospService.CargarSignosEnfermeriaAsync(idOrd, nhcl, nuevo);
            _esError = false;
            _mensajeAlerta = $"Se creó y cargó con éxito la Hoja #{nuevo} de Signos Vitales y Balance Hídrico.";
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"No se pudo crear la nueva hoja: {ex.Message}";
        }
        finally
        {
            _guardando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ExportarPdfAsync()
    {
        if (_paciente is null) return;
        int ordenId = _paciente.OrdenAtencionId > 0 ? _paciente.OrdenAtencionId : (IdOrden > 0 ? IdOrden : 1);
        var bytes = ReportService.GenerarSignosVitalesPdf(_paciente, _form);
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"SignosVitales_Orden{ordenId}_Hoja{_form.NumFormulario}.pdf", "application/pdf", b64);
    }

    private async Task ExportarExcelAsync()
    {
        if (_paciente is null) return;
        int ordenId = _paciente.OrdenAtencionId > 0 ? _paciente.OrdenAtencionId : (IdOrden > 0 ? IdOrden : 1);
        var bytes = ReportService.GenerarSignosVitalesExcel(_paciente, _form);
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"SignosVitales_Orden{ordenId}_Hoja{_form.NumFormulario}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", b64);
    }

    private async Task ImprimirVistaAsync()
    {
        await JS.InvokeVoidAsync("hosvetPrintElement", "area-impresion-signos");
    }
}
