@page "/admision/triaje"
@page "/admision/triaje/{IdOrden:int}/{Nhcl:int}"
@inject IConsultaExternaService ConsultaService
@inject IKardexService KardexService
@inject IAdmisionFacturacionService AdmisionService
@inject SessionStateService Session
@inject NavigationManager Nav

@if (!ModoModal)
{
    <PageTitle>Triaje de Ingreso y Constantes Fisiológicas — e-ForVets</PageTitle>

    <div class="container-fluid py-3 triaje-page">
        <!-- BARRA SUPERIOR DE SELECCIÓN Y ACCIONES -->
        <div class="card shadow-sm border-0 mb-3 bg-white triaje-heading">
            <div class="card-body py-2 px-3">
                <div class="row g-2 align-items-center">
                    <div class="col-12">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4 text-warning">🌡️</span>
                            <div>
                                <h1 class="mb-0 fw-bold text-dark">Triaje de Ingreso y Constantes</h1>
                                <small class="text-muted">Registro de signos vitales y evaluación inicial del paciente.</small>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="triaje-workspace">
            <aside class="triaje-queue"><ColaOrdenesClinicas @key="IdOrden" Triaje="true" OrdenSeleccionada="@(IdOrden ?? 0)" /></aside>
            <div class="triaje-content">

        <!-- Mensajes de feedback -->
        @if (!string.IsNullOrEmpty(_mensajeAlerta))
        {
            <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small shadow-sm" role="alert" style="max-width: 760px; margin: 0 auto 1rem auto;">
                <i class="bi @(_esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@_mensajeAlerta
                <button type="button" class="btn-close py-2" @onclick="() => _mensajeAlerta = null"></button>
            </div>
        }

        @if (_cargando)
        {
            <div class="d-flex align-items-center justify-content-center gap-2 text-primary py-4 px-2">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <span class="fw-semibold small">Cargando constantes del paciente...</span>
            </div>
        }
        else if (_paciente is null)
        {
            <div class="card shadow-sm border-0 py-5 text-center text-muted" style="max-width: 760px; margin: 0 auto;">
                <div class="card-body">
                    <span class="fs-1 d-block mb-2 text-secondary">🐾</span>
                    <h5>Ningún paciente seleccionado para triaje</h5>
                    <p class="small text-muted mb-3">
                        Selecciona una orden en la cola para cargar o ingresar sus constantes vitales.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="triaje-detail">
                <!-- BANNER DEL PACIENTE SELECCIONADO (modo página completa) -->
                <div class="card shadow-sm border-0 mb-3 bg-primary bg-opacity-10 triaje-patient">
                    <div class="card-body py-2 px-3">
                        <div class="triaje-patient-info">
                            <div class="triaje-avatar"><i class="bi bi-heart-pulse"></i><img src="@($"/pacientes-fotos/{_paciente.Nhcl}")" alt="Foto de @_paciente.PacienteNombre" onerror="this.style.display='none'" /></div>
                            <div class="triaje-patient-name"><strong>@_paciente.PacienteNombre</strong><small>@_paciente.Especie · @_paciente.Raza · @_paciente.Sexo · @_paciente.EdadTexto</small><span>HC: @_paciente.Nhcl</span></div>
                            <div class="triaje-patient-meta"><i class="bi bi-calendar2-check"></i><span><small>Orden</small><strong>#@_ficha.MedOrden</strong></span></div>
                            <div class="triaje-patient-meta"><i class="bi bi-person-fill"></i><span><small>Propietario</small><strong>@_paciente.PropietarioNombre</strong></span></div>
                        </div>
                    </div>
                </div>

                @RenderTarjetaTriaje()
            </div>
        }
            </div>
        </div>
    </div>
}
else
{
    <div class="triaje-modal-embedded">
        <!-- Mensajes de feedback -->
        @if (!string.IsNullOrEmpty(_mensajeAlerta))
        {
            <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small shadow-sm mb-3" role="alert">
                <i class="bi @(_esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@_mensajeAlerta
                <button type="button" class="btn-close py-2" @onclick="() => _mensajeAlerta = null"></button>
            </div>
        }

        @if (_cargando)
        {
            <div class="d-flex align-items-center justify-content-center gap-2 text-primary py-5">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <span class="fw-semibold small">Cargando constantes de la Orden #@(IdOrden ?? _ficha.MedOrden)...</span>
            </div>
        }
        else if (_paciente is null)
        {
            <div class="card shadow-sm border-0 py-4 text-center text-muted">
                <div class="card-body">
                    <span class="fs-1 d-block mb-2 text-warning">🌡️</span>
                    <h5>Selecciona una orden para ver o registrar el triaje</h5>
                    <p class="small text-muted mb-0">
                        Las constantes fisiológicas y el temperamento están enlazados a la orden de atención.
                    </p>
                </div>
            </div>
        }
        else
        {
            @RenderTarjetaTriaje()
        }
    </div>
}

@{
    RenderFragment RenderTarjetaTriaje() => @<div class="triaje-panel">
        @if (!ModoModal && Nhcl.GetValueOrDefault() > 0)
        {
            <button type="button" class="btn btn-sm btn-outline-primary mb-3" @onclick="() => _verHistorial = !_verHistorial">
                @(_verHistorial ? "Volver al triaje" : "Historial de triajes")
            </button>
        }
        @if (_verHistorial)
        {
            <HistorialTriaje Nhcl="@Nhcl.GetValueOrDefault()" />
        }
        else
        {
        <div class="card shadow-sm border-0 triaje-form-card">
        <div class="card-header bg-white fw-bold py-2 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-1">
                <span class="text-primary fs-5">🌡️</span>
                <span class="text-primary fw-bold fs-6">Constantes Fisiológicas y Triaje de Temperamento</span>
                @if (ModoModal && _ficha.MedOrden > 0)
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small ms-2">
                        Orden #@_ficha.MedOrden
                    </span>
                }
            </div>
            @if (!DesdeHistorial)
            {
                <span class="small text-muted">Responsable: @Session.NombreUsuario</span>
            }
        </div>
        <div class="card-body p-3 triaje-form-layout">
            <fieldset class="triaje-form-main" disabled="@SoloLectura">
            <div class="triaje-section-title"><i class="bi bi-clipboard2-pulse"></i> Información del triaje</div>
            <!-- Fila 1: Tipo de Consulta, Esterilizado, Sede / Tipo -->
            <div class="row g-2 mb-3">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold">Tipo de Consulta</label>
                    <select class="form-select form-select-sm" @bind="_ficha.MedTipoConsulta">
                        @foreach (var tipo in TiposConsultaDisponibles)
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>
                @if (!DesdeHistorial)
                {
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Esterilizado</label>
                        <select class="form-select form-select-sm" @bind="_ficha.Esterilizado">
                            <option value="S">SÍ</option>
                            <option value="N">NO</option>
                        </select>
                    </div>
                }
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Sede / Tipo</label>
                    <select class="form-select form-select-sm" @bind="_ficha.MedTipo">
                        <option value="HDEV">Doméstico (Mascotas)</option>
                        <option value="TUERI">Silvestre (Fauna)</option>
                    </select>
                </div>
            </div>

            <!-- Fila 2: Semáforo de Temperamento del Paciente -->
            <label class="form-label small fw-semibold d-block triaje-section-title"><i class="bi bi-heart-pulse"></i> Semáforo de Temperamento del Paciente</label>
            <div class="triaje-temperamentos mb-3" role="group" aria-label="Temperamento">
                <button type="button" class="btn btn-sm @(_ficha.Temperamento == "TRANQUILO" ? "btn-dark shadow-sm fw-bold" : "btn-outline-secondary")"
                        @onclick='() => SeleccionarTemperamento("TRANQUILO", "imagenes/temperamento/blanco.png", "green")'>
                    ⚪ Sociable
                </button>
                <button type="button" class="btn btn-sm @(_ficha.Temperamento == "NERVIOSO" ? "btn-success shadow-sm fw-bold" : "btn-outline-success")"
                        @onclick='() => SeleccionarTemperamento("NERVIOSO", "imagenes/temperamento/verde.png", "green")'>
                    🟢 Tímido
                </button>
                <button type="button" class="btn btn-sm @(_ficha.Temperamento == "A LA DEFENSIVA" ? "btn-warning text-dark shadow-sm fw-bold" : "btn-outline-warning text-dark")"
                        @onclick='() => SeleccionarTemperamento("A LA DEFENSIVA", "imagenes/temperamento/amarillo.png", "yellow")'>
                    🟡 Defensivo
                </button>
                <button type="button" class="btn btn-sm @(_ficha.Temperamento == "AGRESIVO" ? "btn-danger shadow-sm fw-bold" : "btn-outline-danger")"
                        @onclick='() => SeleccionarTemperamento("AGRESIVO", "imagenes/temperamento/rojo.png", "red")'>
                    🔴 Agresivo
                </button>
            </div>

            </fieldset>
            <fieldset class="triaje-vitals" disabled="@SoloLectura">
            <!-- Fila 3 y 4: Constantes Fisiológicas -->
            <div class="triaje-section-title"><i class="bi bi-heart"></i> Constantes Vitales</div>
            <div class="row g-2">
                <div class="col-4">
                    <label class="form-label small fw-semibold">Peso (kg)</label>
                    <input type="number" step="0.01" min="0" class="form-control form-control-sm fw-bold text-primary" @bind="_ficha.Peso" />
                </div>
                <div class="col-4">
                    <label class="form-label small fw-semibold">Temp (°C)</label>
                    <input type="number" step="0.1" min="0" class="form-control form-control-sm" @bind="_ficha.Temperatura" />
                </div>
                <div class="col-4">
                    <label class="form-label small fw-semibold">FC (lpm)</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="_ficha.FrecuenciaCardiaca" />
                </div>
                <div class="col-4">
                    <label class="form-label small fw-semibold">FR (rpm)</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="_ficha.FrecuenciaRespiratoria" />
                </div>
                <div class="col-4">
                    <label class="form-label small fw-semibold">TLLC (seg)</label>
                    <input type="number" min="0" class="form-control form-control-sm" @bind="_ficha.TiempoLlenadoCapilar" />
                </div>
                <div class="col-4">
                    <label class="form-label small fw-semibold">Deshidratación (%)</label>
                    <input type="number" min="0" max="100" class="form-control form-control-sm" @bind="_ficha.Deshidratacion" />
                </div>
                <div class="col-6 triaje-icc">
                    <label class="form-label small fw-semibold">Condición Corporal (ICC 1-9)</label>
                    <input type="range" class="form-range" min="1" max="9" @bind="_ficha.IndiceCondicionCorporal" />
                    <div class="text-center small fw-bold text-primary">ICC: @_ficha.IndiceCondicionCorporal / 9</div>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold">Pulso / CP</label>
                    <input type="text" class="form-control form-control-sm" @bind="_ficha.Cp" placeholder="Normal" />
                </div>
                <div class="col-12 mt-1">
                    <label class="form-label small fw-semibold">Observaciones triaje <small class="text-muted fw-normal">(opcional)</small></label>
                    <textarea class="form-control form-control-sm" rows="2" placeholder="Observaciones o notas de triaje..." @bind="_ficha.MedApuntes"></textarea>
                </div>
            </div>

            </fieldset>

            @if (_esOrdenProcedimiento && _ficha.MedOrden > 0 && _ficha.MedNhcl > 0)
            {
                <ProcedimientosTriaje @key="(_ficha.MedOrden, _ficha.MedNhcl)"
                                      IdOrden="@_ficha.MedOrden" Nhcl="@_ficha.MedNhcl"
                                      DesdeHistorial="@DesdeHistorial" SoloLectura="@(SoloLectura || _guardando)" />
            }

            <!-- Botones de Acción -->
            <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                @if (Permisos.Permite("consulta/fichamedica"))
                {
                    <a href="/consulta/fichamedica/@_ficha.MedOrden/@_ficha.MedNhcl" class="btn btn-sm btn-outline-primary fw-semibold">
                    <i class="bi bi-file-medical me-1"></i>Ver en SOAP
                </a>
                }
                @if (!SoloLectura)
                {
                    <button type="button" class="btn btn-success fw-bold px-4" @onclick="GuardarTriajeAsync" disabled="@_guardando">
                        <i class="bi bi-floppy-fill me-1"></i>@(_guardando ? "Guardando..." : "Guardar Constantes")
                    </button>
                }
            </div>
        </div>
        </div>
        }
    </div>;
}

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
    [Parameter] public int? IdOrden { get; set; }
    [Parameter] public int? Nhcl { get; set; }
    [Parameter] public bool ModoModal { get; set; }
    [Parameter] public bool DesdeHistorial { get; set; }
    [Parameter] public bool SoloLectura { get; set; }
    [Parameter] public EventCallback<FichaMedicaCompletaDto> OnGuardado { get; set; }

    private bool _cargando = true;
    private bool _guardando;
    private bool _verHistorial;
    private string? _mensajeAlerta;
    private bool _esError;

    private PacienteHeaderDto? _paciente;
    private int _especialidad;
    private bool _esOrdenProcedimiento;
    private FichaMedicaCompletaDto _ficha = new();
    private List<string> _tiposConsultaCatalogo = [];
    private IEnumerable<string> TiposConsultaDisponibles =>
        !string.IsNullOrWhiteSpace(_ficha.MedTipoConsulta) &&
        !_tiposConsultaCatalogo.Any(x => string.Equals(x, _ficha.MedTipoConsulta, StringComparison.OrdinalIgnoreCase))
            ? _tiposConsultaCatalogo.Append(_ficha.MedTipoConsulta)
            : _tiposConsultaCatalogo;

    private (int? Orden, int? Paciente, bool Modal)? _parametrosCargados;

    protected override async Task OnParametersSetAsync()
    {
        var parametros = (IdOrden, Nhcl, ModoModal);
        if (_parametrosCargados == parametros) return;
        _parametrosCargados = parametros;
        _verHistorial = false;

        _cargando = true;
        _paciente = null;
        _esOrdenProcedimiento = false;
        _mensajeAlerta = null;
        if ((IdOrden ?? 0) > 0 || (ModoModal && (Nhcl ?? 0) > 0))
            await CargarDatosAsync();
        _cargando = false;
    }

    private async Task CargarDatosAsync()
    {
        _mensajeAlerta = null;
        _esError = false;

        int ord = IdOrden ?? 0;
        int nh = Nhcl ?? 0;

        if (!Permisos.Permite("admision/triaje"))
        {
            _esError = true;
            _mensajeAlerta = "El triaje requiere una sesión de Enfermería o Administración.";
            return;
        }

        if (!DesdeHistorial)
        {
            var orden = (await AdmisionService.ObtenerColaClinicaAsync(triaje: true, idOrden: ord)).FirstOrDefault();
            if (orden is null)
            {
                _esError = true;
                _mensajeAlerta = "Esta orden ya no está disponible para triaje.";
                return;
            }
            Nhcl = nh = orden.Nhcl;
            _especialidad = orden.IdEspecialidad;
            _esOrdenProcedimiento = orden.EsProcedimiento;
        }

        _paciente = await KardexService.ObtenerEncabezadoPacienteAsync(ord, nh);
        if (_paciente != null && nh <= 0)
        {
            Nhcl = _paciente.Nhcl;
        }

        if (ord > 0 && !DesdeHistorial)
        {
            Session.SeleccionarOrden(ord, Nhcl ?? (_paciente?.Nhcl ?? 0), _paciente?.PacienteNombre);
        }

        if (DesdeHistorial && _paciente is not null)
            _esOrdenProcedimiento = (await AdmisionService.ObtenerOrdenesPacienteAsync(Nhcl ?? _paciente.Nhcl))
                .Any(orden => orden.IdOrden == ord && orden.EsProcedimiento);

        _tiposConsultaCatalogo = await ConsultaService.ObtenerTiposConsultaCatalogoAsync(Session.Localidad);
        _ficha = await ConsultaService.ObtenerFichaMedicaAsync(ord, Nhcl ?? (_paciente?.Nhcl ?? 0), historica: DesdeHistorial);
        if (string.IsNullOrWhiteSpace(_ficha.Temperamento))
        {
            _ficha.Temperamento = "TRANQUILO";
        }
    }

    private void SeleccionarTemperamento(string temperamento, string rutaImagen, string? colorSemaforo = null)
    {
        _ficha.Temperamento = temperamento;
        _ficha.ColorTriaje = rutaImagen;
    }

    private async Task GuardarTriajeAsync()
    {
        if (SoloLectura) return;
        int ord = IdOrden ?? _ficha.MedOrden;
        if (ord <= 0)
        {
            _esError = true;
            _mensajeAlerta = "Debe seleccionar un paciente con orden activa para guardar el triaje.";
            return;
        }

        _guardando = true;
        _mensajeAlerta = null;

        try
        {
            if (_ficha.MedOrden <= 0) _ficha.MedOrden = ord;
            if (_ficha.MedNhcl <= 0) _ficha.MedNhcl = Nhcl ?? (_paciente?.Nhcl ?? 0);
            if (_ficha.MedCliente <= 0 && _paciente != null) _ficha.MedCliente = _paciente.ClienteCodigo;
            if (string.IsNullOrEmpty(_ficha.MedEspecie) && _paciente != null) _ficha.MedEspecie = _paciente.Especie;

            int idUsuario = Session.UsuarioActual?.IdUsuario ?? Session.IdUser;
            if (idUsuario <= 0 || !Permisos.Permite("admision/triaje"))
            {
                _esError = true;
                _mensajeAlerta = "El triaje requiere una sesión de Enfermería o Administración.";
                return;
            }

            if (!DesdeHistorial) _ficha.MedEspecialidad = _especialidad;
            bool exito = await ConsultaService.GuardarFichaMedicaAsync(_ficha, idUsuario, triaje: true, editarTriaje: DesdeHistorial);

            _esError = !exito;
            _mensajeAlerta = exito
                ? "Constantes de triaje guardadas exitosamente y sincronizadas con la Historia Clínica SOAP."
                : "No fue posible guardar las constantes de triaje. Si está editando el historial, compruebe si ya se guardó la anamnesis.";

            if (exito)
            {
                if (!DesdeHistorial)
                    Session.SeleccionarOrden(_ficha.MedOrden, _ficha.MedNhcl, _paciente?.PacienteNombre);
                if (!ModoModal)
                    Nav.NavigateTo("/admision/triaje");
                if (OnGuardado.HasDelegate)
                {
                    await OnGuardado.InvokeAsync(_ficha);
                }
            }
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al guardar constantes: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }
}
