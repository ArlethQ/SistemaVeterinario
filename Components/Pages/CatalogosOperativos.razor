@page "/administracion/catalogos-operativos"
@page "/administracion/diagnosticos"
@page "/administracion/productos"
@page "/facturacion/productos"
@using ClosedXML.Excel
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject IGestionMigradaService Service
@inject IEFactCatalogService EFactCatalog
@inject SessionStateService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<CatalogosOperativos> Logger

<PageTitle>@(TituloSeccion) | e-ForVets</PageTitle>

@if (_autorizado)
{
    <div class="container-fluid py-3">
        <h2>@TituloSeccion</h2>
        <div class="card mb-3 shadow-sm">
            <div class="card-body py-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1">Catálogo</label>
                        <select class="form-select form-select-sm" @bind="_tipo" @bind:after="AlCambiarCatalogo">
                            @if (_seccion != "productos")
                            {
                                <optgroup label="Diagnósticos">
                                    <option value="diagnosticos">Diagnósticos CIE-10</option>
                                    <option value="grupos-diagnosticos">Grupos diagnósticos</option>
                                </optgroup>
                            }
                            @if (_seccion != "diagnosticos")
                            {
                                <optgroup label="Productos de la veterinaria">
                                    <option value="productos">Productos e insumos</option>
                                    <option value="grupos-productos">Categorías de productos</option>
                                    <option value="subgrupos-productos">Subcategorías de productos</option>
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Buscar por nombre o código</label>
                        <input class="form-control form-control-sm" placeholder="Ej. nombre, código, categoría..." @bind="_filtro" @bind:event="oninput" @bind:after="ReiniciarPagina" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted mb-1">Estado</label>
                        <select class="form-select form-select-sm" @bind="_filtroEstado" @bind:after="ReiniciarPagina">
                            <option value="">Todos los estados</option>
                            <option value="A">Solo Activos</option>
                            <option value="I">Solo Inactivos</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2 justify-content-end">
                        @if (TieneFiltrosActivos)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="LimpiarFiltros">Limpiar filtros</button>
                        }
                        <button class="btn btn-sm btn-primary" @onclick="Nuevo">+ Nuevo registro</button>
                    </div>
                </div>

                @if (_tipo is "productos" or "grupos-productos" or "subgrupos-productos" or "diagnosticos")
                {
                    <div class="row g-2 mt-1 pt-2 border-top align-items-end">
                        @if (_tipo is "productos" or "grupos-productos")
                        {
                            <div class="col-md-2">
                                <label class="form-label small text-muted mb-1">Bien / Servicio</label>
                                <select class="form-select form-select-sm" @bind="_filtroTipo" @bind:after="AlCambiarFiltroTipo">
                                    <option value="">Todos (B y S)</option>
                                    <option value="B">Solo Bienes (B)</option>
                                    <option value="S">Solo Servicios (S)</option>
                                </select>
                            </div>
                        }
                        @if (MuestraGrupo)
                        {
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1">@EtiquetaGrupo</label>
                                <select class="form-select form-select-sm" @bind="_filtroGrupo" @bind:after="AlCambiarFiltroGrupo">
                                    <option value="">Todas (@EtiquetaGrupo.ToLower())</option>
                                    <option value="-1">Sin @EtiquetaGrupo.ToLower()</option>
                                    @foreach (var g in GruposParaFiltro)
                                    {
                                        <option value="@g.Id">@g.Descripcion</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (_tipo == "productos")
                        {
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1">Subcategoría</label>
                                <select class="form-select form-select-sm" @bind="_filtroSubgrupo" @bind:after="ReiniciarPagina">
                                    <option value="">Todas las subcategorías</option>
                                    <option value="-1">Sin subcategoría</option>
                                    @foreach (var s in SubgruposParaFiltro)
                                    {
                                        <option value="@s.Id">@s.Descripcion</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small text-muted mb-1">Inventario</label>
                                <select class="form-select form-select-sm" @bind="_filtroInventario" @bind:after="ReiniciarPagina">
                                    <option value="">Todos</option>
                                    <option value="1">Va al inventario</option>
                                    <option value="0">Sin inventario</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small text-muted mb-1">Impuesto (IVA)</label>
                                <select class="form-select form-select-sm" @bind="_filtroIva" @bind:after="ReiniciarPagina">
                                    <option value="">Todos</option>
                                    <option value="CON">Con IVA</option>
                                    <option value="SIN">Sin IVA</option>
                                </select>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        @if (_tipo == "productos")
        {
            <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
                <div>
                    <label for="productos-excel" class="form-label small mb-1">Importar Excel (.xlsx)</label>
                    <InputFile id="productos-excel" class="form-control form-control-sm" accept=".xlsx"
                               OnChange="ImportarProductosExcelAsync" disabled="@_importandoExcel" />
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="DescargarPlantillaExcelAsync">Descargar plantilla</button>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ExportarProductosExcelAsync" disabled="@_importandoExcel">Exportar Excel</button>
            </div>
            @if (_importandoExcel)
            {
                <p role="status">Importando productos y servicios…</p>
            }
        }
        @if (!string.IsNullOrEmpty(_mensaje)) { <div class="alert @(_error ? "alert-danger" : "alert-success")">@_mensaje</div> }
        @if (_cargando)
        {
            <div class="alert alert-info py-2 d-flex align-items-center gap-2">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <span>Cargando catálogo...</span>
            </div>
        }
        @if (_pendienteEliminar is not null) { <div class="alert alert-warning d-flex align-items-center justify-content-between"><span>¿Desactivar <strong>@_pendienteEliminar.Descripcion</strong> del catálogo local?</span><span><button class="btn btn-sm btn-danger me-2" @onclick="ConfirmarEliminar">Sí, desactivar</button><button class="btn btn-sm btn-outline-secondary" @onclick="CancelarEliminar">Cancelar</button></span></div> }
        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span class="small text-muted">
                            @if (TotalFiltrados == 0)
                            {
                                <span>No se encontraron registros</span>
                            }
                            else
                            {
                                <span>Mostrando <strong>@IndiceInicio</strong> a <strong>@IndiceFin</strong> de <strong>@TotalFiltrados</strong> registros @(TotalFiltrados != _items.Count ? $"(filtrado de {_items.Count} totales)" : "")</span>
                            }
                        </span>
                        <div class="d-flex align-items-center gap-2">
                            <label class="small text-muted mb-0">Mostrar:</label>
                            <select class="form-select form-select-sm" style="width: auto;" @bind="_tamanoPagina" @bind:after="ReiniciarPagina">
                                <option value="20">20 por pág.</option>
                                <option value="30">30 por pág.</option>
                                <option value="50">50 por pág.</option>
                                <option value="100">100 por pág.</option>
                            </select>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Código</th><th>Descripción</th>@if (MuestraGrupo){<th>@EtiquetaGrupo</th>}@if (_tipo == "grupos-productos"){<th>Aplica para</th>}@if (_tipo == "productos"){<th>Subcategoría</th><th>Tipo</th><th>IVA</th><th class="text-end">Precio</th>}<th>Estado</th><th>Acciones</th></tr></thead>
                            <tbody>
                                @if (Paginados.Any())
                                {
                                    @foreach (var x in Paginados)
                                    {
                                        <tr>
                                            <td>@(_tipo == "productos" && !string.IsNullOrWhiteSpace(x.Codigo) ? x.Codigo : x.Id)</td>
                                            <td>@x.Descripcion</td>
                                            @if (MuestraGrupo)
                                            {
                                                <td>@(string.IsNullOrWhiteSpace(x.Grupo) ? "Sin categoría" : x.Grupo)</td>
                                            }
                                            @if (_tipo == "grupos-productos")
                                            {
                                                <td>
                                                    @if (x.Tipo == "S")
                                                    {
                                                        <span class="badge text-bg-secondary">Servicios (0)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-primary">Bienes (1)</span>
                                                    }
                                                </td>
                                            }
                                            @if (_tipo == "productos")
                                            {
                                                <td>@(string.IsNullOrWhiteSpace(x.Subgrupo) ? "Sin subcategoría" : x.Subgrupo)</td>
                                                <td>
                                                    @if (x.Tipo == "S" || x.Tipo == "SERVICIO")
                                                    {
                                                        <span class="badge text-bg-secondary">Servicio (S)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-primary">Bien (B)</span>
                                                        @if (x.Inventario)
                                                        {
                                                            <span class="badge text-bg-info ms-1" title="Va al inventario">Inventario</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge text-bg-light border ms-1" title="No va al inventario">Sin inv.</span>
                                                        }
                                                    }
                                                </td>
                                                <td>@TarifaDescripcion(x)</td>
                                                <td class="text-end">@x.Precio?.ToString("C2")</td>
                                            }
                                            <td>@(x.Estado == "I" ? "Inactivo" : "Activo")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    @if (_tipo == "productos")
                                                    {
                                                        <button class="btn btn-outline-info" title="Ver" @onclick="() => Ver(x)">Ver</button>
                                                    }
                                                    <button class="btn btn-outline-primary" title="Editar" @onclick="() => Editar(x)">Editar</button>
                                                    @if (_tipo == "productos")
                                                    {
                                                        <button class="btn btn-outline-danger" title="Eliminar" @onclick="() => PrepararEliminar(x)">Eliminar</button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-4">No hay registros que coincidan con los filtros seleccionados.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (TotalPaginas > 1)
                    {
                        <div class="card-footer bg-light py-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <span class="small text-muted">Página <strong>@_paginaActual</strong> de <strong>@TotalPaginas</strong></span>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" disabled="@(_paginaActual <= 1)" @onclick="() => IrAPagina(1)" title="Primera página">«</button>
                                <button class="btn btn-outline-secondary" disabled="@(_paginaActual <= 1)" @onclick="() => IrAPagina(_paginaActual - 1)" title="Anterior">‹ Anterior</button>
                                @foreach (var p in PaginasVisibles)
                                {
                                    <button class="btn @(p == _paginaActual ? "btn-primary" : "btn-outline-secondary")" @onclick="() => IrAPagina(p)">@p</button>
                                }
                                <button class="btn btn-outline-secondary" disabled="@(_paginaActual >= TotalPaginas)" @onclick="() => IrAPagina(_paginaActual + 1)" title="Siguiente">Siguiente ›</button>
                                <button class="btn btn-outline-secondary" disabled="@(_paginaActual >= TotalPaginas)" @onclick="() => IrAPagina(TotalPaginas)" title="Última página">»</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4"><div class="card"><div class="card-body">
                <h5>@(_edit.Id > 0 ? "Editar" : "Nuevo")</h5>
                <label>Descripción</label><input class="form-control mb-2" maxlength="300" @bind="_edit.Descripcion" @bind:event="oninput" />
                @if (_tipo == "productos")
                {
                    <label>Tipo</label><select class="form-select mb-2" @bind="_edit.Tipo" @bind:after="CambiarTipoProducto"><option value="B">Bien (B)</option><option value="S">Servicio (S)</option></select>
                    @if (_edit.Tipo == "B")
                    {
                        <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="checkInventario" @bind="_edit.Inventario" /><label class="form-check-label" for="checkInventario">Va al inventario</label></div>
                    }
                }
                @if (MuestraGrupo)
                {
                    <label>@EtiquetaGrupo</label><select class="form-select mb-2" @bind="_edit.IdGrupo" @bind:after="CambiarCategoria"><option value="">Seleccione</option>@foreach (var g in CategoriasDisponibles) { <option value="@g.Id">@g.Descripcion</option> }</select>
                }
                @if (_tipo == "productos")
                {
                    <label>Subcategoría</label><select class="form-select mb-2" @bind="_edit.IdSubgrupo"><option value="">Sin subcategoría</option>@foreach (var s in SubcategoriasDisponibles) { <option value="@s.Id">@s.Descripcion</option> }</select>
                    <label>Código (opcional)</label><input class="form-control mb-2" maxlength="50" @bind="_edit.Codigo" @bind:event="oninput" />
                    <label>Precio base</label><input class="form-control mb-2" type="number" min="0" max="99999999.99" step="0.01" @bind="_edit.Precio" />
                    <div class="row g-2"><div class="col-6"><label>Precio 2 (opcional)</label><input class="form-control mb-2" type="number" min="0" max="99999999.99" step="0.01" @bind="_edit.Precio2" /></div><div class="col-6"><label>Precio 3 (opcional)</label><input class="form-control mb-2" type="number" min="0" max="99999999.99" step="0.01" @bind="_edit.Precio3" /></div></div>
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="aplicaIva" @bind="_aplicaIva" @bind:after="CambiarIva" /><label class="form-check-label" for="aplicaIva">IVA (opcional)</label></div>
                    @if (_aplicaIva)
                    {
                        <label>Tarifa IVA</label><select class="form-select mb-2" @bind="_edit.PorcentajeImpuesto"><option value="">Seleccione</option>@foreach (var tarifa in _tarifas) { <option value="@tarifa.Codigo">@tarifa.Descripcion</option> }</select>
                    }
                }
                else if (_tipo == "grupos-productos")
                {
                    <label>Aplica para</label><select class="form-select mb-2" @bind="_edit.Tipo" disabled="@(_edit.Id > 0)"><option value="B">Bienes (1)</option><option value="S">Servicios (0)</option></select>
                    @if (_edit.Id > 0)
                    {
                        <small class="text-muted d-block mt-n1 mb-2">No se puede cambiar el tipo una vez creada la categoría para evitar inconsistencias con los productos asignados.</small>
                    }
                }
                else if (!EsGrupo && _tipo != "laboratorio" && _tipo != "subgrupos-productos")
                {
                    <label>Tipo</label><input class="form-control mb-2" maxlength="1" @bind="_edit.Tipo" />
                }
                <label>Estado</label><select class="form-select mb-3" @bind="_edit.Estado"><option value="A">Activo</option><option value="I">Inactivo</option></select>
                <button type="button" class="btn btn-primary" disabled="@_guardando" @onclick="Guardar">
                    @if (_guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar</span>
                    }
                </button>
            </div></div></div>
        </div>
        @if (_vista is not null)
        {
            <div class="card mt-3 border-info"><div class="card-header d-flex justify-content-between"><strong>Detalle del producto</strong><button class="btn-close" @onclick="CerrarVista"></button></div><div class="card-body"><div class="row g-3"><div class="col-md-4"><small class="text-muted d-block">Nombre</small><strong>@_vista.Descripcion</strong></div><div class="col-md-2"><small class="text-muted d-block">Código</small><strong>@(string.IsNullOrWhiteSpace(_vista.Codigo) ? $"#{_vista.Id}" : _vista.Codigo)</strong></div><div class="col-md-2"><small class="text-muted d-block">Tipo</small><strong>@(_vista.Tipo == "S" || _vista.Tipo == "SERVICIO" ? "Servicio (S)" : "Bien (B)")</strong></div>@if (_vista.Tipo != "S" && _vista.Tipo != "SERVICIO"){<div class="col-md-2"><small class="text-muted d-block">Inventario</small><strong>@(_vista.Inventario ? "Sí va al inventario" : "No va al inventario")</strong></div>}<div class="col-md-2"><small class="text-muted d-block">Precio base</small><strong>@_vista.Precio?.ToString("C2")</strong></div><div class="col-md-2"><small class="text-muted d-block">IVA</small><strong>@TarifaDescripcion(_vista)</strong></div><div class="col-md-4"><small class="text-muted d-block">Categoría</small><strong>@(string.IsNullOrWhiteSpace(_vista.Grupo) ? "Sin categoría" : _vista.Grupo)</strong></div><div class="col-md-4"><small class="text-muted d-block">Subcategoría</small><strong>@(string.IsNullOrWhiteSpace(_vista.Subgrupo) ? "Sin subcategoría" : _vista.Subgrupo)</strong></div><div class="col-md-2"><small class="text-muted d-block">Precio 2</small><strong>@(_vista.Precio2?.ToString("C2") ?? "—")</strong></div><div class="col-md-2"><small class="text-muted d-block">Precio 3</small><strong>@(_vista.Precio3?.ToString("C2") ?? "—")</strong></div><div class="col-md-2"><small class="text-muted d-block">Estado</small><strong>@(_vista.Estado == "I" ? "Inactivo" : "Activo")</strong></div></div></div></div>
        }
    </div>
}

@code {
    private bool _autorizado, _error, _aplicaIva;
    private string _tipo = "diagnosticos", _filtro = "", _mensaje = "", _seccion = "general";
    private string _filtroTipo = "", _filtroGrupo = "", _filtroSubgrupo = "", _filtroInventario = "", _filtroIva = "", _filtroEstado = "";
    private int _paginaActual = 1, _tamanoPagina = 20;

    private string TituloSeccion => _seccion switch
    {
        "diagnosticos" => "Diagnósticos CIE-10",
        "productos" => "Productos y servicios de la veterinaria",
        _ => "Diagnósticos y productos"
    };
    private List<CatalogoOperativoDto> _items = [], _grupos = [], _subgrupos = [];
    private List<TarifaIvaDto> _tarifas = [];
    private CatalogoOperativoDto _edit = new();
    private CatalogoOperativoDto? _vista;
    private CatalogoOperativoDto? _pendienteEliminar;
    private bool EsGrupo => _tipo.StartsWith("grupos-", StringComparison.Ordinal);
    private bool MuestraGrupo => !EsGrupo && _tipo != "grupos-productos";
    private string EtiquetaGrupo => _tipo is "productos" or "subgrupos-productos" ? "Categoría" : "Grupo";
    private string TipoGrupo => _tipo switch { "diagnosticos" => "grupos-diagnosticos", "productos" or "subgrupos-productos" => "grupos-productos", "laboratorio" => "grupos-laboratorio", _ => "" };

    private bool TieneFiltrosActivos =>
        !string.IsNullOrWhiteSpace(_filtro) ||
        !string.IsNullOrWhiteSpace(_filtroTipo) ||
        !string.IsNullOrWhiteSpace(_filtroGrupo) ||
        !string.IsNullOrWhiteSpace(_filtroSubgrupo) ||
        !string.IsNullOrWhiteSpace(_filtroInventario) ||
        !string.IsNullOrWhiteSpace(_filtroIva) ||
        !string.IsNullOrWhiteSpace(_filtroEstado);

    private IEnumerable<CatalogoOperativoDto> GruposParaFiltro =>
        _tipo == "productos" && !string.IsNullOrWhiteSpace(_filtroTipo)
            ? _grupos.Where(g => _filtroTipo == "S" ? g.Tipo == "S" : (g.Tipo == "B" || string.IsNullOrEmpty(g.Tipo)))
            : _grupos;

    private IEnumerable<CatalogoOperativoDto> SubgruposParaFiltro
    {
        get
        {
            if (int.TryParse(_filtroGrupo, out var idGrupo) && idGrupo > 0)
                return _subgrupos.Where(s => s.IdGrupo == idGrupo);
            if (!string.IsNullOrWhiteSpace(_filtroTipo))
            {
                var idsCategorias = GruposParaFiltro.Select(g => g.Id).ToHashSet();
                return _subgrupos.Where(s => s.IdGrupo.HasValue && idsCategorias.Contains(s.IdGrupo.Value));
            }
            return _subgrupos;
        }
    }

    private IEnumerable<CatalogoOperativoDto> CategoriasDisponibles =>
        _tipo == "productos"
            ? _grupos.Where(g => _edit.Tipo == "S" ? (g.Tipo == "S") : (g.Tipo == "B" || string.IsNullOrEmpty(g.Tipo)))
            : _grupos;
    private IEnumerable<CatalogoOperativoDto> SubcategoriasDisponibles => _subgrupos.Where(x => x.IdGrupo == _edit.IdGrupo);

    private List<CatalogoOperativoDto> Filtrados
    {
        get
        {
            IEnumerable<CatalogoOperativoDto> query = _items;

            if (!string.IsNullOrWhiteSpace(_filtro))
            {
                var f = _filtro.Trim();
                query = query.Where(x =>
                    x.Descripcion.Contains(f, StringComparison.OrdinalIgnoreCase) ||
                    x.Codigo.Contains(f, StringComparison.OrdinalIgnoreCase) ||
                    x.Id.ToString().Contains(f, StringComparison.OrdinalIgnoreCase) ||
                    x.Grupo.Contains(f, StringComparison.OrdinalIgnoreCase) ||
                    x.Subgrupo.Contains(f, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_filtroEstado))
            {
                query = query.Where(x => (x.Estado == "I" ? "I" : "A") == _filtroEstado);
            }

            if (_tipo is "productos" or "grupos-productos" && !string.IsNullOrWhiteSpace(_filtroTipo))
            {
                query = query.Where(x =>
                    _filtroTipo == "S"
                        ? (x.Tipo == "S" || x.Tipo == "SERVICIO")
                        : (x.Tipo != "S" && x.Tipo != "SERVICIO"));
            }

            if (MuestraGrupo && int.TryParse(_filtroGrupo, out var idGrupo))
            {
                if (idGrupo == -1)
                    query = query.Where(x => !x.IdGrupo.HasValue || x.IdGrupo.Value <= 0 || string.IsNullOrWhiteSpace(x.Grupo));
                else if (idGrupo > 0)
                    query = query.Where(x => x.IdGrupo == idGrupo);
            }

            if (_tipo == "productos" && int.TryParse(_filtroSubgrupo, out var idSubgrupo))
            {
                if (idSubgrupo == -1)
                    query = query.Where(x => !x.IdSubgrupo.HasValue || x.IdSubgrupo.Value <= 0 || string.IsNullOrWhiteSpace(x.Subgrupo));
                else if (idSubgrupo > 0)
                    query = query.Where(x => x.IdSubgrupo == idSubgrupo);
            }

            if (_tipo == "productos" && !string.IsNullOrWhiteSpace(_filtroInventario))
            {
                var conInv = _filtroInventario == "1";
                query = query.Where(x =>
                {
                    var esServ = x.Tipo == "S" || x.Tipo == "SERVICIO";
                    var vaInv = !esServ && x.Inventario;
                    return vaInv == conInv;
                });
            }

            if (_tipo == "productos" && !string.IsNullOrWhiteSpace(_filtroIva))
            {
                var conIva = _filtroIva == "CON";
                query = query.Where(x => (x.CodigoImpuesto == "2") == conIva);
            }

            return query.ToList();
        }
    }

    private int TotalFiltrados => Filtrados.Count;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(TotalFiltrados / (double)_tamanoPagina));
    private int IndiceInicio => TotalFiltrados == 0 ? 0 : ((_paginaActual - 1) * _tamanoPagina) + 1;
    private int IndiceFin => Math.Min(_paginaActual * _tamanoPagina, TotalFiltrados);

    private IEnumerable<CatalogoOperativoDto> Paginados =>
        Filtrados
            .Skip((Math.Clamp(_paginaActual, 1, TotalPaginas) - 1) * _tamanoPagina)
            .Take(_tamanoPagina);

    private IEnumerable<int> PaginasVisibles
    {
        get
        {
            var total = TotalPaginas;
            var actual = Math.Clamp(_paginaActual, 1, total);
            var inicio = Math.Max(1, actual - 2);
            var fin = Math.Min(total, inicio + 4);
            if (fin - inicio < 4)
                inicio = Math.Max(1, fin - 4);
            return Enumerable.Range(inicio, fin - inicio + 1);
        }
    }

    private void ReiniciarPagina() => _paginaActual = 1;

    private void IrAPagina(int pagina)
    {
        _paginaActual = Math.Clamp(pagina, 1, TotalPaginas);
    }

    private void AlCambiarFiltroTipo()
    {
        if (int.TryParse(_filtroGrupo, out var idGrupo) && idGrupo > 0)
        {
            if (!GruposParaFiltro.Any(g => g.Id == idGrupo))
            {
                _filtroGrupo = "";
                _filtroSubgrupo = "";
            }
        }
        _paginaActual = 1;
    }

    private void AlCambiarFiltroGrupo()
    {
        if (int.TryParse(_filtroSubgrupo, out var idSub) && idSub > 0)
        {
            if (!SubgruposParaFiltro.Any(s => s.Id == idSub))
            {
                _filtroSubgrupo = "";
            }
        }
        _paginaActual = 1;
    }

    private void LimpiarFiltros()
    {
        _filtro = "";
        _filtroTipo = "";
        _filtroGrupo = "";
        _filtroSubgrupo = "";
        _filtroInventario = "";
        _filtroIva = "";
        _filtroEstado = "";
        _paginaActual = 1;
    }

    private async Task AlCambiarCatalogo()
    {
        LimpiarFiltros();
        await Cargar();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || Session.TipoUser != 1) { Nav.NavigateTo("/dashboard"); return; }
        _autorizado = true;
        Nav.LocationChanged -= OnLocationChanged;
        Nav.LocationChanged += OnLocationChanged;
        _ultimaRutaCargada = Nav.Uri;
        ActualizarSeccionDesdeRuta(Nav.Uri);
        await Cargar();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_autorizado) return;
        await SincronizarRutaAsync(Nav.Uri);
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!_autorizado) return;
        try
        {
            await InvokeAsync(() => SincronizarRutaAsync(e.Location));
        }
        catch (Exception ex)
        {
            _error = true;
            _mensaje = $"No se pudo cambiar de catálogo: {ex.Message}";
            _cargando = false;
            try { await InvokeAsync(StateHasChanged); } catch { }
        }
    }

    private async Task SincronizarRutaAsync(string uri)
    {
        if (string.Equals(_ultimaRutaCargada, uri, StringComparison.OrdinalIgnoreCase))
            return;

        _ultimaRutaCargada = uri;
        var seccionAnterior = _seccion;
        var tipoAnterior = _tipo;
        ActualizarSeccionDesdeRuta(uri);
        if (seccionAnterior != _seccion || tipoAnterior != _tipo)
        {
            _mensaje = "";
            _error = false;
            _vista = null;
            _pendienteEliminar = null;
            _items = [];
            _grupos = [];
            _subgrupos = [];
            _cargando = true;
            LimpiarFiltros();
            StateHasChanged();
            try
            {
                await Cargar();
            }
            finally
            {
                _cargando = false;
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void ActualizarSeccionDesdeRuta(string? uriActual = null)
    {
        var uri = uriActual ?? Nav.Uri;
        if (uri.Contains("/administracion/diagnosticos", StringComparison.OrdinalIgnoreCase))
        {
            _seccion = "diagnosticos";
            if (_tipo is not ("diagnosticos" or "grupos-diagnosticos"))
                _tipo = "diagnosticos";
        }
        else if (uri.Contains("/administracion/productos", StringComparison.OrdinalIgnoreCase) ||
                 uri.Contains("/facturacion/productos", StringComparison.OrdinalIgnoreCase))
        {
            _seccion = "productos";
            if (_tipo is not ("productos" or "grupos-productos" or "subgrupos-productos"))
                _tipo = "productos";
        }
        else
        {
            _seccion = "general";
        }
    }
    private async Task Cargar()
    {
        var tItems = Service.ObtenerCatalogoAsync(_tipo);
        var tGrupos = MuestraGrupo ? Service.ObtenerCatalogoAsync(TipoGrupo) : Task.FromResult(new List<CatalogoOperativoDto>());
        var tSubgrupos = _tipo == "productos" ? Service.ObtenerCatalogoAsync("subgrupos-productos") : Task.FromResult(new List<CatalogoOperativoDto>());
        var tTarifas = _tipo == "productos" ? EFactCatalog.ObtenerTarifasIvaAsync() : Task.FromResult(new List<TarifaIvaDto>());

        await Task.WhenAll(tItems, tGrupos, tSubgrupos, tTarifas);

        _items = await tItems;
        _grupos = await tGrupos;
        _subgrupos = await tSubgrupos;
        _tarifas = await tTarifas;
        _paginaActual = Math.Clamp(_paginaActual, 1, TotalPaginas);
        Nuevo();
    }
    private void Nuevo()
    {
        var tipoInicial = _tipo is "productos" or "grupos-productos"
            ? (!string.IsNullOrWhiteSpace(_filtroTipo) ? _filtroTipo : "B")
            : "";
        int? idGrupoInicial = null;
        int? idSubgrupoInicial = null;

        if (MuestraGrupo && int.TryParse(_filtroGrupo, out var fg) && fg > 0)
        {
            var cat = _grupos.FirstOrDefault(g => g.Id == fg);
            if (cat != null)
            {
                idGrupoInicial = fg;
                if (_tipo == "productos")
                {
                    tipoInicial = cat.Tipo == "S" ? "S" : "B";
                }
            }
        }

        if (_tipo == "productos" && int.TryParse(_filtroSubgrupo, out var fs) && fs > 0)
        {
            var sub = _subgrupos.FirstOrDefault(s => s.Id == fs);
            if (sub != null && (!idGrupoInicial.HasValue || sub.IdGrupo == idGrupoInicial))
            {
                idSubgrupoInicial = fs;
                if (!idGrupoInicial.HasValue && sub.IdGrupo.HasValue)
                {
                    idGrupoInicial = sub.IdGrupo;
                    var cat = _grupos.FirstOrDefault(g => g.Id == idGrupoInicial.Value);
                    if (cat != null)
                        tipoInicial = cat.Tipo == "S" ? "S" : "B";
                }
            }
        }

        _edit = new()
        {
            Tipo = tipoInicial,
            Inventario = tipoInicial != "S",
            IdGrupo = idGrupoInicial,
            IdSubgrupo = idSubgrupoInicial,
            Precio = _tipo == "productos" ? 0m : null,
            Estado = "A"
        };
        _aplicaIva = false;
    }
    private void CambiarCategoria() => _edit.IdSubgrupo = null;
    private void CambiarTipoProducto()
    {
        if (_edit.IdGrupo.HasValue)
        {
            var cat = _grupos.FirstOrDefault(g => g.Id == _edit.IdGrupo.Value);
            if (cat != null)
            {
                var catEsServicio = cat.Tipo == "S";
                var prodEsServicio = _edit.Tipo == "S";
                if (catEsServicio != prodEsServicio)
                {
                    _edit.IdGrupo = null;
                    _edit.IdSubgrupo = null;
                }
            }
        }
        if (_edit.Tipo == "S")
        {
            _edit.Inventario = false;
        }
        else if (_edit.Tipo == "B")
        {
            _edit.Inventario = true;
        }
    }
    private void CambiarIva() { _edit.CodigoImpuesto = _aplicaIva ? "2" : ""; if (!_aplicaIva) _edit.PorcentajeImpuesto = ""; }
    private string TarifaDescripcion(CatalogoOperativoDto x) => x.CodigoImpuesto == "2" ? _tarifas.FirstOrDefault(t => t.Codigo == x.PorcentajeImpuesto)?.Descripcion ?? "IVA" : "Sin IVA";
    private void Editar(CatalogoOperativoDto x)
    {
        var tipoNorm = _tipo is "productos" or "grupos-productos" ? (x.Tipo == "S" || x.Tipo == "SERVICIO" ? "S" : "B") : x.Tipo;
        int? idGrupoValido = x.IdGrupo;
        int? idSubgrupoValido = x.IdSubgrupo;
        if (_tipo == "productos" && idGrupoValido.HasValue && _grupos.Count > 0)
        {
            var cat = _grupos.FirstOrDefault(g => g.Id == idGrupoValido.Value);
            if (cat != null)
            {
                var catEsServicio = cat.Tipo == "S";
                var prodEsServicio = tipoNorm == "S";
                if (catEsServicio != prodEsServicio)
                {
                    idGrupoValido = null;
                    idSubgrupoValido = null;
                }
            }
        }
        _edit = new()
        {
            Id = x.Id,
            Descripcion = x.Descripcion,
            Codigo = x.Codigo,
            Precio = x.Precio,
            Precio2 = x.Precio2,
            Precio3 = x.Precio3,
            IdGrupo = idGrupoValido,
            Grupo = idGrupoValido.HasValue ? x.Grupo : string.Empty,
            IdSubgrupo = idSubgrupoValido,
            Subgrupo = idSubgrupoValido.HasValue ? x.Subgrupo : string.Empty,
            Tipo = tipoNorm,
            Inventario = x.Inventario,
            CodigoImpuesto = x.CodigoImpuesto,
            PorcentajeImpuesto = x.PorcentajeImpuesto,
            Estado = x.Estado
        };
        _aplicaIva = x.CodigoImpuesto == "2";
    }
    private void Ver(CatalogoOperativoDto x) => _vista = x;
    private void CerrarVista() => _vista = null;
    private void PrepararEliminar(CatalogoOperativoDto x) => _pendienteEliminar = x;
    private void CancelarEliminar() => _pendienteEliminar = null;
    private async Task ConfirmarEliminar()
    {
        if (_pendienteEliminar is null || _guardando) return;
        _guardando = true;
        try
        {
            var eliminado = _pendienteEliminar;
            var ok = await EFactCatalog.EliminarProductoAsync(eliminado.Id);
            _error = !ok;
            _mensaje = ok ? "Producto desactivado en el catálogo de esta veterinaria." : "No se pudo desactivar el producto.";
            if (ok)
            {
                _vista = null;
                _pendienteEliminar = null;
                var item = _items.FirstOrDefault(x => x.Id == eliminado.Id);
                if (item != null)
                {
                    item.Estado = "I";
                }
                _paginaActual = Math.Clamp(_paginaActual, 1, TotalPaginas);
            }
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task Guardar()
    {
        if (_guardando) return;
        _guardando = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var ok = await Service.GuardarCatalogoAsync(_tipo, _edit, Session.IdUser);
            _error = !ok;
            _mensaje = ok
                ? "Registro guardado en el catálogo de esta veterinaria."
                : "No se pudo guardar: revise los campos obligatorios o nombres duplicados.";
            if (ok)
            {
                if (_tipo == "productos" && _edit.Id > 0)
                {
                    AplicarProductoEnMemoria(_edit);
                    _vista = null;
                    Nuevo();
                }
                else
                {
                    await Cargar();
                }
            }
        }
        finally
        {
            _guardando = false;
        }
    }

    private void AplicarProductoEnMemoria(CatalogoOperativoDto guardado)
    {
        var grupo = guardado.IdGrupo.HasValue
            ? _grupos.FirstOrDefault(g => g.Id == guardado.IdGrupo.Value)?.Descripcion ?? string.Empty
            : string.Empty;
        var subgrupo = guardado.IdSubgrupo.HasValue
            ? _subgrupos.FirstOrDefault(s => s.Id == guardado.IdSubgrupo.Value)?.Descripcion ?? string.Empty
            : string.Empty;
        bool esServicio = guardado.Tipo == "S" || string.Equals(guardado.Tipo, "SERVICIO", StringComparison.OrdinalIgnoreCase);

        var actualizado = new CatalogoOperativoDto
        {
            Id = guardado.Id,
            Descripcion = guardado.Descripcion.Trim(),
            Codigo = guardado.Codigo?.Trim() ?? string.Empty,
            Precio = guardado.Precio,
            Precio2 = guardado.Precio2,
            Precio3 = guardado.Precio3,
            IdGrupo = guardado.IdGrupo,
            Grupo = grupo,
            IdSubgrupo = guardado.IdSubgrupo,
            Subgrupo = subgrupo,
            Tipo = esServicio ? "S" : "B",
            Inventario = !esServicio && guardado.Inventario,
            CodigoImpuesto = guardado.CodigoImpuesto == "2" ? "2" : string.Empty,
            PorcentajeImpuesto = guardado.CodigoImpuesto == "2" ? guardado.PorcentajeImpuesto : string.Empty,
            Estado = guardado.Estado == "I" ? "I" : "A"
        };

        var idx = _items.FindIndex(x => x.Id == actualizado.Id);
        if (idx >= 0)
        {
            _items[idx] = actualizado;
        }
        else
        {
            _items.Add(actualizado);
        }

        _items = _items.OrderBy(x => x.Descripcion, StringComparer.OrdinalIgnoreCase).ToList();
        _paginaActual = Math.Clamp(_paginaActual, 1, TotalPaginas);
    }
}
