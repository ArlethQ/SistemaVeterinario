@page "/administracion/catalogos-operativos"
@inject IGestionMigradaService Service
@inject SessionStateService Session
@inject NavigationManager Nav
<PageTitle>Catálogos operativos | e-ForVets</PageTitle>
@if(_autorizado){<div class="container-fluid py-3"><h2>Diagnósticos, productos y pruebas de laboratorio</h2><div class="row g-3 my-1"><div class="col-md-3"><select class="form-select" @bind="_tipo" @bind:after="Cargar"><option value="diagnosticos">Diagnósticos CIE-10</option><option value="productos">Productos e insumos</option><option value="laboratorio">Pruebas de laboratorio</option></select></div><div class="col-md-5"><input class="form-control" placeholder="Filtrar catálogo" @bind="_filtro" @bind:event="oninput"/></div><div class="col-md-2"><button class="btn btn-outline-primary" @onclick="Nuevo">Nuevo registro</button></div></div>@if(!string.IsNullOrEmpty(_mensaje)){<div class="alert @(_error?"alert-danger":"alert-success")">@_mensaje</div>}
<div class="row g-3"><div class="col-lg-8"><div class="table-responsive card"><table class="table table-hover mb-0"><thead><tr><th>Código</th><th>Descripción</th><th>Grupo</th><th>Tipo</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Filtrados){<tr><td>@x.Id</td><td>@x.Descripcion</td><td>@x.Grupo</td><td>@x.Tipo</td><td>@x.Estado</td><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Editar(x)">Editar</button></td></tr>}</tbody></table></div></div><div class="col-lg-4"><div class="card"><div class="card-body"><h5>@(_edit.Id>0?"Editar":"Nuevo")</h5><label>Descripción</label><input class="form-control mb-2" @bind="_edit.Descripcion"/><label>Id grupo</label><input type="number" class="form-control mb-2" @bind="_edit.IdGrupo"/><label>Tipo</label><input class="form-control mb-2" @bind="_edit.Tipo"/><label>Estado</label><select class="form-select mb-3" @bind="_edit.Estado"><option value="A">Activo</option><option value="I">Inactivo</option></select><button class="btn btn-primary" @onclick="Guardar">Guardar</button></div></div></div></div></div>}
@code{bool _autorizado,_error;string _tipo="diagnosticos",_filtro="",_mensaje="";List<CatalogoOperativoDto> _items=[];CatalogoOperativoDto _edit=new();IEnumerable<CatalogoOperativoDto> Filtrados=>string.IsNullOrWhiteSpace(_filtro)?_items:_items.Where(x=>x.Descripcion.Contains(_filtro,StringComparison.OrdinalIgnoreCase)||x.Grupo.Contains(_filtro,StringComparison.OrdinalIgnoreCase));protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated||Session.TipoUser!=1){Nav.NavigateTo("/dashboard");return;}_autorizado=true;await Cargar();}async Task Cargar()=>_items=await Service.ObtenerCatalogoAsync(_tipo);void Nuevo()=>_edit=new();void Editar(CatalogoOperativoDto x)=>_edit=new(){Id=x.Id,Descripcion=x.Descripcion,IdGrupo=x.IdGrupo,Grupo=x.Grupo,Tipo=x.Tipo,Estado=x.Estado};async Task Guardar(){var ok=await Service.GuardarCatalogoAsync(_tipo,_edit,Session.IdUser);_error=!ok;_mensaje=ok?"Registro guardado.":"No se pudo guardar el registro.";if(ok){Nuevo();await Cargar();}}}
