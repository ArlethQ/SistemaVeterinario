@page "/administracion/catalogos-operativos"
@inject IGestionMigradaService Service
@inject SessionStateService Session
@inject NavigationManager Nav
<PageTitle>Catálogos operativos | e-ForVets</PageTitle>
@if(_autorizado){<div class="container-fluid py-3"><h2>Diagnósticos, productos y pruebas de laboratorio</h2><div class="row g-3 my-1"><div class="col-md-4"><select class="form-select" @bind="_tipo" @bind:after="Cargar"><optgroup label="Diagnósticos"><option value="diagnosticos">Diagnósticos CIE-10</option><option value="grupos-diagnosticos">Grupos diagnósticos</option></optgroup><optgroup label="Productos"><option value="productos">Productos e insumos</option><option value="grupos-productos">Grupos de productos</option></optgroup><optgroup label="Laboratorio"><option value="laboratorio">Pruebas de laboratorio</option><option value="grupos-laboratorio">Perfiles de laboratorio</option></optgroup></select></div><div class="col-md-5"><input class="form-control" placeholder="Filtrar catálogo" @bind="_filtro" @bind:event="oninput"/></div><div class="col-md-2"><button class="btn btn-outline-primary" @onclick="Nuevo">Nuevo registro</button></div></div>@if(!string.IsNullOrEmpty(_mensaje)){<div class="alert @(_error?"alert-danger":"alert-success")">@_mensaje</div>}
<div class="row g-3"><div class="col-lg-8"><div class="table-responsive card"><table class="table table-hover mb-0"><thead><tr><th>Código</th><th>Descripción</th>@if(!EsGrupo){<th>Grupo</th><th>Tipo</th>}<th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Filtrados){<tr><td>@x.Id</td><td>@x.Descripcion</td>@if(!EsGrupo){<td>@x.Grupo</td><td>@x.Tipo</td>}<td>@x.Estado</td><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Editar(x)">Editar</button></td></tr>}</tbody></table></div></div><div class="col-lg-4"><div class="card"><div class="card-body"><h5>@(_edit.Id>0?"Editar":"Nuevo")</h5><label>Descripción</label><input class="form-control mb-2" maxlength="300" @bind="_edit.Descripcion"/>@if(!EsGrupo){<label>Grupo</label><select class="form-select mb-2" @bind="_edit.IdGrupo"><option value="">Seleccione</option>@foreach(var g in _grupos){<option value="@g.Id">@g.Descripcion</option>}</select>@if(_tipo!="laboratorio"){<label>Tipo</label><input class="form-control mb-2" maxlength="1" @bind="_edit.Tipo"/>}}<label>Estado</label><select class="form-select mb-3" @bind="_edit.Estado"><option value="A">Activo</option><option value="I">Inactivo</option></select><button class="btn btn-primary" @onclick="Guardar">Guardar</button></div></div></div></div></div>}
@code{bool _autorizado,_error;string _tipo="diagnosticos",_filtro="",_mensaje="";List<CatalogoOperativoDto> _items=[],_grupos=[];CatalogoOperativoDto _edit=new();bool EsGrupo=>_tipo.StartsWith("grupos-",StringComparison.Ordinal);string TipoGrupo=>_tipo switch{"diagnosticos"=>"grupos-diagnosticos","productos"=>"grupos-productos","laboratorio"=>"grupos-laboratorio",_=>""};IEnumerable<CatalogoOperativoDto> Filtrados=>string.IsNullOrWhiteSpace(_filtro)?_items:_items.Where(x=>x.Descripcion.Contains(_filtro,StringComparison.OrdinalIgnoreCase)||x.Grupo.Contains(_filtro,StringComparison.OrdinalIgnoreCase));protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated||Session.TipoUser!=1){Nav.NavigateTo("/dashboard");return;}_autorizado=true;await Cargar();}async Task Cargar(){_items=await Service.ObtenerCatalogoAsync(_tipo);_grupos=EsGrupo?[]:await Service.ObtenerCatalogoAsync(TipoGrupo);Nuevo();}void Nuevo()=>_edit=new();void Editar(CatalogoOperativoDto x)=>_edit=new(){Id=x.Id,Descripcion=x.Descripcion,IdGrupo=x.IdGrupo,Grupo=x.Grupo,Tipo=x.Tipo,Estado=x.Estado};async Task Guardar(){var ok=await Service.GuardarCatalogoAsync(_tipo,_edit,Session.IdUser);_error=!ok;_mensaje=ok?"Registro guardado.":"No se pudo guardar: revise campos obligatorios o nombres duplicados.";if(ok){Nuevo();await Cargar();}}}
