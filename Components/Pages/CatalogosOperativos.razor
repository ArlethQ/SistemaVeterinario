@page "/administracion/catalogos-operativos"
@page "/facturacion/productos"
@inject IGestionMigradaService Service
@inject IEFactCatalogService EFactCatalog
@inject SessionStateService Session
@inject NavigationManager Nav

<PageTitle>Catálogos operativos | e-ForVets</PageTitle>

@if (_autorizado)
{
    <div class="container-fluid py-3">
        <h2>Diagnósticos, productos y pruebas de laboratorio</h2>
        <div class="row g-3 my-1">
            <div class="col-md-4"><select class="form-select" @bind="_tipo" @bind:after="Cargar"><optgroup label="Diagnósticos"><option value="diagnosticos">Diagnósticos CIE-10</option><option value="grupos-diagnosticos">Grupos diagnósticos</option></optgroup><optgroup label="Productos de la veterinaria"><option value="productos">Productos e insumos</option><option value="grupos-productos">Categorías de productos</option><option value="subgrupos-productos">Subcategorías de productos</option></optgroup><optgroup label="Laboratorio"><option value="laboratorio">Pruebas de laboratorio</option><option value="grupos-laboratorio">Perfiles de laboratorio</option></optgroup></select></div>
            <div class="col-md-5"><input class="form-control" placeholder="Filtrar catálogo" @bind="_filtro" @bind:event="oninput" /></div>
            <div class="col-md-2"><button class="btn btn-outline-primary" @onclick="Nuevo">Nuevo registro</button></div>
        </div>
        @if (!string.IsNullOrEmpty(_mensaje)) { <div class="alert @(_error ? "alert-danger" : "alert-success")">@_mensaje</div> }
        @if (_pendienteEliminar is not null) { <div class="alert alert-warning d-flex align-items-center justify-content-between"><span>¿Desactivar <strong>@_pendienteEliminar.Descripcion</strong> del catálogo local?</span><span><button class="btn btn-sm btn-danger me-2" @onclick="ConfirmarEliminar">Sí, desactivar</button><button class="btn btn-sm btn-outline-secondary" @onclick="CancelarEliminar">Cancelar</button></span></div> }
        <div class="row g-3">
            <div class="col-lg-8"><div class="table-responsive card"><table class="table table-hover mb-0">
                <thead><tr><th>Código</th><th>Descripción</th>@if (MuestraGrupo){<th>@EtiquetaGrupo</th>}@if (_tipo == "productos"){<th>Subcategoría</th><th>Tipo</th><th>IVA</th><th class="text-end">Precio</th>}<th>Estado</th><th>Acciones</th></tr></thead>
                <tbody>@foreach (var x in Filtrados) { <tr><td>@(_tipo == "productos" && !string.IsNullOrWhiteSpace(x.Codigo) ? x.Codigo : x.Id)</td><td>@x.Descripcion</td>@if (MuestraGrupo){<td>@(string.IsNullOrWhiteSpace(x.Grupo) ? "Sin categoría" : x.Grupo)</td>}@if (_tipo == "productos"){<td>@(string.IsNullOrWhiteSpace(x.Subgrupo) ? "Sin subcategoría" : x.Subgrupo)</td><td>@x.Tipo</td><td>@TarifaDescripcion(x)</td><td class="text-end">@x.Precio?.ToString("C2")</td>}<td>@x.Estado</td><td><div class="btn-group btn-group-sm">@if (_tipo == "productos"){<button class="btn btn-outline-info" title="Ver" @onclick="() => Ver(x)">Ver</button>}<button class="btn btn-outline-primary" title="Editar" @onclick="() => Editar(x)">Editar</button>@if (_tipo == "productos"){<button class="btn btn-outline-danger" title="Eliminar" @onclick="() => PrepararEliminar(x)">Eliminar</button>}</div></td></tr> }</tbody>
            </table></div></div>
            <div class="col-lg-4"><div class="card"><div class="card-body">
                <h5>@(_edit.Id > 0 ? "Editar" : "Nuevo")</h5>
                <label>Descripción</label><input class="form-control mb-2" maxlength="300" @bind="_edit.Descripcion" />
                @if (MuestraGrupo)
                {
                    <label>@EtiquetaGrupo</label><select class="form-select mb-2" @bind="_edit.IdGrupo" @bind:after="CambiarCategoria"><option value="">Seleccione</option>@foreach (var g in _grupos) { <option value="@g.Id">@g.Descripcion</option> }</select>
                }
                @if (_tipo == "productos")
                {
                    <label>Código (opcional)</label><input class="form-control mb-2" maxlength="50" @bind="_edit.Codigo" />
                    <label>Precio base</label><input class="form-control mb-2" type="number" min="0" max="99999999.99" step="0.01" @bind="_edit.Precio" />
                    <div class="row g-2"><div class="col-6"><label>Precio 2 (opcional)</label><input class="form-control mb-2" type="number" min="0" max="99999999.99" step="0.01" @bind="_edit.Precio2" /></div><div class="col-6"><label>Precio 3 (opcional)</label><input class="form-control mb-2" type="number" min="0" max="99999999.99" step="0.01" @bind="_edit.Precio3" /></div></div>
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="aplicaIva" @bind="_aplicaIva" @bind:after="CambiarIva" /><label class="form-check-label" for="aplicaIva">IVA (opcional)</label></div>
                    @if (_aplicaIva)
                    {
                        <label>Tarifa IVA</label><select class="form-select mb-2" @bind="_edit.PorcentajeImpuesto"><option value="">Seleccione</option>@foreach (var tarifa in _tarifas) { <option value="@tarifa.Codigo">@tarifa.Descripcion</option> }</select>
                    }
                    <label>Subcategoría</label><select class="form-select mb-2" @bind="_edit.IdSubgrupo"><option value="">Sin subcategoría</option>@foreach (var s in SubcategoriasDisponibles) { <option value="@s.Id">@s.Descripcion</option> }</select>
                    <label>Tipo</label><select class="form-select mb-2" @bind="_edit.Tipo"><option value="PRODUCTO">Producto</option><option value="SERVICIO">Servicio</option></select>
                }
                else if (!EsGrupo && _tipo != "laboratorio" && _tipo != "subgrupos-productos")
                {
                    <label>Tipo</label><input class="form-control mb-2" maxlength="1" @bind="_edit.Tipo" />
                }
                <label>Estado</label><select class="form-select mb-3" @bind="_edit.Estado"><option value="A">Activo</option><option value="I">Inactivo</option></select>
                <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
            </div></div></div>
        </div>
        @if (_vista is not null)
        {
            <div class="card mt-3 border-info"><div class="card-header d-flex justify-content-between"><strong>Detalle del producto</strong><button class="btn-close" @onclick="CerrarVista"></button></div><div class="card-body"><div class="row g-3"><div class="col-md-4"><small class="text-muted d-block">Nombre</small><strong>@_vista.Descripcion</strong></div><div class="col-md-2"><small class="text-muted d-block">Código</small><strong>@(string.IsNullOrWhiteSpace(_vista.Codigo) ? $"#{_vista.Id}" : _vista.Codigo)</strong></div><div class="col-md-2"><small class="text-muted d-block">Tipo</small><strong>@_vista.Tipo</strong></div><div class="col-md-2"><small class="text-muted d-block">Precio base</small><strong>@_vista.Precio?.ToString("C2")</strong></div><div class="col-md-2"><small class="text-muted d-block">IVA</small><strong>@TarifaDescripcion(_vista)</strong></div><div class="col-md-4"><small class="text-muted d-block">Categoría</small><strong>@(string.IsNullOrWhiteSpace(_vista.Grupo) ? "Sin categoría" : _vista.Grupo)</strong></div><div class="col-md-4"><small class="text-muted d-block">Subcategoría</small><strong>@(string.IsNullOrWhiteSpace(_vista.Subgrupo) ? "Sin subcategoría" : _vista.Subgrupo)</strong></div><div class="col-md-2"><small class="text-muted d-block">Precio 2</small><strong>@(_vista.Precio2?.ToString("C2") ?? "—")</strong></div><div class="col-md-2"><small class="text-muted d-block">Precio 3</small><strong>@(_vista.Precio3?.ToString("C2") ?? "—")</strong></div></div></div></div>
        }
    </div>
}

@code {
    private bool _autorizado, _error, _aplicaIva;
    private string _tipo = "diagnosticos", _filtro = "", _mensaje = "";
    private List<CatalogoOperativoDto> _items = [], _grupos = [], _subgrupos = [];
    private List<TarifaIvaDto> _tarifas = [];
    private CatalogoOperativoDto _edit = new();
    private CatalogoOperativoDto? _vista;
    private CatalogoOperativoDto? _pendienteEliminar;
    private bool EsGrupo => _tipo.StartsWith("grupos-", StringComparison.Ordinal);
    private bool MuestraGrupo => !EsGrupo && _tipo != "grupos-productos";
    private string EtiquetaGrupo => _tipo is "productos" or "subgrupos-productos" ? "Categoría" : "Grupo";
    private string TipoGrupo => _tipo switch { "diagnosticos" => "grupos-diagnosticos", "productos" or "subgrupos-productos" => "grupos-productos", "laboratorio" => "grupos-laboratorio", _ => "" };
    private IEnumerable<CatalogoOperativoDto> SubcategoriasDisponibles => _subgrupos.Where(x => x.IdGrupo == _edit.IdGrupo);
    private IEnumerable<CatalogoOperativoDto> Filtrados => string.IsNullOrWhiteSpace(_filtro) ? _items : _items.Where(x => x.Descripcion.Contains(_filtro, StringComparison.OrdinalIgnoreCase) || x.Grupo.Contains(_filtro, StringComparison.OrdinalIgnoreCase) || x.Subgrupo.Contains(_filtro, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() { if (!Session.IsAuthenticated || Session.TipoUser != 1) { Nav.NavigateTo("/dashboard"); return; } _autorizado = true; if (Nav.Uri.Contains("/facturacion/productos", StringComparison.OrdinalIgnoreCase)) _tipo = "productos"; await Cargar(); }
    private async Task Cargar() { _items = await Service.ObtenerCatalogoAsync(_tipo); _grupos = MuestraGrupo ? await Service.ObtenerCatalogoAsync(TipoGrupo) : []; _subgrupos = _tipo == "productos" ? await Service.ObtenerCatalogoAsync("subgrupos-productos") : []; _tarifas = _tipo == "productos" ? await EFactCatalog.ObtenerTarifasIvaAsync() : []; Nuevo(); }
    private void Nuevo() { _edit = new() { Tipo = _tipo == "productos" ? "PRODUCTO" : "" }; _aplicaIva = false; }
    private void CambiarCategoria() => _edit.IdSubgrupo = null;
    private void CambiarIva() { _edit.CodigoImpuesto = _aplicaIva ? "2" : ""; if (!_aplicaIva) _edit.PorcentajeImpuesto = ""; }
    private string TarifaDescripcion(CatalogoOperativoDto x) => x.CodigoImpuesto == "2" ? _tarifas.FirstOrDefault(t => t.Codigo == x.PorcentajeImpuesto)?.Descripcion ?? "IVA" : "Sin IVA";
    private void Editar(CatalogoOperativoDto x) { _edit = new() { Id = x.Id, Descripcion = x.Descripcion, Codigo = x.Codigo, Precio = x.Precio, Precio2 = x.Precio2, Precio3 = x.Precio3, IdGrupo = x.IdGrupo, Grupo = x.Grupo, IdSubgrupo = x.IdSubgrupo, Subgrupo = x.Subgrupo, Tipo = x.Tipo, CodigoImpuesto = x.CodigoImpuesto, PorcentajeImpuesto = x.PorcentajeImpuesto, Estado = x.Estado }; _aplicaIva = x.CodigoImpuesto == "2"; }
    private void Ver(CatalogoOperativoDto x) => _vista = x;
    private void CerrarVista() => _vista = null;
    private void PrepararEliminar(CatalogoOperativoDto x) => _pendienteEliminar = x;
    private void CancelarEliminar() => _pendienteEliminar = null;
    private async Task ConfirmarEliminar() { if (_pendienteEliminar is null) return; var ok = await EFactCatalog.EliminarProductoAsync(_pendienteEliminar.Id); _error = !ok; _mensaje = ok ? "Producto desactivado en el catálogo de esta veterinaria." : "No se pudo desactivar el producto."; if (ok) { _vista = null; _pendienteEliminar = null; await Cargar(); } }
    private async Task Guardar() { var ok = await Service.GuardarCatalogoAsync(_tipo, _edit, Session.IdUser); _error = !ok; _mensaje = ok ? "Registro guardado en el catálogo de esta veterinaria." : "No se pudo guardar: revise los campos obligatorios o nombres duplicados."; if (ok) await Cargar(); }
}
