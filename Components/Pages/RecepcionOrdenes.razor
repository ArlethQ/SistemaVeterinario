@page "/admision/ordenes"
@using HosvetKardex.Web.Models
@using HosvetKardex.Web.Services
@inject IAdmisionFacturacionService AdmisionService
@inject IKardexService KardexService
@inject IReportExportService ReportService
@inject IJSRuntime JS
@inject SessionStateService SessionState
@inject NavigationManager NavManager
@inject IWebHostEnvironment Env
@inject SessionControlService SessionControl

<PageTitle>e-ForVets — Recepción, Triaje y Órdenes de Atención</PageTitle>

<div class="container-fluid py-3 triage-page">
    <!-- Encabezado -->
    <div class="triage-hero d-flex flex-wrap justify-content-between align-items-center mb-2 p-3 rounded-3 bg-white">
        <div class="d-flex align-items-center gap-3">
            <div class="triage-hero-icon">🐾</div><div>
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-clipboard2-pulse-fill me-2"></i>Recepción de Pacientes, Triaje y Órdenes de Atención
            </h4>
            <small class="text-muted">
                Asignación de médico tratante, triaje clínico, cola de espera en vivo y despacho por área.
            </small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-danger btn-sm" @onclick="ExportarPdfAsync">PDF</button>
            <button class="btn btn-outline-success btn-sm" @onclick="ExportarExcelAsync">Excel</button>
            <button type="button" class="btn btn-success btn-sm" @onclick="AbrirFormularioOrden">+ Nueva orden</button>
            @if (Permisos.Permite("admision/clientes-pacientes"))
            {
                <a href="/admision/clientes-pacientes" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-people me-1"></i>Clientes / Mascotas
            </a>
            }
            @if (Permisos.Permite("admision/citas"))
            {
                <a href="/admision/citas" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-calendar-week me-1"></i>Agenda de Citas
            </a>
            }
        </div>
    </div>

    <div class="waiting-strip mb-3">
        <div class="waiting-label"><span>◷</span><div><strong>Pacientes en espera</strong><small>Próximos a ser atendidos</small></div></div>
        <div class="waiting-doctors">
            @if (_conteoMedicos.Count == 0)
            {
                <div class="d-flex align-items-center text-muted small px-3">
                    <i class="bi bi-check2-circle text-success me-2 fs-5"></i>Sin pacientes en espera en este momento.
                </div>
            }
            @foreach (var med in _conteoMedicos.Take(4))
            {
                var sigOrden = ObtenerSiguienteEnEsperaMedico(med.IdMedico);
                <div class="doctor-chip" style="grid-template-columns: 38px minmax(0, 1fr) auto !important; gap: 10px; padding: 10px 12px;">
                    <span class="doctor-avatar">@InicialesMedico(med.Medico)</span>
                    <div style="min-width: 0;">
                        <strong>@med.Medico</strong>
                        <small>@med.Especialidad</small>
                        @if (sigOrden is not null)
                        {
                            <small class="text-primary fw-bold mt-1" style="font-size:0.64rem;">Próximo: Orden #@sigOrden.IdOrden · @sigOrden.Mascota</small>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        <b title="Pacientes en espera" style="flex-shrink:0;">@med.EnEspera</b>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensajeAlerta))
    {
        <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2" role="alert">
            <i class="bi @(_esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@_mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => _mensajeAlerta = string.Empty"></button>
        </div>
    }

    @if (_cargandoInicial)
    {
        <LoadingState Title="Cargando recepción y triaje"
                      Message="Preparando pacientes, médicos y órdenes de atención." />
    }

    <!-- Fila Superior: Conteo de Médicos en Espera (Conteomedicos) -->
    <div class="row g-2 mb-3 d-none">
        @foreach (var med in _conteoMedicos)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-dark small">@med.Medico</div>
                            <span class="badge bg-light text-secondary border">@med.Especialidad</span>
                        </div>
                        <div class="text-center">
                            <span class="badge rounded-pill @(med.EnEspera >= 3 ? "bg-danger" : "bg-primary") fs-6 px-3">
                                @med.EnEspera
                            </span>
                            <div class="text-muted" style="font-size:0.7rem;">En espera</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (_mostrarFormularioOrden)
    {
        <div class="order-drawer-backdrop" @onclick="CerrarFormularioOrden"></div>
    }

    <div class="row g-3">
        <!-- Columna Izquierda: Emisión de Nueva Orden de Atención -->
        <div class="@(_mostrarFormularioOrden ? "order-drawer" : "d-none")" role="dialog" aria-modal="true" aria-label="Registrar nueva orden de atención">
            <div class="card shadow-sm border-0 triage-register-card">
                <div class="card-header text-white fw-bold">
                    <div><i class="bi bi-plus-circle me-1"></i><span>1.</span> Registrar Nueva Orden de Atención
                    <small>Busca al paciente, completa los datos y envíalo a sala de espera.</small></div>
                    <button type="button" class="order-drawer-close" title="Cerrar" @onclick="CerrarFormularioOrden">×</button>
                </div>
                <div class="card-body">
                    @if (CitaOrigenId.HasValue && CitaOrigenId.Value > 0)
                    {
                        <div class="alert alert-info py-2 px-3 small mb-3 d-flex align-items-center justify-content-between">
                            <div>
                                <i class="bi bi-calendar2-check-fill me-2 text-primary fs-6"></i>
                                <strong>Datos cargados desde Cita Médica #@CitaOrigenId</strong>
                            </div>
                            <span class="badge bg-primary">Agenda Médica</span>
                        </div>
                    }

                    <!-- Selector rápido de paciente -->
                    @if (!EsDesdeCita)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold"><span class="step-dot">1</span> Buscar paciente</label>
                            <div class="patient-search-tabs"><span class="active">Por nombre / NHCL</span><span>Por cédula</span><span>Por código</span></div>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" placeholder="Ej: 5001, MAX, Mendoza..."
                                       @bind="_filtroPaciente" @bind:event="oninput" @onkeyup="BuscarPacientesAsync" />
                            </div>

                            <div class="list-group list-group-flush border rounded mt-1" style="max-height:155px; overflow-y:auto;">
                                @foreach (var pac in _pacientesEncontrados)
                                {
                                    bool sel = _nuevaOrden.Nhcl == pac.MasNhcl;
                                    <button type="button"
                                            class="list-group-item list-group-item-action py-1 px-2 d-flex justify-content-between align-items-center @(sel ? "active" : "")"
                                            @onclick="() => SeleccionarPacienteParaOrden(pac)">
                                        <div>
                                            <strong>#@pac.MasNhcl — @pac.MasNombre</strong>
                                            <small class="d-block @(sel ? "text-light" : "text-muted")">@pac.ClienteNombre (@pac.EspecieDescripcion)</small>
                                        </div>
                                        <span class="badge @(pac.MasOrigen == "T" ? "bg-success" : "bg-info")">
                                            @(pac.MasOrigen == "T" ? "Silvestre" : "Doméstico")
                                        </span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <SaveForm Model="_nuevaOrden" OnValidSubmit="CrearOrdenAtencionAsync">
                        <DataAnnotationsValidator />

                        <div class="selected-patient mb-2 small">
                            <span class="selected-patient-avatar">
                                @if (!string.IsNullOrEmpty(ObtenerFotoPaciente(_nuevaOrden.Nhcl))) { <img src="@ObtenerFotoPaciente(_nuevaOrden.Nhcl)" alt="Foto de @_nuevaOrden.NombreMascota" /> }
                                else { <span>🐾</span> }
                            </span><div><small>Paciente seleccionado</small><strong>@(_nuevaOrden.Nhcl > 0 ? $"#{_nuevaOrden.Nhcl} - {_nuevaOrden.NombreMascota}" : "Ninguno")</strong><span>Propietario: @_nuevaOrden.NombrePropietario</span></div>
                        </div>

                        <div class="row g-2">
                            @if (!_nuevaOrden.EsProcedimiento)
                            {
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold">2. Tipo de consulta</label>
                                    <select class="form-select form-select-sm" value="@_nuevaOrden.IdEspecialidad" @onchange="CambiarEspecialidadAsync" disabled="@EsDesdeCita">
                                        @foreach (var esp in _especialidades)
                                        {
                                            <option value="@esp.Id">[@(string.IsNullOrWhiteSpace(esp.Codigo) ? "GEN" : esp.Codigo)] @esp.Descripcion</option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="col-md-12 d-flex align-items-end">
                                <label class="form-check mb-2"><InputCheckbox class="form-check-input" @bind-Value="_nuevaOrden.EsProcedimiento" disabled="@EsDesdeCita" /><span class="form-check-label ms-2 fw-bold">Procedimiento</span></label>
                            </div>
                            @if (_nuevaOrden.EsProcedimiento)
                            {
                                <div class="col-md-12">
                                    <label class="form-label small fw-bold">2. Enfermero responsable</label>
                                    <select class="form-select form-select-sm" @bind="_nuevaOrden.IdEnfermero" disabled="@EsDesdeCita">
                                        <option value="">Cualquier enfermero disponible</option>
                                        @foreach (var enfermero in _enfermeros)
                                        {
                                            <option value="@enfermero.Id">@enfermero.Descripcion</option>
                                        }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-9">
                                    <label class="form-label small fw-bold">3. Médico tratante asignado</label>
                                    <select class="form-select form-select-sm" @bind="_nuevaOrden.IdMedico" disabled="@EsDesdeCita">
                                        <option value="0">Seleccione un médico</option>
                                        @foreach (var med in _medicosDisponibles)
                                        {
                                            <option value="@med.Id">@med.Descripcion</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <label class="form-check mb-2"><input type="checkbox" class="form-check-input" @bind="_nuevaOrden.TriajeMedico" /><span class="form-check-label ms-2 fw-bold">Triaje por el médico</span></label>
                                </div>
                            }

                            @if (_nuevaOrden.EsProcedimiento || _nuevaOrden.TriajeMedico)
                            {
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">@(_nuevaOrden.EsProcedimiento ? "3. Semáforo Triaje" : "4. Semáforo Triaje")</label>
                                    <select class="form-select form-select-sm" @bind="_nuevaOrden.ColorTriaje">
                                        <option value="green">🟢 Verde — Estándar</option>
                                        <option value="yellow">🟡 Amarillo — Prioritario</option>
                                        <option value="red">🔴 Rojo — Emergencia</option>
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div class="col-md-6 d-flex align-items-center">
                                    <div class="alert alert-light border small text-muted py-2 px-2 m-0 w-100" style="font-size:0.75rem;">
                                        <i class="bi bi-info-circle me-1 text-primary"></i>Esta orden <strong>no requiere triaje</strong>.
                                    </div>
                                </div>
                            }

                        </div>

                        <SaveButton Type="submit" class="btn btn-success w-100 mt-3 fw-bold" Disabled="@(_nuevaOrden.Nhcl == 0)">
                            <i class="bi bi-check2-circle me-1"></i>Registrar Orden y Enviar a Sala de Espera
                        </SaveButton>
                    </SaveForm>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Tablero de Órdenes Activas del Día y Ruteo Clínico -->
        <div class="col-12">
            <div class="row g-2 mb-2 triage-kpis">
                <div class="col-6 col-xl-3"><div class="kpi-card blue"><span class="kpi-symbol">ORD</span><div><strong>@OrdenesEnCurso</strong><small>Órdenes en curso</small><em>Actividad del día</em></div></div></div>
                <div class="col-6 col-xl-3"><div class="kpi-card green"><span class="kpi-symbol">ATN</span><div><strong>@OrdenesEnAtencion</strong><small>En atención</small><em>Pacientes atendidos</em></div></div></div>
                <div class="col-6 col-xl-3"><div class="kpi-card amber"><span class="kpi-symbol">PEN</span><div><strong>@OrdenesPendientes</strong><small>Pendientes</small><em>Requieren seguimiento</em></div></div></div>
                <div class="col-6 col-xl-3"><div class="kpi-card red"><span class="kpi-symbol">ESP</span><div><strong>@OrdenesEnEspera</strong><small>En espera</small><em>En cola de atención</em></div></div></div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="fw-bold text-dark">
                        <i class="bi bi-list-check me-1"></i>Tablero de Órdenes en Curso (@OrdenesMostradas.Count)
                    </span>
                    <div class="d-flex gap-2 align-items-center">
                        <input type="date" class="form-control form-control-sm" style="width:145px;"
                               value="@_fechaConsulta.ToString("yyyy-MM-dd")"
                               @onchange="CambiarFechaTableroAsync" />
                        <select class="form-select form-select-sm" style="width:160px;" value="@_filtroEtapa" @onchange="CambiarEtapaFiltroAsync">
                            <option value="">Todas las Etapas</option>
                            <option value="Consulta">Consulta Externa</option>
                            <option value="Hospitalización">Hospitalización</option>
                            <option value="Quirófano">Quirófano</option>
                            <option value="Imagenología">Imagenología</option>
                            <option value="Laboratorio">Laboratorio</option>
                        </select>
                        <input type="text" class="form-control form-control-sm" style="width:180px;" placeholder="Filtrar orden o mascota..."
                               @bind="_filtroOrdenTexto" @bind:event="oninput" @onkeyup="CargarOrdenesAsync" />
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Orden</th>
                                    <th>Hora</th>
                                    <th>Prioridad</th>
                                    <th>Paciente (NHCL)</th>
                                    <th>Propietario</th>
                                    <th>Especialidad / Doctor que Atiende</th>
                                    <th>Etapa Actual</th>
                                    <th>Proforma</th>
                                    <th class="text-end">Accesos Clínicos Directos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (OrdenesMostradas.Count == 0)
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-4">
                                            No hay órdenes en curso en este momento.
                                        </td>
                                    </tr>
                                }
                                @foreach (var o in OrdenesMostradas)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-primary px-2 py-1">Orden #@o.IdOrden</span>
                                        </td>
                                        <td>@o.Hora</td>
                                        <td><span class="triage-priority @ClaseTriaje(o.ColorTriaje)">@TextoPrioridad(o.ColorTriaje)</span></td>
                                        <td>
                                            <div class="order-patient-cell">
                                                <span class="order-patient-photo">
                                                    @if (!string.IsNullOrEmpty(ObtenerFotoPaciente(o.Nhcl))) { <img src="@ObtenerFotoPaciente(o.Nhcl)" alt="Foto de @o.Mascota" /> }
                                                    else { <span>@InicialPaciente(o.Mascota)</span> }
                                                </span>
                                                <div><div class="fw-bold">@o.Mascota <span class="text-muted">(#@o.Nhcl)</span></div><small class="text-muted">@o.Especie — @(o.TipoOrigen == "T" ? "Silvestre" : "Doméstico")</small></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>@o.Propietario</div>
                                            <small class="text-muted">@o.Cedula</small>
                                        </td>
                                        <td>
                                            @if (o.EsProcedimiento)
                                            {
                                                <div class="fw-bold text-dark">
                                                    <i class="bi bi-person-heart text-success me-1"></i>Enf. @(string.IsNullOrWhiteSpace(o.Enfermero) ? "Sin asignar" : o.Enfermero)
                                                </div>
                                                <div class="d-flex align-items-center gap-1 mt-1">
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace" style="font-size:0.7rem;">PROC</span>
                                                    <small class="text-success fw-semibold">Procedimiento de Enfermería</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="fw-bold text-dark">
                                                    <i class="bi bi-person-badge-fill text-primary me-1"></i>Dr(a). @o.Medico
                                                </div>
                                                <div class="d-flex align-items-center gap-1 mt-1">
                                                    <span class="badge bg-light text-primary border font-monospace" style="font-size:0.7rem;">@(string.IsNullOrWhiteSpace(o.CodigoEspecialidad) ? "GEN" : o.CodigoEspecialidad)</span>
                                                    <small class="text-muted">@o.Especialidad</small>
                                                    @if (!string.IsNullOrWhiteSpace(o.Consultorio))
                                                    {
                                                        <span class="badge bg-info text-dark ms-1" style="font-size:0.7rem;"><i class="bi bi-door-open-fill me-1"></i>@o.Consultorio</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column align-items-start gap-1">
                                                @{
                                                    var estado = EstadosClinicos.First(e => e.Clave == ObtenerEstadoClinico(o));
                                                }
                                                <div class="d-flex flex-wrap align-items-center gap-1">
                                                    <span class="badge @estado.Badge">@estado.Titulo</span>
                                                    @if (o.Estado == "E" && estado.Clave != "TRIAJE")
                                                    {
                                                        <button type="button" class="badge bg-secondary border-0" @onclick="() => FinalizarTurnoAsync(o)">Finalizar</button>
                                                    }
                                                </div>
                                                @if (o.EsProcedimiento || !string.Equals(o.Etapa, "Consulta", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <small class="text-muted">@(o.EsProcedimiento ? "Procedimiento" : o.Etapa)</small>
                                                }
                                                @if (!o.EsProcedimiento && o.TriajeMedico && !string.IsNullOrWhiteSpace(o.Enfermero))
                                                {
                                                    <small class="text-muted">Triaje: @o.Enfermero</small>
                                                }
                                                @if (o.InicioTriaje is { } inicioTriaje && o.FinTriaje is { } finTriaje)
                                                {
                                                    <ContadorAtencion Etiqueta="Triaje" InicioUtc="inicioTriaje" FinUtc="finTriaje" />
                                                }
                                                @if (o.InicioConsulta is { } inicioConsulta && o.FinConsulta is { } finConsulta)
                                                {
                                                    <ContadorAtencion Etiqueta="Consulta" InicioUtc="inicioConsulta" FinUtc="finConsulta" />
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (o.Facturado == "S")
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-all me-1"></i>@o.NumFacturaBc</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <select class="form-select form-select-sm fw-semibold border-primary text-dark ms-auto"
                                                    style="width: 195px; font-size: 0.74rem; cursor: pointer;"
                                                    value=""
                                                    @onchange="(e) => EjecutarAccionDropboxAsync(o, e)">
                                                <option value="">⚡ Módulos / Acciones...</option>
                                                <optgroup label="Módulos Clínicos">
                                                    @if (Permisos.Permite("admision/triaje") && !o.FinTriaje.HasValue)
                                                    {
                                                        <option value="triaje">📋 Triaje de Ingreso</option>
                                                    }
                                                    <option value="soap">🩺 Ficha Médica SOAP</option>
                                                    <option value="kardex">💊 Kardex Enfermería</option>
                                                    <option value="hosp">🏥 Hospitalización 24h</option>
                                                    <option value="quir">🔪 Quirófano / Anestesia</option>
                                                    <option value="proforma">💲 Proforma / Facturación</option>
                                                </optgroup>
                                                <optgroup label="Gestión de la Orden">
                                                    @if (o.Estado == "E")
                                                    {
                                                        <option value="finalizar">✅ Finalizar atención</option>
                                                        <option value="espera">⏳ Devolver a espera</option>
                                                    }
                                                    @if (o.Estado == "T")
                                                    {
                                                        <option value="espera">⏳ Reabrir / Poner en espera</option>
                                                    }
                                                    <option value="asignar">🔄 Cambiar médico / especialidad</option>
                                                    <option value="anular">❌ Anular orden</option>
                                                </optgroup>
                                            </select>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section class="stage-board mt-3">
        <header><span>▤</span><strong>Pacientes por estado</strong></header>
        <div class="stage-columns">
            @foreach (var etapa in EstadosClinicos)
            {
                var pacientesEtapa = FiltrarPorEtapa(etapa.Clave);
                if (etapa.Clave == "OTRO" && pacientesEtapa.Count == 0) { continue; }
                <div class="stage-column @etapa.Clase">
                    <div class="stage-title"><span>@etapa.Icono</span><strong>@etapa.Titulo (@pacientesEtapa.Count)</strong></div>
                    @if (pacientesEtapa.Count == 0)
                    {
                        <div class="stage-empty">Sin pacientes en este estado</div>
                    }
                    @foreach (var orden in pacientesEtapa.Take(10))
                    {
                        <div class="stage-patient">
                            <span class="stage-pet-avatar">@if (!string.IsNullOrEmpty(ObtenerFotoPaciente(orden.Nhcl))) { <img src="@ObtenerFotoPaciente(orden.Nhcl)" alt="Foto de @orden.Mascota" /> } else { <span>@InicialPaciente(orden.Mascota)</span> }</span>
                            <div>
                                <strong><span class="badge bg-primary font-monospace me-1" style="font-size:0.58rem;">#@orden.IdOrden</span>@orden.Mascota</strong>
                                <small>@(orden.EsProcedimiento ? $"Enf. {orden.Enfermero}" : $"Dr(a). {orden.Medico}")</small>
                            </div>
                            <div class="text-end">
                                <time class="d-block">@orden.Hora</time>
                                @if (etapa.Clave == "FINALIZADO")
                                {
                                    <span role="button" class="badge bg-outline-secondary border text-secondary mt-1 d-inline-block" style="font-size:0.58rem; padding: 2px 6px; cursor:pointer;" title="Reabrir orden y devolver a espera" @onclick="() => DevolverAEsperaAsync(orden)">↺ Reabrir</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    @if (_ordenCambio is not null)
    {
        <div class="order-drawer-backdrop"></div><div class="order-drawer"><div class="card"><div class="card-header"><strong>Cambiar asignación de orden #@_ordenCambio.IdOrden</strong></div><div class="card-body"><label>Especialidad</label><select class="form-select" value="@_cambioEspecialidad" @onchange="CambiarEspecialidadCambioAsync">@foreach(var e in _especialidades){<option value="@e.Id">[@(string.IsNullOrWhiteSpace(e.Codigo) ? "GEN" : e.Codigo)] @e.Descripcion</option>}</select><label class="mt-2">Médico</label><select class="form-select" @bind="_cambioMedico">@foreach(var m in _medicosCambio){<option value="@m.Id">@m.Descripcion</option>}</select><div class="mt-3 d-flex gap-2"><button class="btn btn-secondary" @onclick="()=>_ordenCambio=null">Cancelar</button><SaveButton class="btn btn-primary" OnClick="GuardarCambioAsignacionAsync">Guardar cambio auditable</SaveButton></div></div></div></div>
    }

    @if (_ordenTicket is not null)
    {
        <div class="order-drawer-backdrop" @onclick="() => _ordenTicket = null"></div>
        <div class="position-fixed top-50 start-50 translate-middle bg-white rounded-4 shadow-lg border p-4" style="z-index: 1080; width: 380px; max-width: 94vw;">
            <div class="text-center border-bottom pb-3 mb-3">
                <small class="text-uppercase fw-bold text-primary d-block">Hospital de Especialidades Veterinarias</small>
                <span class="text-muted small">Comprobante de Orden por Especialidad</span>
                <div class="my-3 py-2 px-3 bg-primary bg-opacity-10 rounded-3 border border-primary border-opacity-25">
                    <small class="text-uppercase text-primary fw-bold d-block" style="font-size:0.72rem;">ORDEN ASIGNADA</small>
                    <div class="display-5 fw-bold text-primary font-monospace mb-0">#@_ordenTicket.IdOrden</div>
                    <span class="badge bg-primary mt-1">@_ordenTicket.Especialidad</span>
                </div>
                <div class="p-2 rounded-3 bg-light border text-start">
                    <div class="small text-muted">@(_ordenTicket.EsProcedimiento ? "Enfermero(a) responsable:" : "Médico con el que se va a atender:")</div>
                    <div class="fw-bold text-dark fs-6"><i class="bi @(_ordenTicket.EsProcedimiento ? "bi-person-heart text-success" : "bi-person-badge-fill text-primary") me-1"></i>@(_ordenTicket.EsProcedimiento ? $"Enf. {_ordenTicket.Enfermero}" : $"Dr(a). {_ordenTicket.Medico}")</div>
                    @if (!string.IsNullOrWhiteSpace(_ordenTicket.Consultorio))
                    {
                        <div class="small fw-semibold text-info mt-1"><i class="bi bi-door-open-fill me-1"></i>Consultorio / Habitación: @_ordenTicket.Consultorio</div>
                    }
                </div>
            </div>
            <div class="small mb-3">
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Paciente:</span>
                    <strong>@_ordenTicket.Mascota (NHCL #@_ordenTicket.Nhcl)</strong>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Tutor:</span>
                    <span>@_ordenTicket.Propietario</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Fecha y Hora:</span>
                    <span>@_ordenTicket.Fecha.ToString("dd/MM/yyyy") · @_ordenTicket.Hora</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">N° Orden Interna:</span>
                    <strong>#@_ordenTicket.IdOrden</strong>
                </div>
            </div>
            <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" @onclick="() => _ordenTicket = null">Cerrar</button>
                <button type="button" class="btn btn-primary btn-sm px-3" @onclick="() => ImprimirTicketTurnoAsync(_ordenTicket)">
                    <i class="bi bi-printer-fill me-1"></i>Imprimir
                </button>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
    private int? NhclPreseleccionado { get; set; }
    private int? MedicoPreseleccionado { get; set; }
    private int? EspecialidadPreseleccionada { get; set; }
    private int? TipoDespachoPreseleccionado { get; set; }
    private int? CitaOrigenId { get; set; }
    private bool EsDesdeCita => CitaOrigenId.HasValue && CitaOrigenId.Value > 0;

    private List<CatalogoItemGenericoDto> _especialidades = new();
    private List<CatalogoItemGenericoDto> _todosMedicos = new();
    private List<CatalogoItemGenericoDto> _medicosDisponibles = new();
    private int _tipoConsulta = 2;
    private bool EsTipoConsultaEspecialidad => _tipoConsulta == 2;
    private List<CatalogoItemGenericoDto> _enfermeros = new();
    private List<ConteoMedicoEsperaDto> _conteoMedicos = new();
    private List<PacienteMascotaDto> _pacientesEncontrados = new();
    private List<OrdenAtencionResumenDto> _ordenes = new();
    private OrdenAtencionResumenDto? _ordenCambio;
    private OrdenAtencionResumenDto? _ordenTicket;
    private List<OrdenAtencionResumenDto> OrdenesMostradas =>
        _ordenes
            .Where(o => o.Estado != "T" && o.Estado != "I")
            .OrderBy(o => Array.FindIndex(EstadosClinicos, estado => estado.Clave == ObtenerEstadoClinico(o)))
            .ThenBy(o => o.IdOrden)
            .ToList();

    private string ObtenerSiguienteTurnoPreview()
    {
        if (_nuevaOrden.EsProcedimiento)
        {
            int existentes = _ordenes.Count(o => o.EsProcedimiento && o.Fecha.Date == _nuevaOrden.FechaOrden.Date);
            return $"PROC-{(existentes + 1):D2}";
        }
        var esp = _especialidades.FirstOrDefault(e => e.Id == _nuevaOrden.IdEspecialidad);
        string prefijo = !string.IsNullOrWhiteSpace(esp?.Codigo) ? esp.Codigo : "GEN";
        int existentesEsp = _ordenes.Count(o => o.IdEspecialidad == _nuevaOrden.IdEspecialidad && o.Fecha.Date == _nuevaOrden.FechaOrden.Date);
        int sig = existentesEsp + 1;
        return $"{prefijo}-{sig:D2}";
    }

    private string ObtenerNombreMedicoSeleccionado() =>
        _medicosDisponibles.FirstOrDefault(m => m.Id == _nuevaOrden.IdMedico)?.Descripcion ?? "Por asignar";

    private string ObtenerNombreEspecialidadSeleccionada() =>
        _especialidades.FirstOrDefault(e => e.Id == _nuevaOrden.IdEspecialidad)?.Descripcion ?? "General";
    private List<CatalogoItemGenericoDto> _medicosCambio = new();
    private int _cambioEspecialidad, _cambioMedico;

    private NuevaOrdenAtencionDto _nuevaOrden = new() { TriajeMedico = true };
    private string _filtroPaciente = string.Empty;
    private string _filtroOrdenTexto = string.Empty;
    private string _filtroEtapa = string.Empty;
    private DateTime _fechaConsulta = DateTime.Today;
    private bool _cargandoInicial = true;
    private string _mensajeAlerta = string.Empty;
    private bool _esError;
    private bool _mostrarFormularioOrden;
    private int OrdenesEnCurso => _ordenes.Count(o => o.Estado != "T" && o.Estado != "I");
    private int OrdenesEnAtencion => _ordenes.Count(o => o.Estado == "E");
    private int OrdenesPendientes => _ordenes.Count(o => o.Facturado != "S" && o.Estado != "T" && o.Estado != "I");
    private int OrdenesEnEspera => _ordenes.Count(o => o.Estado == "A");
    private static readonly (string Clave, string Titulo, string Clase, string Icono, string Badge)[] EstadosClinicos =
    [
        ("ESPERA", "En espera", "waiting", "⌛", "bg-warning text-dark"),
        ("TRIAJE", "En triaje", "attention", "▣", "bg-info text-dark"),
        ("ESPERA_CONSULTA", "En espera de consulta", "waiting", "⌛", "bg-warning text-dark"),
        ("CONSULTA", "En consulta", "pending", "✚", "bg-primary"),
        ("FINALIZADO", "Finalizado", "finished", "◉", "bg-secondary"),
        ("OTRO", "Otros estados", "finished", "•", "bg-secondary")
    ];

    private static string ObtenerEstadoClinico(OrdenAtencionResumenDto orden) => orden.Estado switch
    {
        "A" => "ESPERA",
        "E" when orden.InicioTriaje.HasValue && !orden.FinTriaje.HasValue => "TRIAJE",
        "E" when orden.FinTriaje.HasValue && !orden.InicioConsulta.HasValue && !orden.EsProcedimiento => "ESPERA_CONSULTA",
        "E" => "CONSULTA",
        "T" => "FINALIZADO",
        _ => "OTRO"
    };

    private List<OrdenAtencionResumenDto> FiltrarPorEtapa(string etapa) =>
        _ordenes.Where(o => ObtenerEstadoClinico(o) == etapa).OrderBy(o => o.IdOrden).ToList();

    private OrdenAtencionResumenDto? ObtenerSiguienteEnEsperaMedico(int idMedico) =>
        _ordenes
            .Where(o => o.IdMedico == idMedico && o.Estado == "A")
            .OrderBy(o => o.IdOrden)
            .FirstOrDefault();

    private async Task FinalizarTurnoAsync(OrdenAtencionResumenDto orden)
    {
        bool ok = await AdmisionService.CambiarEstadoOrdenAsync(orden.IdOrden, "T", orden.Etapa);
        if (ok)
        {
            _esError = false;
            _mensajeAlerta = $"✓ Orden #{orden.IdOrden} ({orden.Mascota}) marcada como finalizada.";
            KardexService.InvalidarCacheOrdenesActivas();
            await CargarOrdenesAsync();
        }
    }

    private async Task DevolverAEsperaAsync(OrdenAtencionResumenDto orden)
    {
        bool ok = await AdmisionService.CambiarEstadoOrdenAsync(orden.IdOrden, "A", orden.Etapa);
        if (ok)
        {
            _esError = false;
            _mensajeAlerta = $"⏳ Orden #{orden.IdOrden} ({orden.Mascota}) devuelta a sala de espera.";
            KardexService.InvalidarCacheOrdenesActivas();
            await CargarOrdenesAsync();
        }
    }

    private async Task EjecutarAccionDropboxAsync(OrdenAtencionResumenDto o, ChangeEventArgs e)
    {
        string accion = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(accion)) return;

        switch (accion)
        {
            case "triaje":
                NavManager.NavigateTo($"/admision/triaje/{o.IdOrden}/{o.Nhcl}");
                break;
            case "soap":
                NavManager.NavigateTo($"/consulta/fichamedica/{o.IdOrden}/{o.Nhcl}");
                break;
            case "kardex":
                NavManager.NavigateTo($"/kardex/enfermeria?orden={o.IdOrden}&nhcl={o.Nhcl}");
                break;
            case "hosp":
                NavManager.NavigateTo($"/hospitalizacion/ficha/{o.IdOrden}/{o.Nhcl}");
                break;
            case "quir":
                NavManager.NavigateTo($"/quirofano/preanestesia/{o.IdOrden}/{o.Nhcl}");
                break;
            case "proforma":
                NavManager.NavigateTo($"/facturacion/proformas?ordenId={o.IdOrden}");
                break;
            case "finalizar":
                await FinalizarTurnoAsync(o);
                break;
            case "espera":
                await DevolverAEsperaAsync(o);
                break;
            case "asignar":
                await AbrirCambioAsignacion(o);
                break;
            case "anular":
                await AnularOrdenAsync(o.IdOrden);
                break;
        }
    }

    private async Task ImprimirTicketTurnoAsync(OrdenAtencionResumenDto t)
    {
        string consultorioHtml = !string.IsNullOrWhiteSpace(t.Consultorio)
            ? $"<div style='margin-top:4px;color:#0284c7;font-weight:600;font-size:12px;'>Consultorio / Habitación: {System.Net.WebUtility.HtmlEncode(t.Consultorio)}</div>"
            : "";
        string profesionalLbl = t.EsProcedimiento ? "Enfermero(a) responsable:" : "Médico con el que se va a atender:";
        string profesionalNom = t.EsProcedimiento
            ? $"Enf. {System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(t.Enfermero) ? "Sin asignar" : t.Enfermero)}"
            : $"Dr(a). {System.Net.WebUtility.HtmlEncode(t.Medico)}";

        string html = $@"<!DOCTYPE html>
<html lang='es'>
<head>
<meta charset='utf-8'/>
<title>Orden #{t.IdOrden}</title>
<style>
  @page {{ size: auto; margin: 12mm; }}
  body {{ font-family: Segoe UI, Arial, sans-serif; margin: 0; padding: 0; color: #0f172a; background: #fff; }}
  .ticket {{ width: 320px; margin: 0 auto; border: 1.5px solid #cbd5e1; border-radius: 14px; padding: 20px; box-sizing: border-box; text-align: center; }}
  .hosp {{ color: #0872df; font-weight: 800; font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; }}
  .sub {{ color: #64748b; font-size: 11px; margin-top: 2px; }}
  .turn-box {{ margin: 14px 0; padding: 12px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; }}
  .turn-lbl {{ color: #0872df; font-size: 10px; font-weight: 700; text-transform: uppercase; }}
  .turn-code {{ color: #0872df; font-size: 36px; font-weight: 900; font-family: Consolas, monospace; line-height: 1.1; margin: 4px 0; }}
  .esp-badge {{ display: inline-block; background: #0872df; color: #fff; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 6px; }}
  .doc-box {{ text-align: left; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 9px 12px; margin-bottom: 14px; }}
  .doc-lbl {{ color: #64748b; font-size: 11px; }}
  .doc-name {{ color: #0f172a; font-size: 14px; font-weight: 800; margin-top: 2px; }}
  .row-item {{ display: flex; justify-content: space-between; font-size: 12px; padding: 5px 0; border-bottom: 1px solid #f1f5f9; }}
  .row-item:last-child {{ border-bottom: none; }}
  .muted {{ color: #64748b; }}
</style>
</head>
<body>
  <div class='ticket'>
    <div class='hosp'>Hospital de Especialidades Veterinarias</div>
    <div class='sub'>Comprobante de Orden por Especialidad</div>
    <div class='turn-box'>
      <div class='turn-lbl'>ORDEN ASIGNADA</div>
      <div class='turn-code'>#{t.IdOrden}</div>
      <span class='esp-badge'>{System.Net.WebUtility.HtmlEncode(t.Especialidad)}</span>
    </div>
    <div class='doc-box'>
      <div class='doc-lbl'>{profesionalLbl}</div>
      <div class='doc-name'>{profesionalNom}</div>
      {consultorioHtml}
    </div>
    <div class='row-item'><span class='muted'>Paciente:</span><strong>{System.Net.WebUtility.HtmlEncode(t.Mascota)} (NHCL #{t.Nhcl})</strong></div>
    <div class='row-item'><span class='muted'>Tutor:</span><span>{System.Net.WebUtility.HtmlEncode(t.Propietario)}</span></div>
    <div class='row-item'><span class='muted'>Fecha y Hora:</span><span>{t.Fecha:dd/MM/yyyy} · {System.Net.WebUtility.HtmlEncode(t.Hora)}</span></div>
    <div class='row-item'><span class='muted'>N° Orden Interna:</span><strong>#{t.IdOrden}</strong></div>
  </div>
</body>
</html>";

        string b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(html));
        await JS.InvokeVoidAsync("eval", $@"{{
            const htmlStr = decodeURIComponent(escape(atob('{b64}')));
            const iframe = document.createElement('iframe');
            iframe.style.position = 'fixed';
            iframe.style.right = '0';
            iframe.style.bottom = '0';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = '0';
            document.body.appendChild(iframe);
            const doc = iframe.contentWindow.document;
            doc.open();
            doc.write(htmlStr);
            doc.close();
            setTimeout(() => {{
                iframe.contentWindow.focus();
                iframe.contentWindow.print();
                setTimeout(() => document.body.removeChild(iframe), 1000);
            }}, 150);
        }}");
    }

    private static string InicialesMedico(string nombre)
    {
        var partes = (nombre ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(partes.Take(2).Select(p => p[0])).ToUpperInvariant();
    }

    private static string InicialPaciente(string nombre) => string.IsNullOrWhiteSpace(nombre) ? "?" : nombre.Trim()[..1].ToUpperInvariant();

    private string ObtenerFotoPaciente(int nhcl)
    {
        if (nhcl <= 0) return string.Empty;
        string directorio = Path.Combine(Env.WebRootPath, "PacientesFotos");
        if (!Directory.Exists(directorio)) return string.Empty;
        string? archivo = Directory.EnumerateFiles(directorio, $"{nhcl}.*").FirstOrDefault();
        return archivo is null ? string.Empty : SessionControl.FirmarFotoUrl(nhcl, File.GetLastWriteTimeUtc(archivo).Ticks);
    }

    private static string TextoPrioridad(string color) => color?.ToLowerInvariant() switch
    {
        "red" => "Emergencia",
        "yellow" => "Prioritario",
        _ => "Estándar"
    };

    private static string ClaseTriaje(string color) => color?.ToLowerInvariant() switch
    {
        "red" => "red",
        "yellow" => "yellow",
        _ => "green"
    };

    protected override async Task OnInitializedAsync()
    {
        _cargandoInicial = true;
        await Task.Yield();

        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        if (!string.IsNullOrWhiteSpace(uri.Query))
        {
            var q = System.Web.HttpUtility.ParseQueryString(uri.Query);
            if (int.TryParse(q["nhcl"], out int qNhcl) && qNhcl > 0)
            {
                NhclPreseleccionado = qNhcl;
                _mostrarFormularioOrden = true;
            }
            if (int.TryParse(q["idMedico"], out int qMed) && qMed > 0)
            {
                MedicoPreseleccionado = qMed;
            }
            if (int.TryParse(q["idEspecialidad"], out int qEsp) && qEsp > 0)
            {
                EspecialidadPreseleccionada = qEsp;
            }
            if (int.TryParse(q["tipoConsulta"], out int qTipoCons))
            {
                _tipoConsulta = qTipoCons;
                TipoDespachoPreseleccionado = qTipoCons switch
                {
                    3 => 4, // Cirugía programada -> Quirófano
                    5 => 1, // Imagen / Ecografía -> Imagenología
                    _ => 0  // Consulta general, especialidad, control -> Consulta externa / Ambulatorio
                };
            }
            if (int.TryParse(q["tipoDespacho"], out int qDespacho))
            {
                TipoDespachoPreseleccionado = qDespacho;
            }
            if (int.TryParse(q["idCita"], out int qCita) && qCita > 0)
            {
                CitaOrigenId = qCita;
            }
            if (!string.IsNullOrWhiteSpace(q["hora"]))
            {
                _nuevaOrden.HoraOrden = q["hora"]!;
            }
            if (DateTime.TryParse(q["fecha"], out var qFec))
            {
                _nuevaOrden.FechaOrden = qFec;
            }
        }

        var tEsp = AdmisionService.ObtenerEspecialidadesAsync();
        var tMedicosTodos = AdmisionService.ObtenerMedicosPorEspecialidadAsync(0);
        var tEnfermeros = AdmisionService.ObtenerEnfermerosAsync();
        var tPac = BuscarPacientesAsync();
        var tOrd = CargarOrdenesAsync();
        await Task.WhenAll(tEsp, tMedicosTodos, tEnfermeros, tPac, tOrd);

        _especialidades = await tEsp;
        if (SessionState.TipoUser == 2 && SessionState.EspUser > 0)
        {
            _especialidades = _especialidades.Where(e => e.Id == SessionState.EspUser).ToList();
        }
        _todosMedicos = await tMedicosTodos;
        _enfermeros = await tEnfermeros;

        _nuevaOrden.TipoConsulta = _tipoConsulta;
        _nuevaOrden.TipoDespacho = TipoDespachoPreseleccionado ?? (_tipoConsulta switch
        {
            3 => 4,
            5 => 1,
            _ => 0
        });

        if (EsTipoConsultaEspecialidad)
        {
            if (EspecialidadPreseleccionada.HasValue && EspecialidadPreseleccionada.Value > 0)
            {
                _nuevaOrden.IdEspecialidad = EspecialidadPreseleccionada.Value;
            }
            else
            {
                var medGen = _especialidades.FirstOrDefault(x =>
                    string.Equals(x.Codigo, "MG", StringComparison.OrdinalIgnoreCase) ||
                    x.Descripcion.Contains("MEDICINA GENERAL", StringComparison.OrdinalIgnoreCase));
                _nuevaOrden.IdEspecialidad = medGen?.Id ?? _especialidades.FirstOrDefault()?.Id ?? 0;
            }
            SincronizarTipoPorEspecialidad(_nuevaOrden.IdEspecialidad);

            _medicosDisponibles = await ObtenerMedicosEnHorarioAsync(_nuevaOrden.IdEspecialidad);
            AplicarProfesionalPreseleccionado();
        }
        else
        {
            _nuevaOrden.IdEspecialidad = EspecialidadPreseleccionada.GetValueOrDefault() > 0
                ? EspecialidadPreseleccionada!.Value
                : ResolverEspecialidadPorTipo(_tipoConsulta, MedicoPreseleccionado.GetValueOrDefault());

            var medicos = _nuevaOrden.IdEspecialidad > 0
                ? await ObtenerMedicosEnHorarioAsync(_nuevaOrden.IdEspecialidad)
                : new List<CatalogoItemGenericoDto>();

            if (medicos.Count > 0)
            {
                _medicosDisponibles = medicos;
            }
            else
            {
                var enHorario = await ObtenerMedicosEnHorarioAsync(0);
                _medicosDisponibles = enHorario.Count > 0 ? enHorario : _todosMedicos;
            }

            AplicarProfesionalPreseleccionado();
        }

        if (NhclPreseleccionado.HasValue && NhclPreseleccionado.Value > 0)
        {
            _filtroPaciente = NhclPreseleccionado.Value.ToString();
            _pacientesEncontrados = await AdmisionService.BuscarMascotasAsync(_filtroPaciente);
            var encontrado = _pacientesEncontrados.FirstOrDefault(p => p.MasNhcl == NhclPreseleccionado.Value);
            if (encontrado == null)
            {
                var resultados = await AdmisionService.BuscarMascotasAsync(string.Empty);
                encontrado = resultados.FirstOrDefault(p => p.MasNhcl == NhclPreseleccionado.Value);
                if (encontrado != null && !_pacientesEncontrados.Any(p => p.MasNhcl == encontrado.MasNhcl))
                {
                    _pacientesEncontrados.Insert(0, encontrado);
                }
            }
            if (encontrado != null)
            {
                SeleccionarPacienteParaOrden(encontrado);
            }
        }
        else if (_pacientesEncontrados.Count > 0)
        {
            SeleccionarPacienteParaOrden(_pacientesEncontrados[0]);
        }
        _cargandoInicial = false;
    }

    private async Task BuscarPacientesAsync()
    {
        _pacientesEncontrados = await AdmisionService.BuscarMascotasAsync(_filtroPaciente);
    }

    private async Task AbrirFormularioOrden()
    {
        if (_especialidades.Count == 0)
        {
            _especialidades = await AdmisionService.ObtenerEspecialidadesAsync();
            if (SessionState.TipoUser == 2 && SessionState.EspUser > 0)
            {
                _especialidades = _especialidades.Where(e => e.Id == SessionState.EspUser).ToList();
            }
        }

        if (EsTipoConsultaEspecialidad)
        {
            if (_nuevaOrden.IdEspecialidad <= 0)
            {
                _nuevaOrden.IdEspecialidad = _especialidades.FirstOrDefault()?.Id ?? 0;
            }
            _medicosDisponibles = await ObtenerMedicosEnHorarioAsync(_nuevaOrden.IdEspecialidad);
            if (!_medicosDisponibles.Any(m => m.Id == _nuevaOrden.IdMedico))
            {
                _nuevaOrden.IdMedico = _medicosDisponibles.FirstOrDefault()?.Id ?? 0;
            }
        }
        else
        {
            if (_medicosDisponibles.Count == 0)
            {
                _medicosDisponibles = await ObtenerMedicosEnHorarioAsync(_nuevaOrden.IdEspecialidad > 0 ? _nuevaOrden.IdEspecialidad : 0);
                if (!_medicosDisponibles.Any(m => m.Id == _nuevaOrden.IdMedico))
                {
                    _nuevaOrden.IdMedico = _medicosDisponibles.FirstOrDefault()?.Id ?? 0;
                }
            }
        }

        _nuevaOrden.TriajeMedico = true;
        _mostrarFormularioOrden = true;
    }
    private void AplicarProfesionalPreseleccionado()
    {
        if (MedicoPreseleccionado.HasValue && MedicoPreseleccionado.Value > 0)
        {
            var medId = MedicoPreseleccionado.Value;
            if (_medicosDisponibles.Any(m => m.Id == medId))
            {
                _nuevaOrden.IdMedico = medId;
                return;
            }

            var medicoCatalogo = _todosMedicos.FirstOrDefault(m => m.Id == medId);
            if (medicoCatalogo is not null)
            {
                _medicosDisponibles.Insert(0, medicoCatalogo);
                _nuevaOrden.IdMedico = medId;
                return;
            }

            if (_enfermeros.Any(e => e.Id == medId))
            {
                _nuevaOrden.EsProcedimiento = true;
                _nuevaOrden.IdEnfermero = medId;
                _nuevaOrden.IdMedico = 0;
                return;
            }
        }

        _nuevaOrden.IdMedico = _medicosDisponibles.FirstOrDefault()?.Id ?? 0;
    }

    private void CerrarFormularioOrden()
    {
        _mostrarFormularioOrden = false;
        CitaOrigenId = null;
    }

    private void SeleccionarPacienteParaOrden(PacienteMascotaDto pac)
    {
        _nuevaOrden.Nhcl = pac.MasNhcl;
        _nuevaOrden.IdCliente = pac.MasIdCliente;
        _nuevaOrden.NombreMascota = pac.MasNombre;
        _nuevaOrden.NombrePropietario = pac.ClienteNombre;
        _nuevaOrden.TipoOrigen = pac.MasOrigen;
        _nuevaOrden.ColorTriaje = pac.MasColorTriaje;
    }

    private async Task OnTipoConsultaChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int tipo))
        {
            _tipoConsulta = tipo;
            _nuevaOrden.TipoConsulta = tipo;
            _nuevaOrden.TipoDespacho = tipo switch
            {
                3 => 4, // Cirugía Programada -> Quirófano
                5 => 1, // Imagen / Ecografía -> Imagenología
                _ => 0  // Consulta General, Especialidad, Control / Revisión -> Consulta / Ambulatorio
            };

            if (tipo == 2) // Especialidad
            {
                if (_nuevaOrden.IdEspecialidad <= 0)
                {
                    _nuevaOrden.IdEspecialidad = _especialidades.FirstOrDefault()?.Id ?? 0;
                }
                _medicosDisponibles = await ObtenerMedicosEnHorarioAsync(_nuevaOrden.IdEspecialidad);
            }
            else
            {
                _nuevaOrden.IdEspecialidad = ResolverEspecialidadPorTipo(tipo, _nuevaOrden.IdMedico);
                var medicos = _nuevaOrden.IdEspecialidad > 0
                    ? await ObtenerMedicosEnHorarioAsync(_nuevaOrden.IdEspecialidad)
                    : new List<CatalogoItemGenericoDto>();

                if (medicos.Count > 0)
                {
                    _medicosDisponibles = medicos;
                }
                else
                {
                    var enHorario = await ObtenerMedicosEnHorarioAsync(0);
                    _medicosDisponibles = enHorario.Count > 0 ? enHorario : _todosMedicos;
                }
            }

            if (!_medicosDisponibles.Any(m => m.Id == _nuevaOrden.IdMedico))
            {
                _nuevaOrden.IdMedico = _medicosDisponibles.FirstOrDefault()?.Id ?? 0;
            }
            _esError = false;
            _mensajeAlerta = string.Empty;
        }
    }

    private int ResolverEspecialidadPorTipo(int tipoConsulta, int idMedico)
    {
        if (tipoConsulta == 1 || tipoConsulta == 4)
        {
            var medGen = _especialidades.FirstOrDefault(x =>
                string.Equals(x.Codigo, "MG", StringComparison.OrdinalIgnoreCase) ||
                x.Descripcion.Contains("MEDICINA GENERAL", StringComparison.OrdinalIgnoreCase) ||
                x.Descripcion.Contains("GENERAL", StringComparison.OrdinalIgnoreCase));
            if (medGen != null) return medGen.Id;
        }
        else if (tipoConsulta == 3)
        {
            var cir = _especialidades.FirstOrDefault(x =>
                string.Equals(x.Codigo, "CIR", StringComparison.OrdinalIgnoreCase) ||
                x.Descripcion.Contains("CIRUGIA", StringComparison.OrdinalIgnoreCase));
            if (cir != null) return cir.Id;
        }
        else if (tipoConsulta == 5)
        {
            var img = _especialidades.FirstOrDefault(x =>
                string.Equals(x.Codigo, "IMG", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.Codigo, "RX", StringComparison.OrdinalIgnoreCase) ||
                x.Descripcion.Contains("IMAGEN", StringComparison.OrdinalIgnoreCase) ||
                x.Descripcion.Contains("ECOGRAFIA", StringComparison.OrdinalIgnoreCase));
            if (img != null) return img.Id;
        }

        var med = _todosMedicos.FirstOrDefault(m => m.Id == idMedico);
        if (med?.IdPadre.GetValueOrDefault() > 0)
            return med.IdPadre!.Value;

        return _especialidades.FirstOrDefault()?.Id ?? 0;
    }

    private void SincronizarTipoPorEspecialidad(int idEsp)
    {
        var esp = _especialidades.FirstOrDefault(e => e.Id == idEsp);
        if (esp == null)
        {
            _nuevaOrden.TipoConsulta = 2;
            _nuevaOrden.TipoDespacho = TipoDespachoPreseleccionado ?? 0;
            return;
        }

        if (string.Equals(esp.Codigo, "MG", StringComparison.OrdinalIgnoreCase) ||
            esp.Descripcion.Contains("MEDICINA GENERAL", StringComparison.OrdinalIgnoreCase))
        {
            _nuevaOrden.TipoConsulta = 1;
            _nuevaOrden.TipoDespacho = TipoDespachoPreseleccionado ?? 0;
        }
        else if (string.Equals(esp.Codigo, "CIR", StringComparison.OrdinalIgnoreCase) ||
                 esp.Descripcion.Contains("CIRUGIA", StringComparison.OrdinalIgnoreCase))
        {
            _nuevaOrden.TipoConsulta = 3;
            _nuevaOrden.TipoDespacho = TipoDespachoPreseleccionado ?? 4;
        }
        else if (string.Equals(esp.Codigo, "IMG", StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(esp.Codigo, "RX", StringComparison.OrdinalIgnoreCase) ||
                 esp.Descripcion.Contains("IMAGEN", StringComparison.OrdinalIgnoreCase) ||
                 esp.Descripcion.Contains("ECOGRAFIA", StringComparison.OrdinalIgnoreCase))
        {
            _nuevaOrden.TipoConsulta = 5;
            _nuevaOrden.TipoDespacho = TipoDespachoPreseleccionado ?? 1;
        }
        else
        {
            _nuevaOrden.TipoConsulta = 2;
            _nuevaOrden.TipoDespacho = TipoDespachoPreseleccionado ?? 0;
        }
    }

    private async Task CambiarEspecialidadAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idEsp))
        {
            _nuevaOrden.IdEspecialidad = idEsp;
            SincronizarTipoPorEspecialidad(idEsp);
            _medicosDisponibles = await ObtenerMedicosEnHorarioAsync(idEsp);
            _nuevaOrden.IdMedico = _medicosDisponibles.FirstOrDefault()?.Id ?? 0;
            if (_medicosDisponibles.Count == 0)
            {
                _esError = true;
                _mensajeAlerta = "No existen médicos registrados para esta especialidad en la sucursal actual.";
            }
            else
            {
                _esError = false;
                _mensajeAlerta = string.Empty;
            }
        }
    }

    private async Task<List<CatalogoItemGenericoDto>> ObtenerMedicosEnHorarioAsync(int idEspecialidad)
    {
        var medicos = await AdmisionService.ObtenerMedicosPorEspecialidadAsync(idEspecialidad);
        if (medicos.Count == 0) return [];

        var disponibles = new List<CatalogoItemGenericoDto>();
        foreach (var medico in medicos)
        {
            var slots = await AdmisionService.ObtenerSlotsHorarioMedicoAsync(medico.Id, _nuevaOrden.FechaOrden, SessionState.Localidad);
            if (slots.Any(s => s.Disponible))
            {
                disponibles.Add(medico);
            }
        }
        return disponibles.Count > 0 ? disponibles : medicos;
    }

    private async Task<List<CatalogoItemGenericoDto>> FiltrarEspecialidadesEnHorarioAsync(IEnumerable<CatalogoItemGenericoDto> especialidades)
    {
        var resultado = new List<CatalogoItemGenericoDto>();
        foreach (var especialidad in especialidades)
        {
            if ((await ObtenerMedicosEnHorarioAsync(especialidad.Id)).Count > 0)
            {
                resultado.Add(especialidad);
            }
        }
        return resultado;
    }


    private async Task CrearOrdenAtencionAsync()
    {
        if (_nuevaOrden.Nhcl <= 0)
        {
            _esError = true;
            _mensajeAlerta = "Seleccione primero un paciente (NHCL) de la lista.";
            return;
        }

        var ahora = DateTime.UtcNow.AddHours(-5);
        _nuevaOrden.FechaOrden = ahora.Date;
        _nuevaOrden.HoraOrden = ahora.ToString("HH:mm");

        if (_nuevaOrden.EsProcedimiento)
        {
            _nuevaOrden.IdMedico = 0;
            _nuevaOrden.IdEspecialidad = 0;
            _nuevaOrden.TipoConsulta = 0;
            _nuevaOrden.TipoDespacho = 0;
        }
        else
        {
            if (EsTipoConsultaEspecialidad && _nuevaOrden.IdEspecialidad <= 0)
            {
                _esError = true;
                _mensajeAlerta = "Seleccione una especialidad requerida.";
                return;
            }

            if (_nuevaOrden.IdMedico <= 0)
            {
                _esError = true;
                _mensajeAlerta = "Seleccione el médico tratante.";
                return;
            }

            _nuevaOrden.IdEnfermero = null;

            if (!EsTipoConsultaEspecialidad && _nuevaOrden.IdEspecialidad <= 0)
            {
                _nuevaOrden.IdEspecialidad = ResolverEspecialidadPorTipo(_tipoConsulta, _nuevaOrden.IdMedico);
            }

            var medicosEnHorario = EsTipoConsultaEspecialidad && _nuevaOrden.IdEspecialidad > 0
                ? await ObtenerMedicosEnHorarioAsync(_nuevaOrden.IdEspecialidad)
                : await ObtenerMedicosEnHorarioAsync(0);

            if (medicosEnHorario.Count == 0 || !medicosEnHorario.Any(m => m.Id == _nuevaOrden.IdMedico))
            {
                _esError = true;
                _mensajeAlerta = "El médico seleccionado no atiende en la sucursal actual o no tiene un horario de atención disponible.";
                return;
            }
        }

        if (_nuevaOrden.EsProcedimiento)
        {
            if (string.IsNullOrWhiteSpace(_nuevaOrden.ColorTriaje))
            {
                _nuevaOrden.ColorTriaje = "green";
            }
        }
        else if (!_nuevaOrden.TriajeMedico)
        {
            _nuevaOrden.ColorTriaje = string.Empty;
        }
        else if (string.IsNullOrWhiteSpace(_nuevaOrden.ColorTriaje))
        {
            _nuevaOrden.ColorTriaje = "green";
        }

        _nuevaOrden.IdLocalidad = SessionState.Localidad;
        int idUsuario = SessionState.UsuarioActual?.IdUsuario ?? 1;
        int idCreada = await AdmisionService.CrearOrdenAtencionAsync(_nuevaOrden, idUsuario, "127.0.0.1");

        if (CitaOrigenId.HasValue && CitaOrigenId.Value > 0)
        {
            try
            {
                await AdmisionService.ActualizarEstadoCitaAsync(CitaOrigenId.Value, "A");
            }
            catch
            {
                // No bloquear la orden si la cita no puede cambiar a atendida
            }
        }

        await CargarOrdenesAsync();

        var ordenRecienCreada = _ordenes.FirstOrDefault(o => o.IdOrden == idCreada);
        string asignacionTexto = ordenRecienCreada != null
            ? (ordenRecienCreada.EsProcedimiento
                ? $" — Procedimiento (Enfermero: {ordenRecienCreada.Enfermero})"
                : $" — Atiende: Dr(a). {ordenRecienCreada.Medico}")
            : "";

        _esError = false;
        string vinculoCita = (CitaOrigenId.HasValue && CitaOrigenId.Value > 0) ? $" (Vinculada a Cita #{CitaOrigenId.Value})" : "";
        _mensajeAlerta = $"Orden #{idCreada}{asignacionTexto} generada para {_nuevaOrden.NombreMascota} (NHCL #{_nuevaOrden.Nhcl}){vinculoCita}.";
        _nuevaOrden.EsProcedimiento = false;
        _mostrarFormularioOrden = false;
        CitaOrigenId = null;
    }

    private async Task CambiarFechaTableroAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var fec))
        {
            _fechaConsulta = fec;
            await CargarOrdenesAsync();
        }
    }

    private async Task CambiarEtapaFiltroAsync(ChangeEventArgs e)
    {
        _filtroEtapa = e.Value?.ToString() ?? string.Empty;
        await CargarOrdenesAsync();
    }

    private async Task CargarOrdenesAsync()
    {
        _ordenes = await AdmisionService.ObtenerOrdenesDelDiaAsync(_fechaConsulta, _filtroOrdenTexto, _filtroEtapa);
        _conteoMedicos = await AdmisionService.ObtenerConteoMedicosEsperaAsync(_fechaConsulta, SessionState.Localidad);
        if (SessionState.TipoUser == 2)
        {
            _ordenes = _ordenes.Where(o => o.IdMedico == SessionState.IdUser).ToList();
            _conteoMedicos = _conteoMedicos.Where(m => m.IdMedico == SessionState.IdUser).ToList();
        }
    }

    private async Task AbrirCambioAsignacion(OrdenAtencionResumenDto orden)
    {
        _ordenCambio = orden;
        _cambioEspecialidad = _especialidades.FirstOrDefault(e => e.Descripcion == orden.Especialidad)?.Id ?? _especialidades.FirstOrDefault()?.Id ?? 1;
        _medicosCambio = await AdmisionService.ObtenerMedicosPorEspecialidadAsync(_cambioEspecialidad);
        _cambioMedico = _medicosCambio.Any(m => m.Id == orden.IdMedico) ? orden.IdMedico : _medicosCambio.FirstOrDefault()?.Id ?? 0;
    }

    private async Task CambiarEspecialidadCambioAsync(ChangeEventArgs e)
    {
        if(!int.TryParse(e.Value?.ToString(),out _cambioEspecialidad))return;
        _medicosCambio=await AdmisionService.ObtenerMedicosPorEspecialidadAsync(_cambioEspecialidad);
        _cambioMedico=_medicosCambio.FirstOrDefault()?.Id??0;
    }

    private async Task GuardarCambioAsignacionAsync()
    {
        if(_ordenCambio is null)return;
        bool ok=await AdmisionService.CambiarAsignacionOrdenAsync(_ordenCambio.IdOrden,_cambioMedico,_cambioEspecialidad,SessionState.IdUser);
        _esError=!ok;_mensajeAlerta=ok?"Asignación actualizada y auditada.":"No se pudo actualizar la asignación.";if(ok)_ordenCambio=null;await CargarOrdenesAsync();
    }

    private async Task AnularOrdenAsync(int idOrden)
    {
        bool confirmar=await JS.InvokeAsync<bool>("confirm",$"¿Anular la orden #{idOrden}?");if(!confirmar)return;
        bool ok=await AdmisionService.AnularOrdenAsync(idOrden,SessionState.IdUser);_esError=!ok;_mensajeAlerta=ok?"Orden anulada.":"No se pudo anular la orden.";if(ok)KardexService.InvalidarCacheOrdenesActivas();await CargarOrdenesAsync();
    }

    private async Task ExportarPdfAsync(){var bytes=ReportService.GenerarOrdenesAtencionPdf(_ordenes,_fechaConsulta,_fechaConsulta);await DescargarAsync(bytes,"application/pdf",$"Ordenes_{_fechaConsulta:yyyyMMdd}.pdf");}
    private async Task ExportarExcelAsync(){var bytes=ReportService.GenerarOrdenesAtencionExcel(_ordenes,_fechaConsulta,_fechaConsulta);await DescargarAsync(bytes,"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",$"Ordenes_{_fechaConsulta:yyyyMMdd}.xlsx");}
    private async Task DescargarAsync(byte[] bytes,string mime,string nombre){var b64=Convert.ToBase64String(bytes);await JS.InvokeVoidAsync("eval",$"{{const a=document.createElement('a');a.href='data:{mime};base64,{b64}';a.download='{nombre}';a.click();}}");}

    private static string ObtenerColorHexTriaje(string color) => color switch
    {
        "red" => "#dc2626",
        "yellow" => "#d97706",
        _ => "#16a34a"
    };

    private static string ObtenerBadgeEtapa(string etapa) => etapa switch
    {
        "Hospitalización" => "bg-info text-dark",
        "Quirófano" => "bg-danger",
        "Imagenología" => "bg-primary",
        "Laboratorio" => "bg-secondary",
