@page "/admision/ordenes"
@using HosvetKardex.Web.Models
@using HosvetKardex.Web.Services
@inject IAdmisionFacturacionService AdmisionService
@inject IReportExportService ReportService
@inject IJSRuntime JS
@inject SessionStateService SessionState
@inject NavigationManager NavManager
@inject IWebHostEnvironment Env

<PageTitle>e-ForVets — Recepción, Triaje y Órdenes de Atención</PageTitle>

<div class="container-fluid py-3 triage-page">
    <!-- Encabezado -->
    <div class="triage-hero d-flex flex-wrap justify-content-between align-items-center mb-2 p-3 rounded-3 bg-white">
        <div class="d-flex align-items-center gap-3">
            <div class="triage-hero-icon">🐾</div><div>
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-clipboard2-pulse-fill me-2"></i>Recepción de Pacientes, Triaje y Órdenes de Atención
            </h4>
            <small class="text-muted">
                Asignación de médico tratante, triaje clínico, cola de espera en vivo y despacho por área.
            </small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-danger btn-sm" @onclick="ExportarPdfAsync">PDF</button>
            <button class="btn btn-outline-success btn-sm" @onclick="ExportarExcelAsync">Excel</button>
            <button type="button" class="btn btn-success btn-sm" @onclick="AbrirFormularioOrden">+ Nueva orden</button>
            <a href="/admision/clientes-pacientes" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-people me-1"></i>Clientes / Mascotas
            </a>
            <a href="/admision/citas" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-calendar-week me-1"></i>Agenda de Citas
            </a>
        </div>
    </div>

    <div class="waiting-strip mb-3">
        <div class="waiting-label"><span>◷</span><div><strong>Pacientes en espera</strong><small>Próximos a ser atendidos</small></div></div>
        <div class="waiting-doctors">
            @foreach (var med in _conteoMedicos.Take(4))
            {
                <div class="doctor-chip"><span class="doctor-avatar">@InicialesMedico(med.Medico)</span><div><strong>@med.Medico</strong><small>@med.Especialidad</small></div><b>@med.EnEspera</b></div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensajeAlerta))
    {
        <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2" role="alert">
            <i class="bi @(_esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@_mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => _mensajeAlerta = string.Empty"></button>
        </div>
    }

    @if (_cargandoInicial)
    {
        <LoadingState Title="Cargando recepción y triaje"
                      Message="Preparando pacientes, médicos y órdenes de atención." />
    }

    <!-- Fila Superior: Conteo de Médicos en Espera (Conteomedicos) -->
    <div class="row g-2 mb-3 d-none">
        @foreach (var med in _conteoMedicos)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-dark small">@med.Medico</div>
                            <span class="badge bg-light text-secondary border">@med.Especialidad</span>
                        </div>
                        <div class="text-center">
                            <span class="badge rounded-pill @(med.EnEspera >= 3 ? "bg-danger" : "bg-primary") fs-6 px-3">
                                @med.EnEspera
                            </span>
                            <div class="text-muted" style="font-size:0.7rem;">En espera</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (_mostrarFormularioOrden)
    {
        <div class="order-drawer-backdrop" @onclick="CerrarFormularioOrden"></div>
    }

    <div class="row g-3">
        <!-- Columna Izquierda: Emisión de Nueva Orden de Atención -->
        <div class="@(_mostrarFormularioOrden ? "order-drawer" : "d-none")">
            <div class="card shadow-sm border-0 triage-register-card">
                <div class="card-header text-white fw-bold">
                    <div><i class="bi bi-plus-circle me-1"></i><span>1.</span> Registrar Nueva Orden de Atención
                    <small>Busca al paciente, completa los datos y envíalo a sala de espera.</small></div>
                    <button type="button" class="order-drawer-close" title="Cerrar" @onclick="CerrarFormularioOrden">×</button>
                </div>
                <div class="card-body">
                    <!-- Selector rápido de paciente -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold"><span class="step-dot">1</span> Buscar paciente</label>
                        <div class="patient-search-tabs"><span class="active">Por nombre / NHCL</span><span>Por cédula</span><span>Por código</span></div>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" placeholder="Ej: 5001, MAX, Mendoza..."
                                   @bind="_filtroPaciente" @bind:event="oninput" @onkeyup="BuscarPacientesAsync" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="BuscarPacientesAsync">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>

                        <div class="list-group list-group-flush border rounded mt-1" style="max-height:155px; overflow-y:auto;">
                            @foreach (var pac in _pacientesEncontrados)
                            {
                                bool sel = _nuevaOrden.Nhcl == pac.MasNhcl;
                                <button type="button"
                                        class="list-group-item list-group-item-action py-1 px-2 d-flex justify-content-between align-items-center @(sel ? "active" : "")"
                                        @onclick="() => SeleccionarPacienteParaOrden(pac)">
                                    <div>
                                        <strong>#@pac.MasNhcl — @pac.MasNombre</strong>
                                        <small class="d-block @(sel ? "text-light" : "text-muted")">@pac.ClienteNombre (@pac.EspecieDescripcion)</small>
                                    </div>
                                    <span class="badge @(pac.MasOrigen == "T" ? "bg-success" : "bg-info")">
                                        @(pac.MasOrigen == "T" ? "Silvestre" : "Doméstico")
                                    </span>
                                </button>
                            }
                        </div>
                    </div>

                    <EditForm Model="_nuevaOrden" OnValidSubmit="CrearOrdenAtencionAsync">
                        <DataAnnotationsValidator />

                        <div class="selected-patient mb-2 small">
                            <span class="selected-patient-avatar">
                                @if (!string.IsNullOrEmpty(ObtenerFotoPaciente(_nuevaOrden.Nhcl))) { <img src="@ObtenerFotoPaciente(_nuevaOrden.Nhcl)" alt="Foto de @_nuevaOrden.NombreMascota" /> }
                                else { <span>🐾</span> }
                            </span><div><small>Paciente seleccionado</small><strong>@(_nuevaOrden.Nhcl > 0 ? $"#{_nuevaOrden.Nhcl} - {_nuevaOrden.NombreMascota}" : "Ninguno")</strong><span>Propietario: @_nuevaOrden.NombrePropietario</span></div>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">2. Especialidad Requerida</label>
                                <select class="form-select form-select-sm" value="@_nuevaOrden.IdEspecialidad" @onchange="CambiarEspecialidadAsync">
                                    @foreach (var esp in _especialidades)
                                    {
                                        <option value="@esp.Id">@esp.Descripcion</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold">3. Médico Tratante Asignado</label>
                                <select class="form-select form-select-sm" @bind="_nuevaOrden.IdMedico">
                                    @foreach (var med in _medicosDisponibles)
                                    {
                                        <option value="@med.Id">@med.Descripcion</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">4. Destino / Despacho</label>
                                <select class="form-select form-select-sm" @bind="_nuevaOrden.TipoDespacho">
                                    <option value="0">0 — Consulta / Ambulatorio</option>
                                    <option value="3">3 — Hospitalización Directa</option>
                                    <option value="4">4 — Quirófano / Cirugía</option>
                                    <option value="1">1 — Despacho Imagenología</option>
                                    <option value="2">2 — Despacho Laboratorio</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">5. Semáforo Triaje</label>
                                <select class="form-select form-select-sm" @bind="_nuevaOrden.ColorTriaje">
                                    <option value="green">🟢 Verde — Estándar</option>
                                    <option value="yellow">🟡 Amarillo — Prioritario</option>
                                    <option value="red">🔴 Rojo — Emergencia</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Fecha Atención</label>
                                <InputDate class="form-control form-control-sm" @bind-Value="_nuevaOrden.FechaOrden" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Hora Ingreso</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_nuevaOrden.HoraOrden" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 mt-3 fw-bold" disabled="@(_nuevaOrden.Nhcl == 0)">
                            <i class="bi bi-check2-circle me-1"></i>Registrar Orden y Enviar a Sala de Espera
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Tablero de Órdenes Activas del Día y Ruteo Clínico -->
        <div class="col-12">
            <div class="row g-2 mb-2 triage-kpis">
                <div class="col-6 col-xl-3"><div class="kpi-card blue"><span class="kpi-symbol">ORD</span><div><strong>@_ordenes.Count</strong><small>Órdenes en curso</small><em>Actividad del día</em></div></div></div>
                <div class="col-6 col-xl-3"><div class="kpi-card green"><span class="kpi-symbol">ATN</span><div><strong>@OrdenesEnAtencion</strong><small>En atención</small><em>Pacientes atendidos</em></div></div></div>
                <div class="col-6 col-xl-3"><div class="kpi-card amber"><span class="kpi-symbol">PEN</span><div><strong>@OrdenesPendientes</strong><small>Pendientes</small><em>Requieren seguimiento</em></div></div></div>
                <div class="col-6 col-xl-3"><div class="kpi-card red"><span class="kpi-symbol">ESP</span><div><strong>@OrdenesEnEspera</strong><small>En espera</small><em>En cola de atención</em></div></div></div>
            </div>
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="fw-bold text-dark">
                        <i class="bi bi-list-check me-1"></i>Tablero de Órdenes de Atención en Curso (@_ordenes.Count)
                    </span>
                    <div class="d-flex gap-2 align-items-center">
                        <input type="date" class="form-control form-control-sm" style="width:145px;"
                               value="@_fechaConsulta.ToString("yyyy-MM-dd")"
                               @onchange="CambiarFechaTableroAsync" />
                        <select class="form-select form-select-sm" style="width:160px;" value="@_filtroEtapa" @onchange="CambiarEtapaFiltroAsync">
                            <option value="">Todas las Etapas</option>
                            <option value="Consulta">Consulta Externa</option>
                            <option value="Hospitalización">Hospitalización</option>
                            <option value="Quirófano">Quirófano</option>
                            <option value="Imagenología">Imagenología</option>
                            <option value="Laboratorio">Laboratorio</option>
                        </select>
                        <input type="text" class="form-control form-control-sm" style="width:180px;" placeholder="Filtrar orden o mascota..."
                               @bind="_filtroOrdenTexto" @bind:event="oninput" @onkeyup="CargarOrdenesAsync" />
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>N° Orden</th>
                                    <th>Hora</th>
                                    <th>Prioridad</th>
                                    <th>Paciente (NHCL)</th>
                                    <th>Propietario</th>
                                    <th>Especialidad / Médico</th>
                                    <th>Etapa Actual</th>
                                    <th>Proforma</th>
                                    <th class="text-end">Accesos Clínicos Directos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in _ordenes)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">
                                            <span>#@o.IdOrden</span>
                                        </td>
                                        <td>@o.Hora</td>
                                        <td><span class="triage-priority @ClaseTriaje(o.ColorTriaje)">@TextoPrioridad(o.ColorTriaje)</span></td>
                                        <td>
                                            <div class="order-patient-cell">
                                                <span class="order-patient-photo">
                                                    @if (!string.IsNullOrEmpty(ObtenerFotoPaciente(o.Nhcl))) { <img src="@ObtenerFotoPaciente(o.Nhcl)" alt="Foto de @o.Mascota" /> }
                                                    else { <span>@InicialPaciente(o.Mascota)</span> }
                                                </span>
                                                <div><div class="fw-bold">@o.Mascota <span class="text-muted">(#@o.Nhcl)</span></div><small class="text-muted">@o.Especie — @(o.TipoOrigen == "T" ? "Silvestre" : "Doméstico")</small></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>@o.Propietario</div>
                                            <small class="text-muted">@o.Cedula</small>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@o.Medico</div>
                                            <small class="text-muted">@o.Especialidad</small>
                                        </td>
                                        <td>
                                            <span class="badge @ObtenerBadgeEtapa(o.Etapa)">@o.Etapa</span>
                                        </td>
                                        <td>
                                            @if (o.Facturado == "S")
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-all me-1"></i>@o.NumFacturaBc</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a href="/consulta/fichamedica/@o.IdOrden/@o.Nhcl" class="btn btn-outline-primary" title="Ficha Médica SOAP">
                                                    SOAP
                                                </a>
                                                <a href="/kardex/enfermeria?orden=@o.IdOrden&nhcl=@o.Nhcl" class="btn triage-kardex" title="Kardex Enfermería">
                                                    Kardex
                                                </a>
                                                <a href="/hospitalizacion/ficha/@o.IdOrden/@o.Nhcl" class="btn btn-outline-info" title="Ficha Hospitalización 24h">
                                                    Hosp
                                                </a>
                                                <a href="/quirofano/preanestesia/@o.IdOrden/@o.Nhcl" class="btn btn-outline-danger" title="Quirófano / Anestesia">
                                                    Quir
                                                </a>
                                                <a href="/facturacion/proformas?ordenId=@o.IdOrden" class="btn btn-outline-success" title="Gestionar proforma">
                                                    $
                                                </a>
                                                <button class="btn btn-outline-secondary" title="Cambiar médico/especialidad" @onclick="()=>AbrirCambioAsignacion(o)">Asignar</button>
                                                <button class="btn btn-outline-danger" title="Anular orden" @onclick="()=>AnularOrdenAsync(o.IdOrden)">Anular</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section class="stage-board mt-3">
        <header><span>▤</span><strong>Pacientes por Etapa</strong></header>
        <div class="stage-columns">
            @foreach (var etapa in EtapasResumen)
            {
                var pacientesEtapa = FiltrarPorEtapa(etapa.Clave);
                <div class="stage-column @etapa.Clase">
                    <div class="stage-title"><span>@etapa.Icono</span><strong>@etapa.Titulo (@pacientesEtapa.Count)</strong></div>
                    @if (pacientesEtapa.Count == 0)
                    {
                        <div class="stage-empty">Sin pacientes en esta etapa</div>
                    }
                    @foreach (var orden in pacientesEtapa.Take(4))
                    {
                        <div class="stage-patient"><span class="stage-pet-avatar">@if (!string.IsNullOrEmpty(ObtenerFotoPaciente(orden.Nhcl))) { <img src="@ObtenerFotoPaciente(orden.Nhcl)" alt="Foto de @orden.Mascota" /> } else { <span>@InicialPaciente(orden.Mascota)</span> }</span><div><strong>@orden.Mascota</strong><small>@orden.Propietario</small></div><time>@orden.Hora</time></div>
                    }
                </div>
            }
        </div>
    </section>

    @if (_ordenCambio is not null)
    {
        <div class="order-drawer-backdrop"></div><div class="order-drawer"><div class="card"><div class="card-header"><strong>Cambiar asignación de orden #@_ordenCambio.IdOrden</strong></div><div class="card-body"><label>Especialidad</label><select class="form-select" value="@_cambioEspecialidad" @onchange="CambiarEspecialidadCambioAsync">@foreach(var e in _especialidades){<option value="@e.Id">@e.Descripcion</option>}</select><label class="mt-2">Médico</label><select class="form-select" @bind="_cambioMedico">@foreach(var m in _medicosCambio){<option value="@m.Id">@m.Descripcion</option>}</select><div class="mt-3 d-flex gap-2"><button class="btn btn-secondary" @onclick="()=>_ordenCambio=null">Cancelar</button><button class="btn btn-primary" @onclick="GuardarCambioAsignacionAsync">Guardar cambio auditable</button></div></div></div></div>
    }
</div>

@code {
    private int? NhclPreseleccionado { get; set; }

    private List<CatalogoItemGenericoDto> _especialidades = new();
    private List<CatalogoItemGenericoDto> _medicosDisponibles = new();
    private List<ConteoMedicoEsperaDto> _conteoMedicos = new();
    private List<PacienteMascotaDto> _pacientesEncontrados = new();
    private List<OrdenAtencionResumenDto> _ordenes = new();
    private OrdenAtencionResumenDto? _ordenCambio;
    private List<CatalogoItemGenericoDto> _medicosCambio = new();
    private int _cambioEspecialidad, _cambioMedico;

    private NuevaOrdenAtencionDto _nuevaOrden = new();
    private string _filtroPaciente = string.Empty;
    private string _filtroOrdenTexto = string.Empty;
    private string _filtroEtapa = string.Empty;
    private DateTime _fechaConsulta = DateTime.Today;
    private bool _cargandoInicial = true;
    private string _mensajeAlerta = string.Empty;
    private bool _esError;
    private bool _mostrarFormularioOrden;
    private int OrdenesEnAtencion => _ordenes.Count(o => o.Etapa.Contains("Consulta", StringComparison.OrdinalIgnoreCase));
    private int OrdenesPendientes => _ordenes.Count(o => o.Facturado != "S");
    private int OrdenesEnEspera => Math.Max(0, _conteoMedicos.Sum(m => m.EnEspera));
    private static readonly (string Clave, string Titulo, string Clase, string Icono)[] EtapasResumen =
    [
        ("ESPERA", "En espera", "waiting", "⌛"),
        ("Consulta", "En atención", "attention", "▣"),
        ("PENDIENTE", "Pendientes", "pending", "✓"),
        ("FINALIZADO", "Finalizados", "finished", "◉")
    ];

    private List<OrdenAtencionResumenDto> FiltrarPorEtapa(string etapa) => etapa switch
    {
        "ESPERA" => _ordenes.Where(o => string.IsNullOrWhiteSpace(o.Etapa)).ToList(),
        "PENDIENTE" => _ordenes.Where(o => o.Facturado != "S" && !o.Etapa.Contains("Consulta", StringComparison.OrdinalIgnoreCase)).ToList(),
        "FINALIZADO" => _ordenes.Where(o => o.Etapa.Contains("Final", StringComparison.OrdinalIgnoreCase)).ToList(),
        _ => _ordenes.Where(o => o.Etapa.Contains(etapa, StringComparison.OrdinalIgnoreCase)).ToList()
    };

    private static string InicialesMedico(string nombre)
    {
        var partes = (nombre ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(partes.Take(2).Select(p => p[0])).ToUpperInvariant();
    }

    private static string InicialPaciente(string nombre) => string.IsNullOrWhiteSpace(nombre) ? "?" : nombre.Trim()[..1].ToUpperInvariant();

    private string ObtenerFotoPaciente(int nhcl)
    {
        if (nhcl <= 0) return string.Empty;
        string directorio = Path.Combine(Env.WebRootPath, "PacientesFotos");
        if (!Directory.Exists(directorio)) return string.Empty;
        string? archivo = Directory.EnumerateFiles(directorio, $"{nhcl}.*").FirstOrDefault();
        return archivo is null ? string.Empty : $"/pacientes-fotos/{nhcl}?v={File.GetLastWriteTimeUtc(archivo).Ticks}";
    }

    private static string TextoPrioridad(string color) => color?.ToLowerInvariant() switch
    {
        "red" => "Emergencia",
        "yellow" => "Prioritario",
        _ => "Estándar"
    };

    private static string ClaseTriaje(string color) => color?.ToLowerInvariant() switch
    {
        "red" => "red",
        "yellow" => "yellow",
        _ => "green"
    };

    protected override async Task OnInitializedAsync()
    {
        _cargandoInicial = true;
        await Task.Yield();

        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        if (!string.IsNullOrWhiteSpace(uri.Query))
        {
            var q = System.Web.HttpUtility.ParseQueryString(uri.Query);
            if (int.TryParse(q["nhcl"], out int qNhcl) && qNhcl > 0)
            {
                NhclPreseleccionado = qNhcl;
                _mostrarFormularioOrden = true;
            }
        }

        var tEsp = AdmisionService.ObtenerEspecialidadesAsync();
        var tPac = BuscarPacientesAsync();
        var tOrd = CargarOrdenesAsync();
        await Task.WhenAll(tEsp, tPac, tOrd);

        _especialidades = await tEsp;
        int espInicial = _especialidades.FirstOrDefault()?.Id ?? 1;
        _medicosDisponibles = await AdmisionService.ObtenerMedicosPorEspecialidadAsync(espInicial);

        _nuevaOrden.IdEspecialidad = espInicial;
        _nuevaOrden.IdMedico = _medicosDisponibles.FirstOrDefault()?.Id ?? 1;

        if (NhclPreseleccionado.HasValue && NhclPreseleccionado.Value > 0)
        {
            var encontrado = _pacientesEncontrados.FirstOrDefault(p => p.MasNhcl == NhclPreseleccionado.Value);
            if (encontrado != null)
            {
                SeleccionarPacienteParaOrden(encontrado);
            }
        }
        else if (_pacientesEncontrados.Count > 0)
        {
            SeleccionarPacienteParaOrden(_pacientesEncontrados[0]);
        }
        _cargandoInicial = false;
    }

    private async Task BuscarPacientesAsync()
    {
        _pacientesEncontrados = await AdmisionService.BuscarMascotasAsync(_filtroPaciente);
    }

    private void AbrirFormularioOrden() => _mostrarFormularioOrden = true;
    private void CerrarFormularioOrden() => _mostrarFormularioOrden = false;

    private void SeleccionarPacienteParaOrden(PacienteMascotaDto pac)
    {
        _nuevaOrden.Nhcl = pac.MasNhcl;
        _nuevaOrden.IdCliente = pac.MasIdCliente;
        _nuevaOrden.NombreMascota = pac.MasNombre;
        _nuevaOrden.NombrePropietario = pac.ClienteNombre;
        _nuevaOrden.TipoOrigen = pac.MasOrigen;
        _nuevaOrden.ColorTriaje = pac.MasColorTriaje;
    }

    private async Task CambiarEspecialidadAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idEsp))
        {
            _nuevaOrden.IdEspecialidad = idEsp;
            _medicosDisponibles = await AdmisionService.ObtenerMedicosPorEspecialidadAsync(idEsp);
            _nuevaOrden.IdMedico = _medicosDisponibles.FirstOrDefault()?.Id ?? 1;
        }
    }

    private async Task CrearOrdenAtencionAsync()
    {
        if (_nuevaOrden.Nhcl <= 0)
        {
            _esError = true;
            _mensajeAlerta = "Seleccione primero un paciente (NHCL) de la lista.";
            return;
        }

        _nuevaOrden.IdLocalidad = SessionState.Localidad;
        int idUsuario = SessionState.UsuarioActual?.IdUsuario ?? 1;
        int idCreada = await AdmisionService.CrearOrdenAtencionAsync(_nuevaOrden, idUsuario, "127.0.0.1");
        await CargarOrdenesAsync();

        _esError = false;
        _mensajeAlerta = $"Orden de Atención #{idCreada} creada exitosamente para {_nuevaOrden.NombreMascota} (NHCL #{_nuevaOrden.Nhcl}).";
        _mostrarFormularioOrden = false;
    }

    private async Task CambiarFechaTableroAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var fec))
        {
            _fechaConsulta = fec;
            await CargarOrdenesAsync();
        }
    }

    private async Task CambiarEtapaFiltroAsync(ChangeEventArgs e)
    {
        _filtroEtapa = e.Value?.ToString() ?? string.Empty;
        await CargarOrdenesAsync();
    }

    private async Task CargarOrdenesAsync()
    {
        _ordenes = await AdmisionService.ObtenerOrdenesDelDiaAsync(_fechaConsulta, _filtroOrdenTexto, _filtroEtapa);
        _conteoMedicos = await AdmisionService.ObtenerConteoMedicosEsperaAsync(_fechaConsulta, 0);
    }

    private async Task AbrirCambioAsignacion(OrdenAtencionResumenDto orden)
    {
        _ordenCambio = orden;
        _cambioEspecialidad = _especialidades.FirstOrDefault(e => e.Descripcion == orden.Especialidad)?.Id ?? _especialidades.FirstOrDefault()?.Id ?? 1;
        _medicosCambio = await AdmisionService.ObtenerMedicosPorEspecialidadAsync(_cambioEspecialidad);
        _cambioMedico = _medicosCambio.Any(m => m.Id == orden.IdMedico) ? orden.IdMedico : _medicosCambio.FirstOrDefault()?.Id ?? 0;
    }

    private async Task CambiarEspecialidadCambioAsync(ChangeEventArgs e)
    {
        if(!int.TryParse(e.Value?.ToString(),out _cambioEspecialidad))return;
        _medicosCambio=await AdmisionService.ObtenerMedicosPorEspecialidadAsync(_cambioEspecialidad);
        _cambioMedico=_medicosCambio.FirstOrDefault()?.Id??0;
    }

    private async Task GuardarCambioAsignacionAsync()
    {
        if(_ordenCambio is null)return;
        bool ok=await AdmisionService.CambiarAsignacionOrdenAsync(_ordenCambio.IdOrden,_cambioMedico,_cambioEspecialidad,SessionState.IdUser);
        _esError=!ok;_mensajeAlerta=ok?"Asignación actualizada y auditada.":"No se pudo actualizar la asignación.";if(ok)_ordenCambio=null;await CargarOrdenesAsync();
    }

    private async Task AnularOrdenAsync(int idOrden)
    {
        bool confirmar=await JS.InvokeAsync<bool>("confirm",$"¿Anular la orden #{idOrden}?");if(!confirmar)return;
        bool ok=await AdmisionService.AnularOrdenAsync(idOrden,SessionState.IdUser);_esError=!ok;_mensajeAlerta=ok?"Orden anulada.":"No se pudo anular la orden.";await CargarOrdenesAsync();
    }

    private async Task ExportarPdfAsync(){var bytes=ReportService.GenerarOrdenesAtencionPdf(_ordenes,_fechaConsulta,_fechaConsulta);await DescargarAsync(bytes,"application/pdf",$"Ordenes_{_fechaConsulta:yyyyMMdd}.pdf");}
    private async Task ExportarExcelAsync(){var bytes=ReportService.GenerarOrdenesAtencionExcel(_ordenes,_fechaConsulta,_fechaConsulta);await DescargarAsync(bytes,"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",$"Ordenes_{_fechaConsulta:yyyyMMdd}.xlsx");}
    private async Task DescargarAsync(byte[] bytes,string mime,string nombre){var b64=Convert.ToBase64String(bytes);await JS.InvokeVoidAsync("eval",$"{{const a=document.createElement('a');a.href='data:{mime};base64,{b64}';a.download='{nombre}';a.click();}}");}

    private static string ObtenerColorHexTriaje(string color) => color switch
    {
        "red" => "#dc2626",
        "yellow" => "#d97706",
        _ => "#16a34a"
    };

    private static string ObtenerBadgeEtapa(string etapa) => etapa switch
    {
        "Hospitalización" => "bg-info text-dark",
        "Quirófano" => "bg-danger",
        "Imagenología" => "bg-primary",
        "Laboratorio" => "bg-secondary",
        _ => "bg-success"
    };
}
