@page "/recuperar-contrasena"
@layout Layout.PublicLayout
<PageTitle>Nueva contraseña | e-ForVets</PageTitle>
<div class="account-page"><a class="account-brand" href="/"><img src="/favicon.png" alt="" /><strong>e-ForVets</strong></a><section class="account-card compact"><div class="recovery-icon">⌁</div><div class="account-heading"><span>Restablecer acceso</span><h1>Crea una nueva contraseña</h1><p>Esta pantalla requiere un token válido emitido por el servidor.</p></div>
    <div class="warning-message" role="alert">No se recibió un token de recuperación válido o el servicio aún no está configurado.</div>
    <form><label>Nueva contraseña<input type="password" disabled autocomplete="new-password" /></label><label>Confirmar nueva contraseña<input type="password" disabled autocomplete="new-password" /></label><button class="submit-button" type="button" disabled>Guardar nueva contraseña</button></form><p class="account-footer"><a href="/login">← Volver a iniciar sesión</a></p>
</section></div>
