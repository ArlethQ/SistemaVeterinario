@page "/recuperar-contrasena"
@layout Layout.PublicLayout

<PageTitle>Nueva contraseña | e-ForVets</PageTitle>
<AuthPageShell Title="Nueva contraseña" Description="Crea una nueva contraseña para tu cuenta.">
    <div class="warning-message" role="alert">No se recibió un token de recuperación válido o el servicio aún no está configurado.</div>
    <form>
        <label>Nueva contraseña<span class="field-control"><i class="bi bi-lock field-icon" aria-hidden="true"></i><input type="password" disabled autocomplete="new-password" placeholder="Ingresa tu nueva contraseña" /></span></label>
        <label>Confirmar nueva contraseña<span class="field-control"><i class="bi bi-lock field-icon" aria-hidden="true"></i><input type="password" disabled autocomplete="new-password" placeholder="Confirma tu contraseña" /></span></label>
        <button class="submit-button" type="button" disabled>Guardar nueva contraseña</button>
    </form>
    <p class="account-footer"><a href="/login"><i class="bi bi-arrow-left" aria-hidden="true"></i> Volver a iniciar sesión</a></p>
</AuthPageShell>
