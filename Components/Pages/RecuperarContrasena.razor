@page "/recuperar-contrasena"
@page "/olvide-contrasena"
@layout Layout.PublicLayout
<PageTitle>e-ForVets - Recuperar contraseña</PageTitle>
<div class="account-page">
    <a class="account-brand" href="/"><span>eF</span><strong>e-ForVets</strong></a>
    <section class="account-card compact">
        <div class="recovery-icon">🔐</div><div class="account-heading"><span>Recuperación de acceso</span><h1>¿Olvidaste tu contraseña?</h1><p>Ingresa el correo asociado a tu cuenta. Te enviaremos las instrucciones para recuperarla.</p></div>
        @if (_enviado) { <div class="success-message"><strong>Revisa tu correo</strong><span>Si existe una cuenta asociada, recibirás las instrucciones de recuperación.</span></div> }
        else { <form @onsubmit="Enviar" @onsubmit:preventDefault><label>Correo electrónico<input required type="email" @bind="_correo" placeholder="nombre@correo.com" /></label><button type="submit">Enviar instrucciones</button></form> }
        <p class="account-footer"><a href="/login">← Volver a iniciar sesión</a></p>
    </section>
</div>
@code { private string _correo=string.Empty; private bool _enviado; private void Enviar()=>_enviado=true; }
