@page "/reportes/clinicos"
@inject IGestionMigradaService Service
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Reportes clínicos | e-ForVets</PageTitle>
@if(_autorizado){<div class="container-fluid py-3"><div class="d-flex flex-wrap gap-2 justify-content-between align-items-end mb-3"><div><small class="text-primary fw-bold">REPORTERÍA</small><h2>Reportes clínicos</h2></div><div class="d-flex gap-2">@if(_tab=="partes"){<button class="btn btn-outline-danger" disabled="@(!_partes.Any() || _cargando)" @onclick="ExportarPartesPdf"><i class="bi bi-file-earmark-pdf-fill me-1"></i>Imprimir consolidado</button>}<button class="btn btn-primary" disabled="@_cargando" @onclick="Cargar">@(_cargando ? "Consultando..." : "Consultar")</button></div></div>
<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-3"><label>Desde</label><input type="date" class="form-control" @bind="_desde"/></div><div class="col-md-3"><label>Hasta</label><input type="date" class="form-control" @bind="_hasta"/></div></div></div>
<ul class="nav nav-tabs mb-3">@foreach(var t in new[]{("atenciones","Atenciones"),("diagnosticos","Diagnósticos consolidados"),("partes","Parte operatorio")}){<li class="nav-item"><button class="nav-link @(_tab==t.Item1?"active":"")" @onclick="()=>Cambiar(t.Item1)">@t.Item2</button></li>}</ul>
@if(!string.IsNullOrEmpty(_error)){<div class="alert alert-danger">@_error</div>}<div class="table-responsive card"><table class="table table-hover mb-0"><thead class="table-light">@if(_tab=="atenciones"){<tr><th>Fecha</th><th>Orden/NHCL</th><th>Paciente/cliente</th><th>Médico</th><th>Diagnóstico</th><th>Localidad</th></tr>}else if(_tab=="diagnosticos"){<tr><th>Fecha</th><th>Orden/NHCL</th><th>Paciente/cliente</th><th>Médico</th><th>Diagnóstico</th><th>Tipo</th></tr>}else{<tr><th>Fecha</th><th>Orden/NHCL</th><th>Paciente/propietario</th><th>Procedimiento</th><th>Diagnóstico</th></tr>}</thead><tbody>
@if(_tab=="atenciones"){@foreach(var x in _atenciones){<tr><td>@x.Fecha.ToString("g")</td><td>@x.Orden / @x.Nhcl</td><td><strong>@x.Paciente</strong><small class="d-block">@x.Cliente</small></td><td>@x.Medico</td><td>@x.Diagnostico</td><td>@x.Localidad</td></tr>}}else if(_tab=="diagnosticos"){@foreach(var x in _diagnosticos){<tr><td>@x.Fecha.ToString("g")</td><td>@x.Orden / @x.Nhcl</td><td><strong>@x.Paciente</strong><small class="d-block">@x.Cliente</small></td><td>@x.Medico</td><td>@x.Diagnostico</td><td>@x.Tipo</td></tr>}}else{@foreach(var x in _partes){<tr><td>@x.Fecha.ToString("g")</td><td>@x.IdOrden / @x.Nhcl</td><td><strong>@x.Paciente</strong><small class="d-block">@x.Propietario</small></td><td>@x.Procedimiento</td><td>@x.Diagnostico <button class="btn btn-sm btn-outline-primary float-end" @onclick='()=>Nav.NavigateTo($"/quirofano/protocolo/{x.IdOrden}/{x.Nhcl}")'>Ver e imprimir</button></td></tr>}}@if(!_cargando && ((_tab=="atenciones"&&!_atenciones.Any())||(_tab=="diagnosticos"&&!_diagnosticos.Any())||(_tab=="partes"&&!_partes.Any()))){<tr><td colspan="6" class="text-center text-muted py-4">No existen registros para el período seleccionado.</td></tr>}</tbody></table></div></div>}
@code{bool _autorizado,_cargando;string _tab="atenciones",_error="";DateTime _desde=DateTime.Today.AddMonths(-1),_hasta=DateTime.Today;List<ReporteAtencionDto> _atenciones=[];List<ReporteDiagnosticoDto> _diagnosticos=[];List<ParteOperatorioResumenDto> _partes=[];protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated){Nav.NavigateTo("/login");return;}_autorizado=true;await Cargar();}async Task Cambiar(string t){_tab=t;await Cargar();}async Task Cargar(){_error="";if(_desde>_hasta){_error="La fecha inicial no puede superar la fecha final.";return;}_cargando=true;try{if(_tab=="atenciones")_atenciones=await Service.ObtenerAtencionesAsync(_desde,_hasta);else if(_tab=="diagnosticos")_diagnosticos=await Service.ObtenerDiagnosticosAsync(_desde,_hasta);else _partes=await Service.ObtenerPartesOperatoriosAsync(_desde,_hasta);}catch(Exception ex){_error=$"No se pudo generar el reporte: {ex.Message}";}finally{_cargando=false;}}async Task ExportarPartesPdf(){if(!_partes.Any())return;var bytes=ReportService.GenerarPartesOperatoriosPdf(_partes,_desde,_hasta);await JS.InvokeVoidAsync("descargarArchivoBase64",$"PartesOperatorios_{_desde:yyyyMMdd}_{_hasta:yyyyMMdd}.pdf","application/pdf",Convert.ToBase64String(bytes));}}
