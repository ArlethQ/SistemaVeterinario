@page "/quirofano/protocolo"
@page "/quirofano/protocolo/{IdOrden:int}/{Nhcl:int}"
@inject IKardexService KardexService
@inject IQuirofanoService QuirofanoService
@inject IInventarioService InventarioService
@inject IFarmaciaService FarmaciaService
@inject IReportExportService ReportService
@inject NavigationManager Nav
@inject IWebHostEnvironment Environment
@inject SessionStateService Session
@inject IJSRuntime JS

<PageTitle>Protocolo Quirúrgico y Chequeo de Cirugía - e-ForVets</PageTitle>

<div class="protocolo-view">
<header class="protocolo-header mb-3">
    <div class="protocolo-heading">
        <i class="bi bi-scissors" aria-hidden="true"></i>
        <div>
            <h1>Protocolo quirúrgico</h1>
            <p>Acto operatorio, equipo quirúrgico y chequeo de cirugía segura.</p>
        </div>
    </div>

    @if (paciente != null)
    {
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <SaveButton class="btn btn-sm btn-success fw-semibold" OnClick="GuardarProtocoloAsync" Disabled="@guardando">
                @(guardando ? "Guardando..." : "Guardar Protocolo")
            </SaveButton>
            <button class="btn btn-sm btn-danger app-doc-action app-doc-pdf" @onclick="ExportarPdfAsync"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Exportar PDF</button>
            @if (Permisos.Permite("quirofano/pausa-seguridad"))
            {
                <a class="btn btn-sm btn-outline-warning" href="/quirofano/pausa-seguridad/@IdOrden/@Nhcl">Pausa Seguridad</a>
            }
            @if (Permisos.Permite("quirofano/recuperacion"))
            {
                <a class="app-workflow-action app-workflow-recovery" href="/quirofano/recuperacion/@IdOrden/@Nhcl"><i class="bi bi-heart-pulse" aria-hidden="true"></i> Ir a Recuperación</a>
            }
        </div>
    }
</header>

<div class="protocolo-panel protocolo-search d-flex flex-wrap gap-2 align-items-center mb-3">
    <select class="form-select form-select-sm protocolo-orden" aria-label="Orden activa" value="@IdOrden" @onchange="OnOrdenSelectChangedAsync">
        <option value="0">-- Seleccionar Orden Activa --</option>
        @foreach (var ord in ordenesActivas)
        {
            <option value="@ord.IdOrdenAtencion">#@ord.IdOrdenAtencion | NHCL:@ord.Nhcl - @ord.Paciente (@ord.Cliente)</option>
        }
    </select>

    <BuscadorOrdenClinica @bind-Orden="ordenInput" @bind-Nhcl="nhclInput" OnBuscar="CargarPorInputAsync" />
</div>

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small" role="alert">
        @mensajeAlerta
        <button type="button" class="btn-close py-2" @onclick="() => mensajeAlerta = string.Empty"></button>
    </div>
}

@if (cargandoInicial)
{
    <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span class="fw-semibold small">Cargando protocolo quirúrgico y equipo operatorio...</span>
    </div>
}
else if (paciente != null)
{
    <SelectorCirugiaOperacion Cirugias="_cirugiasOrden"
                              IdCirugiaSeleccionada="_idCirugiaActiva"
                              ModuloClave="protocolo"
                              OnCirugiaCambiada="CambiarCirugiaActivaAsync" />

    <!-- Cabecera Paciente -->
    <section class="protocolo-panel protocolo-patient mb-3" aria-label="Datos de la orden y del paciente">
        <div><i class="bi bi-clipboard" aria-hidden="true"></i><div>
            <span>Orden / NHCL</span>
            <strong>#@paciente.OrdenAtencionId / @paciente.Nhcl</strong>
        </div></div>
        <div><i class="bi bi-heart-pulse" aria-hidden="true"></i><div>
            <span>Paciente</span>
            <strong class="text-primary">@paciente.PacienteNombre</strong>
            <small>@paciente.Especie · @paciente.Raza</small>
        </div></div>
        <div><i class="bi bi-gender-ambiguous" aria-hidden="true"></i><div>
            <span>Edad / Sexo</span>
            <strong>@paciente.EdadTexto / @paciente.Sexo</strong>
        </div></div>
        <div><i class="bi bi-person" aria-hidden="true"></i><div>
            <span>Propietario</span>
            <strong>@paciente.PropietarioNombre</strong>
        </div></div>
    </section>

    <!-- Pestañas del Módulo Quirúrgico -->
    <ul class="nav nav-tabs protocolo-tabs mb-3 fw-semibold">
        <li class="nav-item">
            <button class="nav-link @(tabActiva == 1 ? "active" : "")" @onclick="() => CambiarTab(1)">
                1. Protocolo Operatorio y Chequeo Quirúrgico
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == 2 ? "active" : "")" @onclick="() => CambiarTab(2)">
                2. Equipo Quirúrgico Interviniente (@protDto.Equipo.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == 3 ? "active" : "")" @onclick="() => CambiarTab(3)">
                3. Archivos y Fotos de Cirugía (@archivosQuirurgicos.Count)
            </button>
        </li>
    </ul>

    @if (tabActiva == 1)
    {
        <div class="row g-3">
            <!-- Columna Izquierda: Descripción del Acto Quirúrgico (qvt_Protocolo) -->
            <div class="col-lg-7">
                <div class="card protocolo-panel mb-3">
                    <div class="card-header protocolo-section fw-bold">
                        1. Protocolo Operatorio
                    </div>
                <div class="card-body small">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label mb-1 fw-semibold">Fecha Cirugía</label>
                            <input type="date" class="form-control form-control-sm" @bind="protDto.Fecha" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-1 fw-semibold">Carácter de la Cirugía</label>
                            <select class="form-select form-select-sm" @bind="protDto.TipoCirugia">
                                <option value="Electiva">Electiva / Programada</option>
                                <option value="Emergencia">Emergencia / Urgencia</option>
                                <option value="Paliativa">Paliativa / Diagnóstica</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-1 fw-semibold">Sangrado Estimado (ml)</label>
                            <input type="number" class="form-control form-control-sm" @bind="protDto.Sangrado" />
                        </div>

                        <!-- Horario y Duración de Cirugía -->
                        <div class="col-md-4">
                            <label class="form-label mb-1 fw-semibold">
                                <i class="bi bi-clock me-1 text-primary"></i>Hora Inicio Cirugía
                            </label>
                            <input type="time" class="form-control form-control-sm" value="@protDto.HoraInicio" @onchange="OnHoraInicioChanged" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-1 fw-semibold">
                                <i class="bi bi-clock-fill me-1 text-primary"></i>Hora Fin Cirugía
                            </label>
                            <input type="time" class="form-control form-control-sm @(errorHorarioCirugia ? "is-invalid" : "")" value="@protDto.HoraFin" @onchange="OnHoraFinChanged" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-1 fw-semibold">
                                <i class="bi bi-hourglass-split me-1 text-primary"></i>Tiempo de Operación
                            </label>
                            <div class="d-flex align-items-center" style="min-height: 31px;">
                                @if (errorHorarioCirugia)
                                {
                                    <span class="badge bg-danger text-wrap text-start py-1">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Fin menor a inicio
                                    </span>
                                }
                                else if (!string.IsNullOrWhiteSpace(duracionCirugiaTexto))
                                {
                                    <span class="badge bg-success-subtle text-success border border-success fw-bold px-2 py-1 fs-6">
                                        <i class="bi bi-stopwatch me-1"></i> @duracionCirugiaTexto
                                    </span>
                                    @if (protDto.DuracionMinutos > 0)
                                    {
                                        <small class="text-muted ms-2">(@protDto.DuracionMinutos min)</small>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        <i class="bi bi-dash-circle me-1"></i> Sin registrar
                                    </span>
                                }
                            </div>
                            @if (errorHorarioCirugia)
                            {
                                <small class="text-danger d-block mt-1">La hora final no puede ser anterior a la de inicio.</small>
                            }
                        </div>

                        <div class="col-12">
                            <label class="form-label mb-1 fw-semibold">Operación / Procedimiento Quirúrgico Realizado</label>
                            <input type="text" class="form-control form-control-sm" @bind="protDto.Principal" placeholder="Ej: Ovariohisterectomía / Laparotomía Exploratoria / Osteosíntesis..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label mb-1 fw-semibold">Diéresis / Incisión y Abordaje</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="protDto.Incision" placeholder="Tipo de incisión, plano anatómico abordado..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label mb-1 fw-semibold">Hallazgos Intraoperatorios</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="protDto.Hallazgos" placeholder="Descripción detallada de órganos y lesiones encontradas..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label mb-1 fw-semibold">Descripción de la Técnica / Procedimiento Quirúrgico</label>
                            <textarea class="form-control form-control-sm" rows="4" @bind="protDto.ProcedimientoQuir" placeholder="Detalle paso a paso del procedimiento ejecutado, ligaduras, implantes..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label mb-1 fw-semibold">Síntesis / Cierre por Planos</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="protDto.Sintesis" placeholder="Material de sutura y patrón empleado en fascia, subcutáneo y piel..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label mb-1 fw-semibold">Complicaciones Intraoperatorias</label>
                            <input type="text" class="form-control form-control-sm" @bind="protDto.Complicaciones" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label mb-1 fw-semibold">Envío Muestra Patología</label>
                            <select class="form-select form-select-sm" @bind="protDto.Muestra">
                                <option value="NO">NO</option>
                                <option value="SI">SÍ (Histopatología)</option>
                                <option value="CULTIVO">SÍ (Cultivo)</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label mb-1 fw-semibold">Uso de Drenajes</label>
                            <select class="form-select form-select-sm" @bind="protDto.Drenaje">
                                <option value="0">Sin Drenaje</option>
                                <option value="1">Penrose / Pasivo</option>
                                <option value="2">Activo / Cerrado</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

            <!-- Columna Derecha: Chequeo de Enfermería Quirúrgica y Conteo de Gasas (qvt_ingresocirugia) -->
            <div class="col-lg-5">
                <div class="card protocolo-panel mb-3">
                    <div class="card-header protocolo-section fw-bold">
                        2. Chequeo Quirúrgico y Conteo de Textiles
                    </div>
                    <div class="card-body small">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-semibold">Quirófano / Sala #</label>
                                <input type="number" class="form-control form-control-sm" @bind="protDto.Sala" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-semibold">Posición Quirúrgica</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.Posicion" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-semibold">Clasificación Herida</label>
                                <select class="form-select form-select-sm" @bind="protDto.CasoContaminado">
                                    <option value="Limpia">Limpia</option>
                                    <option value="Limpia-Contaminada">Limpia-Contaminada</option>
                                    <option value="Contaminada">Contaminada</option>
                                    <option value="Sucia / Infectada">Sucia / Infectada</option>
                                </select>
                            </div>

                            <div class="col-md-4 position-relative">
                                <label class="form-label mb-0 fw-semibold">Antisepsia / Lavado <small class="text-muted fw-normal">(stock)</small></label>
                                <input type="text" class="form-control form-control-sm" autocomplete="off"
                                       disabled="@_descargadoAntisepsia"
                                       @bind="protDto.Lavado" @bind:event="oninput"
                                       @onfocus="() => AbrirSugerenciasStockAsync(1)"
                                       @onblur="CerrarSugerenciasStockAsync"
                                       placeholder="Buscar en stock..." />
                                @if (_sugStockTipo == 1)
                                {
                                    var sugs = FiltrarStock(protDto.Lavado);
                                    <div class="list-group position-absolute start-0 bg-white border rounded shadow-sm mt-1" style="z-index:1060; min-width:250px; max-height:190px; overflow-y:auto;">
                                        @if (sugs.Count == 0)
                                        {
                                            <div class="list-group-item py-1 px-2 text-muted small">Sin bienes en stock</div>
                                        }
                                        else
                                        {
                                            @foreach (var prod in sugs)
                                            {
                                                var p = prod;
                                                <button type="button" class="list-group-item list-group-item-action py-1 px-2 small d-flex justify-content-between align-items-center gap-2 text-start"
                                                        @onmousedown="() => SeleccionarStockAntisepsia(p)">
                                                    <span class="text-truncate">@p.DisplayName</span>
                                                    <span class="badge text-bg-success text-nowrap">@p.Available.ToString("N2") @p.BaseUnitOfMeasureCode</span>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                                @if (_stockAntisepsia != null)
                                {
                                    <div class="input-group input-group-sm mt-1">
                                        <input type="number" step="0.01" min="0" max="@_stockAntisepsia.Available"
                                               class="form-control text-center @(_cantAntisepsia > _stockAntisepsia.Available ? "is-invalid" : "")"
                                               disabled="@_descargadoAntisepsia"
                                               value="@_cantAntisepsia" @onchange="OnCantAntisepsiaChanged" />
                                        <span class="input-group-text bg-light text-secondary px-1" style="font-size:10px;">@_stockAntisepsia.BaseUnitOfMeasureCode</span>
                                        @if (_descargadoAntisepsia)
                                        {
                                            <span class="input-group-text bg-success text-white px-2" title="Descargado"><i class="bi bi-check-lg"></i></span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-success px-2" disabled="@(_descargandoStock || _cantAntisepsia <= 0 || _cantAntisepsia > _stockAntisepsia.Available)"
                                                    title="Descargar del inventario (máx. @_stockAntisepsia.Available.ToString("0.##") @_stockAntisepsia.BaseUnitOfMeasureCode)"
                                                    @onclick="DescargarAntisepsiaAsync"><i class="bi bi-box-arrow-down"></i></button>
                                        }
                                    </div>
                                    <div class="text-muted" style="font-size:10px;">Disponible: <strong>@_stockAntisepsia.Available.ToString("0.##") @_stockAntisepsia.BaseUnitOfMeasureCode</strong></div>
                                }
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-semibold">Unidad Electrocirugía</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.UnidadElectro" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-semibold">Placa Retorno</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.LocalizacionPlaca" />
                            </div>

                            <div class="col-12 position-relative">
                                <label class="form-label mb-0 fw-semibold text-primary">Bien de Gasas <small class="text-muted fw-normal">(elija ítem con stock para limitar cantidades)</small></label>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" autocomplete="off"
                                           disabled="@_descargadoGasas"
                                           @bind="_filtroGasasStock" @bind:event="oninput"
                                           @onfocus="() => AbrirSugerenciasStockAsync(2)"
                                           @onblur="CerrarSugerenciasStockAsync"
                                           placeholder="Buscar gasas en stock..." />
                                    @if (_stockGasas != null)
                                    {
                                        <span class="input-group-text bg-light text-secondary fw-semibold" style="font-size:11px;">
                                            Disp: @_stockGasas.Available.ToString("0.##") @_stockGasas.BaseUnitOfMeasureCode
                                        </span>
                                        @if (_descargadoGasas)
                                        {
                                            <span class="input-group-text bg-success text-white px-2" title="Gasas descargadas del inventario"><i class="bi bi-check-lg me-1"></i>Descargado</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-success px-2"
                                                    disabled="@(_descargandoStock || TotalGasasUsadas <= 0 || GasasExcedenStock)"
                                                    title="Descargar total de gasas usadas (@TotalGasasUsadas @_stockGasas.BaseUnitOfMeasureCode)"
                                                    @onclick="DescargarGasasAsync">
                                                <i class="bi bi-box-arrow-down me-1"></i>Descargar (@TotalGasasUsadas)
                                            </button>
                                        }
                                    }
                                </div>
                                @if (_sugStockTipo == 2)
                                {
                                    var sugs = FiltrarStock(_filtroGasasStock);
                                    <div class="list-group position-absolute start-0 end-0 bg-white border rounded shadow-sm mt-1" style="z-index:1060; max-height:190px; overflow-y:auto;">
                                        @if (sugs.Count == 0)
                                        {
                                            <div class="list-group-item py-1 px-2 text-muted small">Sin bienes en stock</div>
                                        }
                                        else
                                        {
                                            @foreach (var prod in sugs)
                                            {
                                                var p = prod;
                                                <button type="button" class="list-group-item list-group-item-action py-1 px-2 small d-flex justify-content-between align-items-center gap-2 text-start"
                                                        @onmousedown="() => SeleccionarStockGasas(p)">
                                                    <span class="text-truncate">@p.DisplayName</span>
                                                    <span class="badge text-bg-success text-nowrap">@p.Available.ToString("N2") @p.BaseUnitOfMeasureCode</span>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                                @if (GasasExcedenStock && _stockGasas != null)
                                {
                                    <div class="text-danger fw-semibold mt-1" style="font-size:11px;">
                                        El total de gasas (@TotalGasasUsadas) supera el stock disponible (@_stockGasas.Available.ToString("0.##") @_stockGasas.BaseUnitOfMeasureCode).
                                    </div>
                                }
                            </div>

                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-bold text-primary">Gasas Iniciales</label>
                                <input type="number" min="0" max="@(_stockGasas != null ? (int)Math.Floor(_stockGasas.Available) : 9999)"
                                       class="form-control form-control-sm @(GasasExcedenStock ? "is-invalid" : "")"
                                       disabled="@_descargadoGasas"
                                       value="@protDto.GasasIniciales" @onchange="OnGasasInicialesChanged" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-bold text-primary">Gasas Adicionales</label>
                                <input type="number" min="0" max="@(_stockGasas != null ? Math.Max(0, (int)Math.Floor(_stockGasas.Available) - ParseEntero(protDto.GasasIniciales)) : 9999)"
                                       class="form-control form-control-sm @(GasasExcedenStock ? "is-invalid" : "")"
                                       disabled="@_descargadoGasas"
                                       value="@protDto.GasasAdicionales" @onchange="OnGasasAdicionalesChanged" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-bold text-success">Recuento Final</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.GasasRecuentoFinal" />
                            </div>

                            <div class="col-md-6 position-relative">
                                <label class="form-label mb-0 fw-semibold">Conteo Compresas / Cotonoides <small class="text-muted fw-normal">(stock opcional)</small></label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.Compresas" placeholder="Ej: Completas" />
                                <div class="input-group input-group-sm mt-1">
                                    <input type="text" class="form-control" autocomplete="off"
                                           disabled="@_descargadoCompresas"
                                           @bind="_filtroCompresasStock" @bind:event="oninput"
                                           @onfocus="() => AbrirSugerenciasStockAsync(3)"
                                           @onblur="CerrarSugerenciasStockAsync"
                                           placeholder="Elegir compresas en stock..." />
                                    @if (_stockCompresas != null)
                                    {
                                        <input type="number" step="0.01" min="0" max="@_stockCompresas.Available"
                                               class="form-control text-center @(_cantCompresas > _stockCompresas.Available ? "is-invalid" : "")"
                                               style="max-width:65px;" disabled="@_descargadoCompresas"
                                               value="@_cantCompresas" @onchange="OnCantCompresasChanged" />
                                        <span class="input-group-text bg-light text-secondary px-1" style="font-size:10px;">@_stockCompresas.BaseUnitOfMeasureCode</span>
                                        @if (_descargadoCompresas)
                                        {
                                            <span class="input-group-text bg-success text-white px-2" title="Descargado"><i class="bi bi-check-lg"></i></span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-success px-2" disabled="@(_descargandoStock || _cantCompresas <= 0 || _cantCompresas > _stockCompresas.Available)"
                                                    title="Descargar del inventario (máx. @_stockCompresas.Available.ToString("0.##") @_stockCompresas.BaseUnitOfMeasureCode)"
                                                    @onclick="DescargarCompresasAsync"><i class="bi bi-box-arrow-down"></i></button>
                                        }
                                    }
                                </div>
                                @if (_sugStockTipo == 3)
                                {
                                    var sugs = FiltrarStock(_filtroCompresasStock);
                                    <div class="list-group position-absolute start-0 end-0 bg-white border rounded shadow-sm mt-1" style="z-index:1060; max-height:190px; overflow-y:auto;">
                                        @if (sugs.Count == 0)
                                        {
                                            <div class="list-group-item py-1 px-2 text-muted small">Sin bienes en stock</div>
                                        }
                                        else
                                        {
                                            @foreach (var prod in sugs)
                                            {
                                                var p = prod;
                                                <button type="button" class="list-group-item list-group-item-action py-1 px-2 small d-flex justify-content-between align-items-center gap-2 text-start"
                                                        @onmousedown="() => SeleccionarStockCompresas(p)">
                                                    <span class="text-truncate">@p.DisplayName</span>
                                                    <span class="badge text-bg-success text-nowrap">@p.Available.ToString("N2") @p.BaseUnitOfMeasureCode</span>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                                @if (_stockCompresas != null)
                                {
                                    <div class="text-muted" style="font-size:10px;">Disponible: <strong>@_stockCompresas.Available.ToString("0.##") @_stockCompresas.BaseUnitOfMeasureCode</strong></div>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="form-label mb-0 fw-semibold">Paciente Transferido A</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.TransferidoA" />
                            </div>

                            <div class="col-12">
                                <label class="form-label mb-0 fw-semibold">Observaciones de Enfermería de Quirófano</label>
                                <textarea class="form-control form-control-sm" rows="3" @bind="protDto.ObservacionesEnfermeria"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (tabActiva == 2)
    {
        <!-- Pestaña 2: Equipo Quirúrgico (qvt_team / vt_quirTeam) -->
        <div class="card protocolo-panel mb-3">
            <div class="card-header protocolo-section fw-bold d-flex justify-content-between align-items-center">
                <span>Equipo Quirúrgico Interviniente (@protDto.Equipo.Count)</span>
                <small class="text-white fw-normal">Asignación de cirujanos, anestesiólogo, instrumentistas y circulante</small>
            </div>
            <div class="card-body small">
                <!-- Selector Tipo de Miembro (Interno / Externo) -->
                <div class="d-flex align-items-center gap-3 mb-2 px-1">
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="radio" name="tipoMiembro" id="tipoInterno" checked="@(!nuevoMiembro.EsExterno)" @onchange="() => CambiarTipoMiembro(false)">
                        <label class="form-check-label fw-semibold" for="tipoInterno">Personal del Sistema</label>
                    </div>
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="radio" name="tipoMiembro" id="tipoExterno" checked="@nuevoMiembro.EsExterno" @onchange="() => CambiarTipoMiembro(true)">
                        <label class="form-check-label fw-semibold text-primary" for="tipoExterno">
                            <i class="bi bi-person-plus-fill me-1"></i>Médico Externo
                        </label>
                    </div>
                </div>

                <div class="row g-2 mb-3 align-items-end protocolo-toolbar p-2 rounded border">
                    <div class="col-md-5">
                        <label class="form-label mb-1 fw-semibold">Profesional del Sistema</label>
                        <select class="form-select form-select-sm" @bind="nuevoMiembro.IdUsuario">
                            <option value="0">-- Seleccionar Profesional --</option>
                            @foreach (var u in profesionales.Where(u => u.EsExterno == nuevoMiembro.EsExterno))
                            {
                                <option value="@u.UserNumero">@u.UserNombre</option>
                            }
                        </select>
                        @if (nuevoMiembro.EsExterno)
                        {
                            <small class="text-muted">Registre al médico externo en Administración de usuarios antes de seleccionarlo.</small>
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label mb-1 fw-semibold">Rol en Quirófano</label>
                        <select class="form-select form-select-sm" @bind="nuevoMiembro.RolFuncion">
                            <option value="Cirujano Principal">Cirujano Principal</option>
                            <option value="Primer Ayudante">Primer Ayudante</option>
                            <option value="Segundo Ayudante">Segundo Ayudante</option>
                            <option value="Anestesiólogo">Anestesiólogo</option>
                            <option value="Instrumentista">Instrumentista</option>
                            <option value="Circulante">Circulante</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <SaveButton class="btn btn-sm btn-primary w-100 fw-semibold" OnClick="AgregarMiembroAsync">
                            + Añadir al Equipo Quirúrgico
                        </SaveButton>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table protocolo-table table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Profesional</th>
                                <th>Rol en Quirófano</th>
                                <th class="text-center" style="width: 130px;">Condición</th>
                                <th class="text-center" style="width: 90px;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!protDto.Equipo.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No hay integrantes registrados en el equipo de esta cirugía.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var m in protDto.Equipo)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">@m.NombreProfesional</span>
                                            @if (m.EsExterno)
                                            {
                                                <span class="badge bg-info text-dark ms-2">Externo</span>
                                                @if (!string.IsNullOrWhiteSpace(m.Cedula))
                                                {
                                                    <small class="text-muted d-block">C.I.: @m.Cedula</small>
                                                }
                                            }
                                        </td>
                                        <td>@m.RolFuncion</td>
                                        <td class="text-center">
                                            @if (m.Principal)
                                            {
                                                <span class="badge bg-success">Principal</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Asistente</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs btn-outline-danger py-0 px-2"
                                                    title="Eliminar miembro"
                                                    @onclick="() => EliminarMiembroAsync(m.Sec)">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (tabActiva == 3)
    {
        <!-- Pestaña 3: Archivos Quirúrgicos del Paciente (vt_quirArchivos) -->
        <div class="card protocolo-panel mb-3">
            <div class="card-header protocolo-section fw-bold d-flex justify-content-between align-items-center">
                <span>Archivos, Documentos y Evidencia Quirúrgica (@archivosQuirurgicos.Count)</span>
                <span class="badge bg-info-subtle text-info border">Ruta: archivosPacientes/@Nhcl/ingreso</span>
            </div>
            <div class="card-body small">
                <div class="row g-2 mb-3 protocolo-toolbar p-2 rounded align-items-center">
                    <div class="col-md-7">
                        <label class="form-label mb-1 fw-semibold">Subir nuevo archivo / foto quirúrgica (PDF, JPG, PNG, DOCX, XLSX máx 15MB):</label>
                        <InputFile class="form-control form-control-sm" OnChange="SubirArchivoQuirurgicoAsync" accept=".pdf,.jpg,.jpeg,.png,.docx,.xlsx" />
                    </div>
                    <div class="col-md-5 text-muted pt-3">
                        <small>Los archivos subidos quedan asociados al expediente de ingreso quirúrgico del paciente.</small>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table protocolo-table table-hover table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Nombre del Archivo</th>
                                <th style="width: 170px;">Fecha y Hora</th>
                                <th style="width: 110px;">Tamaño</th>
                                <th class="text-center" style="width: 140px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!archivosQuirurgicos.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No existen archivos quirúrgicos cargados para este paciente.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var arc in archivosQuirurgicos)
                                {
                                    <tr>
                                        <td>
                                            <a href="@arc.Url" target="_blank" class="fw-semibold text-decoration-none">
                                                📄 @arc.Nombre
                                            </a>
                                        </td>
                                        <td>@arc.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@arc.TamanoTexto</td>
                                        <td class="text-center">
                                            <a href="@arc.Url" download="@arc.Nombre" class="btn btn-xs btn-outline-primary py-0 px-2 me-1">Descargar</a>
                                            <button class="btn btn-xs btn-outline-danger py-0 px-2" @onclick="() => EliminarArchivoQuirurgico(arc.Nombre)">Eliminar</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

</div>

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }
    [Parameter] public int IdCirugia { get; set; }
    [Parameter] public EventCallback<int> OnCirugiaCambiada { get; set; }

    private int ordenInput;
    private int nhclInput;
    private List<OrdenActivaResumenDto> ordenesActivas = new();
    private List<CirugiaOperacionResumenDto> _cirugiasOrden = [];
    private int _idCirugiaActiva;
    private int tabActiva = 1;
    private PacienteHeaderDto? paciente;
    private ProtocoloQuirurgicoCompletoDto protDto = new();
    private List<FuncionarioDto> profesionales = new();
    private MiembroEquipoQuirurgicoDto nuevoMiembro = new() { RolFuncion = "Cirujano Principal" };
    private List<ArchivoQuirurgicoInfo> archivosQuirurgicos = new();

    private sealed record ArchivoQuirurgicoInfo(string Nombre, string Url, DateTime Fecha, string TamanoTexto);

    private bool cargandoInicial = true;
    private bool guardando;
    private string mensajeAlerta = string.Empty;
    private bool esError;
    private string duracionCirugiaTexto = string.Empty;
    private bool errorHorarioCirugia;

    private List<FarmacoStockDto> _catalogoStock = [];
    private int _localidadStockCargada;
    private int _sugStockTipo; // 1=Antisepsia, 2=Gasas, 3=Compresas
    private bool _descargandoStock;

    private FarmacoStockDto? _stockAntisepsia;
    private decimal _cantAntisepsia = 1m;
    private bool _descargadoAntisepsia;

    private FarmacoStockDto? _stockGasas;
    private string _filtroGasasStock = string.Empty;
    private bool _descargadoGasas;

    private FarmacoStockDto? _stockCompresas;
    private string _filtroCompresasStock = string.Empty;
    private decimal _cantCompresas = 1m;
    private bool _descargadoCompresas;

    private static int ParseEntero(string? val) => int.TryParse(val?.Trim(), out var n) && n > 0 ? n : 0;
    private int TotalGasasUsadas => ParseEntero(protDto.GasasIniciales) + ParseEntero(protDto.GasasAdicionales);
    private bool GasasExcedenStock => _stockGasas != null && TotalGasasUsadas > _stockGasas.Available;

    protected override async Task OnParametersSetAsync()
    {
        cargandoInicial = true;
        await Task.Yield();

        var cargarOrdenesPrimero = IdOrden <= 0 && Session.OrdenActiva is not > 0;
        var tareaProfesionales = KardexService.ObtenerProfesionalesQuirurgicosAsync();
        if (cargarOrdenesPrimero)
        {
            var tareaOrdenes = KardexService.ObtenerOrdenesActivasAsync();
            await Task.WhenAll(tareaProfesionales, tareaOrdenes);
            ordenesActivas = await tareaOrdenes;
        }

        profesionales = await tareaProfesionales;

        if (IdOrden <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
        {
            IdOrden = Session.OrdenActiva.Value;
            Nhcl = Session.NhclActivo ?? 0;
        }
        else if (IdOrden <= 0 && ordenesActivas.Count > 0)
        {
            IdOrden = ordenesActivas[0].IdOrdenAtencion;
            Nhcl = ordenesActivas[0].Nhcl;
        }

        if (IdOrden > 0)
        {
            ordenInput = IdOrden;
            await CargarDatosAsync(navegar: false);
        }
        cargandoInicial = false;

        if (!cargarOrdenesPrimero)
        {
            StateHasChanged();
            ordenesActivas = await KardexService.ObtenerOrdenesActivasAsync();
        }
    }

    private void CambiarTab(int tab)
    {
        tabActiva = tab;
        mensajeAlerta = string.Empty;
        esError = false;
    }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CargarPorInputAsync();
        }
    }

    private async Task OnOrdenSelectChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selOrden) && selOrden > 0)
        {
            mensajeAlerta = string.Empty;
            esError = false;
            var ord = ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == selOrden);
            IdOrden = selOrden;
            Nhcl = ord?.Nhcl ?? 0;
            ordenInput = IdOrden;
            nhclInput = Nhcl;
            await CargarDatosAsync();
        }
    }

    private async Task CargarPorInputAsync()
    {
        mensajeAlerta = string.Empty;
        esError = false;

        if (ordenInput > 0)
        {
            IdOrden = ordenInput;
            var match = ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == IdOrden);
            if (match != null)
            {
                Nhcl = match.Nhcl;
                nhclInput = Nhcl;
            }
        }
        else if (nhclInput > 0)
        {
            Nhcl = nhclInput;
            var match = ordenesActivas.FirstOrDefault(x => x.Nhcl == Nhcl);
            if (match != null)
            {
                IdOrden = match.IdOrdenAtencion;
                ordenInput = IdOrden;
            }
        }
        else if (ordenesActivas.Count > 0)
        {
            IdOrden = ordenesActivas[0].IdOrdenAtencion;
            Nhcl = ordenesActivas[0].Nhcl;
            ordenInput = IdOrden;
            nhclInput = Nhcl;
        }

        if (IdOrden <= 0 && Nhcl <= 0) return;
        await CargarDatosAsync();
    }

    private string DirectorioFisico => Path.Combine(Environment.WebRootPath, "archivosPacientes", Nhcl.ToString(), "ingreso");
    private string DirectorioRelativo => $"archivosPacientes/{Nhcl}/ingreso";

    private void CargarArchivosQuirurgicos()
    {
        archivosQuirurgicos.Clear();
        if (Nhcl <= 0) return;

        try
        {
            Directory.CreateDirectory(DirectorioFisico);
            var di = new DirectoryInfo(DirectorioFisico);
            archivosQuirurgicos = di.EnumerateFiles()
                .Select(f => new ArchivoQuirurgicoInfo(
                    f.Name,
                    $"/{DirectorioRelativo}/{Uri.EscapeDataString(f.Name)}",
                    f.LastWriteTime,
                    FormatearTamano(f.Length)))
                .OrderByDescending(x => x.Fecha)
                .ToList();
        }
        catch
        {
            // Directorio protegido o no disponible
        }
    }

    private static string FormatearTamano(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
        if (bytes >= 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{bytes} B";
    }

    private async Task SubirArchivoQuirurgicoAsync(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo == null) return;

        const long maxTamanoBytes = 15 * 1024 * 1024; // 15 MB
        if (archivo.Size > maxTamanoBytes)
        {
            esError = true;
            mensajeAlerta = $"El archivo '{archivo.Name}' supera el límite máximo permitido de 15 MB (tamaño actual: {FormatearTamano(archivo.Size)}).";
            return;
        }

        var extensiones = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            ".pdf", ".jpg", ".jpeg", ".png", ".docx", ".xlsx"
        };
        var ext = Path.GetExtension(archivo.Name);
        if (string.IsNullOrWhiteSpace(ext) || !extensiones.Contains(ext))
        {
            esError = true;
            mensajeAlerta = $"Tipo de archivo no permitido ('{ext}'). Solo se admiten archivos PDF, JPG, PNG, DOCX y XLSX.";
            return;
        }

        try
        {
            Directory.CreateDirectory(DirectorioFisico);
            var safeName = $"{DateTime.Now:yyyyMMddHHmmss}_{Path.GetFileNameWithoutExtension(archivo.Name)}{ext}";
            await using var entrada = archivo.OpenReadStream(maxTamanoBytes);
            await using var salida = File.Create(Path.Combine(DirectorioFisico, safeName));
            await entrada.CopyToAsync(salida);

            esError = false;
            mensajeAlerta = $"Archivo '{archivo.Name}' subido correctamente al expediente quirúrgico.";
            CargarArchivosQuirurgicos();
        }
        catch (Exception ex)
        {
            esError = true;
            mensajeAlerta = $"Error al subir el archivo: {ex.Message}";
        }
    }

    private void EliminarArchivoQuirurgico(string nombre)
    {
        try
        {
            var ruta = Path.Combine(DirectorioFisico, nombre);
            if (File.Exists(ruta))
            {
                File.Delete(ruta);
                esError = false;
                mensajeAlerta = $"Archivo '{nombre}' eliminado correctamente.";
                CargarArchivosQuirurgicos();
            }
        }
        catch (Exception ex)
        {
            esError = true;
            mensajeAlerta = $"No se pudo eliminar el archivo: {ex.Message}";
        }
    }

    private async Task CargarDatosAsync(bool navegar = true)
    {
        var p = await KardexService.ObtenerCabeceraPacienteAsync(IdOrden, Nhcl);
        if (p != null)
        {
            Nhcl = p.Nhcl;
            nhclInput = Nhcl;
            ordenInput = IdOrden;
            Session.SeleccionarOrden(IdOrden, Nhcl, p.PacienteNombre);
            _cirugiasOrden = await QuirofanoService.ObtenerResumenCirugiasOrdenAsync(IdOrden, Nhcl);
            if (IdCirugia > 0 && _cirugiasOrden.Any(c => c.IdCirugia == IdCirugia))
                _idCirugiaActiva = IdCirugia;
            else if (_idCirugiaActiva <= 0 || !_cirugiasOrden.Any(c => c.IdCirugia == _idCirugiaActiva))
                _idCirugiaActiva = _cirugiasOrden.FirstOrDefault()?.IdCirugia ?? 0;

            protDto = await QuirofanoService.ObtenerProtocoloQuirurgicoAsync(IdOrden, Nhcl, _idCirugiaActiva);
            var cirActiva = _cirugiasOrden.FirstOrDefault(c => c.IdCirugia == _idCirugiaActiva);
            if (cirActiva != null && string.IsNullOrWhiteSpace(protDto.Principal) && !string.IsNullOrWhiteSpace(cirActiva.Procedimiento))
                protDto.Principal = cirActiva.Procedimiento;
            CalcularDuracionCirugia();
            paciente = p;
            CargarArchivosQuirurgicos();
            var ruta = $"/quirofano/protocolo/{IdOrden}/{Nhcl}";
            if (navegar && Nav.Uri != Nav.ToAbsoluteUri(ruta).AbsoluteUri)
            {
                Nav.NavigateTo(ruta);
            }
        }
        else
        {
            paciente = null;
            esError = true;
            mensajeAlerta = $"No se encontró la Orden #{IdOrden}.";
        }
    }

    private async Task CambiarCirugiaActivaAsync(int nuevoIdCirugia)
    {
        _idCirugiaActiva = nuevoIdCirugia;
        IdCirugia = nuevoIdCirugia;
        mensajeAlerta = string.Empty;
        if (OnCirugiaCambiada.HasDelegate)
            await OnCirugiaCambiada.InvokeAsync(nuevoIdCirugia);
        await CargarDatosAsync(navegar: false);
    }

    private async Task GuardarProtocoloAsync()
    {
        if (paciente == null) return;

        CalcularDuracionCirugia();
        if (errorHorarioCirugia)
        {
            esError = true;
            mensajeAlerta = "La hora de finalización no puede ser anterior a la hora de inicio de la cirugía.";
            return;
        }
        if (GasasExcedenStock && _stockGasas != null)
        {
            esError = true;
            mensajeAlerta = $"El total de gasas ({TotalGasasUsadas}) supera el stock disponible ({_stockGasas.Available:0.##} {_stockGasas.BaseUnitOfMeasureCode}).";
            return;
        }

        guardando = true;
        protDto.IdOrden = IdOrden;
        protDto.IdCirugia = _idCirugiaActiva;
        protDto.Nhcl = Nhcl;

        var result = await QuirofanoService.GuardarProtocoloQuirurgicoAsync(
            protDto,
            Session.CurrentUser?.IdUsuario ?? 1,
            Session.CurrentUser?.NombreCompleto ?? "Cirujano");

        guardando = false;
        esError = !result.Ok;
        mensajeAlerta = result.Ok
            ? "Protocolo Operatorio y Chequeo Quirúrgico guardados exitosamente."
            : $"Error al guardar el Protocolo Quirúrgico: {result.Mensaje}";
        if (result.Ok)
            _cirugiasOrden = await QuirofanoService.ObtenerResumenCirugiasOrdenAsync(IdOrden, Nhcl);
    }

    private void CambiarTipoMiembro(bool esExterno)
    {
        nuevoMiembro.EsExterno = esExterno;
        nuevoMiembro.IdUsuario = 0;
    }

    private async Task AgregarMiembroAsync()
    {
        if (nuevoMiembro.IdUsuario <= 0)
        {
            esError = true;
            mensajeAlerta = "Seleccione un profesional registrado para integrarlo al equipo quirúrgico.";
            return;
        }

        nuevoMiembro.IdOrden = IdOrden;
        nuevoMiembro.Principal = nuevoMiembro.RolFuncion == "Cirujano Principal";

        var ok = await QuirofanoService.AgregarMiembroEquipoAsync(nuevoMiembro);
        if (ok)
        {
            protDto = await QuirofanoService.ObtenerProtocoloQuirurgicoAsync(IdOrden, Nhcl);
            bool mantExterno = nuevoMiembro.EsExterno;
            nuevoMiembro = new() { RolFuncion = "Cirujano Principal", EsExterno = mantExterno };
            esError = false;
            mensajeAlerta = "Integrante añadido al equipo quirúrgico.";
        }
        else
        {
            esError = true;
            mensajeAlerta = "No se pudo añadir el integrante. Verifique que el profesional siga activo y que corresponda al tipo seleccionado.";
        }
    }

    private void OnHoraInicioChanged(ChangeEventArgs e)
    {
        protDto.HoraInicio = e.Value?.ToString() ?? string.Empty;
        CalcularDuracionCirugia();
    }

    private void OnHoraFinChanged(ChangeEventArgs e)
    {
        protDto.HoraFin = e.Value?.ToString() ?? string.Empty;
        CalcularDuracionCirugia();
    }

    private void CalcularDuracionCirugia()
    {
        errorHorarioCirugia = false;
        duracionCirugiaTexto = string.Empty;
        protDto.DuracionMinutos = 0;

        if (string.IsNullOrWhiteSpace(protDto.HoraInicio) || string.IsNullOrWhiteSpace(protDto.HoraFin))
        {
            return;
        }

        if (TimeSpan.TryParse(protDto.HoraInicio, out var tIni) && TimeSpan.TryParse(protDto.HoraFin, out var tFin))
        {
            if (tFin < tIni)
            {
                errorHorarioCirugia = true;
                duracionCirugiaTexto = "Inválido (Fin anterior a Inicio)";
                return;
            }

            var diff = tFin - tIni;
            int totalMin = (int)diff.TotalMinutes;
            int horas = diff.Hours;
            int mins = diff.Minutes;

            protDto.DuracionMinutos = totalMin;
            duracionCirugiaTexto = $"{horas}h {mins}m";
        }
    }

    private async Task EliminarMiembroAsync(int sec)
    {
        await QuirofanoService.EliminarMiembroEquipoAsync(sec);
        protDto = await QuirofanoService.ObtenerProtocoloQuirurgicoAsync(IdOrden, Nhcl);
    }

    private async Task AsegurarCatalogoStockAsync(bool forzar = false)
    {
        var sede = Session.Localidad > 0 ? Session.Localidad : 1;
        if (!forzar && _catalogoStock.Count > 0 && _localidadStockCargada == sede) return;
        try
        {
            var lista = await InventarioService.BuscarMedicamentosConStockAsync(string.Empty, sede, Session.Apostrofe);
            _catalogoStock = lista.Where(x => x.Available > 0).OrderBy(x => x.DisplayName).ToList();
            _localidadStockCargada = sede;
        }
        catch { }
    }

    private List<FarmacoStockDto> FiltrarStock(string? texto)
    {
        var t = (texto ?? string.Empty).Trim();
        IEnumerable<FarmacoStockDto> q = _catalogoStock;
        if (!string.IsNullOrWhiteSpace(t))
            q = q.Where(x =>
                x.DisplayName.Contains(t, StringComparison.OrdinalIgnoreCase) ||
                x.Number.Contains(t, StringComparison.OrdinalIgnoreCase));
        return q.Take(12).ToList();
    }

    private async Task AbrirSugerenciasStockAsync(int tipo)
    {
        await AsegurarCatalogoStockAsync();
        _sugStockTipo = tipo;
    }

    private async Task CerrarSugerenciasStockAsync()
    {
        await Task.Delay(160);
        _sugStockTipo = 0;
    }

    private void SeleccionarStockAntisepsia(FarmacoStockDto prod)
    {
        _stockAntisepsia = prod;
        protDto.Lavado = prod.DisplayName;
        _cantAntisepsia = Math.Min(1m, prod.Available);
        _descargadoAntisepsia = false;
        _sugStockTipo = 0;
    }

    private void SeleccionarStockGasas(FarmacoStockDto prod)
    {
        _stockGasas = prod;
        _filtroGasasStock = prod.DisplayName;
        _descargadoGasas = false;
        _sugStockTipo = 0;
        var maxDisp = (int)Math.Floor(prod.Available);
        var ini = ParseEntero(protDto.GasasIniciales);
        var adi = ParseEntero(protDto.GasasAdicionales);
        if (ini + adi > maxDisp)
        {
            protDto.GasasIniciales = Math.Min(ini, maxDisp).ToString();
            protDto.GasasAdicionales = Math.Max(0, Math.Min(adi, maxDisp - ParseEntero(protDto.GasasIniciales))).ToString();
        }
    }

    private void SeleccionarStockCompresas(FarmacoStockDto prod)
    {
        _stockCompresas = prod;
        _filtroCompresasStock = prod.DisplayName;
        _cantCompresas = Math.Min(1m, prod.Available);
        _descargadoCompresas = false;
        _sugStockTipo = 0;
    }

    private void OnCantAntisepsiaChanged(ChangeEventArgs e)
    {
        var val = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : 0m;
        if (val < 0m) val = 0m;
        if (_stockAntisepsia != null && val > _stockAntisepsia.Available) val = _stockAntisepsia.Available;
        _cantAntisepsia = val;
    }

    private void OnCantCompresasChanged(ChangeEventArgs e)
    {
        var val = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : 0m;
        if (val < 0m) val = 0m;
        if (_stockCompresas != null && val > _stockCompresas.Available) val = _stockCompresas.Available;
        _cantCompresas = val;
    }

    private void OnGasasInicialesChanged(ChangeEventArgs e)
    {
        var val = int.TryParse(e.Value?.ToString(), out var n) && n >= 0 ? n : 0;
        if (_stockGasas != null)
        {
            var maxIni = Math.Max(0, (int)Math.Floor(_stockGasas.Available) - ParseEntero(protDto.GasasAdicionales));
            if (val > maxIni) val = maxIni;
        }
        protDto.GasasIniciales = val.ToString();
    }

    private void OnGasasAdicionalesChanged(ChangeEventArgs e)
    {
        var val = int.TryParse(e.Value?.ToString(), out var n) && n >= 0 ? n : 0;
        if (_stockGasas != null)
        {
            var maxAdi = Math.Max(0, (int)Math.Floor(_stockGasas.Available) - ParseEntero(protDto.GasasIniciales));
            if (val > maxAdi) val = maxAdi;
        }
        protDto.GasasAdicionales = val.ToString();
    }

    private async Task DescargarAntisepsiaAsync()
    {
        if (_stockAntisepsia == null) return;
        if (await DescargarBienProtocoloAsync(_stockAntisepsia, _cantAntisepsia, "Protocolo-Antisepsia", "Antisepsia / Lavado quirúrgico"))
            _descargadoAntisepsia = true;
    }

    private async Task DescargarGasasAsync()
    {
        if (_stockGasas == null) return;
        if (await DescargarBienProtocoloAsync(_stockGasas, TotalGasasUsadas, "Protocolo-Gasas", $"Gasas quirúrgicas (Ini:{protDto.GasasIniciales} Adic:{protDto.GasasAdicionales})"))
            _descargadoGasas = true;
    }

    private async Task DescargarCompresasAsync()
    {
        if (_stockCompresas == null) return;
        if (await DescargarBienProtocoloAsync(_stockCompresas, _cantCompresas, "Protocolo-Compresas", $"Compresas / Cotonoides ({protDto.Compresas})"))
            _descargadoCompresas = true;
    }

    private async Task<bool> DescargarBienProtocoloAsync(FarmacoStockDto item, decimal cantidad, string modulo, string indicaciones)
    {
        if (paciente == null || IdOrden <= 0 || Nhcl <= 0) return false;
        if (cantidad <= 0m)
        {
            esError = true;
            mensajeAlerta = "Ingrese una cantidad mayor a cero.";
            return false;
        }
        _descargandoStock = true;
        try
        {
            await AsegurarCatalogoStockAsync(forzar: true);
            var actual = _catalogoStock.FirstOrDefault(x => x.Id == item.Id || x.Number == item.Number);
            if (actual == null || actual.Available < cantidad)
            {
                esError = true;
                mensajeAlerta = $"Stock insuficiente para {item.DisplayName} (disponible: {actual?.Available ?? 0m:0.##} {item.BaseUnitOfMeasureCode}).";
                return false;
            }
            var sede = Session.Localidad > 0 ? Session.Localidad : 1;
            var idUsuario = Session.CurrentUser?.IdUsuario ?? 1;
            var prodQui = new ProductoQuirofanoDto
            {
                OrdenId = IdOrden,
                Nhcl = Nhcl,
                CodigoProd = item.Number,
                ProdDescripcion = item.DisplayName,
                PrecioProd = item.UnitPrice,
                StockProd = (int)Math.Ceiling(actual.Available),
                CantProd = cantidad,
                Via = "TOP",
                Hora = DateTime.Now.ToString("HH:mm"),
                IndicacionesProd = indicaciones,
                Modulo = modulo,
                MedBodega = actual.Location,
                MedMedida = actual.BaseUnitOfMeasureCode,
                Iniciales = Session.CurrentUser?.Iniciales ?? "QX",
                Funcion = "Quirófano",
                Funcionario = Session.CurrentUser?.NombreCompleto ?? "Quirófano"
            };
            var ok = await QuirofanoService.AgregarProductoQuirofanoAsync(prodQui, idUsuario, sede, "QUI");
            if (!ok)
            {
                esError = true;
                mensajeAlerta = $"No se pudo registrar {item.DisplayName} en quirófano.";
                return false;
            }
            await FarmaciaService.ReservarStockDirectoAsync(
                item.Id, item.Number, cantidad, sede, IdOrden, Nhcl, idUsuario, modulo, actual.Location);
            await AsegurarCatalogoStockAsync(forzar: true);
            esError = false;
            mensajeAlerta = $"{item.DisplayName} ({cantidad:0.##} {actual.BaseUnitOfMeasureCode}) descargado del inventario y registrado en Farmacia.";
            return true;
        }
        catch (Exception ex)
        {
            esError = true;
            mensajeAlerta = $"Error al descargar del inventario: {ex.Message}";
            return false;
        }
        finally { _descargandoStock = false; }
    }

    private async Task ExportarPdfAsync()
    {
        if (paciente == null) return;
        var bytes = ReportService.GenerarProtocoloQuirurgicoPdf(paciente, protDto);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"ProtocoloQuirurgico_Orden_{IdOrden}.pdf", "application/pdf", Convert.ToBase64String(bytes));
    }
