@page "/quirofano/protocolo"
@page "/quirofano/protocolo/{IdOrden:int}/{Nhcl:int}"
@inject IKardexService KardexService
@inject IQuirofanoService QuirofanoService
@inject IReportExportService ReportService
@inject NavigationManager Nav
@inject IWebHostEnvironment Environment
@inject SessionStateService Session
@inject IJSRuntime JS

<PageTitle>Protocolo Quirúrgico y Chequeo de Cirugía - e-ForVets</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="mb-0 fw-bold text-primary">Protocolo Operatorio, Equipo Quirúrgico y Chequeo de Cirugía</h4>
        <small class="text-muted">Descripción del acto operatorio, equipo quirúrgico interviniente y lista de chequeo de cirugía segura.</small>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center">
        <select class="form-select form-select-sm" style="min-width: 280px; max-width: 360px;" value="@IdOrden" @onchange="OnOrdenSelectChangedAsync">
            <option value="0">-- Seleccionar Orden Activa --</option>
            @foreach (var ord in ordenesActivas)
            {
                <option value="@ord.IdOrdenAtencion">#@ord.IdOrdenAtencion | NHCL:@ord.Nhcl - @ord.Paciente (@ord.Cliente)</option>
            }
        </select>

        <div class="input-group input-group-sm" style="width: auto;">
            <span class="input-group-text">Ord:</span>
            <input type="number" class="form-control" style="width: 95px; min-width: 85px;" @bind="ordenInput" @bind:event="oninput" @onkeydown="OnInputKeyDown" placeholder="Orden" />
            <span class="input-group-text">NHCL:</span>
            <input type="number" class="form-control" style="width: 95px; min-width: 85px;" @bind="nhclInput" @bind:event="oninput" @onkeydown="OnInputKeyDown" placeholder="NHCL" />
            <button class="btn btn-primary" @onclick="CargarPorInputAsync">Buscar</button>
        </div>

        @if (paciente != null)
        {
            <button class="btn btn-sm btn-success fw-semibold" @onclick="GuardarProtocoloAsync" disabled="@guardando">
                @(guardando ? "Guardando..." : "Guardar Protocolo")
            </button>
            <button class="btn btn-sm btn-danger" @onclick="ExportarPdfAsync">Exportar PDF</button>
            <a class="btn btn-sm btn-outline-warning" href="/quirofano/pausa-seguridad/@IdOrden/@Nhcl">Pausa Seguridad</a>
            <a class="btn btn-sm btn-outline-primary" href="/quirofano/recuperacion/@IdOrden/@Nhcl">Ir a Recuperación</a>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small" role="alert">
        @mensajeAlerta
        <button type="button" class="btn-close py-2" @onclick="() => mensajeAlerta = string.Empty"></button>
    </div>
}

@if (cargandoInicial)
{
    <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span class="fw-semibold small">Cargando protocolo quirúrgico y equipo operatorio...</span>
    </div>
}
else if (paciente != null)
{
    <!-- Cabecera Paciente -->
    <div class="card shadow-sm border-0 mb-3 bg-primary-subtle">
        <div class="card-body py-2 px-3">
            <div class="row g-2 align-items-center small">
                <div class="col-md-3">
                    <span class="text-muted">Orden / NHCL:</span>
                    <strong class="ms-1 text-primary">#@paciente.OrdenAtencionId / @paciente.Nhcl</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted">Paciente:</span>
                    <strong class="ms-1">@paciente.PacienteNombre</strong> (@paciente.Especie - @paciente.Raza)
                </div>
                <div class="col-md-3">
                    <span class="text-muted">Edad / Sexo:</span>
                    <strong class="ms-1">@paciente.EdadTexto / @paciente.Sexo</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted">Propietario:</span>
                    <strong class="ms-1">@paciente.PropietarioNombre</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Pestañas del Módulo Quirúrgico -->
    <ul class="nav nav-tabs mb-3 small fw-semibold">
        <li class="nav-item">
            <button class="nav-link @(tabActiva == 1 ? "active text-primary" : "text-secondary")" @onclick="() => CambiarTab(1)">
                1. Protocolo Operatorio y Chequeo Quirúrgico
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == 2 ? "active text-primary" : "text-secondary")" @onclick="() => CambiarTab(2)">
                2. Equipo Quirúrgico Interviniente (@protDto.Equipo.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == 3 ? "active text-primary" : "text-secondary")" @onclick="() => CambiarTab(3)">
                3. Archivos y Fotos de Cirugía (@archivosQuirurgicos.Count)
            </button>
        </li>
    </ul>

    @if (tabActiva == 1)
    {
        <div class="row g-3">
            <!-- Columna Izquierda: Descripción del Acto Quirúrgico (qvt_Protocolo) -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-header bg-white fw-bold text-primary">
                        1. Protocolo Operatorio
                    </div>
                <div class="card-body small">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label mb-1 fw-semibold">Fecha Cirugía</label>
                            <input type="date" class="form-control form-control-sm" @bind="protDto.Fecha" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-1 fw-semibold">Carácter de la Cirugía</label>
                            <select class="form-select form-select-sm" @bind="protDto.TipoCirugia">
                                <option value="Electiva">Electiva / Programada</option>
                                <option value="Emergencia">Emergencia / Urgencia</option>
                                <option value="Paliativa">Paliativa / Diagnóstica</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-1 fw-semibold">Sangrado Estimado (ml)</label>
                            <input type="number" class="form-control form-control-sm" @bind="protDto.Sangrado" />
                        </div>

                        <div class="col-12">
                            <label class="form-label mb-1 fw-semibold">Operación / Procedimiento Quirúrgico Realizado</label>
                            <input type="text" class="form-control form-control-sm" @bind="protDto.Principal" placeholder="Ej: Ovariohisterectomía / Laparotomía Exploratoria / Osteosíntesis..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label mb-1 fw-semibold">Diéresis / Incisión y Abordaje</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="protDto.Incision" placeholder="Tipo de incisión, plano anatómico abordado..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label mb-1 fw-semibold">Hallazgos Intraoperatorios</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="protDto.Hallazgos" placeholder="Descripción detallada de órganos y lesiones encontradas..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label mb-1 fw-semibold">Descripción de la Técnica / Procedimiento Quirúrgico</label>
                            <textarea class="form-control form-control-sm" rows="4" @bind="protDto.ProcedimientoQuir" placeholder="Detalle paso a paso del procedimiento ejecutado, ligaduras, implantes..."></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label mb-1 fw-semibold">Síntesis / Cierre por Planos</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="protDto.Sintesis" placeholder="Material de sutura y patrón empleado en fascia, subcutáneo y piel..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label mb-1 fw-semibold">Complicaciones Intraoperatorias</label>
                            <input type="text" class="form-control form-control-sm" @bind="protDto.Complicaciones" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label mb-1 fw-semibold">Envío Muestra Patología</label>
                            <select class="form-select form-select-sm" @bind="protDto.Muestra">
                                <option value="NO">NO</option>
                                <option value="SI">SÍ (Histopatología)</option>
                                <option value="CULTIVO">SÍ (Cultivo)</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label mb-1 fw-semibold">Uso de Drenajes</label>
                            <select class="form-select form-select-sm" @bind="protDto.Drenaje">
                                <option value="0">Sin Drenaje</option>
                                <option value="1">Penrose / Pasivo</option>
                                <option value="2">Activo / Cerrado</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

            <!-- Columna Derecha: Chequeo de Enfermería Quirúrgica y Conteo de Gasas (qvt_ingresocirugia) -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-header bg-white fw-bold text-primary">
                        2. Chequeo Quirúrgico y Conteo de Textiles
                    </div>
                    <div class="card-body small">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-semibold">Quirófano / Sala #</label>
                                <input type="number" class="form-control form-control-sm" @bind="protDto.Sala" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-semibold">Posición Quirúrgica</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.Posicion" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-semibold">Clasificación Herida</label>
                                <select class="form-select form-select-sm" @bind="protDto.CasoContaminado">
                                    <option value="Limpia">Limpia</option>
                                    <option value="Limpia-Contaminada">Limpia-Contaminada</option>
                                    <option value="Contaminada">Contaminada</option>
                                    <option value="Sucia / Infectada">Sucia / Infectada</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-semibold">Antisepsia / Lavado</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.Lavado" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-semibold">Unidad Electrocirugía</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.UnidadElectro" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-semibold">Placa Retorno</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.LocalizacionPlaca" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-bold text-primary">Gasas Iniciales</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.GasasIniciales" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-bold text-primary">Gasas Adicionales</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.GasasAdicionales" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-0 fw-bold text-success">Recuento Final</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.GasasRecuentoFinal" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label mb-0 fw-semibold">Conteo Compresas / Cotonoides</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.Compresas" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label mb-0 fw-semibold">Paciente Transferido A</label>
                                <input type="text" class="form-control form-control-sm" @bind="protDto.TransferidoA" />
                            </div>

                            <div class="col-12">
                                <label class="form-label mb-0 fw-semibold">Observaciones de Enfermería de Quirófano</label>
                                <textarea class="form-control form-control-sm" rows="3" @bind="protDto.ObservacionesEnfermeria"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (tabActiva == 2)
    {
        <!-- Pestaña 2: Equipo Quirúrgico (qvt_team / vt_quirTeam) -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center">
                <span>Equipo Quirúrgico Interviniente (@protDto.Equipo.Count)</span>
                <small class="text-muted">Asignación de cirujanos, anestesiólogo, instrumentistas y circulante</small>
            </div>
            <div class="card-body small">
                <div class="row g-2 mb-3 align-items-end bg-light p-2 rounded">
                    <div class="col-md-4">
                        <label class="form-label mb-1 fw-semibold">Profesional</label>
                        <select class="form-select form-select-sm" @bind="nuevoMiembro.IdUsuario">
                            <option value="0">-- Seleccionar Profesional --</option>
                            @foreach (var u in profesionales)
                            {
                                <option value="@u.UserNumero">@u.UserNombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label mb-1 fw-semibold">Rol en Quirófano</label>
                        <select class="form-select form-select-sm" @bind="nuevoMiembro.RolFuncion">
                            <option value="Cirujano Principal">Cirujano Principal</option>
                            <option value="Primer Ayudante">Primer Ayudante</option>
                            <option value="Segundo Ayudante">Segundo Ayudante</option>
                            <option value="Anestesiólogo">Anestesiólogo</option>
                            <option value="Instrumentista">Instrumentista</option>
                            <option value="Circulante">Circulante</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-sm btn-primary w-100 fw-semibold" @onclick="AgregarMiembroAsync">
                            + Añadir al Equipo Quirúrgico
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Profesional</th>
                                <th>Rol en Quirófano</th>
                                <th class="text-center" style="width: 120px;">Condición</th>
                                <th class="text-center" style="width: 80px;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!protDto.Equipo.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No hay integrantes registrados en el equipo de esta cirugía.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var m in protDto.Equipo)
                                {
                                    <tr>
                                        <td class="fw-semibold">@m.NombreProfesional</td>
                                        <td>@m.RolFuncion</td>
                                        <td class="text-center">
                                            @if (m.Principal)
                                            {
                                                <span class="badge bg-success">Principal</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Asistente</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-xs btn-outline-danger py-0 px-2"
                                                    title="Eliminar miembro"
                                                    @onclick="() => EliminarMiembroAsync(m.Sec)">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (tabActiva == 3)
    {
        <!-- Pestaña 3: Archivos Quirúrgicos del Paciente (vt_quirArchivos) -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center">
                <span>Archivos, Documentos y Evidencia Quirúrgica (@archivosQuirurgicos.Count)</span>
                <span class="badge bg-info-subtle text-info border">Ruta: archivosPacientes/@Nhcl/ingreso</span>
            </div>
            <div class="card-body small">
                <div class="row g-2 mb-3 bg-light p-2 rounded align-items-center">
                    <div class="col-md-7">
                        <label class="form-label mb-1 fw-semibold">Subir nuevo archivo / foto quirúrgica (PDF, JPG, PNG, DOCX, XLSX máx 15MB):</label>
                        <InputFile class="form-control form-control-sm" OnChange="SubirArchivoQuirurgicoAsync" />
                    </div>
                    <div class="col-md-5 text-muted pt-3">
                        <small>Los archivos subidos quedan asociados al expediente de ingreso quirúrgico del paciente.</small>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-hover table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre del Archivo</th>
                                <th style="width: 170px;">Fecha y Hora</th>
                                <th style="width: 110px;">Tamaño</th>
                                <th class="text-center" style="width: 140px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!archivosQuirurgicos.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No existen archivos quirúrgicos cargados para este paciente.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var arc in archivosQuirurgicos)
                                {
                                    <tr>
                                        <td>
                                            <a href="@arc.Url" target="_blank" class="fw-semibold text-decoration-none">
                                                📄 @arc.Nombre
                                            </a>
                                        </td>
                                        <td>@arc.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@arc.TamanoTexto</td>
                                        <td class="text-center">
                                            <a href="@arc.Url" download="@arc.Nombre" class="btn btn-xs btn-outline-primary py-0 px-2 me-1">Descargar</a>
                                            <button class="btn btn-xs btn-outline-danger py-0 px-2" @onclick="() => EliminarArchivoQuirurgico(arc.Nombre)">Eliminar</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }

    private int ordenInput;
    private int nhclInput;
    private List<OrdenActivaResumenDto> ordenesActivas = new();
    private int tabActiva = 1;
    private PacienteHeaderDto? paciente;
    private ProtocoloQuirurgicoCompletoDto protDto = new();
    private List<FuncionarioDto> profesionales = new();
    private MiembroEquipoQuirurgicoDto nuevoMiembro = new() { RolFuncion = "Cirujano Principal" };
    private List<ArchivoQuirurgicoInfo> archivosQuirurgicos = new();

    private sealed record ArchivoQuirurgicoInfo(string Nombre, string Url, DateTime Fecha, string TamanoTexto);

    private bool cargandoInicial = true;
    private bool guardando;
    private string mensajeAlerta = string.Empty;
    private bool esError;

    protected override async Task OnParametersSetAsync()
    {
        cargandoInicial = true;
        await Task.Yield();

        var tProf = KardexService.ObtenerFuncionariosEnfermeriaAsync();
        var tOrd = KardexService.ObtenerOrdenesActivasAsync();
        await Task.WhenAll(tProf, tOrd);

        profesionales = await tProf;
        ordenesActivas = await tOrd;

        if (IdOrden <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
        {
            IdOrden = Session.OrdenActiva.Value;
            Nhcl = Session.NhclActivo ?? 0;
        }
        else if (IdOrden <= 0 && ordenesActivas.Count > 0)
        {
            IdOrden = ordenesActivas[0].IdOrdenAtencion;
            Nhcl = ordenesActivas[0].Nhcl;
        }

        if (IdOrden > 0)
        {
            ordenInput = IdOrden;
            await CargarDatosAsync();
        }
        cargandoInicial = false;
    }

    private void CambiarTab(int tab)
    {
        tabActiva = tab;
        mensajeAlerta = string.Empty;
        esError = false;
    }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CargarPorInputAsync();
        }
    }

    private async Task OnOrdenSelectChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selOrden) && selOrden > 0)
        {
            mensajeAlerta = string.Empty;
            esError = false;
            var ord = ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == selOrden);
            IdOrden = selOrden;
            Nhcl = ord?.Nhcl ?? 0;
            ordenInput = IdOrden;
            nhclInput = Nhcl;
            await CargarDatosAsync();
        }
    }

    private async Task CargarPorInputAsync()
    {
        mensajeAlerta = string.Empty;
        esError = false;

        if (ordenInput > 0)
        {
            IdOrden = ordenInput;
            var match = ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == IdOrden);
            if (match != null)
            {
                Nhcl = match.Nhcl;
                nhclInput = Nhcl;
            }
        }
        else if (nhclInput > 0)
        {
            Nhcl = nhclInput;
            var match = ordenesActivas.FirstOrDefault(x => x.Nhcl == Nhcl);
            if (match != null)
            {
                IdOrden = match.IdOrdenAtencion;
                ordenInput = IdOrden;
            }
        }
        else if (ordenesActivas.Count > 0)
        {
            IdOrden = ordenesActivas[0].IdOrdenAtencion;
            Nhcl = ordenesActivas[0].Nhcl;
            ordenInput = IdOrden;
            nhclInput = Nhcl;
        }

        if (IdOrden <= 0 && Nhcl <= 0) return;
        await CargarDatosAsync();
    }

    private string DirectorioFisico => Path.Combine(Environment.WebRootPath, "archivosPacientes", Nhcl.ToString(), "ingreso");
    private string DirectorioRelativo => $"archivosPacientes/{Nhcl}/ingreso";

    private void CargarArchivosQuirurgicos()
    {
        archivosQuirurgicos.Clear();
        if (Nhcl <= 0) return;

        try
        {
            Directory.CreateDirectory(DirectorioFisico);
            var di = new DirectoryInfo(DirectorioFisico);
            archivosQuirurgicos = di.EnumerateFiles()
                .Select(f => new ArchivoQuirurgicoInfo(
                    f.Name,
                    $"/{DirectorioRelativo}/{Uri.EscapeDataString(f.Name)}",
                    f.LastWriteTime,
                    FormatearTamano(f.Length)))
                .OrderByDescending(x => x.Fecha)
                .ToList();
        }
        catch
        {
            // Directorio protegido o no disponible
        }
    }

    private static string FormatearTamano(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
        if (bytes >= 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{bytes} B";
    }

    private async Task SubirArchivoQuirurgicoAsync(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo == null) return;

        if (archivo.Size > 15 * 1024 * 1024)
        {
            esError = true;
            mensajeAlerta = "El archivo supera el límite permitido de 15 MB.";
            return;
        }

        var extensiones = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            ".pdf", ".png", ".jpg", ".jpeg", ".bmp", ".xlsx", ".docx", ".doc"
        };
        var ext = Path.GetExtension(archivo.Name);
        if (!extensiones.Contains(ext))
        {
            esError = true;
            mensajeAlerta = "Tipo de archivo no permitido. Use imágenes (JPG, PNG), PDF o documentos Office.";
            return;
        }

        try
        {
            Directory.CreateDirectory(DirectorioFisico);
            var safeName = $"{DateTime.Now:yyyyMMddHHmmss}_{Path.GetFileNameWithoutExtension(archivo.Name)}{ext}";
            await using var entrada = archivo.OpenReadStream(15 * 1024 * 1024);
            await using var salida = File.Create(Path.Combine(DirectorioFisico, safeName));
            await entrada.CopyToAsync(salida);

            esError = false;
            mensajeAlerta = $"Archivo '{archivo.Name}' subido correctamente al expediente quirúrgico.";
            CargarArchivosQuirurgicos();
        }
        catch (Exception ex)
        {
            esError = true;
            mensajeAlerta = $"Error al subir el archivo: {ex.Message}";
        }
    }

    private void EliminarArchivoQuirurgico(string nombre)
    {
        try
        {
            var ruta = Path.Combine(DirectorioFisico, nombre);
            if (File.Exists(ruta))
            {
                File.Delete(ruta);
                esError = false;
                mensajeAlerta = $"Archivo '{nombre}' eliminado correctamente.";
                CargarArchivosQuirurgicos();
            }
        }
        catch (Exception ex)
        {
            esError = true;
            mensajeAlerta = $"No se pudo eliminar el archivo: {ex.Message}";
        }
    }

    private async Task CargarDatosAsync()
    {
        var p = await KardexService.ObtenerCabeceraPacienteAsync(IdOrden, Nhcl);
        if (p != null)
        {
            Nhcl = p.Nhcl;
            nhclInput = Nhcl;
            ordenInput = IdOrden;
            Session.SeleccionarOrden(IdOrden, Nhcl, p.PacienteNombre);
            protDto = await QuirofanoService.ObtenerProtocoloQuirurgicoAsync(IdOrden, Nhcl);
            paciente = p;
            CargarArchivosQuirurgicos();
            Nav.NavigateTo($"/quirofano/protocolo/{IdOrden}/{Nhcl}", false);
        }
        else
        {
            paciente = null;
            esError = true;
            mensajeAlerta = $"No se encontró la Orden #{IdOrden}.";
        }
    }

    private async Task GuardarProtocoloAsync()
    {
        if (paciente == null) return;
        guardando = true;
        protDto.IdOrden = IdOrden;
        protDto.Nhcl = Nhcl;

        var result = await QuirofanoService.GuardarProtocoloQuirurgicoAsync(
            protDto,
            Session.CurrentUser?.IdUsuario ?? 1,
            Session.CurrentUser?.NombreCompleto ?? "Cirujano");

        guardando = false;
        esError = !result.Ok;
        mensajeAlerta = result.Ok
            ? "Protocolo Operatorio y Chequeo Quirúrgico guardados exitosamente."
            : $"Error al guardar el Protocolo Quirúrgico: {result.Mensaje}";
    }

    private async Task AgregarMiembroAsync()
    {
        if (nuevoMiembro.IdUsuario <= 0)
        {
            esError = true;
            mensajeAlerta = "Seleccione el profesional para integrarlo al equipo quirúrgico.";
            return;
        }

        nuevoMiembro.IdOrden = IdOrden;
        nuevoMiembro.Principal = nuevoMiembro.RolFuncion == "Cirujano Principal";

        var ok = await QuirofanoService.AgregarMiembroEquipoAsync(nuevoMiembro);
        if (ok)
        {
            protDto = await QuirofanoService.ObtenerProtocoloQuirurgicoAsync(IdOrden, Nhcl);
            esError = false;
            mensajeAlerta = "Integrante añadido al equipo quirúrgico.";
        }
    }

    private async Task EliminarMiembroAsync(int sec)
    {
        await QuirofanoService.EliminarMiembroEquipoAsync(sec);
        protDto = await QuirofanoService.ObtenerProtocoloQuirurgicoAsync(IdOrden, Nhcl);
    }

    private async Task ExportarPdfAsync()
    {
        if (paciente == null) return;
        var bytes = ReportService.GenerarProtocoloQuirurgicoPdf(paciente, protDto);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"ProtocoloQuirurgico_Orden_{IdOrden}.pdf", "application/pdf", Convert.ToBase64String(bytes));
    }
}
