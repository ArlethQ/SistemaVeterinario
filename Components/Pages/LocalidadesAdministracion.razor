@page "/administracion/localidades"
@using HosvetKardex.Web.Components.Layout
@inject SessionStateService Session
@inject IAdministracionClinicaService AdminService
@inject NavigationManager Nav
<PageTitle>Localidades | e-ForVets</PageTitle>

@if (_autorizado)
{
<div class="catalog-page"><SecurityNav /><header><div><span>Administración</span><h1>Localidades y especialidades</h1><p>Administra sedes y los servicios disponibles en cada una.</p></div><button @onclick="Nuevo">+ Nuevo</button></header>
@if (!string.IsNullOrWhiteSpace(_mensaje)) { <div class="message @(_error ? "error" : "success")">@_mensaje</div> }
<div class="btn-group mb-3"><button class="btn @(_tab == "localidades" ? "btn-primary" : "btn-outline-primary")" @onclick='() => CambiarTab("localidades")'>Localidades</button><button class="btn @(_tab == "asignaciones" ? "btn-primary" : "btn-outline-primary")" @onclick='() => CambiarTab("asignaciones")'>Especialidades por localidad</button></div>
@if (_tab == "localidades")
{<div class="catalog-layout"><section><h2>Localidades</h2>@foreach (var x in _localidades) { <button class="catalog-row @(x.Id == _localidad.Id ? "active" : "")" @onclick="() => Editar(x)"><span><strong>@x.Localidad</strong><small>@x.Ciudad, @x.Provincia · @(x.Estado == "A" ? "Activa" : "Inactiva")</small></span><i>Editar</i></button> }</section><aside><h2>@(_localidad.Id > 0 ? "Editar localidad" : "Nueva localidad")</h2><div class="form-grid"><label>Nombre<input @bind="_localidad.Localidad" /></label><label>Empresa<input @bind="_localidad.Empresa" /></label><label>RUC<input @bind="_localidad.Ruc" /></label><label>Teléfono<input @bind="_localidad.Telefono" /></label><label>Administrador<input @bind="_localidad.Administrador" /></label><label>Provincia<select @bind="_localidad.IdProvincia" @bind:after="CargarCiudades"><option value="0">Seleccione</option>@foreach (var x in _provincias) { <option value="@x.Id">@x.Descripcion</option> }</select></label><label>Ciudad<select @bind="_localidad.IdCiudad"><option value="0">Seleccione</option>@foreach (var x in _ciudades) { <option value="@x.Id">@x.Descripcion</option> }</select></label><label>Prefijo<input maxlength="2" @bind="_localidad.Prefijo" /></label></div><label>Dirección<input @bind="_localidad.Direccion" /></label><label class="check"><input type="checkbox" checked="@(_localidad.Estado == "A")" @onchange="CambiarEstadoLocalidad" /> Activa</label><button class="save" @onclick="GuardarLocalidad">Guardar</button></aside></div>}
else
{<div class="catalog-layout"><section><h2>Asignaciones</h2>@foreach (var x in _asignaciones) { <button class="catalog-row @(x.Id == _asignacion.Id ? "active" : "")" @onclick="() => Editar(x)"><span><strong>@x.Especialidad</strong><small>@x.Localidad · @(x.Estado == "A" ? "Activa" : "Inactiva")</small></span><i>Editar</i></button> }</section><aside><h2>@(_asignacion.Id > 0 ? "Editar asignación" : "Nueva asignación")</h2><label>Especialidad<select @bind="_asignacion.IdEspecialidad"><option value="0">Seleccione</option>@foreach (var x in _especialidades.Where(x => x.Estado == "A")) { <option value="@x.Id">@x.Descripcion</option> }</select></label><label>Localidad<select @bind="_asignacion.IdLocalidad"><option value="0">Seleccione</option>@foreach (var x in _localidades.Where(x => x.Estado == "A")) { <option value="@x.Id">@x.Localidad</option> }</select></label><label class="check"><input type="checkbox" checked="@(_asignacion.Estado == "A")" @onchange="CambiarEstadoAsignacion" /> Activa</label><button class="save" @onclick="GuardarAsignacion">Guardar</button></aside></div>}</div>
}

@code {
private bool _autorizado,_error; private string _tab="localidades",_mensaje="";
private List<LocalidadAdministrativaDto> _localidades=[]; private List<EspecialidadLocalidadDto> _asignaciones=[]; private List<CatalogoItemGenericoDto> _provincias=[],_ciudades=[]; private List<CatalogoAdministrativoDto> _especialidades=[];
private LocalidadAdministrativaDto _localidad=new(); private EspecialidadLocalidadDto _asignacion=new();
protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated||Session.TipoUser!=1){Nav.NavigateTo("/dashboard");return;}_autorizado=true;await Cargar();}
private async Task Cargar(){var a=AdminService.ObtenerLocalidadesAsync();var b=AdminService.ObtenerEspecialidadesLocalidadAsync();var c=AdminService.ObtenerProvinciasAsync();var d=AdminService.ObtenerCatalogoAsync("especialidades");await Task.WhenAll(a,b,c,d);_localidades=a.Result;_asignaciones=b.Result;_provincias=c.Result;_especialidades=d.Result;}
private void CambiarTab(string tab){_tab=tab;Nuevo();} private void Nuevo(){_localidad=new(){Estado="A"};_asignacion=new(){Estado="A"};_ciudades=[];_mensaje="";}
private async Task Editar(LocalidadAdministrativaDto x){_localidad=new(){Id=x.Id,Localidad=x.Localidad,Direccion=x.Direccion,Telefono=x.Telefono,Ruc=x.Ruc,Administrador=x.Administrador,Estado=x.Estado,Empresa=x.Empresa,Prefijo=x.Prefijo,Region=x.Region,IdCiudad=x.IdCiudad,IdProvincia=x.IdProvincia};await CargarCiudades();}
private void Editar(EspecialidadLocalidadDto x)=>_asignacion=new(){Id=x.Id,IdEspecialidad=x.IdEspecialidad,IdLocalidad=x.IdLocalidad,Estado=x.Estado};
private async Task CargarCiudades()=>_ciudades=_localidad.IdProvincia>0?await AdminService.ObtenerCiudadesAsync(_localidad.IdProvincia):[];
private void CambiarEstadoLocalidad(ChangeEventArgs e)=>_localidad.Estado=e.Value is true?"A":"I"; private void CambiarEstadoAsignacion(ChangeEventArgs e)=>_asignacion.Estado=e.Value is true?"A":"I";
private async Task GuardarLocalidad(){var r=await AdminService.GuardarLocalidadAsync(_localidad,Session.IdUser);_error=!r.Exito;_mensaje=r.Mensaje;if(r.Exito){Nuevo();await Cargar();}}
private async Task GuardarAsignacion(){var r=await AdminService.GuardarEspecialidadLocalidadAsync(_asignacion,Session.IdUser);_error=!r.Exito;_mensaje=r.Mensaje;if(r.Exito){Nuevo();await Cargar();}}
}
