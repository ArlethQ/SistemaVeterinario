@page "/administracion/empresas"
@using HosvetKardex.Web.Components.Layout
@using Microsoft.EntityFrameworkCore
@using Simetric.Data
@using Simetric.DTOs.EContax
@using Simetric.Services.EContax
@inject SessionStateService Session
@inject NavigationManager Nav
@inject EContaxOrganizacionService OrganizacionService
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Empresas | e-ForVets</PageTitle>

@if (_autorizado)
{
    <div class="container-fluid py-3">
        <SecurityNav />
        <div class="d-flex justify-content-between align-items-end my-3">
            <div><small class="text-primary fw-bold">ADMINISTRACIÓN GLOBAL</small><h1 class="h2 mb-1">Empresas</h1><p class="text-muted mb-0">Cada empresa mantiene separados sus datos veterinarios, contables y de facturación.</p></div>
            <button class="btn btn-primary" @onclick="Nueva">+ Nueva empresa</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_mensaje)) { <div class="alert @(_error ? "alert-danger" : "alert-success")">@_mensaje</div> }
        @if (_cargando) { <div class="card card-body">Cargando empresas...</div> }
        else
        {
            <div class="card table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Empresa</th><th>RUC</th><th>Estado</th></tr></thead><tbody>
                @foreach (var empresa in _empresas) { <tr><td><strong>@empresa.Nombre</strong><small class="d-block text-muted">ID @empresa.IdEmpresa</small></td><td>@(empresa.Ruc ?? "Sin registrar")</td><td><span class="badge @(empresa.Estado ? "text-bg-success" : "text-bg-secondary")">@(empresa.Estado ? "Activa" : "Inactiva")</span></td></tr> }
            </tbody></table></div>
        }
    </div>

    @if (_mostrarEditor)
    {
        <div class="modal fade show d-block" style="background:rgba(0,0,0,.5)" tabindex="-1" @onclick="Cerrar">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation><div class="modal-content"><div class="modal-header"><div><small class="text-primary fw-bold">NUEVO TENANT</small><h2 class="h5 mb-0">Crear empresa</h2></div><button class="btn-close" @onclick="Cerrar"></button></div>
                <div class="modal-body"><div class="mb-3"><label class="form-label">Nombre de la empresa *</label><input class="form-control" @bind="_modelo.Nombre" /></div><div class="mb-3"><label class="form-label">RUC</label><input class="form-control" maxlength="13" @bind="_modelo.Ruc" /></div><div class="mb-3"><label class="form-label">Usuario titular *</label><select class="form-select" @bind="_modelo.IdTitular"><option value="0">Seleccione</option>@foreach (var usuario in _titularesDisponibles) { <option value="@usuario.Id">@usuario.Nombre (@usuario.Email)</option> }</select><div class="form-text">Se creará automáticamente la sucursal Matriz y el titular recibirá control total de la empresa.</div></div></div>
                <div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="Cerrar">Cancelar</button><button class="btn btn-primary" disabled="@_guardando" @onclick="Guardar">@(_guardando ? "Creando..." : "Crear empresa")</button></div>
            </div></div>
        </div>
    }
}

@code {
    private bool _autorizado, _cargando = true, _guardando, _mostrarEditor, _error;
    private string _mensaje = string.Empty;
    private EContaxEmpresaCreateDto _modelo = new();
    private List<EContaxEmpresaDto> _empresas = [];
    private List<TitularItem> _titularesDisponibles = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || Session.TipoUser != 1) { Nav.NavigateTo("/dashboard"); return; }
        _autorizado = true;
        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        _empresas = await OrganizacionService.GetEmpresasAsync(true);
        await using var db = await DbFactory.CreateDbContextAsync();
        _titularesDisponibles = await db.Usuarios.AsNoTracking()
            .Where(u => u.Estado == true && !db.EContaxUsuariosContexto.Any(c => c.IdUsuario == u.IdUsuario && c.Estado))
            .OrderBy(u => u.Nombres).ThenBy(u => u.Apellidos)
            .Select(u => new TitularItem(u.IdUsuario, (u.Nombres + " " + u.Apellidos).Trim(), u.Email ?? string.Empty))
            .ToListAsync();
        _cargando = false;
    }

    private void Nueva() { _modelo = new(); _mensaje = string.Empty; _mostrarEditor = true; }
    private void Cerrar() => _mostrarEditor = false;
    private async Task Guardar()
    {
        try { _guardando = true; var id = await OrganizacionService.CrearEmpresaAsync(_modelo); _mensaje = $"Empresa creada correctamente con ID {id}."; _error = false; _mostrarEditor = false; await Cargar(); }
        catch (Exception ex) { _mensaje = ex.Message; _error = true; }
        finally { _guardando = false; }
    }

    private sealed record TitularItem(int Id, string Nombre, string Email);
}
