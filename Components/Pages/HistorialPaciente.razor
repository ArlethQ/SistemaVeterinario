@page "/consulta/historial/{Nhcl:int}"
@page "/consulta/curvacrecimiento/{Nhcl:int}"
@page "/consulta/historial/{Nhcl:int}/{TabInicial}"
@inject SessionStateService Session
@inject IAdministracionClinicaService AdminService
@inject IConsultaExternaService ConsultaService
@inject IWebHostEnvironment Environment
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Historial y Curva de Crecimiento | e-ForVets</PageTitle>

@if (_autorizado)
{
<div class="container-fluid py-3">
    <!-- CABECERA DEL PACIENTE -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <small class="text-primary fw-bold text-uppercase">Historia Longitudinal y Biometría</small>
            <h2 class="mb-0 fw-bold">
                @if (_pacienteInfo is not null)
                {
                    <span>@_pacienteInfo.Nombre</span>
                    <span class="fs-5 text-muted fw-normal ms-2">(NHCL: #@Nhcl)</span>
                }
                else
                {
                    <span>Paciente NHCL #@Nhcl</span>
                }
            </h2>
            @if (_pacienteInfo is not null)
            {
                <div class="d-flex flex-wrap gap-2 text-muted small mt-1">
                    <span><strong>Especie:</strong> @_pacienteInfo.Especie</span>
                    <span>•</span>
                    <span><strong>Raza:</strong> @_pacienteInfo.Raza</span>
                    <span>•</span>
                    <span><strong>Sexo:</strong> @_pacienteInfo.Sexo</span>
                    <span>•</span>
                    <span><strong>Propietario:</strong> @_pacienteInfo.Cliente</span>
                    @if (_pacienteInfo.FechaNacimiento.HasValue)
                    {
                        <span>•</span>
                        <span><strong>Nacimiento:</strong> @_pacienteInfo.FechaNacimiento.Value.ToString("yyyy-MM-dd")</span>
                    }
                </div>
            }
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm @(_tab == "apuntes" ? "active" : "")" @onclick='() => _tab = "apuntes"'>
                <i class="bi bi-journal-text me-1"></i>Apuntes (@_apuntes.Count)
            </button>
            @if (_tab == "crecimiento")
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="ImprimirGraficoAsync">
                    <i class="bi bi-printer me-1"></i>Imprimir Curva
                </button>
            }
            <a class="btn btn-outline-danger btn-sm" href="/consulta/imprimir-fichas/@Nhcl">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>Dossier Seguros / Fichas
            </a>
            <a class="btn btn-outline-primary btn-sm" href="/admision/clientes-pacientes">
                <i class="bi bi-arrow-left me-1"></i>Volver a Pacientes
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2">@_error</div>
    }

    <!-- PESTAÑAS -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_tab=="resumen"?"active fw-bold":"")" @onclick='()=>_tab="resumen"'>
                Resumen Clínico
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_tab=="crecimiento"?"active fw-bold text-primary":"")" @onclick='()=>_tab="crecimiento"'>
                📈 Curva de Crecimiento y Constantes (@_mediciones.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_tab=="apuntes"?"active fw-bold text-success":"")" @onclick='()=>_tab="apuntes"'>
                📝 Apuntes (@_apuntes.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_tab=="archivos"?"active fw-bold":"")" @onclick='()=>_tab="archivos"'>
                Archivos Adjuntos (@_archivos.Count)
            </button>
        </li>
    </ul>

    @if (_cargando)
    {
        <div class="d-flex align-items-center gap-2 text-muted py-4">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            <span>Cargando historial y registros biométricos del paciente...</span>
        </div>
    }
    else if (_tab == "resumen")
    {
        <!-- BARRA DE FILTROS POR FECHA Y BÚSQUEDA -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2 col-6">
                        <label class="form-label small fw-semibold text-muted mb-1">
                            <i class="bi bi-calendar3 me-1"></i>Fecha Desde:
                        </label>
                        <input type="date" class="form-control form-control-sm" @bind="_filtroDesde" />
                    </div>
                    <div class="col-md-2 col-6">
                        <label class="form-label small fw-semibold text-muted mb-1">
                            <i class="bi bi-calendar3 me-1"></i>Fecha Hasta:
                        </label>
                        <input type="date" class="form-control form-control-sm" @bind="_filtroHasta" />
                    </div>
                    <div class="col-md-3 col-12">
                        <label class="form-label small fw-semibold text-muted mb-1">
                            <i class="bi bi-search me-1"></i>Buscar en historial:
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" placeholder="Buscar medicamento, diagnóstico..." @bind="_filtroTexto" @bind:event="oninput" />
                            @if (!string.IsNullOrWhiteSpace(_filtroTexto))
                            {
                                <button class="btn btn-outline-secondary" type="button" @onclick='() => _filtroTexto = ""'>
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-md-3 col-12">
                        <label class="form-label small fw-semibold text-muted mb-1">Filtros rápidos:</label>
                        <div class="btn-group btn-group-sm w-100" role="group">
                            <button type="button" class="btn btn-outline-secondary py-1 @(!_filtroDesde.HasValue && !_filtroHasta.HasValue ? "active fw-semibold" : "")" @onclick='() => FiltrarRangoRapido("todos")'>
                                Todos
                            </button>
                            <button type="button" class="btn btn-outline-secondary py-1" @onclick='() => FiltrarRangoRapido("ano")'>
                                Este año
                            </button>
                            <button type="button" class="btn btn-outline-secondary py-1" @onclick='() => FiltrarRangoRapido("6meses")'>
                                6 meses
                            </button>
                            <button type="button" class="btn btn-outline-secondary py-1" @onclick='() => FiltrarRangoRapido("mes")'>
                                Este mes
                            </button>
                        </div>
                    </div>
                    <div class="col-md-2 col-12 text-md-end">
                        <label class="form-label small fw-semibold text-muted mb-1 d-none d-md-block">Vista:</label>
                        <div class="btn-group btn-group-sm w-100" role="group">
                            <button type="button" class="btn @(_modoVistaResumen == "categorias" ? "btn-primary" : "btn-outline-primary") py-1" @onclick='() => _modoVistaResumen = "categorias"' title="Vista agrupada por tarjetas de categorías">
                                <i class="bi bi-grid-fill me-1"></i>Categorías
                            </button>
                            <button type="button" class="btn @(_modoVistaResumen == "cronologico" ? "btn-primary" : "btn-outline-primary") py-1" @onclick='() => _modoVistaResumen = "cronologico"' title="Vista cronológica día por día">
                                <i class="bi bi-clock-history me-1"></i>Cronológico
                            </button>
                        </div>
                    </div>
                </div>

                @if (_filtroDesde.HasValue || _filtroHasta.HasValue || !string.IsNullOrWhiteSpace(_filtroTexto))
                {
                    <div class="mt-2 pt-2 border-top d-flex flex-wrap justify-content-between align-items-center small text-muted">
                        <span>
                            <i class="bi bi-funnel-fill text-primary me-1"></i>
                            Filtro aplicado:
                            @if (_filtroDesde.HasValue && _filtroHasta.HasValue)
                            {
                                <span class="badge bg-primary-subtle text-primary border me-1">@_filtroDesde.Value.ToString("yyyy-MM-dd") al @_filtroHasta.Value.ToString("yyyy-MM-dd")</span>
                            }
                            else if (_filtroDesde.HasValue)
                            {
                                <span class="badge bg-primary-subtle text-primary border me-1">Desde @_filtroDesde.Value.ToString("yyyy-MM-dd")</span>
                            }
                            else if (_filtroHasta.HasValue)
                            {
                                <span class="badge bg-primary-subtle text-primary border me-1">Hasta @_filtroHasta.Value.ToString("yyyy-MM-dd")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(_filtroTexto))
                            {
                                <span class="badge bg-secondary-subtle text-secondary border me-1">Texto: "@_filtroTexto"</span>
                            }
                            — <strong>@HistorialFiltrado.Count()</strong> registros en este período
                        </span>
                        <button class="btn btn-link btn-sm text-decoration-none p-0 text-danger" @onclick='() => FiltrarRangoRapido("todos")'>
                            <i class="bi bi-x-circle me-1"></i>Restablecer filtros
                        </button>
                    </div>
                }
            </div>
        </div>

        @if (_modoVistaResumen == "categorias")
        {
            <div class="row g-3">
                @foreach (var grupo in CategoriasDisponibles)
                {
                    var itemsGrupo = HistorialFiltrado.Where(x => x.Categoria == grupo).ToList();
                    var itemsAgrupados = itemsGrupo
                        .GroupBy(x => new { x.Codigo, x.Descripcion })
                        .Select(g => new {
                            Codigo = g.Key.Codigo,
                            Descripcion = g.Key.Descripcion,
                            NumeroVeces = g.Count(),
                            UltimaFecha = g.Max(x => x.Fecha),
                            Fechas = g.Select(x => x.Fecha).OrderByDescending(f => f).Distinct().ToList(),
                            Ordenes = g.Select(x => x.IdOrden).Where(o => o > 0).Distinct().ToList()
                        })
                        .OrderByDescending(x => x.UltimaFecha)
                        .ThenByDescending(x => x.NumeroVeces)
                        .ToList();

                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                                <span>
                                    @ObtenerIconoCategoria(grupo) @grupo
                                </span>
                                <span class="badge bg-light text-muted border">
                                    @itemsGrupo.Count registros
                                </span>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Descripción</th>
                                            <th style="width: 140px;">Fecha</th>
                                            <th style="width: 80px;" class="text-end">Veces</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!itemsAgrupados.Any())
                                        {
                                            <tr>
                                                <td colspan="3" class="text-center text-muted py-3 small">
                                                    No se registran @grupo.ToLower() en el rango de fechas seleccionado.
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var x in itemsAgrupados)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(x.Codigo))
                                                        {
                                                            <code class="me-1 text-danger">@x.Codigo</code>
                                                        }
                                                        <span class="fw-semibold text-dark">@x.Descripcion</span>
                                                        @if (x.Ordenes.Any())
                                                        {
                                                            <span class="text-muted d-block small" style="font-size: 0.75rem;">
                                                                Ord: @string.Join(", ", x.Ordenes.Select(o => $"#{o}"))
                                                            </span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-light text-dark border">
                                                            <i class="bi bi-calendar-event me-1 text-primary"></i>@x.UltimaFecha.ToString("yyyy-MM-dd")
                                                        </span>
                                                        @if (x.Fechas.Count > 1)
                                                        {
                                                            <span class="badge bg-info-subtle text-info border ms-1" title="@string.Join(", ", x.Fechas.Select(f => f.ToString("yyyy-MM-dd")))">
                                                                +@(x.Fechas.Count - 1)
                                                            </span>
                                                        }
                                                    </td>
                                                    <td class="text-end fw-bold text-primary">@x.NumeroVeces</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- VISTA CRONOLÓGICA DÍA POR DÍA -->
            @if (!HistorialFiltrado.Any())
            {
                <div class="alert alert-light border text-center py-4 my-2">
                    <i class="bi bi-calendar-x fs-3 text-muted d-block mb-1"></i>
                    <h6 class="text-muted fw-semibold">No se encontraron atenciones ni procedimientos en este período.</h6>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var fechaGrupo in HistorialFiltrado.GroupBy(x => x.Fecha.Date).OrderByDescending(g => g.Key))
                    {
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-2">
                                <span class="fw-bold text-dark">
                                    <i class="bi bi-calendar2-check-fill text-primary me-2"></i>@fechaGrupo.Key.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES")).ToUpperInvariant()
                                </span>
                                <span class="badge bg-light text-dark border">
                                    @fechaGrupo.Count() @(fechaGrupo.Count() == 1 ? "registro realizado" : "registros realizados") este día
                                </span>
                            </div>
                            <div class="card-body p-2">
                                <div class="row g-2">
                                    @foreach (var subGrupo in fechaGrupo.GroupBy(x => x.Categoria))
                                    {
                                        <div class="col-md-6">
                                            <div class="p-2 border rounded bg-light h-100">
                                                <div class="d-flex align-items-center gap-1 mb-2 pb-1 border-bottom">
                                                    <span class="badge @ObtenerBadgeColorCategoria(subGrupo.Key)">
                                                        @ObtenerIconoCategoria(subGrupo.Key) @subGrupo.Key
                                                    </span>
                                                    <small class="text-muted ms-auto">@subGrupo.Count() @(subGrupo.Count() == 1 ? "ítem" : "ítems")</small>
                                                </div>
                                                <ul class="list-unstyled mb-0 small">
                                                    @foreach (var item in subGrupo)
                                                    {
                                                        <li class="py-1 border-bottom border-light-subtle d-flex justify-content-between align-items-center">
                                                            <div>
                                                                @if (!string.IsNullOrWhiteSpace(item.Codigo))
                                                                {
                                                                    <code class="me-1">@item.Codigo</code>
                                                                }
                                                                <span>@item.Descripcion</span>
                                                            </div>
                                                            @if (item.IdOrden > 0)
                                                            {
                                                                <span class="badge bg-white text-muted border ms-2">Ord #@item.IdOrden</span>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
    else if (_tab == "crecimiento")
    {
        <!-- PESTAÑA: CURVA DE CRECIMIENTO VISUAL E INTERACTIVA (MIGRACIÓN curvaCrecimiento.aspx) -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body pb-2">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">@TituloMetricaActual</h5>
                        <small class="text-muted">Evolución longitudinal registrada en atenciones y fichas médicas.</small>
                    </div>

                    <!-- SELECTOR DE CONSTANTE (PESO, FC, FR) -->
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn @(_metricaActiva == "peso" ? "btn-primary" : "btn-outline-primary")" @onclick='() => CambiarMetrica("peso")'>
                            ⚖️ Peso (kg) — Crecimiento
                        </button>
                        <button type="button" class="btn @(_metricaActiva == "fc" ? "btn-danger" : "btn-outline-danger")" @onclick='() => CambiarMetrica("fc")'>
                            ❤️ Frecuencia Cardíaca (lpm)
                        </button>
                        <button type="button" class="btn @(_metricaActiva == "fr" ? "btn-success" : "btn-outline-success")" @onclick='() => CambiarMetrica("fr")'>
                            🫁 Frecuencia Respiratoria (rpm)
                        </button>
                    </div>
                </div>

                @{
                    var puntos = ObtenerPuntosValidos();
                }

                @if (puntos.Count == 0)
                {
                    <div class="alert alert-light border text-center py-4 my-2">
                        <div class="fs-4 text-muted mb-1">📉</div>
                        <h6 class="text-muted fw-semibold">Sin datos suficientes para esta métrica</h6>
                        <small class="text-muted">No se registran mediciones numéricas mayores a cero en las fichas médicas de este paciente.</small>
                    </div>
                }
                else
                {
                    <!-- TARJETAS DE RESUMEN KPI -->
                    var primerPunto = puntos.First();
                    var ultimoPunto = puntos.Last();
                    var dif = ultimoPunto.Valor - primerPunto.Valor;
                    var maxPunto = puntos.MaxBy(p => p.Valor)!;
                    var minPunto = puntos.MinBy(p => p.Valor)!;

                    <div class="row g-2 mb-3">
                        <div class="col-6 col-md-3">
                            <div class="p-2 border rounded bg-light">
                                <small class="text-muted d-block">Último valor (@ultimoPunto.Fecha.ToString("dd/MM/yyyy"))</small>
                                <strong class="fs-5 text-dark">@ultimoPunto.Valor.ToString("N2") @UnidadMetricaActual</strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-2 border rounded bg-light">
                                <small class="text-muted d-block">Primer registro (@primerPunto.Fecha.ToString("dd/MM/yyyy"))</small>
                                <strong class="fs-5 text-dark">@primerPunto.Valor.ToString("N2") @UnidadMetricaActual</strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-2 border rounded bg-light">
                                <small class="text-muted d-block">Variación total</small>
                                <strong class="fs-5 @(dif >= 0 ? "text-success" : "text-danger")">
                                    @(dif >= 0 ? "+" : "")@dif.ToString("N2") @UnidadMetricaActual
                                    @if (primerPunto.Valor > 0)
                                    {
                                        <small class="fs-6 text-muted">(@((dif / primerPunto.Valor * 100).ToString("N1"))%)</small>
                                    }
                                </strong>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-2 border rounded bg-light">
                                <small class="text-muted d-block">Rango registrado</small>
                                <span class="fs-6 fw-bold text-secondary">
                                    Min: @minPunto.Valor.ToString("N2") — Max: @maxPunto.Valor.ToString("N2")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- GRÁFICO SVG NATIVO E INTERACTIVO -->
                    <div class="border rounded p-2 bg-white position-relative mb-2">
                        @{
                            const double svgW = 900;
                            const double svgH = 340;
                            const double padL = 70;
                            const double padR = 40;
                            const double padT = 30;
                            const double padB = 45;
                            const double plotW = svgW - padL - padR;
                            const double plotH = svgH - padT - padB;

                            decimal vMin = minPunto.Valor;
                            decimal vMax = maxPunto.Valor;
                            if (vMin == vMax)
                            {
                                vMin = vMin > 0 ? vMin * 0.8m : 0m;
                                vMax = vMax > 0 ? vMax * 1.2m : 10m;
                            }
                            else
                            {
                                var margin = (vMax - vMin) * 0.1m;
                                vMin = Math.Max(0m, vMin - margin);
                                vMax = vMax + margin;
                            }
                            decimal vRange = vMax - vMin <= 0 ? 1m : vMax - vMin;

                            // Coordenadas calculadas
                            var coords = new List<(double X, double Y, PuntoGrafico P)>();
                            for (int i = 0; i < puntos.Count; i++)
                            {
                                var p = puntos[i];
                                double cx = puntos.Count == 1 ? padL + (plotW / 2.0) : padL + (i * plotW / (puntos.Count - 1));
                                double norm = (double)((p.Valor - vMin) / vRange);
                                double cy = padT + plotH - (norm * plotH);
                                coords.Add((cx, cy, p));
                            }

                            // Construcción de trazado de línea y área sombreada
                            var pathLine = new System.Text.StringBuilder();
                            for (int i = 0; i < coords.Count; i++)
                            {
                                if (i == 0) pathLine.Append(System.Globalization.CultureInfo.InvariantCulture, $"M {coords[i].X:F1} {coords[i].Y:F1}");
                                else pathLine.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {coords[i].X:F1} {coords[i].Y:F1}");
                            }

                            var pathArea = new System.Text.StringBuilder(pathLine.ToString());
                            if (coords.Count > 0)
                            {
                                double groundY = padT + plotH;
                                pathArea.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {coords.Last().X:F1} {groundY:F1} L {coords.First().X:F1} {groundY:F1} Z");
                            }

                            string strokeColor = _metricaActiva switch
                            {
                                "fc" => "#dc2626",
                                "fr" => "#059669",
                                _ => "#2563eb"
                            };
                            string gradId = $"grad_{_metricaActiva}";
                        }

                        <svg viewBox="0 0 @svgW @svgH" class="w-100" style="max-height: 380px; display: block;" preserveAspectRatio="xMidYMid meet">
                            <defs>
                                <linearGradient id="@gradId" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="@strokeColor" stop-opacity="0.35" />
                                    <stop offset="100%" stop-color="@strokeColor" stop-opacity="0.02" />
                                </linearGradient>
                            </defs>

                            <!-- LÍNEAS DE GUÍA HORIZONTALES (EJE Y) -->
                            @for (int step = 0; step <= 4; step++)
                            {
                                double yPos = padT + (step * plotH / 4.0);
                                decimal refVal = vMax - (step * (vRange / 4m));
                                <line x1="@padL" y1="@yPos" x2="@(svgW - padR)" y2="@yPos" stroke="#e2e8f0" stroke-dasharray="4 4" stroke-width="1" />
                                @((MarkupString)$"<text x='{padL - 10}' y='{yPos + 4:F1}' text-anchor='end' fill='#64748b' font-size='11' font-family='sans-serif'>{refVal:N1}</text>")
                            }

                            <!-- ÁREA BAJO LA CURVA -->
                            @if (coords.Count > 1)
                            {
                                <path d="@pathArea.ToString()" fill="url(#@gradId)" />
                                <path d="@pathLine.ToString()" fill="none" stroke="@strokeColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                            }
                            else if (coords.Count == 1)
                            {
                                <line x1="@padL" y1="@coords[0].Y" x2="@(svgW - padR)" y2="@coords[0].Y" stroke="@strokeColor" stroke-width="2" stroke-dasharray="2 2" />
                            }

                            <!-- PUNTOS INTERACTIVOS (CIRCULOS) -->
                            @foreach (var pt in coords)
                            {
                                bool isSelected = _puntoSeleccionado == pt.P;
                                <g style="cursor: pointer;" @onclick="() => _puntoSeleccionado = pt.P">
                                    @if (isSelected)
                                    {
                                        <circle cx="@pt.X" cy="@pt.Y" r="11" fill="@strokeColor" fill-opacity="0.25" />
                                        <circle cx="@pt.X" cy="@pt.Y" r="7" fill="@strokeColor" />
                                    }
                                    else
                                    {
                                        <circle cx="@pt.X" cy="@pt.Y" r="5" fill="#ffffff" stroke="@strokeColor" stroke-width="2.5" />
                                    }
                                </g>

                                <!-- ETIQUETAS EJE X (FECHA Y EDAD) -->
                                @if (coords.Count <= 8 || pt.P == primerPunto || pt.P == ultimoPunto || isSelected)
                                {
                                    @((MarkupString)$"<text x='{pt.X:F1}' y='{svgH - padB + 16:F1}' text-anchor='middle' fill='#475569' font-size='10' font-weight='{(isSelected ? "bold" : "normal")}'>{pt.P.Fecha:dd/MM/yy}</text>")
                                    @((MarkupString)$"<text x='{pt.X:F1}' y='{svgH - padB + 28:F1}' text-anchor='middle' fill='#94a3b8' font-size='9'>{pt.P.EdadMeses}m</text>")
                                }
                            }
                        </svg>

                        <!-- TOOLTIP / DETALLE DE PUNTO SELECCIONADO -->
                        @if (_puntoSeleccionado is not null)
                        {
                            <div class="alert alert-primary py-2 px-3 mb-0 mt-2 d-flex justify-content-between align-items-center small">
                                <div>
                                    <strong>Punto seleccionado:</strong>
                                    <span class="ms-1">Fecha: @_puntoSeleccionado.Fecha.ToString("yyyy-MM-dd")</span>
                                    <span class="ms-2">| Edad: @(_puntoSeleccionado.EdadMeses / 12)a @(_puntoSeleccionado.EdadMeses % 12)m</span>
                                    <span class="ms-2 text-primary fw-bold">| @TituloMetricaActual: @_puntoSeleccionado.Valor.ToString("N2") @UnidadMetricaActual</span>
                                </div>
                                <button class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="() => _puntoSeleccionado = null">
                                    Cerrar detalle
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- TABLA COMPLETA HISTÓRICA (CONSERVA LOS DATOS ORIGINALES) -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <div>
                    <strong>Tabla Histórica de Fichas Médicas</strong>
                    <small class="d-block text-muted">Historial secuencial de pesajes y constantes vitales por orden médica.</small>
                </div>
                <span class="badge bg-secondary">@_mediciones.Count registros</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Edad del Paciente</th>
                            <th class="@(_metricaActiva == "peso" ? "table-primary fw-bold" : "")">Peso (kg)</th>
                            <th class="@(_metricaActiva == "fc" ? "table-danger fw-bold" : "")">FC (lpm)</th>
                            <th class="@(_metricaActiva == "fr" ? "table-success fw-bold" : "")">FR (rpm)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in _mediciones.OrderByDescending(m => m.Fecha))
                        {
                            bool rowSelected = _puntoSeleccionado?.Fecha == x.Fecha;
                            <tr class="@(rowSelected ? "table-active border-primary" : "")" style="cursor: pointer;" @onclick='() => SeleccionarPuntoPorFecha(x.Fecha)'>
                                <td>@x.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(x.EdadMeses / 12) año(s) @(x.EdadMeses % 12) mes(es)</td>
                                <td class="@(_metricaActiva == "peso" ? "fw-bold text-primary" : "")">
                                    @(x.Peso.HasValue ? x.Peso.Value.ToString("N2") : "-")
                                </td>
                                <td class="@(_metricaActiva == "fc" ? "fw-bold text-danger" : "")">
                                    @(x.FrecuenciaCardiaca.HasValue ? x.FrecuenciaCardiaca.Value.ToString("N0") : "-")
                                </td>
                                <td class="@(_metricaActiva == "fr" ? "fw-bold text-success" : "")">
                                    @(x.FrecuenciaRespiratoria.HasValue ? x.FrecuenciaRespiratoria.Value.ToString("N0") : "-")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (_tab == "apuntes")
    {
        <!-- PESTAÑA: APUNTES A HISTORIAS CLÍNICAS -->
        @if (!string.IsNullOrWhiteSpace(_mensajeApunte))
        {
            <div class="alert @(_esErrorApunte ? "alert-danger" : "alert-success") alert-dismissible py-2 mb-3" role="alert">
                @_mensajeApunte
                <button type="button" class="btn-close py-2" @onclick="() => _mensajeApunte = string.Empty"></button>
            </div>
        }

        <div class="row g-3">
            <!-- Formulario de nuevo apunte -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary">
                        <i class="bi bi-pencil-square me-1"></i>Nuevo Apunte Clínico
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Fecha del Apunte *</label>
                            <input type="date" class="form-control form-control-sm" @bind="_nuevoApunte.Fecha" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Observación Clínica *</label>
                            <textarea class="form-control form-control-sm" rows="11" maxlength="10000"
                                      placeholder="Escriba el apunte u observación médica que debe permanecer registrada en la historia del paciente..."
                                      @bind="_nuevoApunte.Observacion" @bind:event="oninput"></textarea>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">Se registrará en el expediente longitudinal del paciente.</small>
                                <small class="text-muted">@_nuevoApunte.Observacion.Length / 10000</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white text-end">
                        <button class="btn btn-sm btn-success fw-semibold" disabled="@_guardandoApunte" @onclick="GuardarApunteAsync">
                            <i class="bi bi-floppy-fill me-1"></i>@(_guardandoApunte ? "Guardando..." : "Guardar Apunte")
                        </button>
                    </div>
                </div>
            </div>

            <!-- Listado de apuntes anteriores -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">
                            <i class="bi bi-clock-history me-1"></i>Apuntes Registrados (@_apuntes.Count)
                        </span>
                        <span class="badge bg-primary-subtle text-primary border">Expediente Clínico</span>
                    </div>
                    <div class="card-body" style="max-height: 540px; overflow-y: auto;">
                        @if (_apuntes.Count == 0)
                        {
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-journal-x display-6 d-block mb-2 opacity-50"></i>
                                No existen apuntes registrados para este paciente todavía.
                            </div>
                        }
                        else
                        {
                            @foreach (var apunte in _apuntes.OrderByDescending(x => x.Fecha).ThenByDescending(x => x.Id))
                            {
                                <article class="border rounded p-3 mb-3 bg-light shadow-sm">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 pb-1 border-bottom">
                                        <div>
                                            <strong class="text-primary"><i class="bi bi-calendar-event me-1"></i>@apunte.Fecha.ToString("yyyy-MM-dd")</strong>
                                            <span class="text-muted ms-2"><i class="bi bi-person me-1"></i>@apunte.RegistradoPor</span>
                                            <span class="badge bg-white text-dark border ms-2">@apunte.Tipo</span>
                                        </div>
                                        @if (_idApunteAAnular == apunte.Id)
                                        {
                                            <div class="d-flex gap-1 align-items-center">
                                                <small class="text-danger fw-semibold me-1">¿Anular?</small>
                                                <button class="btn btn-xs btn-danger py-0 px-2" disabled="@_anulandoApunte" @onclick="() => AnularApunteAsync(apunte.Id)">Sí, anular</button>
                                                <button class="btn btn-xs btn-outline-secondary py-0 px-2" @onclick="() => _idApunteAAnular = 0">Cancelar</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="btn btn-xs btn-outline-danger py-0 px-2" @onclick="() => _idApunteAAnular = apunte.Id" title="Anular este apunte">
                                                <i class="bi bi-trash3 me-1"></i>Anular
                                            </button>
                                        }
                                    </div>
                                    <div class="text-dark" style="white-space: pre-wrap; word-break: break-word; font-size: 0.93rem;">@apunte.Observacion</div>
                                </article>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-paperclip me-1"></i>Archivos, Fotos y Documentos Adjuntos (@_archivos.Count)
                </span>
                <span class="badge bg-light text-muted border">
                    Ruta: archivosPacientes/@Nhcl/ingreso
                </span>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(_mensaje))
                {
                    <div class="alert alert-success alert-dismissible py-2 mb-3" role="alert">
                        <i class="bi bi-check-circle-fill me-1"></i>@_mensaje
                        <button type="button" class="btn-close py-2" @onclick="() => _mensaje = string.Empty"></button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger alert-dismissible py-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@_error
                        <button type="button" class="btn-close py-2" @onclick="() => _error = string.Empty"></button>
                    </div>
                }

                <!-- Formulario de Subida con Texto Opcional -->
                <div class="bg-light p-3 rounded mb-3 border">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-dark mb-1">
                                <i class="bi bi-file-earmark-arrow-up me-1 text-primary"></i>Seleccionar archivo o foto:
                            </label>
                            <InputFile OnChange="OnArchivoSeleccionado" class="form-control form-control-sm" accept=".pdf,.png,.jpg,.jpeg,.webp,.xlsx,.docx" />
                            <small class="text-muted d-block mt-1">Fotos (JPG, PNG, WEBP), PDF, DOCX o XLSX (máx 15MB).</small>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-dark mb-1">
                                <i class="bi bi-chat-left-text me-1 text-primary"></i>Texto o comentario opcional del archivo:
                            </label>
                            <input type="text" class="form-control form-control-sm" placeholder="Ej: Foto de la lesión, ecografía abdominal, informe..." @bind="_nuevoArchivoComentario" />
                            <small class="text-muted d-block mt-1">Descripción para identificar rápidamente el contenido del archivo.</small>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-sm btn-primary w-100 fw-semibold" disabled="@(_archivoSeleccionado == null || _subiendoArchivo)" @onclick="SubirArchivoAsync">
                                <i class="bi bi-cloud-arrow-up-fill me-1"></i>@(_subiendoArchivo ? "Subiendo..." : "Subir Archivo")
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Tabla de Archivos y Fotos con opción de Quitar / Comentar -->
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle small mb-0">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th style="width: 60px;" class="text-center">Tipo</th>
                                <th>Nombre y Comentario del Archivo</th>
                                <th style="width: 160px;">Fecha y Hora</th>
                                <th style="width: 100px;">Tamaño</th>
                                <th style="width: 220px;" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!_archivos.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-5">
                                        <i class="bi bi-folder2-open display-6 d-block mb-2 text-secondary opacity-50"></i>
                                        No hay fotos ni archivos adjuntos para este paciente aún.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var arc in _archivos)
                                {
                                    bool esFoto = arc.Nombre.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
                                               || arc.Nombre.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase)
                                               || arc.Nombre.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)
                                               || arc.Nombre.EndsWith(".webp", StringComparison.OrdinalIgnoreCase);
                                    bool esPdf = arc.Nombre.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                    bool esDoc = arc.Nombre.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) || arc.Nombre.EndsWith(".doc", StringComparison.OrdinalIgnoreCase);

                                    <tr>
                                        <td class="text-center">
                                            @if (esFoto)
                                            {
                                                <a href="@arc.Url" target="_blank" title="Haga clic para ver la foto en tamaño completo">
                                                    <img src="@arc.Url" alt="@arc.Nombre" class="rounded border shadow-sm" style="width: 42px; height: 42px; object-fit: cover;" />
                                                </a>
                                            }
                                            else if (esPdf)
                                            {
                                                <i class="bi bi-file-earmark-pdf-fill text-danger fs-3"></i>
                                            }
                                            else if (esDoc)
                                            {
                                                <i class="bi bi-file-earmark-word-fill text-primary fs-3"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-file-earmark-text text-secondary fs-3"></i>
                                            }
                                        </td>
                                        <td>
                                            <a href="@arc.Url" target="_blank" class="fw-bold text-decoration-none text-dark d-block">
                                                @arc.Nombre
                                            </a>
                                            @if (!string.IsNullOrWhiteSpace(arc.Comentario))
                                            {
                                                <div class="mt-1 p-1 px-2 bg-light rounded border-start border-3 border-primary text-secondary" style="font-size: 0.85rem;">
                                                    <i class="bi bi-chat-left-dots text-primary me-1"></i>@arc.Comentario
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <i class="bi bi-calendar-event me-1 text-muted"></i>@arc.Fecha.ToString("yyyy-MM-dd HH:mm")
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-muted border">@FormatearTamano(arc.TamanoBytes)</span>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a href="@arc.Url" target="_blank" class="btn btn-xs btn-outline-primary py-1 px-2" title="Abrir / Ver">
                                                    <i class="bi bi-eye-fill me-1"></i>Ver
                                                </a>
                                                <a href="@arc.Url" download="@arc.Nombre" class="btn btn-xs btn-outline-secondary py-1 px-2" title="Descargar">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                                <button class="btn btn-xs btn-outline-info py-1 px-2 text-dark" @onclick="() => AbrirEditarComentario(arc)" title="Editar texto o comentario">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-xs btn-outline-danger py-1 px-2" @onclick="() => ConfirmarEliminarArchivo(arc.Nombre)" title="Quitar / Eliminar archivo">
                                                    <i class="bi bi-trash3-fill me-1"></i>Quitar
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Confirmar Eliminación de Archivo -->
@if (_mostrarModalEliminarArchivo)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-danger text-white py-2">
                    <h5 class="modal-title fs-6 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación de Archivo
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelarEliminarArchivo"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="mb-2">¿Está seguro de que desea quitar este archivo del expediente del paciente?</p>
                    <div class="alert alert-warning py-2 mb-2 small">
                        <strong><i class="bi bi-file-earmark-x me-1"></i>@_archivoAEliminar</strong>
                    </div>
                    <small class="text-muted d-block">Esta acción eliminará el archivo del servidor de forma permanente.</small>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CancelarEliminarArchivo">Cancelar</button>
                    <button type="button" class="btn btn-sm btn-danger fw-semibold" @onclick="EliminarArchivoConfirmado">
                        <i class="bi bi-trash3-fill me-1"></i>Sí, Quitar Archivo
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Editar Comentario de Archivo -->
@if (_mostrarModalEditarComentario)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-primary text-white py-2">
                    <h5 class="modal-title fs-6 fw-bold">
                        <i class="bi bi-chat-left-text-fill me-2"></i>Texto / Comentario del Archivo
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _mostrarModalEditarComentario = false"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-2 small text-muted">
                        Archivo: <strong>@_archivoAEditarComentario</strong>
                    </div>
                    <label class="form-label small fw-semibold">Comentario u observación:</label>
                    <textarea class="form-control form-control-sm" rows="3" placeholder="Escriba un comentario o descripción para este archivo..." @bind="_comentarioEditando"></textarea>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _mostrarModalEditarComentario = false">Cancelar</button>
                    <button type="button" class="btn btn-sm btn-primary fw-semibold" @onclick="GuardarComentarioEditado">
                        <i class="bi bi-check-circle-fill me-1"></i>Guardar Comentario
                    </button>
                </div>
            </div>
        </div>
    </div>
}
}

@code {
    [Parameter] public int Nhcl { get; set; }
    [Parameter] public string? TabInicial { get; set; }

    private bool _autorizado, _cargando = true;
    private string _tab = "resumen", _error = "", _mensaje = "";
    private string _metricaActiva = "peso"; // "peso", "fc", "fr"
    private PuntoGrafico? _puntoSeleccionado;

    private PacienteResumenCrecimientoDto? _pacienteInfo;
    private List<HistorialPacienteItemDto> _historial = [];

    // Filtros de fecha y búsqueda para Resumen Clínico
    private DateTime? _filtroDesde;
    private DateTime? _filtroHasta;
    private string _filtroTexto = string.Empty;
    private string _modoVistaResumen = "categorias"; // "categorias" o "cronologico"

    private static readonly string[] CategoriasDisponibles = new[]
    {
        "Diagnósticos", "Medicamentos", "Insumos", "Fisioterapia", "Imagenología", "Procedimientos", "Laboratorio"
    };

    private IEnumerable<HistorialPacienteItemDto> HistorialFiltrado
    {
        get
        {
            var q = _historial.AsEnumerable();
            if (_filtroDesde.HasValue)
            {
                q = q.Where(x => x.Fecha.Date >= _filtroDesde.Value.Date);
            }
            if (_filtroHasta.HasValue)
            {
                q = q.Where(x => x.Fecha.Date <= _filtroHasta.Value.Date);
            }
            if (!string.IsNullOrWhiteSpace(_filtroTexto))
            {
                var term = _filtroTexto.Trim();
                q = q.Where(x => x.Descripcion.Contains(term, StringComparison.OrdinalIgnoreCase)
                              || (!string.IsNullOrEmpty(x.Codigo) && x.Codigo.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }
            return q;
        }
    }

    private void FiltrarRangoRapido(string opcion)
    {
        var hoy = DateTime.Today;
        switch (opcion)
        {
            case "mes":
                _filtroDesde = new DateTime(hoy.Year, hoy.Month, 1);
                _filtroHasta = hoy;
                break;
            case "ano":
                _filtroDesde = new DateTime(hoy.Year, 1, 1);
                _filtroHasta = hoy;
                break;
            case "6meses":
                _filtroDesde = hoy.AddMonths(-6);
                _filtroHasta = hoy;
                break;
            default: // "todos"
                _filtroDesde = null;
                _filtroHasta = null;
                _filtroTexto = string.Empty;
                break;
        }
    }

    private static string ObtenerIconoCategoria(string cat) => cat switch
    {
        "Diagnósticos" => "🩺",
        "Medicamentos" => "💊",
        "Insumos" => "📦",
        "Fisioterapia" => "🩹",
        "Imagenología" => "🩻",
        "Procedimientos" => "🔬",
        "Laboratorio" => "🧪",
        _ => "📋"
    };

    private static string ObtenerBadgeColorCategoria(string cat) => cat switch
    {
        "Diagnósticos" => "bg-danger",
        "Medicamentos" => "bg-primary",
        "Insumos" => "bg-info text-dark",
        "Fisioterapia" => "bg-success",
        "Imagenología" => "bg-warning text-dark",
        "Procedimientos" => "bg-dark",
        "Laboratorio" => "bg-secondary",
        _ => "bg-secondary"
    };
    private List<MedicionCrecimientoDto> _mediciones = [];
    private List<ArchivoPaciente> _archivos = [];
    private List<ApunteHistoriaClinicaDto> _apuntes = [];
    private ApunteHistoriaClinicaDto _nuevoApunte = new() { Fecha = DateTime.Today };
    private bool _guardandoApunte;
    private bool _anulandoApunte;
    private int _idApunteAAnular;
    private string _mensajeApunte = string.Empty;
    private bool _esErrorApunte;

    public sealed record ArchivoPaciente(string Nombre, string Url, DateTime Fecha, long TamanoBytes, string? Comentario);
    public sealed record PuntoGrafico(int Indice, DateTime Fecha, int EdadMeses, decimal Valor);

    private string TituloMetricaActual => _metricaActiva switch
    {
        "fc" => "Frecuencia Cardíaca (lpm)",
        "fr" => "Frecuencia Respiratoria (rpm)",
        _ => "Curva de Crecimiento — Evolución de Peso (kg)"
    };

    private string UnidadMetricaActual => _metricaActiva switch
    {
        "fc" => "lpm",
        "fr" => "rpm",
        _ => "kg"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }
        _autorizado = true;

        if (!string.IsNullOrWhiteSpace(TabInicial) && TabInicial.Equals("crecimiento", StringComparison.OrdinalIgnoreCase))
        {
            _tab = "crecimiento";
        }
        else if (Nav.Uri.Contains("curvacrecimiento", StringComparison.OrdinalIgnoreCase))
        {
            _tab = "crecimiento";
        }

        try
        {
            var h = AdminService.ObtenerResumenHistorialAsync(Nhcl);
            var c = AdminService.ObtenerCurvaCrecimientoAsync(Nhcl);
            var p = AdminService.ObtenerInfoPacienteCrecimientoAsync(Nhcl);
            var a = ConsultaService.ObtenerApuntesHistoriaAsync(Nhcl);

            await Task.WhenAll(h, c, p, a);

            _historial = h.Result;
            _mediciones = c.Result;
            _pacienteInfo = p.Result;
            _apuntes = a.Result;

            CargarArchivos();
        }
        catch (Exception)
        {
            _error = "No se pudo cargar el historial del paciente.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private void CambiarMetrica(string metrica)
    {
        _metricaActiva = metrica;
        _puntoSeleccionado = null;
    }

    private List<PuntoGrafico> ObtenerPuntosValidos()
    {
        var lista = new List<PuntoGrafico>();
        int idx = 0;
        foreach (var m in _mediciones.OrderBy(x => x.Fecha))
        {
            decimal? val = _metricaActiva switch
            {
                "fc" => m.FrecuenciaCardiaca,
                "fr" => m.FrecuenciaRespiratoria,
                _ => m.Peso
            };

            if (val.HasValue && val.Value > 0)
            {
                lista.Add(new PuntoGrafico(idx++, m.Fecha, m.EdadMeses, val.Value));
            }
        }
        return lista;
    }

    private void SeleccionarPuntoPorFecha(DateTime fecha)
    {
        var puntos = ObtenerPuntosValidos();
        _puntoSeleccionado = puntos.FirstOrDefault(p => p.Fecha == fecha);
    }

    private async Task ImprimirGraficoAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private string DirectorioRelativo => $"archivosPacientes/{Nhcl}/ingreso";
    private string DirectorioFisico => Path.Combine(Environment.WebRootPath, "archivosPacientes", Nhcl.ToString(), "ingreso");
    private string RutaMetadataComentarios => Path.Combine(DirectorioFisico, "_metadata_comentarios.json");

    private IBrowserFile? _archivoSeleccionado;
    private string _nuevoArchivoComentario = string.Empty;
    private bool _subiendoArchivo;
    private string? _archivoAEliminar;
    private bool _mostrarModalEliminarArchivo;
    private string? _archivoAEditarComentario;
    private string _comentarioEditando = string.Empty;
    private bool _mostrarModalEditarComentario;

    private static string FormatearTamano(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
        if (bytes >= 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{bytes} B";
    }

    private Dictionary<string, string> ObtenerDiccionarioComentarios()
    {
        try
        {
            if (File.Exists(RutaMetadataComentarios))
            {
                var json = File.ReadAllText(RutaMetadataComentarios);
                return System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(json) ?? new();
            }
        }
        catch { }
        return new();
    }

    private void GuardarDiccionarioComentarios(Dictionary<string, string> dict)
    {
        try
        {
            Directory.CreateDirectory(DirectorioFisico);
            File.WriteAllText(RutaMetadataComentarios, System.Text.Json.JsonSerializer.Serialize(dict));
        }
        catch { }
    }

    private void CargarArchivos()
    {
        try
        {
            Directory.CreateDirectory(DirectorioFisico);
            var comentarios = ObtenerDiccionarioComentarios();
            var di = new DirectoryInfo(DirectorioFisico);
            _archivos = di.EnumerateFiles()
                .Where(f => !f.Name.StartsWith("_metadata_"))
                .Select(x => new ArchivoPaciente(
                    x.Name,
                    $"/{DirectorioRelativo}/{Uri.EscapeDataString(x.Name)}",
                    x.LastWriteTime,
                    x.Length,
                    comentarios.TryGetValue(x.Name, out var c) ? c : null))
                .OrderByDescending(x => x.Fecha)
                .ToList();
        }
        catch
        {
            _archivos = [];
        }
    }

    private void OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        _archivoSeleccionado = e.File;
        _error = string.Empty;
    }

    private async Task SubirArchivoAsync()
    {
        if (_archivoSeleccionado == null)
        {
            _error = "Por favor seleccione un archivo o foto para subir.";
            return;
        }

        if (_archivoSeleccionado.Size > 15 * 1024 * 1024)
        {
            _error = "El archivo supera el límite máximo permitido de 15 MB.";
            return;
        }

        var extensiones = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".pdf", ".png", ".jpg", ".jpeg", ".webp", ".xlsx", ".docx" };
        var ext = Path.GetExtension(_archivoSeleccionado.Name);
        if (string.IsNullOrWhiteSpace(ext) || !extensiones.Contains(ext))
        {
            _error = $"Tipo de archivo no permitido ('{ext}'). Solo se admiten fotos (JPG, PNG, WEBP), PDF, DOCX y XLSX.";
            return;
        }

        _subiendoArchivo = true;
        try
        {
            Directory.CreateDirectory(DirectorioFisico);
            var nombre = $"{DateTime.Now:yyyyMMddHHmmss}_{Path.GetFileNameWithoutExtension(_archivoSeleccionado.Name)}{ext}";
            var fullPath = Path.Combine(DirectorioFisico, nombre);

            await using var entrada = _archivoSeleccionado.OpenReadStream(15 * 1024 * 1024);
            await using var salida = File.Create(fullPath);
            await entrada.CopyToAsync(salida);

            if (!string.IsNullOrWhiteSpace(_nuevoArchivoComentario))
            {
                var dict = ObtenerDiccionarioComentarios();
                dict[nombre] = _nuevoArchivoComentario.Trim();
                GuardarDiccionarioComentarios(dict);
            }

            _archivoSeleccionado = null;
            _nuevoArchivoComentario = string.Empty;
            _error = "";
            _mensaje = $"Archivo '{nombre}' subido correctamente.";
            CargarArchivos();
        }
        catch (Exception ex)
        {
            _error = $"Error al subir el archivo: {ex.Message}";
        }
        finally
        {
            _subiendoArchivo = false;
        }
    }

    private void ConfirmarEliminarArchivo(string nombre)
    {
        _archivoAEliminar = nombre;
        _mostrarModalEliminarArchivo = true;
    }

    private void CancelarEliminarArchivo()
    {
        _archivoAEliminar = null;
        _mostrarModalEliminarArchivo = false;
    }

    private void EliminarArchivoConfirmado()
    {
        if (string.IsNullOrWhiteSpace(_archivoAEliminar)) return;

        try
        {
            var ruta = Path.Combine(DirectorioFisico, _archivoAEliminar);
            if (File.Exists(ruta))
            {
                File.Delete(ruta);
            }

            var dict = ObtenerDiccionarioComentarios();
            if (dict.ContainsKey(_archivoAEliminar))
            {
                dict.Remove(_archivoAEliminar);
                GuardarDiccionarioComentarios(dict);
            }

            _mensaje = $"Archivo '{_archivoAEliminar}' eliminado correctamente.";
            _error = "";
            _archivoAEliminar = null;
            _mostrarModalEliminarArchivo = false;
            CargarArchivos();
        }
        catch (Exception ex)
        {
            _error = $"Error al eliminar el archivo: {ex.Message}";
            _mostrarModalEliminarArchivo = false;
        }
    }

    private void AbrirEditarComentario(ArchivoPaciente arc)
    {
        _archivoAEditarComentario = arc.Nombre;
        _comentarioEditando = arc.Comentario ?? string.Empty;
        _mostrarModalEditarComentario = true;
    }

    private void GuardarComentarioEditado()
    {
        if (string.IsNullOrWhiteSpace(_archivoAEditarComentario)) return;

        var dict = ObtenerDiccionarioComentarios();
        if (string.IsNullOrWhiteSpace(_comentarioEditando))
        {
            dict.Remove(_archivoAEditarComentario);
        }
        else
        {
            dict[_archivoAEditarComentario] = _comentarioEditando.Trim();
        }
        GuardarDiccionarioComentarios(dict);

        _mostrarModalEditarComentario = false;
        _archivoAEditarComentario = null;
        _mensaje = "Comentario actualizado correctamente.";
        CargarArchivos();
    }

    private async Task GuardarApunteAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevoApunte.Observacion))
        {
            _mensajeApunte = "Debe escribir una observación clínica para guardar el apunte.";
            _esErrorApunte = true;
            return;
        }

        _guardandoApunte = true;
        try
        {
            _nuevoApunte.Nhcl = Nhcl;
            _nuevoApunte.Tipo = "HDEV";
            var (ok, errorMsg) = await ConsultaService.AgregarApunteHistoriaAsync(_nuevoApunte, Session.CurrentUser?.UserNumero ?? 1);
            if (ok)
            {
                _mensajeApunte = "Apunte clínico guardado correctamente.";
                _esErrorApunte = false;
                _nuevoApunte = new() { Fecha = DateTime.Today };
                _apuntes = await ConsultaService.ObtenerApuntesHistoriaAsync(Nhcl);
            }
            else
            {
                _mensajeApunte = errorMsg ?? "No se pudo guardar el apunte.";
                _esErrorApunte = true;
            }
        }
        catch (Exception ex)
        {
            _mensajeApunte = $"Error al guardar apunte: {ex.Message}";
            _esErrorApunte = true;
        }
        finally
        {
            _guardandoApunte = false;
        }
    }

    private async Task AnularApunteAsync(int id)
    {
        _anulandoApunte = true;
        try
        {
            var (ok, errorMsg) = await ConsultaService.AnularApunteHistoriaAsync(id, Session.CurrentUser?.UserNumero ?? 1);
            if (ok)
            {
                _idApunteAAnular = 0;
                _mensajeApunte = "Apunte anulado correctamente.";
                _esErrorApunte = false;
                _apuntes = await ConsultaService.ObtenerApuntesHistoriaAsync(Nhcl);
            }
            else
            {
                _mensajeApunte = errorMsg ?? "No se pudo anular el apunte.";
                _esErrorApunte = true;
            }
        }
        catch (Exception ex)
        {
            _mensajeApunte = $"Error al anular apunte: {ex.Message}";
            _esErrorApunte = true;
        }
        finally
        {
            _anulandoApunte = false;
        }
    }
