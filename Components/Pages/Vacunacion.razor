@page "/consulta/vacunas"
@page "/consulta/vacunas/{Nhcl:int}"
@inject IConsultaExternaService ConsultaService
@inject IAdmisionFacturacionService AdmisionService
@inject IKardexService KardexService
@inject SessionStateService Session
@inject NavigationManager Nav

<PageTitle>Vacunación | e-ForVets</PageTitle>

<div class="container-fluid py-3 vaccination-page">
    <header class="vaccination-heading">
        <div>
            <span>Consulta e historia</span>
            <h1>Vacunación</h1>
            <p>Registro histórico de vacunas, desparasitación y próximos refuerzos.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="alert @(_esError ? "alert-danger" : "alert-success")" role="alert">@_mensaje</div>
    }

    <section class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <label class="form-label fw-semibold" for="buscar-paciente">Buscar paciente</label>
            <div class="input-group">
                <input id="buscar-paciente" class="form-control" autocomplete="off" @bind="_filtro" @bind:event="oninput" @bind:after="BuscarPacientesAutoAsync"
                       @onkeydown="BuscarConEnterAsync" placeholder="Nombre de mascota, propietario, cédula o número de historia" />
            </div>
            @if (_resultados.Count > 0)
            {
                <div class="patient-results mt-2">
                    @foreach (var paciente in _resultados)
                    {
                        <button type="button" @onclick="() => SeleccionarPacienteAsync(paciente)">
                            <strong>@paciente.MasNombre</strong>
                            <span>NHCL @paciente.MasNhcl · @paciente.ClienteNombre · @paciente.EspecieDescripcion</span>
                        </button>
                    }
                </div>
            }
        </div>
    </section>

    @if (_paciente is not null)
    {
        <section class="patient-summary mb-3">
            <div><small>Paciente</small><strong>@_paciente.PacienteNombre</strong></div>
            <div><small>Historia clínica</small><strong>@_paciente.Nhcl</strong></div>
            <div><small>Edad</small><strong>@_paciente.EdadTexto</strong></div>
            <div><small>Especie / raza</small><strong>@_paciente.Especie · @_paciente.Raza</strong></div>
            <div><small>Propietario</small><strong>@_paciente.ClienteNombre</strong></div>
        </section>

        <div class="row g-3">
            <div class="col-xl-4">
                <section class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold">Nuevo registro</div>
                    <div class="card-body vaccination-form">
                        <label>Tipo
                            <select class="form-select" @bind="_nueva.Tipo">
                                <option value="Vacunación">Vacunación</option>
                                <option value="Desparasitación">Desparasitación</option>
                                <option value="Antiparasitario externo">Antiparasitario externo</option>
                            </select>
                        </label>
                        <label>Vacuna o producto
                            <select class="form-select" @bind="_nueva.IdProducto">
                                <option value="0">Seleccione</option>
                                @foreach (var producto in _catalogo)
                                {
                                    <option value="@producto.Id">@producto.Descripcion</option>
                                }
                            </select>
                        </label>
                        <div class="row g-2">
                            <label class="col-sm-6">Fecha de aplicación
                                <input type="date" class="form-control" @bind="_nueva.Fecha" />
                            </label>
                            <label class="col-sm-6">Próximo refuerzo
                                <input type="date" class="form-control" value="@FechaRefuerzoTexto" @onchange="CambiarFechaRefuerzo" />
                            </label>
                        </div>
                        <label>Observaciones
                            <textarea class="form-control" rows="4" maxlength="2000" @bind="_nueva.ObservacionVacuna"
                                      placeholder="Lote, fabricante, sitio de aplicación o reacción observada"></textarea>
                        </label>
                        <button class="btn btn-success w-100" disabled="@_guardando" @onclick="GuardarAsync">
                            @(_guardando ? "Guardando..." : "Guardar registro")
                        </button>
                    </div>
                </section>
            </div>
            <div class="col-xl-8">
                <section class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <strong>Historial de vacunación</strong><span class="badge text-bg-primary">@_vacunas.Count registros</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Aplicación</th><th>Tipo</th><th>Vacuna / producto</th><th>Próximo refuerzo</th><th>Observaciones</th><th>Registrado por</th><th></th></tr></thead>
                            <tbody>
                                @if (_vacunas.Count == 0)
                                {
                                    <tr><td colspan="7" class="text-center text-muted py-4">El paciente no tiene vacunas registradas.</td></tr>
                                }
                                @foreach (var vacuna in _vacunas)
                                {
                                    <tr>
                                        <td>@vacuna.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@vacuna.Tipo</td>
                                        <td class="fw-semibold">@(string.IsNullOrWhiteSpace(vacuna.NombreVacuna) ? "Sin producto asociado" : vacuna.NombreVacuna.ToUpperInvariant())</td>
                                        <td>@(vacuna.FechaRevacunacion?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@vacuna.ObservacionVacuna</td>
                                        <td>@vacuna.NombreMedico</td>
                                        <td><button class="btn btn-sm btn-outline-danger" title="Eliminar" @onclick="() => EliminarAsync(vacuna.VacunaId)">Eliminar</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Nhcl { get; set; }

    private string _filtro = string.Empty;
    private string? _mensaje;
    private bool _esError;
    private bool _cargando;
    private bool _guardando;
    private int _idCliente;
    private PacienteHeaderDto? _paciente;
    private List<PacienteMascotaDto> _resultados = [];
    private List<CatalogoItemGenericoDto> _catalogo = [];
    private List<VacunaPacienteDto> _vacunas = [];
    private VacunaPacienteDto _nueva = NuevaVacuna();
    private string FechaRefuerzoTexto => _nueva.FechaRevacunacion?.ToString("yyyy-MM-dd") ?? string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _catalogo = await ConsultaService.ObtenerCatalogoVacunasAsync();
        if (Nhcl <= 0 && Session.NhclActivo is > 0) Nhcl = Session.NhclActivo.Value;
        if (Nhcl > 0) await CargarPacienteAsync(Nhcl);
    }

    private async Task BuscarConEnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarPacientesAsync();
    }

    private async Task BuscarPacientesAutoAsync()
    {
        _mensaje = null;
        if (string.IsNullOrWhiteSpace(_filtro))
        {
            _resultados = [];
            return;
        }
        _cargando = true;
        try
        {
            _resultados = await AdmisionService.BuscarMascotasAsync(_filtro);
        }
        catch { }
        finally { _cargando = false; }
    }

    private async Task BuscarPacientesAsync()
    {
        _mensaje = null;
        _cargando = true;
        try
        {
            _resultados = await AdmisionService.BuscarMascotasAsync(_filtro);
            if (_resultados.Count == 0) MostrarError("No se encontraron pacientes con ese criterio.");
        }
        catch (Exception ex) { MostrarError($"No se pudo consultar pacientes: {ex.Message}"); }
        finally { _cargando = false; }
    }

    private async Task SeleccionarPacienteAsync(PacienteMascotaDto paciente)
    {
        _idCliente = paciente.MasIdCliente;
        _resultados = [];
        Nhcl = paciente.MasNhcl;
        await CargarPacienteAsync(Nhcl);
        Nav.NavigateTo($"/consulta/vacunas/{Nhcl}", replace: true);
    }

    private async Task CargarPacienteAsync(int nhcl)
    {
        _paciente = await KardexService.ObtenerCabeceraPacienteAsync(0, nhcl);
        if (_paciente is null)
        {
            MostrarError("No se encontró la información del paciente.");
            return;
        }
        _idCliente = _paciente.ClienteCodigo;
        Session.SeleccionarOrden(_paciente.OrdenAtencionId, nhcl, _paciente.PacienteNombre);
        _vacunas = await ConsultaService.ObtenerVacunasPacienteAsync(nhcl);
        _nueva = NuevaVacuna();
    }

    private void CambiarFechaRefuerzo(ChangeEventArgs e)
    {
        _nueva.FechaRevacunacion = DateTime.TryParse(e.Value?.ToString(), out var fecha) ? fecha.Date : null;
    }

    private async Task GuardarAsync()
    {
        _mensaje = null;
        if (_paciente is null || Nhcl <= 0) { MostrarError("Seleccione un paciente."); return; }
        if (_nueva.IdProducto <= 0) { MostrarError("Seleccione la vacuna o producto aplicado."); return; }
        if (_nueva.Fecha.Date > DateTime.Today) { MostrarError("La fecha de aplicación no puede ser futura."); return; }
        if (_nueva.FechaRevacunacion.HasValue && _nueva.FechaRevacunacion.Value.Date < _nueva.Fecha.Date)
        { MostrarError("El próximo refuerzo no puede ser anterior a la aplicación."); return; }

        _guardando = true;
        try
        {
            _nueva.Nhcl = Nhcl;
            _nueva.Orden = _paciente.OrdenAtencionId;
            await ConsultaService.AgregarVacunaAsync(_nueva, Session.IdUser, _idCliente);
            _vacunas = await ConsultaService.ObtenerVacunasPacienteAsync(Nhcl);
            _nueva = NuevaVacuna();
            _esError = false;
            _mensaje = "Vacuna registrada correctamente.";
        }
        catch (Exception ex) { MostrarError($"No se pudo guardar la vacuna: {ex.Message}"); }
        finally { _guardando = false; }
    }

    private async Task EliminarAsync(int vacunaId)
    {
        await ConsultaService.EliminarVacunaAsync(vacunaId, Session.IdUser);
        _vacunas = await ConsultaService.ObtenerVacunasPacienteAsync(Nhcl);
        _esError = false;
        _mensaje = "Registro eliminado.";
    }

    private void MostrarError(string mensaje) { _esError = true; _mensaje = mensaje; }
    private static VacunaPacienteDto NuevaVacuna() => new() { Fecha = DateTime.Today, FechaRevacunacion = DateTime.Today.AddYears(1) };
}
