    private void EnviarARecepcionOrdenes(CitaMedicaDto cita)
    {
        if (!PuedeEditar(cita)) return;

        if (cita.CiNhcl <= 0)
        {
            MostrarErrorCita($"La cita de {cita.CiNombreMas} no tiene un paciente (NHCL) asignado. Primero vincule o registre el paciente en 'Clientes, tutores y mascotas'.");
            return;
        }

        string horaNorm = string.IsNullOrWhiteSpace(cita.CiHora) ? DateTime.Now.ToString("HH:mm") : cita.CiHora.Trim();
        string fechaNorm = (cita.CiFecha == default ? DateTime.Today : cita.CiFecha).ToString("yyyy-MM-dd");
        
        int idEsp = ResolverEspecialidadCita(cita);
        NavManager.NavigateTo($"/admision/ordenes?nhcl={cita.CiNhcl}&idMedico={cita.CiUsuario}&idEspecialidad={idEsp}&tipoConsulta={cita.CiTipoConsulta}&idCita={cita.CiId}&hora={Uri.EscapeDataString(horaNorm)}&fecha={fechaNorm}");
    }

