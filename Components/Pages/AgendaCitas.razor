    private async Task<List<CatalogoItemGenericoDto>> ObtenerMedicosVisiblesAsync(int sucursal)
    {
        if (sucursal <= 0)
            return _medicos;

        return await AdmisionService.ObtenerMedicosAgendaAsync(sucursal);
    }

    private async Task ActualizarMedicosAgendaAsync()
    {
        var sucursal = _sucursalAgenda;
        var medicos = await ObtenerMedicosVisiblesAsync(sucursal);
        if (sucursal != _sucursalAgenda)
            return;

        _medicosAgenda = medicos;
        if (!_medicosAgenda.Any(medico => medico.Id == _medicoAgenda))
            _medicoAgenda = _puedeVerAgendaCompleta ? 0 : _medicosAgenda.FirstOrDefault()?.Id ?? 0;
    }

    private async Task CargarAgendaAsync()
    {
        var version = ++_versionAgenda;
        var medico = _medicoAgenda;
        var inicio = InicioSemana(InicioMes);
        var hasta = InicioSemana(InicioMes.AddMonths(1).AddDays(-1)).AddDays(6);
        var localidad = _sucursalAgenda;
        _cargandoInicial = true;
        _citas = [];
        _citasMes = _citas.ToLookup(cita => cita.CiFecha.Date);
        _slotsMes = [];

        try
        {
            if (_sucursales.Count == 0 || (localidad > 0 && medico <= 0))
                return;

            var citas = AdmisionService.ObtenerCitasPorFechaAsync(inicio, hasta, medico, localidad > 0 ? localidad : null);
            if (localidad > 0)
            {
                var horarios = AdmisionService.ObtenerSlotsHorarioMedicoPorRangoAsync(medico, inicio, hasta, localidad);
                await Task.WhenAll(citas, horarios);
                if (version == _versionAgenda)
                    _slotsMes = await horarios;
            }

            var citasMes = await citas;
            if (version != _versionAgenda)
                return;

            _citasMes = citasMes.ToLookup(cita => cita.CiFecha.Date);
            ActualizarCitasDelDia();
        }
        catch (Exception)
        {
            if (version == _versionAgenda)
            {
                _mensajeEsError = true;
                _mensaje = "No se pudo cargar la disponibilidad del médico.";
            }
        }
        finally
        {
            if (version == _versionAgenda)
                _cargandoInicial = false;
        }
    }

    private void ActualizarCitasDelDia() => _citas = _citasMes[_fechaAgenda.Date].ToList();

    private async Task CambiarMedicoAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idMed) && _puedeVerAgendaCompleta &&
            (idMed == 0 || _medicosAgenda.Any(medico => medico.Id == idMed)))
        {
            _medicoAgenda = idMed;
            await CargarAgendaAsync();
        }
    }

    private Task SeleccionarFechaAsync(DateTime fecha)
    {
        var recargarMes = fecha.Year != _fechaAgenda.Year || fecha.Month != _fechaAgenda.Month;
        _fechaAgenda = fecha.Date;
        if (recargarMes)
            return CargarAgendaAsync();

        ActualizarCitasDelDia();
        return Task.CompletedTask;
    }

    private Task CambiarFechaAsync(ChangeEventArgs e) =>
        DateTime.TryParse(e.Value?.ToString(), out var fecha) ? SeleccionarFechaAsync(fecha) : Task.CompletedTask;

    private void SeleccionarHoraLibre(string hora)
    {
        _nuevaCita.CiHora = hora;
        _mostrarFormularioCita = true;
    }

    private void AutocompletarPacienteCita(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nhcl) && nhcl > 0)
        {
            var p = _pacientes.FirstOrDefault(x => x.MasNhcl == nhcl);
            if (p != null)
            {
                _nuevaCita.CiNhcl = p.MasNhcl;
                _nuevaCita.CiNombreMas = p.MasNombre;
                _nuevaCita.CiNombre = p.ClienteNombre;
                _nuevaCita.CiTelefono = p.ClienteTelefono;
                _nuevaCita.CiTipo = p.MasOrigen;
            }
        }
    }

    private async Task GuardarCitaAsync()
    {
        _errorFormulario = string.Empty;
        try
        {
            int idUser = SessionState.UsuarioActual?.IdUsuario ?? 1;
            var medicoObj = _medicosAgenda.FirstOrDefault(m => m.Id == _idMedicoFiltro);
            _nuevaCita.CiUsuario = _idMedicoFiltro;
            _nuevaCita.NombreMedico = medicoObj?.Descripcion ?? "Médico";


            if (_nuevaCita.CiFecha == default)
                _nuevaCita.CiFecha = _fechaAgenda;

            if (TimeSpan.TryParse(_nuevaCita.CiHora, out var ts))
            {
                _nuevaCita.CiHora = $"{ts.Hours:D2}:{ts.Minutes:D2}";
            }

            if (_idMedicoFiltro <= 0)
            {
                _errorFormulario = "No hay médicos veterinarios registrados en la especialidad seleccionada.";
                return;
            }
            if (string.IsNullOrWhiteSpace(_nuevaCita.CiHora))
            {
                _errorFormulario = "Selecciona una hora disponible o cambia la fecha de la cita.";
                return;
            }

            if (_nuevaCita.CiFecha.Date >= AhoraClinica.Date &&
                !ObtenerHorasLibresParaFormulario().Contains(_nuevaCita.CiHora))
            {
                _errorFormulario = "Selecciona un turno disponible para el médico y la fecha.";
                return;
            }
            _nuevaCita.CiEspecialidad = ResolverEspecialidadCita(_nuevaCita);
            int idCita = await AdmisionService.AgendarCitaAsync(_nuevaCita, idUser);
            _mensaje = $"Cita #{idCita} agendada para {_nuevaCita.CiNombreMas} a las {_nuevaCita.CiHora} con {_nuevaCita.NombreMedico}.";
            _mensajeEsError = false;

            _fechaAgenda = _nuevaCita.CiFecha;
            _medicoAgenda = _idMedicoFiltro;
            _sucursalAgenda = _nuevaCita.CiLocalidad;
            _nuevaCita = new CitaMedicaDto 
            { 
                CiFecha = _fechaAgenda, 
                CiHora = "08:00", 
                CiUsuario = _idMedicoFiltro, 
                CiLocalidad = _sucursalAgenda
            };
            await CargarAgendaAsync();
            _mostrarFormularioCita = false;
        }
        catch (InvalidOperationException ex)
        {
            _errorFormulario = ex.Message;
        }
        catch (Exception ex)
        {
            _errorFormulario = $"No se pudo agendar la cita: {ex.Message}";
        }
    }

    private async Task CambiarEstadoCitaAsync(int idCita, string nuevoEstado)
    {
        _mensajeModal = string.Empty;
        try
        {
            var ok = await AdmisionService.ActualizarEstadoCitaAsync(idCita, nuevoEstado);
            if (ok)
            {
                _mensajeEsError = false;
                _mensaje = nuevoEstado switch
                {
                    "C" => $"Cita #{idCita} confirmada exitosamente.",
                    "X" => $"Cita #{idCita} cancelada.",
                    "N" => $"Cita #{idCita} marcada como por confirmar.",
                    _ => $"Estado de la cita #{idCita} actualizado."
                };
            }
            else
            {
                MostrarErrorCita($"No se pudo actualizar el estado de la cita #{idCita}.");
                return;
            }
            await CargarAgendaAsync();
            if (_citaDetalle != null && _citaDetalle.CiId == idCita)
            {
                _citaDetalle.CiEstadoCita = nuevoEstado;
            }
        }
        catch (Exception ex)
        {
            MostrarErrorCita($"Error al cambiar estado de la cita: {ex.Message}");
        }
    }

    private void MostrarErrorCita(string mensaje)
    {
        if (_citaDetalle is not null || _citaReagendar is not null || _citaCancelar is not null)
            _mensajeModal = mensaje;
        else
        {
            _mensajeEsError = true;
            _mensaje = mensaje;
        }
    }

    private async Task ExportarPdfAgendaAsync()
    {
        var bytes = ReportService.GenerarAgendaCitasPdf(_citas, _fechaAgenda, _fechaAgenda);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $"{{ const a = document.createElement('a'); a.href = 'data:application/pdf;base64,{base64}'; a.download = 'Agenda_Citas_{_fechaAgenda:yyyyMMdd}.pdf'; a.click(); }}");
    }
}
