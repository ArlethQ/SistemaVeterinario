    private int ResolverEspecialidadPorTipo(int tipoConsulta, int idMedico)
    {
        if (tipoConsulta == 1 || tipoConsulta == 4)
        {
            var medGen = _especialidades.FirstOrDefault(x =>
                string.Equals(x.Codigo, "MG", StringComparison.OrdinalIgnoreCase) ||
                x.Descripcion.Contains("MEDICINA GENERAL", StringComparison.OrdinalIgnoreCase));
            if (medGen != null) return medGen.Id;
        }
        else if (tipoConsulta == 3)
        {
            var cir = _especialidades.FirstOrDefault(x =>
                string.Equals(x.Codigo, "CIR", StringComparison.OrdinalIgnoreCase) ||
                x.Descripcion.Contains("CIRUGIA", StringComparison.OrdinalIgnoreCase));
            if (cir != null) return cir.Id;
        }

        var med = _medicos.FirstOrDefault(m => m.Id == idMedico);
        if (med?.IdPadre.GetValueOrDefault() > 0)
            return med.IdPadre!.Value;

        return _especialidades.FirstOrDefault()?.Id ?? 1;
    }

    private int ResolverEspecialidadCita(CitaMedicaDto cita)
    {
        if (cita.CiTipoConsulta == 2 && cita.CiEspecialidad > 0)
            return cita.CiEspecialidad;
        if (cita.CiEspecialidad > 0)
            return cita.CiEspecialidad;
        return ResolverEspecialidadPorTipo(cita.CiTipoConsulta, cita.CiUsuario);
    }

    private string ObtenerFotoPaciente(int nhcl)
    {
        if (nhcl <= 0) return string.Empty;
        string directorio = Path.Combine(Env.WebRootPath, "PacientesFotos");
        if (!Directory.Exists(directorio)) return string.Empty;
        string? archivo = Directory.EnumerateFiles(directorio, $"{nhcl}.*").FirstOrDefault();
        return archivo is null ? string.Empty : $"/pacientes-fotos/{nhcl}?v={File.GetLastWriteTimeUtc(archivo).Ticks}";
    }

