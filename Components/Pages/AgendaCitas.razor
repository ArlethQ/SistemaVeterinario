    private bool EsFechaUHoraPasada
    {
        get
        {
            var fecha = _nuevaCita.CiFecha == default ? _fechaAgenda : _nuevaCita.CiFecha;
            if (fecha.Date < AhoraClinica.Date) return true;
            if (fecha.Date == AhoraClinica.Date && TimeSpan.TryParse(_nuevaCita.CiHora, out var t))
            {
                return t < AhoraClinica.TimeOfDay;
