@page "/admision/citas"
@using HosvetKardex.Web.Models
@using HosvetKardex.Web.Services
@inject IAdmisionFacturacionService AdmisionService
@inject IReportExportService ReportService
@inject SessionStateService SessionState
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject NavigationManager NavManager

<PageTitle>e-ForVets — Agenda Médica y Calendarización de Citas</PageTitle>

<div class="container-fluid py-3 agenda-page">
    <!-- Encabezado -->
    <div class="agenda-hero d-flex flex-wrap justify-content-between align-items-center mb-3 p-3 bg-white">
        <div class="d-flex align-items-center gap-3">
            <div class="agenda-hero-icon">▦</div><div>
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-calendar2-week-fill me-2"></i>Agenda Médica
            </h4>
            <small class="text-muted">
                Programación de turnos por especialista, disponibilidad horaria y confirmación de citas.
            </small>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center agenda-toolbar">
            <button class="btn btn-outline-secondary btn-sm" @onclick="DiaAnterior">‹</button>
            <input type="date" class="form-control form-control-sm" value="@_fechaAgenda.ToString("yyyy-MM-dd")" @onchange="CambiarFechaAsync" />
            <button class="btn btn-outline-secondary btn-sm" @onclick="DiaSiguiente">›</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="IrHoy">Hoy</button>
            <button class="btn btn-primary btn-sm" @onclick="AbrirFormularioCita">+ Agendar cita</button>
            <button class="btn btn-outline-danger btn-sm" @onclick="ExportarPdfAgendaAsync">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>Exportar Agenda PDF
            </button>
            @if (Permisos.Permite("admision/ordenes"))
            {
                <a href="/admision/ordenes" class="btn btn-success btn-sm">
                    <i class="bi bi-clipboard2-pulse me-1"></i>Recepción / Órdenes
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensaje))
    {
        <div class="alert @(_mensajeEsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2" role="alert">
            <i class="bi @(_mensajeEsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@_mensaje
            <button type="button" class="btn-close" @onclick="() => _mensaje = string.Empty"></button>
        </div>
    }

    @if (_cargandoInicial)
    {
        <LoadingState Title="Cargando agenda médica"
                      Message="Preparando citas, especialistas y turnos disponibles." />
    }

    <div class="row g-3 mb-3 agenda-kpis">
        <div class="col-6 col-xl-3"><div class="agenda-kpi blue"><span>AGE</span><div><strong>@_citas.Count</strong><small>Citas programadas</small><em>Para este día</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="agenda-kpi green"><span>CON</span><div><strong>@CitasConfirmadas</strong><small>Confirmadas</small><em>@Porcentaje(CitasConfirmadas)% del total</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="agenda-kpi amber"><span>PEN</span><div><strong>@CitasPendientes</strong><small>Por confirmar</small><em>@Porcentaje(CitasPendientes)% del total</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="agenda-kpi red"><span>CAN</span><div><strong>@CitasCanceladas</strong><small>Canceladas</small><em>@Porcentaje(CitasCanceladas)% del total</em></div></div></div>
    </div>

    <nav class="agenda-tabs mb-3">
        <button class="@(_vistaAgenda == "agenda" ? "active" : "")" @onclick='() => _vistaAgenda = "agenda"'>Agenda diaria</button>
        <button class="@(_vistaAgenda == "tabla" ? "active" : "")" @onclick='() => _vistaAgenda = "tabla"'>Citas programadas <span>@_citas.Count</span></button>
        <button class="@(_vistaAgenda == "historial" ? "active" : "")" @onclick="AbrirHistorialAsync">Historial y filtros</button>
    </nav>

    <div class="@(_vistaAgenda == "agenda" ? "row g-3 agenda-workspace" : "d-none")">
        <div class="col-xl-9">
            <section class="calendar-card">
                <header><span>│</span><strong>Médicos Veterinarios</strong></header>
                <div class="calendar-grid calendar-doctors" style="--doctor-count:@MedicosAgenda.Count">
                    <div class="time-header"></div>
                    @foreach (var medico in MedicosAgenda)
                    {
                        <div class="calendar-doctor"><span>@Iniciales(medico.Descripcion)</span><div><strong>@medico.Descripcion</strong><small>Médico veterinario</small></div></div>
                    }
                </div>
                <div class="calendar-scroll">
                    @foreach (var hora in HorasAgenda)
                    {
                        bool receso = hora.StartsWith("13:");
                        <div class="calendar-grid calendar-row @(receso ? "lunch-row" : "")" style="--doctor-count:@MedicosAgenda.Count">
                            <div class="calendar-time">@hora</div>
                            @if (receso)
                            {
                                <div class="calendar-lunch">13:00 Receso / Almuerzo</div>
                            }
                            else
                            {
                                @foreach (var medico in MedicosAgenda)
                                {
                                    var cita = ObtenerCita(medico.Id, hora);
                                    if (cita is null)
                                    {
                                        var slot = ObtenerSlot(medico.Id, hora);
                                        if (slot?.Bloqueado != true)
                                        {
                                            <button type="button" class="calendar-slot free" title="Seleccionar @hora para agendar con @medico.Descripcion" @onclick="() => AbrirDesdeCasilla(medico.Id, hora)"><span>+</span></button>
                                        }
                                        else
                                        {
                                            <span class="calendar-slot" title="@slot.MotivoEstado"></span>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="calendar-slot appointment @ClaseEstadoCita(cita.CiEstadoCita)" @onclick="() => VerDetalleCita(cita)">
                                            <span class="appointment-photo">@if (!string.IsNullOrEmpty(ObtenerFotoPaciente(cita.CiNhcl))) { <img src="@ObtenerFotoPaciente(cita.CiNhcl)" alt="Foto de @cita.CiNombreMas" /> } else { <b>@Iniciales(cita.CiNombreMas)</b> }</span>
                                            <span><strong>@cita.CiNombreMas @if(cita.CiNhcl > 0){<small>(#@cita.CiNhcl)</small>}</strong><small>@cita.CiNombre</small><em>@TextoTipoConsultaCita(cita)</em></span>
                                        </button>
                                    }
                                }
                            }
                        </div>
                    }
                </div>
                <footer class="calendar-legend"><span class="confirmed">Confirmada</span><span class="pending">Por confirmar</span><span class="waiting">Agendada</span><span class="cancelled">Cancelada</span></footer>
            </section>
        </div>
        <div class="col-xl-3">
            <section class="day-list-card">
                <header><strong>Citas del día (@_citas.Count)</strong></header>
                <div class="day-list">
                    @foreach (var cita in _citas.OrderBy(c => c.CiHora))
                    {
                        <button type="button" class="day-appointment" @onclick="() => VerDetalleCita(cita)"><time>@cita.CiHora</time><span class="mini-pet">@if(!string.IsNullOrEmpty(ObtenerFotoPaciente(cita.CiNhcl))){<img src="@ObtenerFotoPaciente(cita.CiNhcl)" alt="Foto de @cita.CiNombreMas"/>}else{<b>@Iniciales(cita.CiNombreMas)</b>}</span><span><strong>@cita.CiNombreMas</strong><small>@cita.CiNombre</small></span><em class="@ClaseEstadoCita(cita.CiEstadoCita)">@TextoEstadoCita(cita.CiEstadoCita)</em></button>
                    }
                </div>
            </section>
        </div>
    </div>

    @if (_vistaAgenda == "tabla")
    {
        <section class="scheduled-table-card">
            <header><div><small>PROGRAMACIÓN DEL DÍA</small><h5>Citas programadas</h5></div><div><span>@_fechaAgenda.ToString("dd/MM/yyyy")</span><button class="btn btn-primary btn-sm" @onclick="AbrirFormularioCita">+ Agendar cita</button></div></header>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Hora</th><th>Paciente</th><th>Propietario / Contacto</th><th>Médico</th><th>Tipo / Motivo</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var cita in _citas.OrderBy(c => c.CiHora))
                        {
                            <tr>
                                <td><strong class="scheduled-time">@cita.CiHora</strong></td>
                                <td><div class="scheduled-patient"><span class="appointment-photo">@if(!string.IsNullOrEmpty(ObtenerFotoPaciente(cita.CiNhcl))){<img src="@ObtenerFotoPaciente(cita.CiNhcl)" alt="Foto de @cita.CiNombreMas"/>}else{<b>@Iniciales(cita.CiNombreMas)</b>}</span><div><strong>@cita.CiNombreMas</strong><small>@(cita.CiNhcl > 0 ? $"NHCL #{cita.CiNhcl}" : "Sin NHCL")</small></div></div></td>
                                <td><strong>@cita.CiNombre</strong><small>@cita.CiTelefono</small></td>
                                <td><strong>@cita.NombreMedico</strong><small>@cita.Especialidad</small></td>
                                <td><strong>@TextoTipoConsultaCita(cita)</strong><small>@cita.CiObservacion</small></td>
                                <td><span class="table-status @ClaseEstadoCita(cita.CiEstadoCita)">@TextoEstadoCita(cita.CiEstadoCita)</span></td>
                                <td class="text-end">
                                    <button class="btn btn-info btn-sm" @onclick="() => VerDetalleCita(cita)">Ver</button>
                                    @if (PuedeEditar(cita) && Permisos.Permite("admision/ordenes"))
                                    {
                                        <button class="btn btn-primary btn-sm" title="Mandar a Recepción de Órdenes" @onclick="() => EnviarARecepcionOrdenes(cita)"><i class="bi bi-clipboard2-pulse"></i> Orden</button>
                                    }
                                    @if (PuedeEditar(cita) && cita.CiEstadoCita != "X")
                                    {
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => AbrirReagendar(cita)">Reagendar</button>
                                        @if (cita.CiEstadoCita != "C")
                                        {
                                            <button class="btn btn-success btn-sm" title="Confirmar asistencia" @onclick='() => CambiarEstadoCitaAsync(cita.CiId, "C")'>Confirmar</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-warning btn-sm" title="Marcar como por confirmar" @onclick='() => CambiarEstadoCitaAsync(cita.CiId, "N")'>Por confirmar</button>
                                        }
                                        <button class="btn btn-danger btn-sm" title="Cancelar cita" @onclick="() => AbrirCancelar(cita)">Cancelar</button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (_citas.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-5">No hay citas programadas para esta fecha.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (_vistaAgenda == "historial")
    {
        <section class="scheduled-table-card">
            <header><div><small>CONSULTA MULTIFECHA</small><h5>Historial de citas</h5></div></header>
            <div class="p-3 row g-2">
                <div class="col-md-2"><label>Desde</label><InputDate class="form-control" @bind-Value="_historialDesde" @bind-Value:after="CargarHistorialAsync" /></div>
                <div class="col-md-2"><label>Hasta</label><InputDate class="form-control" @bind-Value="_historialHasta" @bind-Value:after="CargarHistorialAsync" /></div>
                <div class="col-md-3"><label>Médico</label><select class="form-select" @bind="_historialMedico" @bind:after="CargarHistorialAsync"><option value="0">Todos</option>@foreach(var m in _medicos){<option value="@m.Id">@m.Descripcion</option>}</select></div>
                <div class="col-md-3"><label>Paciente / propietario / NHCL</label><input class="form-control" autocomplete="off" placeholder="Escriba para filtrar..." @bind="_historialTexto" @bind:event="oninput" /></div>
                <div class="col-md-2 align-self-end"><button class="btn btn-primary w-100" @onclick="CargarHistorialAsync">Consultar</button></div>
            </div>
            <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Fecha/hora</th><th>Paciente</th><th>Propietario</th><th>Médico</th><th>Estado</th><th>Motivo cancelación</th><th></th></tr></thead><tbody>
                @foreach (var cita in HistorialFiltrado)
                {
                    <tr>
                        <td>@cita.CiFecha.ToString("dd/MM/yyyy") @cita.CiHora</td>
                        <td>@cita.CiNombreMas <small>#@cita.CiNhcl</small></td>
                        <td>@cita.CiNombre</td>
                        <td>@cita.NombreMedico</td>
                        <td>@TextoEstadoCita(cita.CiEstadoCita)</td>
                        <td>@cita.CiMotivoCancelacion</td>
                        <td>
                            <button class="btn btn-sm btn-info" @onclick="() => VerDetalleCita(cita)">Ver</button>
                            @if (PuedeEditar(cita))
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirReagendar(cita)">Reagendar</button>
                                <button class="btn btn-sm btn-outline-danger" disabled="@(cita.CiEstadoCita == "X")" @onclick="() => AbrirCancelar(cita)">Cancelar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody></table></div>
        </section>
    }

        @if (_mostrarFormularioCita)
    {
        <div class="appointment-drawer-backdrop" @onclick="CerrarFormularioCita"></div>
        <aside class="appointment-drawer">
            <header><div><small>NUEVA CITA</small><h5>Agendar cita médica</h5></div><button @onclick="CerrarFormularioCita">✕</button></header>
            <div class="appointment-form">
                @if (!string.IsNullOrEmpty(_errorFormulario))
                {
                    <div class="alert alert-danger py-2 small mb-3 alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @_errorFormulario
                        <button type="button" class="btn-close py-2" @onclick="() => _errorFormulario = string.Empty"></button>
                    </div>
                }
                @if (EsFechaUHoraPasada)
                {
                    <div class="alert alert-info py-2 small mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history fs-5 text-info"></i>
                        <div>
                            <strong>Atención / Cita extemporánea:</strong>
                            <div class="small">Se registrará en el historial con fecha @_nuevaCita.CiFecha.ToString("dd/MM/yyyy") a las @_nuevaCita.CiHora.</div>
                        </div>
                    </div>
                }
                <EditForm Model="_nuevaCita" OnValidSubmit="GuardarCitaAsync">
                    <DataAnnotationsValidator />
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="mb-0">1. Información del paciente</h6>
                        <button type="button" class="btn btn-outline-primary btn-sm py-1 px-2 fw-semibold d-flex align-items-center gap-1 shadow-sm" style="font-size: 0.8rem;" @onclick="AbrirModalNuevoPaciente">
                            <i class="bi bi-person-plus-fill"></i>
                            <span>Nuevo paciente</span>
                        </button>
                    </div>
                    <label>Paciente existente</label>
                    <select class="form-select" value="@_nuevaCita.CiNhcl" @onchange="AutocompletarPacienteCita"><option value="0">Buscar por NHCL, nombre o propietario...</option>@foreach(var p in _pacientes){<option value="@p.MasNhcl">#@p.MasNhcl — @p.MasNombre (@p.ClienteNombre)</option>}</select>
                    @if (_nuevaCita.CiNhcl > 0)
                    {
                        <div class="drawer-patient"><span class="appointment-photo">@if(!string.IsNullOrEmpty(ObtenerFotoPaciente(_nuevaCita.CiNhcl))){<img src="@ObtenerFotoPaciente(_nuevaCita.CiNhcl)" alt="Foto"/>}else{<b>@Iniciales(_nuevaCita.CiNombreMas)</b>}</span><div><strong>@_nuevaCita.CiNombreMas (#@_nuevaCita.CiNhcl)</strong><small>Propietario: @_nuevaCita.CiNombre</small></div></div>
                    }
                    <h6>2. Detalles de la cita</h6>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label>Médico veterinario *</label>
                            <select class="form-select" value="@_idMedicoFiltro" @onchange="OnMedicoFormChanged">
                                @if (MedicosFormulario.Count == 0)
                                {
                                    <option value="0">-- Sin médicos en esta especialidad --</option>
                                }
                                @foreach(var m in MedicosFormulario)
                                {
                                    <option value="@m.Id">@m.Descripcion</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label>Tipo de consulta *</label>
                            <select id="selectTipoConsultaCita" class="form-select" value="@_nuevaCita.CiTipoConsulta" @onchange="OnTipoConsultaChanged">
                                <option value="1">Consulta General</option>
                                <option value="2">Especialidad</option>
                                <option value="3">Cirugía Programada</option>
                                <option value="4">Control / Revisión</option>
                                <option value="5">Imagen / Ecografía</option>
                            </select>
                            @if (_nuevaCita.CiTipoConsulta == 2)
                            {
                                <div class="mt-2">
                                    <label class="text-primary fw-bold"><i class="bi bi-award-fill me-1"></i>Especialidad *</label>
                                    <select class="form-select border-primary" value="@_nuevaCita.CiEspecialidad" @onchange="OnEspecialidadCitaChanged">
                                        @foreach (var esp in _especialidades)
                                        {
                                            <option value="@esp.Id">[@(string.IsNullOrWhiteSpace(esp.Codigo) ? "GEN" : esp.Codigo)] @esp.Descripcion</option>
                                        }
                                    </select>
                                </div>
                            }
                            <select class="d-none">
                                <option value="1">Consulta General</option>
                                <option value="2">Especialidad</option>
                                <option value="3">Cirugía Programada</option>
                                <option value="4">Control / Revisión</option>
                                <option value="5">Imagen / Ecografía</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label>Fecha *</label>
                            <InputDate class="form-control" @bind-Value="_nuevaCita.CiFecha" @bind-Value:after="OnFechaFormChanged" />
                        </div>
                        <div class="col-md-6">
                            <label>Hora *</label>
                            <div class="input-group">
                                <InputText class="form-control text-center fw-bold" @bind-Value="_nuevaCita.CiHora" placeholder="08:00" />
                                <select class="form-select" style="max-width: 140px;" @onchange="OnHoraSelectChanged">
                                    <option value="">Turnos libres</option>
                                    @foreach (var h in ObtenerHorasLibresParaFormulario())
                                    {
                                        <option value="@h" selected="@(h == _nuevaCita.CiHora)">@h</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6"><label>Propietario *</label><InputText class="form-control" @bind-Value="_nuevaCita.CiNombre" /></div>
                        <div class="col-md-6"><label>Paciente *</label><InputText class="form-control" @bind-Value="_nuevaCita.CiNombreMas" /></div>
                        <div class="col-12"><label>Motivo / Observaciones</label><InputTextArea class="form-control" rows="3" @bind-Value="_nuevaCita.CiObservacion" /></div>
                    </div>
                    <div class="drawer-actions"><button type="button" class="btn btn-secondary" @onclick="CerrarFormularioCita">Cancelar</button><button type="submit" class="btn btn-primary">Guardar cita</button></div>
                </EditForm>
            </div>
        </aside>
    }

    @if (_citaDetalle is not null)
    {
        <div class="appointment-detail-backdrop" @onclick="CerrarDetalleCita"></div>
        <section class="appointment-detail" role="dialog" aria-modal="true" aria-label="Detalle de la cita">
            <header>
                <div>
                    <small>DETALLE DE CITA #@_citaDetalle.CiId</small>
                    <h5>@_citaDetalle.CiNombreMas</h5>
                </div>
                <button type="button" @onclick="CerrarDetalleCita">×</button>
            </header>
            @if (!string.IsNullOrWhiteSpace(_mensajeModal))
            {
                <div class="alert alert-danger mx-3 mt-3 mb-0" role="alert">@_mensajeModal</div>
            }
            <div class="detail-patient">
                <span class="detail-photo">
                    @if(!string.IsNullOrEmpty(ObtenerFotoPaciente(_citaDetalle.CiNhcl)))
                    {
                        <img src="@ObtenerFotoPaciente(_citaDetalle.CiNhcl)" alt="Foto de @_citaDetalle.CiNombreMas"/>
                    }
                    else
                    {
                        <b>@Iniciales(_citaDetalle.CiNombreMas)</b>
                    }
                </span>
                <div>
                    <strong>@_citaDetalle.CiNombreMas @if(_citaDetalle.CiNhcl > 0){<small>(NHCL #@_citaDetalle.CiNhcl)</small>}</strong>
                    <span>Propietario: @_citaDetalle.CiNombre</span>
                </div>
                <em class="@ClaseEstadoCita(_citaDetalle.CiEstadoCita)">@TextoEstadoCita(_citaDetalle.CiEstadoCita)</em>
            </div>
            <div class="detail-grid">
                <div><small>Fecha</small><strong>@_citaDetalle.CiFecha.ToString("dd/MM/yyyy")</strong></div>
                <div><small>Hora</small><strong>@_citaDetalle.CiHora</strong></div>
                <div><small>Médico veterinario</small><strong>@_citaDetalle.NombreMedico</strong></div>
                <div><small>Tipo de consulta</small><strong>@TextoTipoConsultaCita(_citaDetalle)</strong></div>
                <div><small>Teléfono</small><strong>@(string.IsNullOrWhiteSpace(_citaDetalle.CiTelefono) ? "No registrado" : _citaDetalle.CiTelefono)</strong></div>
                <div><small>Correo electrónico</small><strong>@(string.IsNullOrWhiteSpace(_citaDetalle.CiEmail) ? "No registrado" : _citaDetalle.CiEmail)</strong></div>
                <div class="detail-observation"><small>Motivo / Observaciones</small><strong>@(string.IsNullOrWhiteSpace(_citaDetalle.CiObservacion) ? "Sin observaciones" : _citaDetalle.CiObservacion)</strong></div>
            </div>
            <footer>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarDetalleCita">Cerrar</button>
                </div>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    @if (PuedeEditar(_citaDetalle) && _citaDetalle.CiEstadoCita != "X")
                    {
                        <button type="button" class="btn btn-outline-danger" @onclick="() => AbrirCancelarDesdeDetalle(_citaDetalle)">
                            <i class="bi bi-x-circle me-1"></i>Cancelar cita
                        </button>
                        <button type="button" class="btn btn-outline-primary" @onclick="() => AbrirReagendarDesdeDetalle(_citaDetalle)">
                            <i class="bi bi-calendar2-range me-1"></i>Reagendar
                        </button>
                    }
                    @if (PuedeEditar(_citaDetalle) && _citaDetalle.CiEstadoCita != "C" && _citaDetalle.CiEstadoCita != "X")
                    {
                        <button type="button" class="btn btn-success fw-semibold" @onclick="() => ConfirmarCitaDetalleAsync(_citaDetalle.CiId)">
                            <i class="bi bi-check2-circle me-1"></i>Confirmar cita
                        </button>
                    }
                    else if (PuedeEditar(_citaDetalle) && _citaDetalle.CiEstadoCita == "C")
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold">
                            <i class="bi bi-check-circle-fill me-1"></i>Confirmada
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-warning" title="Volver a marcar como por confirmar" @onclick='() => CambiarEstadoCitaAsync(_citaDetalle.CiId, "N")'>
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Por confirmar
                        </button>
                    }
                    @if (PuedeEditar(_citaDetalle) && Permisos.Permite("admision/ordenes"))
                    {
                        <button type="button" class="btn btn-primary fw-bold" @onclick="() => EnviarARecepcionOrdenes(_citaDetalle)" title="Crear Orden de Atención en Recepción con los datos de esta cita">
                            <i class="bi bi-clipboard2-pulse-fill me-1"></i>Recepción / Crear Orden
                        </button>
                    }
                </div>
            </footer>
        </section>
    }

    @if (_citaReagendar is not null)
    {
        <div class="appointment-detail-backdrop" @onclick="() => _citaReagendar = null"></div>
        <section class="appointment-detail" role="dialog" aria-modal="true" aria-label="Reagendar Cita">
            <header>
                <div>
                    <small class="text-primary fw-bold">REAGENDAR CITA</small>
                    <h5 class="mb-0">Reagendar cita #@_citaReagendar.CiId — @_citaReagendar.CiNombreMas</h5>
                </div>
                <button type="button" @onclick="() => _citaReagendar = null">×</button>
            </header>
            @if (!string.IsNullOrWhiteSpace(_mensajeModal))
            {
                <div class="alert alert-danger mx-3 mt-3 mb-0" role="alert">@_mensajeModal</div>
            }
            <div class="detail-grid p-3">
                <div>
                    <label class="small text-muted fw-bold mb-1">Nueva Fecha</label>
                    <InputDate class="form-control" @bind-Value="_reagendaFecha" />
                </div>
                <div>
                    <label class="small text-muted fw-bold mb-1">Nueva Hora</label>
                    <input class="form-control" @bind="_reagendaHora" placeholder="08:00" />
                </div>
                <div class="detail-observation">
                    <label class="small text-muted fw-bold mb-1">Médico Veterinario</label>
                    <select class="form-select" @bind="_reagendaMedico" disabled="@(SessionState.TipoUser == 2)">
                        @foreach (var m in _medicos)
                        {
                            <option value="@m.Id">@m.Descripcion</option>
                        }
                    </select>
                </div>
            </div>
            <footer>
                <button type="button" class="btn btn-secondary" @onclick="() => _citaReagendar = null">Cerrar</button>
                <button type="button" class="btn btn-primary" @onclick="ReagendarAsync">
                    <i class="bi bi-calendar-check me-1"></i>Guardar reagendamiento
                </button>
            </footer>
        </section>
