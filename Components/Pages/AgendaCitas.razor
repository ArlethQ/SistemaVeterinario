    private async Task CambiarSucursalHistorialAsync()
    {
        var sucursal = _sucursalHistorial;
        var medicos = await ObtenerMedicosVisiblesAsync(sucursal);
        if (sucursal != _sucursalHistorial)
            return;

        _medicosHistorial = medicos;
        if (!_medicosHistorial.Any(medico => medico.Id == _historialMedico))
            _historialMedico = 0;

        await CargarHistorialAsync();
    }

    private async Task CargarHistorialAsync()
    {
        var version = ++_versionHistorial;
        _historial = [];
        if (_historialHasta < _historialDesde)
        {
            _mensajeEsError = true;
            _mensaje = "El rango de historial no es válido.";
            return;
        }

        var citas = await AdmisionService.ObtenerCitasPorFechaAsync(_historialDesde, _historialHasta,
            _historialMedico, _sucursalHistorial > 0 ? _sucursalHistorial : null);
        if (version == _versionHistorial)
            _historial = citas;
    }
    private void AbrirReagendar(CitaMedicaDto c){_mensajeModal="";_citaReagendar=c;_reagendaFecha=c.CiFecha;_reagendaHora=c.CiHora;_reagendaMedico=c.CiUsuario;}
    private void AbrirCancelar(CitaMedicaDto c){_mensajeModal="";_citaCancelar=c;_motivoCancelacion="";}
    private async Task ReagendarAsync()
    {
        if (_citaReagendar is null) return;
        _mensajeModal = string.Empty;
        try
        {
            int idUser = SessionState.IdUser > 0 ? SessionState.IdUser : (SessionState.UsuarioActual?.IdUsuario ?? 1);
            int localidad = _citaReagendar.CiLocalidad > 0 ? _citaReagendar.CiLocalidad : _sucursalAgenda;
            var ok = await AdmisionService.ReagendarCitaAsync(_citaReagendar.CiId, _reagendaFecha, _reagendaHora, _reagendaMedico, localidad, idUser);
            if (!ok)
            {
                _mensajeModal = "No se guardó el reagendamiento. El horario puede estar ocupado o la cita ya no esté activa.";
                return;
            }
            _mensajeEsError = false;
            _mensaje = "Cita reagendada y verificada.";

            _fechaAgenda = _reagendaFecha;
            _idMedicoFiltro = _reagendaMedico;
            _medicoAgenda = _reagendaMedico;
            _sucursalAgenda = localidad;
            await ActualizarMedicosAgendaAsync();
            _citaReagendar = null;
            _citaDetalle = null;
            await CargarAgendaAsync();
            await CargarHistorialAsync();
        }
        catch (Exception ex)
        {
            MostrarErrorCita($"No se pudo reagendar la cita: {ex.Message}");
        }
    }
    private async Task CancelarCitaAsync()
    {
        if (_citaCancelar is null) return;
        _mensajeModal = string.Empty;
        if (string.IsNullOrWhiteSpace(_motivoCancelacion))
        {
            _mensajeModal = "Ingrese el motivo de cancelación.";
            return;
        }
        try
        {
            int idCita = _citaCancelar.CiId;
            int idUser = SessionState.IdUser > 0 ? SessionState.IdUser : (SessionState.UsuarioActual?.IdUsuario ?? 1);
            var ok = await AdmisionService.CancelarCitaAsync(idCita, _motivoCancelacion, idUser);
            if (!ok)
            {
                _mensajeModal = "No se pudo cancelar la cita.";
                return;
            }
            _mensajeEsError = false;
            _mensaje = $"Cita #{idCita} cancelada exitosamente.";
            _citaCancelar = null;
            _citaDetalle = null;
            await CargarAgendaAsync();
            await CargarHistorialAsync();
        }
        catch (Exception ex)
        {
            MostrarErrorCita($"Error al cancelar la cita: {ex.Message}");
        }
    }
