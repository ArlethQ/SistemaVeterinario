    @if (_citaCancelar is not null)
    {
        <div class="appointment-detail-backdrop" @onclick="() => _citaCancelar = null"></div>
        <section class="appointment-detail" role="dialog" aria-modal="true" aria-label="Cancelar Cita">
            <header>
                <div>
                    <small class="text-danger fw-bold">CANCELACIÓN DE CITA</small>
                    <h5 class="mb-0">Cancelar cita #@_citaCancelar.CiId</h5>
                </div>
                <button type="button" @onclick="() => _citaCancelar = null">×</button>
            </header>
            @if (!string.IsNullOrWhiteSpace(_mensajeModal))
            {
                <div class="alert alert-danger mx-3 mt-3 mb-0" role="alert">@_mensajeModal</div>
            }
            <div class="p-3">
                <div class="alert alert-warning py-2 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    Está a punto de cancelar la cita de <strong>@_citaCancelar.CiNombreMas</strong> (@_citaCancelar.CiNombre) programada para el <strong>@_citaCancelar.CiFecha.ToString("dd/MM/yyyy") a las @_citaCancelar.CiHora</strong>.
                </div>
                <label class="form-label small fw-bold mb-1">Motivo de cancelación *</label>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small" @onclick='() => _motivoCancelacion = "Cancelado por el tutor / cliente"'>
                        Cancelado por el cliente
                    </button>
                    <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small" @onclick='() => _motivoCancelacion = "Imposibilidad de asistir del paciente"'>
                        No puede asistir
                    </button>
                    <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small" @onclick='() => _motivoCancelacion = "Reprogramación de turno"'>
                        Reprogramación
                    </button>
                    <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small" @onclick='() => _motivoCancelacion = "Cita duplicada o registrada por error"'>
                        Duplicada / Error
                    </button>
                </div>
                <textarea class="form-control" rows="3" placeholder="Escriba o seleccione un motivo..." @bind="_motivoCancelacion" @bind:event="oninput"></textarea>
            </div>
            <footer>
                <button type="button" class="btn btn-secondary" @onclick="() => _citaCancelar = null">Volver</button>
                <button type="button" class="btn btn-danger" disabled="@string.IsNullOrWhiteSpace(_motivoCancelacion)" @onclick="CancelarCitaAsync">
                    <i class="bi bi-x-circle-fill me-1"></i>Confirmar cancelación
                </button>
            </footer>
        </section>
    }

    @if (_mostrarModalNuevoPaciente)
    {
        <ModalNuevoPacienteCita OnPacienteCreado="OnPacienteCreadoDesdeModal" OnCerrar="CerrarModalNuevoPaciente" />
    }

    <div class="row g-3 d-none">
        <!-- Columna Izquierda: Grilla de Slots Horarios del Médico (08:00 a 17:30) -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-0">Médico Veterinario</label>
                            <select class="form-select form-select-sm" value="@_idMedicoFiltro" @onchange="CambiarMedicoAsync">
                                @foreach (var m in _medicos)
                                {
                                    <option value="@m.Id">@m.Descripcion</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-0">Fecha de Agenda</label>
                            <input type="date" class="form-control form-control-sm"
                                   value="@_fechaAgenda.ToString("yyyy-MM-dd")"
                                   @onchange="CambiarFechaAsync" />
                        </div>
                    </div>
                </div>
                <div class="card-body p-2">
                    <div class="d-flex justify-content-between align-items-center px-2 mb-2 small text-muted">
                        <span>Seleccione un bloque libre para agendar:</span>
                        <span><span class="badge bg-success">Libre</span> <span class="badge bg-primary">Ocupado</span> <span class="badge bg-secondary">Receso</span></span>
                    </div>

                    <div class="list-group" style="max-height: 460px; overflow-y: auto;">
                        @foreach (var slot in _slots)
                        {
                            string bgClass = slot.Bloqueado ? "list-group-item-secondary" : (slot.Disponible ? "list-group-item-action" : "list-group-item-primary");
                            <div class="list-group-item @bgClass py-2 px-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge @(slot.Bloqueado ? "bg-secondary" : (slot.Disponible ? "bg-success" : "bg-primary")) me-2">
                                        @slot.Hora
                                    </span>
                                    <span class="small fw-semibold">@slot.MotivoEstado</span>
                                </div>
                                @if (slot.Disponible)
                                {
                                    <button class="btn btn-xs btn-outline-success py-0 px-2" @onclick="() => SeleccionarHoraLibre(slot.Hora)">
                                        <i class="bi bi-plus-lg"></i> Asignar
                                    </button>
                                }
                                else if (slot.CitaExistente != null)
                                {
                                    <span class="badge bg-dark">NHCL #@slot.CitaExistente.CiNhcl</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Formulario de Reserva + Listado de Citas -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-info text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-calendar-plus me-1"></i>Reservar Turno Médico</span>
                    <span class="badge bg-dark">Hora Seleccionada: @_nuevaCita.CiHora</span>
                </div>
                <div class="card-body">
                    <EditForm Model="_nuevaCita" OnValidSubmit="GuardarCitaAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-2">
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Autocompletar desde Paciente Existente</label>
                                <select class="form-select form-select-sm" @onchange="AutocompletarPacienteCita">
                                    <option value="0">-- Seleccionar NHCL existente (Opcional) --</option>
                                    @foreach (var p in _pacientes)
                                    {
                                        <option value="@p.MasNhcl">#@p.MasNhcl — @p.MasNombre (@p.ClienteNombre)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Tipo de Consulta</label>
                                <select class="form-select form-select-sm" @bind="_nuevaCita.CiTipoConsulta">
                                    <option value="1">1 — Consulta General</option>
                                    <option value="2">2 — Especialidad</option>
                                    <option value="3">3 — Cirugía Programada</option>
                                    <option value="4">4 — Control / Revisión</option>
                                    <option value="5">5 — Estudio de Imagen / Eco</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">Hora Cita *</label>
                                <InputText class="form-control form-control-sm fw-bold text-center" @bind-Value="_nuevaCita.CiHora" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nombre del Propietario *</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_nuevaCita.CiNombre" />
                                <ValidationMessage For="() => _nuevaCita.CiNombre" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nombre de la Mascota *</label>
                                <InputText class="form-control form-control-sm text-uppercase" @bind-Value="_nuevaCita.CiNombreMas" />
                                <ValidationMessage For="() => _nuevaCita.CiNombreMas" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Teléfono Contacto</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_nuevaCita.CiTelefono" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Correo Electrónico</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_nuevaCita.CiEmail" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">Origen</label>
                                <select class="form-select form-select-sm" @bind="_nuevaCita.CiTipo">
                                    <option value="M">Doméstico</option>
                                    <option value="T">Silvestre</option>
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Motivo de la Cita / Observaciones</label>
                                <InputText class="form-control form-control-sm" placeholder="Ej: Vacunación anual, control post-operatorio, ecografía abdominal..." @bind-Value="_nuevaCita.CiObservacion" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-info text-white btn-sm fw-bold">
                                <i class="bi bi-calendar-check me-1"></i>Confirmar y Registrar Cita
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>

            <!-- Tabla de Citas Programadas -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-card-checklist me-1"></i>Citas Programadas (@_citas.Count)</span>
                    <span class="badge bg-info text-dark">@_fechaAgenda.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Hora</th>
                                    <th>Mascota (NHCL)</th>
                                    <th>Propietario / Tel.</th>
                                    <th>Médico</th>
                                    <th>Motivo</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in _citas)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@c.CiHora</td>
                                        <td>
                                            <strong>@c.CiNombreMas</strong>
                                            @if (c.CiNhcl > 0)
                                            {
                                                <span class="text-muted">(#@c.CiNhcl)</span>
                                            }
                                        </td>
                                        <td>
                                            <div>@c.CiNombre</div>
                                            <small class="text-muted">@c.CiTelefono</small>
                                        </td>
                                        <td>@c.NombreMedico</td>
                                        <td>@c.CiObservacion</td>
                                        <td>
                                            @if (c.CiEstadoCita == "C")
                                            {
                                                <span class="badge bg-success">Confirmada</span>
                                            }
                                            else if (c.CiEstadoCita == "A")
                                            {
                                                <span class="badge bg-primary">Atendida</span>
                                            }
                                            else if (c.CiEstadoCita == "X")
                                            {
                                                <span class="badge bg-danger">Cancelada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Agendada</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (PuedeEditar(c))
                                            {
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-success py-0 px-2" title="Confirmar Asistencia"
                                                            @onclick='() => CambiarEstadoCitaAsync(c.CiId, "C")'>
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger py-0 px-2" title="Cancelar Cita"
                                                            @onclick='() => CambiarEstadoCitaAsync(c.CiId, "X")'>
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);

    private List<CatalogoItemGenericoDto> _medicos = new();
    private List<CatalogoItemGenericoDto> _especialidades = new();
    private List<PacienteMascotaDto> _pacientes = new();
    private List<SlotHorarioMedicoDto> _slots = new();
    private Dictionary<int, List<SlotHorarioMedicoDto>> _slotsPorMedico = new();
    private List<CitaMedicaDto> _citas = new();

    private CitaMedicaDto _nuevaCita = new();
    private int _idMedicoFiltro = 1;
    private DateTime _fechaAgenda = DateTime.Today;
    private bool _cargandoInicial = true;
    private string _mensaje = string.Empty;
    private string _mensajeModal = string.Empty;
    private bool _mensajeEsError;
    private bool _mostrarFormularioCita;
    private bool _mostrarModalNuevoPaciente;
    private CitaMedicaDto? _citaDetalle;
    private CitaMedicaDto? _citaReagendar, _citaCancelar;
    private List<CitaMedicaDto> _historial = new();
    private DateTime _historialDesde = DateTime.Today.AddMonths(-1), _historialHasta = DateTime.Today;
    private int _historialMedico;
    private string _historialTexto = "", _reagendaHora = "08:00", _motivoCancelacion = "";
    private DateTime _reagendaFecha = DateTime.Today;
    private int _reagendaMedico;
    private string _vistaAgenda = "agenda";
    private IEnumerable<CitaMedicaDto> HistorialFiltrado => _historial.Where(c => _historialMedico == 0 || c.CiUsuario == _historialMedico).Where(c => string.IsNullOrWhiteSpace(_historialTexto) || c.CiNombre.Contains(_historialTexto, StringComparison.OrdinalIgnoreCase) || c.CiNombreMas.Contains(_historialTexto, StringComparison.OrdinalIgnoreCase) || c.CiNhcl.ToString().Contains(_historialTexto));
    private bool PuedeEditar(CitaMedicaDto cita) => SessionState.TipoUser != 2 || cita.CiUsuario == SessionState.IdUser;
    private int CitasConfirmadas => _citas.Count(c => c.CiEstadoCita == "C");
    private int CitasCanceladas => _citas.Count(c => c.CiEstadoCita == "X");
    private int CitasPendientes => _citas.Count(c => c.CiEstadoCita is not ("C" or "X" or "A"));
    private List<CatalogoItemGenericoDto> MedicosAgenda => _medicos.ToList();
    private static readonly string[] HorasAgenda = Enumerable.Range(16, 20).Select(i => $"{i / 2:D2}:{(i % 2) * 30:D2}").ToArray();

    private int Porcentaje(int cantidad) => _citas.Count == 0 ? 0 : (int)Math.Round(cantidad * 100d / _citas.Count);
    private CitaMedicaDto? ObtenerCita(int medicoId, string hora) => _citas.FirstOrDefault(c => c.CiUsuario == medicoId && c.CiHora == hora && c.CiEstado != "I");
    private SlotHorarioMedicoDto? ObtenerSlot(int medicoId, string hora) => _slotsPorMedico.GetValueOrDefault(medicoId)?.FirstOrDefault(s => s.Hora == hora);
    private static string Iniciales(string texto)
    {
        var partes = (texto ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(partes.Take(2).Select(p => p[0])).ToUpperInvariant();
    }
    private static string ClaseEstadoCita(string estado) => estado switch { "C" => "confirmed", "X" => "cancelled", "A" => "waiting", _ => "pending" };
    private static string TextoEstadoCita(string estado) => estado switch { "C" => "Confirmada", "X" => "Cancelada", "A" => "Atendida", _ => "Por confirmar" };
    private static string TextoTipoConsulta(int tipo) => tipo switch { 2 => "Especialidad", 3 => "Cirugía programada", 4 => "Control / Revisión", 5 => "Imagen / Ecografía", _ => "Consulta general" };

    private static string TextoTipoConsultaCita(CitaMedicaDto cita)
    {
        if (cita.CiTipoConsulta == 2 && !string.IsNullOrWhiteSpace(cita.Especialidad))
        {
            string cod = !string.IsNullOrWhiteSpace(cita.CodigoEspecialidad) ? $"[{cita.CodigoEspecialidad}] " : "";
            return $"Especialidad · {cod}{cita.Especialidad}";
        }
        return TextoTipoConsulta(cita.CiTipoConsulta);
    }

    private List<CatalogoItemGenericoDto> MedicosFormulario =>
        _nuevaCita.CiTipoConsulta == 2 && _nuevaCita.CiEspecialidad > 0
            ? _medicos.Where(m => m.IdPadre == _nuevaCita.CiEspecialidad).ToList()
            : _medicos;

    private void OnTipoConsultaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int tipo))
        {
            _nuevaCita.CiTipoConsulta = tipo;
            if (tipo == 2)
            {
                if (_nuevaCita.CiEspecialidad <= 0)
                {
                    var med = _medicos.FirstOrDefault(m => m.Id == _idMedicoFiltro);
                    _nuevaCita.CiEspecialidad = med?.IdPadre.GetValueOrDefault() > 0
                        ? med!.IdPadre!.Value
                        : (_especialidades.FirstOrDefault()?.Id ?? 1);
                }
                if (MedicosFormulario.All(m => m.Id != _idMedicoFiltro))
                {
                    _idMedicoFiltro = MedicosFormulario.FirstOrDefault()?.Id ?? 0;
                    _nuevaCita.CiUsuario = _idMedicoFiltro;
                }
            }
            else
            {
                if (_idMedicoFiltro <= 0)
                {
                    _idMedicoFiltro = _medicos.FirstOrDefault()?.Id ?? 1;
                    _nuevaCita.CiUsuario = _idMedicoFiltro;
                }
                _nuevaCita.CiEspecialidad = ResolverEspecialidadPorTipo(tipo, _idMedicoFiltro);
            }
        }
    }

    private void OnEspecialidadCitaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idEsp))
        {
            _nuevaCita.CiEspecialidad = idEsp;
            _idMedicoFiltro = MedicosFormulario.FirstOrDefault()?.Id ?? 0;
            _nuevaCita.CiUsuario = _idMedicoFiltro;
            _errorFormulario = string.Empty;
            if (_idMedicoFiltro > 0)
            {
                var libre = ObtenerHorasLibresParaFormulario().FirstOrDefault();
                if (!string.IsNullOrEmpty(libre))
                {
                    _nuevaCita.CiHora = libre;
                }
            }
        }
    }

    private int ResolverEspecialidadPorTipo(int tipoConsulta, int idMedico)
    {
        if (tipoConsulta == 1 || tipoConsulta == 4)
        {
            var medGen = _especialidades.FirstOrDefault(x =>
                string.Equals(x.Codigo, "MG", StringComparison.OrdinalIgnoreCase) ||
                x.Descripcion.Contains("MEDICINA GENERAL", StringComparison.OrdinalIgnoreCase));
            if (medGen != null) return medGen.Id;
        }
        else if (tipoConsulta == 3)
        {
            var cir = _especialidades.FirstOrDefault(x =>
                string.Equals(x.Codigo, "CIR", StringComparison.OrdinalIgnoreCase) ||
                x.Descripcion.Contains("CIRUGIA", StringComparison.OrdinalIgnoreCase));
            if (cir != null) return cir.Id;
        }

        var med = _medicos.FirstOrDefault(m => m.Id == idMedico);
        if (med?.IdPadre.GetValueOrDefault() > 0)
            return med.IdPadre!.Value;

        return _especialidades.FirstOrDefault()?.Id ?? 1;
    }

    private int ResolverEspecialidadCita(CitaMedicaDto cita)
    {
        if (cita.CiTipoConsulta == 2 && cita.CiEspecialidad > 0)
            return cita.CiEspecialidad;
        if (cita.CiEspecialidad > 0)
            return cita.CiEspecialidad;
        return ResolverEspecialidadPorTipo(cita.CiTipoConsulta, cita.CiUsuario);
    }

    private string ObtenerFotoPaciente(int nhcl)
    {
        if (nhcl <= 0) return string.Empty;
        string directorio = Path.Combine(Env.WebRootPath, "PacientesFotos");
        if (!Directory.Exists(directorio)) return string.Empty;
        string? archivo = Directory.EnumerateFiles(directorio, $"{nhcl}.*").FirstOrDefault();
        return archivo is null ? string.Empty : $"/pacientes-fotos/{nhcl}?v={File.GetLastWriteTimeUtc(archivo).Ticks}";
    }

        private string _errorFormulario = string.Empty;

    private bool EsFechaUHoraPasada
    {
        get
        {
            var fecha = _nuevaCita.CiFecha == default ? _fechaAgenda : _nuevaCita.CiFecha;
            if (fecha.Date < DateTime.Today) return true;
            if (fecha.Date == DateTime.Today && TimeSpan.TryParse(_nuevaCita.CiHora, out var t))
            {
                return t < DateTime.Now.TimeOfDay;
            }
            return false;
        }
    }

    private IEnumerable<string> ObtenerHorasLibresParaFormulario()
    {
        var fecha = _nuevaCita.CiFecha == default ? _fechaAgenda : _nuevaCita.CiFecha;
        var ocupadas = _citas
            .Where(c => c.CiUsuario == _idMedicoFiltro && c.CiFecha.Date == fecha.Date && c.CiEstado != "I" && c.CiEstadoCita != "X")
            .Select(c => (c.CiHora ?? "").Trim().PadLeft(5, '0').Substring(0, Math.Min(5, (c.CiHora ?? "").Trim().PadLeft(5, '0').Length)))
            .ToHashSet();

        foreach (var h in HorasAgenda)
        {
            if (!ocupadas.Contains(h))
            {
                yield return h;
            }
        }
    }

