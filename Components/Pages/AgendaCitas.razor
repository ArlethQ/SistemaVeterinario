@page "/admision/citas"
@using HosvetKardex.Web.Models
@using HosvetKardex.Web.Services
@inject IAdmisionFacturacionService AdmisionService
@inject IReportExportService ReportService
@inject SessionStateService SessionState
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject NavigationManager NavManager

<PageTitle>e-ForVets — Agenda Médica y Calendarización de Citas</PageTitle>

<div class="container-fluid py-3 agenda-page">
    <!-- Encabezado -->
    <div class="agenda-hero d-flex flex-wrap justify-content-between align-items-center mb-3 p-3 bg-white">
        <div class="d-flex align-items-center gap-3">
            <div class="agenda-hero-icon">▦</div><div>
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-calendar2-week-fill me-2"></i>Agenda Médica
            </h4>
            <small class="text-muted">
                Programación de turnos por especialista, disponibilidad horaria y confirmación de citas.
            </small>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center agenda-toolbar">
            <div>
                <label for="agenda-sucursal" class="form-label small mb-0">Sucursal</label>
                <select id="agenda-sucursal" class="form-select form-select-sm" @bind="_sucursalAgenda" @bind:after="CambiarSucursalAsync">
                    @if (_sucursales.Count == 0)
                    {
                        <option value="0">Sin sucursales asignadas</option>
                    }
                    else
                    {
                        <option value="0">Todas las sucursales</option>
                    }
                    @foreach (var sucursal in _sucursales)
                    {
                        <option value="@sucursal.Id">@sucursal.Descripcion</option>
                    }
                </select>
            </div>
            <div>
                <label for="agenda-medico" class="form-label small mb-0">Médico</label>
                <select id="agenda-medico" class="form-select form-select-sm" value="@_medicoAgenda"
                        disabled="@(!_puedeVerAgendaCompleta || _cargandoInicial)" @onchange="CambiarMedicoAsync">
                    <option value="0">Seleccionar médico</option>
                    @foreach (var medico in _medicosAgenda)
                    {
                        <option value="@medico.Id">@medico.Descripcion</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary btn-sm" disabled="@(_sucursalAgenda <= 0 || _medicoAgenda <= 0 || _cargandoInicial)" @onclick="AbrirFormularioCita">+ Agendar cita</button>
            @if (_puedeVerAgendaCompleta && Permisos.Permite("programacion/clinica"))
            {
                <a class="btn btn-outline-primary btn-sm" href="@($"/programacion/clinica?medico={_medicoAgenda}")">Registrar turnos</a>
            }
            <button class="btn btn-outline-danger btn-sm" @onclick="ExportarPdfAgendaAsync">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>Exportar Agenda PDF
            </button>
            @if (Permisos.Permite("admision/ordenes"))
            {
                <a href="/admision/ordenes" class="btn btn-success btn-sm">
                    <i class="bi bi-clipboard2-pulse me-1"></i>Recepción / Órdenes
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensaje))
    {
        <div class="alert @(_mensajeEsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2" role="alert">
            <i class="bi @(_mensajeEsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@_mensaje
            <button type="button" class="btn-close" @onclick="() => _mensaje = string.Empty"></button>
        </div>
    }

    @if (_cargandoInicial)
    {
        <LoadingState Title="Cargando agenda médica"
                      Message="Preparando citas, especialistas y turnos disponibles." />
    }

    <div class="row g-3 mb-3 agenda-kpis">
        <div class="col-6 col-xl-3"><div class="agenda-kpi blue"><span>AGE</span><div><strong>@_citas.Count</strong><small>Citas programadas</small><em>Para este día</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="agenda-kpi green"><span>CON</span><div><strong>@CitasConfirmadas</strong><small>Confirmadas</small><em>@Porcentaje(CitasConfirmadas)% del total</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="agenda-kpi amber"><span>PEN</span><div><strong>@CitasPendientes</strong><small>Por confirmar</small><em>@Porcentaje(CitasPendientes)% del total</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="agenda-kpi red"><span>CAN</span><div><strong>@CitasCanceladas</strong><small>Canceladas</small><em>@Porcentaje(CitasCanceladas)% del total</em></div></div></div>
    </div>

    <nav class="agenda-tabs mb-3">
        <button class="@(_vistaAgenda == "agenda" ? "active" : "")" @onclick='() => _vistaAgenda = "agenda"'>Agenda semanal</button>
        <button class="@(_vistaAgenda == "tabla" ? "active" : "")" @onclick='() => _vistaAgenda = "tabla"'>Citas programadas <span>@_citas.Count</span></button>
        <button class="@(_vistaAgenda == "historial" ? "active" : "")" @onclick="AbrirHistorialAsync">Historial y filtros</button>
    </nav>

    @if (_vistaAgenda == "agenda" && !_cargandoInicial)
    {
        @if (_sucursales.Count == 0)
        {
            <p class="alert alert-light border">No tienes una sucursal activa asignada para consultar turnos.</p>
        }
        else if (_sucursalAgenda <= 0)
        {
            <p class="alert alert-light border mb-2">Elige una sucursal para ver turnos libres y agendar.</p>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <label for="agenda-fecha-todas" class="form-label mb-0">Fecha</label>
                <input id="agenda-fecha-todas" type="date" class="form-control form-control-sm w-auto"
                       value="@_fechaAgenda.ToString("yyyy-MM-dd")" @onchange="CambiarFechaAsync" />
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick='() => _vistaAgenda = "tabla"'>
                    Ver citas del día (@_citas.Count)
                </button>
            </div>
        }
        else if (_medicosAgenda.Count == 0)
        {
            <p class="alert alert-light border">No hay médicos asignados a esta sucursal.</p>
        }
        else if (_medicoAgenda <= 0)
        {
            <p class="alert alert-light border">Selecciona un médico para consultar su disponibilidad.</p>
        }
        else
        {
            <div class="row g-3 agenda-workspace">
                <div class="col-12">
                    <section class="day-list-card agenda-panel-horas">
                        <header class="agenda-panel-cabecera d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div>
                                <h6 class="mb-1">Agenda semanal</h6>
                                <div class="text-muted small">@InicioSemana(_fechaAgenda).ToString("dd MMM", CulturaAgenda) – @InicioSemana(_fechaAgenda).AddDays(6).ToString("dd MMM yyyy", CulturaAgenda)</div>
                            </div>
                            @if (_slots.Any(slot => !slot.Bloqueado))
                            {
                                <span class="text-muted small">
                                    @_fechaAgenda.ToString("dd/MM") · @(_slots.Count(slot => !slot.Bloqueado && slot.CitaExistente != null))
                                    de @(_slots.Count(slot => !slot.Bloqueado)) turnos reservados
                                </span>
                            }
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary" aria-label="Semana anterior"
                                        @onclick="() => SeleccionarFechaAsync(_fechaAgenda.AddDays(-7))">‹</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="IrHoy">Hoy</button>
                                <button type="button" class="btn btn-outline-secondary" aria-label="Semana siguiente"
                                        @onclick="() => SeleccionarFechaAsync(_fechaAgenda.AddDays(7))">›</button>
                            </div>
                            <div class="agenda-selector-fecha" @onkeydown="CerrarSelectorFechaConTecla">
                                <button type="button" class="btn btn-outline-primary btn-sm"
                                        aria-expanded="@_mostrarSelectorFecha" aria-controls="agenda-selector-fecha"
                                        @onclick="() => _mostrarSelectorFecha = !_mostrarSelectorFecha">
                                    <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>Ir a fecha
                                </button>
                                @if (_mostrarSelectorFecha)
                                {
                                    <section id="agenda-selector-fecha" class="calendar-card agenda-calendario agenda-selector-panel">
                                        <div class="agenda-panel-cabecera d-flex flex-wrap gap-2 align-items-center justify-content-between">
                                            <h6 class="text-capitalize mb-0">@_fechaAgenda.ToString("MMMM yyyy", CulturaAgenda)</h6>
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                            <label class="visually-hidden" for="agenda-fecha">Ir a fecha</label>
                                            <input id="agenda-fecha" type="date" class="form-control form-control-sm w-auto"
                                                   value="@_fechaAgenda.ToString("yyyy-MM-dd")" @onchange="ElegirFechaCalendarioAsync" />
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-secondary" aria-label="Mes anterior" @onclick="() => CambiarMesAsync(-1)">‹</button>
                                                <button type="button" class="btn btn-outline-secondary" @onclick="() => ElegirFechaCalendarioAsync(AhoraClinica.Date)">Hoy</button>
                                                <button type="button" class="btn btn-outline-secondary" aria-label="Mes siguiente" @onclick="() => CambiarMesAsync(1)">›</button>
                                            </div>
                                            </div>
                                        </div>
                                        <div class="agenda-mes">
                                            @foreach (var dia in DiasSemana)
                                            {
                                                <strong class="agenda-dia-semana">@dia</strong>
                                            }
                                            @for (var espacio = 0; espacio < DesfaseMes; espacio++)
                                            {
                                                <span class="agenda-dia-vacio" aria-hidden="true"></span>
                                            }
                                            @foreach (var fecha in FechasMes)
                                            {
                                                var libres = ObtenerHorasLibres(fecha).Count();
                                                var citas = _citasMes[fecha].Count(cita => cita.CiEstado != "I" && cita.CiEstadoCita != "X");
                                                var turnos = _slotsMes.GetValueOrDefault(fecha) ?? [];
                                                var total = turnos.Count(slot => !slot.Bloqueado);
                                                var reservados = turnos.Count(slot => !slot.Bloqueado && slot.CitaExistente != null);
                                                <button type="button" class="agenda-dia @(libres > 0 ? "agenda-dia-libre" : "")"
                                                        aria-pressed="@(fecha == _fechaAgenda.Date)"
                                                        aria-label="@fecha.ToString("D", CulturaAgenda), @citas citas, @libres horas libres"
                                                        @onclick="() => ElegirFechaCalendarioAsync(fecha)">
                                                    <strong>@fecha.Day</strong>
                                                    @if (citas > 0)
                                                    {
                                                        <small class="agenda-dia-citas">@citas citas</small>
                                                    }
                                                    @if (libres > 0)
                                                    {
                                                        <small><i class="bi bi-circle-fill" aria-hidden="true"></i> @libres libres</small>
                                                    }
                                                    @if (total > 0 && reservados > 0)
                                                    {
                                                        <progress class="agenda-dia-ocupacion" value="@reservados" max="@total"
                                                                  aria-label="@reservados de @total turnos reservados"></progress>
                                                    }
                                                </button>
                                            }
                                        </div>
                                        <div class="agenda-leyenda">
                                            <span><i class="bi bi-circle-fill text-success" aria-hidden="true"></i> Con disponibilidad</span>
                                            <span><i class="bi bi-circle text-secondary" aria-hidden="true"></i> Sin turnos libres</span>
                                        </div>
                                    </section>
                                }
                            </div>
                        </header>
                        @{
                            var semana = ObtenerSemanaAgenda();
                            var horas = semana.SelectMany(dia => dia.Citas.Select(grupo => grupo.Key)
                                .Concat((_slotsMes.GetValueOrDefault(dia.Fecha) ?? []).Select(slot => slot.Hora)))
                                .Distinct(StringComparer.Ordinal).OrderBy(hora => hora, StringComparer.Ordinal);
                        }
                        <div class="agenda-semana-scroll">
                            <div class="agenda-semana">
                                <div class="agenda-semana-cabecera agenda-columna-hora">Hora</div>
                                @foreach (var dia in semana)
                                {
                                    <button type="button" class="agenda-semana-cabecera agenda-semana-dia"
                                            aria-pressed="@(dia.Fecha == _fechaAgenda.Date)"
                                            @onclick="() => SeleccionarFechaAsync(dia.Fecha)">
                                        <span>@dia.Fecha.ToString("ddd", CulturaAgenda)</span>
                                        <strong>@dia.Fecha.Day</strong>
                                    </button>
                                }
                                @foreach (var hora in horas)
                                {
                                    <time class="agenda-columna-hora agenda-semana-hora">@hora</time>
                                    @foreach (var dia in semana)
                                    {
                                        <div class="agenda-semana-celda @(dia.Fecha == _fechaAgenda.Date ? "agenda-semana-seleccion" : "")">
                                            @foreach (var cita in dia.Citas[hora])
                                            {
                                                <button type="button" class="agenda-evento @ClaseEstadoCita(cita.CiEstadoCita)"
                                                        @key="cita.CiId" @onclick="() => VerDetalleCita(cita)">
                                                    <strong>@cita.CiNombreMas</strong>
                                                    <span>@TextoTipoConsultaCita(cita)</span>
                                                    @if (!string.IsNullOrWhiteSpace(cita.CiObservacion))
                                                    {
                                                        <small>@cita.CiObservacion</small>
                                                    }
                                                    <small>@TextoEstadoCita(cita.CiEstadoCita)</small>
                                                </button>
                                            }
                                            @if (dia.Libres.Contains(hora))
                                            {
                                                <button type="button" class="agenda-semana-libre"
                                                        aria-label="Agendar el @dia.Fecha.ToString("D", CulturaAgenda) a las @hora"
                                                        title="Agendar a las @hora"
                                                        @onclick="() => AbrirDesdeCasilla(dia.Fecha, hora)">
                                                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        @if (!horas.Any())
                        {
                            <p class="text-muted small p-3 mb-0">No hay citas ni turnos libres para esta semana.</p>
                        }
                    </section>
                </div>

            </div>
        }
    }

    @if (_vistaAgenda == "tabla")
    {
        <section class="scheduled-table-card">
            <header><div><small>PROGRAMACIÓN DEL DÍA</small><h5>Citas programadas</h5></div><div><span>@_fechaAgenda.ToString("dd/MM/yyyy")</span><button class="btn btn-primary btn-sm" disabled="@(_sucursalAgenda <= 0 || _medicoAgenda <= 0 || _cargandoInicial)" @onclick="AbrirFormularioCita">+ Agendar cita</button></div></header>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Hora</th><th>Paciente</th><th>Propietario / Contacto</th><th>Médico</th><th>Sucursal</th><th>Tipo / Motivo</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var cita in _citas.OrderBy(c => c.CiHora))
                        {
                            <tr>
                                <td><strong class="scheduled-time">@cita.CiHora</strong></td>
                                <td><div class="scheduled-patient"><span class="appointment-photo">@if(!string.IsNullOrEmpty(ObtenerFotoPaciente(cita.CiNhcl))){<img src="@ObtenerFotoPaciente(cita.CiNhcl)" alt="Foto de @cita.CiNombreMas"/>}else{<b>@Iniciales(cita.CiNombreMas)</b>}</span><div><strong>@cita.CiNombreMas</strong><small>@(cita.CiNhcl > 0 ? $"NHCL #{cita.CiNhcl}" : "Sin NHCL")</small></div></div></td>
                                <td><strong>@cita.CiNombre</strong><small>@cita.CiTelefono</small></td>
                                <td><strong>@cita.NombreMedico</strong><small>@cita.Especialidad</small></td>
                                <td>@NombreSucursal(cita.CiLocalidad)</td>
                                <td><strong>@TextoTipoConsultaCita(cita)</strong><small>@cita.CiObservacion</small></td>
                                <td><span class="table-status @ClaseEstadoCita(cita.CiEstadoCita)">@TextoEstadoCita(cita.CiEstadoCita)</span></td>
                                <td class="text-end">
                                    <button class="btn btn-info btn-sm" @onclick="() => VerDetalleCita(cita)">Ver</button>
                                    @if (PuedeEditar(cita) && Permisos.Permite("admision/ordenes"))
                                    {
                                        <button class="btn btn-primary btn-sm" title="Mandar a Recepción de Órdenes" @onclick="() => EnviarARecepcionOrdenes(cita)"><i class="bi bi-clipboard2-pulse"></i> Orden</button>
                                    }
                                    @if (PuedeEditar(cita) && cita.CiEstadoCita != "X")
                                    {
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => AbrirReagendar(cita)">Reagendar</button>
                                        @if (cita.CiEstadoCita != "C")
                                        {
                                            <button class="btn btn-success btn-sm" title="Confirmar asistencia" @onclick='() => CambiarEstadoCitaAsync(cita.CiId, "C")'>Confirmar</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-warning btn-sm" title="Marcar como por confirmar" @onclick='() => CambiarEstadoCitaAsync(cita.CiId, "N")'>Por confirmar</button>
                                        }
                                        <button class="btn btn-danger btn-sm" title="Cancelar cita" @onclick="() => AbrirCancelar(cita)">Cancelar</button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (_citas.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-5">No hay citas programadas para esta fecha.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (_vistaAgenda == "historial")
    {
        <section class="scheduled-table-card">
            <header><div><small>CONSULTA MULTIFECHA</small><h5>Historial de citas</h5></div></header>
            <div class="p-3 row g-2">
                <div class="col-md-2"><label>Desde</label><InputDate class="form-control" @bind-Value="_historialDesde" @bind-Value:after="CargarHistorialAsync" /></div>
                <div class="col-md-2"><label>Hasta</label><InputDate class="form-control" @bind-Value="_historialHasta" @bind-Value:after="CargarHistorialAsync" /></div>
                <div class="col-md-4">
                    <label for="historial-sucursal">Sucursal</label>
                    <select id="historial-sucursal" class="form-select" @bind="_sucursalHistorial" @bind:after="CambiarSucursalHistorialAsync">
                        <option value="0">Todas las sucursales disponibles</option>
                        @foreach (var sucursal in _sucursales)
                        {
                            <option value="@sucursal.Id">@sucursal.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="col-md-4"><label>Médico</label><select class="form-select" @bind="_historialMedico" @bind:after="CargarHistorialAsync"><option value="0">Todos</option>@foreach(var m in _medicosHistorial){<option value="@m.Id">@m.Descripcion</option>}</select></div>
                <div class="col-md-4"><label>Paciente / propietario / NHCL</label><input class="form-control" autocomplete="off" placeholder="Escriba para filtrar..." @bind="_historialTexto" @bind:event="oninput" /></div>
            </div>
            <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Fecha/hora</th><th>Paciente</th><th>Propietario</th><th>Médico</th><th>Sucursal</th><th>Estado</th><th>Motivo cancelación</th><th></th></tr></thead><tbody>
                @foreach (var cita in HistorialFiltrado)
                {
                    <tr>
                        <td>@cita.CiFecha.ToString("dd/MM/yyyy") @cita.CiHora</td>
                        <td>@cita.CiNombreMas <small>#@cita.CiNhcl</small></td>
                        <td>@cita.CiNombre</td>
                        <td>@cita.NombreMedico</td><td>@NombreSucursal(cita.CiLocalidad)</td>
                        <td>@TextoEstadoCita(cita.CiEstadoCita)</td>
                        <td>@cita.CiMotivoCancelacion</td>
                        <td>
                            <button class="btn btn-sm btn-info" @onclick="() => VerDetalleCita(cita)">Ver</button>
                            @if (PuedeEditar(cita))
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirReagendar(cita)">Reagendar</button>
                                <button class="btn btn-sm btn-outline-danger" disabled="@(cita.CiEstadoCita == "X")" @onclick="() => AbrirCancelar(cita)">Cancelar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody></table></div>
        </section>
    }

        @if (_mostrarFormularioCita)
    {
        <div class="appointment-drawer-backdrop" @onclick="CerrarFormularioCita"></div>
        <aside class="appointment-drawer">
            <header><div><small>NUEVA CITA</small><h5>Agendar cita médica</h5></div><button @onclick="CerrarFormularioCita">✕</button></header>
            <div class="appointment-form">
                @if (!string.IsNullOrEmpty(_errorFormulario))
                {
                    <div class="alert alert-danger py-2 small mb-3 alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @_errorFormulario
                        <button type="button" class="btn-close py-2" @onclick="() => _errorFormulario = string.Empty"></button>
                    </div>
                }
                @if (EsFechaUHoraPasada)
                {
                    <div class="alert alert-info py-2 small mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history fs-5 text-info"></i>
                        <div>
                            <strong>Atención / Cita extemporánea:</strong>
                            <div class="small">Se registrará en el historial con fecha @_nuevaCita.CiFecha.ToString("dd/MM/yyyy") a las @_nuevaCita.CiHora.</div>
                        </div>
                    </div>
                }
                <EditForm Model="_nuevaCita" OnValidSubmit="GuardarCitaAsync">
                    <DataAnnotationsValidator />
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h6 class="mb-0">1. Información del paciente</h6>
                        <button type="button" class="btn btn-outline-primary btn-sm py-1 px-2 fw-semibold d-flex align-items-center gap-1 shadow-sm" style="font-size: 0.8rem;" @onclick="AbrirModalNuevoPaciente">
                            <i class="bi bi-person-plus-fill"></i>
                            <span>Nuevo paciente</span>
                        </button>
                    </div>
                    <label>Paciente existente</label>
                    <select class="form-select" value="@_nuevaCita.CiNhcl" @onchange="AutocompletarPacienteCita"><option value="0">Buscar por NHCL, nombre o propietario...</option>@foreach(var p in _pacientes){<option value="@p.MasNhcl">#@p.MasNhcl — @p.MasNombre (@p.ClienteNombre)</option>}</select>
                    @if (_nuevaCita.CiNhcl > 0)
                    {
                        <div class="drawer-patient"><span class="appointment-photo">@if(!string.IsNullOrEmpty(ObtenerFotoPaciente(_nuevaCita.CiNhcl))){<img src="@ObtenerFotoPaciente(_nuevaCita.CiNhcl)" alt="Foto"/>}else{<b>@Iniciales(_nuevaCita.CiNombreMas)</b>}</span><div><strong>@_nuevaCita.CiNombreMas (#@_nuevaCita.CiNhcl)</strong><small>Propietario: @_nuevaCita.CiNombre</small></div></div>
                    }
                    <h6>2. Detalles de la cita</h6>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label>Médico veterinario *</label>
                            <select class="form-select" value="@_idMedicoFiltro" disabled="@(!_puedeVerAgendaCompleta)" @onchange="OnMedicoFormChanged">
                                @if (MedicosFormulario.Count == 0)
                                {
                                    <option value="0">-- Sin médicos en esta especialidad --</option>
                                }
                                @foreach(var m in MedicosFormulario)
                                {
                                    <option value="@m.Id">@m.Descripcion</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label>Tipo de consulta *</label>
                            <select id="selectTipoConsultaCita" class="form-select" value="@_nuevaCita.CiTipoConsulta" @onchange="OnTipoConsultaChanged">
                                <option value="1">Consulta General</option>
                                <option value="2">Especialidad</option>
                                <option value="3">Cirugía Programada</option>
                                <option value="4">Control / Revisión</option>
                                <option value="5">Imagen / Ecografía</option>
                            </select>
                            @if (_nuevaCita.CiTipoConsulta == 2)
                            {
                                <div class="mt-2">
                                    <label class="text-primary fw-bold"><i class="bi bi-award-fill me-1"></i>Especialidad *</label>
                                    <select class="form-select border-primary" value="@_nuevaCita.CiEspecialidad" @onchange="OnEspecialidadCitaChanged">
                                        @foreach (var esp in _especialidades)
                                        {
                                            <option value="@esp.Id">[@(string.IsNullOrWhiteSpace(esp.Codigo) ? "GEN" : esp.Codigo)] @esp.Descripcion</option>
                                        }
                                    </select>
                                </div>
                            }
                            <select class="d-none">
                                <option value="1">Consulta General</option>
                                <option value="2">Especialidad</option>
                                <option value="3">Cirugía Programada</option>
                                <option value="4">Control / Revisión</option>
                                <option value="5">Imagen / Ecografía</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label>Fecha *</label>
                            <InputDate class="form-control" @bind-Value="_nuevaCita.CiFecha" @bind-Value:after="OnFechaFormChanged" />
                        </div>
                        <div class="col-md-6">
                            <label>Hora *</label>
                            <div class="input-group">
                                <InputText class="form-control text-center fw-bold" @bind-Value="_nuevaCita.CiHora" placeholder="08:00" readonly="@(_nuevaCita.CiFecha.Date >= AhoraClinica.Date)" />
                                <select class="form-select" style="max-width: 140px;" value="@_nuevaCita.CiHora" @onchange="OnHoraSelectChanged">
                                    <option value="">Turnos libres</option>
                                    @foreach (var h in ObtenerHorasLibresParaFormulario())
                                    {
                                        <option value="@h">@h</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6"><label>Propietario *</label><InputText class="form-control" @bind-Value="_nuevaCita.CiNombre" /></div>
                        <div class="col-md-6"><label>Paciente *</label><InputText class="form-control" @bind-Value="_nuevaCita.CiNombreMas" /></div>
                        <div class="col-12"><label>Motivo / Observaciones</label><InputTextArea class="form-control" rows="3" @bind-Value="_nuevaCita.CiObservacion" /></div>
                    </div>
                    <div class="drawer-actions"><button type="button" class="btn btn-secondary" @onclick="CerrarFormularioCita">Cancelar</button><button type="submit" class="btn btn-primary">Guardar cita</button></div>
                </EditForm>
            </div>
        </aside>
    }

    @if (_citaDetalle is not null)
    {
        <div class="appointment-detail-backdrop" @onclick="CerrarDetalleCita"></div>
        <section class="appointment-detail" role="dialog" aria-modal="true" aria-label="Detalle de la cita">
            <header>
                <div>
                    <small>DETALLE DE CITA #@_citaDetalle.CiId</small>
                    <h5>@_citaDetalle.CiNombreMas</h5>
                </div>
                <button type="button" @onclick="CerrarDetalleCita">×</button>
            </header>
            @if (!string.IsNullOrWhiteSpace(_mensajeModal))
            {
                <div class="alert alert-danger mx-3 mt-3 mb-0" role="alert">@_mensajeModal</div>
            }
            <div class="detail-patient">
                <span class="detail-photo">
                    @if(!string.IsNullOrEmpty(ObtenerFotoPaciente(_citaDetalle.CiNhcl)))
                    {
                        <img src="@ObtenerFotoPaciente(_citaDetalle.CiNhcl)" alt="Foto de @_citaDetalle.CiNombreMas"/>
                    }
                    else
                    {
                        <b>@Iniciales(_citaDetalle.CiNombreMas)</b>
                    }
                </span>
                <div>
                    <strong>@_citaDetalle.CiNombreMas @if(_citaDetalle.CiNhcl > 0){<small>(NHCL #@_citaDetalle.CiNhcl)</small>}</strong>
                    <span>Propietario: @_citaDetalle.CiNombre</span>
                </div>
                <em class="@ClaseEstadoCita(_citaDetalle.CiEstadoCita)">@TextoEstadoCita(_citaDetalle.CiEstadoCita)</em>
            </div>
            <div class="detail-grid">
                <div><small>Fecha</small><strong>@_citaDetalle.CiFecha.ToString("dd/MM/yyyy")</strong></div>
                <div><small>Sucursal</small><strong>@NombreSucursal(_citaDetalle.CiLocalidad)</strong></div>
                <div><small>Hora</small><strong>@_citaDetalle.CiHora</strong></div>
                <div><small>Médico veterinario</small><strong>@_citaDetalle.NombreMedico</strong></div>
                <div><small>Tipo de consulta</small><strong>@TextoTipoConsultaCita(_citaDetalle)</strong></div>
                <div><small>Teléfono</small><strong>@(string.IsNullOrWhiteSpace(_citaDetalle.CiTelefono) ? "No registrado" : _citaDetalle.CiTelefono)</strong></div>
                <div><small>Correo electrónico</small><strong>@(string.IsNullOrWhiteSpace(_citaDetalle.CiEmail) ? "No registrado" : _citaDetalle.CiEmail)</strong></div>
                <div class="detail-observation"><small>Motivo / Observaciones</small><strong>@(string.IsNullOrWhiteSpace(_citaDetalle.CiObservacion) ? "Sin observaciones" : _citaDetalle.CiObservacion)</strong></div>
            </div>
            <footer>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarDetalleCita">Cerrar</button>
                </div>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    @if (PuedeEditar(_citaDetalle) && _citaDetalle.CiEstadoCita != "X")
                    {
                        <button type="button" class="btn btn-outline-danger" @onclick="() => AbrirCancelarDesdeDetalle(_citaDetalle)">
                            <i class="bi bi-x-circle me-1"></i>Cancelar cita
                        </button>
                        <button type="button" class="btn btn-outline-primary" @onclick="() => AbrirReagendarDesdeDetalle(_citaDetalle)">
                            <i class="bi bi-calendar2-range me-1"></i>Reagendar
                        </button>
                    }
                    @if (PuedeEditar(_citaDetalle) && _citaDetalle.CiEstadoCita != "C" && _citaDetalle.CiEstadoCita != "X")
                    {
                        <button type="button" class="btn btn-success fw-semibold" @onclick="() => ConfirmarCitaDetalleAsync(_citaDetalle.CiId)">
                            <i class="bi bi-check2-circle me-1"></i>Confirmar cita
                        </button>
                    }
                    else if (PuedeEditar(_citaDetalle) && _citaDetalle.CiEstadoCita == "C")
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold">
                            <i class="bi bi-check-circle-fill me-1"></i>Confirmada
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-warning" title="Volver a marcar como por confirmar" @onclick='() => CambiarEstadoCitaAsync(_citaDetalle.CiId, "N")'>
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Por confirmar
                        </button>
                    }
                    @if (PuedeEditar(_citaDetalle) && Permisos.Permite("admision/ordenes"))
                    {
                        <button type="button" class="btn btn-primary fw-bold" @onclick="() => EnviarARecepcionOrdenes(_citaDetalle)" title="Crear Orden de Atención en Recepción con los datos de esta cita">
                            <i class="bi bi-clipboard2-pulse-fill me-1"></i>Recepción / Crear Orden
                        </button>
                    }
                </div>
            </footer>
        </section>
    }

    @if (_citaReagendar is not null)
    {
        <div class="appointment-detail-backdrop" @onclick="() => _citaReagendar = null"></div>
        <section class="appointment-detail" role="dialog" aria-modal="true" aria-label="Reagendar Cita">
            <header>
                <div>
                    <small class="text-primary fw-bold">REAGENDAR CITA</small>
                    <h5 class="mb-0">Reagendar cita #@_citaReagendar.CiId — @_citaReagendar.CiNombreMas</h5>
                </div>
                <button type="button" @onclick="() => _citaReagendar = null">×</button>
            </header>
            @if (!string.IsNullOrWhiteSpace(_mensajeModal))
            {
                <div class="alert alert-danger mx-3 mt-3 mb-0" role="alert">@_mensajeModal</div>
            }
            <div class="detail-grid p-3">
                <div>
                    <label class="small text-muted fw-bold mb-1">Nueva Fecha</label>
                    <InputDate class="form-control" @bind-Value="_reagendaFecha" />
                </div>
                <div>
                    <label class="small text-muted fw-bold mb-1">Nueva Hora</label>
                    <input class="form-control" @bind="_reagendaHora" placeholder="08:00" />
                </div>
                <div class="detail-observation">
                    <label class="small text-muted fw-bold mb-1">Médico Veterinario</label>
                    <select class="form-select" @bind="_reagendaMedico" disabled="@(!_puedeVerAgendaCompleta)">
                        @foreach (var m in _medicos)
                        {
                            <option value="@m.Id">@m.Descripcion</option>
                        }
                    </select>
                </div>
            </div>
            <footer>
                <button type="button" class="btn btn-secondary" @onclick="() => _citaReagendar = null">Cerrar</button>
                <button type="button" class="btn btn-primary" @onclick="ReagendarAsync">
                    <i class="bi bi-calendar-check me-1"></i>Guardar reagendamiento
                </button>
            </footer>
        </section>
    }
    @if (_citaCancelar is not null)
    {
        <div class="appointment-detail-backdrop" @onclick="() => _citaCancelar = null"></div>
        <section class="appointment-detail" role="dialog" aria-modal="true" aria-label="Cancelar Cita">
            <header>
                <div>
                    <small class="text-danger fw-bold">CANCELACIÓN DE CITA</small>
                    <h5 class="mb-0">Cancelar cita #@_citaCancelar.CiId</h5>
                </div>
                <button type="button" @onclick="() => _citaCancelar = null">×</button>
            </header>
            @if (!string.IsNullOrWhiteSpace(_mensajeModal))
            {
                <div class="alert alert-danger mx-3 mt-3 mb-0" role="alert">@_mensajeModal</div>
            }
            <div class="p-3">
                <div class="alert alert-warning py-2 small mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    Está a punto de cancelar la cita de <strong>@_citaCancelar.CiNombreMas</strong> (@_citaCancelar.CiNombre) programada para el <strong>@_citaCancelar.CiFecha.ToString("dd/MM/yyyy") a las @_citaCancelar.CiHora</strong>.
                </div>
                <label class="form-label small fw-bold mb-1">Motivo de cancelación *</label>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small" @onclick='() => _motivoCancelacion = "Cancelado por el tutor / cliente"'>
                        Cancelado por el cliente
                    </button>
                    <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small" @onclick='() => _motivoCancelacion = "Imposibilidad de asistir del paciente"'>
                        No puede asistir
                    </button>
                    <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small" @onclick='() => _motivoCancelacion = "Reprogramación de turno"'>
                        Reprogramación
                    </button>
                    <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2 small" @onclick='() => _motivoCancelacion = "Cita duplicada o registrada por error"'>
                        Duplicada / Error
                    </button>
                </div>
                <textarea class="form-control" rows="3" placeholder="Escriba o seleccione un motivo..." @bind="_motivoCancelacion" @bind:event="oninput"></textarea>
            </div>
            <footer>
                <button type="button" class="btn btn-secondary" @onclick="() => _citaCancelar = null">Volver</button>
                <button type="button" class="btn btn-danger" disabled="@string.IsNullOrWhiteSpace(_motivoCancelacion)" @onclick="CancelarCitaAsync">
                    <i class="bi bi-x-circle-fill me-1"></i>Confirmar cancelación
                </button>
            </footer>
        </section>
    }

    @if (_mostrarModalNuevoPaciente)
    {
        <ModalNuevoPacienteCita OnPacienteCreado="OnPacienteCreadoDesdeModal" OnCerrar="CerrarModalNuevoPaciente" />
    }

    <div class="row g-3 d-none">
        <!-- Columna Izquierda: Grilla de Slots Horarios del Médico (08:00 a 17:30) -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-0">Médico Veterinario</label>
                            <select class="form-select form-select-sm" value="@_idMedicoFiltro" @onchange="CambiarMedicoAsync">
                                @foreach (var m in _medicos)
                                {
                                    <option value="@m.Id">@m.Descripcion</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-0">Fecha de Agenda</label>
                            <input type="date" class="form-control form-control-sm"
                                   value="@_fechaAgenda.ToString("yyyy-MM-dd")"
                                   @onchange="CambiarFechaAsync" />
                        </div>
                    </div>
                </div>
                <div class="card-body p-2">
                    <div class="d-flex justify-content-between align-items-center px-2 mb-2 small text-muted">
                        <span>Seleccione un bloque libre para agendar:</span>
                        <span><span class="badge bg-success">Libre</span> <span class="badge bg-primary">Ocupado</span> <span class="badge bg-secondary">Receso</span></span>
                    </div>

                    <div class="list-group" style="max-height: 460px; overflow-y: auto;">
                        @foreach (var slot in _slots)
                        {
                            string bgClass = slot.Bloqueado ? "list-group-item-secondary" : (slot.Disponible ? "list-group-item-action" : "list-group-item-primary");
                            <div class="list-group-item @bgClass py-2 px-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge @(slot.Bloqueado ? "bg-secondary" : (slot.Disponible ? "bg-success" : "bg-primary")) me-2">
                                        @slot.Hora
                                    </span>
                                    <span class="small fw-semibold">@slot.MotivoEstado</span>
                                </div>
                                @if (slot.Disponible)
                                {
                                    <button class="btn btn-xs btn-outline-success py-0 px-2" @onclick="() => SeleccionarHoraLibre(slot.Hora)">
                                        <i class="bi bi-plus-lg"></i> Asignar
                                    </button>
                                }
                                else if (slot.CitaExistente != null)
                                {
                                    <span class="badge bg-dark">NHCL #@slot.CitaExistente.CiNhcl</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Formulario de Reserva + Listado de Citas -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-info text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-calendar-plus me-1"></i>Reservar Turno Médico</span>
                    <span class="badge bg-dark">Hora Seleccionada: @_nuevaCita.CiHora</span>
                </div>
                <div class="card-body">
                    <EditForm Model="_nuevaCita" OnValidSubmit="GuardarCitaAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-2">
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Autocompletar desde Paciente Existente</label>
                                <select class="form-select form-select-sm" @onchange="AutocompletarPacienteCita">
                                    <option value="0">-- Seleccionar NHCL existente (Opcional) --</option>
                                    @foreach (var p in _pacientes)
                                    {
                                        <option value="@p.MasNhcl">#@p.MasNhcl — @p.MasNombre (@p.ClienteNombre)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Tipo de Consulta</label>
                                <select class="form-select form-select-sm" @bind="_nuevaCita.CiTipoConsulta">
                                    <option value="1">1 — Consulta General</option>
                                    <option value="2">2 — Especialidad</option>
                                    <option value="3">3 — Cirugía Programada</option>
                                    <option value="4">4 — Control / Revisión</option>
                                    <option value="5">5 — Estudio de Imagen / Eco</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">Hora Cita *</label>
                                <InputText class="form-control form-control-sm fw-bold text-center" @bind-Value="_nuevaCita.CiHora" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nombre del Propietario *</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_nuevaCita.CiNombre" />
                                <ValidationMessage For="() => _nuevaCita.CiNombre" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nombre de la Mascota *</label>
                                <InputText class="form-control form-control-sm text-uppercase" @bind-Value="_nuevaCita.CiNombreMas" />
                                <ValidationMessage For="() => _nuevaCita.CiNombreMas" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Teléfono Contacto</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_nuevaCita.CiTelefono" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Correo Electrónico</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_nuevaCita.CiEmail" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">Origen</label>
                                <select class="form-select form-select-sm" @bind="_nuevaCita.CiTipo">
                                    <option value="M">Doméstico</option>
                                    <option value="T">Silvestre</option>
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Motivo de la Cita / Observaciones</label>
                                <InputText class="form-control form-control-sm" placeholder="Ej: Vacunación anual, control post-operatorio, ecografía abdominal..." @bind-Value="_nuevaCita.CiObservacion" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-info text-white btn-sm fw-bold">
                                <i class="bi bi-calendar-check me-1"></i>Confirmar y Registrar Cita
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>

            <!-- Tabla de Citas Programadas -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-card-checklist me-1"></i>Citas Programadas (@_citas.Count)</span>
                    <span class="badge bg-info text-dark">@_fechaAgenda.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Hora</th>
                                    <th>Mascota (NHCL)</th>
                                    <th>Propietario / Tel.</th>
                                    <th>Médico</th>
                                    <th>Motivo</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in _citas)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@c.CiHora</td>
                                        <td>
                                            <strong>@c.CiNombreMas</strong>
                                            @if (c.CiNhcl > 0)
                                            {
                                                <span class="text-muted">(#@c.CiNhcl)</span>
                                            }
                                        </td>
                                        <td>
                                            <div>@c.CiNombre</div>
                                            <small class="text-muted">@c.CiTelefono</small>
                                        </td>
                                        <td>@c.NombreMedico</td>
                                        <td>@c.CiObservacion</td>
                                        <td>
                                            @if (c.CiEstadoCita == "C")
                                            {
                                                <span class="badge bg-success">Confirmada</span>
                                            }
                                            else if (c.CiEstadoCita == "A")
                                            {
                                                <span class="badge bg-primary">Atendida</span>
                                            }
                                            else if (c.CiEstadoCita == "X")
                                            {
                                                <span class="badge bg-danger">Cancelada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Agendada</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (PuedeEditar(c))
                                            {
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-success py-0 px-2" title="Confirmar Asistencia"
                                                            @onclick='() => CambiarEstadoCitaAsync(c.CiId, "C")'>
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger py-0 px-2" title="Cancelar Cita"
                                                            @onclick='() => CambiarEstadoCitaAsync(c.CiId, "X")'>
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);

    private List<CatalogoItemGenericoDto> _medicos = new();
    private List<CatalogoItemGenericoDto> _medicosAgenda = [];
    private List<CatalogoItemGenericoDto> _medicosHistorial = [];
    private List<CatalogoItemGenericoDto> _especialidades = new();
    private List<PacienteMascotaDto> _pacientes = new();
    private List<SlotHorarioMedicoDto> _slots => _slotsMes.GetValueOrDefault(_fechaAgenda.Date) ?? [];
    private Dictionary<DateTime, List<SlotHorarioMedicoDto>> _slotsMes = [];
    private List<SlotHorarioMedicoDto> _slotsFormulario = [];
    private List<CatalogoItemGenericoDto> _sucursales = [];
    private int _sucursalAgenda;
    private int _sucursalHistorial;
