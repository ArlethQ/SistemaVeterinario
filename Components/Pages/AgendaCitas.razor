    private static DateTime InicioSemana(DateTime fecha) =>
        fecha.Date.AddDays(-((int)fecha.DayOfWeek + 6) % 7);

    private (DateTime Fecha, ILookup<string, CitaMedicaDto> Citas, HashSet<string> Libres)[] ObtenerSemanaAgenda()
    {
        var lunes = InicioSemana(_fechaAgenda);
        return Enumerable.Range(0, 7).Select(indice =>
        {
            var fecha = lunes.AddDays(indice);
            var citas = _citasMes[fecha].Where(cita => cita.CiEstado != "I" && cita.CiEstadoCita != "X")
                .ToLookup(cita => TimeSpan.TryParse(cita.CiHora, out var hora)
                ? $"{hora.Hours:D2}:{hora.Minutes:D2}" : cita.CiHora);
            var libres = ObtenerHorasLibres(fecha).Select(slot => slot.Hora).ToHashSet(StringComparer.Ordinal);
            return (fecha, citas, libres);
        }).ToArray();
    }

    private static bool EsHoraLibre(SlotHorarioMedicoDto slot, DateTime fecha) =>
        slot.Disponible && TimeSpan.TryParse(slot.Hora, out var hora) && fecha.Date.Add(hora) >= AhoraClinica;
