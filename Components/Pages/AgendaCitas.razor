                _nuevaCita.CiTelefono = p.ClienteTelefono;
                _nuevaCita.CiTipo = p.MasOrigen;
            }
        }
    }

    private async Task GuardarCitaAsync()
    {
        _errorFormulario = string.Empty;
        try
        {
            int idUser = SessionState.UsuarioActual?.IdUsuario ?? 1;
            var medicoObj = _medicos.FirstOrDefault(m => m.Id == _idMedicoFiltro);
            _nuevaCita.CiUsuario = _idMedicoFiltro;
            _nuevaCita.NombreMedico = medicoObj?.Descripcion ?? "Médico";
            _nuevaCita.CiLocalidad = SessionState.Localidad;

            if (_nuevaCita.CiFecha == default)
                _nuevaCita.CiFecha = _fechaAgenda;

            if (TimeSpan.TryParse(_nuevaCita.CiHora, out var ts))
            {
                _nuevaCita.CiHora = $"{ts.Hours:D2}:{ts.Minutes:D2}";
            }

            if (_idMedicoFiltro <= 0)
            {
                _errorFormulario = "No hay médicos veterinarios registrados en la especialidad seleccionada.";
                return;
            }
            _nuevaCita.CiEspecialidad = ResolverEspecialidadCita(_nuevaCita);
            int idCita = await AdmisionService.AgendarCitaAsync(_nuevaCita, idUser);
            _mensaje = $"Cita #{idCita} agendada para {_nuevaCita.CiNombreMas} a las {_nuevaCita.CiHora} con {_nuevaCita.NombreMedico}.";
            _mensajeEsError = false;

            _fechaAgenda = _nuevaCita.CiFecha;
            _nuevaCita = new CitaMedicaDto 
            { 
                CiFecha = _fechaAgenda, 
                CiHora = "08:00", 
                CiUsuario = _idMedicoFiltro, 
                CiLocalidad = SessionState.Localidad 
            };
            await CargarAgendaAsync();
            _mostrarFormularioCita = false;
        }
        catch (InvalidOperationException ex)
        {
            _errorFormulario = ex.Message;
        }
        catch (Exception ex)
        {
            _errorFormulario = $"No se pudo agendar la cita: {ex.Message}";
        }
    }

    private async Task CambiarEstadoCitaAsync(int idCita, string nuevoEstado)
    {
        _mensajeModal = string.Empty;
        try
        {
            var ok = await AdmisionService.ActualizarEstadoCitaAsync(idCita, nuevoEstado);
            if (ok)
            {
                _mensajeEsError = false;
                _mensaje = nuevoEstado switch
                {
                    "C" => $"Cita #{idCita} confirmada exitosamente.",
                    "X" => $"Cita #{idCita} cancelada.",
                    "N" => $"Cita #{idCita} marcada como por confirmar.",
                    _ => $"Estado de la cita #{idCita} actualizado."
                };
            }
            else
            {
                MostrarErrorCita($"No se pudo actualizar el estado de la cita #{idCita}.");
                return;
            }
            await CargarAgendaAsync();
            if (_citaDetalle != null && _citaDetalle.CiId == idCita)
            {
                _citaDetalle.CiEstadoCita = nuevoEstado;
            }
        }
        catch (Exception ex)
        {
            MostrarErrorCita($"Error al cambiar estado de la cita: {ex.Message}");
        }
    }

    private void MostrarErrorCita(string mensaje)
    {
        if (_citaDetalle is not null || _citaReagendar is not null || _citaCancelar is not null)
            _mensajeModal = mensaje;
        else
        {
            _mensajeEsError = true;
            _mensaje = mensaje;
        }
    }

