@page "/admision/citas"
@using HosvetKardex.Web.Models
@using HosvetKardex.Web.Services
@inject IAdmisionFacturacionService AdmisionService
@inject IReportExportService ReportService
@inject SessionStateService SessionState
@inject IJSRuntime JS
@inject IWebHostEnvironment Env

<PageTitle>e-ForVets — Agenda Médica y Calendarización de Citas</PageTitle>

<div class="container-fluid py-3 agenda-page">
    <!-- Encabezado -->
    <div class="agenda-hero d-flex flex-wrap justify-content-between align-items-center mb-3 p-3 bg-white">
        <div class="d-flex align-items-center gap-3">
            <div class="agenda-hero-icon">▦</div><div>
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-calendar2-week-fill me-2"></i>Agenda Médica
            </h4>
            <small class="text-muted">
                Programación de turnos por especialista, disponibilidad horaria y confirmación de citas.
            </small>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center agenda-toolbar">
            <button class="btn btn-outline-secondary btn-sm" @onclick="DiaAnterior">‹</button>
            <input type="date" class="form-control form-control-sm" value="@_fechaAgenda.ToString("yyyy-MM-dd")" @onchange="CambiarFechaAsync" />
            <button class="btn btn-outline-secondary btn-sm" @onclick="DiaSiguiente">›</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="IrHoy">Hoy</button>
            <button class="btn btn-primary btn-sm" @onclick="AbrirFormularioCita">+ Agendar cita</button>
            <button class="btn btn-outline-danger btn-sm" @onclick="ExportarPdfAgendaAsync">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>Exportar Agenda PDF
            </button>
            <a href="/admision/ordenes" class="btn btn-success btn-sm">
                <i class="bi bi-clipboard2-pulse me-1"></i>Recepción / Órdenes
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensaje))
    {
        <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@_mensaje
            <button type="button" class="btn-close" @onclick="() => _mensaje = string.Empty"></button>
        </div>
    }

    @if (_cargandoInicial)
    {
        <LoadingState Title="Cargando agenda médica"
                      Message="Preparando citas, especialistas y turnos disponibles." />
    }

    <div class="row g-3 mb-3 agenda-kpis">
        <div class="col-6 col-xl-3"><div class="agenda-kpi blue"><span>AGE</span><div><strong>@_citas.Count</strong><small>Citas programadas</small><em>Para este día</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="agenda-kpi green"><span>CON</span><div><strong>@CitasConfirmadas</strong><small>Confirmadas</small><em>@Porcentaje(CitasConfirmadas)% del total</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="agenda-kpi amber"><span>PEN</span><div><strong>@CitasPendientes</strong><small>Por confirmar</small><em>@Porcentaje(CitasPendientes)% del total</em></div></div></div>
        <div class="col-6 col-xl-3"><div class="agenda-kpi red"><span>CAN</span><div><strong>@CitasCanceladas</strong><small>Canceladas</small><em>@Porcentaje(CitasCanceladas)% del total</em></div></div></div>
    </div>

    <nav class="agenda-tabs mb-3">
        <button class="@(_vistaAgenda == "agenda" ? "active" : "")" @onclick='() => _vistaAgenda = "agenda"'>Agenda diaria</button>
        <button class="@(_vistaAgenda == "tabla" ? "active" : "")" @onclick='() => _vistaAgenda = "tabla"'>Citas programadas <span>@_citas.Count</span></button>
    </nav>

    <div class="@(_vistaAgenda == "agenda" ? "row g-3 agenda-workspace" : "d-none")">
        <div class="col-xl-9">
            <section class="calendar-card">
                <header><span>│</span><strong>Médicos Veterinarios</strong></header>
                <div class="calendar-grid calendar-doctors" style="--doctor-count:@MedicosAgenda.Count">
                    <div class="time-header"></div>
                    @foreach (var medico in MedicosAgenda)
                    {
                        <div class="calendar-doctor"><span>@Iniciales(medico.Descripcion)</span><div><strong>@medico.Descripcion</strong><small>Médico veterinario</small></div></div>
                    }
                </div>
                <div class="calendar-scroll">
                    @foreach (var hora in HorasAgenda)
                    {
                        bool receso = hora.StartsWith("13:");
                        <div class="calendar-grid calendar-row @(receso ? "lunch-row" : "")" style="--doctor-count:@MedicosAgenda.Count">
                            <div class="calendar-time">@hora</div>
                            @if (receso)
                            {
                                <div class="calendar-lunch">13:00 Receso / Almuerzo</div>
                            }
                            else
                            {
                                @foreach (var medico in MedicosAgenda)
                                {
                                    var cita = ObtenerCita(medico.Id, hora);
                                    if (cita is null)
                                    {
                                        <button type="button" class="calendar-slot free" title="Agendar cita con @medico.Descripcion a las @hora" @onclick="() => AbrirDesdeCasilla(medico.Id, hora)"><span>+</span></button>
                                    }
                                    else
                                    {
                                        <button type="button" class="calendar-slot appointment @ClaseEstadoCita(cita.CiEstadoCita)" @onclick="() => VerDetalleCita(cita)">
                                            <span class="appointment-photo">@if (!string.IsNullOrEmpty(ObtenerFotoPaciente(cita.CiNhcl))) { <img src="@ObtenerFotoPaciente(cita.CiNhcl)" alt="Foto de @cita.CiNombreMas" /> } else { <b>@Iniciales(cita.CiNombreMas)</b> }</span>
                                            <span><strong>@cita.CiNombreMas @if(cita.CiNhcl > 0){<small>(#@cita.CiNhcl)</small>}</strong><small>@cita.CiNombre</small><em>@TextoTipoConsulta(cita.CiTipoConsulta)</em></span>
                                        </button>
                                    }
                                }
                            }
                        </div>
                    }
                </div>
                <footer class="calendar-legend"><span class="confirmed">Confirmada</span><span class="pending">Por confirmar</span><span class="waiting">Agendada</span><span class="cancelled">Cancelada</span></footer>
            </section>
        </div>
        <div class="col-xl-3">
            <section class="day-list-card">
                <header><strong>Citas del día (@_citas.Count)</strong></header>
                <div class="day-list">
                    @foreach (var cita in _citas.OrderBy(c => c.CiHora))
                    {
                        <button type="button" class="day-appointment" @onclick="() => VerDetalleCita(cita)"><time>@cita.CiHora</time><span class="mini-pet">@if(!string.IsNullOrEmpty(ObtenerFotoPaciente(cita.CiNhcl))){<img src="@ObtenerFotoPaciente(cita.CiNhcl)" alt="Foto de @cita.CiNombreMas"/>}else{<b>@Iniciales(cita.CiNombreMas)</b>}</span><span><strong>@cita.CiNombreMas</strong><small>@cita.CiNombre</small></span><em class="@ClaseEstadoCita(cita.CiEstadoCita)">@TextoEstadoCita(cita.CiEstadoCita)</em></button>
                    }
                </div>
            </section>
        </div>
    </div>

    @if (_vistaAgenda == "tabla")
    {
        <section class="scheduled-table-card">
            <header><div><small>PROGRAMACIÓN DEL DÍA</small><h5>Citas programadas</h5></div><div><span>@_fechaAgenda.ToString("dd/MM/yyyy")</span><button class="btn btn-primary btn-sm" @onclick="AbrirFormularioCita">+ Agendar cita</button></div></header>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Hora</th><th>Paciente</th><th>Propietario / Contacto</th><th>Médico</th><th>Tipo / Motivo</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                    <tbody>
                        @foreach (var cita in _citas.OrderBy(c => c.CiHora))
                        {
                            <tr>
                                <td><strong class="scheduled-time">@cita.CiHora</strong></td>
                                <td><div class="scheduled-patient"><span class="appointment-photo">@if(!string.IsNullOrEmpty(ObtenerFotoPaciente(cita.CiNhcl))){<img src="@ObtenerFotoPaciente(cita.CiNhcl)" alt="Foto de @cita.CiNombreMas"/>}else{<b>@Iniciales(cita.CiNombreMas)</b>}</span><div><strong>@cita.CiNombreMas</strong><small>@(cita.CiNhcl > 0 ? $"NHCL #{cita.CiNhcl}" : "Sin NHCL")</small></div></div></td>
                                <td><strong>@cita.CiNombre</strong><small>@cita.CiTelefono</small></td>
                                <td><strong>@cita.NombreMedico</strong><small>@cita.Especialidad</small></td>
                                <td><strong>@TextoTipoConsulta(cita.CiTipoConsulta)</strong><small>@cita.CiObservacion</small></td>
                                <td><span class="table-status @ClaseEstadoCita(cita.CiEstadoCita)">@TextoEstadoCita(cita.CiEstadoCita)</span></td>
                                <td class="text-end"><button class="btn btn-info btn-sm" @onclick="() => VerDetalleCita(cita)">Ver detalle</button> <button class="btn btn-success btn-sm" title="Confirmar" @onclick='() => CambiarEstadoCitaAsync(cita.CiId, "C")'>Confirmar</button> <button class="btn btn-danger btn-sm" title="Cancelar" @onclick='() => CambiarEstadoCitaAsync(cita.CiId, "X")'>Cancelar</button></td>
                            </tr>
                        }
                        @if (_citas.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-5">No hay citas programadas para esta fecha.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (_mostrarFormularioCita)
    {
        <div class="appointment-drawer-backdrop" @onclick="CerrarFormularioCita"></div>
        <aside class="appointment-drawer">
            <header><div><small>NUEVA CITA</small><h5>Agendar cita médica</h5></div><button @onclick="CerrarFormularioCita">×</button></header>
            <div class="appointment-form">
                <EditForm Model="_nuevaCita" OnValidSubmit="GuardarCitaAsync">
                    <DataAnnotationsValidator />
                    <h6>1. Información del paciente</h6>
                    <label>Paciente existente</label>
                    <select class="form-select" @onchange="AutocompletarPacienteCita"><option value="0">Buscar por NHCL, nombre o propietario...</option>@foreach(var p in _pacientes){<option value="@p.MasNhcl">#@p.MasNhcl — @p.MasNombre (@p.ClienteNombre)</option>}</select>
                    @if (_nuevaCita.CiNhcl > 0)
                    {
                        <div class="drawer-patient"><span class="appointment-photo">@if(!string.IsNullOrEmpty(ObtenerFotoPaciente(_nuevaCita.CiNhcl))){<img src="@ObtenerFotoPaciente(_nuevaCita.CiNhcl)" alt="Foto"/>}else{<b>@Iniciales(_nuevaCita.CiNombreMas)</b>}</span><div><strong>@_nuevaCita.CiNombreMas (#@_nuevaCita.CiNhcl)</strong><small>Propietario: @_nuevaCita.CiNombre</small></div></div>
                    }
                    <h6>2. Detalles de la cita</h6>
                    <div class="row g-2">
                        <div class="col-md-6"><label>Médico veterinario *</label><select class="form-select" @bind="_idMedicoFiltro">@foreach(var m in _medicos){<option value="@m.Id">@m.Descripcion</option>}</select></div>
                        <div class="col-md-6"><label>Tipo de consulta *</label><select class="form-select" @bind="_nuevaCita.CiTipoConsulta"><option value="1">Consulta General</option><option value="2">Especialidad</option><option value="3">Cirugía Programada</option><option value="4">Control / Revisión</option><option value="5">Imagen / Ecografía</option></select></div>
                        <div class="col-md-6"><label>Fecha *</label><InputDate class="form-control" @bind-Value="_nuevaCita.CiFecha" /></div>
                        <div class="col-md-6"><label>Hora *</label><InputText class="form-control" @bind-Value="_nuevaCita.CiHora" /></div>
                        <div class="col-md-6"><label>Propietario *</label><InputText class="form-control" @bind-Value="_nuevaCita.CiNombre" /></div>
                        <div class="col-md-6"><label>Paciente *</label><InputText class="form-control" @bind-Value="_nuevaCita.CiNombreMas" /></div>
                        <div class="col-12"><label>Motivo / Observaciones</label><InputTextArea class="form-control" rows="3" @bind-Value="_nuevaCita.CiObservacion" /></div>
                    </div>
                    <div class="drawer-actions"><button type="button" class="btn btn-secondary" @onclick="CerrarFormularioCita">Cancelar</button><button type="submit" class="btn btn-primary">Guardar cita</button></div>
                </EditForm>
            </div>
        </aside>
    }

    @if (_citaDetalle is not null)
    {
        <div class="appointment-detail-backdrop" @onclick="CerrarDetalleCita"></div>
        <section class="appointment-detail" role="dialog" aria-modal="true" aria-label="Detalle de la cita">
            <header><div><small>DETALLE DE CITA #@_citaDetalle.CiId</small><h5>@_citaDetalle.CiNombreMas</h5></div><button @onclick="CerrarDetalleCita">×</button></header>
            <div class="detail-patient">
                <span class="detail-photo">@if(!string.IsNullOrEmpty(ObtenerFotoPaciente(_citaDetalle.CiNhcl))){<img src="@ObtenerFotoPaciente(_citaDetalle.CiNhcl)" alt="Foto de @_citaDetalle.CiNombreMas"/>}else{<b>@Iniciales(_citaDetalle.CiNombreMas)</b>}</span>
                <div><strong>@_citaDetalle.CiNombreMas @if(_citaDetalle.CiNhcl > 0){<small>(NHCL #@_citaDetalle.CiNhcl)</small>}</strong><span>Propietario: @_citaDetalle.CiNombre</span></div>
                <em class="@ClaseEstadoCita(_citaDetalle.CiEstadoCita)">@TextoEstadoCita(_citaDetalle.CiEstadoCita)</em>
            </div>
            <div class="detail-grid">
                <div><small>Fecha</small><strong>@_citaDetalle.CiFecha.ToString("dd/MM/yyyy")</strong></div>
                <div><small>Hora</small><strong>@_citaDetalle.CiHora</strong></div>
                <div><small>Médico veterinario</small><strong>@_citaDetalle.NombreMedico</strong></div>
                <div><small>Tipo de consulta</small><strong>@TextoTipoConsulta(_citaDetalle.CiTipoConsulta)</strong></div>
                <div><small>Teléfono</small><strong>@(string.IsNullOrWhiteSpace(_citaDetalle.CiTelefono) ? "No registrado" : _citaDetalle.CiTelefono)</strong></div>
                <div><small>Correo electrónico</small><strong>@(string.IsNullOrWhiteSpace(_citaDetalle.CiEmail) ? "No registrado" : _citaDetalle.CiEmail)</strong></div>
                <div class="detail-observation"><small>Motivo / Observaciones</small><strong>@(string.IsNullOrWhiteSpace(_citaDetalle.CiObservacion) ? "Sin observaciones" : _citaDetalle.CiObservacion)</strong></div>
            </div>
            <footer><button class="btn btn-secondary" @onclick="CerrarDetalleCita">Cerrar</button></footer>
        </section>
    }

    <div class="row g-3 d-none">
        <!-- Columna Izquierda: Grilla de Slots Horarios del Médico (08:00 a 17:30) -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-0">Médico Veterinario</label>
                            <select class="form-select form-select-sm" value="@_idMedicoFiltro" @onchange="CambiarMedicoAsync">
                                @foreach (var m in _medicos)
                                {
                                    <option value="@m.Id">@m.Descripcion</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-0">Fecha de Agenda</label>
                            <input type="date" class="form-control form-control-sm"
                                   value="@_fechaAgenda.ToString("yyyy-MM-dd")"
                                   @onchange="CambiarFechaAsync" />
                        </div>
                    </div>
                </div>
                <div class="card-body p-2">
                    <div class="d-flex justify-content-between align-items-center px-2 mb-2 small text-muted">
                        <span>Seleccione un bloque libre para agendar:</span>
                        <span><span class="badge bg-success">Libre</span> <span class="badge bg-primary">Ocupado</span> <span class="badge bg-secondary">Receso</span></span>
                    </div>

                    <div class="list-group" style="max-height: 460px; overflow-y: auto;">
                        @foreach (var slot in _slots)
                        {
                            string bgClass = slot.Bloqueado ? "list-group-item-secondary" : (slot.Disponible ? "list-group-item-action" : "list-group-item-primary");
                            <div class="list-group-item @bgClass py-2 px-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge @(slot.Bloqueado ? "bg-secondary" : (slot.Disponible ? "bg-success" : "bg-primary")) me-2">
                                        @slot.Hora
                                    </span>
                                    <span class="small fw-semibold">@slot.MotivoEstado</span>
                                </div>
                                @if (slot.Disponible)
                                {
                                    <button class="btn btn-xs btn-outline-success py-0 px-2" @onclick="() => SeleccionarHoraLibre(slot.Hora)">
                                        <i class="bi bi-plus-lg"></i> Asignar
                                    </button>
                                }
                                else if (slot.CitaExistente != null)
                                {
                                    <span class="badge bg-dark">NHCL #@slot.CitaExistente.CiNhcl</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Formulario de Reserva + Listado de Citas -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-info text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-calendar-plus me-1"></i>Reservar Turno Médico</span>
                    <span class="badge bg-dark">Hora Seleccionada: @_nuevaCita.CiHora</span>
                </div>
                <div class="card-body">
                    <EditForm Model="_nuevaCita" OnValidSubmit="GuardarCitaAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-2">
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Autocompletar desde Paciente Existente</label>
                                <select class="form-select form-select-sm" @onchange="AutocompletarPacienteCita">
                                    <option value="0">-- Seleccionar NHCL existente (Opcional) --</option>
                                    @foreach (var p in _pacientes)
                                    {
                                        <option value="@p.MasNhcl">#@p.MasNhcl — @p.MasNombre (@p.ClienteNombre)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Tipo de Consulta</label>
                                <select class="form-select form-select-sm" @bind="_nuevaCita.CiTipoConsulta">
                                    <option value="1">1 — Consulta General</option>
                                    <option value="2">2 — Especialidad</option>
                                    <option value="3">3 — Cirugía Programada</option>
                                    <option value="4">4 — Control / Revisión</option>
                                    <option value="5">5 — Estudio de Imagen / Eco</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">Hora Cita *</label>
                                <InputText class="form-control form-control-sm fw-bold text-center" @bind-Value="_nuevaCita.CiHora" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nombre del Propietario *</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_nuevaCita.CiNombre" />
                                <ValidationMessage For="() => _nuevaCita.CiNombre" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nombre de la Mascota *</label>
                                <InputText class="form-control form-control-sm text-uppercase" @bind-Value="_nuevaCita.CiNombreMas" />
                                <ValidationMessage For="() => _nuevaCita.CiNombreMas" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Teléfono Contacto</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_nuevaCita.CiTelefono" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Correo Electrónico</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_nuevaCita.CiEmail" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">Origen</label>
                                <select class="form-select form-select-sm" @bind="_nuevaCita.CiTipo">
                                    <option value="M">Doméstico</option>
                                    <option value="T">Silvestre</option>
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Motivo de la Cita / Observaciones</label>
                                <InputText class="form-control form-control-sm" placeholder="Ej: Vacunación anual, control post-operatorio, ecografía abdominal..." @bind-Value="_nuevaCita.CiObservacion" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-info text-white btn-sm fw-bold">
                                <i class="bi bi-calendar-check me-1"></i>Confirmar y Registrar Cita
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>

            <!-- Tabla de Citas Programadas -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-card-checklist me-1"></i>Citas Programadas (@_citas.Count)</span>
                    <span class="badge bg-info text-dark">@_fechaAgenda.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Hora</th>
                                    <th>Mascota (NHCL)</th>
                                    <th>Propietario / Tel.</th>
                                    <th>Médico</th>
                                    <th>Motivo</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in _citas)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@c.CiHora</td>
                                        <td>
                                            <strong>@c.CiNombreMas</strong>
                                            @if (c.CiNhcl > 0)
                                            {
                                                <span class="text-muted">(#@c.CiNhcl)</span>
                                            }
                                        </td>
                                        <td>
                                            <div>@c.CiNombre</div>
                                            <small class="text-muted">@c.CiTelefono</small>
                                        </td>
                                        <td>@c.NombreMedico</td>
                                        <td>@c.CiObservacion</td>
                                        <td>
                                            @if (c.CiEstadoCita == "C")
                                            {
                                                <span class="badge bg-success">Confirmada</span>
                                            }
                                            else if (c.CiEstadoCita == "A")
                                            {
                                                <span class="badge bg-primary">Atendida</span>
                                            }
                                            else if (c.CiEstadoCita == "X")
                                            {
                                                <span class="badge bg-danger">Cancelada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Agendada</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-success py-0 px-2" title="Confirmar Asistencia"
                                                        @onclick='() => CambiarEstadoCitaAsync(c.CiId, "C")'>
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                                <button class="btn btn-outline-danger py-0 px-2" title="Cancelar Cita"
                                                        @onclick='() => CambiarEstadoCitaAsync(c.CiId, "X")'>
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<CatalogoItemGenericoDto> _medicos = new();
    private List<PacienteMascotaDto> _pacientes = new();
    private List<SlotHorarioMedicoDto> _slots = new();
    private List<CitaMedicaDto> _citas = new();

    private CitaMedicaDto _nuevaCita = new();
    private int _idMedicoFiltro = 1;
    private DateTime _fechaAgenda = DateTime.Today;
    private bool _cargandoInicial = true;
    private string _mensaje = string.Empty;
    private bool _mostrarFormularioCita;
    private CitaMedicaDto? _citaDetalle;
    private string _vistaAgenda = "agenda";
    private int CitasConfirmadas => _citas.Count(c => c.CiEstadoCita == "C");
    private int CitasCanceladas => _citas.Count(c => c.CiEstadoCita == "X");
    private int CitasPendientes => _citas.Count(c => c.CiEstadoCita is not ("C" or "X" or "A"));
    private List<CatalogoItemGenericoDto> MedicosAgenda => _medicos.ToList();
    private static readonly string[] HorasAgenda = Enumerable.Range(16, 20).Select(i => $"{i / 2:D2}:{(i % 2) * 30:D2}").ToArray();

    private int Porcentaje(int cantidad) => _citas.Count == 0 ? 0 : (int)Math.Round(cantidad * 100d / _citas.Count);
    private CitaMedicaDto? ObtenerCita(int medicoId, string hora) => _citas.FirstOrDefault(c => c.CiUsuario == medicoId && c.CiHora == hora && c.CiEstado != "I");
    private static string Iniciales(string texto)
    {
        var partes = (texto ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(partes.Take(2).Select(p => p[0])).ToUpperInvariant();
    }
    private static string ClaseEstadoCita(string estado) => estado switch { "C" => "confirmed", "X" => "cancelled", "A" => "waiting", _ => "pending" };
    private static string TextoEstadoCita(string estado) => estado switch { "C" => "Confirmada", "X" => "Cancelada", "A" => "Atendida", _ => "Por confirmar" };
    private static string TextoTipoConsulta(int tipo) => tipo switch { 2 => "Especialidad", 3 => "Cirugía programada", 4 => "Control / Revisión", 5 => "Imagen / Ecografía", _ => "Consulta general" };

    private string ObtenerFotoPaciente(int nhcl)
    {
        if (nhcl <= 0) return string.Empty;
        string directorio = Path.Combine(Env.WebRootPath, "PacientesFotos");
        if (!Directory.Exists(directorio)) return string.Empty;
        string? archivo = Directory.EnumerateFiles(directorio, $"{nhcl}.*").FirstOrDefault();
        return archivo is null ? string.Empty : $"/pacientes-fotos/{nhcl}?v={File.GetLastWriteTimeUtc(archivo).Ticks}";
    }

    private void AbrirFormularioCita()
    {
        _nuevaCita = new CitaMedicaDto { CiFecha = _fechaAgenda, CiHora = "08:00", CiUsuario = _idMedicoFiltro };
        _mostrarFormularioCita = true;
    }

    private void AbrirDesdeCasilla(int medicoId, string hora)
    {
        _idMedicoFiltro = medicoId;
        _nuevaCita = new CitaMedicaDto { CiFecha = _fechaAgenda, CiHora = hora, CiUsuario = medicoId };
        _mostrarFormularioCita = true;
    }

    private void CerrarFormularioCita() => _mostrarFormularioCita = false;
    private void VerDetalleCita(CitaMedicaDto cita) => _citaDetalle = cita;
    private void CerrarDetalleCita() => _citaDetalle = null;
    private async Task DiaAnterior() { _fechaAgenda = _fechaAgenda.AddDays(-1); await CargarAgendaAsync(); }
    private async Task DiaSiguiente() { _fechaAgenda = _fechaAgenda.AddDays(1); await CargarAgendaAsync(); }
    private async Task IrHoy() { _fechaAgenda = DateTime.Today; await CargarAgendaAsync(); }

    protected override async Task OnInitializedAsync()
    {
        _cargandoInicial = true;
        await Task.Yield();

        var tMed = AdmisionService.ObtenerMedicosPorEspecialidadAsync(0);
        var tPac = AdmisionService.BuscarMascotasAsync(string.Empty);
        await Task.WhenAll(tMed, tPac);

        _medicos = await tMed;
        _pacientes = await tPac;
        _idMedicoFiltro = _medicos.FirstOrDefault()?.Id ?? 1;

        await CargarAgendaAsync();
        _cargandoInicial = false;
    }

    private async Task CargarAgendaAsync()
    {
        var tSlots = AdmisionService.ObtenerSlotsHorarioMedicoAsync(_idMedicoFiltro, _fechaAgenda, 1);
        var tCitas = AdmisionService.ObtenerCitasPorFechaAsync(_fechaAgenda, _fechaAgenda, 0);
        await Task.WhenAll(tSlots, tCitas);
        _slots = await tSlots;
        _citas = await tCitas;

        var medicoObj = _medicos.FirstOrDefault(m => m.Id == _idMedicoFiltro);
        _nuevaCita.CiUsuario = _idMedicoFiltro;
        _nuevaCita.NombreMedico = medicoObj?.Descripcion ?? "Médico";
        _nuevaCita.CiFecha = _fechaAgenda;
    }

    private async Task CambiarMedicoAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idMed))
        {
            _idMedicoFiltro = idMed;
            await CargarAgendaAsync();
        }
    }

    private async Task CambiarFechaAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var fec))
        {
            _fechaAgenda = fec;
            await CargarAgendaAsync();
        }
    }

    private void SeleccionarHoraLibre(string hora)
    {
        _nuevaCita.CiHora = hora;
        _mostrarFormularioCita = true;
    }

    private void AutocompletarPacienteCita(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nhcl) && nhcl > 0)
        {
            var p = _pacientes.FirstOrDefault(x => x.MasNhcl == nhcl);
            if (p != null)
            {
                _nuevaCita.CiNhcl = p.MasNhcl;
                _nuevaCita.CiNombreMas = p.MasNombre;
                _nuevaCita.CiNombre = p.ClienteNombre;
                _nuevaCita.CiTelefono = p.ClienteTelefono;
                _nuevaCita.CiTipo = p.MasOrigen;
            }
        }
    }

    private async Task GuardarCitaAsync()
    {
        int idUser = SessionState.UsuarioActual?.IdUsuario ?? 1;
        var medicoObj = _medicos.FirstOrDefault(m => m.Id == _idMedicoFiltro);
        _nuevaCita.CiUsuario = _idMedicoFiltro;
        _nuevaCita.NombreMedico = medicoObj?.Descripcion ?? "Médico";
        _nuevaCita.CiFecha = _fechaAgenda;

        int idCita = await AdmisionService.AgendarCitaAsync(_nuevaCita, idUser);
        _mensaje = $"Cita #{idCita} agendada para {_nuevaCita.CiNombreMas} a las {_nuevaCita.CiHora} con {_nuevaCita.NombreMedico}.";
        _nuevaCita = new CitaMedicaDto { CiFecha = _fechaAgenda, CiHora = "08:30", CiUsuario = _idMedicoFiltro };
        await CargarAgendaAsync();
        _mostrarFormularioCita = false;
    }

    private async Task CambiarEstadoCitaAsync(int idCita, string nuevoEstado)
    {
        await AdmisionService.ActualizarEstadoCitaAsync(idCita, nuevoEstado);
        await CargarAgendaAsync();
    }

    private async Task ExportarPdfAgendaAsync()
    {
        var bytes = ReportService.GenerarAgendaCitasPdf(_citas, _fechaAgenda, _fechaAgenda);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $"{{ const a = document.createElement('a'); a.href = 'data:application/pdf;base64,{base64}'; a.download = 'Agenda_Citas_{_fechaAgenda:yyyyMMdd}.pdf'; a.click(); }}");
    }
}
