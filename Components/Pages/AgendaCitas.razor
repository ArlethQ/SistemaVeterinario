    private async Task OnFechaFormChanged()
    {
        _errorFormulario = string.Empty;
        _slotsFormulario = [];
        var cita = _nuevaCita;
        var fecha = cita.CiFecha.Date;
        var medico = _idMedicoFiltro;
        if (fecha < AhoraClinica.Date || medico <= 0)
            return;

        cita.CiHora = "";
        try
        {
            var slots = await AdmisionService.ObtenerSlotsHorarioMedicoAsync(medico, fecha, cita.CiLocalidad);
            if (ReferenceEquals(cita, _nuevaCita) && fecha == cita.CiFecha.Date && medico == _idMedicoFiltro)
            {
                _slotsFormulario = slots;
                cita.CiHora = ObtenerHorasLibresParaFormulario().FirstOrDefault() ?? "";
            }
        }
        catch (Exception)
        {
            if (ReferenceEquals(cita, _nuevaCita) && fecha == cita.CiFecha.Date && medico == _idMedicoFiltro)
                _errorFormulario = "No se pudieron cargar los turnos libres.";
        }
    }

