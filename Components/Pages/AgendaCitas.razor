    protected override async Task OnInitializedAsync()
    {
        var tEsp = AdmisionService.ObtenerEspecialidadesAsync();
        var tMed = AdmisionService.ObtenerMedicosAgendaAsync();
        var tPac = AdmisionService.BuscarMascotasAsync(string.Empty);
        var tPermiso = AdmisionService.PuedeVerAgendaCompletaAsync();
        var tSucursales = AdmisionService.ObtenerSucursalesAgendaAsync();
        await Task.WhenAll(tEsp, tMed, tPac, tPermiso, tSucursales);
        _puedeVerAgendaCompleta = await tPermiso;
        _sucursales = await tSucursales;
        _sucursalAgenda = _sucursales.Any(sucursal => sucursal.Id == SessionState.Localidad)
            ? SessionState.Localidad
            : _sucursales.FirstOrDefault()?.Id ?? 0;

        _especialidades = await tEsp;
        _medicos = (await tMed).Where(m => _puedeVerAgendaCompleta || m.Id == SessionState.IdUser).ToList();
        if (!_puedeVerAgendaCompleta && _medicos.Count == 0 && SessionState.IsAuthenticated)
            _medicos.Add(new() { Id = SessionState.IdUser, Descripcion = SessionState.NombreUsuario });

        _pacientes = await tPac;
        _medicosHistorial = _medicos;
        await ActualizarMedicosAgendaAsync();
        await CargarAgendaAsync();
    }

