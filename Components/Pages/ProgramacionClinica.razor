    if (_horario.Id == 0 && MedicoAgenda is int medico && _medicos.Any(m => m.Id == medico))
    {
        _horario.IdMedico = medico;
        if (EsProfesionalEnfermero(medico))
        {
            _consultorioId = 0;
            _horario.Piso = "General";
            _horario.Consultorio = "Área General";
        }
        ActualizarLocalidadSegunProfesional();
        if (_horario.IdLocalidad == 0 && LocalidadesDisponibles.Any(l => l.Id == Session.Localidad))
            _horario.IdLocalidad = Session.Localidad;
    }
}

async Task Cambiar(string t){_tab=t;_mensaje="";await Cargar();if(_tab=="cirugias"){_cirugia.IdLocalidad=Session.Localidad>0?Session.Localidad:(_cirugia.IdLocalidad>0?_cirugia.IdLocalidad:(_localidades.FirstOrDefault()?.Id??0));await CargarDisponibilidadMedicosCirugiaAsync();await CargarSlotsDisponiblesCirugiaAsync();}}
void AsegurarLocalidadCirugia()
{
    var disp = LocalidadesCirugiaDisponibles.ToList();
    if (PermitirElegirSucursalEnModal)
    {
        if (_cirugia.IdLocalidad <= 0 && disp.Count > 0)
            _cirugia.IdLocalidad = disp[0].Id;
        return;
    }
    if (disp.Count > 0 && !disp.Any(l => l.Id == _cirugia.IdLocalidad))
        _cirugia.IdLocalidad = disp[0].Id;
}

int ContarSlotsLibresMedico(int idMedico)
{
    if (!_slotsPorMedicoCirugia.TryGetValue(idMedico, out var slots) || slots.Count == 0) return 0;
    var esHoy = _cirugia.Fecha.Date == DateTime.Today;
    var ahora = DateTime.Now.TimeOfDay;
    return slots.Count(s => s.Disponible && (!esHoy || (TimeSpan.TryParse(s.Hora, out var sh) && sh >= ahora)));
}

bool TieneAlMenosUnSlotLibre(int idMedico) => ContarSlotsLibresMedico(idMedico) > 0;

bool EstaDisponibleEnRangoCirugia(int idMedico, string horaInicio, string horaFin)
{
    if (!_slotsPorMedicoCirugia.TryGetValue(idMedico, out var slots) || slots.Count == 0) return false;
    var esHoy = _cirugia.Fecha.Date == DateTime.Today;
    var ahora = DateTime.Now.TimeOfDay;
    if (string.IsNullOrWhiteSpace(horaInicio) || !TimeSpan.TryParse(horaInicio, out var inicioTs))
        return slots.Any(s => s.Disponible && (!esHoy || (TimeSpan.TryParse(s.Hora, out var sh) && sh >= ahora)));
    var finTs = TimeSpan.TryParse(horaFin, out var f) && f > inicioTs ? f : inicioTs + TimeSpan.FromMinutes(30);
    if (esHoy && inicioTs < ahora) return false;
    bool tieneInicioLibre = slots.Any(s => s.Disponible && TimeSpan.TryParse(s.Hora, out var sh) && sh == inicioTs);
    if (!tieneInicioLibre) return false;
    bool tieneConflicto = slots.Any(s => !s.Disponible && TimeSpan.TryParse(s.Hora, out var sh) && sh >= inicioTs && sh < finTs);
    return !tieneConflicto;
}

void ValidarAnestesiologoDisponible()
{
    if (_cirugia.IdAnestesiologo is int idA && idA > 0)
    {
        if (idA == _cirugia.IdMedico || !EstaDisponibleEnRangoCirugia(idA, _cirugia.HoraInicio, _cirugia.HoraFin))
            _cirugia.IdAnestesiologo = null;
    }
}

async Task CargarDisponibilidadMedicosCirugiaAsync()
{
    _slotsPorMedicoCirugia = [];
    if (_cirugia.IdLocalidad <= 0) return;
    var medicosBranch = MedicosSoloCirugia.ToList();
    if (medicosBranch.Count == 0) return;
    var tareas = medicosBranch.Select(async m =>
    {
        var slots = await AdmisionService.ObtenerSlotsHorarioMedicoAsync(m.Id, _cirugia.Fecha, _cirugia.IdLocalidad);
        return (m.Id, slots);
    }).ToList();
    var resultados = await Task.WhenAll(tareas);
    foreach (var (id, slots) in resultados)
        _slotsPorMedicoCirugia[id] = slots;
    if (_cirugia.IdMedico > 0)
    {
        if (PermitirElegirSucursalEnModal || FiltrarPorMedicoEnModal)
        {
            if (!MedicosSoloCirugia.Any(m => m.Id == _cirugia.IdMedico))
                _cirugia.IdMedico = 0;
        }
        else if (!TieneAlMenosUnSlotLibre(_cirugia.IdMedico))
        {
            _cirugia.IdMedico = 0;
        }
    }
    ValidarAnestesiologoDisponible();
}

