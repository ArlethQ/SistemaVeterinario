@page "/programacion/clinica"
@inject IGestionMigradaService Service
@inject IAdmisionFacturacionService AdmisionService
@inject IKardexService KardexService
@inject IConsultaExternaService ConsultaService
@inject SessionStateService Session
@inject NavigationManager Nav
<PageTitle>Programación clínica | e-ForVets</PageTitle>
@if(_autorizado){
<div class="@(ModoModal ? "py-2" : "container-fluid py-3")">
@if(!ModoModal){
<div class="d-flex justify-content-between"><h2>Horarios clínicos y programación quirúrgica</h2>@if (Permisos.Permite("programacion/consultorios")) { <a class="btn btn-outline-primary" href="/programacion/consultorios">Gestionar pisos y consultorios</a> }</div>
<ul class="nav nav-tabs my-3"><li class="nav-item"><button class="nav-link @(_tab=="horarios"?"active":"")" @onclick='()=>Cambiar("horarios")'>Horarios semanales</button></li><li class="nav-item"><button class="nav-link @(_tab=="excepciones"?"active":"")" @onclick='()=>Cambiar("excepciones")'>Bloqueos y excepciones</button></li><li class="nav-item"><button class="nav-link @(_tab=="cirugias"?"active":"")" @onclick='()=>Cambiar("cirugias")'>Cirugías</button></li></ul>
}
@if(!string.IsNullOrEmpty(_mensaje)){<div class="alert @(_error?"alert-danger":"alert-success")">@_mensaje</div>}
@if(_tab=="horarios"){
<div class="card mb-3"><div class="card-body">@if(_horario.Id>0){<div class="alert alert-info py-2">Editando horario #@_horario.Id</div>}<div class="row g-2">
<div class="col-md-3"><label>Profesional (Médico / Enfermero)</label><select class="form-select" value="@_horario.IdMedico" @onchange="SeleccionarProfesionalHorario"><option value="0">Seleccione</option>@foreach(var x in _medicos){<option value="@x.Id">@x.Descripcion</option>}</select></div>
<div class="col-md-2"><label>Día</label><select class="form-select" @bind="_horario.Dia">@foreach(var d in Dias.Keys){<option value="@d">@d</option>}</select></div>
<div class="col-md-1"><label>Desde</label><input type="time" class="form-control" value="@_horario.Desde" @onchange="e => _horario.Desde = e.Value?.ToString() ?? string.Empty"/></div><div class="col-md-1"><label>Hasta</label><input type="time" class="form-control" value="@_horario.Hasta" @onchange="e => _horario.Hasta = e.Value?.ToString() ?? string.Empty"/></div><div class="col-md-1"><label>Minutos</label><input type="number" min="5" class="form-control" @bind="_horario.Intervalo"/></div>
<div class="col-md-2"><label>Localidad</label><select class="form-select @(_horario.IdMedico > 0 && !LocalidadesDisponibles.Any() ? "is-invalid" : "")" value="@_horario.IdLocalidad" @onchange="CambiarLocalidad"><option value="0">@(_horario.IdMedico > 0 && !LocalidadesDisponibles.Any() ? "Sin sucursal asignada" : "Seleccione")</option>@foreach(var x in LocalidadesDisponibles){<option value="@x.Id">@x.Descripcion</option>}</select></div>
@if(EsProfesionalEnfermero(_horario.IdMedico)){
<div class="col-md-4"><label>Ubicación / Consultorio</label><input class="form-control text-muted bg-light" value="Área General (Sin consultorio asignado)" readonly title="Los enfermeros no tienen consultorio ni piso asignado"/></div>
}else{
<div class="col-md-3"><label>Consultorio</label><select class="form-select" value="@_consultorioId" @onchange="SeleccionarConsultorio"><option value="0">Seleccione</option>@foreach(var x in ConsultoriosDisponibles){<option value="@x.Id">@x.Piso · @x.Nombre</option>}</select></div>
<div class="col-md-1"><label>Piso</label><input class="form-control" value="@_horario.Piso" readonly/></div>
}
<div class="col-md-2"><label>Vigente desde</label><input type="date" class="form-control" @bind="_horario.VigenciaDesde"/></div><div class="col-md-2"><label>Vigente hasta <small>(vacío = permanente)</small></label><input type="date" class="form-control" @bind="_horario.VigenciaHasta"/></div>
<div class="col-md-3 align-self-end d-flex gap-2"><SaveButton class="btn btn-primary" OnClick="GuardarHorario">@(_horario.Id>0?"Actualizar":"Guardar")</SaveButton>@if(_horario.Id>0){<button class="btn btn-outline-secondary" @onclick="CancelarHorario">Cancelar</button>}</div>
</div></div></div>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Profesional</th><th>Día</th><th>Horario</th><th>Consultorio</th><th>Vigencia</th><th>Localidad</th><th></th></tr></thead><tbody>@foreach(var x in _horarios){<tr><td>@(string.IsNullOrWhiteSpace(x.Medico)?"Sin asignar":x.Medico)</td><td>@x.Dia</td><td>@x.Desde - @x.Hasta</td><td>@(string.IsNullOrWhiteSpace(x.Consultorio)?"Sin consultorio":(x.Consultorio.Contains("General", StringComparison.OrdinalIgnoreCase)?x.Consultorio:$"Piso {x.Piso} · {x.Consultorio}"))</td><td>@(x.VigenciaDesde?.ToString("dd/MM/yyyy")??"Inmediata") — @(x.VigenciaHasta?.ToString("dd/MM/yyyy")??"Permanente")</td><td>@x.Localidad</td><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Editar(x)">Editar</button> <button class="btn btn-sm btn-outline-danger" @onclick="()=>EliminarHorario(x.Id)">Eliminar</button></td></tr>}</tbody></table></div>
}else if(_tab=="excepciones"){
<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-3"><label>Profesional (Médico / Enfermero)</label><select class="form-select" value="@_excepcion.IdMedico" @onchange="SeleccionarProfesionalExcepcion"><option value="0">Seleccione</option>@foreach(var x in _medicos){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-3"><label>Motivo</label><input class="form-control" @bind="_excepcion.Motivo"/></div><div class="col-md-2"><label>Fecha</label><input type="date" class="form-control" @bind="_excepcion.Fecha"/></div><div class="col-md-1"><label>Desde</label><input class="form-control" @bind="_excepcion.Desde"/></div><div class="col-md-1"><label>Hasta</label><input class="form-control" @bind="_excepcion.Hasta"/></div><div class="col-md-2"><label>Localidad</label><select class="form-select @(_excepcion.IdMedico > 0 && !LocalidadesExcepcionDisponibles.Any() ? "is-invalid" : "")" @bind="_excepcion.IdLocalidad"><option value="0">@(_excepcion.IdMedico > 0 && !LocalidadesExcepcionDisponibles.Any() ? "Sin sucursal asignada" : "Seleccione")</option>@foreach(var x in LocalidadesExcepcionDisponibles){<option value="@x.Id">@x.Descripcion</option>}</select></div><div><SaveButton class="btn btn-primary" OnClick="GuardarExcepcion">Guardar bloqueo</SaveButton></div></div></div>
<table class="table"><thead><tr><th>Fecha</th><th>Profesional</th><th>Motivo</th><th>Horario</th><th></th></tr></thead><tbody>@foreach(var x in _excepciones.Where(x=>x.Estado=="A")){<tr><td>@x.Fecha.ToString("yyyy-MM-dd")</td><td>@x.Medico</td><td>@x.Motivo</td><td>@x.Desde - @x.Hasta</td><td><button class="btn btn-sm btn-outline-danger" @onclick="()=>DesactivarExcepcion(x.Id)">Desactivar</button></td></tr>}</tbody></table>
}else if(ModoModal && FiltrarPorMedicoEnModal){
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white border-bottom py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="fw-bold text-dark">
            <i class="bi bi-calendar-plus text-primary me-2"></i>Nueva programación quirúrgica
        </div>
        @if (_cirugia.IdLocalidad > 0)
        {
            var nombreSuc = _localidades.FirstOrDefault(l => l.Id == _cirugia.IdLocalidad)?.Descripcion;
            if (!string.IsNullOrWhiteSpace(nombreSuc))
            {
                <span class="badge rounded-pill text-bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2">
                    <i class="bi bi-geo-alt-fill me-1"></i>Sucursal: @nombreSuc
                </span>
            }
        }
    </div>
    <div class="card-body p-4">
        @if (_ordenesCirugiaPendientes.Count > 0)
        {
            <div class="alert alert-info border-info border-opacity-25 py-2 px-3 mb-3 small">
                <div class="fw-bold text-primary mb-1">
                    <i class="bi bi-clipboard2-check-fill me-1"></i>Órdenes de cirugía pendientes por agendar (desde SOAP)
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var ordPend in _ordenesCirugiaPendientes.Take(10))
                    {
                        <button type="button"
                                class="btn btn-sm @(_cirugia.Nhcl == ordPend.Nhcl && _cirugia.IdProcedimiento == ordPend.IdProducto ? "btn-primary" : "btn-outline-primary bg-white") py-1 px-2 text-start"
                                @onclick="() => AplicarOrdenCirugiaPendiente(ordPend)">
                            <strong>@ordPend.PacienteNombre</strong> <span class="text-muted">(NHCL #@ordPend.Nhcl)</span> · @ordPend.DescripcionCirugia
                        </button>
                    }
                </div>
            </div>
        }
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-secondary mb-1">
                    <i class="bi bi-building me-1 text-primary"></i>Sucursal de la cirugía *
                </label>
                <select class="form-select" value="@_cirugia.IdLocalidad" @onchange="OnLocalidadCirugiaChangedAsync">
                    <option value="0">Seleccione sucursal...</option>
                    @foreach(var x in LocalidadesCirugiaDisponibles){<option value="@x.Id">@x.Descripcion</option>}
                </select>
            </div>
            <div class="col-md-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label fw-semibold small text-secondary mb-0">
                        <i class="bi bi-person-badge me-1 text-primary"></i>Médico cirujano *
                    </label>
                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold"
                            style="font-size: .75rem;"
                            @onclick="AgregarCirujanoAdicional"
                            disabled="@(_cirugia.IdLocalidad <= 0 || !MedicosCirugiaSelector.Any())">
                        <i class="bi bi-plus-circle me-1"></i>Agregar otro cirujano
                    </button>
                </div>
                <select class="form-select" value="@_cirugia.IdMedico" @onchange="OnMedicoCirugiaChangedAsync" disabled="@(_cirugia.IdLocalidad <= 0)">
                    <option value="0">@(_cirugia.IdLocalidad <= 0 ? "Primero seleccione una sucursal" : (MedicosCirugiaSelector.Any() ? "Seleccione un médico..." : "Sin médicos asignados a esta sucursal"))</option>
                    @foreach(var x in MedicosCirugiaSelector)
                    {
                        var libres = ContarSlotsLibresMedico(x.Id);
                        <option value="@x.Id">@x.Descripcion @(libres > 0 ? $"({libres} libres)" : "(sin horas en esta fecha)")</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-secondary mb-1">
                    <i class="bi bi-heart-pulse me-1 text-primary"></i>Anestesiólogo <span class="fw-normal text-muted">(opcional)</span>
                </label>
                <select class="form-select" @bind="_cirugia.IdAnestesiologo">
                    <option value="">Sin asignar</option>
                    @foreach(var x in AnestesiologosDisponibles){<option value="@x.Id">@x.Descripcion</option>}
                </select>
            </div>
            @if (_cirugia.IdsCirujanosAdicionales.Count > 0)
            {
                <div class="col-12">
                    <div class="p-3 bg-light border rounded-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-semibold text-secondary">
                                <i class="bi bi-people-fill me-1 text-primary"></i>Cirujanos adicionales (@_cirugia.IdsCirujanosAdicionales.Count)
                            </span>
                            <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" @onclick="AgregarCirujanoAdicional">
                                <i class="bi bi-plus-lg me-1"></i>Agregar otro
                            </button>
                        </div>
                        <div class="row g-2">
                            @for (int idx = 0; idx < _cirugia.IdsCirujanosAdicionales.Count; idx++)
                            {
                                var indice = idx;
                                var valorActual = _cirugia.IdsCirujanosAdicionales[indice];
                                var conflictoEste = valorActual > 0 && !CirujanoAdicionalDisponibleEnHorario(valorActual);
                                <div class="col-md-4">
                                    <div class="input-group input-group-sm">
                                        <select class="form-select @(conflictoEste ? "is-invalid" : "")" value="@valorActual" @onchange="e => ActualizarCirujanoAdicional(indice, e)">
                                            <option value="0">Seleccione cirujano adicional...</option>
                                            @foreach (var m in CirujanosAdicionalesDisponibles(indice))
                                            {
                                                var disp = CirujanoAdicionalDisponibleEnHorario(m.Id);
                                                <option value="@m.Id" disabled="@(!disp && m.Id != valorActual)">
                                                    @m.Descripcion @(disp ? "" : "— No disponible en este horario")
                                                </option>
                                            }
                                        </select>
                                        <button type="button" class="btn btn-outline-danger" title="Quitar cirujano" @onclick="() => QuitarCirujanoAdicional(indice)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                    @if (conflictoEste)
                                    {
                                        <div class="text-danger small mt-1" style="font-size:.72rem;">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i>No disponible en este horario.
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (HayConflictoCirujanosAdicionales)
                        {
                            <div class="alert alert-danger py-2 px-3 mt-2 mb-0 small d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span><strong>No disponible en el horario seleccionado:</strong> @string.Join(", ", CirujanosAdicionalesConConflicto) (tiene cita, bloqueo, otra cirugía o está fuera de turno). Quítelo o elija otro horario.</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="col-md-6 position-relative">
                <label class="form-label fw-semibold small text-secondary mb-1">
                    <i class="bi bi-search me-1 text-primary"></i>Paciente *
                </label>
                <input class="form-control" autocomplete="off" placeholder="Escriba nombre o NHCL para buscar paciente..." @bind="_filtroPaciente" @bind:event="oninput" @bind:after="BuscarPacientesAutoAsync" @onfocus="() => _mostrarPacientesSugeridos = !string.IsNullOrWhiteSpace(_filtroPaciente)" @onblur="CerrarPacientesSugeridosAsync" />
                @if(_mostrarPacientesSugeridos && _pacientes.Count > 0 && !string.IsNullOrWhiteSpace(_filtroPaciente))
                {
                    <div class="list-group position-absolute bg-white border rounded shadow mt-1 w-100" style="z-index:1060;max-height:220px;overflow-y:auto;">
                        @foreach(var x in _pacientes){<button type="button" class="list-group-item list-group-item-action py-2 px-3 small text-start" @onmousedown="() => SeleccionarPacienteCirugia(x)">@x.Descripcion</button>}
                    </div>
                }
                <select class="form-select mt-2" @bind="_cirugia.Nhcl">
                    @foreach(var x in _pacientes){<option value="@x.Id">@x.Descripcion</option>}
                </select>
            </div>

            <div class="col-md-6 position-relative">
                <label class="form-label fw-semibold small text-secondary mb-1">
                    <i class="bi bi-clipboard2-pulse me-1 text-primary"></i>Procedimiento quirúrgico *
                </label>
                <input class="form-control" autocomplete="off" placeholder="Escriba para buscar procedimiento..." @bind="_filtroProcedimiento" @bind:event="oninput" @bind:after="BuscarProcedimientosAutoAsync" @onfocus="() => _mostrarProcedimientosSugeridos = !string.IsNullOrWhiteSpace(_filtroProcedimiento)" @onblur="CerrarProcedimientosSugeridosAsync" />
                @if(_mostrarProcedimientosSugeridos && _procedimientos.Count > 0 && !string.IsNullOrWhiteSpace(_filtroProcedimiento))
                {
                    <div class="list-group position-absolute bg-white border rounded shadow mt-1 w-100" style="z-index:1060;max-height:220px;overflow-y:auto;">
                        @foreach(var x in _procedimientos){<button type="button" class="list-group-item list-group-item-action py-2 px-3 small text-start" @onmousedown="() => SeleccionarProcedimientoCirugia(x)">@x.Descripcion</button>}
                    </div>
                }
                <select class="form-select mt-2" @bind="_cirugia.IdProcedimiento">
                    @foreach(var x in _procedimientos){<option value="@x.Id">@x.Descripcion</option>}
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold small text-secondary mb-1">
                    <i class="bi bi-calendar-event me-1 text-primary"></i>Fecha *
                </label>
                <input type="date" class="form-control" value="@_cirugia.Fecha.ToString("yyyy-MM-dd")" @onchange="OnFechaCirugiaChangedAsync" min="@DateTime.Today.ToString("yyyy-MM-dd")"/>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-secondary mb-1">
                    <i class="bi bi-clock me-1 text-primary"></i>Hora inicio (libre) *
                </label>
                <select class="form-select" value="@_cirugia.HoraInicio" @onchange="OnHoraInicioCirugiaChanged" disabled="@(_slotsLibresCirugia.Count == 0)">
                    @if(_slotsLibresCirugia.Count == 0){<option value="">Sin horas libres</option>}else{<option value="">Seleccione</option>@foreach(var s in _slotsLibresCirugia){<option value="@s.Hora">@s.Hora</option>}}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-secondary mb-1">
                    <i class="bi bi-hourglass-split me-1 text-primary"></i>Hora fin / duración *
                </label>
                <select class="form-select" value="@_cirugia.HoraFin" @onchange="OnHoraFinCirugiaChanged" disabled="@(_horasFinDisponibles.Count == 0)">
                    @if(_horasFinDisponibles.Count == 0){<option value="">--</option>}else{@foreach(var hf in _horasFinDisponibles){<option value="@hf.Hora">@hf.Etiqueta</option>}}
                </select>
            </div>
            @SelectorSala
            <div class="col-md-3 d-flex align-items-end">
                <SaveButton class="btn btn-primary w-100 fw-semibold py-2" OnClick="GuardarCirugia" Disabled="@(_cirugia.IdMedico <= 0 || _cirugia.IdLocalidad <= 0 || _slotsLibresCirugia.Count == 0 || string.IsNullOrWhiteSpace(_cirugia.HoraInicio) || string.IsNullOrWhiteSpace(_cirugia.HoraFin) || HayConflictoCirujanosAdicionales || SalaPendiente)">
                    <i class="bi bi-check2-circle me-1"></i>Guardar cirugía
                </SaveButton>
            </div>

            @if(_cirugia.IdMedico > 0 && _cirugia.IdLocalidad > 0 && !_cargandoSlotsCirugia)
            {
                var citasDia = _slotsTodosCirugia.Count(s => s.CitaExistente != null);
                var bloqueosDia = _slotsTodosCirugia.Count(s => s.Bloqueado);
                if(_slotsLibresCirugia.Count == 0)
                {
                    <div class="col-12">
                        <div class="alert alert-warning py-2 px-3 mb-0 small d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>El médico no tiene horas libres para el <strong>@_cirugia.Fecha.ToString("dd/MM/yyyy")</strong> en esta sucursal (sin horario asignado, turno finalizado, o ya ocupado por citas (@citasDia) / bloqueos (@bloqueosDia)). Pruebe seleccionando otra fecha.</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <div class="d-flex flex-wrap gap-2 align-items-center small text-muted bg-light border rounded-3 px-3 py-2">
                            <span><strong>Agenda del día:</strong> @_slotsTodosCirugia[0].Hora – @_slotsTodosCirugia[^1].Hora</span>
                            <span class="badge text-bg-success">@_slotsLibresCirugia.Count libres</span>
                            <span class="badge text-bg-secondary">@citasDia citas</span>
                            <span class="badge text-bg-warning text-dark">@bloqueosDia bloqueos/cirugías</span>
                            <span class="badge text-bg-info text-dark">@_ordenesActivasMedicoHoy órdenes activas</span>
                            <span class="ms-auto text-muted">Si inicia al cierre del turno, puede elegir horas extra en <strong>Hora fin</strong>.</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
var cirugiasVisiblesModal = _cirugias.Where(x =>
    x.Estado == "A" &&
    _cirugia.IdMedico > 0 &&
    x.Fecha.Date >= DateTime.Today &&
    x.IncluyeMedico(_cirugia.IdMedico)).ToList();
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
        <div class="fw-bold text-primary">
            <i class="bi bi-calendar-check me-2"></i>Cirugías pendientes del médico seleccionado
        </div>
        @if (_cirugia.IdMedico > 0)
        {
            <span class="badge rounded-pill text-bg-primary px-3 py-2">@cirugiasVisiblesModal.Count pendiente(s)</span>
        }
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Fecha</th>
                    <th>Médico</th>
                    <th>Anestesiólogo</th>
                    <th>Paciente</th>
                    <th>Procedimiento</th>
                    <th>Horario</th>
                    <th class="text-end pe-4">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (_cirugia.IdMedico <= 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-person-check me-2"></i>Seleccione un médico para ver sus cirugías pendientes.</td></tr>
                }
                else if (cirugiasVisiblesModal.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-calendar-x me-2"></i>Este médico no tiene cirugías pendientes.</td></tr>
                }
                else
                {
                    @foreach(var x in cirugiasVisiblesModal)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@x.Fecha.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div>@x.Medico</div>
                                @if (!string.IsNullOrWhiteSpace(x.CirujanosAdicionalesNombres))
                                {
                                    <small class="text-primary d-block">+ @x.CirujanosAdicionalesNombres</small>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(x.Anestesiologo) ? "-" : x.Anestesiologo)</td>
                            <td class="fw-semibold">@x.Paciente</td>
                            <td>@x.Procedimiento</td>
                            <td><span class="badge text-bg-light border text-dark">@x.HoraInicio - @x.HoraFin</span><small class="d-block text-muted">@x.Sala</small></td>
                            <td class="text-end pe-4"><button class="btn btn-sm btn-outline-danger" @onclick="()=>CancelarCirugia(x.Id)">Cancelar</button></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
