DescripcionCirugia;}_mostrarProcedimientosSugeridos=false;}void SeleccionarProcedimientoCirugia(SelectorClinicoDto x){_cirugia.IdProcedimiento=x.Id;_filtroProcedimiento=x.Descripcion;_mostrarProcedimientosSugeridos=false;}async Task CerrarPacientesSugeridosAsync(){await Task.Delay(180);_mostrarPacientesSugeridos=false;}async Task CerrarProcedimientosSugeridosAsync(){await Task.Delay(180);_mostrarProcedimientosSugeridos=false;}async Task GuardarExcepcion(){if(_excepcion.IdMedico>0){var disp=LocalidadesExcepcionDisponibles.ToList();if(disp.Count==0){Mensaje(false,"El profesional no tiene ninguna sucursal asignada en Usuarios.");return;}if(_excepcion.IdLocalidad>0&&!disp.Any(l=>l.Id==_excepcion.IdLocalidad)){Mensaje(false,"Seleccione una sucursal asignada al profesional.");return;}}var ok=await Service.GuardarExcepcionAsync(_excepcion,Session.IdUser);Mensaje(ok,ok?"Bloqueo guardado.":"Datos inválidos o bloqueo superpuesto.");if(ok){_excepcion=new();await Cargar();}}async Task DesactivarExcepcion(int id){await Service.DesactivarExcepcionAsync(id,Session.IdUser);await Cargar();}
async Task GuardarCirugia()
{
    if (ModoModal && IdOrden > 0) _cirugia.IdOrden = IdOrden;
    if (!SalasCirugia.Any()) _cirugia.IdSala = null;

    try
    {
        var ok = await Service.GuardarCirugiaAsync(_cirugia, Session.IdUser);
        if (!ok)
        {
            await Cargar();
            Mensaje(false, "Revisa el horario del equipo y la disponibilidad de la sala.");
            return;
        }

        _cirugia = new()
        {
            IdMedico = _cirugia.IdMedico,
            IdLocalidad = _cirugia.IdLocalidad,
            Fecha = _cirugia.Fecha,
            Nhcl = ModoModal && !MostrarSelectorPacienteEnModal ? Nhcl : 0,
            IdOrden = ModoModal && IdOrden > 0 ? IdOrden : null
        };
        if (MostrarSelectorPacienteEnModal)
        {
            _filtroPaciente = "";
            _filtroProcedimiento = "";
        }
        Mensaje(true, "Cirugía programada y enviada a Bandeja de órdenes.");
        await Cargar();
        await CargarDisponibilidadMedicosCirugiaAsync();
        await CargarSlotsDisponiblesCirugiaAsync();
    }
    catch (Exception ex)
    {
        Mensaje(false, $"No se pudo completar la programación. {ex.Message}");
    }
}
