@page "/programacion/clinica"
@inject IGestionMigradaService Service
@inject SessionStateService Session
@inject NavigationManager Nav
<PageTitle>Programación clínica | e-ForVets</PageTitle>
@if (_autorizado)
{
<div class="container-fluid py-3"><h2>Horarios médicos y programación quirúrgica</h2>
<ul class="nav nav-tabs my-3"><li class="nav-item"><button class="nav-link @(_tab=="horarios"?"active":"")" @onclick='()=>Cambiar("horarios")'>Horarios semanales</button></li><li class="nav-item"><button class="nav-link @(_tab=="excepciones"?"active":"")" @onclick='()=>Cambiar("excepciones")'>Bloqueos y excepciones</button></li><li class="nav-item"><button class="nav-link @(_tab=="cirugias"?"active":"")" @onclick='()=>Cambiar("cirugias")'>Cirugías</button></li></ul>
@if(!string.IsNullOrEmpty(_mensaje)){<div class="alert @(_error?"alert-danger":"alert-success")">@_mensaje</div>}
@if(_tab=="horarios")
{<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-3"><label>Médico</label><select class="form-select" @bind="_horario.IdMedico"><option value="0">Seleccione</option>@foreach(var x in _medicos){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-2"><label>Día</label><select class="form-select" @bind="_horario.Dia">@foreach(var d in Dias.Keys){<option>@d</option>}</select></div><div class="col-md-1"><label>Desde</label><input class="form-control" @bind="_horario.Desde"/></div><div class="col-md-1"><label>Hasta</label><input class="form-control" @bind="_horario.Hasta"/></div><div class="col-md-1"><label>Minutos</label><input type="number" min="5" class="form-control" @bind="_horario.Intervalo"/></div><div class="col-md-2"><label>Localidad</label><select class="form-select" @bind="_horario.IdLocalidad"><option value="0">Seleccione</option>@foreach(var x in _localidades){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-2 align-self-end"><button class="btn btn-primary" @onclick="GuardarHorario">Guardar</button></div></div></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Médico</th><th>Día</th><th>Horario</th><th>Intervalo</th><th>Localidad</th><th></th></tr></thead><tbody>@foreach(var x in _horarios){<tr><td>@x.Medico</td><td>@x.Dia</td><td>@x.Desde - @x.Hasta</td><td>@x.Intervalo min</td><td>@x.Localidad</td><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Editar(x)">Editar</button> <button class="btn btn-sm btn-outline-danger" @onclick="()=>EliminarHorario(x.Id)">Eliminar</button></td></tr>}</tbody></table></div>}
else if(_tab=="excepciones")
{<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-3"><label>Médico</label><select class="form-select" @bind="_excepcion.IdMedico"><option value="0">Seleccione</option>@foreach(var x in _medicos){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-3"><label>Motivo</label><input class="form-control" @bind="_excepcion.Motivo"/></div><div class="col-md-2"><label>Fecha</label><input type="date" class="form-control" @bind="_excepcion.Fecha"/></div><div class="col-md-1"><label>Desde</label><input class="form-control" @bind="_excepcion.Desde"/></div><div class="col-md-1"><label>Hasta</label><input class="form-control" @bind="_excepcion.Hasta"/></div><div class="col-md-2"><label>Localidad</label><select class="form-select" @bind="_excepcion.IdLocalidad"><option value="0">Seleccione</option>@foreach(var x in _localidades){<option value="@x.Id">@x.Descripcion</option>}</select></div><div><button class="btn btn-primary" @onclick="GuardarExcepcion">Guardar bloqueo</button></div></div></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Fecha</th><th>Médico</th><th>Motivo</th><th>Horario</th><th>Localidad</th><th></th></tr></thead><tbody>@foreach(var x in _excepciones.Where(x=>x.Estado=="A")){<tr><td>@x.Fecha.ToString("yyyy-MM-dd")</td><td>@x.Medico</td><td>@x.Motivo</td><td>@x.Desde - @x.Hasta</td><td>@x.Localidad</td><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Editar(x)">Editar</button> <button class="btn btn-sm btn-outline-danger" @onclick="()=>DesactivarExcepcion(x.Id)">Desactivar</button></td></tr>}</tbody></table></div>}
else
{<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-3"><label>Médico</label><select class="form-select" @bind="_cirugia.IdMedico"><option value="0">Seleccione</option>@foreach(var x in _medicos){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-3"><label>Paciente</label><div class="input-group mb-1"><input class="form-control" placeholder="Nombre o NHCL" @bind="_filtroPaciente"/><button class="btn btn-outline-secondary" @onclick="BuscarPacientes">Buscar</button></div><select class="form-select" @bind="_cirugia.Nhcl"><option value="0">Seleccione</option>@foreach(var x in _pacientes){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-3"><label>Procedimiento</label><div class="input-group mb-1"><input class="form-control" placeholder="Descripción" @bind="_filtroProcedimiento"/><button class="btn btn-outline-secondary" @onclick="BuscarProcedimientos">Buscar</button></div><select class="form-select" @bind="_cirugia.IdProcedimiento"><option value="0">Seleccione</option>@foreach(var x in _procedimientos){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-2"><label>Localidad</label><select class="form-select" @bind="_cirugia.IdLocalidad"><option value="0">Seleccione</option>@foreach(var x in _localidades){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-2"><label>Fecha</label><input type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" @bind="_cirugia.Fecha"/></div><div class="col-md-1"><label>Inicio</label><input class="form-control" @bind="_cirugia.HoraInicio"/></div><div class="col-md-1"><label>Fin</label><input class="form-control" @bind="_cirugia.HoraFin"/></div><div class="col-md-3 align-self-end"><button class="btn btn-primary" @onclick="GuardarCirugia">Guardar cirugía</button></div></div></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Fecha</th><th>Médico</th><th>Paciente</th><th>Procedimiento</th><th>Horario</th><th></th></tr></thead><tbody>@foreach(var x in _cirugias.Where(x=>x.Estado=="A")){<tr><td>@x.Fecha.ToString("yyyy-MM-dd")</td><td>@x.Medico</td><td>@x.Paciente <small>NHCL @x.Nhcl</small></td><td>@x.Procedimiento</td><td>@x.HoraInicio - @x.HoraFin</td><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Editar(x)">Editar</button> <button class="btn btn-sm btn-outline-danger" @onclick="()=>CancelarCirugia(x.Id)">Cancelar</button></td></tr>}</tbody></table></div>}
</div>}
@code {
bool _autorizado,_error;string _tab="horarios",_mensaje="",_filtroPaciente="",_filtroProcedimiento="";HorarioMedicoDto _horario=new();ExcepcionHorarioDto _excepcion=new();CirugiaProgramadaDto _cirugia=new();List<HorarioMedicoDto> _horarios=[];List<ExcepcionHorarioDto> _excepciones=[];List<CirugiaProgramadaDto> _cirugias=[];List<SelectorClinicoDto> _medicos=[],_localidades=[],_pacientes=[],_procedimientos=[];readonly Dictionary<string,string> Dias=new(){{"Lunes","Monday"},{"Martes","Tuesday"},{"Miércoles","Wednesday"},{"Jueves","Thursday"},{"Viernes","Friday"},{"Sábado","Saturday"},{"Domingo","Sunday"}};
protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated){Nav.NavigateTo("/login");return;}_autorizado=true;var m=Service.ObtenerMedicosAsync();var l=Service.ObtenerLocalidadesSelectorAsync();var p=Service.BuscarPacientesAsync("");var pr=Service.BuscarProcedimientosAsync("");await Task.WhenAll(m,l,p,pr);_medicos=m.Result;_localidades=l.Result;_pacientes=p.Result;_procedimientos=pr.Result;await Cargar();}
async Task Cambiar(string t){_tab=t;_mensaje="";await Cargar();}async Task Cargar(){try{if(_tab=="horarios")_horarios=await Service.ObtenerHorariosAsync();else if(_tab=="excepciones")_excepciones=await Service.ObtenerExcepcionesAsync(DateTime.Today,DateTime.Today.AddMonths(6));else _cirugias=await Service.ObtenerCirugiasAsync(DateTime.Today,DateTime.Today.AddMonths(6));}catch(Exception ex){Mensaje(false,ex.Message);}}
async Task BuscarPacientes()=>_pacientes=await Service.BuscarPacientesAsync(_filtroPaciente);async Task BuscarProcedimientos()=>_procedimientos=await Service.BuscarProcedimientosAsync(_filtroProcedimiento);
void Editar(HorarioMedicoDto x)=>_horario=new(){Id=x.Id,IdMedico=x.IdMedico,Dia=x.Dia,DiaIngles=x.DiaIngles,Desde=x.Desde,Hasta=x.Hasta,Intervalo=x.Intervalo,IdLocalidad=x.IdLocalidad};void Editar(ExcepcionHorarioDto x)=>_excepcion=new(){Id=x.Id,IdMedico=x.IdMedico,Motivo=x.Motivo,Fecha=x.Fecha,Desde=x.Desde,Hasta=x.Hasta,IdLocalidad=x.IdLocalidad};void Editar(CirugiaProgramadaDto x)=>_cirugia=new(){Id=x.Id,IdMedico=x.IdMedico,Nhcl=x.Nhcl,IdProcedimiento=x.IdProcedimiento,Fecha=x.Fecha,HoraInicio=x.HoraInicio,HoraFin=x.HoraFin,IdLocalidad=x.IdLocalidad};
async Task GuardarHorario(){_horario.DiaIngles=Dias[_horario.Dia];var ok=await Service.GuardarHorarioAsync(_horario,Session.IdUser);Mensaje(ok,ok?"Horario guardado.":"Datos inválidos o cruce con otro horario.");if(ok){_horario=new();await Cargar();}}async Task EliminarHorario(int id){var ok=await Service.EliminarHorarioAsync(id,Session.IdUser);Mensaje(ok,ok?"Horario eliminado.":"No se pudo eliminar.");await Cargar();}async Task GuardarExcepcion(){var ok=await Service.GuardarExcepcionAsync(_excepcion,Session.IdUser);Mensaje(ok,ok?"Bloqueo guardado.":"Datos inválidos o bloqueo superpuesto.");if(ok){_excepcion=new();await Cargar();}}async Task DesactivarExcepcion(int id){var ok=await Service.DesactivarExcepcionAsync(id,Session.IdUser);Mensaje(ok,ok?"Bloqueo desactivado.":"No se pudo desactivar.");await Cargar();}async Task GuardarCirugia(){var ok=await Service.GuardarCirugiaAsync(_cirugia,Session.IdUser);Mensaje(ok,ok?"Cirugía programada.":"Datos inválidos, horario bloqueado o cruce de agenda.");if(ok){_cirugia=new();await Cargar();}}async Task CancelarCirugia(int id){var ok=await Service.CancelarCirugiaAsync(id,Session.IdUser);Mensaje(ok,ok?"Cirugía cancelada.":"No se pudo cancelar.");await Cargar();}void Mensaje(bool ok,string texto){_error=!ok;_mensaje=texto;}
}
