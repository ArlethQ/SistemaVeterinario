async Task CargarSlotsDisponiblesCirugiaAsync()
{
    _slotsTodosCirugia=[];
    _slotsLibresCirugia=[];
    _horasFinDisponibles=[];
    _ordenesActivasMedicoHoy=0;
    _cirugia.HoraInicio="";
    _cirugia.HoraFin="";
    if(_cirugia.IdMedico<=0||_cirugia.IdLocalidad<=0)return;
    _cargandoSlotsCirugia=true;
    try
    {
        var slotsTask = AdmisionService.ObtenerSlotsHorarioMedicoAsync(_cirugia.IdMedico,_cirugia.Fecha,_cirugia.IdLocalidad);
        var esperaTask = AdmisionService.ObtenerConteoMedicosEsperaAsync(_cirugia.Fecha,_cirugia.IdLocalidad);
        await Task.WhenAll(slotsTask, esperaTask);
        _slotsTodosCirugia = await slotsTask;
        var conteos = await esperaTask;
        _ordenesActivasMedicoHoy = conteos.FirstOrDefault(c => c.IdMedico == _cirugia.IdMedico)?.EnEspera ?? 0;
        var esHoy = _cirugia.Fecha.Date == DateTime.Today;
        var ahora = DateTime.Now.TimeOfDay;
        _slotsLibresCirugia = _slotsTodosCirugia
            .Where(s => s.Disponible && (!esHoy || (TimeSpan.TryParse(s.Hora, out var sh) && sh >= ahora)))
            .ToList();
        if(_slotsLibresCirugia.Count>0)
        {
            _cirugia.HoraInicio=_slotsLibresCirugia[0].Hora;
            RecalcularHorasFinDisponibles();
            ValidarAnestesiologoDisponible();
        }
    }
    finally
    {
        _cargandoSlotsCirugia=false;
    }
}

static string FormatearDuracionCirugia(TimeSpan duracion)
{
    var h = (int)duracion.TotalHours;
    var m = duracion.Minutes;
    if (h > 0 && m > 0) return $"{h} h {m} min";
    if (h > 0) return $"{h} h";
    return $"{m} min";
}

void RecalcularHorasFinDisponibles()
{
    _horasFinDisponibles=[];
    _cirugia.HoraFin="";
    if(string.IsNullOrWhiteSpace(_cirugia.HoraInicio)||_slotsTodosCirugia.Count==0)return;
    var idx=_slotsTodosCirugia.FindIndex(s=>s.Hora==_cirugia.HoraInicio&&s.Disponible);
    if(idx<0)return;
    if(!TimeSpan.TryParse(_cirugia.HoraInicio,out var inicioTs))return;
    var paso=TimeSpan.FromMinutes(30);
    if(_slotsTodosCirugia.Count>=2&&TimeSpan.TryParse(_slotsTodosCirugia[0].Hora,out var t0)&&TimeSpan.TryParse(_slotsTodosCirugia[1].Hora,out var t1)&&t1>t0)
        paso=t1-t0;
    TimeSpan? ultimaFin=null;
    bool detenidoPorConflicto=false;
    for(int i=idx;i<_slotsTodosCirugia.Count;i++)
    {
        if(!_slotsTodosCirugia[i].Disponible){detenidoPorConflicto=true;break;}
        if(!TimeSpan.TryParse(_slotsTodosCirugia[i].Hora,out var hi)){detenidoPorConflicto=true;break;}
        if(i>idx&&TimeSpan.TryParse(_slotsTodosCirugia[i-1].Hora,out var prev)&&(hi-prev)!=paso){break;}
        var fin=hi+paso;
        ultimaFin=fin;
        var textoFin=$"{(int)fin.TotalHours:D2}:{fin.Minutes:D2}";
        _horasFinDisponibles.Add((textoFin, $"{textoFin} ({FormatearDuracionCirugia(fin - inicioTs)})", false));
    }
    if(!detenidoPorConflicto && ultimaFin.HasValue)
    {
        var maxDia=TimeSpan.FromHours(23)+TimeSpan.FromMinutes(59);
        var limiteExtra=ultimaFin.Value+TimeSpan.FromHours(4);
        var siguienteSlotOcupado=_slotsTodosCirugia
            .Where(s=>TimeSpan.TryParse(s.Hora,out var st)&&st>=ultimaFin.Value)
            .Select(s=>TimeSpan.Parse(s.Hora))
            .OrderBy(t=>t)
            .FirstOrDefault();
        for(var extraFin=ultimaFin.Value+paso; extraFin<=limiteExtra && extraFin<=maxDia; extraFin+=paso)
        {
            if(siguienteSlotOcupado>TimeSpan.Zero && extraFin>siguienteSlotOcupado)break;
            var textoFin=$"{(int)extraFin.TotalHours:D2}:{extraFin.Minutes:D2}";
            _horasFinDisponibles.Add((textoFin, $"{textoFin} ({FormatearDuracionCirugia(extraFin - inicioTs)} · hora extra)", true));
        }
    }
    if(_horasFinDisponibles.Count>0)_cirugia.HoraFin=_horasFinDisponibles[0].Hora;
}async Task Cargar(){try{if(_tab=="horarios")_horarios=await Service.ObtenerHorariosAsync();else if(_tab=="excepciones")_excepciones=await Service.ObtenerExcepcionesAsync(DateTime.Today,DateTime.Today.AddMonths(6));else{_salasQuirofano=await Service.ObtenerSalasQuirofanoAsync();_cirugias=await Service.ObtenerCirugiasAsync(ModoModal?DateTime.Today.AddMonths(-6):DateTime.Today.AddDays(-30),DateTime.Today.AddMonths(6));if(MostrarSelectorPacienteEnModal)_ordenesCirugiaPendientes=await ConsultaService.ObtenerOrdenesCirugiaPendientesAsync();}}catch(Exception ex){Mensaje(false,ex.Message);}}
