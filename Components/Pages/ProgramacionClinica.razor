@page "/programacion/clinica"
@inject IGestionMigradaService Service
@inject SessionStateService Session
@inject NavigationManager Nav
<PageTitle>Programación clínica | e-ForVets</PageTitle>
@if(_autorizado){<div class="container-fluid py-3"><h2>Horarios médicos y programación quirúrgica</h2><ul class="nav nav-tabs my-3"><li class="nav-item"><button class="nav-link @(_tab=="horarios"?"active":"")" @onclick='()=>Cambiar("horarios")'>Horarios médicos</button></li><li class="nav-item"><button class="nav-link @(_tab=="cirugias"?"active":"")" @onclick='()=>Cambiar("cirugias")'>Cirugías</button></li></ul>@if(!string.IsNullOrEmpty(_mensaje)){<div class="alert @(_error?"alert-danger":"alert-success")">@_mensaje</div>}
@if(_tab=="horarios"){<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-2"><label>Id médico</label><input type="number" class="form-control" @bind="_horario.IdMedico"/></div><div class="col-md-2"><label>Día</label><select class="form-select" @bind="_horario.Dia">@foreach(var d in Dias.Keys){<option>@d</option>}</select></div><div class="col-md-2"><label>Desde</label><input class="form-control" placeholder="08:00" @bind="_horario.Desde"/></div><div class="col-md-2"><label>Hasta</label><input class="form-control" placeholder="17:00" @bind="_horario.Hasta"/></div><div class="col-md-1"><label>Minutos</label><input type="number" class="form-control" @bind="_horario.Intervalo"/></div><div class="col-md-1"><label>Localidad</label><input type="number" class="form-control" @bind="_horario.IdLocalidad"/></div><div class="col-md-2 align-self-end"><button class="btn btn-primary" @onclick="GuardarHorario">Guardar</button></div></div></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Médico</th><th>Día</th><th>Horario</th><th>Intervalo</th><th>Localidad</th><th></th></tr></thead><tbody>@foreach(var x in _horarios){<tr><td>@x.Medico</td><td>@x.Dia</td><td>@x.Desde - @x.Hasta</td><td>@x.Intervalo min</td><td>@x.Localidad</td><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Editar(x)">Editar</button></td></tr>}</tbody></table></div>}
else{<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-2"><label>Id médico</label><input type="number" class="form-control" @bind="_cirugia.IdMedico"/></div><div class="col-md-2"><label>NHCL</label><input type="number" class="form-control" @bind="_cirugia.Nhcl"/></div><div class="col-md-2"><label>Id procedimiento</label><input type="number" class="form-control" @bind="_cirugia.IdProcedimiento"/></div><div class="col-md-2"><label>Fecha</label><input type="date" class="form-control" @bind="_cirugia.Fecha"/></div><div class="col-md-1"><label>Inicio</label><input class="form-control" placeholder="08:00" @bind="_cirugia.HoraInicio"/></div><div class="col-md-1"><label>Fin</label><input class="form-control" placeholder="09:00" @bind="_cirugia.HoraFin"/></div><div class="col-md-1"><label>Localidad</label><input type="number" class="form-control" @bind="_cirugia.IdLocalidad"/></div><div class="col-md-1 align-self-end"><button class="btn btn-primary" @onclick="GuardarCirugia">Guardar</button></div></div></div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Fecha</th><th>Médico</th><th>Paciente</th><th>Procedimiento</th><th>Horario</th><th></th></tr></thead><tbody>@foreach(var x in _cirugias){<tr><td>@x.Fecha.ToString("yyyy-MM-dd")</td><td>@x.Medico</td><td>@x.Paciente <small>NHCL @x.Nhcl</small></td><td>@x.Procedimiento</td><td>@x.HoraInicio - @x.HoraFin</td><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Editar(x)">Editar</button></td></tr>}</tbody></table></div>}</div>}
@code{bool _autorizado,_error;string _tab="horarios",_mensaje="";HorarioMedicoDto _horario=new();CirugiaProgramadaDto _cirugia=new();List<HorarioMedicoDto> _horarios=[];List<CirugiaProgramadaDto> _cirugias=[];Dictionary<string,string>Dias=new(){{"Lunes","Monday"},{"Martes","Tuesday"},{"Miércoles","Wednesday"},{"Jueves","Thursday"},{"Viernes","Friday"},{"Sábado","Saturday"},{"Domingo","Sunday"}};protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated){Nav.NavigateTo("/login");return;}_autorizado=true;await Cargar();}async Task Cambiar(string t){_tab=t;await Cargar();}async Task Cargar(){if(_tab=="horarios")_horarios=await Service.ObtenerHorariosAsync();else _cirugias=await Service.ObtenerCirugiasAsync(DateTime.Today.AddMonths(-1),DateTime.Today.AddMonths(6));}void Editar(HorarioMedicoDto x)=>_horario=x;void Editar(CirugiaProgramadaDto x)=>_cirugia=x;async Task GuardarHorario(){_horario.DiaIngles=Dias[_horario.Dia];Mensaje(await Service.GuardarHorarioAsync(_horario,Session.IdUser));if(!_error){_horario=new();await Cargar();}}async Task GuardarCirugia(){Mensaje(await Service.GuardarCirugiaAsync(_cirugia,Session.IdUser));if(!_error){_cirugia=new();await Cargar();}}void Mensaje(bool ok){_error=!ok;_mensaje=ok?"Registro guardado.":"No se pudo guardar; revise los datos.";}}
