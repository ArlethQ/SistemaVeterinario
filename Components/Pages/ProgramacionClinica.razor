@page "/programacion/clinica"
@inject IGestionMigradaService Service
@inject SessionStateService Session
@inject NavigationManager Nav
<PageTitle>Programación clínica | e-ForVets</PageTitle>
@if(_autorizado){
<div class="container-fluid py-3">
<div class="d-flex justify-content-between"><h2>Horarios médicos y programación quirúrgica</h2>@if (Permisos.Permite("programacion/consultorios")) { <a class="btn btn-outline-primary" href="/programacion/consultorios">Gestionar pisos y consultorios</a> }</div>
<ul class="nav nav-tabs my-3"><li class="nav-item"><button class="nav-link @(_tab=="horarios"?"active":"")" @onclick='()=>Cambiar("horarios")'>Horarios semanales</button></li><li class="nav-item"><button class="nav-link @(_tab=="excepciones"?"active":"")" @onclick='()=>Cambiar("excepciones")'>Bloqueos y excepciones</button></li><li class="nav-item"><button class="nav-link @(_tab=="cirugias"?"active":"")" @onclick='()=>Cambiar("cirugias")'>Cirugías</button></li></ul>
@if(!string.IsNullOrEmpty(_mensaje)){<div class="alert @(_error?"alert-danger":"alert-success")">@_mensaje</div>}
@if(_tab=="horarios"){
<div class="card mb-3"><div class="card-body">@if(_horario.Id>0){<div class="alert alert-info py-2">Editando horario #@_horario.Id</div>}<div class="row g-2">
<div class="col-md-3"><label>Médico</label><select class="form-select" @bind="_horario.IdMedico"><option value="0">Seleccione</option>@foreach(var x in _medicos){<option value="@x.Id">@x.Descripcion</option>}</select></div>
<div class="col-md-2"><label>Día</label><select class="form-select" @bind="_horario.Dia">@foreach(var d in Dias.Keys){<option value="@d">@d</option>}</select></div>
<div class="col-md-1"><label>Desde</label><input class="form-control" @bind="_horario.Desde"/></div><div class="col-md-1"><label>Hasta</label><input class="form-control" @bind="_horario.Hasta"/></div><div class="col-md-1"><label>Minutos</label><input type="number" min="5" class="form-control" @bind="_horario.Intervalo"/></div>
<div class="col-md-2"><label>Localidad</label><select class="form-select" value="@_horario.IdLocalidad" @onchange="CambiarLocalidad"><option value="0">Seleccione</option>@foreach(var x in _localidades){<option value="@x.Id">@x.Descripcion</option>}</select></div>
<div class="col-md-3"><label>Consultorio</label><select class="form-select" value="@_consultorioId" @onchange="SeleccionarConsultorio"><option value="0">Seleccione</option>@foreach(var x in ConsultoriosDisponibles){<option value="@x.Id">@x.Piso · @x.Nombre</option>}</select></div>
<div class="col-md-1"><label>Piso</label><input class="form-control" value="@_horario.Piso" readonly/></div>
<div class="col-md-2"><label>Vigente desde</label><input type="date" class="form-control" @bind="_horario.VigenciaDesde"/></div><div class="col-md-2"><label>Vigente hasta <small>(vacío = permanente)</small></label><input type="date" class="form-control" @bind="_horario.VigenciaHasta"/></div>
<div class="col-md-3 align-self-end d-flex gap-2"><button class="btn btn-primary" @onclick="GuardarHorario">@(_horario.Id>0?"Actualizar":"Guardar")</button>@if(_horario.Id>0){<button class="btn btn-outline-secondary" @onclick="CancelarHorario">Cancelar</button>}</div>
</div></div></div>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Médico</th><th>Día</th><th>Horario</th><th>Consultorio</th><th>Vigencia</th><th>Localidad</th><th></th></tr></thead><tbody>@foreach(var x in _horarios){<tr><td>@(string.IsNullOrWhiteSpace(x.Medico)?"Sin médico":x.Medico)</td><td>@x.Dia</td><td>@x.Desde - @x.Hasta</td><td>@(string.IsNullOrWhiteSpace(x.Consultorio)?"Sin consultorio":$"Piso {x.Piso} · {x.Consultorio}")</td><td>@(x.VigenciaDesde?.ToString("dd/MM/yyyy")??"Inmediata") — @(x.VigenciaHasta?.ToString("dd/MM/yyyy")??"Permanente")</td><td>@x.Localidad</td><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Editar(x)">Editar</button> <button class="btn btn-sm btn-outline-danger" @onclick="()=>EliminarHorario(x.Id)">Eliminar</button></td></tr>}</tbody></table></div>
}else if(_tab=="excepciones"){
<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-3"><label>Médico</label><select class="form-select" @bind="_excepcion.IdMedico"><option value="0">Seleccione</option>@foreach(var x in _medicos){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-3"><label>Motivo</label><input class="form-control" @bind="_excepcion.Motivo"/></div><div class="col-md-2"><label>Fecha</label><input type="date" class="form-control" @bind="_excepcion.Fecha"/></div><div class="col-md-1"><label>Desde</label><input class="form-control" @bind="_excepcion.Desde"/></div><div class="col-md-1"><label>Hasta</label><input class="form-control" @bind="_excepcion.Hasta"/></div><div class="col-md-2"><label>Localidad</label><select class="form-select" @bind="_excepcion.IdLocalidad"><option value="0">Seleccione</option>@foreach(var x in _localidades){<option value="@x.Id">@x.Descripcion</option>}</select></div><div><button class="btn btn-primary" @onclick="GuardarExcepcion">Guardar bloqueo</button></div></div></div>
<table class="table"><thead><tr><th>Fecha</th><th>Médico</th><th>Motivo</th><th>Horario</th><th></th></tr></thead><tbody>@foreach(var x in _excepciones.Where(x=>x.Estado=="A")){<tr><td>@x.Fecha.ToString("yyyy-MM-dd")</td><td>@x.Medico</td><td>@x.Motivo</td><td>@x.Desde - @x.Hasta</td><td><button class="btn btn-sm btn-outline-danger" @onclick="()=>DesactivarExcepcion(x.Id)">Desactivar</button></td></tr>}</tbody></table>
}else{
<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-3"><label>Médico</label><select class="form-select" @bind="_cirugia.IdMedico"><option value="0">Seleccione</option>@foreach(var x in _medicos){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-3"><label>Paciente</label><input class="form-control" @bind="_filtroPaciente"/><button class="btn btn-sm btn-outline-secondary" @onclick="BuscarPacientes">Buscar</button><select class="form-select" @bind="_cirugia.Nhcl">@foreach(var x in _pacientes){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-3"><label>Procedimiento</label><input class="form-control" @bind="_filtroProcedimiento"/><button class="btn btn-sm btn-outline-secondary" @onclick="BuscarProcedimientos">Buscar</button><select class="form-select" @bind="_cirugia.IdProcedimiento">@foreach(var x in _procedimientos){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-2"><label>Localidad</label><select class="form-select" @bind="_cirugia.IdLocalidad">@foreach(var x in _localidades){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-2"><label>Fecha</label><input type="date" class="form-control" @bind="_cirugia.Fecha"/></div><div class="col-md-1"><label>Inicio</label><input class="form-control" @bind="_cirugia.HoraInicio"/></div><div class="col-md-1"><label>Fin</label><input class="form-control" @bind="_cirugia.HoraFin"/></div><div class="col-md-2 align-self-end"><button class="btn btn-primary" @onclick="GuardarCirugia">Guardar cirugía</button></div></div></div>
<table class="table"><thead><tr><th>Fecha</th><th>Médico</th><th>Paciente</th><th>Procedimiento</th><th>Horario</th><th></th></tr></thead><tbody>@foreach(var x in _cirugias.Where(x=>x.Estado=="A")){<tr><td>@x.Fecha.ToString("yyyy-MM-dd")</td><td>@x.Medico</td><td>@x.Paciente</td><td>@x.Procedimiento</td><td>@x.HoraInicio - @x.HoraFin</td><td><button class="btn btn-sm btn-outline-danger" @onclick="()=>CancelarCirugia(x.Id)">Cancelar</button></td></tr>}</tbody></table>
}</div>}
@code{
[CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
bool _autorizado,_error;string _tab="horarios",_mensaje="",_filtroPaciente="",_filtroProcedimiento="";int _consultorioId;HorarioMedicoDto _horario=new();ExcepcionHorarioDto _excepcion=new();CirugiaProgramadaDto _cirugia=new();List<HorarioMedicoDto> _horarios=[];List<ExcepcionHorarioDto> _excepciones=[];List<CirugiaProgramadaDto> _cirugias=[];List<PisoClinicoDto> _pisos=[];List<ConsultorioClinicoDto> _consultorios=[];List<SelectorClinicoDto> _medicos=[],_localidades=[],_pacientes=[],_procedimientos=[];readonly Dictionary<string,string> Dias=new(){{"Lunes","Monday"},{"Martes","Tuesday"},{"Miércoles","Wednesday"},{"Jueves","Thursday"},{"Viernes","Friday"},{"Sábado","Saturday"},{"Domingo","Sunday"}};
IEnumerable<ConsultorioClinicoDto> ConsultoriosDisponibles=>_consultorios.Where(c=>_horario.IdLocalidad==0||_pisos.Any(p=>p.Id==c.IdPiso&&p.IdLocalidad==_horario.IdLocalidad));
protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated){Nav.NavigateTo("/login");return;}_autorizado=true;var m=Service.ObtenerMedicosAsync();var l=Service.ObtenerLocalidadesSelectorAsync();var p=Service.BuscarPacientesAsync("");var pr=Service.BuscarProcedimientosAsync("");var pi=Service.ObtenerPisosAsync(true);var co=Service.ObtenerConsultoriosAsync(true);await Task.WhenAll(m,l,p,pr,pi,co);_medicos=await m;_localidades=await l;_pacientes=await p;_procedimientos=await pr;_pisos=await pi;_consultorios=await co;await Cargar();}
async Task Cambiar(string t){_tab=t;_mensaje="";await Cargar();}async Task Cargar(){try{if(_tab=="horarios")_horarios=await Service.ObtenerHorariosAsync();else if(_tab=="excepciones")_excepciones=await Service.ObtenerExcepcionesAsync(DateTime.Today,DateTime.Today.AddMonths(6));else _cirugias=await Service.ObtenerCirugiasAsync(DateTime.Today,DateTime.Today.AddMonths(6));}catch(Exception ex){Mensaje(false,ex.Message);}}
void CambiarLocalidad(ChangeEventArgs e){_horario.IdLocalidad=int.TryParse(e.Value?.ToString(),out var id)?id:0;_consultorioId=0;_horario.Piso=_horario.Consultorio="";}void SeleccionarConsultorio(ChangeEventArgs e){_consultorioId=int.TryParse(e.Value?.ToString(),out var id)?id:0;var c=_consultorios.FirstOrDefault(x=>x.Id==_consultorioId);_horario.Piso=c?.Piso??"";_horario.Consultorio=c?.Nombre??"";}
void Editar(HorarioMedicoDto x){_horario=new(){Id=x.Id,IdMedico=x.IdMedico,Dia=x.Dia,DiaIngles=x.DiaIngles,Desde=x.Desde,Hasta=x.Hasta,Intervalo=x.Intervalo,IdLocalidad=x.IdLocalidad,Piso=x.Piso,Consultorio=x.Consultorio,VigenciaDesde=x.VigenciaDesde,VigenciaHasta=x.VigenciaHasta};_consultorioId=_consultorios.FirstOrDefault(c=>c.Nombre.Equals(x.Consultorio,StringComparison.OrdinalIgnoreCase)&&c.Piso.Equals(x.Piso,StringComparison.OrdinalIgnoreCase))?.Id??0;_mensaje="";}void CancelarHorario(){_horario=new();_consultorioId=0;_mensaje="";}
async Task GuardarHorario(){try{if(_consultorioId<=0){Mensaje(false,"Seleccione un consultorio del catálogo.");return;}_horario.DiaIngles=Dias[_horario.Dia];var ok=await Service.GuardarHorarioAsync(_horario,Session.IdUser);Mensaje(ok,ok?"Horario guardado.":"El horario se cruza con otro registro del médico o contiene datos inválidos.");if(ok){CancelarHorario();await Cargar();}}catch(Exception ex){Mensaje(false,$"No se pudo guardar el horario: {ex.Message}");}}async Task EliminarHorario(int id){await Service.EliminarHorarioAsync(id,Session.IdUser);await Cargar();}
async Task BuscarPacientes()=>_pacientes=await Service.BuscarPacientesAsync(_filtroPaciente);async Task BuscarProcedimientos()=>_procedimientos=await Service.BuscarProcedimientosAsync(_filtroProcedimiento);async Task GuardarExcepcion(){var ok=await Service.GuardarExcepcionAsync(_excepcion,Session.IdUser);Mensaje(ok,ok?"Bloqueo guardado.":"Datos inválidos o bloqueo superpuesto.");if(ok){_excepcion=new();await Cargar();}}async Task DesactivarExcepcion(int id){await Service.DesactivarExcepcionAsync(id,Session.IdUser);await Cargar();}async Task GuardarCirugia(){var ok=await Service.GuardarCirugiaAsync(_cirugia,Session.IdUser);Mensaje(ok,ok?"Cirugía programada.":"Datos inválidos o cruce de agenda.");if(ok){_cirugia=new();await Cargar();}}async Task CancelarCirugia(int id){await Service.CancelarCirugiaAsync(id,Session.IdUser);await Cargar();}void Mensaje(bool ok,string t){_error=!ok;_mensaje=t;}
}
