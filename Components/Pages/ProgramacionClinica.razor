@page "/programacion/clinica"
@inject IGestionMigradaService Service
@inject SessionStateService Session
@inject NavigationManager Nav
<PageTitle>Programación clínica | e-ForVets</PageTitle>
@if(_autorizado){
<div class="container-fluid py-3">
<div class="d-flex justify-content-between"><h2>Horarios clínicos y programación quirúrgica</h2>@if (Permisos.Permite("programacion/consultorios")) { <a class="btn btn-outline-primary" href="/programacion/consultorios">Gestionar pisos y consultorios</a> }</div>
<ul class="nav nav-tabs my-3"><li class="nav-item"><button class="nav-link @(_tab=="horarios"?"active":"")" @onclick='()=>Cambiar("horarios")'>Horarios semanales</button></li><li class="nav-item"><button class="nav-link @(_tab=="excepciones"?"active":"")" @onclick='()=>Cambiar("excepciones")'>Bloqueos y excepciones</button></li><li class="nav-item"><button class="nav-link @(_tab=="cirugias"?"active":"")" @onclick='()=>Cambiar("cirugias")'>Cirugías</button></li></ul>
@if(!string.IsNullOrEmpty(_mensaje)){<div class="alert @(_error?"alert-danger":"alert-success")">@_mensaje</div>}
@if(_tab=="horarios"){
<div class="card mb-3"><div class="card-body">@if(_horario.Id>0){<div class="alert alert-info py-2">Editando horario #@_horario.Id</div>}<div class="row g-2">
<div class="col-md-3"><label>Profesional (Médico / Enfermero)</label><select class="form-select" value="@_horario.IdMedico" @onchange="SeleccionarProfesionalHorario"><option value="0">Seleccione</option>@foreach(var x in _medicos){<option value="@x.Id">@x.Descripcion</option>}</select></div>
<div class="col-md-2"><label>Día</label><select class="form-select" @bind="_horario.Dia">@foreach(var d in Dias.Keys){<option value="@d">@d</option>}</select></div>
<div class="col-md-1"><label>Desde</label><input type="time" class="form-control" value="@_horario.Desde" @onchange="e => _horario.Desde = e.Value?.ToString() ?? string.Empty"/></div><div class="col-md-1"><label>Hasta</label><input type="time" class="form-control" value="@_horario.Hasta" @onchange="e => _horario.Hasta = e.Value?.ToString() ?? string.Empty"/></div><div class="col-md-1"><label>Minutos</label><input type="number" min="5" class="form-control" @bind="_horario.Intervalo"/></div>
<div class="col-md-2"><label>Localidad</label><select class="form-select @(_horario.IdMedico > 0 && !LocalidadesDisponibles.Any() ? "is-invalid" : "")" value="@_horario.IdLocalidad" @onchange="CambiarLocalidad"><option value="0">@(_horario.IdMedico > 0 && !LocalidadesDisponibles.Any() ? "Sin sucursal asignada" : "Seleccione")</option>@foreach(var x in LocalidadesDisponibles){<option value="@x.Id">@x.Descripcion</option>}</select></div>
@if(EsProfesionalEnfermero(_horario.IdMedico)){
<div class="col-md-4"><label>Ubicación / Consultorio</label><input class="form-control text-muted bg-light" value="Área General (Sin consultorio asignado)" readonly title="Los enfermeros no tienen consultorio ni piso asignado"/></div>
}else{
<div class="col-md-3"><label>Consultorio</label><select class="form-select" value="@_consultorioId" @onchange="SeleccionarConsultorio"><option value="0">Seleccione</option>@foreach(var x in ConsultoriosDisponibles){<option value="@x.Id">@x.Piso · @x.Nombre</option>}</select></div>
<div class="col-md-1"><label>Piso</label><input class="form-control" value="@_horario.Piso" readonly/></div>
}
<div class="col-md-2"><label>Vigente desde</label><input type="date" class="form-control" @bind="_horario.VigenciaDesde"/></div><div class="col-md-2"><label>Vigente hasta <small>(vacío = permanente)</small></label><input type="date" class="form-control" @bind="_horario.VigenciaHasta"/></div>
<div class="col-md-3 align-self-end d-flex gap-2"><SaveButton class="btn btn-primary" OnClick="GuardarHorario">@(_horario.Id>0?"Actualizar":"Guardar")</SaveButton>@if(_horario.Id>0){<button class="btn btn-outline-secondary" @onclick="CancelarHorario">Cancelar</button>}</div>
</div></div></div>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Profesional</th><th>Día</th><th>Horario</th><th>Consultorio</th><th>Vigencia</th><th>Localidad</th><th></th></tr></thead><tbody>@foreach(var x in _horarios){<tr><td>@(string.IsNullOrWhiteSpace(x.Medico)?"Sin asignar":x.Medico)</td><td>@x.Dia</td><td>@x.Desde - @x.Hasta</td><td>@(string.IsNullOrWhiteSpace(x.Consultorio)?"Sin consultorio":(x.Consultorio.Contains("General", StringComparison.OrdinalIgnoreCase)?x.Consultorio:$"Piso {x.Piso} · {x.Consultorio}"))</td><td>@(x.VigenciaDesde?.ToString("dd/MM/yyyy")??"Inmediata") — @(x.VigenciaHasta?.ToString("dd/MM/yyyy")??"Permanente")</td><td>@x.Localidad</td><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Editar(x)">Editar</button> <button class="btn btn-sm btn-outline-danger" @onclick="()=>EliminarHorario(x.Id)">Eliminar</button></td></tr>}</tbody></table></div>
}else if(_tab=="excepciones"){
<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-3"><label>Profesional (Médico / Enfermero)</label><select class="form-select" value="@_excepcion.IdMedico" @onchange="SeleccionarProfesionalExcepcion"><option value="0">Seleccione</option>@foreach(var x in _medicos){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-3"><label>Motivo</label><input class="form-control" @bind="_excepcion.Motivo"/></div><div class="col-md-2"><label>Fecha</label><input type="date" class="form-control" @bind="_excepcion.Fecha"/></div><div class="col-md-1"><label>Desde</label><input class="form-control" @bind="_excepcion.Desde"/></div><div class="col-md-1"><label>Hasta</label><input class="form-control" @bind="_excepcion.Hasta"/></div><div class="col-md-2"><label>Localidad</label><select class="form-select @(_excepcion.IdMedico > 0 && !LocalidadesExcepcionDisponibles.Any() ? "is-invalid" : "")" @bind="_excepcion.IdLocalidad"><option value="0">@(_excepcion.IdMedico > 0 && !LocalidadesExcepcionDisponibles.Any() ? "Sin sucursal asignada" : "Seleccione")</option>@foreach(var x in LocalidadesExcepcionDisponibles){<option value="@x.Id">@x.Descripcion</option>}</select></div><div><SaveButton class="btn btn-primary" OnClick="GuardarExcepcion">Guardar bloqueo</SaveButton></div></div></div>
<table class="table"><thead><tr><th>Fecha</th><th>Profesional</th><th>Motivo</th><th>Horario</th><th></th></tr></thead><tbody>@foreach(var x in _excepciones.Where(x=>x.Estado=="A")){<tr><td>@x.Fecha.ToString("yyyy-MM-dd")</td><td>@x.Medico</td><td>@x.Motivo</td><td>@x.Desde - @x.Hasta</td><td><button class="btn btn-sm btn-outline-danger" @onclick="()=>DesactivarExcepcion(x.Id)">Desactivar</button></td></tr>}</tbody></table>
}else{
<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-3"><label>Médico</label><select class="form-select" @bind="_cirugia.IdMedico"><option value="0">Seleccione</option>@foreach(var x in _medicos){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-3 position-relative"><label>Paciente</label><input class="form-control" autocomplete="off" placeholder="Escriba para buscar paciente..." @bind="_filtroPaciente" @bind:event="oninput" @bind:after="BuscarPacientesAutoAsync" @onfocus="() => _mostrarPacientesSugeridos = !string.IsNullOrWhiteSpace(_filtroPaciente)" @onblur="CerrarPacientesSugeridosAsync" />@if(_mostrarPacientesSugeridos && _pacientes.Count > 0 && !string.IsNullOrWhiteSpace(_filtroPaciente)){<div class="list-group position-absolute bg-white border rounded shadow-sm mt-1 w-100" style="z-index:1050;max-height:200px;overflow-y:auto;">@foreach(var x in _pacientes){<button type="button" class="list-group-item list-group-item-action py-1 px-2 small text-start" @onmousedown="() => SeleccionarPacienteCirugia(x)">@x.Descripcion</button>}</div>}<select class="form-select mt-1" @bind="_cirugia.Nhcl">@foreach(var x in _pacientes){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-3 position-relative"><label>Procedimiento</label><input class="form-control" autocomplete="off" placeholder="Escriba para buscar procedimiento..." @bind="_filtroProcedimiento" @bind:event="oninput" @bind:after="BuscarProcedimientosAutoAsync" @onfocus="() => _mostrarProcedimientosSugeridos = !string.IsNullOrWhiteSpace(_filtroProcedimiento)" @onblur="CerrarProcedimientosSugeridosAsync" />@if(_mostrarProcedimientosSugeridos && _procedimientos.Count > 0 && !string.IsNullOrWhiteSpace(_filtroProcedimiento)){<div class="list-group position-absolute bg-white border rounded shadow-sm mt-1 w-100" style="z-index:1050;max-height:200px;overflow-y:auto;">@foreach(var x in _procedimientos){<button type="button" class="list-group-item list-group-item-action py-1 px-2 small text-start" @onmousedown="() => SeleccionarProcedimientoCirugia(x)">@x.Descripcion</button>}</div>}<select class="form-select mt-1" @bind="_cirugia.IdProcedimiento">@foreach(var x in _procedimientos){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-2"><label>Localidad</label><select class="form-select" @bind="_cirugia.IdLocalidad">@foreach(var x in _localidades){<option value="@x.Id">@x.Descripcion</option>}</select></div><div class="col-md-2"><label>Fecha</label><input type="date" class="form-control" @bind="_cirugia.Fecha"/></div><div class="col-md-1"><label>Inicio</label><input class="form-control" @bind="_cirugia.HoraInicio"/></div><div class="col-md-1"><label>Fin</label><input class="form-control" @bind="_cirugia.HoraFin"/></div><div class="col-md-2 align-self-end"><SaveButton class="btn btn-primary" OnClick="GuardarCirugia">Guardar cirugía</SaveButton></div></div></div>
<table class="table"><thead><tr><th>Fecha</th><th>Médico</th><th>Paciente</th><th>Procedimiento</th><th>Horario</th><th></th></tr></thead><tbody>@foreach(var x in _cirugias.Where(x=>x.Estado=="A")){<tr><td>@x.Fecha.ToString("yyyy-MM-dd")</td><td>@x.Medico</td><td>@x.Paciente</td><td>@x.Procedimiento</td><td>@x.HoraInicio - @x.HoraFin</td><td><button class="btn btn-sm btn-outline-danger" @onclick="()=>CancelarCirugia(x.Id)">Cancelar</button></td></tr>}</tbody></table>
}</div>}
@code{
[SupplyParameterFromQuery(Name = "medico")] public int? MedicoAgenda { get; set; }
[CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
bool _autorizado,_error,_mostrarPacientesSugeridos,_mostrarProcedimientosSugeridos;string _tab="horarios",_mensaje="",_filtroPaciente="",_filtroProcedimiento="";int _consultorioId;HorarioMedicoDto _horario=new();ExcepcionHorarioDto _excepcion=new();CirugiaProgramadaDto _cirugia=new();List<HorarioMedicoDto> _horarios=[];List<ExcepcionHorarioDto> _excepciones=[];List<CirugiaProgramadaDto> _cirugias=[];List<PisoClinicoDto> _pisos=[];List<ConsultorioClinicoDto> _consultorios=[];List<SelectorClinicoDto> _medicos=[],_localidades=[],_pacientes=[],_procedimientos=[];Dictionary<int, List<int>> _localidadesAsignadas=[];readonly Dictionary<string,string> Dias=new(){{"Lunes","Monday"},{"Martes","Tuesday"},{"Miércoles","Wednesday"},{"Jueves","Thursday"},{"Viernes","Friday"},{"Sábado","Saturday"},{"Domingo","Sunday"}};
IEnumerable<ConsultorioClinicoDto> ConsultoriosDisponibles=>_consultorios.Where(c=>_horario.IdLocalidad==0||_pisos.Any(p=>p.Id==c.IdPiso&&p.IdLocalidad==_horario.IdLocalidad));
IEnumerable<SelectorClinicoDto> LocalidadesDisponibles =>
    _horario.IdMedico <= 0
        ? _localidades
        : (_localidadesAsignadas.TryGetValue(_horario.IdMedico, out var ids) && ids.Count > 0
            ? _localidades.Where(l => ids.Contains(l.Id))
            : Enumerable.Empty<SelectorClinicoDto>());

IEnumerable<SelectorClinicoDto> LocalidadesExcepcionDisponibles =>
    _excepcion.IdMedico <= 0
        ? _localidades
        : (_localidadesAsignadas.TryGetValue(_excepcion.IdMedico, out var ids) && ids.Count > 0
            ? _localidades.Where(l => ids.Contains(l.Id))
            : Enumerable.Empty<SelectorClinicoDto>());

protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated){Nav.NavigateTo("/login");return;}_autorizado=true;var m=Service.ObtenerMedicosAsync();var l=Service.ObtenerLocalidadesSelectorAsync();var p=Service.BuscarPacientesAsync("");var pr=Service.BuscarProcedimientosAsync("");var pi=Service.ObtenerPisosAsync(true);var co=Service.ObtenerConsultoriosAsync(true);var la=Service.ObtenerLocalidadesAsignadasMedicosAsync();await Task.WhenAll(m,l,p,pr,pi,co,la);_medicos=await m;_localidades=await l;_pacientes=await p;_procedimientos=await pr;_pisos=await pi;_consultorios=await co;var asignaciones=await la;_localidadesAsignadas=asignaciones.GroupBy(a=>a.IdUsuario).ToDictionary(g=>g.Key,g=>g.Select(x=>x.IdLocalidad).Distinct().ToList());await Cargar();}
bool EsProfesionalEnfermero(int idMedico) =>
    _medicos.FirstOrDefault(m => m.Id == idMedico)?.Rol == "Enfermero" ||
    _medicos.FirstOrDefault(m => m.Id == idMedico)?.Descripcion.Contains("Enfermería", StringComparison.OrdinalIgnoreCase) == true;

void ActualizarLocalidadSegunProfesional()
{
    var disponibles = LocalidadesDisponibles.ToList();
    if (_horario.IdLocalidad > 0 && !disponibles.Any(l => l.Id == _horario.IdLocalidad))
    {
        _horario.IdLocalidad = disponibles.Count == 1 ? disponibles[0].Id : 0;
        _consultorioId = 0;
        if (!EsProfesionalEnfermero(_horario.IdMedico))
        {
            _horario.Piso = "";
            _horario.Consultorio = "";
        }
    }
    else if (_horario.IdLocalidad == 0 && disponibles.Count == 1)
    {
        _horario.IdLocalidad = disponibles[0].Id;
    }
}

void SeleccionarProfesionalHorario(ChangeEventArgs e)
{
    _horario.IdMedico = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
    ActualizarLocalidadSegunProfesional();
    if (EsProfesionalEnfermero(_horario.IdMedico))
    {
        _consultorioId = 0;
        _horario.Piso = "General";
        _horario.Consultorio = "Área General";
    }
    else if (_horario.Consultorio == "Área General")
    {
        _horario.Piso = "";
        _horario.Consultorio = "";
    }
}

void SeleccionarProfesionalExcepcion(ChangeEventArgs e)
{
    _excepcion.IdMedico = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
    var disponibles = LocalidadesExcepcionDisponibles.ToList();
    if (_excepcion.IdLocalidad > 0 && !disponibles.Any(l => l.Id == _excepcion.IdLocalidad))
    {
        _excepcion.IdLocalidad = disponibles.Count == 1 ? disponibles[0].Id : 0;
    }
    else if (_excepcion.IdLocalidad == 0 && disponibles.Count == 1)
    {
        _excepcion.IdLocalidad = disponibles[0].Id;
    }
}

protected override void OnParametersSet()
{
    if (_horario.Id == 0 && MedicoAgenda is int medico && _medicos.Any(m => m.Id == medico))
    {
        _horario.IdMedico = medico;
        if (EsProfesionalEnfermero(medico))
        {
            _consultorioId = 0;
            _horario.Piso = "General";
            _horario.Consultorio = "Área General";
        }
        ActualizarLocalidadSegunProfesional();
        if (_horario.IdLocalidad == 0 && LocalidadesDisponibles.Any(l => l.Id == Session.Localidad))
            _horario.IdLocalidad = Session.Localidad;
    }
}

async Task Cambiar(string t){_tab=t;_mensaje="";await Cargar();}async Task Cargar(){try{if(_tab=="horarios")_horarios=await Service.ObtenerHorariosAsync();else if(_tab=="excepciones")_excepciones=await Service.ObtenerExcepcionesAsync(DateTime.Today,DateTime.Today.AddMonths(6));else _cirugias=await Service.ObtenerCirugiasAsync(DateTime.Today,DateTime.Today.AddMonths(6));}catch(Exception ex){Mensaje(false,ex.Message);}}
void CambiarLocalidad(ChangeEventArgs e){_horario.IdLocalidad=int.TryParse(e.Value?.ToString(),out var id)?id:0;if(!EsProfesionalEnfermero(_horario.IdMedico)){_consultorioId=0;_horario.Piso=_horario.Consultorio="";}}void SeleccionarConsultorio(ChangeEventArgs e){_consultorioId=int.TryParse(e.Value?.ToString(),out var id)?id:0;var c=_consultorios.FirstOrDefault(x=>x.Id==_consultorioId);_horario.Piso=c?.Piso??"";_horario.Consultorio=c?.Nombre??"";}
void Editar(HorarioMedicoDto x){_horario=new(){Id=x.Id,IdMedico=x.IdMedico,Dia=x.Dia,DiaIngles=x.DiaIngles,Desde=x.Desde,Hasta=x.Hasta,Intervalo=x.Intervalo,IdLocalidad=x.IdLocalidad,Piso=x.Piso,Consultorio=x.Consultorio,VigenciaDesde=x.VigenciaDesde,VigenciaHasta=x.VigenciaHasta};if(EsProfesionalEnfermero(x.IdMedico)){_consultorioId=0;_horario.Piso="General";_horario.Consultorio="Área General";}else{_consultorioId=_consultorios.FirstOrDefault(c=>c.Nombre.Equals(x.Consultorio,StringComparison.OrdinalIgnoreCase)&&c.Piso.Equals(x.Piso,StringComparison.OrdinalIgnoreCase))?.Id??0;}_mensaje="";}void CancelarHorario(){_horario=new();_consultorioId=0;_mensaje="";}
async Task GuardarHorario(){try{if(_horario.IdMedico<=0){Mensaje(false,"Seleccione un profesional.");return;}var disponibles=LocalidadesDisponibles.ToList();if(disponibles.Count==0){Mensaje(false,"El profesional no tiene ninguna sucursal asignada en Usuarios.");return;}if(_horario.IdLocalidad<=0||!disponibles.Any(l=>l.Id==_horario.IdLocalidad)){Mensaje(false,"Seleccione una sucursal asignada al profesional.");return;}bool esEnf=EsProfesionalEnfermero(_horario.IdMedico);if(!esEnf&&_consultorioId<=0){Mensaje(false,"Seleccione un consultorio del catálogo.");return;}if(esEnf){_horario.Piso="General";_horario.Consultorio="Área General";}_horario.DiaIngles=Dias[_horario.Dia];var ok=await Service.GuardarHorarioAsync(_horario,Session.IdUser);Mensaje(ok,ok?"Horario guardado.":"El horario se cruza con otro registro del médico o contiene datos inválidos.");if(ok){_horario.Id=0;await Cargar();}}catch(Exception ex){Mensaje(false,$"No se pudo guardar el horario: {ex.Message}");}}async Task EliminarHorario(int id){await Service.EliminarHorarioAsync(id,Session.IdUser);await Cargar();}
async Task BuscarPacientes()=>_pacientes=await Service.BuscarPacientesAsync(_filtroPaciente);async Task BuscarProcedimientos()=>_procedimientos=await Service.BuscarProcedimientosAsync(_filtroProcedimiento);async Task BuscarPacientesAutoAsync(){await BuscarPacientes();_mostrarPacientesSugeridos=!string.IsNullOrWhiteSpace(_filtroPaciente)&&_pacientes.Count>0;if(_pacientes.Count>0)_cirugia.Nhcl=_pacientes[0].Id;}async Task BuscarProcedimientosAutoAsync(){await BuscarProcedimientos();_mostrarProcedimientosSugeridos=!string.IsNullOrWhiteSpace(_filtroProcedimiento)&&_procedimientos.Count>0;if(_procedimientos.Count>0)_cirugia.IdProcedimiento=_procedimientos[0].Id;}void SeleccionarPacienteCirugia(SelectorClinicoDto x){_cirugia.Nhcl=x.Id;_filtroPaciente=x.Descripcion;_mostrarPacientesSugeridos=false;}void SeleccionarProcedimientoCirugia(SelectorClinicoDto x){_cirugia.IdProcedimiento=x.Id;_filtroProcedimiento=x.Descripcion;_mostrarProcedimientosSugeridos=false;}async Task CerrarPacientesSugeridosAsync(){await Task.Delay(180);_mostrarPacientesSugeridos=false;}async Task CerrarProcedimientosSugeridosAsync(){await Task.Delay(180);_mostrarProcedimientosSugeridos=false;}async Task GuardarExcepcion(){if(_excepcion.IdMedico>0){var disp=LocalidadesExcepcionDisponibles.ToList();if(disp.Count==0){Mensaje(false,"El profesional no tiene ninguna sucursal asignada en Usuarios.");return;}if(_excepcion.IdLocalidad>0&&!disp.Any(l=>l.Id==_excepcion.IdLocalidad)){Mensaje(false,"Seleccione una sucursal asignada al profesional.");return;}}var ok=await Service.GuardarExcepcionAsync(_excepcion,Session.IdUser);Mensaje(ok,ok?"Bloqueo guardado.":"Datos inválidos o bloqueo superpuesto.");if(ok){_excepcion=new();await Cargar();}}async Task DesactivarExcepcion(int id){await Service.DesactivarExcepcionAsync(id,Session.IdUser);await Cargar();}async Task GuardarCirugia(){var ok=await Service.GuardarCirugiaAsync(_cirugia,Session.IdUser);Mensaje(ok,ok?"Cirugía programada.":"Datos inválidos o cruce de agenda.");if(ok){_cirugia=new();await Cargar();}}async Task CancelarCirugia(int id){await Service.CancelarCirugiaAsync(id,Session.IdUser);await Cargar();}void Mensaje(bool ok,string t){_error=!ok;_mensaje=t;}
}
