@page "/olvide-contrasena"
@layout Layout.PublicLayout

<PageTitle>Olvidé mi contraseña | e-ForVets</PageTitle>
<AuthPageShell Title="Recupera tu acceso" Description="Solicita ayuda para restablecer tu contraseña.">
    <div class="info-message" role="status">La recuperación automática permanece deshabilitada hasta configurar tokens de un solo uso y correo seguro. Solicita el restablecimiento a un administrador autorizado.</div>
