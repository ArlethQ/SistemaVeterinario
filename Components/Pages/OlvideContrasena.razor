@page "/olvide-contrasena"
@layout Layout.PublicLayout
<PageTitle>Olvidé mi contraseña | e-ForVets</PageTitle>
<div class="account-page"><a class="account-brand" href="/"><img src="/favicon.png" alt="" /><strong>e-ForVets</strong></a><section class="account-card compact"><div class="recovery-icon">✉</div><div class="account-heading"><span>Recuperación de acceso</span><h1>¿Olvidaste tu contraseña?</h1><p>Ingresa el correo asociado a tu cuenta para solicitar instrucciones de recuperación.</p></div>
    @if (_solicitado) { <div class="info-message" role="status">El envío de correos todavía no está conectado. No se envió ningún mensaje.</div> }
    <form @onsubmit="Enviar" @onsubmit:preventDefault><label>Correo electrónico<input required type="email" autocomplete="email" @bind="_correo" placeholder="nombre@correo.com" /></label><button class="submit-button" type="submit">Enviar instrucciones</button></form><p class="account-footer"><a href="/login">← Volver a iniciar sesión</a></p>
</section></div>
@code { private string _correo=""; private bool _solicitado; private void Enviar()=>_solicitado=true; }
