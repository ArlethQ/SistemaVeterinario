@page "/administracion/usuarios"
@using HosvetKardex.Web.Components.Layout
@inject SessionStateService Session
@inject IAuthService AuthService
@inject NavigationManager Nav
<PageTitle>Usuarios | e-ForVets</PageTitle>

@if (_autorizado)
{
<div class="users-page">
    <SecurityNav />
    <header class="page-head"><div><span>Seguridad y personal</span><h1>Usuarios</h1><p>Crea cuentas, registra el perfil laboral y asigna roles de acceso.</p></div><button type="button" class="primary" @onclick="Nuevo">+ Nuevo usuario</button></header>
    @if (!string.IsNullOrWhiteSpace(_mensaje)) { <div class="message @(_error ? "error" : "success")" role="status">@_mensaje</div> }
    <div class="toolbar"><input type="search" @bind="_filtro" @bind:event="oninput" placeholder="Buscar por nombre, usuario o correo" /><select @bind="_estadoFiltro"><option value="">Todos los estados</option><option value="A">Activos</option><option value="I">Inactivos</option></select></div>
    @if (_cargando) { <div class="state">Cargando usuarios...</div> }
    else if (_usuarios.Count == 0) { <div class="state">No fue posible obtener usuarios desde la base de datos.</div> }
    else
    {
        <div class="users-table"><div class="table-head"><span>Usuario</span><span>Rol</span><span>Contacto</span><span>Estado</span><span>Acciones</span></div>
        @foreach (var u in Filtrados)
        {
            <div class="table-row"><span class="person"><b>@Iniciales(u)</b><span><strong>@u.Nombre</strong><small>@@@u.Login</small></span></span><span><em>@Rol(u.RolId)</em>@if(u.RolId == 2 && !string.IsNullOrWhiteSpace(u.Especialidad)){<small>@u.Especialidad</small>}</span><span><strong class="contact">@u.Email</strong><small>@u.Celular</small></span><span><i class="status-dot @(u.Estado == "A" ? "active" : "inactive")"></i>@(u.Estado == "A" ? "Activo" : "Inactivo")</span><span class="actions"><button title="Editar usuario" @onclick="() => Editar(u)">Editar</button><a href="@($"/administracion/roles-permisos?usuario={u.Id}")">Permisos</a><button title="Restablecer contraseña" @onclick="() => PrepararClave(u)">Contraseña</button><button class="danger" @onclick="() => CambiarEstado(u)">@(u.Estado == "A" ? "Desactivar" : "Activar")</button></span></div>
        }
        </div>
    }
</div>

@if (_mostrarEditor)
{
    <div class="modal-backdrop" role="presentation" @onclick="CerrarEditor"><section class="editor-modal" role="dialog" aria-modal="true" aria-labelledby="user-editor-title" @onclick:stopPropagation><header><div><span>@(_edit.Id == 0 ? "Nueva cuenta" : "Editar cuenta")</span><h2 id="user-editor-title">@(_edit.Id == 0 ? "Crear usuario y perfil" : _edit.Nombre)</h2></div><button aria-label="Cerrar" @onclick="CerrarEditor">×</button></header><div class="editor-body">
        <h3 class="editor-section-title">Cuenta y contacto</h3><div class="form-grid"><label>Nombre completo<input @bind="_edit.Nombre" /></label><label>Usuario de acceso<input autocomplete="off" @bind="_edit.Login" /></label><label>Correo electrónico<input type="email" @bind="_edit.Email" /></label><label>Celular<input @bind="_edit.Celular" /></label><label>Teléfono convencional<input @bind="_edit.Convencional" /></label><label>Cédula / identificación<input @bind="_edit.Cedula" /></label><label>Iniciales<input maxlength="4" @bind="_edit.Iniciales" /></label><label>Rol<select @bind="_edit.RolId"><option value="0">Seleccione</option>@foreach(var r in _roles){<option value="@r.Id">@r.Descripcion</option>}</select></label>@if(_edit.Id==0){<label class="wide">Contraseña temporal<input type="password" minlength="8" autocomplete="new-password" @bind="_claveTemporal" /><small>Mínimo 8 caracteres.</small></label>}</div>
        <h3 class="editor-section-title">@(EsMedico ? "Perfil médico y laboral" : "Perfil laboral")</h3>
        <div class="form-grid">
            @if (EsMedico)
            {
                <label>Tipo de médico
                    <select @bind="_edit.TipoMedico">
                        <option value="P">Médico de planta</option>
                        <option value="L">Médico a llamada</option>
                        <option value="N">No aplica</option>
                    </select>
                </label>
                <div class="wide specialty-picker-container">
                    <label style="font-weight:700; font-size:0.8rem; margin:0 0 0.35rem; display:block;">Especialidades médicas asignadas *</label>
                    <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
                        <select class="form-select form-select-sm" style="flex:1; min-width:240px;" @bind="_nuevaEspecialidadSeleccionada">
                            <option value="0">Seleccionar especialidad para añadir...</option>
                            @foreach (var e in EspecialidadesDisponiblesParaAgregar)
                            {
                                <option value="@e.Id">@e.Descripcion</option>
                            }
                        </select>
                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                style="font-weight:700; height:31px; display:inline-flex; align-items:center;"
                                disabled="@(_nuevaEspecialidadSeleccionada <= 0)"
                                @onclick="AgregarEspecialidad">
                            + Añadir
                        </button>
                    </div>

                    @if (_edit.EspecialidadesIds.Count == 0)
                    {
                        <div class="text-danger mt-1" style="font-size:0.75rem; font-weight:600;">
                            ⚠️ Debe asignar al menos una especialidad al médico.
                        </div>
                    }
                    else
                    {
                        <div class="specialty-chips-grid mt-2">
                            @foreach (var espId in _edit.EspecialidadesIds)
                            {
                                <div class="specialty-chip">
                                    <span class="specialty-chip-title">⚕ @NombreEspecialidad(espId)</span>
                                    <button type="button"
                                            class="specialty-chip-remove"
                                            title="Quitar especialidad"
                                            @onclick="() => QuitarEspecialidad(espId)">×</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            <label class="wide">Observaciones<textarea rows="2" @bind="_edit.Observaciones"></textarea></label>
            <fieldset class="wide locations-field"><legend>Localidades donde trabaja</legend>@foreach(var l in _localidades){<label class="location-option"><input type="checkbox" checked="@_edit.LocalidadesIds.Contains(l.Id)" @onchange="e => CambiarLocalidad(l.Id, e)" /> @l.Descripcion</label>}</fieldset>
        </div>
    </div><footer><button @onclick="CerrarEditor">Cancelar</button><button class="primary" disabled="@_guardando" @onclick="Guardar">@(_guardando ? "Guardando..." : "Guardar usuario")</button></footer></section></div>
}

@if (_usuarioClave is not null)
{
    <div class="modal-backdrop" role="presentation" @onclick="CerrarClave"><section class="editor-modal small" role="dialog" aria-modal="true" aria-labelledby="password-title" @onclick:stopPropagation><header><div><span>Seguridad</span><h2 id="password-title">Restablecer contraseña</h2></div><button aria-label="Cerrar" @onclick="CerrarClave">×</button></header><div class="editor-body"><p>Define una contraseña temporal para <strong>@_usuarioClave.Nombre</strong>.</p><label>Nueva contraseña<input type="password" minlength="8" autocomplete="new-password" @bind="_nuevaClave" /><small>Mínimo 8 caracteres.</small></label><label>Confirmar contraseña<input type="password" minlength="8" autocomplete="new-password" @bind="_confirmarClave" /></label></div><footer><button @onclick="CerrarClave">Cancelar</button><button class="primary" disabled="@_guardando" @onclick="GuardarClave">Restablecer</button></footer></section></div>
}
}

<style>
    .editor-section-title { margin: 0 0 1rem; color: #082868; font-size: .85rem; }
    .editor-section-title:not(:first-child) { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid #e2edf3; }
    .editor-body textarea { padding: .72rem .8rem; border: 1px solid #d5e5ec; border-radius: 9px; resize: vertical; }
    .locations-field { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: .65rem 1.2rem; padding: 1rem; border: 1px solid #d5e5ec; border-radius: 10px; }
    .locations-field legend { width: auto; padding: 0 .35rem; color: #405970; font-size: .75rem; font-weight: 750; }
    .editor-body .location-option { flex-direction: row; align-items: center; gap: .45rem; font-weight: 600; }
    .editor-body .location-option input { width: 16px; height: 16px; padding: 0; }
    .specialty-picker-container { grid-column: 1 / -1; padding: 0.85rem; border: 1px solid #d5e5ec; border-radius: 10px; background: #fbfdff; }
    .specialty-chips-grid { display: flex; flex-wrap: wrap; gap: 0.45rem; }
    .specialty-chip { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.65rem; background: #eaf3fa; border: 1px solid #bddbee; border-radius: 20px; font-size: 0.78rem; font-weight: 650; color: #074770; }
    .specialty-chip-remove { border: none; background: #d0e4f3; color: #083b5e; border-radius: 50%; width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem; cursor: pointer; padding: 0; line-height: 1; }
    .specialty-chip-remove:hover { background: #ea3943; color: #ffffff; }
</style>

@code {
    private bool _autorizado, _cargando = true, _guardando, _error, _mostrarEditor;
    private string _filtro = "", _estadoFiltro = "", _mensaje = "", _claveTemporal = "", _nuevaClave = "", _confirmarClave = "";
    private int _nuevaEspecialidadSeleccionada;
    private List<UsuarioAdministracionModel> _usuarios = [];
    private List<RolUsuarioModel> _roles = [];
    private List<CatalogoItemGenericoDto> _especialidades = [], _localidades = [];
    private UsuarioAdministracionModel _edit = new();
    private UsuarioAdministracionModel? _usuarioClave;
    private IEnumerable<UsuarioAdministracionModel> Filtrados => _usuarios.Where(u => (string.IsNullOrWhiteSpace(_filtro) || u.Nombre.Contains(_filtro,StringComparison.OrdinalIgnoreCase) || u.Login.Contains(_filtro,StringComparison.OrdinalIgnoreCase) || u.Email.Contains(_filtro,StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrEmpty(_estadoFiltro) || u.Estado == _estadoFiltro));
    private bool EsMedico => _edit.RolId == 2;
    private IEnumerable<CatalogoItemGenericoDto> EspecialidadesDisponiblesParaAgregar =>
        _especialidades.Where(e => !_edit.EspecialidadesIds.Contains(e.Id));

    protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated||Session.TipoUser!=1){Nav.NavigateTo("/dashboard");return;}_autorizado=true;await Cargar();}
    private async Task Cargar(){_cargando=true;var a=AuthService.ObtenerUsuariosAdministracionAsync();var b=AuthService.ObtenerRolesAsync();var c=AuthService.ObtenerEspecialidadesUsuarioAsync();var d=AuthService.ObtenerLocalidadesUsuarioAsync();_usuarios=await a;_roles=await b;_especialidades=await c;_localidades=await d;_cargando=false;}
    
    private void Nuevo()
    {
        _edit = new()
        {
            RolId = _roles.FirstOrDefault(r => r.Id != 1)?.Id ?? 2,
            EspecialidadId = _especialidades.FirstOrDefault()?.Id ?? 1,
            EspecialidadesIds = _especialidades.Count > 0 ? new List<int> { _especialidades[0].Id } : new List<int>(),
            TipoMedico = "P",
            Estado = "A"
        };
        _claveTemporal = "";
        _nuevaEspecialidadSeleccionada = 0;
        _mensaje = "";
        _mostrarEditor = true;
    }

    private async Task Editar(UsuarioAdministracionModel u)
    {
        var localTask = AuthService.ObtenerLocalidadesAsignadasAsync(u.Id);
        var espTask = AuthService.ObtenerEspecialidadesAsignadasAsync(u.Id);
        await Task.WhenAll(localTask, espTask);
        _edit = new()
        {
            Id = u.Id,
            Nombre = u.Nombre,
            Login = u.Login,
            Iniciales = u.Iniciales,
            Email = u.Email,
            Celular = u.Celular,
            Convencional = u.Convencional,
            Cedula = u.Cedula,
            RolId = u.RolId,
            EspecialidadId = u.EspecialidadId,
            Especialidad = u.Especialidad,
            TipoMedico = u.TipoMedico,
            Observaciones = u.Observaciones,
            Estado = u.Estado,
            LocalidadesIds = localTask.Result,
            EspecialidadesIds = espTask.Result
        };
        _claveTemporal = "";
        _nuevaEspecialidadSeleccionada = 0;
        _mensaje = "";
        _mostrarEditor = true;
    }

    private void AgregarEspecialidad()
    {
        if (_nuevaEspecialidadSeleccionada > 0 && !_edit.EspecialidadesIds.Contains(_nuevaEspecialidadSeleccionada))
        {
            _edit.EspecialidadesIds.Add(_nuevaEspecialidadSeleccionada);
            _nuevaEspecialidadSeleccionada = 0;
        }
    }

    private void QuitarEspecialidad(int id)
    {
        _edit.EspecialidadesIds.Remove(id);
    }

    private string NombreEspecialidad(int id) =>
        _especialidades.FirstOrDefault(e => e.Id == id)?.Descripcion ?? $"Especialidad #{id}";

    private void CambiarLocalidad(int id, ChangeEventArgs e){if(e.Value is true){if(!_edit.LocalidadesIds.Contains(id))_edit.LocalidadesIds.Add(id);}else _edit.LocalidadesIds.Remove(id);}
    private void CerrarEditor()=>_mostrarEditor=false;
    
    private async Task Guardar()
    {
        try
        {
            if (EsMedico && _edit.EspecialidadesIds.Count == 0)
            {
                _error = true;
                _mensaje = "Debe asignar al menos una especialidad médica al doctor.";
                return;
            }
            _guardando = true;
            var r = await AuthService.GuardarUsuarioAdministracionAsync(_edit, _edit.Id == 0 ? _claveTemporal : null, Session.IdUser);
            _guardando = false;
            _error = !r.Exito;
            _mensaje = r.Mensaje;
            if (r.Exito)
            {
                _mostrarEditor = false;
                await Cargar();
            }
        }
        catch (Exception ex)
        {
            _guardando = false;
            _error = true;
            _mensaje = ex.Message;
        }
    }

    private async Task CambiarEstado(UsuarioAdministracionModel u){try{var r=await AuthService.CambiarEstadoUsuarioAsync(u.Id,u.Estado!="A",Session.IdUser);_error=!r.Exito;_mensaje=r.Mensaje;if(r.Exito)await Cargar();}catch(Exception ex){_error=true;_mensaje=ex.Message;}}
    private void PrepararClave(UsuarioAdministracionModel u){_usuarioClave=u;_nuevaClave="";_confirmarClave="";_mensaje="";}
    private void CerrarClave()=>_usuarioClave=null;
    private async Task GuardarClave(){if(_usuarioClave is null)return;if(_nuevaClave!=_confirmarClave){_error=true;_mensaje="Las contraseñas no coinciden.";return;}try{_guardando=true;var r=await AuthService.RestablecerClaveUsuarioAsync(_usuarioClave.Id,_nuevaClave,Session.IdUser);_guardando=false;_error=!r.Exito;_mensaje=r.Mensaje;if(r.Exito)_usuarioClave=null;}catch(Exception ex){_guardando=false;_error=true;_mensaje=ex.Message;}}
    private string Rol(int id)=>_roles.FirstOrDefault(x=>x.Id==id)?.Descripcion??$"Rol {id}";
    private static string Iniciales(UsuarioAdministracionModel u)=>!string.IsNullOrWhiteSpace(u.Iniciales)?u.Iniciales:string.Concat(u.Nombre.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>x[0])).ToUpperInvariant();
}
