@page "/administracion/usuarios"
@using HosvetKardex.Web.Components.Layout
@inject SessionStateService Session
@inject IAuthService AuthService
@inject NavigationManager Nav
<PageTitle>Usuarios | e-ForVets</PageTitle>

@if (_autorizado)
{
<div class="users-page">
    <SecurityNav />
    <header class="page-head"><div><span>Seguridad</span><h1>Usuarios</h1><p>Crea cuentas, asigna roles y controla el acceso al sistema.</p></div><button type="button" class="primary" @onclick="Nuevo">+ Nuevo usuario</button></header>
    @if (!string.IsNullOrWhiteSpace(_mensaje)) { <div class="message @(_error ? "error" : "success")" role="status">@_mensaje</div> }
    <div class="toolbar"><input type="search" @bind="_filtro" @bind:event="oninput" placeholder="Buscar por nombre, usuario o correo" /><select @bind="_estadoFiltro"><option value="">Todos los estados</option><option value="A">Activos</option><option value="I">Inactivos</option></select></div>
    @if (_cargando) { <div class="state">Cargando usuarios...</div> }
    else if (_usuarios.Count == 0) { <div class="state">No fue posible obtener usuarios desde la base de datos.</div> }
    else
    {
        <div class="users-table"><div class="table-head"><span>Usuario</span><span>Rol</span><span>Contacto</span><span>Estado</span><span>Acciones</span></div>
        @foreach (var u in Filtrados)
        {
            <div class="table-row"><span class="person"><b>@Iniciales(u)</b><span><strong>@u.Nombre</strong><small>@@@u.Login</small></span></span><span><em>@Rol(u.RolId)</em></span><span><strong class="contact">@u.Email</strong><small>@u.Celular</small></span><span><i class="status-dot @(u.Estado == "A" ? "active" : "inactive")"></i>@(u.Estado == "A" ? "Activo" : "Inactivo")</span><span class="actions"><button title="Editar usuario" @onclick="() => Editar(u)">Editar</button><a href="@($"/administracion/roles-permisos?usuario={u.Id}")">Permisos</a><button title="Restablecer contraseña" @onclick="() => PrepararClave(u)">Contraseña</button><button class="danger" @onclick="() => CambiarEstado(u)">@(u.Estado == "A" ? "Desactivar" : "Activar")</button></span></div>
        }
        </div>
    }
</div>

@if (_mostrarEditor)
{
    <div class="modal-backdrop" role="presentation" @onclick="CerrarEditor"><section class="editor-modal" role="dialog" aria-modal="true" aria-labelledby="user-editor-title" @onclick:stopPropagation><header><div><span>@(_edit.Id == 0 ? "Nueva cuenta" : "Editar cuenta")</span><h2 id="user-editor-title">@(_edit.Id == 0 ? "Crear usuario" : _edit.Nombre)</h2></div><button aria-label="Cerrar" @onclick="CerrarEditor">×</button></header><div class="editor-body"><div class="form-grid"><label>Nombre completo<input @bind="_edit.Nombre" /></label><label>Usuario de acceso<input autocomplete="off" @bind="_edit.Login" /></label><label>Correo electrónico<input type="email" @bind="_edit.Email" /></label><label>Celular<input @bind="_edit.Celular" /></label><label>Iniciales<input maxlength="4" @bind="_edit.Iniciales" /></label><label>Rol<select @bind="_edit.RolId"><option value="0">Seleccione</option>@foreach(var r in _roles){<option value="@r.Id">@r.Descripcion</option>}</select></label>@if(_edit.Id==0){<label class="wide">Contraseña temporal<input type="password" minlength="8" autocomplete="new-password" @bind="_claveTemporal" /><small>Mínimo 8 caracteres.</small></label>}</div></div><footer><button @onclick="CerrarEditor">Cancelar</button><button class="primary" disabled="@_guardando" @onclick="Guardar">@(_guardando ? "Guardando..." : "Guardar usuario")</button></footer></section></div>
}

@if (_usuarioClave is not null)
{
    <div class="modal-backdrop" role="presentation" @onclick="CerrarClave"><section class="editor-modal small" role="dialog" aria-modal="true" aria-labelledby="password-title" @onclick:stopPropagation><header><div><span>Seguridad</span><h2 id="password-title">Restablecer contraseña</h2></div><button aria-label="Cerrar" @onclick="CerrarClave">×</button></header><div class="editor-body"><p>Define una contraseña temporal para <strong>@_usuarioClave.Nombre</strong>.</p><label>Nueva contraseña<input type="password" minlength="8" autocomplete="new-password" @bind="_nuevaClave" /><small>Mínimo 8 caracteres.</small></label><label>Confirmar contraseña<input type="password" minlength="8" autocomplete="new-password" @bind="_confirmarClave" /></label></div><footer><button @onclick="CerrarClave">Cancelar</button><button class="primary" disabled="@_guardando" @onclick="GuardarClave">Restablecer</button></footer></section></div>
}
}

@code {
    private bool _autorizado, _cargando = true, _guardando, _error, _mostrarEditor;
    private string _filtro = "", _estadoFiltro = "", _mensaje = "", _claveTemporal = "", _nuevaClave = "", _confirmarClave = "";
    private List<UsuarioAdministracionModel> _usuarios = [];
    private List<RolUsuarioModel> _roles = [];
    private UsuarioAdministracionModel _edit = new();
    private UsuarioAdministracionModel? _usuarioClave;
    private IEnumerable<UsuarioAdministracionModel> Filtrados => _usuarios.Where(u => (string.IsNullOrWhiteSpace(_filtro) || u.Nombre.Contains(_filtro,StringComparison.OrdinalIgnoreCase) || u.Login.Contains(_filtro,StringComparison.OrdinalIgnoreCase) || u.Email.Contains(_filtro,StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrEmpty(_estadoFiltro) || u.Estado == _estadoFiltro));
    protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated||Session.TipoUser!=1){Nav.NavigateTo("/dashboard");return;}_autorizado=true;await Cargar();}
    private async Task Cargar(){_cargando=true;var a=AuthService.ObtenerUsuariosAdministracionAsync();var b=AuthService.ObtenerRolesAsync();await Task.WhenAll(a,b);_usuarios=a.Result;_roles=b.Result;_cargando=false;}
    private void Nuevo(){_edit=new(){RolId=_roles.FirstOrDefault(r=>r.Id!=1)?.Id??2,Estado="A"};_claveTemporal="";_mensaje="";_mostrarEditor=true;}
    private void Editar(UsuarioAdministracionModel u){_edit=new(){Id=u.Id,Nombre=u.Nombre,Login=u.Login,Iniciales=u.Iniciales,Email=u.Email,Celular=u.Celular,RolId=u.RolId,Estado=u.Estado};_claveTemporal="";_mensaje="";_mostrarEditor=true;}
    private void CerrarEditor()=>_mostrarEditor=false;
    private async Task Guardar(){_guardando=true;var r=await AuthService.GuardarUsuarioAdministracionAsync(_edit,_edit.Id==0?_claveTemporal:null,Session.IdUser);_guardando=false;_error=!r.Exito;_mensaje=r.Mensaje;if(r.Exito){_mostrarEditor=false;await Cargar();}}
    private async Task CambiarEstado(UsuarioAdministracionModel u){var r=await AuthService.CambiarEstadoUsuarioAsync(u.Id,u.Estado!="A",Session.IdUser);_error=!r.Exito;_mensaje=r.Mensaje;if(r.Exito)await Cargar();}
    private void PrepararClave(UsuarioAdministracionModel u){_usuarioClave=u;_nuevaClave="";_confirmarClave="";_mensaje="";}
    private void CerrarClave()=>_usuarioClave=null;
    private async Task GuardarClave(){if(_usuarioClave is null)return;if(_nuevaClave!=_confirmarClave){_error=true;_mensaje="Las contraseñas no coinciden.";return;}_guardando=true;var r=await AuthService.RestablecerClaveUsuarioAsync(_usuarioClave.Id,_nuevaClave,Session.IdUser);_guardando=false;_error=!r.Exito;_mensaje=r.Mensaje;if(r.Exito)_usuarioClave=null;}
    private string Rol(int id)=>_roles.FirstOrDefault(x=>x.Id==id)?.Descripcion??$"Rol {id}";
    private static string Iniciales(UsuarioAdministracionModel u)=>!string.IsNullOrWhiteSpace(u.Iniciales)?u.Iniciales:string.Concat(u.Nombre.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>x[0])).ToUpperInvariant();
}
