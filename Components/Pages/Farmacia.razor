    private void OnSeleccionarProductoVentaChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        var prod = _catalogoDisponibleVenta.FirstOrDefault(x => x.Id == id);
        if (prod is not null)
        {
            _productoVentaSeleccionado = prod;
            _bodegasProductoVenta = (prod.Location ?? string.Empty)
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            _bodegaVentaElegida = _bodegasProductoVenta.FirstOrDefault() ?? prod.Location ?? string.Empty;
            _precioVentaInput = prod.UnitPrice;
            _cantidadVentaInput = 1m;
            _ventaPorPaquete = false;
        }
        else
        {
            _productoVentaSeleccionado = null;
            _bodegasProductoVenta = [];
            _bodegaVentaElegida = string.Empty;
            _precioVentaInput = 0m;
        }
    }

    private void AgregarAlCarritoVenta()
    {
        if (_productoVentaSeleccionado is null)
        {
            _esError = true;
            _mensajeAlerta = "Seleccione un producto con stock disponible.";
            return;
        }

        var cantBase = CantidadBaseVentaCalculada;
        if (cantBase <= 0 || cantBase > _productoVentaSeleccionado.Available)
        {
            _esError = true;
            _mensajeAlerta = cantBase <= 0
                ? "Ingrese una cantidad mayor que cero."
                : $"La cantidad ({cantBase:0.##} {UnidadVentaSeleccionada}) supera el stock libre ({FormatearResumenStock(_productoVentaSeleccionado)}).";
            return;
        }

        _lineasVenta.Add(new FarmaciaVentaLineaInputDto
        {
            IdProducto = _productoVentaSeleccionado.Id,
            CodigoProducto = _productoVentaSeleccionado.Number,
            NombreProducto = _productoVentaSeleccionado.DisplayName,
            Bodega = _bodegaVentaElegida,
            UnidadMedida = UnidadVentaSeleccionada,
            FactorConversion = FactorVentaSeleccionado,
            PorPaquete = _ventaPorPaquete,
            CantidadIngresada = _cantidadVentaInput,
            PrecioUnitario = _precioVentaInput,
            StockDisponible = _productoVentaSeleccionado.Available,
            Iva = _productoVentaSeleccionado.TaxGroupCode,
            Indicaciones = _indicacionVentaInput
        });

        _productoVentaSeleccionado = null;
        _bodegasProductoVenta = [];
        _cantidadVentaInput = 1m;
        _ventaPorPaquete = false;
        _indicacionVentaInput = string.Empty;
        _mensajeAlerta = null;
    }

    private void OnOrdenVentaChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idOrd) && idOrd > 0)
        {
            var ord = _ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == idOrd);
            if (ord is not null)
            {
                _ordenVentaId = ord.IdOrdenAtencion;
                _nhclVentaId = ord.Nhcl;
                if (string.IsNullOrWhiteSpace(_clienteReferenciaVenta))
                    _clienteReferenciaVenta = $"{ord.Paciente} ({ord.Cliente})";
            }
        }
        else
        {
            _ordenVentaId = 0;
            _nhclVentaId = 0;
        }
    }

    private async Task ConfirmarVentaMostradorAsync()
    {
        if (_lineasVenta.Count == 0) return;
        _procesando = true;
        try
        {
            var dto = new FarmaciaVentaMostradorInputDto
            {
                IdOrden = _ordenVentaId > 0 ? _ordenVentaId : null,
                Nhcl = _nhclVentaId > 0 ? _nhclVentaId : null,
                ClienteReferencia = _clienteReferenciaVenta,
                Observacion = _clienteReferenciaVenta,
                Lineas = _lineasVenta.ToList()
            };

            var res = await FarmaciaService.RegistrarVentaMostradorAsync(
                dto,
                SucursalActivaId,
                Session.IdUser,
                Session.NombreUsuario,
                Session.Iniciales);

            _esError = !res.Exito;
            _mensajeAlerta = res.Mensaje;
            if (res.Exito)
            {
                _lineasVenta.Clear();
                _clienteReferenciaVenta = string.Empty;
                _ordenVentaId = 0;
                _nhclVentaId = 0;
                await CargarTodoAsync();
            }
        }
        finally
        {
            _procesando = false;
        }
    }
}
