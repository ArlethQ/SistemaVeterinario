@page "/programacion/salas-quirofano"
@inject IGestionMigradaService Service
@inject ILogger<SalasQuirofano> Logger

<PageTitle>Salas de quirófano | e-ForVets</PageTitle>

<div class="container-fluid py-3 clinical-kardex organizacion-kardex salas-quirofano">
    <header class="clinical-kardex-header">
        <div class="organizacion-heading">
            <i class="bi bi-door-closed" aria-hidden="true"></i>
            <div>
                <h1>Salas de quirófano</h1>
                <small class="text-muted">Disponibilidad y reservas por sucursal y piso</small>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (Permisos.Permite("programacion/clinica"))
            {
                <a class="btn btn-outline-primary" href="/programacion/clinica">Programación clínica</a>
            }
        </div>
    </header>

    <section class="card shadow-sm mb-3" aria-labelledby="registro-sala" id="formulario-sala">
        <div class="card-header bg-white">
            <h2 class="h5 fw-bold mb-0" id="registro-sala">
                <i class="bi bi-door-closed me-2" aria-hidden="true"></i>@(_edicion.Id == 0 ? "Registrar sala" : $"Editar sala · {_edicion.Codigo}")
            </h2>
        </div>
        <div class="card-body">
            @if (_errorFormulario is not null)
            {
                <div class="alert alert-danger" role="alert">@_errorFormulario</div>
            }
            <fieldset disabled="@(_guardando || _cargandoCatalogos)">
                <div class="row g-3">
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label fw-semibold" for="sucursal-sala">Sucursal *</label>
                        <select id="sucursal-sala" class="form-select" disabled="@(_edicion.Id > 0 || !Session.EsAdministrador)"
                                @bind="_sucursalEdicion" @bind:after="CambiarSucursalEdicion">
                            @if (Session.EsAdministrador)
                            {
                                <option value="0">Selecciona una sucursal</option>
                            }
                            @foreach (var sucursal in _localidades)
                            {
                                <option value="@sucursal.Id">@sucursal.Descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label fw-semibold" for="piso-sala">Piso *</label>
                        @if (_edicion.Id > 0)
                        {
                            <input id="piso-sala" class="form-control" value="@_edicion.Piso" readonly />
                        }
                        else
                        {
                            <select id="piso-sala" class="form-select" disabled="@(!PisosEdicion.Any())" @bind="_edicion.IdPiso">
                                <option value="0">Selecciona un piso</option>
                                @foreach (var piso in PisosEdicion)
                                {
                                    <option value="@piso.Id">@piso.Nombre</option>
                                }
                            </select>
                            @if (_sucursalEdicion > 0 && !PisosEdicion.Any())
                            {
                                <small class="text-muted">Esta sucursal no tiene pisos activos.</small>
                            }
                        }
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label fw-semibold" for="codigo-sala">Código o nombre *</label>
                        <input id="codigo-sala" class="form-control" maxlength="50" required
                               placeholder="Ej. Quirófano 1" @ref="_campoCodigo" @bind="_edicion.Codigo" />
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label fw-semibold" for="observacion-sala">Observación <span class="fw-normal text-muted">(opcional)</span></label>
                        <input id="observacion-sala" class="form-control" maxlength="200" @bind="_edicion.Observacion" />
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
                    <div class="form-check form-switch mb-0">
                        <input id="sala-activa" type="checkbox" class="form-check-input" role="switch" @bind="_edicion.Activa" />
                        <label class="form-check-label" for="sala-activa">Sala activa</label>
                    </div>
                    <div class="d-flex ms-auto gap-2">
                        @if (_edicion.Id > 0)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="NuevaSala">Cancelar edición</button>
                        }
                        <SaveButton class="btn btn-primary" OnClick="GuardarAsync" Disabled="@(_guardando || _cargandoCatalogos || _pisos.Count == 0)">
                            <i class="bi bi-floppy me-1" aria-hidden="true"></i>@(_edicion.Id == 0 ? "Guardar sala" : "Guardar cambios")
                        </SaveButton>
                    </div>
                </div>
            </fieldset>
        </div>
    </section>

    <section class="card shadow-sm mb-3 organizacion-filtros" aria-label="Filtros de salas">
        <div class="card-body row g-2">
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="filtro-sucursal">Sucursal</label>
                <select class="form-select" id="filtro-sucursal" disabled="@(!Session.EsAdministrador)" @bind="_idLocalidad">
                    @if (Session.EsAdministrador)
                {
                    <option value="0">Todas las sucursales</option>
                }
                    @foreach (var sucursal in _localidades)
                    {
                        <option value="@sucursal.Id">@sucursal.Descripcion</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="filtro-fecha">Fecha de programación</label>
                <input id="filtro-fecha" type="date" class="form-control" @bind="_fecha" @bind:after="CargarReservasAsync" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="filtro-estado">Disponibilidad</label>
                <select class="form-select" id="filtro-estado" @bind="_estadoFiltro">
                    <option value="">Todas</option>
                    <option value="libre">Sin reservas</option>
                    <option value="reservada">Con reservas</option>
                    <option value="inactiva">Inactivas</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="filtro-codigo">Buscar código o nombre</label>
                <input class="form-control" id="filtro-codigo" @bind="_busqueda" @bind:event="oninput" />
            </div>
        </div>
    </section>

    @if (_confirmacion is not null)
    {
        <div class="alert alert-success" role="status">@_confirmacion</div>
    }

    @if (_errorCarga is not null)
    {
        <div class="alert alert-danger" role="alert">@_errorCarga</div>
    }
    else if (_cargando)
    {
        <p role="status">Cargando salas y reservas…</p>
    }
    else if (!SalasVisibles.Any())
    {
        <p class="text-muted">No hay salas que coincidan con los filtros.</p>
    }
    else
    {
        @foreach (var piso in SalasVisibles.GroupBy(s => new { s.IdLocalidad, s.Localidad, s.IdPiso, s.Piso }))
        {
            <section class="card shadow-sm mb-3" @key="(piso.Key.IdLocalidad, piso.Key.IdPiso)">
                <h2 class="card-header bg-white organizacion-secundaria h6 mb-0 d-flex flex-wrap align-items-center gap-2">
                    <span class="badge text-bg-primary">@piso.Key.Localidad</span>
                    <span>@piso.Key.Piso</span>
                </h2>
                <div class="card-body sala-mapa">
                    @foreach (var sala in piso)
                    {
                        var reservas = ReservasSala(sala).ToList();
                        var estado = EstadoSala(sala);
                        <article class="sala-tarjeta @estado" @key="sala.Id">
                            <span class="sala-estado">@(estado == "libre" ? "Libre" : estado == "reservada" ? "Reservada" : "Inactiva")</span>
                            <h3 class="sala-codigo">@sala.Codigo</h3>
                            @if (!string.IsNullOrWhiteSpace(sala.Observacion))
                            {
                                <p class="small text-muted mb-0">@sala.Observacion</p>
                            }
                            @if (reservas.Count > 0)
                            {
                                <ul class="list-unstyled small mb-0">
                                    @foreach (var reserva in reservas)
                                    {
                                        <li>
                                            <strong>@(reserva.HoraInicio)–@reserva.HoraFin</strong>
                                            <span class="d-block">@(reserva.IdSala.HasValue ? reserva.Procedimiento : "Cirugía sin sala asignada")</span>
                                        </li>
                                    }
                                </ul>
                            }
                            <div class="mt-auto pt-2">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        aria-label="@($"Editar {sala.Codigo}")" disabled="@_guardando" @onclick="() => EditarSalaAsync(sala)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    }

</div>

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
    [Inject] private SessionStateService Session { get; set; } = default!;

    private List<SelectorClinicoDto> _localidades = [];
    private List<PisoClinicoDto> _pisos = [];
    private List<SalaQuirofanoDto> _salas = [];
    private List<CirugiaProgramadaDto> _reservas = [];
    private DateTime _fecha = DateTime.UtcNow.AddHours(-5).Date;
    private int _idLocalidad;
    private int _sucursalEdicion;
    private string? _confirmacion;
    private bool _cargando = true;
    private bool _guardando;
    private string? _errorCarga;
    private bool _cargandoCatalogos = true;
    private string _busqueda = "";
    private string _estadoFiltro = "";
    private string? _errorFormulario;
    private SalaQuirofanoDto _edicion = new();
    private ElementReference _campoCodigo;

    private IEnumerable<PisoClinicoDto> PisosEdicion => _pisos.Where(p => p.IdLocalidad == _sucursalEdicion);

    private IEnumerable<SalaQuirofanoDto> SalasVisibles =>
        _salas.Where(s => (_idLocalidad == 0 || s.IdLocalidad == _idLocalidad)
            && s.Codigo.Contains(_busqueda.Trim(), StringComparison.OrdinalIgnoreCase)
            && (_estadoFiltro.Length == 0 || EstadoSala(s) == _estadoFiltro));

    private IEnumerable<CirugiaProgramadaDto> ReservasSala(SalaQuirofanoDto sala) =>
        _reservas.Where(r => r.IdSala == sala.Id || (r.IdSala is null && r.IdLocalidad == sala.IdLocalidad));

    private string EstadoSala(SalaQuirofanoDto sala) =>
        !sala.Activa ? "inactiva" : ReservasSala(sala).Any() ? "reservada" : "libre";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _idLocalidad = Session.EsAdministrador ? 0 : Session.Localidad;
            _localidades = (await Service.ObtenerLocalidadesSelectorAsync())
                .Where(s => Session.EsAdministrador || s.Id == Session.Localidad).ToList();
            _pisos = (await Service.ObtenerPisosAsync(true))
                .Where(p => Session.EsAdministrador || p.IdLocalidad == Session.Localidad).ToList();
            NuevaSala();
            _cargandoCatalogos = false;
            _salas = await Service.ObtenerSalasQuirofanoAsync(limitarASucursal: true);
            await CargarReservasAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudieron cargar las salas de quirófano");
            _errorCarga = "No se pudieron cargar las salas de quirófano.";
            _cargando = false;
        }
    }

    private async Task CargarReservasAsync()
    {
        var fecha = _fecha;
        _cargando = true;
        _errorCarga = null;
        try
        {
            var reservas = await Service.ObtenerCirugiasAsync(fecha, fecha, limitarASucursal: true);
            if (fecha == _fecha)
                _reservas = reservas.Where(r => r.Estado == "A").ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudieron cargar las reservas de quirófano");
            if (fecha == _fecha) _errorCarga = "No se pudieron cargar las reservas para esta fecha.";
        }
        finally
        {
            if (fecha == _fecha) _cargando = false;
        }
    }

    private void NuevaSala()
    {
        _errorFormulario = null;
        _confirmacion = null;
        _sucursalEdicion = _idLocalidad > 0 ? _idLocalidad : Session.Localidad;
        _edicion = new();
        CambiarSucursalEdicion();
    }

    private void CambiarSucursalEdicion()
    {
        var pisos = PisosEdicion.ToList();
        _edicion.IdPiso = pisos.Count == 1 ? pisos[0].Id : 0;
    }

    private async Task EditarSalaAsync(SalaQuirofanoDto sala)
    {
        if (_guardando) return;
        _errorFormulario = null;
        _confirmacion = null;
        _sucursalEdicion = sala.IdLocalidad;
        _edicion = new()
        {
            Id = sala.Id,
            Piso = sala.Piso,
            IdPiso = sala.IdPiso,
            Codigo = sala.Codigo,
            Observacion = sala.Observacion,
            Activa = sala.Activa
        };
        await _campoCodigo.FocusAsync();
    }

    private async Task GuardarAsync()
    {
        if (_guardando || _cargandoCatalogos) return;
        if (string.IsNullOrWhiteSpace(_edicion.Codigo))
        {
            _errorFormulario = "Ingresa el código o nombre de la sala.";
            return;
        }

        if (_edicion.IdPiso <= 0)
        {
            _errorFormulario = "Selecciona la sucursal y un piso activo.";
            return;
        }

        _guardando = true;
        _errorFormulario = null;
        try
        {
            if (!await Service.GuardarSalaQuirofanoAsync(_edicion, Session.IdUser))
            {
                _errorFormulario = "Verifica que el piso esté activo, que el nombre esté disponible y que no haya reservas pendientes si vas a desactivar la sala.";
                return;
            }
            var confirmacion = _edicion.Id == 0 ? "Sala registrada." : "Cambios guardados.";
            var sucursalGuardada = _sucursalEdicion;
            NuevaSala();
            _sucursalEdicion = sucursalGuardada;
            CambiarSucursalEdicion();
            _confirmacion = confirmacion;
            _salas = await Service.ObtenerSalasQuirofanoAsync(limitarASucursal: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo guardar o recargar una sala de quirófano");
            if (_confirmacion is not null) _errorCarga = "La sala se guardó. No se pudo actualizar el listado.";
            else _errorFormulario = "No se pudo guardar la sala.";
        }
        finally
        {
            _guardando = false;
        }
    }
}
