@inject IJSRuntime ArchivosJS
@page "/hospitalizacion/fichas-complementarias"
@page "/hospitalizacion/fichas-complementarias/{IdOrden:int}/{Nhcl:int}"
@inject IKardexService KardexService
@inject IAdmisionFacturacionService AdmisionService
@inject IEFactCatalogService Catalogo
@inject IFichasClinicasComplementariasService FichasService
@inject SessionStateService Session

<PageTitle>Fichas clínicas complementarias — e-ForVets</PageTitle>

<div class="container-fluid py-3 clinical-forms-page">
    <div class="clinical-titlebar shadow-sm mb-3">
        <div>
            <h1><i class="bi bi-droplet-half me-2" aria-hidden="true"></i>Transfusiones sanguíneas</h1>
            <div class="small opacity-75">Registro de transfusiones y monitoreo del receptor</div>
        </div>
        @if (_paciente is not null)
        {
            <div class="d-flex gap-2 flex-wrap justify-content-end">
                @if (Permisos.Permite("hospitalizacion/ficha"))
                {
                    <a href="/hospitalizacion/ficha/@IdOrden/@Nhcl" class="btn btn-sm btn-light fw-semibold">Ficha 24h</a>
                }
                @if (Permisos.Permite("hospitalizacion/monitoreo"))
                {
                    <a href="/hospitalizacion/monitoreo/@IdOrden/@Nhcl" class="btn btn-sm btn-warning fw-semibold">Monitoreo</a>
                }
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm mb-3 no-print">
        <div class="card-body py-2 px-3 bg-light rounded">
            <div class="row g-2 align-items-end">
                <div class="col-md-4 position-relative">
                    <label class="form-label small fw-bold">Buscar paciente hospitalizado</label>
                    <div class="input-group input-group-sm">
                        <input class="form-control" autocomplete="off" @bind="_filtro" @bind:event="oninput" @bind:after="BuscarAutoAsync"
                               @onfocus="() => _mostrarSugerencias = !string.IsNullOrWhiteSpace(_filtro)"
                               @onblur="CerrarSugerenciasConRetrasoAsync"
                               placeholder="Paciente, tutor o NHCL" />
                    </div>
                    @if (_mostrarSugerencias && _ordenes.Count > 0 && !string.IsNullOrWhiteSpace(_filtro))
                    {
                        <div class="list-group position-absolute bg-white border rounded shadow-sm mt-1 w-100" style="z-index: 1050; max-height: 220px; overflow-y: auto;">
                            @foreach (var o in _ordenes)
                            {
                                <button type="button" class="list-group-item list-group-item-action py-1 px-2 small text-start"
                                        @onmousedown="() => SeleccionarOrdenSugeridaAsync(o)">
                                    <strong>#@o.IdOrdenAtencion</strong> | NHCL @o.Nhcl — @o.Paciente <small class="text-muted">(@o.Cliente)</small>
                                </button>
                            }
                        </div>
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Orden activa</label>
                    <select class="form-select form-select-sm" value="@IdOrden" @onchange="CambiarOrdenAsync">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var o in _ordenes)
                        {
                            <option value="@o.IdOrdenAtencion">#@o.IdOrdenAtencion | NHCL @o.Nhcl — @o.Paciente (@o.Cliente)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <span class="badge rounded-pill @(_paciente is null ? "text-bg-secondary" : "text-bg-success") px-3 py-2">@(_paciente is null ? "Sin paciente seleccionado" : "Paciente cargado")</span>
                </div>
            </div>
        </div>
    </div>

    @if (_paciente is not null)
    {
        <div class="card shadow-sm border-0 mb-3 patient-strip">
            <div class="card-header bg-primary text-white py-2 px-3 fw-bold">🐾 DATOS DEL PACIENTE Y LA ORDEN</div>
            <div class="card-body py-2 px-3">
                <div class="row text-center small g-2 align-items-center">
                    <div class="col-6 col-md-2 border-end"><div class="text-muted">Historia / Orden</div><div class="fw-bold text-danger fs-6">@Nhcl <span class="text-secondary">(#@IdOrden)</span></div></div>
                    <div class="col-6 col-md-3 border-end"><div class="text-muted">Paciente / Especie</div><div class="fw-bold">@_pacienteVista.PacienteNombre <span class="text-success">(@_pacienteVista.Especie)</span></div></div>
                    <div class="col-6 col-md-3 border-end"><div class="text-muted">Propietario</div><div class="fw-semibold">@_pacienteVista.ClienteNombre</div></div>
                    <div class="col-6 col-md-2 border-end"><div class="text-muted">Sexo</div><div class="fw-semibold">@_pacienteVista.Sexo</div></div>
                    <div class="col-6 col-md-2 border-end">
                        <div class="text-muted">Tipo de sangre registrado</div>
                        <div class="fw-bold text-primary">@(_tipoSangre ?? "Sin registrar")</div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="alert @(_error ? "alert-danger" : "alert-success") py-2">@_mensaje</div>
    }

    <nav class="nav nav-tabs trans-pestanas" aria-label="Secciones de transfusiones">
        <button type="button" class="nav-link @(!_mostrarHistorial ? "active" : "")"
                aria-pressed="@(!_mostrarHistorial ? "true" : "false")" aria-controls="panel-trans-ficha"
                @onclick="() => _mostrarHistorial = false">Ficha de transfusión</button>
        <button type="button" class="nav-link @(_mostrarHistorial ? "active" : "")"
                aria-pressed="@(_mostrarHistorial ? "true" : "false")" aria-controls="panel-trans-historial"
                @onclick="() => _mostrarHistorial = true">Historial</button>
    </nav>
    <fieldset disabled="@(_paciente is null || _guardandoCuadricula)">
        <div id="panel-trans-ficha" hidden="@_mostrarHistorial">
        <div class="alert alert-warning small"><strong>Seguridad:</strong> verifique identidad del paciente, unidad, vencimiento, consentimiento, tipificación y compatibilidad conforme al protocolo institucional antes de iniciar.</div>
        <div class="card border-0 shadow-sm clinical-card"><div class="card-header section-header section-transfusion"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i><span><strong>Ficha de monitoreo transfusional de hemoderivados</strong></span></div><div class="card-body hoja-transfusion"><div class="row g-2">
            <h2 class="col-12 banda-transfusion">Producto sanguíneo</h2>
            <div class="col-md-3"><label class="form-label" for="producto-transfusion">Producto *</label><InputSelect id="producto-transfusion" class="form-select" @bind-Value="_trans.Producto">
                    <option value="">Selecciona un producto</option>
                    @if (_trans.Id > 0 && !_productos.Contains(_trans.Producto, StringComparer.Ordinal))
                    {
                        <option value="@_trans.Producto">@_trans.Producto (registrado)</option>
                    }
                    @foreach (var producto in _productos)
                    {
                        <option value="@producto">@producto</option>
                    }
                </InputSelect></div>
            <div class="col-md-3">
                <label for="trans-conservacion" class="form-label">Conservación</label>
                <InputSelect id="trans-conservacion" class="form-select" @bind-Value="_trans.Conservacion">
                    <option value="">Selecciona</option>
                    <option>Fresco</option>
                    <option>Congelado</option>
                </InputSelect>
            </div>
            <div class="col-md-3">
                <label for="trans-fecha" class="form-label">Fecha de transfusión</label>
                <InputDate id="trans-fecha" class="form-control" @bind-Value="_trans.Fecha" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="trans-Crossmatching" class="form-label">Resultado de crossmatching</label>
                <InputText id="trans-Crossmatching" class="form-control form-control-sm" maxlength="100" @bind-Value="_trans.Crossmatching" />
            </div>
            <div class="col-md-3"><label class="form-label">Identificador de unidad *</label><InputText class="form-control" @bind-Value="_trans.IdentificadorUnidad" /></div>
            <div class="col-md-3"><label class="form-label">Vencimiento</label><InputDate class="form-control" @bind-Value="_trans.FechaVencimiento" /></div>
            <div class="col-md-3"><label class="form-label">Estado</label><InputSelect class="form-select" @bind-Value="_trans.Estado"><option>En preparación</option><option>En curso</option><option>Completada</option><option>Suspendida</option><option>Reacción adversa</option></InputSelect></div>


            <div class="col-md-2"><label class="form-label">Vol. prescrito (ml)</label><InputNumber class="form-control" @bind-Value="_trans.VolumenPrescritoMl" /></div>
            <div class="col-md-2"><label class="form-label">Administrado (ml)</label><InputNumber class="form-control" @bind-Value="_trans.VolumenAdministradoMl" /></div>
            <div class="col-md-2"><label class="form-label">Velocidad (ml/h)</label><InputNumber class="form-control" @bind-Value="_trans.VelocidadMlHora" /></div>
            <div class="col-md-3"><label class="form-label">Inicio</label><InputDate class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="_trans.HoraInicio" /></div>
            <div class="col-md-3"><label class="form-label">Fin</label><InputDate class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="_trans.HoraFin" /></div>

            <div class="col-md-3"><label class="form-label">Médico responsable</label><InputText class="form-control" @bind-Value="_trans.MedicoResponsable" /></div>
            <div class="col-md-3"><label class="form-label">Doble verificación (dos responsables)</label><InputText class="form-control" @bind-Value="_trans.DobleVerificacion" /></div>
            <h2 class="col-12 banda-transfusion">Documentos de compatibilidad</h2>
            @foreach (var (tipo, titulo, nombreGuardado) in AdjuntosTransfusion())
            {
                var pendiente = _trans.AdjuntosPendientes.GetValueOrDefault(tipo);
                <div class="col-sm-6 col-xl-3">
                    <div class="trans-adjunto h-100">
                        <label class="form-label" for="@($"adjunto-{tipo}")">@titulo</label>
                        <InputFile id="@($"adjunto-{tipo}")" class="form-control form-control-sm"
                                   accept=".pdf,.png,.jpg,.jpeg" OnChange="e => SeleccionarAdjuntoAsync(e, tipo)" />
                        @if (pendiente is not null)
                        {
                            <span class="small text-break">Pendiente de guardar: @pendiente.Nombre</span>
                        }
                        else if (nombreGuardado is not null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary text-break"
                                    @onclick="() => DescargarAdjuntoAsync(tipo)">@nombreGuardado</button>
                        }
                    </div>
                </div>
            }
            <div class="col-12"><label class="form-label">Observaciones</label><InputTextArea class="form-control" rows="2" @bind-Value="_trans.Observaciones" /></div>
            <h2 class="col-12 banda-transfusion">Datos del receptor</h2>
            <div class="col-md-3"><span class="form-label d-block">N.º de ficha</span><strong>@_paciente?.Nhcl</strong></div>
            <div class="col-md-3"><span class="form-label d-block">Especie</span><strong>@_paciente?.Especie</strong></div>
            <div class="col-md-3"><span class="form-label d-block">Médico tratante</span><strong>@_paciente?.MedicoResponsable</strong></div>
            <div class="col-md-3"><label class="form-label">Grupo sanguíneo</label><InputText class="form-control" @bind-Value="_trans.GrupoReceptor" /></div>
            <div class="col-md-6"><label class="form-label">Diagnóstico/indicación</label><InputTextArea class="form-control" rows="2" @bind-Value="_trans.DiagnosticoIndicacion" /></div>
            <div class="col-sm-6 col-lg-3">
                <label for="trans-NumeroHistorial" class="form-label">N.º de transfusión / historial</label>
                <InputText id="trans-NumeroHistorial" class="form-control form-control-sm" maxlength="50" @bind-Value="_trans.NumeroHistorial" />
            </div>
            <div class="col-12">
                <table class="table table-sm align-middle mb-0 parametros-receptor">
                    <thead><tr><th scope="col">Parámetros</th><th scope="col">VGA</th><th scope="col">Proteínas totales</th><th scope="col">Albúmina</th></tr></thead>
                    <tbody>
                        <tr>
                            <th scope="row">Inicio</th>
                            <td><InputNumber aria-label="VGA al inicio" class="form-control form-control-sm" step="any" @bind-Value="_trans.VgaInicio" /></td>
                            <td><InputNumber aria-label="Proteínas totales al inicio" class="form-control form-control-sm" step="any" @bind-Value="_trans.ProteinasInicio" /></td>
                            <td><InputNumber aria-label="Albúmina al inicio" class="form-control form-control-sm" step="any" @bind-Value="_trans.AlbuminaInicio" /></td>
                        </tr>
                        <tr>
                            <th scope="row">Final</th>
                            <td><InputNumber aria-label="VGA al final" class="form-control form-control-sm" step="any" @bind-Value="_trans.VgaFinal" /></td>
                            <td><InputNumber aria-label="Proteínas totales al final" class="form-control form-control-sm" step="any" @bind-Value="_trans.ProteinasFinal" /></td>
                            <td><InputNumber aria-label="Albúmina al final" class="form-control form-control-sm" step="any" @bind-Value="_trans.AlbuminaFinal" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <h2 class="col-12 banda-transfusion">Datos del donante</h2>
            <div class="col-md-3"><label class="form-label">Grupo sanguíneo</label><InputText class="form-control" @bind-Value="_trans.GrupoDonante" /></div>
            <div class="col-sm-6 col-lg-3">
                <label for="trans-FichaDonante" class="form-label">N.º de ficha</label>
                <InputText id="trans-FichaDonante" class="form-control form-control-sm" maxlength="50" @bind-Value="_trans.FichaDonante" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="trans-TelefonoDonante" class="form-label">Teléfono</label>
                <InputText id="trans-TelefonoDonante" class="form-control form-control-sm" maxlength="50" @bind-Value="_trans.TelefonoDonante" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="trans-FechaRecoleccion" class="form-label">Fecha y hora de recolección</label>
                <InputDate id="trans-FechaRecoleccion" class="form-control form-control-sm" Type="InputDateType.DateTimeLocal" @bind-Value="_trans.FechaRecoleccion" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="trans-MlRecolectados" class="form-label">Volumen recolectado (ml)</label>
                <InputNumber id="trans-MlRecolectados" class="form-control form-control-sm" step="any" @bind-Value="_trans.MlRecolectados" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="trans-VgaDonante" class="form-label">VGA</label>
                <InputNumber id="trans-VgaDonante" class="form-control form-control-sm" step="any" @bind-Value="_trans.VgaDonante" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="trans-PtDonante" class="form-label">Proteínas totales</label>
                <InputNumber id="trans-PtDonante" class="form-control form-control-sm" step="any" @bind-Value="_trans.PtDonante" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="trans-AlbuminaDonante" class="form-label">Albúmina</label>
                <InputNumber id="trans-AlbuminaDonante" class="form-control form-control-sm" step="any" @bind-Value="_trans.AlbuminaDonante" />
            </div>
        </div><div class="mt-3 d-flex gap-2 justify-content-end"><SaveButton class="btn btn-primary" Disabled="@(_trans.Id == 0 && !_productos.Contains(_trans.Producto))" OnClick="GuardarTransAsync">Guardar transfusión</SaveButton><button class="btn btn-outline-secondary" @onclick="NuevaTrans">Nueva</button></div></div></div>

        @{ var momentos = MomentosTransfusion.Concat(_trans.Monitoreos.Select(m => NormalizarMomento(m.Momento)))
                .Distinct(StringComparer.OrdinalIgnoreCase).ToArray(); }
        <section class="history-panel mt-3">
            <header class="section-header trans-monitor-header">
                <h2>Curva y registro de monitorización transfusional</h2>
                <div class="trans-leyenda">
                    @foreach (var serie in SeriesCurva)
                    {
                        <span><strong style="color:@serie.Color">@serie.Simbolo</strong> @serie.Etiqueta</span>
                    }
                </div>
            </header>
            <div class="table-responsive history-table trans-monitor-cuadricula">
                @{
                    var curvas = SeriesCurva.Select(serie => momentos.Select(momento => serie.Valor(ControlVisible(momento))).ToArray()).ToArray();
                    var maximo = Math.Max(200, Math.Ceiling((curvas.SelectMany(c => c).Max() ?? 0) / 20) * 20);
                    double PosicionY(double valor) => valor <= 10
                        ? 300 - valor * 9.2
                        : 208 - (valor - 10) * 188 / (maximo - 10);
                    var marcas = new[] { 2d, 4, 6, 8, 10 }.Concat(
                        Enumerable.Range(1, 10).Select(paso => maximo * paso / 10));
                    var anchoColumna = 1020d / momentos.Length;
                }
                <div class="trans-hoja-grafica">
                <svg class="trans-trazado" viewBox="0 0 1200 340" role="img"
                     aria-label="Curvas de los parámetros registrados por momento de la transfusión">
                    <rect x="180" y="20" width="1020" height="280" fill="#fff" />
                    @foreach (var marca in marcas)
                    {
                        var y = SvgNumero(PosicionY(marca));
                        <line x1="180" x2="1200" y1="@y" y2="@y" stroke="#c4d3e2" />
                        <g><text x="172" y="@SvgNumero(PosicionY(marca) + 4)" text-anchor="end">@marca</text></g>
                    }
                    @for (int columna = 0; columna < momentos.Length; columna++)
                    {
                        var borde = SvgNumero(180 + columna * anchoColumna);
                        if (columna % 3 == 2)
                        {
                            <rect x="@borde" y="20" width="@SvgNumero(anchoColumna)" height="280" fill="#6482a4" opacity=".06" />
                        }
                        var centro = SvgNumero(180 + (columna + .5) * anchoColumna);
                        <line x1="@borde" x2="@borde" y1="20" y2="300"
                              stroke="@(columna % 3 == 0 ? "#203b60" : "#c4d3e2")" stroke-width="@(columna % 3 == 0 ? 2 : 1)" />
                        <g><text x="@centro" y="324" text-anchor="middle">@momentos[columna]</text></g>
                    }
                    <rect x="180" y="20" width="1019" height="280" fill="none" stroke="#203b60" stroke-width="2" />
                    @for (int serie = 0; serie < SeriesCurva.Length; serie++)
                    {
                        var configuracion = SeriesCurva[serie];
                        for (int columna = 0; columna < momentos.Length; columna++)
                        {
                            if (curvas[serie][columna] is not double valor) continue;
                            var x = 180 + (columna + .5) * anchoColumna;
                            var y = PosicionY(valor);
                            if (columna > 0 && curvas[serie][columna - 1] is double previo)
                            {
                                <line x1="@SvgNumero(x - anchoColumna)" x2="@SvgNumero(x)"
                                      y1="@SvgNumero(PosicionY(previo))" y2="@SvgNumero(y)"
                                      stroke="@configuracion.Color" stroke-width="2" />
                            }
                            <g><text x="@SvgNumero(x)" y="@SvgNumero(y + 5)" text-anchor="middle"
                                     class="trans-marca" fill="@configuracion.Color">@configuracion.Simbolo</text>
                                <title>@configuracion.Etiqueta · @momentos[columna] · @valor</title>
                            </g>
                        }
                    }
                </svg>
                </div>

                <table class="table table-sm align-middle mb-0 matriz-transfusion">
                    <colgroup><col class="trans-parametro" /><col span="@momentos.Length" /></colgroup>

                    <thead>
                        <tr><th scope="col">Parámetro</th>
                            @foreach (var momento in momentos)
                            {
                                <th scope="col">
                                    @if (_trans.Id > 0)
                                    {
                                        <button type="button" class="momento-transfusion" @onclick="() => SeleccionarMomento(momento)">@momento</button>
                                    }
                                    else
                                    {
                                        @momento
                                    }
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">Estado de conciencia</th>
                            @foreach (var momento in momentos)
                            {
                                <td>
                                    <input type="text" maxlength="100" class="trans-celda-control"
                                           aria-label="@($"Estado de conciencia, {momento}")"
                                           @bind:get="ControlVisible(momento).EstadoConciencia"
                                           @bind:set="valor => EditarControl(momento).EstadoConciencia = valor"
                                           @bind:event="oninput" />
                                </td>
                            }
                        </tr>
                        <tr>
                            <th scope="row"><strong style="color:@SeriesCurva[0].Color">@SeriesCurva[0].Simbolo</strong> @SeriesCurva[0].Etiqueta</th>
                            @foreach (var momento in momentos)
                            {
                                <td>
                                    <input type="number" min="0" step="1" class="trans-celda-control"
                                           aria-label="@($"FC, {momento}")"
                                           @bind:get="ControlVisible(momento).FrecuenciaCardiaca"
                                           @bind:set="valor => EditarControl(momento).FrecuenciaCardiaca = valor"
                                           @bind:event="oninput" />
                                </td>
                            }
                        </tr>
                        <tr>
                            <th scope="row"><strong style="color:@SeriesCurva[1].Color">@SeriesCurva[1].Simbolo</strong> @SeriesCurva[1].Etiqueta</th>
                            @foreach (var momento in momentos)
                            {
                                <td>
                                    <input type="number" min="0" step="1" class="trans-celda-control"
                                           aria-label="@($"FR, {momento}")"
                                           @bind:get="ControlVisible(momento).FrecuenciaRespiratoria"
                                           @bind:set="valor => EditarControl(momento).FrecuenciaRespiratoria = valor"
                                           @bind:event="oninput" />
                                </td>
                            }
                        </tr>
                        <tr>
                            <th scope="row"><strong style="color:@SeriesCurva[2].Color">@SeriesCurva[2].Simbolo</strong> @SeriesCurva[2].Etiqueta</th>
                            @foreach (var momento in momentos)
                            {
                                <td>
                                    <input type="number" min="0" step="1" class="trans-celda-control"
                                           aria-label="@($"PAS, {momento}")"
                                           @bind:get="ControlVisible(momento).Pas"
                                           @bind:set="valor => EditarControl(momento).Pas = valor"
                                           @bind:event="oninput" />
                                </td>
                            }
                        </tr>
                        <tr>
                            <th scope="row"><strong style="color:@SeriesCurva[3].Color">@SeriesCurva[3].Simbolo</strong> @SeriesCurva[3].Etiqueta</th>
                            @foreach (var momento in momentos)
                            {
                                <td>
                                    <input type="number" min="0" step="1" class="trans-celda-control"
                                           aria-label="@($"PAD, {momento}")"
                                           @bind:get="ControlVisible(momento).Pad"
                                           @bind:set="valor => EditarControl(momento).Pad = valor"
                                           @bind:event="oninput" />
                                </td>
                            }
                        </tr>
                        <tr>
                            <th scope="row"><strong style="color:@SeriesCurva[4].Color">@SeriesCurva[4].Simbolo</strong> @SeriesCurva[4].Etiqueta</th>
                            @foreach (var momento in momentos)
                            {
                                <td>
                                    <input type="number" min="0" step="1" class="trans-celda-control"
                                           aria-label="@($"PAM, {momento}")"
                                           @bind:get="ControlVisible(momento).Pam"
                                           @bind:set="valor => EditarControl(momento).Pam = valor"
                                           @bind:event="oninput" />
                                </td>
                            }
                        </tr>
                        <tr>
                            <th scope="row"><strong style="color:@SeriesCurva[6].Color">@SeriesCurva[6].Simbolo</strong> @SeriesCurva[6].Etiqueta</th>
                            @foreach (var momento in momentos)
                            {
                                <td>
                                    <input type="number" min="0" step="any" class="trans-celda-control"
                                           aria-label="@($"TLLC, {momento}")"
                                           @bind:get="ControlVisible(momento).Tllc"
                                           @bind:set="valor => EditarControl(momento).Tllc = valor"
                                           @bind:event="oninput" />
                                </td>
                            }
                        </tr>
                        <tr>
                            <th scope="row">Mucosas</th>
                            @foreach (var momento in momentos)
                            {
                                <td>
                                    <input type="text" maxlength="100" class="trans-celda-control"
                                           aria-label="@($"Mucosas, {momento}")"
                                           @bind:get="ControlVisible(momento).Mucosas"
                                           @bind:set="valor => EditarControl(momento).Mucosas = valor"
                                           @bind:event="oninput" />
                                </td>
                            }
                        </tr>
                        <tr>
                            <th scope="row"><strong style="color:@SeriesCurva[5].Color">@SeriesCurva[5].Simbolo</strong> @SeriesCurva[5].Etiqueta</th>
                            @foreach (var momento in momentos)
                            {
                                <td>
                                    <input type="number" min="0" step="any" class="trans-celda-control"
                                           aria-label="@($"Temperatura, {momento}")"
                                           @bind:get="ControlVisible(momento).Temperatura"
                                           @bind:set="valor => EditarControl(momento).Temperatura = valor"
                                           @bind:event="oninput" />
                                </td>
                            }
                        </tr>
                        <tr>
                            <th scope="row">Otros</th>
                            @foreach (var momento in momentos)
                            {
                                <td>
                                    <input type="text" maxlength="2000" class="trans-celda-control"
                                           aria-label="@($"Otros, {momento}")"
                                           @bind:get="ControlVisible(momento).Otros"
                                           @bind:set="valor => EditarControl(momento).Otros = valor"
                                           @bind:event="oninput" />
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-end p-2">
                @if (_trans.Id == 0)
                {
                    <small class="text-muted">Los controles se guardan con la transfusión.</small>
                }
                else
                {
                    <SaveButton class="btn btn-sm btn-primary" Disabled="@(_controlesEditados.Count == 0 || _guardandoCuadricula)"
                                OnClick="GuardarCuadriculaAsync">Guardar monitoreo</SaveButton>
                }
            </div>
        </section>
        @if (_trans.Id > 0)
        {
            <div id="trans-control" class="card border-0 shadow-sm mt-3 clinical-card"><div class="card-header bg-dark text-white py-2 px-3 fw-bold">Registrar control</div><div class="card-body"><div class="row g-2">
                <div class="col-md-2"><label class="form-label">Momento</label><InputText class="form-control" @bind-Value="_mon.Momento" list="momentos-transfusion" /><datalist id="momentos-transfusion">@foreach (var momento in MomentosTransfusion) { <option value="@momento"></option> }</datalist></div>
                <div class="col-md-2"><label class="form-label">Temperatura °C</label><InputNumber class="form-control" @bind-Value="_mon.Temperatura" /></div>
                <div class="col-md-2"><label class="form-label">FC lpm</label><InputNumber class="form-control" @bind-Value="_mon.FrecuenciaCardiaca" /></div>
                <div class="col-md-2"><label class="form-label">FR rpm</label><InputNumber class="form-control" @bind-Value="_mon.FrecuenciaRespiratoria" /></div>
                <div class="col-md-1"><label class="form-label">PAS</label><InputNumber class="form-control" @bind-Value="_mon.Pas" /></div>
                <div class="col-md-1"><label class="form-label">PAD</label><InputNumber class="form-control" @bind-Value="_mon.Pad" /></div>
                <div class="col-md-1"><label class="form-label">PAM</label><InputNumber class="form-control" @bind-Value="_mon.Pam" /></div>
                <div class="col-md-2"><label for="trans-tllc" class="form-label">TLLC</label><InputNumber id="trans-tllc" class="form-control" step="any" @bind-Value="_mon.Tllc" /></div>
                <div class="col-md-3"><label for="trans-otros" class="form-label">Otros</label><InputText id="trans-otros" class="form-control" @bind-Value="_mon.Otros" /></div>
                <div class="col-md-3"><label class="form-label">Mucosas</label><InputText class="form-control" @bind-Value="_mon.Mucosas" /></div>
                <div class="col-md-3"><label class="form-label">Conciencia</label><InputText class="form-control" @bind-Value="_mon.EstadoConciencia" /></div>
                <div class="col-md-3"><label class="form-label text-danger">Reacciones adversas</label><InputText class="form-control" @bind-Value="_mon.ReaccionesAdversas" /></div>
                <div class="col-md-3"><label class="form-label">Acción tomada</label><InputText class="form-control" @bind-Value="_mon.AccionTomada" /></div>
                <div class="col-md-3"><label class="form-label">Responsable</label><InputText class="form-control" @bind-Value="_mon.Responsable" /></div>
            </div><SaveButton class="btn btn-primary mt-3" OnClick="AgregarMonAsync">Agregar control</SaveButton></div></div>
        }
        </div>
        <div id="panel-trans-historial" hidden="@(!_mostrarHistorial)">
        <section class="history-panel mt-3"><h2 class="section-header">Historial de transfusiones</h2><div class="table-responsive history-table"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th>Fecha</th><th>Producto/unidad</th><th>Compatibilidad</th><th>Volumen</th><th>Estado</th><th>Controles</th><th>Acciones</th></tr></thead><tbody>
        @if (_transfusiones.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted">@(_paciente is null ? "Selecciona una orden para consultar sus transfusiones." : "Esta orden aún no tiene transfusiones registradas.")</td></tr>
        }
        @foreach (var x in _transfusiones) { <tr><td>@x.Fecha.ToString("yyyy-MM-dd HH:mm")</td><td>@x.Producto / @x.IdentificadorUnidad</td><td>@x.GrupoReceptor → @x.GrupoDonante</td><td>@x.VolumenAdministradoMl / @x.VolumenPrescritoMl ml</td><td>@x.Estado</td><td>@x.Monitoreos.Count</td><td class="text-end text-nowrap"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditarTrans(x)">Abrir</button> <button class="btn btn-xs btn-outline-danger" @onclick="() => EliminarTransAsync(x.Id)">Eliminar</button></td></tr> }
        </tbody></table></div></section>
        </div>
    </fieldset>
</div>

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }
    private string _filtro="", _mensaje=""; private bool _error;
    private List<OrdenActivaResumenDto> _ordenes=[]; private PacienteHeaderDto? _paciente;
    private PacienteHeaderDto _pacienteVista => _paciente ?? new();
    private static readonly (string Etiqueta, string Color, string Simbolo, Func<TransfusionMonitoreoDto, double?> Valor)[] SeriesCurva =
    [
        ("FC (lpm)", "#b71c1c", "●", m => m.FrecuenciaCardiaca),
        ("FR (rpm)", "#1565c0", "◆", m => m.FrecuenciaRespiratoria),
        ("PAS (mmHg)", "#18754e", "▼", m => m.Pas),
        ("PAD (mmHg)", "#7935b0", "▲", m => m.Pad),
        ("PAM (mmHg)", "#006b78", "■", m => m.Pam),
        ("Temperatura (°C)", "#a04b00", "✚", m => (double?)m.Temperatura),
        ("TLLC (s)", "#9d235e", "×", m => (double?)m.Tllc)
    ];

    private static string SvgNumero(double valor) => valor.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private (string Tipo, string Titulo, string? Nombre)[] AdjuntosTransfusion() =>
    [
        ("Consentimiento", "Consentimiento *", _trans.ConsentimientoNombre),
        ("Tipificacion", "Tipificación *", _trans.TipificacionNombre),
        ("PruebaMayor", "Crossmatch mayor", _trans.PruebaMayorNombre),
        ("PruebaMenor", "Crossmatch menor", _trans.PruebaMenorNombre)
    ];

    private async Task SeleccionarAdjuntoAsync(InputFileChangeEventArgs e, string tipo)
    {
        var ficha = _trans;
        try
        {
            var archivo = e.File;
            var nombre = System.IO.Path.GetFileName(archivo.Name);
            if (nombre.Length is 0 or > 200)
                throw new InvalidOperationException("El nombre del archivo debe tener entre 1 y 200 caracteres.");

            await using var entrada = archivo.OpenReadStream(5 * 1024 * 1024);
            using var memoria = new MemoryStream();
            await entrada.CopyToAsync(memoria);
            var bytes = memoria.ToArray();
            bool valido = System.IO.Path.GetExtension(nombre).ToLowerInvariant() switch
            {
                ".pdf" => bytes.AsSpan().StartsWith("%PDF-"u8),
                ".png" => bytes.AsSpan().StartsWith(new byte[] { 137, 80, 78, 71, 13, 10, 26, 10 }),
                ".jpg" or ".jpeg" => bytes.AsSpan().StartsWith(new byte[] { 255, 216, 255 }),
                _ => false
            };
            if (!valido)
                throw new InvalidOperationException("Selecciona un archivo PDF, PNG o JPEG válido.");

            if (!ReferenceEquals(ficha, _trans)) return;
            ficha.AdjuntosPendientes[tipo] = new AdjuntoTransfusionDto(nombre, bytes);
            _error = false;
            _mensaje = "";
        }
        catch (Exception ex)
        {
            if (ReferenceEquals(ficha, _trans)) Error(ex);
        }
    }

    private async Task DescargarAdjuntoAsync(string tipo)
    {
        try
        {
            var adjunto = await FichasService.ObtenerAdjuntoTransfusionAsync(_trans.Id, IdOrden, tipo);
            if (adjunto is not null)
                await ArchivosJS.InvokeVoidAsync("hosvetDownloadFile", adjunto.Nombre, "application/octet-stream",
                    Convert.ToBase64String(adjunto.Contenido));
        }
        catch (Exception ex) { Error(ex); }
    }

    private static readonly string[] MomentosTransfusion = ["T0", "15 min", "30 min", "45 min", "60 min", "1.5 h", "2 h", "2.5 h", "3 h", "3.5 h", "4 h", "4.5 h", "5 h", "5.5 h", "6 h"];
    private readonly Dictionary<string, TransfusionMonitoreoDto> _controlesEditados = new(StringComparer.OrdinalIgnoreCase);
    private bool _guardandoCuadricula;
    private bool _mostrarHistorial;

    private TransfusionMonitoreoDto ControlVisible(string momento) =>
        _controlesEditados.GetValueOrDefault(momento)
        ?? _trans.Monitoreos.Where(m => string.Equals(NormalizarMomento(m.Momento), momento, StringComparison.OrdinalIgnoreCase))
            .OrderBy(m => m.FechaHora).ThenBy(m => m.Id).LastOrDefault()
        ?? new() { Momento = momento };

    private TransfusionMonitoreoDto EditarControl(string momento)
    {
        if (!_controlesEditados.TryGetValue(momento, out var control))
        {
            control = ControlVisible(momento).Copiar();
            _controlesEditados.Add(momento, control);
        }
        return control;
    }

    private async Task GuardarCuadriculaAsync()
    {
        if (_trans.Id <= 0 || _guardandoCuadricula) return;
        _guardandoCuadricula = true;
        try
        {
            await EjecutarAsync(GuardarControlesPendientesAsync, "Monitoreo guardado.");
        }
        finally { _guardandoCuadricula = false; }
    }

    private async Task GuardarControlesPendientesAsync()
    {
        var ficha = _trans;
        foreach (var (momento, control) in _controlesEditados.ToArray())
        {
            if (!ReferenceEquals(ficha, _trans)) return;
            control.IdTransfusion = ficha.Id;
            await FichasService.GuardarControlCuadriculaAsync(control, ficha.IdOrden);
            if (!ReferenceEquals(ficha, _trans)) return;
            ficha.Monitoreos.RemoveAll(m => m.Id == control.Id);
            ficha.Monitoreos.Add(control);
            _controlesEditados.Remove(momento);
        }
    }

    private static string NormalizarMomento(string momento) =>
        momento.Trim().Replace(" hr", " h", StringComparison.OrdinalIgnoreCase);

    private List<TransfusionDto> _transfusiones = [];
    private List<string> _productos = [];
    private TransfusionDto _trans = new(); private TransfusionMonitoreoDto _mon = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ordenes = await KardexService.ObtenerOrdenesActivasAsync();
            if (IdOrden > 0)
                await CargarAsync();
            _productos = (await Catalogo.ObtenerProductosTransfusionAsync())
                .Concat(new[] { "Sangre entera", "Plasma", "Albúmina" }).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        }
        catch (Exception ex)
        {
            Error(ex);
        }
    }
    private bool _mostrarSugerencias;
    private async Task BuscarAutoAsync(){ await BuscarAsync(); _mostrarSugerencias = !string.IsNullOrWhiteSpace(_filtro) && _ordenes.Count > 0; }
    private async Task SeleccionarOrdenSugeridaAsync(OrdenActivaResumenDto o){ _mostrarSugerencias = false; IdOrden = o.IdOrdenAtencion; Nhcl = o.Nhcl; await CargarAsync(); }
    private async Task CerrarSugerenciasConRetrasoAsync(){ await Task.Delay(180); _mostrarSugerencias = false; }
    private async Task BuscarAsync()=>_ordenes=await KardexService.ObtenerOrdenesActivasAsync(_filtro.Trim());
    private string? _tipoSangre;
    private int _versionCargaPaciente;

    private async Task CambiarOrdenAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id) && id > 0 &&
            _ordenes.FirstOrDefault(x => x.IdOrdenAtencion == id) is { } orden)
        {
            await SeleccionarOrdenSugeridaAsync(orden);
            return;
        }

        IdOrden = Nhcl = 0;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var version = ++_versionCargaPaciente;
        var idOrden = IdOrden;
        var nhcl = Nhcl;
        _paciente = null;
        _tipoSangre = null;
        _transfusiones = [];
        NuevaTrans();
        if (idOrden <= 0) return;

        try
        {
            var paciente = await KardexService.ObtenerCabeceraPacienteAsync(idOrden, nhcl);
            if (paciente is null || version != _versionCargaPaciente) return;

            var tipoSangre = await AdmisionService.ObtenerTipoSangreMascotaAsync(idOrden, paciente.Nhcl);
            var transfusiones = await FichasService.ObtenerTransfusionesAsync(idOrden, paciente.Nhcl);
            if (version != _versionCargaPaciente) return;

            Nhcl = paciente.Nhcl;
            _paciente = paciente;
            _tipoSangre = string.IsNullOrWhiteSpace(tipoSangre) ? null : tipoSangre.Trim();
            _transfusiones = transfusiones;
            _mensaje = "";
            Session.SeleccionarOrden(idOrden, Nhcl, paciente.PacienteNombre);
            NuevaTrans();
        }
        catch (Exception ex)
        {
            if (version == _versionCargaPaciente)
                Error(ex);
        }
    }
    private async Task RecargarAsync() => _transfusiones = await FichasService.ObtenerTransfusionesAsync(IdOrden, Nhcl);
    private void NuevaTrans()
    {
        _controlesEditados.Clear();
        _trans = new()
        {
            IdOrden = IdOrden,
            Nhcl = Nhcl,
            Fecha = DateTime.Now,
            GrupoReceptor = _tipoSangre ?? string.Empty
        };
        _mon = new();
    }
    private void SeleccionarMomento(string momento) => _mon.Momento = momento;
    private void EditarTrans(TransfusionDto x){_mostrarHistorial=false;_controlesEditados.Clear();_trans=x;_mon=new(){IdTransfusion=x.Id,FechaHora=DateTime.Now};}
    private async Task GuardarTransAsync()=>await EjecutarAsync(async()=>{_trans.Id=await FichasService.GuardarTransfusionAsync(_trans,Session.IdUser);await GuardarControlesPendientesAsync();await RecargarAsync();_trans=_transfusiones.First(x=>x.Id==_trans.Id);_mon=new(){IdTransfusion=_trans.Id,FechaHora=DateTime.Now};},"Transfusión guardada.");
    private async Task AgregarMonAsync()=>await EjecutarAsync(async()=>{_mon.IdTransfusion=_trans.Id;await FichasService.AgregarMonitoreoAsync(_mon,IdOrden,Session.IdUser);await RecargarAsync();_trans=_transfusiones.First(x=>x.Id==_trans.Id);_mon=new(){IdTransfusion=_trans.Id,FechaHora=DateTime.Now};},"Control agregado.");
    private async Task EliminarTransAsync(int id)=>await EjecutarAsync(async()=>{await FichasService.EliminarTransfusionAsync(id,IdOrden);await RecargarAsync();NuevaTrans();},"Registro eliminado.");
    private async Task EjecutarAsync(Func<Task> accion,string ok){try{await accion();_error=false;_mensaje=ok;}catch(Exception ex){Error(ex);}}
    private void Error(Exception ex){_error=true;_mensaje=ex.GetBaseException().Message;}
}
