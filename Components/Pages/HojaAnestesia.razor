@page "/quirofano/anestesia"
@page "/quirofano/anestesia/{IdOrden:int}/{Nhcl:int}"
@using System.Globalization
@inject IKardexService KardexService
@inject IQuirofanoService QuirofanoService
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Hoja de Anestesia Intraoperatoria - e-ForVets</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="mb-0 fw-bold text-primary">Hoja de Registro Intraoperatorio de Anestesia</h4>
        <small class="text-muted">Monitoreo hemodinámico continuo, manejo de vía aérea, agentes anestésicos y balance hídrico intraoperatorio.</small>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center">
        <!-- Selector Dropbox de Órdenes -->
        <div class="d-flex align-items-center gap-1">
            <label class="small fw-bold text-secondary text-nowrap mb-0">Órdenes:</label>
            <select class="form-select form-select-sm" style="min-width: 280px; max-width: 360px;"
                    value="@IdOrden" @onchange="OnOrdenSelectChangedAsync">
                <option value="0">-- Seleccionar Orden Activa --</option>
                @foreach (var ord in ordenesActivas)
                {
                    <option value="@ord.IdOrdenAtencion">#@ord.IdOrdenAtencion | NHCL:@ord.Nhcl - @ord.Paciente (@ord.Cliente)</option>
                }
            </select>
        </div>

        <!-- Búsqueda Manual por Orden / NHCL con autocomplete -->
        <BuscadorOrdenClinica @bind-Orden="ordenInput" @bind-Nhcl="nhclInput" OnBuscar="CargarPorInputAsync" />

        @if (paciente != null)
        {
            <div class="btn-group btn-group-sm">
                @for (int f = 1; f <= 3; f++)
                {
                    int formNum = f;
                    <button class="btn @(hoja.NumFormulario == formNum ? "btn-primary fw-bold" : "btn-outline-primary")"
                            @onclick="() => CambiarHojaAsync(formNum)">
                        Hoja #@formNum
                    </button>
                }
            </div>

            <SaveButton class="btn btn-sm btn-success fw-semibold" OnClick="GuardarHojaAsync" Disabled="@guardando">
                @(guardando ? "Guardando..." : "Guardar Hoja Anestesia")
            </SaveButton>
            <button class="btn btn-sm btn-danger" @onclick="ExportarPdfAsync">PDF</button>
            <button class="btn btn-sm btn-outline-success" @onclick="ExportarExcelAsync">Excel</button>
            @if (Permisos.Permite("quirofano/recuperacion"))
            {
                <a class="btn btn-sm btn-outline-secondary" href="/quirofano/recuperacion/@IdOrden/@Nhcl">Ir a Recuperación</a>
            }
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small" role="alert">
        @mensajeAlerta
        <button type="button" class="btn-close py-2" @onclick="() => mensajeAlerta = string.Empty"></button>
    </div>
}

@if (cargandoInicial)
{
    <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span class="fw-semibold small">Cargando hoja intraoperatoria de anestesia...</span>
    </div>
}
else
{
    @if (paciente is null)
    {
        <div class="alert alert-info shadow-sm">Vista previa de la Hoja de Anestesia. Seleccione un paciente para habilitar el ingreso y guardado de información.</div>
    }
    <fieldset disabled="@(paciente is null)" class="m-0 p-0 border-0">
    <!-- Cabecera del Paciente y Tiempos Anestésicos -->
    <div class="card shadow-sm border-0 mb-3 bg-primary-subtle">
        <div class="card-body py-2 px-3">
            <div class="row g-2 align-items-center small">
                <div class="col-md-3">
                    <span class="text-muted">Orden / NHCL:</span>
                    <strong class="ms-1 text-primary">#@pacienteVista.OrdenAtencionId / @pacienteVista.Nhcl</strong>
                    <span class="badge bg-primary ms-2">ASA @hoja.Asa</span>
                </div>
                <div class="col-md-3">
                    <span class="text-muted">Paciente:</span>
                    <strong class="ms-1">@(pacienteVista.PacienteNombre.Length > 0 ? pacienteVista.PacienteNombre : "—")</strong> @(paciente is null ? "" : $"({pacienteVista.Especie} - {pacienteVista.Sexo})")
                </div>
                <div class="col-md-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Inicio</span>
                        <input type="time" class="form-control" value="@hoja.HoraInicio" @onchange="@(e => hoja.HoraInicio = e.Value?.ToString() ?? "")" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Fin</span>
                        <input type="time" class="form-control" value="@hoja.HoraFin" @onchange="@(e => hoja.HoraFin = e.Value?.ToString() ?? "")" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">ASA</span>
                        <select class="form-select" @bind="hoja.Asa">
                            <option value="">-- Seleccione --</option>
                            <option value="I">ASA I</option>
                            <option value="II">ASA II</option>
                            <option value="III">ASA III</option>
                            <option value="IV">ASA IV</option>
                            <option value="V">ASA V</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pestañas de Navegación Intraoperatoria -->
    <ul class="nav nav-tabs mb-3 small fw-semibold">
        <li class="nav-item">
            <button class="nav-link @(tabActiva == 1 ? "active text-primary" : "text-secondary")" @onclick="() => SeleccionarTab(1)">
                1. Gráfica Hemodinámica y Agentes (16 Tiempos)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == 2 ? "active text-primary" : "text-secondary")" @onclick="() => SeleccionarTab(2)">
                2. Vía Aérea, Monitoreo y Técnica Anestésica
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(tabActiva == 3 ? "active text-primary" : "text-secondary")" @onclick="() => SeleccionarTab(3)">
                3. Balance Hídrico Intraoperatorio y Cierre
            </button>
        </li>
    </ul>

    @if (tabActiva == 1)
    {
        <!-- GRÁFICA SVG EN TIEMPO REAL DE TENDENCIA HEMODINÁMICA -->
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                <span class="fw-bold text-primary small">Curva Hemodinámica Intraoperatoria en Tiempo Real (FC, PAS, PAD, SpO2, EtCO2)</span>
                <div class="d-flex gap-3 small">
                    <span><span class="badge" style="background:#dc2626">●</span> FC (lpm)</span>
                    <span><span class="badge" style="background:#2563eb">▼</span> PAS (mmHg)</span>
                    <span><span class="badge" style="background:#0284c7">▲</span> PAD (mmHg)</span>
                    <span><span class="badge" style="background:#16a34a">■</span> SpO2 (%)</span>
                    <span><span class="badge" style="background:#ca8a04">◆</span> EtCO2 (mmHg)</span>
                    <button class="btn btn-xs btn-outline-secondary py-0" @onclick="AutoGenerarIntervalos15Min">Autocompletar Horas (+15m)</button>
                </div>
            </div>
            <div class="card-body p-2">
                <svg viewBox="0 0 960 210" class="w-100 border rounded bg-light" style="max-height: 220px;">
                    @for (int val = 0; val <= 200; val += 40)
                    {
                        double y = 185 - (val / 220.0 * 165);
                        <line x1="55" y1="@y.ToString("F1", CultureInfo.InvariantCulture)" x2="940" y2="@y.ToString("F1", CultureInfo.InvariantCulture)" stroke="#e2e8f0" stroke-width="1" />
                        @((MarkupString)$"<text x=\"48\" y=\"{(y + 3).ToString("F1", CultureInfo.InvariantCulture)}\" text-anchor=\"end\" font-size=\"9\" fill=\"#64748b\">{val}</text>")
                    }

                    @for (int i = 0; i < 16; i++)
                    {
                        double x = 75 + i * 56;
                        <line x1="@x.ToString("F1", CultureInfo.InvariantCulture)" y1="15" x2="@x.ToString("F1", CultureInfo.InvariantCulture)" y2="185" stroke="#f1f5f9" stroke-width="1" />
                        @((MarkupString)$"<text x=\"{x.ToString("F1", CultureInfo.InvariantCulture)}\" y=\"200\" text-anchor=\"middle\" font-size=\"9\" font-weight=\"bold\" fill=\"#334155\">{hoja.SlotsTiempo[i].HoraLabel}</text>")
                    }

                    <!-- Polilíneas de FC, PAS, PAD, SpO2, EtCO2 -->
                        <polyline fill="none" stroke="#dc2626" stroke-width="2.2"  points="@ConstruirPuntosSvg(s => s.FrecuenciaCardiaca)" />
                    <polyline fill="none" stroke="#2563eb" stroke-width="2" stroke-dasharray="4,2" points="@ConstruirPuntosSvg(s => s.PresionSistolica)" />
                    <polyline fill="none" stroke="#0284c7" stroke-width="2" stroke-dasharray="2,2" points="@ConstruirPuntosSvg(s => s.PresionDiastolica)" />
                    <polyline fill="none" stroke="#16a34a" stroke-width="1.8" " points="@ConstruirPuntosSvg(s => s.O2L)" />
                        <polyline fill="none" stroke="#ca8a04" stroke-width="1.8"  points="@ConstruirPuntosSvg(s => s.EtCO2)" />

                    @for (int i = 0; i < 16; i++)
                    {
                        double x = 75 + i * 56;
                        var s = hoja.SlotsTiempo[i];
                        if (s.FrecuenciaCardiaca.HasValue)
                        {
                            double y = 185 - (Math.Clamp(s.FrecuenciaCardiaca.Value, 0, 220) / 220.0 * 165);
                            <circle cx="@x.ToString("F1", CultureInfo.InvariantCulture)" cy="@y.ToString("F1", CultureInfo.InvariantCulture)" r="3.5" fill="#dc2626" />
                        }
                        if (s.PresionSistolica.HasValue)
                        {
                            double y = 185 - (Math.Clamp(s.PresionSistolica.Value, 0, 220) / 220.0 * 165);
                            <circle cx="@x.ToString("F1", CultureInfo.InvariantCulture)" cy="@y.ToString("F1", CultureInfo.InvariantCulture)" r="3.2" fill="#2563eb" />
                        }
                        if (s.PresionDiastolica.HasValue)
                        {
                            double y = 185 - (Math.Clamp(s.PresionDiastolica.Value, 0, 220) / 220.0 * 165);
                            <circle cx="@x.ToString("F1", CultureInfo.InvariantCulture)" cy="@y.ToString("F1", CultureInfo.InvariantCulture)" r="3.2" fill="#0284c7" />
                            }
                            if (s.O2L.HasValue)
                            {
                                double y = 185 - (Math.Clamp(s.O2L.Value, 0, 220) / 220.0 * 165);
                                <circle cx="@x.ToString("F1", CultureInfo.InvariantCulture)" cy="@y.ToString("F1", CultureInfo.InvariantCulture)" r="3.2" fill="#16a34a" />
                        }
                            if (s.EtCO2.HasValue)
                        {
                                double y = 185 - (Math.Clamp(s.EtCO2.Value, 0, 220) / 220.0 * 165);
                                <circle cx="@x.ToString("F1", CultureInfo.InvariantCulture)" cy="@y.ToString("F1", CultureInfo.InvariantCulture)" r="3.2" fill="#ca8a04" />
                        }
                    }
                </svg>
            </div>
        </div>

        <!-- MATRIZ DE 16 INTERVALOS: SIGNOS VITALES + 15 AGENTES ANESTÉSICOS -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0 small" style="min-width: 1280px;">
                        <thead class="table-light text-center">
                            <tr>
                                <th class="text-start bg-primary-subtle" style="width: 220px;">Hora / Intervalo (1..16)</th>
                                @foreach (var slot in hoja.SlotsTiempo)
                                {
                                    <th style="width: 64px;">
                                        <input type="text" class="form-control form-control-sm text-center fw-bold px-1 py-0"
                                               @bind="slot.HoraLabel" />
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Parámetros Hemodinámicos y Respiratorios -->
                            <tr class="table-danger bg-opacity-10">
                                <td class="fw-bold text-danger">Frec. Cardíaca (lpm)</td>
                                @foreach (var slot in hoja.SlotsTiempo)
                                {
                                    <td><input type="number" min="0" class="form-control form-control-sm text-center px-1 py-0" @bind="slot.FrecuenciaCardiaca" @bind:event="oninput" /></td>
                                }
                            </tr>
                            <tr>
                                <td class="fw-bold text-primary">P. Arterial Sistólica (mmHg)</td>
                                @foreach (var slot in hoja.SlotsTiempo)
                                {
                                    <td><input type="number" min="0" class="form-control form-control-sm text-center px-1 py-0" @bind="slot.PresionSistolica" @bind:event="oninput" /></td>
                                }
                            </tr>
                            <tr>
                                <td class="fw-bold text-info">P. Arterial Diastólica (mmHg)</td>
                                @foreach (var slot in hoja.SlotsTiempo)
                                {
                                    <td><input type="number" min="0" class="form-control form-control-sm text-center px-1 py-0" @bind="slot.PresionDiastolica" @bind:event="oninput" /></td>
                                }
                            </tr>
                            <tr>
                                <td class="fw-semibold text-secondary">P. Arterial Media TAM (mmHg)</td>
                                @foreach (var slot in hoja.SlotsTiempo)
                                {
                                    <td><input type="text" class="form-control form-control-sm text-center px-1 py-0" @bind="slot.TensionArterialMedia" placeholder="@CalcularTamTexto(slot)" /></td>
                                }
                            </tr>
                            <tr>
                                <td class="fw-bold text-success">Saturación SpO2 (%)</td>
                                @foreach (var slot in hoja.SlotsTiempo)
                                {
                                    <td><input type="number" min="0" class="form-control form-control-sm text-center px-1 py-0" @bind="slot.O2L" @bind:event="oninput" /></td>
                                }
                            </tr>
                            <tr>
                                <td class="fw-bold text-warning-emphasis">Capnografía EtCO2 (mmHg)</td>
                                @foreach (var slot in hoja.SlotsTiempo)
                                {
                                    <td><input type="number" min="0" class="form-control form-control-sm text-center px-1 py-0" @bind="slot.EtCO2" @bind:event="oninput" /></td>
                                }
                            </tr>
                            <tr>
                                <td class="fw-semibold">Temperatura (°C)</td>
                                @foreach (var slot in hoja.SlotsTiempo)
                                {
                                    <td><input type="number" min="0" class="form-control form-control-sm text-center px-1 py-0" @bind="slot.Temperatura" /></td>
                                }
                            </tr>
                            <tr>
                                <td class="fw-semibold">Inducción (I) / Fin (X) / Incisión (⊙)</td>
                                @foreach (var slot in hoja.SlotsTiempo)
                                {
                                    <td><input type="text" class="form-control form-control-sm text-center px-1 py-0" @bind="slot.Induccion" placeholder="I/⊙/X" /></td>
                                }
                            </tr>

                            <!-- Separador de 15 Agentes Inhalatorios / IV / Fluidos -->
                            <tr class="table-secondary">
                                <td colspan="17" class="fw-bold small py-1">
                                    AGENTES ANESTÉSICOS, ANALGÉSICOS E INFUSIONES POR INTERVALO (15 FILAS CONFIGURABLES)
                                </td>
                            </tr>

                            @for (int ag = 0; ag < 15; ag++)
                            {
                                int idxAgente = ag;
                                <tr>
                                    <td>
                                        <input type="text" class="form-control form-control-sm fw-semibold py-0"
                                               @bind="hoja.NombresAgentes[idxAgente]" />
                                    </td>
                                    @foreach (var slot in hoja.SlotsTiempo)
                                    {
                                        <td>
                                            <input type="text" class="form-control form-control-sm text-center px-1 py-0"
                                                   @bind="slot.ValoresAgentes[idxAgente]" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (tabActiva == 2)
    {
        <div class="row g-3">
            <!-- Manejo de Vía Aérea -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary">Manejo de Vía Aérea y Ventilación</div>
                    <div class="card-body small">
                        <div class="row g-2 mb-2">
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.IntubOral" /> Intubación Orotraqueal</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.IntubNasal" /> Intubación Nasotraqueal</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.MascaraFacial" /> Máscara Facial</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.MascaraLaringea" /> Máscara Laríngea</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.IntubBalon" /> Balón Inflado (Cuff)</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.Traqueotomo" /> Traqueostomía</label></div>
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label mb-0 fw-semibold">N° Tubo Endotraqueal</label>
                                <input type="text" class="form-control form-control-sm" @bind="hoja.NumTubo" placeholder="Ej: 6.5 mm" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0 fw-semibold">N° Intentos</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.NIntentos" />
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 fw-semibold">Vol. Tidal (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.VolTidal" />
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 fw-semibold">Frec. Resp.</label>
                                <input type="text" class="form-control form-control-sm" @bind="hoja.FR" />
                            </div>
                            <div class="col-4">
                                <label class="form-label mb-0 fw-semibold">FiO2 (%)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.O2" />
                            </div>
                        </div>

                        <hr class="my-2" />
                        <label class="form-label fw-bold text-secondary mb-1">Modo Ventilatorio</label>
                        <div class="d-flex gap-3 mb-2">
                            <label><input type="checkbox" class="form-check-input me-1" @bind="hoja.VentEspontanea" /> Espontánea</label>
                            <label><input type="checkbox" class="form-check-input me-1" @bind="hoja.VentAsistida" /> Asistida</label>
                            <label><input type="checkbox" class="form-check-input me-1" @bind="hoja.VentMecanica" /> Mecánica</label>
                        </div>
                        <div>
                            <label class="form-label mb-0">PEEP (cmH2O)</label>
                            <input type="text" class="form-control form-control-sm" @bind="hoja.PEEP" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Monitoreo Anestésico -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary">Equipamiento de Monitoreo Intraoperatorio</div>
                    <div class="card-body small">
                        <div class="row g-2">
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.EKG" /> Electrocardiograma (EKG)</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.SPO2" /> Pulsioximetría (SpO2)</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.CO2ET" /> Capnografía (EtCO2)</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.PANI" /> P. Arterial No Invasiva</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.TempMonitoreo" /> Sensor Temperatura</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.PVC" /> Presión Venosa Central</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.SondaVesical" /> Sonda Vesical / Diuresis</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.SNG" /> Sonda Nasogástrica</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.AnalizadorGases" /> Analizador de Gases</label></div>
                            <div class="col-6"><label><input type="checkbox" class="form-check-input me-1" @bind="hoja.Gasometria" /> Gasometría Arterial</label></div>
                            <div class="col-12 mt-2">
                                <label class="form-label mb-0 fw-semibold">Otro Monitoreo Especializado</label>
                                <input type="text" class="form-control form-control-sm" @bind="hoja.OtraMonitorizacion" placeholder="Doppler, Línea Arterial Invasiva, TOF..." />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Técnica Anestésica -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary">Técnica Anestésica Aplicada</div>
                    <div class="card-body small">
                        <div class="d-flex flex-wrap gap-3 mb-2">
                            <label><input type="checkbox" class="form-check-input me-1" @bind="hoja.TecnicaGeneral" /> General Balanceada</label>
                            <label><input type="checkbox" class="form-check-input me-1" @bind="hoja.TecnicaRegional" /> Regional</label>
                            <label><input type="checkbox" class="form-check-input me-1" @bind="hoja.TecnicaEpidural" /> Epidural</label>
                            <label><input type="checkbox" class="form-check-input me-1" @bind="hoja.TecnicaSedacion" /> Sedación Profunda</label>
                            <label><input type="checkbox" class="form-check-input me-1" @bind="hoja.TecnicaLocal" /> Infiltrativa Local</label>
                        </div>

                        <div class="mb-2">
                            <label class="form-label mb-0 fw-semibold">Protocolo de Inducción</label>
                            <input type="text" class="form-control form-control-sm" @bind="hoja.Induccion" placeholder="Ej: Propofol + Fentanilo IV" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label mb-0 fw-semibold">Mantenimiento Anestésico</label>
                            <input type="text" class="form-control form-control-sm" @bind="hoja.Mantenimiento" placeholder="Ej: Isoflurano 1.5% + TIVA FLK" />
                        </div>
                        <div>
                            <label class="form-label mb-0 fw-semibold">Bloqueo de Nervio / Plexo Regional</label>
                            <input type="text" class="form-control form-control-sm" @bind="hoja.BloqueoRegional" placeholder="Ej: Epidural Lumbosacra Bupivacaína 0.5%" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (tabActiva == 3)
    {
        <div class="row g-3">
            <!-- Ingresos Parenterales Intraoperatorios -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-success">Ingresos Parenterales (ml)</div>
                    <div class="card-body small">
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label mb-0">Lactato de Ringer (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.IngLactatoRinger" @bind:event="oninput" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Solución Salina 0.9% (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.IngSalina09" @bind:event="oninput" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Dextrosa (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.IngDextrosa" @bind:event="oninput" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Expansor / Coloides (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.IngExpansor" @bind:event="oninput" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Sangre Total / GR (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.IngSangre" @bind:event="oninput" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Plasma Fresco (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.IngPlasma" @bind:event="oninput" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Manitol (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.IngManitol" @bind:event="oninput" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Otros Líquidos (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.IngOtros" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="alert alert-success py-1 px-2 mt-3 mb-0 d-flex justify-content-between">
                            <span>Total Ingresos:</span>
                            <strong>@hoja.TotalIngresos.ToString("N0") ml</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Egresos Intraoperatorios -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-danger">Egresos y Pérdidas (ml)</div>
                    <div class="card-body small">
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label mb-0">Sangrado Estimado (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.EgrSangrado" @bind:event="oninput" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Diuresis / Orina (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.EgrDiuresis" @bind:event="oninput" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Pérdidas Insensibles (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.EgrPerdidasInsensibles" @bind:event="oninput" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Otros Egresos (ml)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="hoja.EgrOtros" @bind:event="oninput" />
                            </div>
                        </div>

                        <div class="alert alert-danger py-1 px-2 mt-3 mb-2 d-flex justify-content-between">
                            <span>Total Egresos:</span>
                            <strong>@hoja.TotalEgresos.ToString("N0") ml</strong>
                        </div>

                        <div class="alert @(hoja.BalanceTotal >= 0 ? "alert-primary" : "alert-warning") py-2 px-2 mb-0 d-flex justify-content-between">
                            <span class="fw-bold">BALANCE HÍDRICO NETO:</span>
                            <strong class="fs-6">@(hoja.BalanceTotal >= 0 ? "+" : "")@hoja.BalanceTotal.ToString("N0") ml</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Duración y Observaciones Finales -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary">Duración y Cierre Anestésico</div>
                    <div class="card-body small">
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label mb-0">Duración Anestesia (Horas / Min)</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" min="0" class="form-control" @bind="hoja.DuracionAnestesiaHoras" placeholder="H" />
                                    <span class="input-group-text">h</span>
                                    <input type="number" min="0" max="59" class="form-control" @bind="hoja.DuracionAnestesiaMinutos" placeholder="M" />
                                    <span class="input-group-text">m</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Duración Cirugía (Horas / Min)</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" min="0" class="form-control" @bind="hoja.DuracionCirugiaHoras" placeholder="H" />
                                    <span class="input-group-text">h</span>
                                    <input type="number" min="0" max="59" class="form-control" @bind="hoja.DuracionCirugiaMin" placeholder="M" />
                                    <span class="input-group-text">m</span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label mb-0 fw-semibold">Incidentes, Complicaciones y Comentarios Intraoperatorios</label>
                            <textarea class="form-control form-control-sm" rows="4" @bind="hoja.Comentarios"></textarea>
                        </div>

                        <div>
                            <label class="form-label mb-0 fw-semibold">Anestesiólogo Responsable</label>
                            <input type="text" class="form-control form-control-sm" @bind="hoja.Firma" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    </fieldset>
}

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }

    private int ordenInput;
    private int nhclInput;
    private List<OrdenActivaResumenDto> ordenesActivas = new();

    private void SeleccionarTab(int t)
    {
        tabActiva = t;
        mensajeAlerta = string.Empty;
        esError = false;
    }
    private int tabActiva = 1;
    private PacienteHeaderDto? paciente;
    private PacienteHeaderDto pacienteVista => paciente ?? new();
    private HojaAnestesiaCompletaDto hoja = new();
    private bool cargandoInicial = true;
    private bool guardando;
    private string mensajeAlerta = string.Empty;
    private bool esError;

    protected override async Task OnParametersSetAsync()
    {
        cargandoInicial = true;
        await Task.Yield();

        ordenesActivas = await KardexService.ObtenerOrdenesActivasAsync();
        if (IdOrden <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
        {
            IdOrden = Session.OrdenActiva.Value;
            Nhcl = Session.NhclActivo ?? 0;
        }
        else if (IdOrden <= 0 && ordenesActivas.Count > 0)
        {
            IdOrden = ordenesActivas[0].IdOrdenAtencion;
            Nhcl = ordenesActivas[0].Nhcl;
        }

        if (IdOrden > 0 || Nhcl > 0)
        {
            ordenInput = IdOrden;
            nhclInput = Nhcl;
            await CargarDatosAsync(1);
        }
        cargandoInicial = false;
    }

    private async Task OnOrdenSelectChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selOrden) && selOrden > 0)
        {
            var ord = ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == selOrden);
            IdOrden = selOrden;
            Nhcl = ord?.Nhcl ?? 0;
            ordenInput = IdOrden;
            nhclInput = Nhcl;
            await CargarDatosAsync(1);
            Nav.NavigateTo($"/quirofano/anestesia/{IdOrden}/{Nhcl}", replace: true);
        }
    }

    private async Task CargarPorInputAsync()
    {
        if (ordenInput <= 0 && nhclInput > 0)
        {
            var matchNhcl = ordenesActivas.FirstOrDefault(x => x.Nhcl == nhclInput);
            if (matchNhcl != null) ordenInput = matchNhcl.IdOrdenAtencion;
        }

        if (ordenInput > 0 || nhclInput > 0)
        {
            IdOrden = ordenInput;
            Nhcl = nhclInput;
            var match = ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == IdOrden);
            if (match != null && Nhcl <= 0) Nhcl = match.Nhcl;
            await CargarDatosAsync(1);
            Nav.NavigateTo($"/quirofano/anestesia/{IdOrden}/{Nhcl}", replace: true);
        }
    }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CargarPorInputAsync();
        }
    }

    private async Task CambiarHojaAsync(int numForm)
    {
        mensajeAlerta = string.Empty;
        esError = false;
        await CargarDatosAsync(numForm);
    }

    private async Task CargarDatosAsync(int numForm)
    {
        mensajeAlerta = string.Empty;
        esError = false;
        var p = await KardexService.ObtenerCabeceraPacienteAsync(IdOrden, Nhcl);
        if (p != null)
        {
            Nhcl = p.Nhcl;
            Session.SeleccionarOrden(IdOrden, Nhcl, p.PacienteNombre);
            var h = await QuirofanoService.ObtenerHojaAnestesiaAsync(IdOrden, Nhcl, numForm);
            if (string.IsNullOrWhiteSpace(h.Firma))
                h.Firma = Session.CurrentUser?.NombreCompleto ?? string.Empty;
            hoja = h;
            paciente = p;
        }
        else
        {
            paciente = null;
            esError = true;
            mensajeAlerta = $"No se encontró la Orden #{IdOrden}.";
        }
    }

    private void AutoGenerarIntervalos15Min()
    {
        if (!TimeSpan.TryParse(hoja.HoraInicio, out var horaBase))
            horaBase = new TimeSpan(8, 0, 0);

        for (int i = 0; i < 16; i++)
        {
            var t = horaBase.Add(TimeSpan.FromMinutes(i * 15));
            hoja.SlotsTiempo[i].HoraLabel = $"{(int)t.TotalHours % 24:D2}:{t.Minutes:D2}";
        }
    }

    private string CalcularTamTexto(SlotGraficaAnestesiaDto s)
    {
        if (s.PresionSistolica.HasValue && s.PresionDiastolica.HasValue)
        {
            int tam = (s.PresionSistolica.Value + 2 * s.PresionDiastolica.Value) / 3;
            return tam.ToString();
        }
        return "";
    }

    private string ConstruirPuntosSvg(Func<SlotGraficaAnestesiaDto, int?> selector)
    {
        var pts = new List<string>();
        for (int i = 0; i < hoja.SlotsTiempo.Count; i++)
        {
            var val = selector(hoja.SlotsTiempo[i]);
            if (val.HasValue && val.Value > 0)
            {
                double x = 75 + i * 56;
                double y = 185 - (Math.Clamp(val.Value, 0, 220) / 220.0 * 165);
                pts.Add($"{x.ToString("F1", CultureInfo.InvariantCulture)},{y.ToString("F1", CultureInfo.InvariantCulture)}");
            }
        }
        return string.Join(" ", pts);
    }

    private async Task GuardarHojaAsync()
    {
        if (paciente == null) return;
        guardando = true;
        hoja.IdOrden = IdOrden;
        hoja.Nhcl = Nhcl;
        hoja.Sexo = paciente.Sexo;

        var ok = await QuirofanoService.GuardarHojaAnestesiaAsync(
            hoja,
            Session.CurrentUser?.IdUsuario ?? 1,
            Session.CurrentUser?.NombreCompleto ?? "Anestesiólogo");

        guardando = false;
        esError = !ok;
        mensajeAlerta = ok
            ? $"Hoja de Anestesia #{hoja.NumFormulario} guardada exitosamente en SQL Server."
            : "Error al guardar la Hoja de Anestesia.";
    }

    private async Task ExportarPdfAsync()
    {
        if (paciente == null) return;
        var bytes = ReportService.GenerarHojaAnestesiaPdf(paciente, hoja);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"HojaAnestesia_Orden_{IdOrden}.pdf", "application/pdf", Convert.ToBase64String(bytes));
    }

    private async Task ExportarExcelAsync()
    {
        if (paciente == null) return;
        var bytes = ReportService.GenerarHojaAnestesiaExcel(paciente, hoja);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"HojaAnestesia_Orden_{IdOrden}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
    }
}
