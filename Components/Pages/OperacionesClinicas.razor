@page "/operaciones/clinicas"
@page "/operaciones/clinicas/{IdOrden:int}/{Nhcl:int}"
@inject SessionStateService Session
@inject IAdministracionClinicaService Service
@inject NavigationManager Nav
<PageTitle>Operaciones clínicas | e-ForVets</PageTitle>
@if(_autorizado){<div class="container-fluid py-3"><h2>Ingreso, despacho, fisioterapia e i-STAT</h2>@if(!string.IsNullOrWhiteSpace(_mensaje)){<div class="alert @(_error?"alert-danger":"alert-success")">@_mensaje</div>}<ul class="nav nav-tabs mb-3">@foreach(var t in new[]{("ingreso","Control de ingreso"),("despacho","Despachos"),("fisio","Fisioterapia"),("istat","i-STAT")}){<li class="nav-item"><button class="nav-link @(_tab==t.Item1?"active":"")" @onclick="()=>Cambiar(t.Item1)">@t.Item2</button></li>}</ul>
@if(_tab!="despacho"){<div class="row g-2 mb-3"><div class="col-md-3"><label>Orden</label><input class="form-control" type="number" @bind="IdOrden" /></div><div class="col-md-3"><label>NHCL</label><input class="form-control" type="number" @bind="Nhcl" /></div><div class="col-md-2 align-self-end"><button class="btn btn-outline-primary" @onclick="CargarModulo">Cargar</button></div></div>}
@if(_tab=="ingreso"){<div class="card"><div class="card-body row g-3"><div class="col-md-3"><label>Fecha</label><input class="form-control" type="datetime-local" @bind="_ingreso.Fecha" /></div><div class="col-md-3"><label>Sala</label><input class="form-control" @bind="_ingreso.Sala" /></div><div class="col-md-3"><label>Entrada</label><input class="form-control" @bind="_ingreso.Entra" /></div><div class="col-md-3"><label>Salida</label><input class="form-control" @bind="_ingreso.Sale" /></div><div class="col-md-4"><label>Transporte</label><input class="form-control" @bind="_ingreso.Transporte" /></div><div class="col-md-4"><label>Posición</label><input class="form-control" @bind="_ingreso.Posicion" /></div><div class="col-12"><label>Observaciones</label><textarea class="form-control" @bind="_ingreso.Observaciones"></textarea></div><div><button class="btn btn-primary" @onclick="GuardarIngreso">Guardar ingreso</button></div></div></div>}
else if(_tab=="despacho"){<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Orden</th><th>Paciente</th><th>Propietario</th><th>Tipo</th><th>Etapa</th><th></th></tr></thead><tbody>@foreach(var x in _despachos){<tr><td>@x.IdOrden</td><td><strong>@x.Paciente</strong><small class="d-block">NHCL @x.Nhcl</small></td><td>@x.Propietario</td><td>@x.Tipo</td><td>@x.Etapa</td><td><button class="btn btn-sm btn-success" @onclick="()=>Procesar(x.IdOrden)">Procesado</button></td></tr>}</tbody></table></div>}
else if(_tab=="fisio"){<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-2"><label>Id producto</label><input class="form-control" type="number" @bind="_fisioNueva.IdProducto" /></div><div class="col-md-2"><label>Cantidad</label><input class="form-control" type="number" step="0.1" @bind="_fisioNueva.Cantidad" /></div><div class="col-md-6"><label>Observaciones</label><input class="form-control" @bind="_fisioNueva.Observaciones" /></div><div class="col-md-2 align-self-end"><button class="btn btn-primary" @onclick="GuardarFisio">Agregar</button></div></div></div>@foreach(var x in _fisio){<div class="border rounded p-2 mb-1"><strong>@x.Descripcion</strong><span class="float-end">@x.Cantidad</span><small class="d-block text-muted">@x.Fecha.ToString("yyyy-MM-dd") · @x.Observaciones</small></div>}}
else{<div class="card mb-3"><div class="card-body"><div class="row g-2">@foreach(var c in CamposIStat){<div class="col-md-3"><label>@c.Nombre</label><input class="form-control" value="@c.Get()" @onchange="e=>c.Set(e.Value?.ToString()??string.Empty)" /></div>}</div><button class="btn btn-primary mt-3" @onclick="GuardarIStat">Guardar resultado</button></div></div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Fecha</th><th>Hto</th><th>Hb</th><th>Urea</th><th>Creat.</th><th>Glucosa</th><th>Na</th><th>K</th><th>pH</th><th>Lactato</th><th></th></tr></thead><tbody>@foreach(var x in _istat){<tr><td>@x.Fecha.ToString("g")</td><td>@x.Hematocrito</td><td>@x.Hemoglobina</td><td>@x.Urea</td><td>@x.Creatinina</td><td>@x.Glucosa</td><td>@x.Sodio</td><td>@x.Potasio</td><td>@x.Ph</td><td>@x.Lactato</td><td><button class="btn btn-sm text-danger" @onclick="()=>EliminarIStat(x.Id)">Eliminar</button></td></tr>}</tbody></table></div>}</div>}
@code{[Parameter]public int IdOrden{get;set;}[Parameter]public int Nhcl{get;set;}private bool _autorizado,_error;private string _tab="ingreso",_mensaje="";private IngresoCirugiaDto _ingreso=new();private List<DespachoClinicoDto> _despachos=[];private List<FisioterapiaOrdenDto> _fisio=[];private FisioterapiaOrdenDto _fisioNueva=new();private List<IStatDto> _istat=[];private IStatDto _istatNuevo=new();private record Campo(string Nombre,Func<string> Get,Action<string> Set);private IEnumerable<Campo> CamposIStat=>[new("Hematocrito",()=>_istatNuevo.Hematocrito,x=>_istatNuevo.Hematocrito=x),new("Hemoglobina",()=>_istatNuevo.Hemoglobina,x=>_istatNuevo.Hemoglobina=x),new("Urea",()=>_istatNuevo.Urea,x=>_istatNuevo.Urea=x),new("Creatinina",()=>_istatNuevo.Creatinina,x=>_istatNuevo.Creatinina=x),new("Glucosa",()=>_istatNuevo.Glucosa,x=>_istatNuevo.Glucosa=x),new("Sodio",()=>_istatNuevo.Sodio,x=>_istatNuevo.Sodio=x),new("Potasio",()=>_istatNuevo.Potasio,x=>_istatNuevo.Potasio=x),new("pH",()=>_istatNuevo.Ph,x=>_istatNuevo.Ph=x),new("Lactato",()=>_istatNuevo.Lactato,x=>_istatNuevo.Lactato=x)];protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated){Nav.NavigateTo("/login");return;}_autorizado=true;await CargarModulo();}private async Task Cambiar(string t){_tab=t;await CargarModulo();}private async Task CargarModulo(){try{if(_tab=="despacho")_despachos=await Service.ObtenerDespachosAsync(DateTime.Today.AddDays(-30),DateTime.Today);else if(IdOrden>0&&Nhcl>0){if(_tab=="ingreso")_ingreso=await Service.ObtenerIngresoCirugiaAsync(IdOrden,Nhcl);else if(_tab=="fisio")_fisio=await Service.ObtenerFisioterapiaAsync(IdOrden,Nhcl);else _istat=await Service.ObtenerIStatAsync(Nhcl);}}catch(Exception){Mensaje(false);}}private async Task GuardarIngreso(){_ingreso.IdOrden=IdOrden;_ingreso.Nhcl=Nhcl;Mensaje(await Service.GuardarIngresoCirugiaAsync(_ingreso,Session.IdUser));}private async Task Procesar(int id){Mensaje(await Service.MarcarDespachoProcesadoAsync(id));await CargarModulo();}private async Task GuardarFisio(){_fisioNueva.IdOrden=IdOrden;_fisioNueva.Nhcl=Nhcl;var ok=await Service.GuardarFisioterapiaAsync(_fisioNueva);Mensaje(ok);if(ok){_fisioNueva=new();await CargarModulo();}}private async Task GuardarIStat(){_istatNuevo.Nhcl=Nhcl;var ok=await Service.GuardarIStatAsync(_istatNuevo,Session.IdUser);Mensaje(ok);if(ok){_istatNuevo=new();await CargarModulo();}}private async Task EliminarIStat(int id){Mensaje(await Service.EliminarIStatAsync(id,Session.IdUser));await CargarModulo();}private void Mensaje(bool ok){_error=!ok;_mensaje=ok?"Operación guardada correctamente.":"No se pudo completar la operación.";}}
