            TueSectorBarrio = mas.TueSectorBarrio,
            TueProvincia = mas.TueProvincia,
            TueCiudad = mas.TueCiudad
        };
        _nombresCientificos = await AdmisionService.ObtenerNombresCientificosAsync(mas.TueClase);
        _ciudades = mas.TueProvincia.HasValue ? await AdminService.ObtenerCiudadesAsync(mas.TueProvincia.Value) : [];
        _fotoMascota = null;
        _fotoMascotaPreview = ObtenerFotoPaciente(mas.MasNhcl);
        _errorFotoMascota = null;
        _fotoMascotaNombre = "Ningún archivo seleccionado";
    }

    private async Task SeleccionarFotoMascotaAsync(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        _errorFotoMascota = null;
        if (!archivo.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            _errorFotoMascota = "Seleccione una imagen JPG, PNG o WEBP.";
            return;
        }
        if (archivo.Size > 5 * 1024 * 1024)
        {
            _errorFotoMascota = "La imagen no puede superar 5 MB.";
            return;
        }
        _fotoMascota = archivo;
        _fotoMascotaNombre = archivo.Name;
        await using var stream = archivo.OpenReadStream(5 * 1024 * 1024);
        using var memoria = new MemoryStream();
        await stream.CopyToAsync(memoria);
        _fotoMascotaPreview = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}";
    }

    private string ObtenerFotoPaciente(int nhcl)
    {
        if (nhcl <= 0) return string.Empty;
        string directorio = Path.Combine(Env.WebRootPath, "PacientesFotos");
        if (!Directory.Exists(directorio)) return string.Empty;
        string? archivo = Directory.EnumerateFiles(directorio, $"{nhcl}.*").FirstOrDefault();
        return archivo is null ? string.Empty : $"/pacientes-fotos/{nhcl}?v={File.GetLastWriteTimeUtc(archivo).Ticks}";
    }

    private async Task GuardarFotoMascotaAsync(int nhcl)
    {
        if (_fotoMascota is null || nhcl <= 0) return;
        string extension = Path.GetExtension(_fotoMascota.Name).ToLowerInvariant();
        if (extension is not (".jpg" or ".jpeg" or ".png" or ".webp")) extension = ".jpg";
        string directorio = Path.Combine(Env.WebRootPath, "PacientesFotos");
        Directory.CreateDirectory(directorio);
        foreach (string anterior in Directory.EnumerateFiles(directorio, $"{nhcl}.*")) File.Delete(anterior);
        await using var entrada = _fotoMascota.OpenReadStream(5 * 1024 * 1024);
        await using var salida = File.Create(Path.Combine(directorio, $"{nhcl}{extension}"));
        await entrada.CopyToAsync(salida);
    }

    private async Task CambiarEspecieAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idEsp))
        {
            _mascotaEditando.MasEspecie = idEsp;
            _razas = await AdmisionService.ObtenerRazasPorEspecieAsync(idEsp);
            _mascotaEditando.MasRaza = _razas.FirstOrDefault()?.Id ?? 1;
        }
    }

    private async Task CambiarClaseTueriAsync(ChangeEventArgs e)
    {
        _mascotaEditando.TueClase = int.TryParse(e.Value?.ToString(), out int id) ? id : null;
        _nombresCientificos = await AdmisionService.ObtenerNombresCientificosAsync(_mascotaEditando.TueClase);
        _mascotaEditando.TueCientifico = string.Empty;
    }

    private async Task CambiarProvinciaAsync(ChangeEventArgs e)
    {
        _mascotaEditando.TueProvincia = int.TryParse(e.Value?.ToString(), out int id) ? id : null;
        _ciudades = _mascotaEditando.TueProvincia.HasValue
            ? await AdminService.ObtenerCiudadesAsync(_mascotaEditando.TueProvincia.Value)
            : [];
        _mascotaEditando.TueCiudad = null;
    }

    private async Task GuardarMascotaAsync()
    {
        if (_guardandoMascota) return;
        _guardandoMascota = true;
        try
        {
            if (SessionState.UsuarioActual is null)
            {
                _esError = true;
                _mensajeAlerta = "La sesión expiró. Inicia sesión nuevamente.";
                return;
            }
            if (_mascotaEditando.Fallecido && (!_mascotaEditando.FechaFallecido.HasValue || !_mascotaEditando.MotivoFallece.HasValue))
            {
                _esError = true;
                _mensajeAlerta = "La fecha y el motivo de muerte son obligatorios para un paciente fallecido.";
                return;
            }
            if (_mascotaEditando.Fallecido && _mascotaEditando.MotivoFallece == -1 && string.IsNullOrWhiteSpace(_mascotaEditando.MotivoFalleceOtro))
            {
                _esError = true;
                _mensajeAlerta = "Ingrese el motivo de muerte.";
                return;
            }
            if (_mascotaEditando.MasOrigen == "T" && (!_mascotaEditando.TueClase.HasValue || string.IsNullOrWhiteSpace(_mascotaEditando.TueCientifico)))
            {
                _esError = true;
                _mensajeAlerta = "La clase y el nombre científico son obligatorios para fauna silvestre.";
                return;
            }
            if (_mascotaEditando.MasFechaNace.Date > DateTime.Today)
            {
                _esError = true;
                _mensajeAlerta = "La fecha de nacimiento no puede ser posterior a la fecha actual.";
                return;
            }
            if (!string.IsNullOrWhiteSpace(_mascotaEditando.MasNombre))
            {
                _mascotaEditando.MasNombre = _mascotaEditando.MasNombre.Trim().ToUpperInvariant();
            }
            int idUser = SessionState.UsuarioActual.IdUsuario;
            _mascotaEditando.EspecieDescripcion = _especies.FirstOrDefault(e => e.Id == _mascotaEditando.MasEspecie)?.Descripcion ?? "Canino";
            _mascotaEditando.RazaDescripcion = _razas.FirstOrDefault(r => r.Id == _mascotaEditando.MasRaza)?.Descripcion ?? "Mestizo";
            _mascotaEditando.SexoDescripcion = _sexos.FirstOrDefault(s => s.Id == _mascotaEditando.MasSexo)?.Descripcion ?? "Macho";

            int nhcl = await AdmisionService.GuardarMascotaAsync(_mascotaEditando, idUser);
            _mascotaEditando.MasNhcl = nhcl;
            await GuardarFotoMascotaAsync(nhcl);
            await CargarPacientesClienteAsync(_mascotaEditando.MasIdCliente);
            _editandoMascotaNhcl = null;
            _esError = false;

            if (_flujoRegistroCompleto)
            {
                _flujoRegistroCompleto = false;
                _mensajeAlerta = $"¡Registro completado! Propietario #{_mascotaEditando.MasIdCliente} ({_clienteEditando.NombreCompleto}) y paciente '{_mascotaEditando.MasNombre}' (NHCL #{nhcl}) registrados exitosamente.";
            }
            else
            {
                _mensajeAlerta = $"Paciente NHCL #{nhcl} ({_mascotaEditando.MasNombre}) guardado correctamente en la base de datos.";
            }
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al guardar paciente en base de datos: {ex.Message}";
        }
        finally
        {
            _guardandoMascota = false;
        }
    }

