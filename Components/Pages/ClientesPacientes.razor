@page "/admision/clientes-pacientes"
@using HosvetKardex.Web.Models
@using HosvetKardex.Web.Services
@using HosvetKardex.Web.Data
@inject IAdmisionFacturacionService AdmisionService
@inject IAdministracionClinicaService AdminService
@inject SessionStateService SessionState
@inject NavigationManager NavManager
@inject IWebHostEnvironment Env
@inject ISqlDataService SqlData

<PageTitle>e-ForVets — Clientes y Pacientes</PageTitle>

<div class="container-fluid py-3 clients-page">
    <!-- Encabezado -->
    <div class="clients-hero d-flex flex-wrap justify-content-between align-items-center mb-3 p-3 rounded-3 bg-white">
        <div class="d-flex align-items-center gap-3">
            <div class="hero-icon"><i class="bi bi-people-fill"></i></div>
            <div>
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-people-fill me-2"></i>Propietarios y Pacientes
            </h4>
            <small class="text-muted">
                Gestión integral de propietarios, mascotas domésticas y fauna silvestre
            </small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm action-register-all" @onclick="IniciarRegistroCompleto">
                <i class="bi bi-person-plus-fill me-1"></i>+ Registrar
            </button>
            <a href="/admision/ordenes" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-clipboard2-plus me-1"></i>Ir a Recepción / Órdenes
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensajeAlerta))
    {
        <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2" role="alert">
            <i class="bi @(_esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@_mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => _mensajeAlerta = string.Empty"></button>
        </div>
    }

    <div class="row g-3 mb-3 stats-row">
        <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon blue"><i class="bi bi-person"></i></span><div><small>Total propietarios</small><strong>@_clientes.Count</strong></div></div></div>
        <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon violet"><i class="bi bi-heart-fill"></i></span><div><small>Pacientes registrados</small><strong>@TotalPacientes</strong></div></div></div>
        <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon teal"><i class="bi bi-person-check"></i></span><div><small>Con pacientes</small><strong>@PropietariosConPacientes</strong></div></div></div>
        <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon slate"><i class="bi bi-person-dash"></i></span><div><small>Sin pacientes</small><strong>@(_clientes.Count - PropietariosConPacientes)</strong></div></div></div>
    </div>

    @if (_cargandoInicial)
    {
        <LoadingState Title="Cargando propietarios y pacientes"
                      Message="Preparando el directorio clínico y sus mascotas." />
    }

    <!-- Barra de búsqueda unificada -->
    <div class="card search-card border-0 mb-3">
        <div class="card-body py-2">
            <div class="d-flex gap-2">
                <div class="input-group"><span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span><input type="text" class="form-control border-start-0"
                       placeholder="Buscar por nombre del animal, dueño o Cédula/RUC..."
                       value="@_filtroClientes" @oninput="BuscarMientrasEscribeAsync" @onkeydown="OnBuscarKeyDown" /></div>
                <button class="btn btn-primary px-4" @onclick="BuscarClientesAsync">Buscar</button>
                <button class="btn btn-secondary px-3 text-nowrap" @onclick="VerTodosAsync">Ver todos</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_filtroClientes))
            {
                <div class="search-feedback">@(_buscandoCoincidencias ? "Buscando coincidencias..." : $"{_clientes.Count} coincidencia(s) encontrada(s)")</div>
            }
        </div>
    </div>

    <!-- Nuevo propietario (formulario desplegable) -->
    @if (_editandoClienteId == 0)
    {
        <div class="owner-editor-backdrop" @onclick="CancelarEdicionCliente"></div>
        <aside class="owner-editor inline-panel">
            <div class="owner-editor-title">
                <span>
                    @if (_flujoRegistroCompleto)
                    {
                        <span class="badge bg-primary me-2">Paso 1 de 2</span>
                        <span>Datos del Propietario</span>
                    }
                    else
                    {
                        <span>Nuevo propietario</span>
                    }
                </span>
                <button class="btn-close" @onclick="CancelarEdicionCliente"></button>
            </div>
            <div class="owner-editor-summary new-owner-summary">
                <div class="summary-person-icon"><i class="bi bi-person-plus"></i></div>
                <div>
                    <strong>@(_flujoRegistroCompleto ? "Registro integral: Propietario y Paciente" : "Registrar propietario")</strong>
                    <small>@(_flujoRegistroCompleto ? "Complete los datos del propietario; a continuación registrará los datos del animal" : "Complete la información personal y de contacto")</small>
                </div>
            </div>
            <div class="editor-tabs"><span class="active">Información</span><span>Observaciones</span><span>Historial</span></div>
            <div class="card-body editor-form">
                @FormularioCliente
            </div>
        </aside>
    }

    <div class="owner-list-head"><span>Propietario</span><span>Contacto</span><span>Pacientes</span><span>Dirección</span><span>Acciones</span></div>
    <!-- Propietarios y pacientes -->
    @foreach (var cli in _clientes)
    {
        bool expandido = _clienteExpandido == cli.PaCodigo;
        var pacientes = ObtenerPacientes(cli.PaCodigo);
        <div class="card shadow-sm border-0 mb-2 owner-card @(expandido ? "owner-open" : "")">
            <div class="owner-header d-flex align-items-center gap-3 p-3" @onclick="() => AlternarClienteAsync(cli)">
                <div class="owner-profile">
                    <div class="owner-avatar">@Iniciales(cli)</div>
                    <div class="owner-identity">
                        <div class="fw-bold">@cli.NombreCompleto</div>
                        <div class="small text-muted">C.I. @cli.PaCedula</div>
                    </div>
                </div>
                <div class="owner-contact small">
                    <div><i class="bi bi-telephone text-primary me-2"></i>@cli.PaMovil</div>
                    @if (!string.IsNullOrWhiteSpace(cli.PaEmail)) { <div class="text-muted"><i class="bi bi-envelope text-primary me-2"></i>@cli.PaEmail</div> }
                </div>
                <span class="count-pill">@TextoContador(pacientes)</span>
                <div class="owner-address small">@cli.PaDireccion</div>
                <div class="owner-actions" @onclick:stopPropagation="true">
                    <button class="btn btn-sm action-patients" @onclick="() => AlternarClienteAsync(cli)">@(expandido ? "Ocultar" : "Ver pacientes")</button>
                    <button class="btn btn-sm action-add" @onclick='() => AgregarMascotaDesdeFilaAsync(cli)'>Agregar mascota</button>
                    <button class="btn btn-sm action-owner-edit" @onclick="() => EditarClienteAsync(cli)">Editar</button>
                </div>
            </div>

            @if (expandido)
            {
                @if (_viendoClienteId == cli.PaCodigo)
                {
                    <div class="border-top bg-light p-3 inline-panel">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark">
                                <i class="bi bi-eye me-1 text-primary"></i>Ficha del Propietario #@cli.PaCodigo (Solo Lectura)
                            </span>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarClienteAsync(cli)">
                                    <i class="bi bi-pencil-square me-1"></i>Editar
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _viendoClienteId = null">
                                    <i class="bi bi-x-lg me-1"></i>Cerrar
                                </button>
                            </div>
                        </div>
                        <div class="row g-2 bg-white p-3 rounded border">
                            <div class="col-md-4">
                                <small class="text-muted d-block">Tipo y N.º de Documento</small>
                                <span class="fw-bold"><span class="badge bg-secondary me-1">@cli.PaDocumento</span> @cli.PaCedula</span>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block">Apellidos</small>
                                <span class="fw-bold">@cli.PaApellidos</span>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block">Nombres</small>
                                <span class="fw-bold">@cli.PaNombres</span>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block">Teléfono Móvil (Celular)</small>
                                <span class="fw-bold">+593 @cli.PaMovil</span>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block">Teléfono Convencional</small>
                                <span>@(string.IsNullOrWhiteSpace(cli.PaTelefono) ? "—" : cli.PaTelefono)</span>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block">Correo Electrónico</small>
                                <span>@(string.IsNullOrWhiteSpace(cli.PaEmail) ? "—" : cli.PaEmail)</span>
                            </div>
                            <div class="col-md-12">
                                <small class="text-muted d-block">Dirección Domiciliaria</small>
                                <span>@(string.IsNullOrWhiteSpace(cli.PaDireccion) ? "—" : cli.PaDireccion)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(cli.PaObservaciones))
                            {
                                <div class="col-md-12">
                                    <small class="text-muted d-block">Observaciones</small>
                                    <span>@cli.PaObservaciones</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_editandoClienteId == cli.PaCodigo)
                {
                    <div class="owner-editor-backdrop" @onclick="CancelarEdicionCliente"></div>
                    <aside class="owner-editor inline-panel" @onclick:stopPropagation="true">
                        <div class="owner-editor-title"><span><i class="bi bi-person-badge me-2"></i>Editar propietario</span><button class="btn-close" @onclick="CancelarEdicionCliente"></button></div>
                        <div class="owner-editor-summary"><div class="summary-person-icon"><i class="bi bi-person"></i></div><div class="flex-grow-1"><strong>@cli.NombreCompleto</strong><small>C.I. @cli.PaCedula</small></div><span class="count-pill">@TextoContador(pacientes)</span></div>
                        <div class="editor-tabs"><span class="active">Información</span><span>Observaciones</span><span>Historial</span></div>
                        <div class="p-3 editor-form">@FormularioCliente</div>
                    </aside>
                }

                <div class="pets-expanded border-top">
                    <div class="pets-expanded-head"><strong>Mascotas de este propietario <span>(@pacientes.Count)</span></strong></div>
                    @if (pacientes.Count > 0)
                    {
                        <div class="pet-cards-grid">
                        @foreach (var mas in pacientes)
                        {
                            <article class="pet-card">
                                <div class="pet-card-main">
                                    <div class="pet-avatar">
                                        @if (!string.IsNullOrEmpty(ObtenerFotoPaciente(mas.MasNhcl))) { <img src="@ObtenerFotoPaciente(mas.MasNhcl)" alt="Foto de @mas.MasNombre" /> }
                                        else { <span>@InicialAnimal(mas)</span> }
                                    </div>
                                    <div class="pet-card-info">
                                        <div class="pet-name">@mas.MasNombre <span class="pet-kind @(mas.MasOrigen == "T" ? "wild" : "domestic")">@(mas.MasOrigen == "T" ? "Silvestre" : "Doméstico")</span></div>
                                        <div>@(string.IsNullOrWhiteSpace(mas.RazaDescripcion) ? mas.EspecieDescripcion : mas.RazaDescripcion) <span>· @mas.EspecieDescripcion</span></div>
                                        <small><i class="bi @(mas.MasSexo == 2 ? "bi-gender-female" : "bi-gender-male")"></i> @TextoSexo(mas) &nbsp; @mas.EdadCalculada</small>
                                    </div>
                                </div>
                                <div class="pet-card-actions">
                                    <button class="btn btn-sm action-record" @onclick="() => EditarMascotaAsync(mas)">Ver y editar ficha</button>
                                    <button class="btn btn-sm action-history" @onclick='() => NavManager.NavigateTo($"/consulta/historial/{mas.MasNhcl}")'>Historia</button>
                                    <button class="btn btn-sm action-order" @onclick='() => NavManager.NavigateTo($"/admision/ordenes?nhcl={mas.MasNhcl}")'>Orden</button>
                                    <button class="btn btn-sm action-summary" @onclick="() => AbrirModalResumen(mas)">Resumen</button>
                                </div>
                            </article>
                        }
                        </div>
                    }
                    else
                    {
                        <div class="empty-pets"><i class="bi bi-heart"></i><span>Este propietario aún no tiene pacientes registrados.</span></div>
                    }

                </div>
            }
        </div>
    }

    @if (_editandoMascotaNhcl.HasValue)
    {
        <div class="patient-modal-backdrop" @onclick="CancelarEdicionMascota"></div>
        <section class="patient-modal" role="dialog" aria-modal="true" aria-label="Ficha del paciente">
            <header class="patient-modal-header">
                <div>
                    <small>
                        @if (_flujoRegistroCompleto)
                        {
                            <span class="badge bg-success me-1">PASO 2 DE 2</span>
                            <span>DATOS DE LA MASCOTA</span>
                        }
                        else
                        {
                            @(_editandoMascotaNhcl == 0 ? "NUEVO PACIENTE" : $"NHCL #{_editandoMascotaNhcl}")
                        }
                    </small>
                    <h5>
                        @if (_flujoRegistroCompleto)
                        {
                            <span>Registrar paciente para @_clienteEditando.NombreCompleto</span>
                        }
                        else
                        {
                            @(_editandoMascotaNhcl == 0 ? "Agregar paciente" : "Ver y editar paciente")
                        }
                    </h5>
                </div>
                <button type="button" class="modal-close" title="Cerrar" @onclick="CancelarEdicionMascota">×</button>
            </header>
            <div class="patient-modal-body">@FormularioMascota</div>
        </section>
    }

    @if (_modalResumenAbierto && _mascotaResumen != null)
    {
        <div class="patient-modal-backdrop" @onclick="CerrarModalResumen"></div>
        <section class="summary-modal" role="dialog" aria-modal="true" aria-label="Resumen del paciente">
            <header class="summary-modal-header">
                <div>
                    <small>NHCL #@_mascotaResumen.MasNhcl · @(string.IsNullOrWhiteSpace(_mascotaResumen.RazaDescripcion) ? _mascotaResumen.EspecieDescripcion : _mascotaResumen.RazaDescripcion)</small>
                    <h5 class="mb-0">Resumen del paciente: @_mascotaResumen.MasNombre</h5>
                </div>
                <button type="button" class="modal-close" title="Cerrar" @onclick="CerrarModalResumen">×</button>
            </header>

            <div class="summary-tabs-bar">
                <ul class="nav nav-tabs flex-nowrap">
                    @foreach (var tab in _pestanasResumen)
                    {
                        <li class="nav-item">
                            <button type="button"
                                    class="nav-link @(_pestanaResumenActiva == tab.Id ? "active fw-bold text-dark" : "text-primary")"
                                    @onclick="() => _pestanaResumenActiva = tab.Id">
                                <span class="me-1">@tab.Icono</span> @tab.Titulo
                            </button>
                        </li>
                    }
                </ul>
            </div>

            <div class="summary-modal-body">
                <div class="summary-tab-content">
                    @switch (_pestanaResumenActiva)
                    {
                        case "resumen":
                            @if (_mascotaResumen != null)
                            {
                                var tutor = _clientes.FirstOrDefault(c => c.PaCodigo == _mascotaResumen.MasIdCliente);
                                var fotoUrl = ObtenerFotoPaciente(_mascotaResumen.MasNhcl);

                                <div class="resumen-container">
                                    <!-- BANNER PRINCIPAL DEL PACIENTE -->
                                    <div class="resumen-pet-banner">
                                        <div class="resumen-avatar-container">
                                            @if (!string.IsNullOrEmpty(fotoUrl))
                                            {
                                                <img src="@fotoUrl" alt="Foto de @_mascotaResumen.MasNombre" class="resumen-avatar" />
                                            }
                                            else
                                            {
                                                <div class="resumen-avatar-placeholder">
                                                    <span>@InicialAnimal(_mascotaResumen)</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="resumen-pet-details">
                                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                                <h3 class="resumen-pet-name mb-0">@_mascotaResumen.MasNombre</h3>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                    NHCL #@_mascotaResumen.MasNhcl
                                                </span>
                                                <span class="pet-kind @(_mascotaResumen.MasOrigen == "T" ? "wild" : "domestic")">
                                                    @(_mascotaResumen.MasOrigen == "T" ? "Fauna Silvestre (TUERI)" : "Mascota Doméstica (HDEV)")
                                                </span>
                                                @if (_mascotaResumen.Fallecido)
                                                {
                                                    <span class="badge bg-dark text-white px-2 py-1">
                                                        <i class="bi bi-heartbreak-fill me-1"></i> Fallecido @(_mascotaResumen.FechaFallecido.HasValue ? $"({_mascotaResumen.FechaFallecido.Value:dd/MM/yyyy})" : "")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                        <i class="bi bi-circle-fill me-1" style="font-size: .55rem;"></i> Activo
                                                    </span>
                                                }
                                            </div>

                                            <div class="resumen-pet-subinfo text-secondary mb-2">
                                                <span><strong>@(string.IsNullOrWhiteSpace(_mascotaResumen.RazaDescripcion) ? _mascotaResumen.EspecieDescripcion : _mascotaResumen.RazaDescripcion)</strong> · @_mascotaResumen.EspecieDescripcion</span>
                                                <span class="mx-2">•</span>
                                                <span><i class="bi @(_mascotaResumen.MasSexo == 2 ? "bi-gender-female text-danger" : "bi-gender-male text-primary")"></i> @TextoSexo(_mascotaResumen)</span>
                                                <span class="mx-2">•</span>
                                                <span><i class="bi bi-hourglass-split"></i> @_mascotaResumen.EdadCalculada</span>
                                            </div>

                                            <!-- Píldoras de Triaje / Manejo -->
                                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                                <span class="triaje-pill triaje-@(_mascotaResumen.MasColorTriaje ?? "green")">
                                                    <i class="bi bi-shield-fill-check me-1"></i>
                                                    @(_mascotaResumen.MasColorTriaje switch {
                                                        "red" => "Triaje Rojo (Alerta de Manejo / Agresivo)",
                                                        "yellow" => "Triaje Amarillo (Precaución / Nervioso)",
                                                        _ => "Triaje Verde (Temperamento Dócil / Normal)"
                                                    })
                                                </span>

                                                <span class="pill-info">
                                                    <i class="bi bi-scissors me-1"></i>
                                                    @(_mascotaResumen.MasCastrado == "SI" ? "Esterilizado / Castrado" : "Entero (Sin esterilizar)")
                                                </span>

                                                @if (!string.IsNullOrWhiteSpace(_mascotaResumen.MasMicrochip))
                                                {
                                                    <span class="pill-info">
                                                        <i class="bi bi-upc-scan me-1"></i> Chip: @_mascotaResumen.MasMicrochip
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <!-- Resumen rápido del Propietario en el Banner -->
                                        <div class="resumen-tutor-banner">
                                            <small class="text-uppercase fw-bold text-muted d-block mb-1">Tutor Responsable</small>
                                            <div class="fw-bold text-dark fs-6 text-truncate" title="@(tutor?.NombreCompleto ?? _mascotaResumen.ClienteNombre)">
                                                <i class="bi bi-person-circle me-1 text-primary"></i>
                                                @(tutor?.NombreCompleto ?? _mascotaResumen.ClienteNombre)
                                            </div>
                                            <div class="small text-muted mb-1">
                                                <i class="bi bi-card-text me-1"></i> C.I.: @(tutor?.PaCedula ?? _mascotaResumen.ClienteCedula)
                                            </div>
                                            <div class="small text-muted">
                                                <i class="bi bi-telephone-fill me-1 text-success"></i> @(string.IsNullOrWhiteSpace(tutor?.PaMovil) ? (tutor?.PaTelefono ?? _mascotaResumen.ClienteTelefono) : tutor.PaMovil)
                                            </div>
                                        </div>
                                    </div>

                                    <!-- CUADRÍCULA DE 2 COLUMNAS: INFORMACIÓN GENERAL Y RECORDATORIOS -->
                                    <div class="row g-3 mt-1">
                                        <!-- COLUMNA IZQUIERDA: INFORMACIÓN DEMOGRÁFICA Y CARACTERÍSTICAS -->
                                        <div class="col-lg-6 col-12 d-flex flex-column gap-3">
                                            <!-- Tarjeta Características Físicas -->
                                            <div class="resumen-card">
                                                <div class="resumen-card-header">
                                                    <span class="card-icon-bubble text-primary bg-primary-subtle">
                                                        <i class="bi bi-info-circle-fill"></i>
                                                    </span>
                                                    <h6 class="mb-0 fw-bold">Ficha de Identificación</h6>
                                                </div>
                                                <div class="resumen-card-body">
                                                    <div class="info-data-grid">
                                                        <div class="info-item">
                                                            <span class="info-label">Especie</span>
                                                            <span class="info-val">@_mascotaResumen.EspecieDescripcion</span>
                                                        </div>
                                                        <div class="info-item">
                                                            <span class="info-label">Raza</span>
                                                            <span class="info-val">@(string.IsNullOrWhiteSpace(_mascotaResumen.RazaDescripcion) ? "Mestizo / No especificada" : _mascotaResumen.RazaDescripcion)</span>
                                                        </div>
                                                        <div class="info-item">
                                                            <span class="info-label">Sexo</span>
                                                            <span class="info-val">@TextoSexo(_mascotaResumen)</span>
                                                        </div>
                                                        <div class="info-item">
                                                            <span class="info-label">Estado Reproductivo</span>
                                                            <span class="info-val">@(_mascotaResumen.MasCastrado == "SI" ? "Esterilizado" : "No esterilizado")</span>
                                                        </div>
                                                        <div class="info-item">
                                                            <span class="info-label">Fecha de Nacimiento</span>
                                                            <span class="info-val">@_mascotaResumen.MasFechaNace.ToString("dd/MM/yyyy")</span>
                                                        </div>
                                                        <div class="info-item">
                                                            <span class="info-label">Edad Estimada</span>
                                                            <span class="info-val">@_mascotaResumen.EdadCalculada</span>
                                                        </div>
                                                        <div class="info-item">
                                                            <span class="info-label">Color / Pelaje</span>
                                                            <span class="info-val">@(string.IsNullOrWhiteSpace(_mascotaResumen.ColorDescripcion) ? "No especificado" : _mascotaResumen.ColorDescripcion)</span>
                                                        </div>
                                                        <div class="info-item">
                                                            <span class="info-label">Microchip</span>
                                                            <span class="info-val">@(string.IsNullOrWhiteSpace(_mascotaResumen.MasMicrochip) ? "Sin registrar" : _mascotaResumen.MasMicrochip)</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Tarjeta de Observaciones y Señas Particulares -->
                                            <div class="resumen-card">
                                                <div class="resumen-card-header">
