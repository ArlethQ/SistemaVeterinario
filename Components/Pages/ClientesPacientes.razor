@page "/admision/clientes-pacientes"
@using HosvetKardex.Web.Models
@using HosvetKardex.Web.Services
@using HosvetKardex.Web.Data
@inject IAdmisionFacturacionService AdmisionService
@inject SessionStateService SessionState
@inject NavigationManager NavManager

<PageTitle>e-ForVets — Clientes y Pacientes</PageTitle>

<div class="container-fluid py-3">
    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 p-3 rounded-3 shadow-sm bg-white border-start border-4 border-primary">
        <div>
            <h4 class="mb-0 fw-bold text-primary">
                <i class="bi bi-people-fill me-2"></i>Propietarios y Pacientes
            </h4>
            <small class="text-muted">
                Gestión integral de propietarios, mascotas domésticas y fauna silvestre
            </small>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm" @onclick="NuevoCliente">
                <i class="bi bi-person-plus-fill me-1"></i>+ Nuevo propietario
            </button>
            <button class="btn btn-primary btn-sm" @onclick="NuevoPacienteDesdeEncabezadoAsync">
                <i class="bi bi-heart-pulse-fill me-1"></i>+ Nuevo paciente
            </button>
            <a href="/admision/ordenes" class="btn btn-success btn-sm">
                <i class="bi bi-clipboard2-plus me-1"></i>Ir a Recepción / Órdenes
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_mensajeAlerta))
    {
        <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2" role="alert">
            <i class="bi @(_esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@_mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => _mensajeAlerta = string.Empty"></button>
        </div>
    }

    @if (_cargandoInicial)
    {
        <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="fw-semibold small">Cargando directorio de propietarios y pacientes...</span>
        </div>
    }

    <!-- Barra de búsqueda unificada -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body py-2">
            <div class="d-flex gap-2">
                <input type="text" class="form-control"
                       placeholder="Buscar por nombre del animal, dueño o Cédula/RUC..."
                       @bind="_filtroClientes" @bind:event="oninput" @onkeydown="OnBuscarKeyDown" />
                <button class="btn btn-primary px-4" @onclick="BuscarClientesAsync">Buscar</button>
                <button class="btn btn-secondary px-3 text-nowrap" @onclick="VerTodosAsync">Ver todos</button>
            </div>
        </div>
    </div>

    <!-- Nuevo propietario (formulario desplegable) -->
    @if (_editandoClienteId == 0)
    {
        <div class="card shadow-sm border-0 mb-3 inline-panel">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-person-badge me-1"></i>Nuevo propietario
            </div>
            <div class="card-body">
                @FormularioCliente
            </div>
        </div>
    }

    <!-- Tarjetas de propietarios (acordeón) -->
    @foreach (var cli in _clientes)
    {
        bool expandido = _clienteExpandido == cli.PaCodigo;
        var pacientes = ObtenerPacientes(cli.PaCodigo);
        <div class="card shadow-sm border-0 mb-2 owner-card @(expandido ? "owner-open" : "")">
            <div class="owner-header d-flex align-items-center gap-3 p-3" @onclick="() => AlternarClienteAsync(cli)">
                <div class="owner-avatar">@Iniciales(cli)</div>
                <div class="flex-grow-1">
                    <div class="fw-bold">@cli.NombreCompleto</div>
                    <div class="small text-muted">
                        @cli.PaMovil
                        @if (!string.IsNullOrWhiteSpace(cli.PaEmail))
                        {
                            <span> · @cli.PaEmail</span>
                        }
                    </div>
                </div>
                <span class="count-pill">@TextoContador(pacientes)</span>
                <button class="btn btn-sm btn-outline-primary text-nowrap" @onclick:stopPropagation="true" @onclick="() => EditarClienteAsync(cli)">
                    <i class="bi bi-pencil-square me-1"></i>Editar dueño
                </button>
                <i class="bi @(expandido ? "bi-chevron-up" : "bi-chevron-down") text-muted"></i>
            </div>

            @if (expandido)
            {
                @if (_editandoClienteId == cli.PaCodigo)
                {
                    <div class="border-top bg-light p-3 inline-panel">
                        <div class="fw-bold mb-2 text-primary">
                            <i class="bi bi-person-badge me-1"></i>Editar dueño #@cli.PaCodigo
                        </div>
                        @FormularioCliente
                    </div>
                }

                <div class="border-top">
                    <table class="table table-sm align-middle mb-0 pet-table">
                        <thead>
                            <tr>
                                <th class="ps-3">Animal</th>
                                <th>Origen / Especie</th>
                                <th>Sexo</th>
                                <th>Edad</th>
                                <th class="text-end pe-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mas in pacientes)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="pet-avatar">@InicialAnimal(mas)</div>
                                            <div>
                                                <div class="fw-bold">@mas.MasNombre</div>
                                                <div class="small text-muted">@(string.IsNullOrWhiteSpace(mas.RazaDescripcion) ? mas.EspecieDescripcion : mas.RazaDescripcion)</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (mas.MasOrigen == "T")
                                        {
                                            <span class="badge bg-success me-1">Silvestre</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary me-1">Doméstico</span>
                                        }
                                        <span>@mas.EspecieDescripcion</span>
                                    </td>
                                    <td><span class="badge @ClaseSexo(mas)">@TextoSexo(mas)</span></td>
                                    <td>@mas.EdadCalculada</td>
                                    <td class="text-end pe-3 text-nowrap">
                                        <button class="btn btn-sm btn-outline-info py-0 px-2" @onclick='() => NavManager.NavigateTo($"/consulta/historial/{mas.MasNhcl}")'>
                                            <i class="bi bi-clock-history"></i> Ver historial
                                        </button>
                                        <button class="btn btn-sm btn-outline-success py-0 px-2" @onclick='() => NavManager.NavigateTo($"/admision/ordenes?nhcl={mas.MasNhcl}")'>
                                            <i class="bi bi-clipboard2-plus"></i> Orden
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning py-0 px-2" @onclick="() => EditarMascotaAsync(mas)">
                                            <i class="bi bi-pencil"></i> Editar
                                        </button>
                                    </td>
                                </tr>
                                @if (_editandoMascotaNhcl == mas.MasNhcl)
                                {
                                    <tr>
                                        <td colspan="5" class="bg-light p-3">
                                            <div class="inline-panel">
                                                <div class="fw-bold mb-2 text-primary">
                                                    <i class="bi bi-heart-pulse me-1"></i>Editar paciente NHCL #@mas.MasNhcl
                                                </div>
                                                @FormularioMascota
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            @if (pacientes.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">Este propietario aún no tiene pacientes registrados.</td></tr>
                            }
                        </tbody>
                    </table>

                    @if (_editandoMascotaNhcl == 0 && _mascotaEditando.MasIdCliente == cli.PaCodigo)
                    {
                        <div class="bg-light p-3 border-top inline-panel">
                            <div class="fw-bold mb-2 text-primary">
                                <i class="bi bi-plus-circle me-1"></i>Nuevo paciente
                            </div>
                            @FormularioMascota
                        </div>
                    }

                    <div class="p-3 d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary add-btn" @onclick='() => NuevaMascotaAsync(cli.PaCodigo, "M")'>+ Agregar mascota</button>
                        <button class="btn btn-sm btn-outline-success add-btn" @onclick='() => NuevaMascotaAsync(cli.PaCodigo, "T")'>+ Agregar paciente silvestre</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (!_cargandoInicial && _clientes.Count == 0)
    {
        <div class="text-center text-muted py-4">No se encontraron propietarios ni pacientes con ese criterio.</div>
    }
</div>

@code {
    private List<ClienteDto> _clientes = new();
    private readonly Dictionary<int, List<PacienteMascotaDto>> _mascotasPorCliente = new();
    private int? _clienteExpandido;
    private int? _editandoClienteId;
    private int? _editandoMascotaNhcl;
    private List<CatalogoItemGenericoDto> _especies = new();
    private List<CatalogoItemGenericoDto> _razas = new();
    private List<CatalogoItemGenericoDto> _sexos = new();
    private List<CatalogoItemGenericoDto> _clasesTueri = new();

    private ClienteDto? _clienteSeleccionado;
    private ClienteDto _clienteEditando = new() { PaDocumento = "CEDULA" };
    private PacienteMascotaDto _mascotaEditando = new();

    private string _filtroClientes = string.Empty;
    private bool _cargandoInicial = true;
    private string _mensajeAlerta = string.Empty;
    private bool _esError;
    private string? _errorDocumento;
    private bool _esDocValido;
    private string? _errorApellidos;
    private string? _errorNombres;
    private string? _errorMovil;
    private string? _errorEmail;
    private bool _esMovilValido;
    private string? _errorTelefono;
    private bool _esTelefonoValido;

    protected override async Task OnInitializedAsync()
    {
        _cargandoInicial = true;
        await Task.Yield();

        var tEsp = AdmisionService.ObtenerEspeciesAsync();
        var tSex = AdmisionService.ObtenerSexosAsync();
        var tCla = AdmisionService.ObtenerClasesTueriAsync();
        var tRaz = AdmisionService.ObtenerRazasPorEspecieAsync(1);
        var tCli = BuscarClientesAsync();
        await Task.WhenAll(tEsp, tSex, tCla, tRaz, tCli);

        _especies = await tEsp;
        _sexos = await tSex;
        _clasesTueri = await tCla;
        _razas = await tRaz;

        _cargandoInicial = false;
    }

    private async Task BuscarClientesAsync()
    {
        string filtro = _filtroClientes?.Trim() ?? string.Empty;
        var lista = await AdmisionService.BuscarClientesAsync(filtro);

        if (filtro.Length > 0)
        {
            // También incluir dueños cuyo animal coincide con la búsqueda
            var porAnimal = await AdmisionService.BuscarMascotasAsync(filtro, string.Empty);
            var idsExtra = porAnimal.Select(m => m.MasIdCliente)
                                    .Where(id => id > 0 && lista.All(c => c.PaCodigo != id))
                                    .Distinct().ToList();
            if (idsExtra.Count > 0)
            {
                var todos = await AdmisionService.BuscarClientesAsync(string.Empty);
                lista.AddRange(todos.Where(c => idsExtra.Contains(c.PaCodigo)));
            }
        }

        _clientes = lista;

        // Contadores de pacientes para las cabeceras
        var todasMascotas = await AdmisionService.BuscarMascotasAsync(string.Empty, string.Empty);
        foreach (var c in _clientes)
        {
            if (c.PaCodigo == _clienteExpandido) continue;
            _mascotasPorCliente[c.PaCodigo] = todasMascotas.Where(m => m.MasIdCliente == c.PaCodigo).ToList();
        }
    }

    private async Task VerTodosAsync()
    {
        _filtroClientes = string.Empty;
        await BuscarClientesAsync();
    }

    private async Task OnBuscarKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarClientesAsync();
    }

    private List<PacienteMascotaDto> ObtenerPacientes(int idCliente) =>
        _mascotasPorCliente.TryGetValue(idCliente, out var lista) ? lista : new List<PacienteMascotaDto>();

    private async Task CargarPacientesClienteAsync(int idCliente)
    {
        _mascotasPorCliente[idCliente] = await AdmisionService.ObtenerMascotasPorClienteAsync(idCliente);
    }

    private async Task AlternarClienteAsync(ClienteDto cli)
    {
        bool yaAbierto = _clienteExpandido == cli.PaCodigo;
        _editandoClienteId = null;
        _editandoMascotaNhcl = null;
        if (yaAbierto)
        {
            _clienteExpandido = null;
            return;
        }
        _clienteExpandido = cli.PaCodigo;
        _clienteSeleccionado = cli;
        await CargarPacientesClienteAsync(cli.PaCodigo);
    }

    private async Task EditarClienteAsync(ClienteDto cli)
    {
        if (_editandoClienteId == cli.PaCodigo)
        {
            _editandoClienteId = null;
            return;
        }
        _editandoMascotaNhcl = null;
        if (_clienteExpandido != cli.PaCodigo)
        {
            _clienteExpandido = cli.PaCodigo;
            await CargarPacientesClienteAsync(cli.PaCodigo);
        }
        CargarClienteEnFormulario(cli);
        _editandoClienteId = cli.PaCodigo;
    }

    private void CancelarEdicionCliente()
    {
        _editandoClienteId = null;
    }

    private static string Iniciales(ClienteDto c)
    {
        string a = (c.PaNombres ?? string.Empty).Trim();
        string b = (c.PaApellidos ?? string.Empty).Trim();
        string r = (a.Length > 0 ? a[..1] : string.Empty) + (b.Length > 0 ? b[..1] : string.Empty);
        return r.Length > 0 ? r.ToUpperInvariant() : "?";
    }

    private static string InicialAnimal(PacienteMascotaDto m) =>
        string.IsNullOrWhiteSpace(m.MasNombre) ? "?" : m.MasNombre.Trim()[..1].ToUpperInvariant();

    private static string TextoContador(List<PacienteMascotaDto> p)
    {
        int n = p.Count;
        if (n == 0) return "Sin pacientes";
        if (p.All(x => x.MasOrigen == "T")) return $"{n} ejemplar(es) silvestre(s)";
        if (p.All(x => x.MasOrigen != "T")) return $"{n} mascota(s)";
        return $"{n} paciente(s)";
    }

    private static string TextoSexo(PacienteMascotaDto m) => m.MasSexo switch
    {
        1 => "Macho",
        2 => "Hembra",
        _ => "Indeterminado"
    };

    private static string ClaseSexo(PacienteMascotaDto m) => m.MasSexo switch
    {
        1 => "bg-info text-dark",
        2 => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-secondary"
    };

    private void CargarClienteEnFormulario(ClienteDto cli)
    {
        _clienteSeleccionado = cli;
        string rawMovil = new string((cli.PaMovil ?? string.Empty).Where(char.IsDigit).ToArray());
        if (rawMovil.Length > 10) rawMovil = rawMovil[..10];

        _clienteEditando = new ClienteDto
        {
            PaCodigo = cli.PaCodigo,
            PaNombres = cli.PaNombres,
            PaApellidos = cli.PaApellidos,
            PaCedula = cli.PaCedula,
            PaTelefono = cli.PaTelefono,
            PaMovil = rawMovil,
            PaEmail = cli.PaEmail,
            PaEmailFactura = cli.PaEmailFactura,
            PaDireccion = cli.PaDireccion,
            PaObservaciones = cli.PaObservaciones,
            PaTipoCli = cli.PaTipoCli,
            PaDocumento = NormalizarTipoDocumento(cli.PaDocumento, cli.PaCedula),
            PaGrupoCliente = cli.PaGrupoCliente,
            PaTerminosPago = cli.PaTerminosPago,
            PaTipoPersona = cli.PaTipoPersona,
            PaFormaPago = cli.PaFormaPago
        };
        ValidarDocumentoEnVivo(_clienteEditando.PaCedula);
        ValidarApellidosEnVivo(_clienteEditando.PaApellidos);
        ValidarNombresEnVivo(_clienteEditando.PaNombres);
        ValidarMovilEnVivo(_clienteEditando.PaMovil);
        _errorEmail = null;
        ValidarTelefonoEnVivo(_clienteEditando.PaTelefono);
    }

    private void NuevoCliente()
    {
        _clienteSeleccionado = null;
        _clienteEditando = new ClienteDto { PaDocumento = "CEDULA" };
        _errorDocumento = null;
        _errorApellidos = null;
        _errorNombres = null;
        _errorEmail = null;
        _errorMovil = null;
        _esMovilValido = false;
        _errorTelefono = null;
        _esTelefonoValido = false;
        _esDocValido = false;
        _editandoClienteId = 0;
        _editandoMascotaNhcl = null;
        _clienteExpandido = null;
    }

    private static string NormalizarTipoDocumento(string? tipoDoc, string? cedula)
    {
        if (!string.IsNullOrWhiteSpace(tipoDoc))
        {
            var t = tipoDoc.Trim().ToUpperInvariant();
            if (t.StartsWith("RUC") || t == "R") return "RUC";
            if (t.StartsWith("PAS") || t == "P") return "PASAPORTE";
            if (t.StartsWith("CED") || t == "C") return "CEDULA";
        }
        if (!string.IsNullOrWhiteSpace(cedula) && cedula.Trim().Length == 13)
        {
            return "RUC";
        }
        return "CEDULA";
    }
    private bool EsDocumentoNumerico => _clienteEditando.PaDocumento != "PASAPORTE";
    private string InputModeDocumento => EsDocumentoNumerico ? "numeric" : "text";

        private int ObtenerMaximoDocumento() => _clienteEditando.PaDocumento switch
    {
        "CEDULA" => 10,
        "RUC" => 13,
        _ => 15
    };

    private string ObtenerPlaceholderDocumento() => _clienteEditando.PaDocumento switch
    {
        "CEDULA" => "Máx. 10 dígitos numéricos",
        "RUC" => "Máx. 13 dígitos numéricos",
        _ => "6 a 15 caracteres alfanuméricos"
    };

    private void OnCambiarTipoDocumento(ChangeEventArgs e)
    {
        _clienteEditando.PaDocumento = e.Value?.ToString() ?? "CEDULA";
        if (_clienteEditando.PaDocumento == "PASAPORTE")
        {
            _clienteEditando.PaCedula = EcuadorDocumentoValidador.LimpiarPasaporte(_clienteEditando.PaCedula);
        }
        else
        {
            var digitos = new string((_clienteEditando.PaCedula ?? string.Empty).Where(char.IsDigit).ToArray());
            int max = ObtenerMaximoDocumento();
            if (digitos.Length > max) digitos = digitos[..max];
            _clienteEditando.PaCedula = digitos;
        }
        ValidarDocumentoEnVivo(_clienteEditando.PaCedula);
    }

    private async Task OnInputDocumento(ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? string.Empty;
        if (_clienteEditando.PaDocumento == "PASAPORTE")
        {
            raw = EcuadorDocumentoValidador.LimpiarPasaporte(raw);
            if (raw.Length > 15) raw = raw[..15];
        }
        else
        {
            raw = new string(raw.Where(char.IsDigit).ToArray());
            int max = ObtenerMaximoDocumento();
            if (raw.Length > max) raw = raw[..max];
        }
        _clienteEditando.PaCedula = raw;
        ValidarDocumentoEnVivo(raw);
        await VerificarDuplicadoDocumentoAsync();
    }

    private async Task VerificarDuplicadoDocumentoAsync()
    {
        if (!_esDocValido) return;
        int id = await AdmisionService.BuscarDuplicadoClienteAsync("DOCUMENTO", _clienteEditando.PaCedula, _clienteEditando.PaCodigo);
        if (id > 0)
        {
            _errorDocumento = $"El documento {_clienteEditando.PaCedula} ya está registrado en el propietario #{id}.";
            _esDocValido = false;
        }
    }

    private async Task VerificarDuplicadoMovilAsync()
    {
        if (!_esMovilValido) return;
        int id = await AdmisionService.BuscarDuplicadoClienteAsync("MOVIL", _clienteEditando.PaMovil, _clienteEditando.PaCodigo);
        if (id > 0)
        {
            _errorMovil = $"El celular {_clienteEditando.PaMovil} ya está registrado en el propietario #{id}.";
            _esMovilValido = false;
        }
    }

    private string ClaseEmail => _errorEmail != null ? "form-control form-control-sm is-invalid border-danger" : "form-control form-control-sm";

    private async Task OnInputEmailAsync(ChangeEventArgs e)
    {
        _clienteEditando.PaEmail = e.Value?.ToString() ?? string.Empty;
        string email = _clienteEditando.PaEmail?.Trim() ?? string.Empty;
        _errorEmail = null;
        if (email.Length == 0) return;
        int id = await AdmisionService.BuscarDuplicadoClienteAsync("EMAIL", email, _clienteEditando.PaCodigo);
        if (id > 0)
            _errorEmail = $"El correo {email} ya está registrado en el propietario #{id}.";
    }

    private void ValidarDocumentoEnVivo(string valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
        {
            _errorDocumento = null;
            _esDocValido = false;
            return;
        }

        var res = EcuadorDocumentoValidador.Validar(_clienteEditando.PaDocumento, valor);
        _esDocValido = res.EsValido;
        _errorDocumento = res.Mensaje;
    }

    private void OnInputApellidos(ChangeEventArgs e)
    {
        string val = e.Value?.ToString() ?? string.Empty;
        _clienteEditando.PaApellidos = val;
        ValidarApellidosEnVivo(val);
    }

    private void OnBlurApellidos()
    {
        _clienteEditando.PaApellidos = NombreValidador.Sanitizar(_clienteEditando.PaApellidos);
        ValidarApellidosEnVivo(_clienteEditando.PaApellidos);
    }

    private void ValidarApellidosEnVivo(string val)
    {
        if (string.IsNullOrEmpty(val))
        {
            _errorApellidos = null;
            return;
        }
        var res = NombreValidador.Validar(val, "Los apellidos");
        _errorApellidos = res.MensajeError;
    }

    private void OnInputNombres(ChangeEventArgs e)
    {
        string val = e.Value?.ToString() ?? string.Empty;
        _clienteEditando.PaNombres = val;
        ValidarNombresEnVivo(val);
    }

    private void OnBlurNombres()
    {
        _clienteEditando.PaNombres = NombreValidador.Sanitizar(_clienteEditando.PaNombres);
        ValidarNombresEnVivo(_clienteEditando.PaNombres);
    }

    private void ValidarNombresEnVivo(string val)
    {
        if (string.IsNullOrEmpty(val))
        {
            _errorNombres = null;
            return;
        }
        var res = NombreValidador.Validar(val, "Los nombres");
        _errorNombres = res.MensajeError;
    }
    private async Task OnInputMovil(ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? string.Empty;
        raw = new string(raw.Where(char.IsDigit).ToArray());
        if (raw.Length > 10) raw = raw[..10];
        _clienteEditando.PaMovil = raw;
        ValidarMovilEnVivo(raw);
        await VerificarDuplicadoMovilAsync();
    }

    private void ValidarMovilEnVivo(string val)
    {
        if (string.IsNullOrWhiteSpace(val))
        {
            _errorMovil = null;
            _esMovilValido = false;
            return;
        }

        if (val.Length != 10 || !val.StartsWith("0"))
        {
            _errorMovil = "El número celular debe tener 10 dígitos y empezar con 0";
            _esMovilValido = false;
        }
        else
        {
            _errorMovil = null;
            _esMovilValido = true;
        }
    }

    private void OnInputTelefono(ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? string.Empty;
        raw = new string(raw.Where(char.IsDigit).ToArray());
        if (raw.Length > 7) raw = raw[..7];
        _clienteEditando.PaTelefono = raw;
        ValidarTelefonoEnVivo(raw);
    }

    private void ValidarTelefonoEnVivo(string val)
    {
        if (string.IsNullOrWhiteSpace(val))
        {
            _errorTelefono = null;
            _esTelefonoValido = false;
            return;
        }

        if (val.Length != 7 || val.StartsWith("0"))
        {
            _errorTelefono = "El teléfono convencional debe tener exactamente 7 dígitos y no iniciar en 0";
            _esTelefonoValido = false;
        }
        else
        {
            _errorTelefono = null;
            _esTelefonoValido = true;
        }
    }
    private async Task GuardarClienteAsync()
    {
        var resVal = EcuadorDocumentoValidador.Validar(_clienteEditando.PaDocumento, _clienteEditando.PaCedula);
        if (!resVal.EsValido)
        {
            _esError = true;
            _mensajeAlerta = $"Documento inválido: {resVal.Mensaje}";
            _errorDocumento = resVal.Mensaje;
            _esDocValido = false;
            return;
        }

        _clienteEditando.PaCedula = resVal.ValorLimpio;

        _clienteEditando.PaApellidos = NombreValidador.Sanitizar(_clienteEditando.PaApellidos);
        _clienteEditando.PaNombres = NombreValidador.Sanitizar(_clienteEditando.PaNombres);

        var valAp = NombreValidador.Validar(_clienteEditando.PaApellidos, "Los apellidos");
        if (!valAp.EsValido)
        {
            _esError = true;
            _errorApellidos = valAp.MensajeError;
            _mensajeAlerta = valAp.MensajeError!;
            return;
        }

        var valNom = NombreValidador.Validar(_clienteEditando.PaNombres, "Los nombres");
        if (!valNom.EsValido)
        {
            _esError = true;
            _errorNombres = valNom.MensajeError;
            _mensajeAlerta = valNom.MensajeError!;
            return;
        }

        // Validar Teléfono Móvil
        string movil = _clienteEditando.PaMovil?.Trim() ?? string.Empty;
        if (movil.Length != 10 || !movil.StartsWith("0"))
        {
            _esError = true;
            _errorMovil = "El número celular debe tener 10 dígitos y empezar con 0";
            _mensajeAlerta = _errorMovil;
            return;
        }

        if (!string.IsNullOrEmpty(_errorEmail))
        {
            _esError = true;
            _mensajeAlerta = _errorEmail;
            return;
        }

        // Validar Teléfono Convencional (opcional)
        string tel = _clienteEditando.PaTelefono?.Trim() ?? string.Empty;
        if (!string.IsNullOrEmpty(tel))
        {
            if (tel.Length != 7 || tel.StartsWith("0"))
            {
                _esError = true;
                _errorTelefono = "El teléfono convencional debe tener exactamente 7 dígitos y no iniciar en 0";
                _mensajeAlerta = _errorTelefono;
                return;
            }
        }


        try
        {
            int idUser = SessionState.UsuarioActual?.IdUsuario ?? 1;
            int idGuardado = await AdmisionService.GuardarClienteAsync(_clienteEditando, idUser);
            bool eraNuevo = _clienteEditando.PaCodigo == 0;
            _clienteEditando.PaCodigo = idGuardado;
            if (eraNuevo) _filtroClientes = string.Empty;
            await BuscarClientesAsync();
            _editandoClienteId = null;
            _clienteExpandido = idGuardado;
            await CargarPacientesClienteAsync(idGuardado);
            _esError = false;
            _mensajeAlerta = $"Propietario #{idGuardado} ({_clienteEditando.NombreCompleto}) guardado exitosamente en la base de datos.";
        }
        catch (DocumentoDuplicadoException ex)
        {
            _esError = true;
            if (ex.Campo == "MOVIL") { _errorMovil = ex.Message; _esMovilValido = false; }
            else if (ex.Campo == "EMAIL") { _errorEmail = ex.Message; }
            else { _errorDocumento = ex.Message; _esDocValido = false; }
            _mensajeAlerta = ex.Message;
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al guardar propietario en base de datos: {ex.Message}";
        }
    }

    private async Task NuevaMascotaAsync(int idCliente, string origen)
    {
        _editandoClienteId = null;
        _mascotaEditando = new PacienteMascotaDto
        {
            MasIdCliente = idCliente,
            MasOrigen = origen,
            MasEspecie = 1,
            MasSexo = 1,
            MasColorTriaje = "green",
            MasFechaNace = DateTime.Today.AddYears(-1)
        };
        _razas = await AdmisionService.ObtenerRazasPorEspecieAsync(1);
        _editandoMascotaNhcl = 0;
    }

    private async Task NuevoPacienteDesdeEncabezadoAsync()
    {
        if (_clienteExpandido is int idCliente)
        {
            await NuevaMascotaAsync(idCliente, "M");
        }
        else
        {
            _esError = true;
            _mensajeAlerta = "Primero expande un propietario para agregarle un paciente.";
        }
    }

    private async Task EditarMascotaAsync(PacienteMascotaDto mas)
    {
        if (_editandoMascotaNhcl == mas.MasNhcl)
        {
            _editandoMascotaNhcl = null;
            return;
        }
        _editandoClienteId = null;
        await CargarDatosMascotaAsync(mas);
        _editandoMascotaNhcl = mas.MasNhcl;
    }

    private void CancelarEdicionMascota()
    {
        _editandoMascotaNhcl = null;
    }

    private async Task CargarDatosMascotaAsync(PacienteMascotaDto mas)
    {
        _razas = await AdmisionService.ObtenerRazasPorEspecieAsync(mas.MasEspecie);
        _mascotaEditando = new PacienteMascotaDto
        {
            MasNhcl = mas.MasNhcl,
            MasIdCliente = mas.MasIdCliente,
            ClienteNombre = mas.ClienteNombre,
            ClienteCedula = mas.ClienteCedula,
            ClienteTelefono = mas.ClienteTelefono,
            MasNombre = mas.MasNombre,
            MasOrigen = mas.MasOrigen,
            MasSexo = mas.MasSexo,
            MasCastrado = mas.MasCastrado,
            MasEspecie = mas.MasEspecie,
            EspecieDescripcion = mas.EspecieDescripcion,
            MasRaza = mas.MasRaza,
            RazaDescripcion = mas.RazaDescripcion,
            MasOtros = mas.MasOtros,
            MasFechaNace = mas.MasFechaNace,
            MasObservacion = mas.MasObservacion,
            MasColorTriaje = mas.MasColorTriaje,
            TueClase = mas.TueClase,
            TuePeso = mas.TuePeso,
            TueCientifico = mas.TueCientifico,
            TueSectorBarrio = mas.TueSectorBarrio
        };
    }

    private async Task CambiarEspecieAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idEsp))
        {
            _mascotaEditando.MasEspecie = idEsp;
            _razas = await AdmisionService.ObtenerRazasPorEspecieAsync(idEsp);
            _mascotaEditando.MasRaza = _razas.FirstOrDefault()?.Id ?? 1;
        }
    }

    private async Task GuardarMascotaAsync()
    {
        try
        {
            int idUser = SessionState.UsuarioActual?.IdUsuario ?? 1;
            _mascotaEditando.EspecieDescripcion = _especies.FirstOrDefault(e => e.Id == _mascotaEditando.MasEspecie)?.Descripcion ?? "Canino";
            _mascotaEditando.RazaDescripcion = _razas.FirstOrDefault(r => r.Id == _mascotaEditando.MasRaza)?.Descripcion ?? "Mestizo";
            _mascotaEditando.SexoDescripcion = _sexos.FirstOrDefault(s => s.Id == _mascotaEditando.MasSexo)?.Descripcion ?? "Macho";

            int nhcl = await AdmisionService.GuardarMascotaAsync(_mascotaEditando, idUser);
            _mascotaEditando.MasNhcl = nhcl;
            await CargarPacientesClienteAsync(_mascotaEditando.MasIdCliente);
            _editandoMascotaNhcl = null;
            _esError = false;
            _mensajeAlerta = $"Paciente NHCL #{nhcl} ({_mascotaEditando.MasNombre}) guardado correctamente en la base de datos.";
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al guardar paciente en base de datos: {ex.Message}";
        }
    }

