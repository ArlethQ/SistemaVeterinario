                                    <div class="col-md-8"><label class="form-label small fw-bold">Nombre científico / común</label><select class="form-select form-select-sm" @bind="_mascotaEditando.TueCientifico"><option value="">Seleccione</option>@foreach (var x in _nombresCientificos){<option value="@x.Id">@x.Descripcion</option>}</select></div>
                                    <div class="col-md-4"><label class="form-label small fw-bold">Otra clase</label><InputText class="form-control form-control-sm" @bind-Value="_mascotaEditando.TueOtraClase" /></div>
                                    <div class="col-md-4"><label class="form-label small fw-bold">Peso</label><InputText class="form-control form-control-sm" @bind-Value="_mascotaEditando.TuePeso" /></div>
                                    <div class="col-md-4"><label class="form-label small fw-bold">Categoría de ingreso</label><select class="form-select form-select-sm" @bind="_mascotaEditando.TueCategoria"><option value="">Seleccione</option>@foreach (var x in _categoriasTueri){<option value="@x.Id">@x.Descripcion</option>}</select></div>
                                    <div class="col-md-4"><label class="form-label small fw-bold">Otra categoría</label><InputText class="form-control form-control-sm" @bind-Value="_mascotaEditando.TueOtraCategoria" /></div>
                                    <div class="col-md-4"><label class="form-label small fw-bold">Forma de obtención</label><select class="form-select form-select-sm" @bind="_mascotaEditando.TueFormaObtencion"><option value="">Seleccione</option>@foreach (var x in _formasObtencionTueri){<option value="@x.Id">@x.Descripcion</option>}</select></div>
                                    <div class="col-md-4"><label class="form-label small fw-bold">Otra forma de obtención</label><InputText class="form-control form-control-sm" @bind-Value="_mascotaEditando.TueOtraObtencion" /></div>
                                    <div class="col-md-4"><label class="form-label small fw-bold">Región</label><InputText class="form-control form-control-sm" @bind-Value="_mascotaEditando.TueRegion" /></div>
                                    <div class="col-md-4"><label class="form-label small fw-bold">Provincia</label><select class="form-select form-select-sm" value="@_mascotaEditando.TueProvincia" @onchange="CambiarProvinciaAsync"><option value="">Seleccione</option>@foreach (var x in _provincias){<option value="@x.Id">@x.Descripcion</option>}</select></div>
                                    <div class="col-md-4"><label class="form-label small fw-bold">Ciudad</label><select class="form-select form-select-sm" @bind="_mascotaEditando.TueCiudad"><option value="">Seleccione</option>@foreach (var x in _ciudades){<option value="@x.Id">@x.Descripcion</option>}</select></div>
                                    <div class="col-md-12"><label class="form-label small fw-bold">Sector / barrio</label><InputText class="form-control form-control-sm" @bind-Value="_mascotaEditando.TueSectorBarrio" /></div>
                                }

                                <div class="col-12 form-section-title mt-3">Estado clínico</div>
                                <div class="col-md-3 d-flex align-items-end"><label class="form-check mb-2"><InputCheckbox class="form-check-input" @bind-Value="_mascotaEditando.Fallecido" /><span class="form-check-label ms-2">Paciente fallecido</span></label></div>
                                @if (_mascotaEditando.Fallecido)
                                {
                                    <div class="col-md-4"><label class="form-label small fw-bold">Fecha de fallecimiento *</label><InputDate class="form-control form-control-sm" @bind-Value="_mascotaEditando.FechaFallecido" /></div>
                                    <div class="col-md-5"><label class="form-label small fw-bold">Motivo de muerte *</label><select class="form-select form-select-sm" @bind="_mascotaEditando.MotivoFallece"><option value="">Seleccione</option>@foreach (var x in _motivosMuerte){<option value="@x.Id">@x.Descripcion</option>}<option value="-1">Otro</option></select></div>
                                    @if (_mascotaEditando.MotivoFallece == -1)
                                    {
                                        <div class="col-md-5 offset-md-7"><label class="form-label small fw-bold">Especifique el motivo *</label><InputText class="form-control form-control-sm" maxlength="200" @bind-Value="_mascotaEditando.MotivoFalleceOtro" /></div>
                                    }
                                }

                                <div class="col-md-12">
                                    <label class="form-label small fw-bold">Antecedentes / Alergias / Observaciones del Paciente</label>
                                    <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_mascotaEditando.MasObservacion" />
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="small text-muted">Edad estimada: <strong>@_mascotaEditando.EdadCalculada</strong></span>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelarEdicionMascota">Cancelar</button>
                                    <button type="submit" class="btn btn-primary btn-sm" disabled="@_guardandoMascota">
                                        <i class="bi bi-save me-1"></i>@(_guardandoMascota ? "Guardando..." : "Guardar Paciente")
                                    </button>
                                </div>
                            </div>
                        </EditForm>
    </text>;

    private static string ObtenerColorHexTriaje(string color) => color switch
    {
        "red" => "#dc2626",
        "yellow" => "#d97706",
        _ => "#16a34a"
    };

    private static string ObtenerTextoTriaje(string color) => color switch
    {
        "red" => "Crítico / Precaución",
        "yellow" => "Nervioso",
        _ => "Dócil"
    };
}
