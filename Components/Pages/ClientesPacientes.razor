        {
            _clienteEditando.PaCedula = EcuadorDocumentoValidador.LimpiarPasaporte(_clienteEditando.PaCedula);
        }
        else
        {
            var digitos = new string((_clienteEditando.PaCedula ?? string.Empty).Where(char.IsDigit).ToArray());
