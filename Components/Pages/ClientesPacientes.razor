    {
        public int Id { get; set; }
        public DateTime Fecha { get; set; }
        public string Hora { get; set; } = string.Empty;
        public string Medico { get; set; } = string.Empty;
        public string Especialidad { get; set; } = string.Empty;
        public string Observacion { get; set; } = string.Empty;
    }

    private class RecordatorioVacunaItem
    {
        public string Vacuna { get; set; } = string.Empty;
        public DateTime? FechaAplicacion { get; set; }
        public DateTime FechaProxima { get; set; }
        public string Medico { get; set; } = string.Empty;
        public int DiasRestantes => (FechaProxima.Date - DateTime.Today).Days;
    }

    private List<RecordatorioCitaItem> _recordatoriosCitas = new();
    private List<RecordatorioVacunaItem> _recordatoriosVacunas = new();
    private bool _cargandoRecordatorios;

    private async Task CargarRecordatoriosAsync(int nhcl)
    {
        _recordatoriosCitas.Clear();
        _recordatoriosVacunas.Clear();
        _cargandoRecordatorios = true;
        try
        {
            var citas = await SqlData.QueryAsync<RecordatorioCitaItem>(@"
                SELECT c.ci_id AS Id, c.ci_fecha AS Fecha, ISNULL(c.ci_hora, '08:00') AS Hora,
                       ISNULL(u.user_nombre, 'Médico veterinario') AS Medico,
                       ISNULL(e.es_descripcion, 'Consulta') AS Especialidad,
                       ISNULL(c.ci_observacion, '') AS Observacion
                FROM vt_citas c
                LEFT JOIN vt_usuarios u ON c.ci_usuario = u.user_numero
                LEFT JOIN vt_especialidades e ON u.user_esp_numero = e.es_id
                WHERE c.ci_nhcl = @Nhcl AND ISNULL(c.ci_estado, 'A') = 'A' AND ISNULL(c.ci_estadoCita, 'N') != 'X'
                  AND c.ci_fecha >= CAST(GETDATE() AS DATE)
                ORDER BY c.ci_fecha, c.ci_hora", new { Nhcl = nhcl });
            _recordatoriosCitas = citas.ToList();
        }
        catch
        {
            _recordatoriosCitas = new();
        }

        try
        {
            var vacunas = await SqlData.QueryAsync<RecordatorioVacunaItem>(@"
                SELECT ISNULL(p.prod_descripcion, ISNULL(v.vacuna_tipo, 'Vacuna')) AS Vacuna,
                       v.vacuna_fecha AS FechaAplicacion,
                       v.vacuna_revacunacion AS FechaProxima,
                       ISNULL(u.user_nombre, 'Médico') AS Medico
                FROM vt_vacunas v
                LEFT JOIN vt_productos p ON v.vacuna_idprod = p.prod_id
                LEFT JOIN vt_usuarios u ON v.vacuna_iduser = u.user_numero
                WHERE v.vacuna_nhcl = @Nhcl AND ISNULL(v.vacuna_estado, 'A') = 'A'
                  AND v.vacuna_revacunacion IS NOT NULL
                  AND v.vacuna_revacunacion >= DATEADD(month, -1, CAST(GETDATE() AS DATE))
                ORDER BY v.vacuna_revacunacion ASC", new { Nhcl = nhcl });
            _recordatoriosVacunas = vacunas.ToList();
        }
        catch
        {
            _recordatoriosVacunas = new();
        }
        finally
        {
            _cargandoRecordatorios = false;
            StateHasChanged();
        }
    }

