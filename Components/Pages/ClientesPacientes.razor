    private static string NormalizarTipoDocumento(string? tipoDoc, string? cedula)
    {
        if (!string.IsNullOrWhiteSpace(tipoDoc))
        {
            var t = tipoDoc.Trim().ToUpperInvariant();
            if (t.StartsWith("RUC") || t == "R") return "RUC";
            if (t.StartsWith("PAS") || t == "P") return "PASAPORTE";
            if (t.StartsWith("CED") || t == "C") return "CEDULA";
        }
        if (!string.IsNullOrWhiteSpace(cedula) && cedula.Trim().Length == 13)
        {
            return "RUC";
        }
        return "CEDULA";
    }
