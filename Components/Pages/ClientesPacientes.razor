@code {
    private List<ClienteDto> _clientes = new();
    private readonly Dictionary<int, List<PacienteMascotaDto>> _mascotasPorCliente = new();
    private int? _clienteExpandido;
    private int? _editandoClienteId;
    private int? _editandoMascotaNhcl;
    private int? _viendoClienteId;
    private int? _viendoMascotaNhcl;
    private List<CatalogoItemGenericoDto> _especies = new();
    private List<CatalogoItemGenericoDto> _razas = new();
    private List<CatalogoItemGenericoDto> _sexos = new();
    private List<CatalogoItemGenericoDto> _clasesTueri = new();
    private List<CatalogoItemGenericoDto> _categoriasTueri = new();
    private List<CatalogoItemGenericoDto> _formasObtencionTueri = new();
    private List<CatalogoItemGenericoDto> _nombresCientificos = new();
    private List<CatalogoItemGenericoDto> _motivosMuerte = new();
    private List<CatalogoItemGenericoDto> _provincias = new();
    private List<CatalogoItemGenericoDto> _ciudades = new();

    private bool _flujoRegistroCompleto;
    private ClienteDto? _clienteSeleccionado;
    private ClienteDto _clienteEditando = new() { PaDocumento = "CEDULA" };
    private PacienteMascotaDto _mascotaEditando = new();

    private string _filtroClientes = string.Empty;
    private int _versionBusqueda;
    private bool _buscandoCoincidencias;
    private bool _cargandoInicial = true;
    private string _mensajeAlerta = string.Empty;
    private bool _esError;
    private string? _errorDocumento;
    private bool _esDocValido;
    private string? _errorApellidos;
    private string? _errorNombres;
    private string? _errorMovil;
    private string? _errorEmail;
    private bool _esMovilValido;
    private string? _errorTelefono;
    private bool _esTelefonoValido;
    private IBrowserFile? _fotoMascota;
    private string? _fotoMascotaPreview;
    private string? _errorFotoMascota;
    private static string MaxFechaNacimiento => DateTime.Today.ToString("yyyy-MM-dd");
    private string _fotoMascotaNombre = "Ningún archivo seleccionado";
    private bool _guardandoMascota;
    private int TotalPacientes => _clientes.Sum(c => ObtenerPacientes(c.PaCodigo).Count);
    private int PropietariosConPacientes => _clientes.Count(c => ObtenerPacientes(c.PaCodigo).Count > 0);

    protected override async Task OnInitializedAsync()
    {
        _cargandoInicial = true;
        await Task.Yield();

        var tEsp = AdmisionService.ObtenerEspeciesAsync();
        var tSex = AdmisionService.ObtenerSexosAsync();
        var tCla = AdmisionService.ObtenerClasesTueriAsync();
        var tCat = AdmisionService.ObtenerCategoriasIngresoTueriAsync();
        var tObt = AdmisionService.ObtenerFormasObtencionTueriAsync();
        var tCie = AdmisionService.ObtenerNombresCientificosAsync();
        var tMot = AdmisionService.ObtenerMotivosMuerteAsync();
        var tPro = AdminService.ObtenerProvinciasAsync();
        var tRaz = AdmisionService.ObtenerRazasPorEspecieAsync(1);
        var tCli = BuscarClientesAsync();
        await Task.WhenAll(tEsp, tSex, tCla, tCat, tObt, tCie, tMot, tPro, tRaz, tCli);

        _especies = await tEsp;
        _sexos = await tSex;
        _clasesTueri = await tCla;
        _categoriasTueri = await tCat;
        _formasObtencionTueri = await tObt;
        _nombresCientificos = await tCie;
        _motivosMuerte = await tMot;
        _provincias = await tPro;
        _razas = await tRaz;

        _cargandoInicial = false;
    }

    private async Task BuscarClientesAsync()
    {
        string filtro = _filtroClientes?.Trim() ?? string.Empty;
        var lista = await AdmisionService.BuscarClientesAsync(filtro);

        if (filtro.Length > 0)
        {
            // También incluir dueños cuyo animal coincide con la búsqueda
            var porAnimal = await AdmisionService.BuscarMascotasAsync(filtro, string.Empty);
            var idsExtra = porAnimal.Select(m => m.MasIdCliente)
                                    .Where(id => id > 0 && lista.All(c => c.PaCodigo != id))
                                    .Distinct().ToList();
            if (idsExtra.Count > 0)
            {
                var todos = await AdmisionService.BuscarClientesAsync(string.Empty);
                lista.AddRange(todos.Where(c => idsExtra.Contains(c.PaCodigo)));
            }
        }

        _clientes = lista;

        // Contadores de pacientes para las cabeceras
        var todasMascotas = await AdmisionService.BuscarMascotasAsync(string.Empty, string.Empty);
        foreach (var c in _clientes)
        {
            if (c.PaCodigo == _clienteExpandido) continue;
            _mascotasPorCliente[c.PaCodigo] = todasMascotas.Where(m => m.MasIdCliente == c.PaCodigo).ToList();
        }
    }

    private async Task VerTodosAsync()
    {
        _filtroClientes = string.Empty;
        await BuscarClientesAsync();
    }

    private async Task BuscarMientrasEscribeAsync(ChangeEventArgs e)
    {
        _filtroClientes = e.Value?.ToString() ?? string.Empty;
        int versionActual = ++_versionBusqueda;
        _buscandoCoincidencias = true;
        await Task.Delay(300);
        if (versionActual != _versionBusqueda) return;
        await BuscarClientesAsync();
        if (versionActual == _versionBusqueda) _buscandoCoincidencias = false;
    }

    private async Task OnBuscarKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarClientesAsync();
    }

    private List<PacienteMascotaDto> ObtenerPacientes(int idCliente) =>
        _mascotasPorCliente.TryGetValue(idCliente, out var lista) ? lista : new List<PacienteMascotaDto>();

    private async Task CargarPacientesClienteAsync(int idCliente)
    {
        _mascotasPorCliente[idCliente] = await AdmisionService.ObtenerMascotasPorClienteAsync(idCliente);
    }

    private async Task AlternarClienteAsync(ClienteDto cli)
    {
        bool yaAbierto = _clienteExpandido == cli.PaCodigo;
        _editandoClienteId = null;
        _editandoMascotaNhcl = null;
        _viendoClienteId = null;
        _viendoMascotaNhcl = null;
        if (yaAbierto)
        {
            _clienteExpandido = null;
            return;
        }
        _clienteExpandido = cli.PaCodigo;
        _clienteSeleccionado = cli;
        await CargarPacientesClienteAsync(cli.PaCodigo);
    }

    private async Task AlternarVerCliente(ClienteDto cli)
    {
        if (_viendoClienteId == cli.PaCodigo)
        {
            _viendoClienteId = null;
            return;
        }
        _editandoClienteId = null;
        if (_clienteExpandido != cli.PaCodigo)
        {
            _clienteExpandido = cli.PaCodigo;
            await CargarPacientesClienteAsync(cli.PaCodigo);
        }
        _viendoClienteId = cli.PaCodigo;
    }

    private void AlternarVerMascota(PacienteMascotaDto mas)
    {
        if (_viendoMascotaNhcl == mas.MasNhcl)
        {
            _viendoMascotaNhcl = null;
            return;
        }
        _editandoMascotaNhcl = null;
        _viendoMascotaNhcl = mas.MasNhcl;
    }

    private async Task EditarClienteAsync(ClienteDto cli)
    {
        if (_editandoClienteId == cli.PaCodigo)
        {
            _editandoClienteId = null;
            return;
        }
        _editandoMascotaNhcl = null;
        _viendoClienteId = null;
        if (_clienteExpandido != cli.PaCodigo)
        {
            _clienteExpandido = cli.PaCodigo;
            await CargarPacientesClienteAsync(cli.PaCodigo);
        }
        _flujoRegistroCompleto = false;
        CargarClienteEnFormulario(cli);
        _editandoClienteId = cli.PaCodigo;
    }

    private void CancelarEdicionCliente()
    {
        _flujoRegistroCompleto = false;
        _editandoClienteId = null;
