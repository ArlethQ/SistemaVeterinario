@page "/consulta/autorizaciones"
@page "/consulta/autorizaciones/{IdOrden:int}/{Nhcl:int}"
@inject IConsultaExternaService ConsultaService
@inject IKardexService KardexService
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject IJSRuntime JS
@inject IWebHostEnvironment Environment

<PageTitle>e-ForVets - Autorizaciones, Consentimientos y Plan de Alta</PageTitle>

<div class="container-fluid py-3">
    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm border-start border-4 border-warning">
        <div>
            <h4 class="mb-0 text-primary fw-bold">
                <i class="bi bi-file-earmark-check-fill me-2"></i>Consentimientos Informados, Autorizaciones y Plan de Alta
            </h4>
            <small class="text-muted">Emisión de consentimientos informados, documentos legales y plan de alta hospitalaria.</small>
        </div>
        <div class="d-flex gap-2 align-items-center mt-2 mt-md-0">
            <select class="form-select form-select-sm" style="width: 280px;" value="@IdOrden" @onchange="SeleccionarOrdenActivaAsync">
                <option value="0">-- Seleccionar paciente / orden --</option>
                @foreach (var orden in OrdenesActivas)
                {
                    <option value="@orden.IdOrdenAtencion">#@orden.IdOrdenAtencion | @orden.Paciente (NHCL @orden.Nhcl)</option>
                }
            </select>
            <div class="input-group input-group-sm" style="width: 260px;">
                <span class="input-group-text bg-light fw-semibold">Orden / NHCL</span>
                <input type="number" class="form-control" placeholder="Orden" @bind="IdOrdenInput" />
                <input type="number" class="form-control" placeholder="NHCL" @bind="NhclInput" />
                <button class="btn btn-primary" @onclick="CargarPorInputAsync">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            <button class="btn btn-sm btn-danger" @onclick="ExportarAltaPdfAsync">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>Descargar Plan de Alta PDF
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(MensajeAlerta))
    {
        <div class="alert @(EsErrorAlerta ? "alert-danger" : "alert-success") alert-dismissible fade show py-2">
            <i class="bi @(EsErrorAlerta ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@MensajeAlerta
            <button type="button" class="btn-close py-2" @onclick="() => MensajeAlerta = null"></button>
        </div>
    }

    @if (CargandoInicial)
    {
        <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="fw-semibold small">Cargando consentimientos informados y plan de alta...</span>
        </div>
    }

    @if (Paciente != null)
    {
        <div class="card shadow-sm border-0 mb-3 bg-warning bg-opacity-10">
            <div class="card-body py-2 px-3 small">
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <strong>Paciente:</strong> @Paciente.PacienteNombre (@Paciente.Especie - @Paciente.Raza)
                        <span class="badge bg-dark ms-1">NHCL #@Paciente.Nhcl</span>
                    </div>
                    <div class="col-md-4">
                        <strong>Propietario:</strong> @Paciente.PropietarioNombre (C.I.: @Paciente.ClienteCedula)
                    </div>
                    <div class="col-md-4 text-md-end">
                        <strong>Orden:</strong> #@IdOrden | <strong>Médico:</strong> @Paciente.MedicoResponsable
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-3">
        <!-- Columna Izquierda: Generador de Consentimientos Informados (vt_formatos -> vt_autorizaciones) -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold text-primary">
                    <i class="bi bi-file-earmark-richtext me-1"></i>1. Generación de Consentimientos y Autorizaciones Legales
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Seleccionar Plantilla Oficial</label>
                            <select class="form-select form-select-sm" @bind="FormatoSeleccionadoId" @bind:after="CargarPlantillaFormatoAsync">
                                <option value="0">-- Seleccione formato institucional --</option>
                                
                                @if (Plantillas.Any(p => p.EsPersonalizada))
                                {
                                    <optgroup label="⭐ Plantillas Personalizadas (Creadas por usuario)">
                                        @foreach (var f in Plantillas.Where(p => p.EsPersonalizada))
                                        {
                                            <option value="@f.FormId">⭐ @f.FormNombre (Personalizada)</option>
                                        }
                                    </optgroup>
                                }

                                <optgroup label="📋 Plantillas Oficiales del Sistema (Predeterminadas)">
                                    @foreach (var f in Plantillas.Where(p => !p.EsPersonalizada))
                                    {
                                        <option value="@f.FormId">📋 @f.FormNombre (@(f.FormTipo == "TUERI" ? "Silvestre" : (f.FormTipo == "HDEV" ? "Doméstico" : f.FormTipo)))</option>
                                    }
                                </optgroup>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-sm btn-outline-primary w-100 fw-semibold" @onclick="CrearNuevaPlantillaAsync" title="Limpiar y crear una nueva plantilla en blanco">
                                <i class="bi bi-file-earmark-plus me-1"></i>Nueva Plantilla
                            </button>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-sm btn-outline-warning text-dark w-100 fw-semibold" @onclick="GuardarPlantillaAsync" title="Guarda los cambios de este documento en la plantilla para que se mantengan en el futuro">
                                <i class="bi bi-bookmark-check-fill text-warning me-1"></i>Guardar Plantilla
                            </button>
                        </div>
                        <div class="col-md-2">
                            @if (FormatoSeleccionadoId > 0 && PlantillaSeleccionada?.EsPersonalizada == true)
                            {
                                <button class="btn btn-sm btn-outline-danger w-100 fw-semibold" @onclick="AbrirModalEliminarPlantilla" title="Eliminar esta plantilla personalizada">
                                    <i class="bi bi-trash3-fill me-1"></i>Eliminar Plantilla
                                </button>
                            }
                            else if (FormatoSeleccionadoId > 0)
                            {
                                <button class="btn btn-sm btn-outline-secondary w-100 fw-semibold" disabled title="Esta es una plantilla oficial predeterminada del sistema y no se puede borrar">
                                    <i class="bi bi-lock-fill me-1"></i>Plantilla Oficial
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary w-100 fw-semibold" disabled>
                                    <i class="bi bi-trash3 me-1"></i>Eliminar
                                </button>
                            }
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-sm btn-primary w-100 fw-semibold" @onclick="GuardarAutorizacionAsync" title="Registra este documento en el historial legal del paciente">
                                <i class="bi bi-floppy-fill me-1"></i>Guardar Doc
                            </button>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Título del Documento</label>
                        <input type="text" id="docTituloInput" class="form-control form-control-sm" @bind="NuevaAutorizacion.Documento" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1 d-block">
                            <i class="bi bi-file-earmark-font text-primary me-1"></i>Contenido del Documento
                            <small class="text-muted fw-normal ms-1">(Escriba y edite directamente en el documento)</small>
                        </label>

                        <!-- Barra de Herramientas de Formato (Word / Docs) -->
                        <div class="d-flex flex-wrap gap-1 p-1 bg-light border border-bottom-0 rounded-top align-items-center">
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('bold')" title="Negrita (Ctrl+B)">
                                <i class="bi bi-type-bold fw-bold"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('italic')" title="Cursiva (Ctrl+I)">
                                <i class="bi bi-type-italic"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('underline')" title="Subrayado (Ctrl+U)">
                                <i class="bi bi-type-underline"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('strikeThrough')" title="Tachado">
                                <i class="bi bi-type-strikethrough"></i>
                            </button>

                            <span class="vr mx-1 my-1"></span>

                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('formatBlock', '<h2>')" title="Título H2">
                                <span class="fw-bold small">H2</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('formatBlock', '<h3>')" title="Subtítulo H3">
                                <span class="fw-bold small">H3</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('formatBlock', '<p>')" title="Párrafo normal">
                                <span class="small">P</span>
                            </button>

                            <span class="vr mx-1 my-1"></span>

                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('justifyLeft')" title="Alinear a la izquierda">
                                <i class="bi bi-text-left"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('justifyCenter')" title="Centrar">
                                <i class="bi bi-text-center"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('justifyRight')" title="Alinear a la derecha">
                                <i class="bi bi-text-right"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('justifyFull')" title="Justificar">
                                <i class="bi bi-justify"></i>
                            </button>

                            <span class="vr mx-1 my-1"></span>

                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('insertUnorderedList')" title="Lista con viñetas">
                                <i class="bi bi-list-ul"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('insertOrderedList')" title="Lista numerada">
                                <i class="bi bi-list-ol"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('insertHorizontalRule')" title="Separador horizontal">
                                <i class="bi bi-hr"></i>
                            </button>

                            <span class="vr mx-1 my-1"></span>

                            <!-- Subir e Insertar Imagen -->
                            <label class="btn btn-sm btn-white border py-0 px-2 shadow-none mb-0 text-primary fw-semibold" style="cursor: pointer;" title="Subir e insertar imagen al documento (Logo, ecografía, firma, etc.)">
                                <i class="bi bi-image-fill me-1"></i>Insertar Imagen
                                <InputFile OnChange="SubirImagenAlDocumentoAsync" accept="image/png,image/jpeg,image/webp,image/gif" style="display: none;" />
                            </label>

                            <span class="vr mx-1 my-1"></span>

                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('undo')" title="Deshacer (Ctrl+Z)">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('redo')" title="Rehacer (Ctrl+Y)">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('removeFormat')" title="Limpiar formato">
                                <i class="bi bi-eraser"></i>
                            </button>

                            <span class="vr mx-1 my-1"></span>

                            <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none text-dark fw-semibold" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.printDocument(document.getElementById('docTituloInput')?.value, window.hosvetEditor.getContent('editorDocVisual'))" title="Imprimir este documento o guardar como PDF">
                                <i class="bi bi-printer-fill text-dark me-1"></i>Imprimir / PDF
                            </button>
                        </div>

                        <!-- Documento con edición visual directa -->
                        <div id="editorDocVisual"
                             contenteditable="true"
                             class="border rounded-bottom p-3 bg-white shadow-sm"
                             style="min-height: 280px; max-height: 420px; overflow-y: auto; outline: none; line-height: 1.5; font-size: 0.92rem;"
                             @onblur="SincronizarDesdeEditorVisualAsync">
                        </div>

                        <style>
                            #editorDocVisual img {
                                cursor: pointer;
                                transition: outline 0.15s ease-in-out;
                            }
                            #editorDocVisual img:hover {
                                outline: 2px dashed #0d6efd;
                            }
                        </style>
                        <small class="text-muted d-block mt-1">
                            <i class="bi bi-info-circle me-1"></i>Haga clic en el texto para editarlo. <strong>Haga clic sobre cualquier imagen</strong> para redimensionarla (arrastrando las esquinas o con los botones rápidos 25%, 50%, 100%, ➖, ➕) o alinearla.
                        </small>
                    </div>


                </div>
            </div>
        </div>

        <!-- Columna Derecha: Plan de Alta Médica e Instrucciones en Domicilio (qvt_formulario_alta) -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-house-heart-fill me-1"></i>2. Plan de Alta Hospitalaria y Cuidados en Casa</span>
                    <button class="btn btn-sm btn-success py-0" @onclick="GuardarFormularioAltaAsync">
                        <i class="bi bi-floppy-fill me-1"></i>Guardar Plan de Alta
                    </button>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-primary">1. Cuidados Generales en Domicilio (Herida, Collar Isabelino, Higiene)</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="AltaForm.CuidadosGenerales"
                                      placeholder="Mantener collar isabelino permanente, limpieza de herida quirúrgica, ambiente cálido y tranquilo..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-success">2. Actividades Permitidas</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="AltaForm.Permitido"
                                      placeholder="Caminatas cortas con correa para necesidades fisiológicas..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-danger">3. Actividades Restringidas / No Permitidas</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="AltaForm.NoPermitido"
                                      placeholder="No correr, no saltar, no subir escaleras, no bañar hasta retiro de puntos..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-primary">4. Manejo Nutricional y Dieta</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="AltaForm.Dieta"
                                      placeholder="Dieta blanda gastrointestinal fraccionada en 3-4 tomas diarias, agua fresca a libre disposición..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-primary">5. Esquema de Medicación y Próximo Control</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="AltaForm.Medicacion"
                                      placeholder="Resumen de analgésicos/antibióticos en casa y fecha de control o retiro de puntos..."></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fila Completa Horizontal: Historial de Autorizaciones y Documentos Firmados (Abarca todo el ancho) -->
        <div class="col-12 mt-2">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center py-2">
                    <span>
                        <i class="bi bi-clock-history me-1"></i>3. Historial de Autorizaciones y Documentos Firmados del Paciente (@AutorizacionesEmitidas.Count)
                    </span>
                    <span class="badge bg-primary-subtle text-primary border fw-normal">
                        Expediente Legal del Paciente | C.I.: @(Paciente?.ClienteCedula ?? "-")
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th style="width: 70px;" class="ps-3">ID</th>
                                    <th style="width: 140px;">Fecha y Hora</th>
                                    <th>Documento / Consentimiento</th>
                                    <th style="width: 170px;">Médico Emisor</th>
                                    <th style="width: 120px;">Orden / Tipo</th>
                                    <th style="min-width: 310px;">Documento Firmado por Propietario (Físico/Escaneo)</th>
                                    <th style="width: 210px;" class="text-end pe-3">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!AutorizacionesEmitidas.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            <i class="bi bi-folder2-open display-6 d-block mb-1 text-secondary opacity-50"></i>
                                            No se han emitido autorizaciones ni consentimientos para este paciente todavía.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var a in AutorizacionesEmitidas)
                                    {
                                        <tr>
                                            <td class="fw-bold text-secondary ps-3">#@a.AutorizacionId</td>
                                            <td>
                                                <i class="bi bi-calendar-event me-1 text-muted"></i>@a.Fecha.ToString("yyyy-MM-dd HH:mm")
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark">
                                                    <i class="bi bi-file-earmark-medical text-primary me-1"></i>@a.Documento
                                                </div>
                                            </td>
                                            <td>
                                                <i class="bi bi-person-badge me-1 text-muted"></i>@a.NombreMedico
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">
                                                    Ord #@a.Orden
                                                </span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(a.ArchivoUrl))
                                                {
                                                    <div class="d-flex align-items-center gap-1">
                                                        <a href="@a.ArchivoUrl" target="_blank" class="btn btn-xs btn-outline-success py-1 px-2 d-inline-flex align-items-center text-truncate shadow-sm" style="max-width: 240px;" title="Ver o descargar archivo firmado (@a.ArchivoNombre)">
                                                            @if (a.ArchivoNombre?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true)
                                                            {
                                                                <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i>
                                                            }
                                                            else if (a.ArchivoNombre?.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) == true || a.ArchivoNombre?.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) == true)
                                                            {
                                                                <i class="bi bi-file-earmark-word-fill text-primary me-1"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-file-earmark-image-fill text-success me-1"></i>
                                                            }
                                                            <span class="text-truncate">@(string.IsNullOrEmpty(a.ArchivoNombre) ? "Ver Firmado" : a.ArchivoNombre)</span>
                                                        </a>
                                                        <label class="btn btn-xs btn-outline-secondary py-1 px-2 mb-0" style="cursor: pointer;" title="Reemplazar archivo firmado">
                                                            <i class="bi bi-arrow-repeat"></i>
                                                            <InputFile OnChange="@(e => SubirArchivoFirmadoAsync(e, a))" accept="image/*,application/pdf,.doc,.docx" style="display: none;" />
                                                        </label>
                                                        <button class="btn btn-xs btn-outline-danger py-1 px-2" @onclick="() => EliminarArchivoFirmadoAsync(a)" title="Eliminar archivo firmado adjunto">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <label class="btn btn-xs btn-outline-secondary py-1 px-2 mb-0 d-inline-flex align-items-center fw-semibold text-dark shadow-sm" style="cursor: pointer;" title="Subir foto, escaneo PDF o Word con la firma del cliente">
                                                        <i class="bi bi-cloud-arrow-up-fill text-primary me-1"></i>Subir Firmado (PDF, Foto, DOCX)
                                                        <InputFile OnChange="@(e => SubirArchivoFirmadoAsync(e, a))" accept="image/*,application/pdf,.doc,.docx" style="display: none;" />
                                                    </label>
                                                }
                                            </td>
                                            <td class="text-end pe-3">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-xs btn-outline-primary py-1 px-2" @onclick="() => CargarAutorizacionExistenteAsync(a)" title="Cargar y ver en el editor de arriba">
                                                        <i class="bi bi-pencil-square me-1"></i>Ver en Editor
                                                    </button>
                                                    <button class="btn btn-xs btn-outline-dark py-1 px-2" @onclick="() => ImprimirDocumentoAsync(a)" title="Imprimir o guardar directamente en PDF">
                                                        <i class="bi bi-printer-fill me-1"></i>Imprimir / PDF
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmación para Eliminar Plantilla -->
@if (MostrarModalEliminarPlantilla)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-danger text-white py-2">
                    <h5 class="modal-title fs-6 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación de Plantilla
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalEliminarPlantilla"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="mb-2">¿Está seguro de que desea eliminar la plantilla personalizada?</p>
                    <div class="alert alert-warning py-2 mb-2 small">
                        <strong><i class="bi bi-file-earmark-text me-1"></i>@(PlantillaSeleccionada?.FormNombre ?? "Plantilla")</strong>
                    </div>
                    <small class="text-muted d-block">
                        <i class="bi bi-info-circle me-1"></i>Esta acción eliminará la plantilla permanentemente del selector. Los documentos guardados previamente en el historial de los pacientes no se verán afectados.
                    </small>
                </div>
                <div class="modal-footer py-2 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CerrarModalEliminarPlantilla" disabled="@EliminandoPlantilla">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-sm btn-danger fw-semibold" @onclick="ConfirmarEliminarPlantillaAsync" disabled="@EliminandoPlantilla">
                        @(EliminandoPlantilla ? "Eliminando..." : "Sí, Eliminar Plantilla")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }

    private int IdOrdenInput { get; set; }
    private int NhclInput { get; set; }
    private int FormatoSeleccionadoId { get; set; }
    private FormatoPlantillaDto? PlantillaSeleccionada => Plantillas.FirstOrDefault(p => p.FormId == FormatoSeleccionadoId);
    private bool MostrarModalEliminarPlantilla { get; set; }
    private bool EliminandoPlantilla { get; set; }
    private bool CargandoInicial { get; set; } = true;
    private string? MensajeAlerta { get; set; }
    private bool EsErrorAlerta { get; set; }

    private PacienteHeaderDto? Paciente { get; set; }
    private List<OrdenActivaResumenDto> OrdenesActivas { get; set; } = new();
    private List<FormatoPlantillaDto> Plantillas { get; set; } = new();
    private List<AutorizacionClinicaDto> AutorizacionesEmitidas { get; set; } = new();
    private AutorizacionClinicaDto NuevaAutorizacion { get; set; } = new();
    private FormularioAltaMedicaDto AltaForm { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        CargandoInicial = true;
        await Task.Yield();

        var tPlantillas = ConsultaService.ObtenerPlantillasFormatosAsync();
        var tOrdenes = KardexService.ObtenerOrdenesActivasAsync();
        await Task.WhenAll(tPlantillas, tOrdenes);
        Plantillas = await tPlantillas;
        OrdenesActivas = await tOrdenes;

        if (IdOrden <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
        {
            IdOrden = Session.OrdenActiva.Value;
            Nhcl = Session.NhclActivo ?? 0;
        }
        else if (IdOrden <= 0 && Nhcl <= 0)
        {
            if (OrdenesActivas.Count > 0)
            {
                IdOrden = OrdenesActivas[0].IdOrdenAtencion;
                Nhcl = OrdenesActivas[0].Nhcl;
            }
        }

        if (IdOrden > 0 || Nhcl > 0)
        {
            IdOrdenInput = IdOrden;
            NhclInput = Nhcl;
            await CargarDatosAsync();
        }
        CargandoInicial = false;
    }

    private async Task CargarPorInputAsync()
    {
        try
        {
            IdOrden = IdOrdenInput;
            Nhcl = NhclInput;
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al buscar por Orden/NHCL: {ex.Message}";
            EsErrorAlerta = true;
        }
    }

    private async Task SeleccionarOrdenActivaAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var idOrden) || idOrden <= 0)
            return;

        var orden = OrdenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == idOrden);
        if (orden == null)
            return;

        CargandoInicial = true;
        IdOrden = orden.IdOrdenAtencion;
        Nhcl = orden.Nhcl;
        IdOrdenInput = IdOrden;
        NhclInput = Nhcl;
        try
        {
            await CargarDatosAsync();
            MensajeAlerta = $"Paciente {orden.Paciente} cargado correctamente.";
        }
        finally
        {
            CargandoInicial = false;
        }
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            if (IdOrden > 0)
            {
                Paciente = await KardexService.ObtenerEncabezadoPacienteAsync(IdOrden, Nhcl);
                if (Paciente != null && Nhcl <= 0)
                {
                    Nhcl = Paciente.Nhcl;
                    NhclInput = Nhcl;
                }
                Session.SeleccionarOrden(IdOrden, Nhcl, Paciente?.PacienteNombre);
            }

            if (Nhcl > 0)
            {
                var tAut = ConsultaService.ObtenerAutorizacionesPacienteAsync(Nhcl);
                var tAlta = ConsultaService.ObtenerFormularioAltaAsync(IdOrden, Nhcl);
                await Task.WhenAll(tAut, tAlta);
                AutorizacionesEmitidas = await tAut;
                AltaForm = await tAlta;
                await CargarPlantillaFormatoAsync();
            }
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al cargar datos del paciente: {ex.Message}";
            EsErrorAlerta = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(50);
            if (!string.IsNullOrEmpty(NuevaAutorizacion.DetalleHtml))
            {
                await JS.InvokeVoidAsync("hosvetEditor.setContent", "editorDocVisual", NuevaAutorizacion.DetalleHtml);
            }
            else
            {
                await JS.InvokeVoidAsync("hosvetEditor.initImageResizer", "editorDocVisual");
            }
        }
    }

    private async Task CrearNuevaPlantillaAsync()
    {
        FormatoSeleccionadoId = 0;
        NuevaAutorizacion.AutorizacionId = 0;
        NuevaAutorizacion.Documento = "Nueva Plantilla Personalizada";
        NuevaAutorizacion.Tipo = "PERSONALIZADO";
        NuevaAutorizacion.DetalleHtml = "<p><br></p>";

        StateHasChanged();
        await Task.Delay(40);
        await JS.InvokeVoidAsync("hosvetEditor.setContent", "editorDocVisual", "<p><br></p>");
        MensajeAlerta = "Plantilla en blanco preparada. Escriba el título del documento, redacte el contenido o inserte imágenes y haga clic en 'Guardar Plantilla'.";
        EsErrorAlerta = false;
    }

    private async Task CargarPlantillaFormatoAsync()
    {
        try
        {
            var plantilla = Plantillas.FirstOrDefault(p => p.FormId == FormatoSeleccionadoId);
            if (plantilla != null)
            {
                NuevaAutorizacion.AutorizacionId = 0;
                NuevaAutorizacion.Documento = plantilla.FormNombre;
                NuevaAutorizacion.Tipo = string.IsNullOrWhiteSpace(plantilla.FormTipo) ? "HDEV" : plantilla.FormTipo;
            }
            if (FormatoSeleccionadoId > 0 && Nhcl > 0)
            {
                NuevaAutorizacion.DetalleHtml = await ConsultaService.ProcesarPlantillaConDatosPacienteAsync(FormatoSeleccionadoId, Nhcl);
            }
            else if (FormatoSeleccionadoId > 0 && plantilla != null)
            {
                NuevaAutorizacion.DetalleHtml = plantilla.FormArchivoHtml;
            }

            StateHasChanged();
            await Task.Delay(40);
            await JS.InvokeVoidAsync("hosvetEditor.setContent", "editorDocVisual", NuevaAutorizacion.DetalleHtml);
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al cargar la plantilla: {ex.Message}";
            EsErrorAlerta = true;
        }
    }

    private async Task CargarAutorizacionExistenteAsync(AutorizacionClinicaDto item)
    {
        NuevaAutorizacion = new AutorizacionClinicaDto
        {
            AutorizacionId = item.AutorizacionId,
            Nhcl = item.Nhcl,
            Orden = item.Orden,
            Documento = item.Documento,
            Tipo = item.Tipo,
            DetalleHtml = item.DetalleHtml
        };
        StateHasChanged();
        await Task.Delay(40);
        await JS.InvokeVoidAsync("hosvetEditor.setContent", "editorDocVisual", NuevaAutorizacion.DetalleHtml);
    }

    private async Task SubirImagenAlDocumentoAsync(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            if (file.Size > 15 * 1024 * 1024)
            {
                MensajeAlerta = "La imagen seleccionada supera el límite permitido de 15MB.";
                EsErrorAlerta = true;
                return;
            }

            string uploadsFolder = Path.Combine(Environment.WebRootPath, "imagenes", "documentos");
            if (!Directory.Exists(uploadsFolder))
            {
                Directory.CreateDirectory(uploadsFolder);
            }

            string ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (string.IsNullOrWhiteSpace(ext)) ext = ".png";
            string fileName = $"{DateTime.Now:yyyyMMddHHmmss}_{Guid.NewGuid().ToString("N")[..6]}{ext}";
            string filePath = Path.Combine(uploadsFolder, fileName);

            await using (var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024))
            await using (var fs = new FileStream(filePath, FileMode.Create))
            {
                await stream.CopyToAsync(fs);
            }

            string imgUrl = $"/imagenes/documentos/{fileName}";
            await JS.InvokeVoidAsync("hosvetEditor.insertImage", "editorDocVisual", imgUrl);
            await SincronizarDesdeEditorVisualAsync();

            MensajeAlerta = "Imagen subida e insertada exitosamente en el documento.";
            EsErrorAlerta = false;
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al subir imagen al documento: {ex.Message}";
            EsErrorAlerta = true;
        }
    }

    private async Task GuardarAutorizacionAsync()
    {
        try
        {
            if (Nhcl <= 0)
            {
                MensajeAlerta = "Debe seleccionar un paciente antes de registrar un documento.";
                EsErrorAlerta = true;
                return;
            }

            var html = await JS.InvokeAsync<string>("hosvetEditor.getContent", "editorDocVisual");
            if (html != null)
            {
                NuevaAutorizacion.DetalleHtml = html;
            }

            if (string.IsNullOrWhiteSpace(NuevaAutorizacion.DetalleHtml))
            {
                MensajeAlerta = "El contenido del documento no puede estar vacío.";
                EsErrorAlerta = true;
                return;
            }

            NuevaAutorizacion.Nhcl = Nhcl;
            NuevaAutorizacion.Orden = IdOrden;
            NuevaAutorizacion.Cliente = Paciente?.ClienteCodigo ?? 0;
            NuevaAutorizacion.IdUser = Session.CurrentUser?.UserNumero ?? 1;

            await ConsultaService.GuardarAutorizacionAsync(NuevaAutorizacion);
            AutorizacionesEmitidas = await ConsultaService.ObtenerAutorizacionesPacienteAsync(Nhcl);
            MensajeAlerta = $"Documento '{NuevaAutorizacion.Documento}' registrado exitosamente en el historial del paciente.";
            EsErrorAlerta = false;
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al registrar el documento: {ex.Message}";
            EsErrorAlerta = true;
        }
    }

    private async Task GuardarPlantillaAsync()
    {
        try
        {
            var html = await JS.InvokeAsync<string>("hosvetEditor.getContent", "editorDocVisual");
            if (html != null)
            {
                NuevaAutorizacion.DetalleHtml = html;
            }

            if (string.IsNullOrWhiteSpace(NuevaAutorizacion.DetalleHtml))
            {
                MensajeAlerta = "El contenido de la plantilla no puede estar vacío.";
                EsErrorAlerta = true;
                return;
            }

            string nombrePlantilla = string.IsNullOrWhiteSpace(NuevaAutorizacion.Documento)
                ? (Plantillas.FirstOrDefault(p => p.FormId == FormatoSeleccionadoId)?.FormNombre ?? "Plantilla Institucional")
                : NuevaAutorizacion.Documento.Trim();

            var ok = await ConsultaService.GuardarPlantillaFormatoAsync(
                FormatoSeleccionadoId,
                nombrePlantilla,
                NuevaAutorizacion.DetalleHtml);

            if (ok)
            {
                Plantillas = await ConsultaService.ObtenerPlantillasFormatosAsync();
                var guardada = Plantillas.FirstOrDefault(p => p.FormNombre.Equals(nombrePlantilla, StringComparison.OrdinalIgnoreCase))
                               ?? Plantillas.LastOrDefault(p => p.EsPersonalizada);
                if (guardada != null)
                {
                    FormatoSeleccionadoId = guardada.FormId;
                }

                MensajeAlerta = $"Plantilla oficial '{nombrePlantilla}' guardada exitosamente. Los próximos documentos generados mantendrán este nuevo formato e imágenes.";
                EsErrorAlerta = false;
            }
            else
            {
                MensajeAlerta = "No se pudo guardar la plantilla en el sistema.";
                EsErrorAlerta = true;
            }
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al guardar la plantilla: {ex.Message}";
            EsErrorAlerta = true;
        }
    }

    private async Task SincronizarDesdeEditorVisualAsync()
    {
        var html = await JS.InvokeAsync<string>("hosvetEditor.getContent", "editorDocVisual");
        if (html != null)
        {
            NuevaAutorizacion.DetalleHtml = html;
        }
    }

    private void AbrirModalEliminarPlantilla()
    {
        if (PlantillaSeleccionada == null || !PlantillaSeleccionada.EsPersonalizada)
        {
            MensajeAlerta = "Solo se pueden eliminar plantillas personalizadas. Las plantillas del sistema están protegidas.";
            EsErrorAlerta = true;
            return;
        }
        MostrarModalEliminarPlantilla = true;
    }

    private void CerrarModalEliminarPlantilla()
    {
        MostrarModalEliminarPlantilla = false;
    }

    private async Task ConfirmarEliminarPlantillaAsync()
    {
        if (FormatoSeleccionadoId <= 0 || PlantillaSeleccionada == null)
        {
            CerrarModalEliminarPlantilla();
            return;
        }

        try
        {
            EliminandoPlantilla = true;
            string nombreEliminado = PlantillaSeleccionada.FormNombre;
            var res = await ConsultaService.EliminarPlantillaFormatoAsync(FormatoSeleccionadoId);

            if (res.Ok)
            {
                Plantillas = await ConsultaService.ObtenerPlantillasFormatosAsync();
                FormatoSeleccionadoId = 0;
                NuevaAutorizacion.Documento = string.Empty;
                NuevaAutorizacion.DetalleHtml = string.Empty;
                await JS.InvokeVoidAsync("hosvetEditor.setContent", "editorDocVisual", "");

                MensajeAlerta = $"Plantilla personalizada '{nombreEliminado}' eliminada exitosamente.";
                EsErrorAlerta = false;
            }
            else
            {
                MensajeAlerta = res.Mensaje ?? "No se pudo eliminar la plantilla.";
                EsErrorAlerta = true;
            }
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al eliminar la plantilla: {ex.Message}";
            EsErrorAlerta = true;
        }
        finally
        {
            EliminandoPlantilla = false;
            CerrarModalEliminarPlantilla();
        }
    }

    private async Task GuardarFormularioAltaAsync()
    {
        try
        {
            if (IdOrden <= 0 && Nhcl <= 0)
            {
                MensajeAlerta = "Debe seleccionar un paciente/orden antes de guardar el plan de alta.";
                EsErrorAlerta = true;
                return;
            }

            AltaForm.IdOrden = IdOrden;
            AltaForm.Nhcl = Nhcl;
            int idUser = Session.CurrentUser?.UserNumero ?? 1;
            await ConsultaService.GuardarFormularioAltaAsync(AltaForm, idUser);
            MensajeAlerta = "Plan de Alta Hospitalaria guardado correctamente.";
            EsErrorAlerta = false;
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al guardar el plan de alta: {ex.Message}";
            EsErrorAlerta = true;
        }
    }

    private async Task ExportarAltaPdfAsync()
    {
        try
        {
            var pac = Paciente;
            if (pac is null || pac.Nhcl <= 0)
            {
                MensajeAlerta = "No se pudo generar el PDF: faltan los datos reales del paciente.";
                EsErrorAlerta = true;
                return;
            }
            var pdfBytes = ReportService.GenerarAltaMedicaPdf(pac, AltaForm);
            await JS.InvokeVoidAsync("descargarArchivoBase64", $"PlanAlta_Orden_{IdOrden}.pdf", "application/pdf", Convert.ToBase64String(pdfBytes));
            MensajeAlerta = "Plan de Alta descargado correctamente en formato PDF.";
            EsErrorAlerta = false;
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al generar el PDF de alta: {ex.Message}";
            EsErrorAlerta = true;
        }
    }

    private async Task ImprimirDocumentoAsync(AutorizacionClinicaDto item)
    {
        try
        {
            string titulo = string.IsNullOrWhiteSpace(item.Documento) ? "Documento Clínico" : item.Documento;
            string html = item.DetalleHtml;
            if (string.IsNullOrWhiteSpace(html))
            {
                MensajeAlerta = "El documento seleccionado no contiene texto para imprimir.";
                EsErrorAlerta = true;
                return;
            }
            await JS.InvokeVoidAsync("hosvetEditor.printDocument", titulo, html);
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al enviar a impresión: {ex.Message}";
            EsErrorAlerta = true;
        }
    }

    private async Task SubirArchivoFirmadoAsync(InputFileChangeEventArgs e, AutorizacionClinicaDto item)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            if (file.Size > 25 * 1024 * 1024)
            {
                MensajeAlerta = "El archivo firmado no puede superar los 25MB.";
                EsErrorAlerta = true;
                return;
            }

            string uploadsFolder = Path.Combine(Environment.WebRootPath, "archivosPacientes", item.Nhcl.ToString(), "autorizaciones");
            if (!Directory.Exists(uploadsFolder))
            {
                Directory.CreateDirectory(uploadsFolder);
            }

            string ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (string.IsNullOrWhiteSpace(ext)) ext = ".pdf";
            string safeDoc = System.Text.RegularExpressions.Regex.Replace(item.Documento, @"[^a-zA-Z0-9_\-]", "_");
            string fileName = $"Firmado_{item.AutorizacionId}_{safeDoc}_{DateTime.Now:yyyyMMddHHmmss}{ext}";
            string filePath = Path.Combine(uploadsFolder, fileName);

            await using (var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024))
            await using (var fs = new FileStream(filePath, FileMode.Create))
            {
                await stream.CopyToAsync(fs);
            }

            string fileUrl = $"/archivosPacientes/{item.Nhcl}/autorizaciones/{fileName}";
            var ok = await ConsultaService.ActualizarArchivoAutorizacionAsync(item.AutorizacionId, fileUrl, file.Name);
            if (ok)
            {
                item.ArchivoUrl = fileUrl;
                item.ArchivoNombre = file.Name;
                MensajeAlerta = $"Documento firmado '{file.Name}' subido y vinculado exitosamente a la autorización #{item.AutorizacionId}.";
                EsErrorAlerta = false;
            }
            else
            {
                MensajeAlerta = "No se pudo actualizar el registro del archivo en la base de datos.";
                EsErrorAlerta = true;
            }
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al subir archivo firmado: {ex.Message}";
            EsErrorAlerta = true;
        }
    }

    private async Task EliminarArchivoFirmadoAsync(AutorizacionClinicaDto item)
    {
        try
        {
            if (!string.IsNullOrEmpty(item.ArchivoUrl))
            {
                string rel = item.ArchivoUrl.TrimStart('/').Replace('/', Path.DirectorySeparatorChar);
                string physicalPath = Path.Combine(Environment.WebRootPath, rel);
                if (File.Exists(physicalPath))
                {
                    File.Delete(physicalPath);
                }
            }

            var ok = await ConsultaService.ActualizarArchivoAutorizacionAsync(item.AutorizacionId, null, null);
            if (ok)
            {
                item.ArchivoUrl = null;
                item.ArchivoNombre = null;
                MensajeAlerta = $"Archivo firmado de la autorización #{item.AutorizacionId} eliminado correctamente.";
                EsErrorAlerta = false;
            }
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Error al eliminar archivo firmado: {ex.Message}";
            EsErrorAlerta = true;
        }
    }
}
