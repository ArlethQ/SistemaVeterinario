@page "/kardex/ordenes"
@inject IHospitalizacionService HospService
@inject IGestionMigradaService GestionService
@inject IConsultaExternaService ConsultaService
@inject IKardexService KardexService
@inject SessionStateService Session
@inject IWebHostEnvironment Env
@inject SessionControlService SessionControl
@inject IJSRuntime JS

<PageTitle>e-ForVets - Bandeja de Órdenes de Hospitalización</PageTitle>

<div class="container-fluid py-3 hosp-bandeja-page">
    <header class="bandeja-hero">
            <div class="d-flex align-items-center gap-3">
                <span class="bandeja-hero-icon" aria-hidden="true"><i class="bi bi-hospital"></i></span>
                <div>
                    <h1 class="h5 mb-1 fw-bold">Bandeja de Órdenes — Hospitalización 24h</h1>
                    <small>Pacientes derivados desde SOAP para hospitalización. Inicia su ingreso, asigna ubicación e indicaciones.</small>
                </div>
            </div>
            <nav class="bandeja-nav d-flex flex-wrap gap-2" aria-label="Navegación de hospitalización">
                <a class="btn btn-sm btn-outline-secondary" href="/dashboard"><i class="bi bi-house-door-fill me-1"></i>Panel Principal</a>
                @if (Permisos.Permite("/hospitalizacion/ficha"))
                {
                    <a class="btn btn-sm btn-outline-primary" href="/hospitalizacion/ficha"><i class="bi bi-file-earmark-text me-1"></i>Ficha 24h</a>
                }
            </nav>
    </header>

    <ul class="bandeja-estados" aria-label="Resumen de órdenes">
        <li class="bandeja-estado pendientes"><i class="bi bi-clock" aria-hidden="true"></i><span>Pendientes <small>(cola de ingreso)</small></span><strong>@(PendientesIngreso.Count() - IngresosEnProceso)</strong></li>
        <li class="bandeja-estado proceso"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span>En proceso <small>(ingresando)</small></span><strong>@IngresosEnProceso</strong></li>
        <li class="bandeja-estado hospital"><i class="bi bi-hospital" aria-hidden="true"></i><span>Hospitalizados</span><strong>@Hospitalizados.Count(x => x.RequiereHospitalizacion)</strong></li>
        <li class="bandeja-estado cirugia"><i class="bi bi-scissors" aria-hidden="true"></i><span>Cirugía</span><strong>@Hospitalizados.Count(x => x.RequiereCirugia)</strong></li>
    </ul>

    <section class="card bandeja-lista" aria-label="Cola de ingreso">
        <div class="card-header bandeja-lista-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <h2 class="h6 mb-0 fw-bold"><i class="bi bi-people-fill me-2" aria-hidden="true"></i>Cola de ingreso (Pendientes)</h2>
                <span class="badge text-bg-warning">@PendientesIngreso.Count()</span>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="input-group input-group-sm bandeja-busqueda">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input class="form-control" autocomplete="off" aria-label="Buscar paciente, tutor, orden o NHCL" @bind="_filtro" @bind:event="oninput" @bind:after="BuscarMientrasEscribeAsync" placeholder="Buscar paciente, tutor, orden o NHCL…" />
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CargarColaAsync" disabled="@_cargando">
                    <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            @if (_cargando)
            {
                <div class="p-3 text-muted small d-flex align-items-center gap-2" role="status">
                    <span class="spinner-border spinner-border-sm"></span> Cargando órdenes derivadas a hospitalización...
                </div>
            }
            else if (!PendientesIngreso.Any())
            {
                <div class="p-3 text-center text-muted small">
                    No hay pacientes pendientes de ingreso desde SOAP en este momento.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Fecha / Hora</th>
                                <th scope="col">Orden</th>
                                <th scope="col">Paciente</th>
                                <th scope="col">Especie</th>
                                <th scope="col">Tutor</th>
                                <th scope="col">Médico / Especialidad</th>
                                <th scope="col">Tipo</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PendientesIngreso)
                            {
                                var seleccionado = _ordenSeleccionada?.OrdenAtencionId == item.OrdenAtencionId;
                                <tr class="@(seleccionado ? "table-primary" : null)">
                                    <td class="small text-nowrap">
                                        <i class="bi bi-calendar3 bandeja-dato-icon" aria-hidden="true"></i><strong>@item.FechaOrden.ToString("dd/MM/yyyy")</strong><br />
                                        <span class="text-muted">@item.FechaOrden.ToString("HH:mm")</span>
                                    </td>
                                    <td class="fw-semibold text-primary">#@item.OrdenAtencionId</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="hosp-avatar">
                                                @if (!string.IsNullOrEmpty(ObtenerFotoPaciente(item.Nhcl)))
                                                {
                                                    <img src="@ObtenerFotoPaciente(item.Nhcl)" alt="Foto de @item.Paciente" />
                                                }
                                                else
                                                {
                                                    <b>@InicialPaciente(item.Paciente)</b>
                                                }
                                            </span>
                                            <div>
                                                <div class="fw-semibold">@item.Paciente</div>
                                                <small class="text-muted">NHCL #@item.Nhcl · @item.Sexo</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="small text-nowrap"><i class="bi bi-grid-fill bandeja-dato-icon" aria-hidden="true"></i>@item.Especie</td>
                                    <td class="small"><i class="bi bi-person bandeja-dato-icon" aria-hidden="true"></i>@item.Cliente</td>
                                    <td class="small">
                                        <div><i class="bi bi-person-badge bandeja-dato-icon" aria-hidden="true"></i>@item.Medico</div>
                                        <span class="text-muted">@item.Especialidad</span>
                                    </td>
                                    <td class="small">
                                        <span class="badge @ClaseTipoAtencion(item)">@item.TipoAtencionTexto</span>
                                    </td>
                                    <td>
                                        <span class="badge bandeja-alerta">Pendiente de ingreso</span>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm bandeja-iniciar" @onclick="() => SeleccionarParaIngresoAsync(item)">
                                            Iniciar ingreso <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    @if (_ordenSeleccionada is null && !string.IsNullOrWhiteSpace(_mensajeAlerta))
    {
        <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small shadow-sm" role="alert">
            <i class="bi @(_esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@_mensajeAlerta
            <button type="button" class="btn-close py-2" @onclick="() => _mensajeAlerta = null"></button>
        </div>
    }

    <section class="card bandeja-lista bandeja-lista-ingresados" aria-label="Pacientes en hospitalización o cirugía">
        <div class="card-header bandeja-lista-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <h2 class="h6 mb-0 fw-bold text-success"><i class="bi bi-hospital-fill me-1"></i>Pacientes en Hospitalización / Cirugía</h2>
                <span class="badge text-bg-success">@Hospitalizados.Count()</span>
            </div>
            <small class="text-muted">Expediente integrado con pestañas bloqueadas según indicación de SOAP</small>
        </div>

        <div class="card-body p-0">
            @if (!Hospitalizados.Any())
            {
                <div class="p-4 text-center text-muted small">
                    Aún no hay pacientes en hospitalización o cirugía.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Paciente</th>
                                <th scope="col">Orden</th>
                                <th scope="col">NHCL</th>
                                <th scope="col">Propietario</th>
                                <th scope="col">Médico / Especialidad</th>
                                <th scope="col">Modalidad</th>
                                <th scope="col">Jaula</th>
                                <th scope="col">Fecha</th>
                                <th scope="col" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Hospitalizados)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="hosp-avatar">
                                                @if (!string.IsNullOrEmpty(ObtenerFotoPaciente(item.Nhcl)))
                                                {
                                                    <img src="@ObtenerFotoPaciente(item.Nhcl)" alt="Foto de @item.Paciente" />
                                                }
                                                else
                                                {
                                                    <b>@InicialPaciente(item.Paciente)</b>
                                                }
                                            </span>
                                            <div>
                                                <div class="fw-semibold">@item.Paciente</div>
                                                <small class="text-muted">@item.Especie · @item.Sexo</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="fw-bold text-primary">#@item.OrdenAtencionId</span></td>
                                    <td class="small">@item.Nhcl</td>
                                    <td class="small"><i class="bi bi-person bandeja-dato-icon" aria-hidden="true"></i>@item.Cliente</td>
                                    <td class="small">
                                        <div><i class="bi bi-person-badge bandeja-dato-icon" aria-hidden="true"></i>@item.Medico</div>
                                        <span class="text-muted">@item.Especialidad</span>
                                    </td>
                                    <td class="small">
                                        <span class="badge @ClaseTipoAtencion(item)">
                                            @item.TipoAtencionTexto
                                        </span>
                                    </td>
                                    <td class="small">
                                        @if (!item.RequiereHospitalizacion)
                                        {
                                            <span class="text-muted">Ambulatorio</span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(item.JaulaCodigo))
                                        {
                                            <span class="badge bandeja-jaula">@item.JaulaCodigo</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="small text-nowrap">
                                        <i class="bi bi-calendar3 bandeja-dato-icon" aria-hidden="true"></i>@item.FechaOrden.ToString("dd/MM/yyyy")<br />
                                        <span class="text-muted">@item.FechaOrden.ToString("HH:mm")</span>
                                    </td>
                                    <td class="text-center orders-actions-cell">
                                        <div class="bandeja-acciones">
                                            <button type="button" class="btn btn-sm btn-purple fw-semibold" @onclick="() => AbrirModalModulosAsync(item)">
                                                <i class="bi bi-window-stack me-1"></i>Expediente / Módulos
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SeleccionarParaIngresoAsync(item)" aria-label="@($"Editar ingreso de {item.Paciente}")" title="Editar ingreso">
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>

@if (_ordenSeleccionada is { } ordenIngreso)
{
    <dialog class="bandeja-dialog" @ref="_dialogIngreso" aria-labelledby="bandejaIngresoTitulo">
        <header class="bandeja-dialog-header">
            <span class="bandeja-hero-icon" aria-hidden="true"><i class="bi bi-hospital"></i></span>
            <div class="flex-grow-1">
                <h2 class="h5 fw-bold mb-1" id="bandejaIngresoTitulo">@(ordenIngreso.YaIngresado ? "Editar ingreso" : "Iniciar ingreso")</h2>
                <div class="small">@ordenIngreso.Paciente · Orden #@ordenIngreso.OrdenAtencionId · NHCL #@ordenIngreso.Nhcl</div>
            </div>
            <button type="button" class="btn-close" autofocus aria-label="Cerrar" disabled="@IngresoOcupado" @onclick="CancelarIngresoAsync"></button>
        </header>
        <div class="ingreso-contexto">
            <span class="badge @ClaseTipoAtencion(ordenIngreso)">@ordenIngreso.TipoAtencionTexto</span>
            <span><i class="bi bi-person me-1" aria-hidden="true"></i>@ordenIngreso.Cliente</span>
            <span><i class="bi bi-person-badge me-1" aria-hidden="true"></i>@ordenIngreso.Medico · @ordenIngreso.Especialidad</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(_mensajeAlerta))
        {
            <div class="alert @(_esError ? "alert-danger" : "alert-success") mx-3 my-2 py-2 small" role="alert">@_mensajeAlerta</div>
        }
        @if (_cargandoIngreso)
        {
            <div class="p-4 d-flex align-items-center gap-2 text-primary" role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Cargando ficha de ingreso...
            </div>
        }
        else if (!_falloCargaIngreso)
        {
            <div class="ingreso-form">
                <div class="ingreso-scroll">
                    <div class="row g-3">
                        @if (_ordenSeleccionada.RequiereHospitalizacion)
                        {
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="selJaula">Ubicación / Jaula <span class="text-danger">*</span></label>
                                <select id="selJaula" class="form-select form-select-sm" @bind="_ingreso.IdJaula">
                                    <option value="">-- Seleccionar jaula --</option>
                                    @foreach (var jaula in JaulasParaSeleccion)
                                    {
                                        var etiqueta = string.IsNullOrWhiteSpace(jaula.Piso)
                                            ? jaula.Codigo
                                            : $"{jaula.Codigo} ({jaula.Piso} / {jaula.Consultorio})";
                                        <option value="@jaula.Id">@etiqueta @(jaula.Ocupada && jaula.OrdenActual != _ordenSeleccionada.OrdenAtencionId ? "— Ocupada" : "")</option>
                                    }
                                </select>
                                @if (_jaulas.Count == 0)
                                {
                                    <small class="text-muted d-block mt-1">
                                        No hay jaulas registradas aún; cuando se cree el módulo de jaulas aparecerán aquí automáticamente.
                                    </small>
                                }
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="txtUbicacionManual">Detalle / Referencia de ubicación (opcional)</label>
                                <input id="txtUbicacionManual" class="form-control form-control-sm" @bind="_ingreso.UbicacionJaula"
                                       placeholder="Ej. Área Caninos, Jaula J-01, Cuidados intensivos..." maxlength="150" />
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-semibold" for="txtIndicaciones">Indicaciones de hospitalización</label>
                                <textarea id="txtIndicaciones" class="form-control form-control-sm" rows="3" @bind="_ingreso.Indicaciones"
                                          placeholder="Medicación inicial, frecuencia de controles, monitoreo requerido, alertas clínicas..."></textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="txtHidratacion">Hidratación / Fluidoterapia</label>
                                <textarea id="txtHidratacion" class="form-control form-control-sm" rows="3" @bind="_ingreso.HidratacionFluidoterapia"
                                          placeholder="Solución, vía, velocidad de infusión (mL/h), suplementos..."></textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-semibold" for="txtDieta">Dieta y cuidados</label>
                                <textarea id="txtDieta" class="form-control form-control-sm" rows="3" @bind="_ingreso.DietaCuidados"
                                          placeholder="Tipo de alimento, frecuencia, ayuno, cuidados de confort/aseo..."></textarea>
                            </div>
                        }

                        @if (_ordenSeleccionada.RequiereCirugia)
                        {
                            <div class="col-12">
                                <div class="border rounded p-3 bg-white">
                                    <h4 class="h6 mb-2 fw-bold text-primary">
                                        <i class="bi bi-calendar2-check me-1"></i>Programación de Cirugía (Médico encargado, fecha y hora libre)
                                    </h4>
                                    <ProgramacionClinica @key="_ordenSeleccionada.OrdenAtencionId"
                                                         ModoModal="true"
                                                         IdOrden="@_ordenSeleccionada.OrdenAtencionId"
                                                         Nhcl="@_ordenSeleccionada.Nhcl" />
                                </div>
                            </div>
                        }

                        @foreach (var doc in DocumentosIngresoVisibles)
                        {
                            <div class="col-12">
                                <div class="border rounded p-3 bg-light">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                        <div>
                                            <h4 class="h6 mb-1 fw-bold text-dark">
                                                <i class="bi bi-file-earmark-check me-1 text-primary"></i>@doc.Titulo <span class="text-danger">*</span>
                                                <span class="badge text-bg-dark ms-1">DEFAULT</span>
                                            </h4>
                                            <p class="small text-muted mb-0">
                                                Documento oficial predeterminado del sistema (protegido contra eliminación). Puedes descargarlo/imprimirlo, editarlo o subir el escaneo firmado.
                                            </p>
                                        </div>
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(doc.Autorizacion?.ArchivoUrl))
                                            {
                                                <span class="badge text-bg-success"><i class="bi bi-check-circle me-1"></i>Firmado / Escaneado adjunto</span>
                                            }
                                            else if (doc.Autorizacion?.AutorizacionId > 0)
                                            {
                                                <span class="badge text-bg-info"><i class="bi bi-file-earmark-text me-1"></i>Emitido (pendiente de firma)</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">Listo para descargar / firmar</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                        <button type="button" class="btn btn-sm btn-outline-dark app-doc-action app-doc-print" @onclick="() => ImprimirConsentimientoAsync(doc.Clave)" disabled="@_procesandoConsentimiento">
                                            <i class="bi bi-printer" aria-hidden="true"></i>Descargar / Imprimir PDF
                                        </button>

                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AbrirModalEditorConsentimientoAsync(doc.Clave)" disabled="@_procesandoConsentimiento">
                                            <i class="bi bi-pencil-square me-1"></i>Editar documento
                                        </button>

                                        <label class="btn btn-sm btn-outline-success mb-0" style="cursor: pointer;">
                                            <i class="bi bi-cloud-arrow-up-fill me-1"></i>@(string.IsNullOrWhiteSpace(doc.Autorizacion?.ArchivoUrl) ? "Subir firmado (PDF / Foto)" : "Reemplazar firmado")
                                            <InputFile OnChange="@(e => SubirConsentimientoFirmadoAsync(e, doc.Clave))" accept="image/*,application/pdf,.doc,.docx" style="display: none;" />
                                        </label>

                                        @if (!string.IsNullOrWhiteSpace(doc.Autorizacion?.ArchivoUrl))
                                        {
                                            <a class="btn btn-sm btn-link text-decoration-none fw-semibold" href="@doc.Autorizacion.ArchivoUrl" target="_blank" rel="noopener">
                                                <i class="bi bi-paperclip me-1"></i>Ver escaneo (@doc.Autorizacion.ArchivoNombre)
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="ingreso-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex flex-wrap gap-2">
                        @if (_ordenSeleccionada.YaIngresado)
                        {
                            @if (Permisos.Permite("/hospitalizacion/ficha"))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="/hospitalizacion/ficha/@_ordenSeleccionada.OrdenAtencionId/@_ordenSeleccionada.Nhcl">Ir a Ficha 24h</a>
                            }
                            @if (Permisos.Permite("/kardex/enfermeria"))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="/kardex/enfermeria?orden=@_ordenSeleccionada.OrdenAtencionId&nhcl=@_ordenSeleccionada.Nhcl">Ir a Kardex</a>
                            }
                            @if (Permisos.Permite("/kardex/signos"))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="/kardex/signos/@_ordenSeleccionada.OrdenAtencionId/@_ordenSeleccionada.Nhcl">Ir a Signos</a>
                            }
                        }
                    </div>
                    <div class="d-flex flex-wrap justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" disabled="@IngresoOcupado" @onclick="CancelarIngresoAsync">Cancelar</button>
                        <button type="button" class="btn btn-primary bandeja-confirmar" disabled="@IngresoOcupado" @onclick="GuardarIngresoAsync">
                            @if (_guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <i class="bi bi-check2-circle me-1"></i>
                                <span>@(_ordenSeleccionada.YaIngresado ? "Actualizar ingreso" : "Guardar e iniciar ingreso")</span>
                            }
                        </button>
                    </div>
                </div>
            </div>

        }
    </dialog>
}

@if (_mostrarModalConsentimiento && _ordenSeleccionada is not null)
{
    <dialog class="bandeja-dialog bandeja-dialog-editor" @ref="_dialogConsentimiento" aria-labelledby="modalConsentimientoTitulo">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header d-flex justify-content-between align-items-center py-2 px-3 w-100">
                    <h5 class="modal-title fw-bold mb-0" id="modalConsentimientoTitulo">
                        <i class="bi bi-file-earmark-richtext me-1 text-primary"></i>Editar @(string.IsNullOrWhiteSpace(_tituloConsentimiento) ? "Documento" : _tituloConsentimiento) — @_ordenSeleccionada.Paciente
                    </h5>
                    <button type="button" class="btn-close ms-auto" autofocus disabled="@_procesandoConsentimiento" @onclick="CancelarConsentimientoAsync" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(_mensajeAlerta))
                    {
                        <div class="alert @(_esError ? "alert-danger" : "alert-success") py-2 small" role="alert">@_mensajeAlerta</div>
                    }
                    <div class="mb-2">
                        <label class="form-label small fw-semibold" for="txtTituloConsentimiento">Título del documento</label>
                        <input id="txtTituloConsentimiento" class="form-control form-control-sm" @bind="_tituloConsentimiento" maxlength="150" />
                    </div>

                    <div class="d-flex flex-wrap gap-1 p-1 bg-light border border-bottom-0 rounded-top align-items-center">
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('bold')" title="Negrita"><i class="bi bi-type-bold fw-bold"></i></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('italic')" title="Cursiva"><i class="bi bi-type-italic"></i></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('underline')" title="Subrayado"><i class="bi bi-type-underline"></i></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('strikeThrough')" title="Tachado"><i class="bi bi-type-strikethrough"></i></button>
                        <span class="vr mx-1 my-1"></span>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('formatBlock', '<h2>')" title="Título H2"><span class="fw-bold small">H2</span></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('formatBlock', '<h3>')" title="Subtítulo H3"><span class="fw-bold small">H3</span></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('formatBlock', '<p>')" title="Párrafo"><span class="small">P</span></button>
                        <span class="vr mx-1 my-1"></span>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('justifyLeft')" title="Alinear a la izquierda"><i class="bi bi-text-left"></i></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('justifyCenter')" title="Centrar"><i class="bi bi-text-center"></i></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('justifyRight')" title="Alinear a la derecha"><i class="bi bi-text-right"></i></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('justifyFull')" title="Justificar"><i class="bi bi-justify"></i></button>
                        <span class="vr mx-1 my-1"></span>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('insertUnorderedList')" title="Lista con viñetas"><i class="bi bi-list-ul"></i></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('insertOrderedList')" title="Lista numerada"><i class="bi bi-list-ol"></i></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('insertHorizontalRule')" title="Separador"><i class="bi bi-hr"></i></button>
                        <span class="vr mx-1 my-1"></span>
                        <label class="btn btn-sm btn-white border py-0 px-2 shadow-none mb-0 text-primary fw-semibold" style="cursor: pointer;" title="Insertar imagen">
                            <i class="bi bi-image-fill me-1"></i>Insertar Imagen
                            <InputFile OnChange="SubirImagenEditorModalAsync" accept="image/png,image/jpeg,image/webp,image/gif" style="display: none;" />
                        </label>
                        <span class="vr mx-1 my-1"></span>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('undo')" title="Deshacer"><i class="bi bi-arrow-counterclockwise"></i></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('redo')" title="Rehacer"><i class="bi bi-arrow-clockwise"></i></button>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none" onmousedown="event.preventDefault()" onclick="window.hosvetEditor.format('removeFormat')" title="Limpiar formato"><i class="bi bi-eraser"></i></button>
                        <span class="vr mx-1 my-1"></span>
                        <button type="button" class="btn btn-sm btn-white border py-0 px-2 shadow-none text-dark fw-semibold app-doc-action app-doc-print" onmousedown="event.preventDefault()"
                                onclick="window.hosvetEditor.printDocument(document.getElementById('txtTituloConsentimiento')?.value, window.hosvetEditor.getContent('editorConsentimientoHosp'))" title="Imprimir o guardar PDF">
                            <i class="bi bi-printer" aria-hidden="true"></i>Imprimir / PDF
                        </button>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-1 px-2 py-1 bg-primary bg-opacity-10 border border-top-0 border-bottom-0 small">
                        <span class="fw-semibold text-primary me-1"><i class="bi bi-magic me-1"></i>Campos automáticos:</span>
                        @foreach (var campo in CamposAutomaticosPlantilla)
                        {
                            <button type="button"
                                    class="btn btn-xs btn-outline-primary bg-white py-0 px-2"
                                    style="font-size: 0.75rem;"
                                    onmousedown="event.preventDefault()"
                                    @onclick="() => InsertarCampoConsentimientoAsync(campo.Token)"
                                    title="@($"Inserta {campo.Token} — se rellena automáticamente al procesar la plantilla")">
                                + @campo.Etiqueta
                            </button>
                        }
                    </div>

                    <div id="editorConsentimientoHosp"
                         contenteditable="true"
                         class="border rounded-bottom p-3 bg-white shadow-sm"
                         style="min-height: 360px; max-height: 55vh; overflow-y: auto; outline: none; line-height: 1.5; font-size: 0.92rem;">
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelarConsentimientoAsync" disabled="@_procesandoConsentimiento">Cancelar</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="GuardarConsentimientoDesdeModalAsync" disabled="@_procesandoConsentimiento">
                        <i class="bi bi-floppy-fill me-1"></i>Guardar documento
                    </button>
                </div>
            </div>
        </div>
    </dialog>
}

@if (_ordenModal is not null)
{
    <div class="hosp-modal-backdrop" @onclick="CerrarModalModulos"></div>
    <section class="hosp-expediente-modal" role="dialog" aria-modal="true" aria-label="Expediente clínico del paciente">
        <header class="hosp-expediente-header">
            <div class="d-flex align-items-center gap-2">
                <button type="button"
                        class="hosp-sidebar-toggle @(_sidebarModalAbierta ? "active" : "")"
                        title="@(_sidebarModalAbierta ? "Ocultar menú lateral" : "Mostrar menú lateral")"
                        aria-pressed="@_sidebarModalAbierta"
                        @onclick="() => _sidebarModalAbierta = !_sidebarModalAbierta">
                    <i class="bi bi-layout-sidebar"></i>
                </button>
                <div>
                    <small class="text-uppercase fw-bold text-muted">
                        NHCL #@_ordenModal.Nhcl · @_ordenModal.Especie · @_ordenModal.Sexo · Tutor: @_ordenModal.Cliente
                    </small>
                    <h5 class="mb-0 fw-bold text-dark">Expediente del paciente: @_ordenModal.Paciente</h5>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 ms-auto me-2">
                <div class="d-flex flex-wrap align-items-center gap-3 px-2 py-1 bg-light border rounded">
                    <div class="form-check form-switch mb-0">
                        <input @key="(_ordenModal.OrdenAtencionId, _ordenModal.RequiereCirugia, _switchCirugiaVersion)"
                               class="form-check-input" type="checkbox" id="chkModalCirugia"
                               checked="@_ordenModal.RequiereCirugia"
                               disabled="@(_guardandoChecksModal || (_tieneDatosCirugia && _ordenModal.RequiereCirugia))"
                               title="@(_tieneDatosCirugia && _ordenModal.RequiereCirugia ? "No se puede deshabilitar porque ya hay registros en módulos de cirugía" : "Habilitar o deshabilitar módulos de cirugía")"
                               @onchange="OnToggleCirugiaModalAsync" />
                        <label class="form-check-label small fw-semibold" for="chkModalCirugia">
                            Requiere Cirugía @if (_tieneDatosCirugia && _ordenModal.RequiereCirugia) { <span title="Con registros">🔒</span> }
                        </label>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="chkModalHospitalizacion"
                               checked="@_ordenModal.RequiereHospitalizacion"
                               disabled="@(_guardandoChecksModal || (_tieneDatosHospitalizacion && _ordenModal.RequiereHospitalizacion))"
                               title="@(_tieneDatosHospitalizacion && _ordenModal.RequiereHospitalizacion ? "No se puede deshabilitar porque ya hay registros en módulos de hospitalización" : "Habilitar o deshabilitar módulos de hospitalización")"
                               @onchange="OnToggleHospitalizacionModalAsync" />
                        <label class="form-check-label small fw-semibold" for="chkModalHospitalizacion">
                            Requiere Hospitalización @if (_tieneDatosHospitalizacion && _ordenModal.RequiereHospitalizacion) { <span title="Con registros">🔒</span> }
                        </label>
                    </div>
                </div>

                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-2">
                    <i class="bi bi-file-earmark-medical me-1"></i>Orden #@_ordenModal.OrdenAtencionId
                </span>
                @if (!string.IsNullOrWhiteSpace(_ordenModal.JaulaCodigo))
                {
                    <span class="badge text-bg-info px-2 py-2">
                        <i class="bi bi-box-seam me-1"></i>@_ordenModal.JaulaCodigo
                    </span>
                }
            </div>

            <button type="button" class="hosp-modal-close" title="Cerrar" @onclick="CerrarModalModulos">×</button>
        </header>

        @if (!string.IsNullOrWhiteSpace(_mensajeModal))
        {
            <div class="alert alert-warning alert-dismissible fade show py-1 px-3 mb-0 rounded-0 small" role="alert">
                @_mensajeModal
                <button type="button" class="btn-close py-1" @onclick="() => _mensajeModal = null"></button>
            </div>
        }

        <div class="hosp-expediente-workspace">
            @if (_sidebarModalAbierta)
            {
                var gruposSidebar = PestanasDisponiblesModal
                    .GroupBy(t => t.Grupo)
                    .ToList();
                <aside class="hosp-expediente-sidebar" aria-label="Menú del expediente">
                    @for (var gIdx = 0; gIdx < gruposSidebar.Count; gIdx++)
                    {
                        var grupo = gruposSidebar[gIdx];
                        if (gIdx > 0)
                        {
                            <div class="hosp-sidebar-divider"></div>
                        }
                        if (!string.IsNullOrWhiteSpace(grupo.Key))
                        {
                            <div class="hosp-sidebar-group-title">@grupo.Key</div>
                        }
                        @foreach (var tab in grupo)
                        {
                            var bloqueada = EstaPestanaBloqueada(tab.Id);
                            var activa = _pestanaModuloActiva == tab.Id;
                            <button type="button"
                                    disabled="@bloqueada"
                                    title="@(bloqueada ? MotivoBloqueoPestana(tab.Id) : tab.Titulo)"
                                    class="hosp-sidebar-item @(activa ? "active" : "") @(bloqueada ? "locked" : "")"
                                    @onclick="() => CambiarPestanaModalAsync(tab.Id)">
                                <i class="bi @(bloqueada ? "bi-lock" : tab.Icono) hosp-sidebar-icon"></i>
                                <span class="hosp-sidebar-label">@tab.Titulo</span>
                            </button>
                        }
                    }
                </aside>
            }

            <div class="hosp-expediente-modal-body">
            @switch (_pestanaModuloActiva)
            {
                case "resumen":
                    @if (_cargandoResumen)
                    {
                        <div class="py-4 text-center text-primary small">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>Cargando resumen clínico del paciente...
                        </div>
                    }
                    else
                    {
                        var fotoResumen = ObtenerFotoPaciente(_ordenModal.Nhcl);
                        <div class="d-flex flex-column gap-3">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body d-flex flex-wrap align-items-center gap-3">
                                    <span class="hosp-avatar" style="width: 64px; height: 64px; flex: 0 0 64px; font-size: 22px;">
                                        @if (!string.IsNullOrEmpty(fotoResumen))
                                        {
                                            <img src="@fotoResumen" alt="Foto de @_ordenModal.Paciente" />
                                        }
                                        else
                                        {
                                            <b>@InicialPaciente(_ordenModal.Paciente)</b>
                                        }
                                    </span>
                                    <div class="flex-grow-1">
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                            <h4 class="h5 mb-0 fw-bold text-dark">@_ordenModal.Paciente</h4>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">NHCL #@_ordenModal.Nhcl</span>
                                            <span class="badge @ClaseTipoAtencion(_ordenModal)">@_ordenModal.TipoAtencionTexto</span>
                                            @if (_ordenModal.RequiereHospitalizacion)
                                            {
                                                <span class="badge text-bg-info">
                                                    <i class="bi bi-box-seam me-1"></i>@(string.IsNullOrWhiteSpace(_ordenModal.JaulaCodigo) ? "Sin jaula" : _ordenModal.JaulaCodigo)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">Ambulatorio</span>
                                            }
                                        </div>
                                        <div class="small text-muted">
                                            <strong>@(_resumenCabecera?.Raza ?? "—")</strong> · @_ordenModal.Especie · @_ordenModal.Sexo
                                            @if (_resumenCabecera != null)
                                            {
                                                <span> · Edad: @_resumenCabecera.EdadTexto · @_resumenCabecera.Origen</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="border rounded p-2 bg-light small" style="min-width: 240px;">
                                        <div class="text-uppercase fw-bold text-muted" style="font-size: 10px;">Tutor / Médico</div>
                                        <div class="fw-semibold text-dark"><i class="bi bi-person-circle me-1 text-primary"></i>@(_resumenCabecera?.ClienteNombre ?? _ordenModal.Cliente)</div>
                                        @if (!string.IsNullOrWhiteSpace(_resumenCabecera?.ClienteCedula))
                                        {
                                            <div class="text-muted">C.I.: @_resumenCabecera.ClienteCedula</div>
                                        }
                                        <div class="text-muted"><i class="bi bi-stethoscope me-1"></i>Dr(a). @(_resumenCabecera?.MedicoResponsable ?? _ordenModal.Medico)</div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-lg-6 d-flex flex-column gap-3">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-header bg-white fw-bold text-primary py-2">
                                            <i class="bi bi-hospital me-1"></i>Indicaciones de Ingreso y Cuidados
                                        </div>
                                        <div class="card-body small d-flex flex-column gap-2">
                                            @if (_ordenModal.RequiereHospitalizacion)
                                            {
                                                <div class="d-flex flex-wrap gap-3 pb-2 border-bottom">
                                                    <div><strong>Ubicación / Jaula:</strong> <span class="badge text-bg-info">@(string.IsNullOrWhiteSpace(_resumenIngreso?.UbicacionJaula) ? _ordenModal.JaulaCodigo : _resumenIngreso.UbicacionJaula)</span></div>
                                                    @if (_resumenIngreso?.FechaIngreso is { } fi)
                                                    {
                                                        <div><strong>Fecha de ingreso:</strong> @fi.ToString("dd/MM/yyyy HH:mm")</div>
                                                    }
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-secondary">Indicaciones de hospitalización</div>
                                                    <div class="p-2 bg-light rounded border mt-1">@(string.IsNullOrWhiteSpace(_resumenIngreso?.Indicaciones) ? "Sin indicaciones registradas." : _resumenIngreso.Indicaciones)</div>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-secondary">Hidratación / Fluidoterapia</div>
                                                    <div class="p-2 bg-light rounded border mt-1">@(string.IsNullOrWhiteSpace(_resumenIngreso?.HidratacionFluidoterapia) ? "Sin fluidoterapia registrada." : _resumenIngreso.HidratacionFluidoterapia)</div>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-secondary">Dieta y cuidados</div>
                                                    <div class="p-2 bg-light rounded border mt-1">@(string.IsNullOrWhiteSpace(_resumenIngreso?.DietaCuidados) ? "Sin dieta o cuidados especiales registrados." : _resumenIngreso.DietaCuidados)</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="alert alert-light border mb-0">
                                                    Paciente en modalidad ambulatoria (**Cirugía sin hospitalización**). Si requiere internación posterior, activa el switch **Requiere Hospitalización** arriba.
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6 d-flex flex-column gap-3">
                                    @if (_ordenModal.RequiereCirugia)
                                    {
                                        <div class="card border-0 shadow-sm">
                                            <div class="card-header bg-white fw-bold text-primary py-2 d-flex justify-content-between align-items-center">
                                                <span><i class="bi bi-calendar2-check me-1"></i>Cirugía Programada</span>
                                                @if (!EstaPestanaBloqueada("cirugia"))
                                                {
                                                    <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2" @onclick='() => CambiarPestanaModalAsync("cirugia")'>Ir a Programación</button>
                                                }
                                            </div>
                                            <div class="card-body small">
                                                @if (_resumenCirugias.Count > 0)
                                                {
                                                    <div class="d-flex flex-column gap-2">
                                                        @foreach (var cir in _resumenCirugias)
                                                        {
                                                            <div class="p-2 bg-light rounded border d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                                <div>
                                                                    <div class="fw-semibold text-dark">@cir.Procedimiento</div>
                                                                    <div class="text-muted">Cirujano: @cir.Medico</div>
                                                                </div>
                                                                <span class="badge text-bg-primary">@cir.Fecha.ToString("dd/MM/yyyy") · @cir.HoraInicio - @cir.HoraFin</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Aún no hay cirugía agendada para este paciente.</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <div class="card border-0 shadow-sm">
                                        <div class="card-header bg-white fw-bold text-primary py-2">
                                            <i class="bi bi-file-earmark-check me-1"></i>Consentimientos y Documentos
                                        </div>
                                        <div class="card-body small">
                                            @if (_resumenAutorizaciones.Count > 0)
                                            {
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var auth in _resumenAutorizaciones)
                                                    {
                                                        <div class="p-2 bg-light rounded border d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                            <div>
                                                                <div class="fw-semibold text-dark">@auth.Documento</div>
                                                                @if (!string.IsNullOrWhiteSpace(auth.ArchivoUrl))
                                                                {
                                                                    <span class="badge text-bg-success">Firmado / Escaneado</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge text-bg-info">Emitido sin escaneo</span>
                                                                }
                                                            </div>
                                                            <div class="d-flex gap-1">
                                                                @if (!string.IsNullOrWhiteSpace(auth.ArchivoUrl))
                                                                {
                                                                    <a class="btn btn-xs btn-outline-success py-0 px-2" href="@auth.ArchivoUrl" target="_blank" rel="noopener">Ver escaneo</a>
                                                                }
                                                                <button type="button" class="btn btn-xs btn-outline-dark py-0 px-2 app-doc-action app-doc-print" @onclick="() => ImprimirResumenAutorizacionAsync(auth)"><i class="bi bi-printer" aria-hidden="true"></i> Imprimir</button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No hay consentimientos registrados para esta orden todavía.</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    break;
                case "soap":
                    <FichaMedica @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                 IdOrden="@_ordenModal.OrdenAtencionId"
                                 Nhcl="@_ordenModal.Nhcl"
                                 ModoModal="true"
                                 SoloLectura="true" />
                    break;
                case "kardex":
                    <KardexEnfermeria @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                      IdOrden="@_ordenModal.OrdenAtencionId"
                                      Nhcl="@_ordenModal.Nhcl"
                                      ModoModal="true" />
                    break;
                case "signos":
                    <EnfermeriaSignos @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                      IdOrden="@_ordenModal.OrdenAtencionId"
                                      Nhcl="@_ordenModal.Nhcl"
                                      ModoModal="true"
                                      RequiereCirugia="@_ordenModal.RequiereCirugia" />
                    break;
                case "ficha24h":
                    <FichaHospitalizacion @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                          IdOrden="@_ordenModal.OrdenAtencionId"
                                          Nhcl="@_ordenModal.Nhcl"
                                          ModoModal="true" />
                    break;
                case "monitoreo":
                    <MonitoreoHospitalario @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                           IdOrden="@_ordenModal.OrdenAtencionId"
                                           Nhcl="@_ordenModal.Nhcl" />
                    break;
                case "cirugia":
                    <ProgramacionClinica @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                         ModoModal="true"
                                         IdOrden="@_ordenModal.OrdenAtencionId"
                                         Nhcl="@_ordenModal.Nhcl" />
                    break;
                case "preanestesia":
                    <PreAnestesia @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                  IdOrden="@_ordenModal.OrdenAtencionId"
                                  Nhcl="@_ordenModal.Nhcl"
                                  IdCirugia="@_idCirugiaActivaModal"
                                  OnCirugiaCambiada="id => _idCirugiaActivaModal = id"
                                  OnGuardado="RefrescarEstadoBloqueosModalAsync" />
                    break;
                case "pausaseguridad":
                    <PausaSeguridad @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                    IdOrden="@_ordenModal.OrdenAtencionId"
                                    Nhcl="@_ordenModal.Nhcl"
                                    IdCirugia="@_idCirugiaActivaModal"
                                    OnCirugiaCambiada="id => _idCirugiaActivaModal = id"
                                    ModoModal="true"
                                    OnGuardado="RefrescarEstadoBloqueosModalAsync" />
                    break;
                case "anestesia":
                    <HojaAnestesia @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                   IdOrden="@_ordenModal.OrdenAtencionId"
                                   Nhcl="@_ordenModal.Nhcl"
                                   IdCirugia="@_idCirugiaActivaModal"
                                   OnCirugiaCambiada="id => _idCirugiaActivaModal = id" />
                    break;
                case "monanestesia":
                    <MonitorizacionAnestesia @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                             IdOrden="@_ordenModal.OrdenAtencionId"
                                             Nhcl="@_ordenModal.Nhcl"
                                             IdCirugia="@_idCirugiaActivaModal"
                                             OnCirugiaCambiada="id => _idCirugiaActivaModal = id"
                                             ModoModal="true"
                                             OnGuardado="RefrescarEstadoBloqueosModalAsync" />
                    break;
                case "protocolo":
                    <ProtocoloQuirurgico @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                         IdOrden="@_ordenModal.OrdenAtencionId"
                                         Nhcl="@_ordenModal.Nhcl"
                                         IdCirugia="@_idCirugiaActivaModal"
                                         OnCirugiaCambiada="id => _idCirugiaActivaModal = id" />
                    break;
                case "recuperacion":
                    <SalaRecuperacion @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                      IdOrden="@_ordenModal.OrdenAtencionId"
                                      Nhcl="@_ordenModal.Nhcl"
                                      IdCirugia="@_idCirugiaActivaModal"
                                      OnCirugiaCambiada="id => _idCirugiaActivaModal = id" />
                    break;
                case "evoluciones":
                    <EvolucionMedica @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                     IdOrden="@_ordenModal.OrdenAtencionId"
                                     Nhcl="@_ordenModal.Nhcl" />
                    break;
                case "recetario":
                    <RecetarioMedico @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                     IdOrden="@_ordenModal.OrdenAtencionId"
                                     Nhcl="@_ordenModal.Nhcl" />
                    break;
                case "consentimientos":
                    <AutorizacionesAlta @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                        IdOrden="@_ordenModal.OrdenAtencionId"
                                        Nhcl="@_ordenModal.Nhcl" />
                    break;
                case "diagnostico":
                    <OrdenesDiagnostico @key="_ordenModal.OrdenAtencionId"
                                        IdOrden="@_ordenModal.OrdenAtencionId"
                                        Nhcl="@_ordenModal.Nhcl"
                                        ModoModal="true" />
                    break;
                case "informes":
                    <BandejaResultadosDiagnosticos @key="(_ordenModal.OrdenAtencionId, _pestanaModuloActiva)"
                                                   IdOrden="@_ordenModal.OrdenAtencionId"
                                                   Nhcl="@_ordenModal.Nhcl"
                                                   NhclExpediente="@_ordenModal.Nhcl"
                                                   OrdenExpediente="@_ordenModal.OrdenAtencionId" />
                    break;
            }
            </div>
        </div>
    </section>

    @if (_confirmarDesactivarCirugia)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15,23,42,0.55); z-index: 1070;" role="dialog" aria-modal="true" aria-labelledby="modalConfirmCirugiaTitulo">
            <div class="modal-dialog modal-dialog-centered modal-sm" style="max-width: 430px;">
                <div class="modal-content shadow border-0">
                    <div class="modal-header bg-warning bg-opacity-25 py-2">
                        <h5 class="modal-title h6 fw-bold text-dark mb-0" id="modalConfirmCirugiaTitulo">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Confirmar desactivación
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelarDesactivarCirugia" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body small">
                        <p class="mb-0">
                            Tienes datos en borrador de cirugía o <strong>Días PostQuirúrgico</strong> sin guardar. Si desactivas <strong>Requiere Cirugía</strong>, esos borradores se limpiarán. ¿Deseas continuar?
                        </p>
                    </div>
                    <div class="modal-footer py-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelarDesactivarCirugia">Cancelar</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="ConfirmarDesactivarCirugiaAsync">Sí, desactivar y limpiar</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

