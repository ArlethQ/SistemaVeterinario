        ("anestesia", "bi-lungs", "Anestesia", "/quirofano/anestesia", "CIRUGÍA"),
        ("monanestesia", "bi-heart-pulse-fill", "Monitorización de anestesia", "/quirofano/anestesia", "CIRUGÍA"),
        ("protocolo", "bi-scissors", "Protocolo quirúrgico", "/quirofano/protocolo", "CIRUGÍA"),
        ("recuperacion", "bi-hospital", "Recuperación", "/quirofano/recuperacion", "CIRUGÍA"),
        ("recetario", "bi-capsule", "Recetario", "/consulta/recetario", "ALTA Y RECETARIO"),
        ("consentimientos", "bi-file-earmark-check", "Consentimientos y Alta", "/consulta/autorizaciones", "ALTA Y RECETARIO")
    ];
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);

    private List<OrdenHospitalizacionColaDto> _ordenes = [];
    private List<JaulaClinicaDto> _jaulas = [];
    private OrdenHospitalizacionColaDto? _ordenSeleccionada;
    private OrdenHospitalizacionColaDto? _ordenModal;
    private string _pestanaModuloActiva = "resumen";
    private int _idCirugiaActivaModal;
    private IngresoHospitalizacionDto _ingreso = new();
    private PacienteHeaderDto? _resumenCabecera;
    private IngresoHospitalizacionDto? _resumenIngreso;
    private List<AutorizacionClinicaDto> _resumenAutorizaciones = [];
    private List<CirugiaProgramadaDto> _resumenCirugias = [];
    private bool _cargandoResumen;

    private static readonly HashSet<string> PestanasCirugia =
    [
        "cirugia", "preanestesia", "pausaseguridad", "anestesia", "monanestesia", "protocolo", "recuperacion"
    ];

    private static readonly HashSet<string> PestanasHospitalizacion =
    [
        "ficha24h", "kardex", "signos", "monitoreo"
    ];

    private bool _tieneDatosCirugia;
    private bool _tieneDatosHospitalizacion;
    private bool _tienePreanestesia;
    private bool _tienePausaSeguridad;
    private bool _guardandoChecksModal;
    private bool _confirmarDesactivarCirugia;
    private bool _sidebarModalAbierta = true;
    private int _switchCirugiaVersion;
    private string? _mensajeModal;

    private IEnumerable<(string Id, string Icono, string Titulo, string Permiso, string Grupo)> PestanasDisponiblesModal =>
        PestanasModulos.Where(t => Permisos.Permite(t.Permiso) ||
            (t.Id == "diagnostico" && Permisos.Permite("/diagnostico/imagenologia")));

    private bool EstaPestanaBloqueada(string id) =>
        (_ordenModal is not null && PestanasCirugia.Contains(id) && !_ordenModal.RequiereCirugia)
        || (_ordenModal is not null && PestanasHospitalizacion.Contains(id) && !_ordenModal.RequiereHospitalizacion);

    private string MotivoBloqueoPestana(string id)
    {
        if (_ordenModal is not null && PestanasCirugia.Contains(id) && !_ordenModal.RequiereCirugia)
            return "Módulo bloqueado: active Requiere Cirugía";
        if (_ordenModal is not null && PestanasHospitalizacion.Contains(id) && !_ordenModal.RequiereHospitalizacion)
            return "Módulo bloqueado: active Requiere Hospitalización";
        return "Módulo bloqueado";
    }

    private IEnumerable<OrdenHospitalizacionColaDto> PendientesIngreso =>
        _ordenes.Where(x => !x.YaIngresado);
    private IEnumerable<OrdenHospitalizacionColaDto> Hospitalizados =>
        _ordenes.Where(x => x.YaIngresado);
    private int IngresosEnProceso => _ordenSeleccionada is { YaIngresado: false } orden &&
        PendientesIngreso.Any(x => x.OrdenAtencionId == orden.OrdenAtencionId) ? 1 : 0;

    private sealed class DocIngresoEstado
    {
        public string Clave { get; init; } = string.Empty;
        public string Tipo { get; init; } = string.Empty;
        public string? NombreContiene { get; init; }
        public string Titulo { get; set; } = string.Empty;
        public string Html { get; set; } = string.Empty;
        public AutorizacionClinicaDto? Autorizacion { get; set; }
    }

    private readonly Dictionary<string, DocIngresoEstado> _docsIngreso = new()
    {
        ["hosp"] = new() { Clave = "hosp", Tipo = "HOSPITALIZACION", Titulo = "Consentimiento Informado de Hospitalización" },
        ["anest"] = new() { Clave = "anest", Tipo = "AUTORIZACION", NombreContiene = "Anestesia", Titulo = "Autorizacion de Anestesia" },
        ["cir"] = new() { Clave = "cir", Tipo = "CIRUGIA", Titulo = "Consentimiento Informado de Cirugía" }
    };
    private string _claveDocEditando = "hosp";

    private IEnumerable<DocIngresoEstado> DocumentosIngresoVisibles
    {
        get
        {
            if (_ordenSeleccionada is null) yield break;
            if (_ordenSeleccionada.RequiereHospitalizacion) yield return _docsIngreso["hosp"];
            if (_ordenSeleccionada.RequiereCirugia)
            {
                yield return _docsIngreso["anest"];
                yield return _docsIngreso["cir"];
            }
        }
    }

    private string _filtro = string.Empty;
    private string _tituloConsentimiento = "Consentimiento Informado de Hospitalización";
    private string _htmlConsentimiento = string.Empty;
    private bool _cargando;
    private bool _cargandoIngreso;
    private bool _falloCargaIngreso;
    private bool _abrirDialogIngreso;
    private ElementReference _dialogIngreso;
    private ElementReference _dialogConsentimiento;
    private bool IngresoOcupado => _cargandoIngreso || _guardando || _procesandoConsentimiento;
    private bool _guardando;
    private bool _procesandoConsentimiento;
    private bool _mostrarModalConsentimiento;
    private bool _inicializarEditorModal;
    private string? _mensajeAlerta;
    private bool _esError;
    private int _versionBusqueda;

    private IEnumerable<JaulaClinicaDto> JaulasParaSeleccion => _jaulas
        .Where(j => !j.Ocupada || j.OrdenActual == _ordenSeleccionada?.OrdenAtencionId || j.Id == _ingreso.IdJaula);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarColaAsync(), CargarJaulasAsync());
    }

    private async Task CargarJaulasAsync()
    {
        try
        {
            _jaulas = await GestionService.ObtenerJaulasAsync(soloActivas: true, idLocalidad: Session.Localidad > 0 ? Session.Localidad : null);
        }
        catch
        {
            _jaulas = [];
        }
    }

    private async Task CargarColaAsync()
    {
        _cargando = true;
        try
        {
            _ordenes = await HospService.ObtenerColaHospitalizacionAsync(_filtro, Session.Localidad > 0 ? Session.Localidad : null);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task BuscarMientrasEscribeAsync()
    {
        var version = ++_versionBusqueda;
        await Task.Delay(250);
        if (version != _versionBusqueda) return;
        await CargarColaAsync();
    }

    private async Task SeleccionarParaIngresoAsync(OrdenHospitalizacionColaDto item)
    {
        if (_ordenSeleccionada is not null) return;

        _mensajeAlerta = null;
        _esError = false;
        _falloCargaIngreso = false;
        _ordenSeleccionada = item;
        _abrirDialogIngreso = true;
        _cargandoIngreso = true;
        try
        {
            await CargarJaulasAsync();
            _ingreso = await HospService.ObtenerIngresoHospitalizacionAsync(item.OrdenAtencionId, item.Nhcl);
            await CargarConsentimientoOrdenAsync(item.OrdenAtencionId, item.Nhcl);
        }
        catch (Exception ex)
        {
            _falloCargaIngreso = true;
            _esError = true;
            _mensajeAlerta = $"No se pudo cargar el ingreso: {ex.Message}";
        }
        finally
        {
            _cargandoIngreso = false;
        }
    }

    private async Task CancelarIngresoAsync()
    {
        if (IngresoOcupado) return;

        _mensajeAlerta = null;
        await CerrarPanelIngresoAsync();
    }

    private async Task CerrarPanelIngresoAsync()
    {
        await JS.InvokeVoidAsync("hosvetDialog.close", _dialogIngreso);
        _ordenSeleccionada = null;
        _ingreso = new();
        _htmlConsentimiento = string.Empty;
        _mostrarModalConsentimiento = false;
    }

    private async Task AbrirModalModulosAsync(OrdenHospitalizacionColaDto item)
    {
        _ordenModal = item;
        _mensajeModal = null;
        Session.SeleccionarOrden(item.OrdenAtencionId, item.Nhcl, item.Paciente);
        _pestanaModuloActiva = "resumen";
        await Task.WhenAll(RefrescarEstadoBloqueosModalAsync(), CargarResumenModalAsync());
    }

    private async Task CargarResumenModalAsync()
    {
        if (_ordenModal is null) return;
        _cargandoResumen = true;
        try
        {
            var idOrden = _ordenModal.OrdenAtencionId;
            var nhcl = _ordenModal.Nhcl;
            var tCab = KardexService.ObtenerCabeceraPacienteAsync(idOrden, nhcl);
            var tIng = HospService.ObtenerIngresoHospitalizacionAsync(idOrden, nhcl);
            var tAuth = ConsultaService.ObtenerAutorizacionesPacienteAsync(nhcl);
            var tCir = GestionService.ObtenerCirugiasAsync(DateTime.Today.AddDays(-7), DateTime.Today.AddMonths(6));
            await Task.WhenAll(tCab, tIng, tAuth, tCir);

            _resumenCabecera = await tCab;
            _resumenIngreso = await tIng;
            _resumenAutorizaciones = (await tAuth).Where(a => a.Orden == idOrden).ToList();
            _resumenCirugias = (await tCir).Where(c => c.Estado == "A" && c.Nhcl == nhcl).ToList();
        }
        finally
        {
            _cargandoResumen = false;
        }
    }

    private async Task ImprimirResumenAutorizacionAsync(AutorizacionClinicaDto auth)
    {
        if (string.IsNullOrWhiteSpace(auth.DetalleHtml)) return;
        await JS.InvokeVoidAsync("hosvetEditor.printDocument", auth.Documento, auth.DetalleHtml);
    }

    private async Task RefrescarEstadoBloqueosModalAsync()
    {
        if (_ordenModal is null) return;
        var estadoTask = HospService.VerificarDatosModulosOrdenAsync(_ordenModal.OrdenAtencionId, _ordenModal.Nhcl);
        var flujoTask = HospService.ObtenerEstadoFlujoCirugiaAsync(_ordenModal.OrdenAtencionId);
        await Task.WhenAll(estadoTask, flujoTask);
        var estado = await estadoTask;
        var flujo = await flujoTask;
        _tieneDatosCirugia = estado.TieneDatosCirugia;
        _tieneDatosHospitalizacion = estado.TieneDatosHospitalizacion;
        _tienePreanestesia = flujo.TienePreanestesia;
        _tienePausaSeguridad = flujo.TienePausaSeguridad;
    }

    private async Task OnSelectModuloModalChangedAsync(ChangeEventArgs e)
    {
        var tabId = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(tabId))
        {
            await CambiarPestanaModalAsync(tabId);
        }
    }

    private async Task CambiarPestanaModalAsync(string tabId)
    {
        if (EstaPestanaBloqueada(tabId)) return;
        _pestanaModuloActiva = tabId;
        await RefrescarEstadoBloqueosModalAsync();
        if (tabId == "resumen")
        {
            await CargarResumenModalAsync();
        }
    }

    private async Task OnToggleCirugiaModalAsync(ChangeEventArgs e)
    {
        if (_ordenModal is null) return;
        var nuevo = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (!nuevo)
        {
            var tieneBorrador = await JS.InvokeAsync<bool>("hosvetDraft.hasSurgeryDraft", _ordenModal.OrdenAtencionId);
            if (tieneBorrador)
            {
                _confirmarDesactivarCirugia = true;
                return;
            }
        }
        _confirmarDesactivarCirugia = false;
        await ActualizarChecksModalAsync(nuevo, _ordenModal.RequiereHospitalizacion);
    }

    private async Task ConfirmarDesactivarCirugiaAsync()
    {
        if (_ordenModal is null) return;
        _confirmarDesactivarCirugia = false;
        await JS.InvokeVoidAsync("hosvetDraft.clearSurgeryDrafts", _ordenModal.OrdenAtencionId);
        await ActualizarChecksModalAsync(false, _ordenModal.RequiereHospitalizacion);
    }

    private void CancelarDesactivarCirugia()
    {
        _confirmarDesactivarCirugia = false;
        _switchCirugiaVersion++;
    }

    private async Task OnToggleHospitalizacionModalAsync(ChangeEventArgs e)
    {
        if (_ordenModal is null) return;
        var nuevo = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        await ActualizarChecksModalAsync(_ordenModal.RequiereCirugia, nuevo);
    }

    private async Task ActualizarChecksModalAsync(bool reqCirugia, bool reqHosp)
    {
        if (_ordenModal is null) return;
        _mensajeModal = null;
        _guardandoChecksModal = true;
        try
        {
            await RefrescarEstadoBloqueosModalAsync();
            await HospService.ActualizarIndicacionesModalAsync(_ordenModal.OrdenAtencionId, _ordenModal.Nhcl, reqCirugia, reqHosp, Session.IdUser);
            _ordenModal.RequiereCirugia = reqCirugia;
            _ordenModal.RequiereHospitalizacion = reqHosp;

            if (EstaPestanaBloqueada(_pestanaModuloActiva))
            {
                var primera = PestanasDisponiblesModal.FirstOrDefault(t => !EstaPestanaBloqueada(t.Id)).Id;
                _pestanaModuloActiva = string.IsNullOrWhiteSpace(primera) ? "soap" : primera;
            }

            await CargarColaAsync();
            var refOrd = _ordenes.FirstOrDefault(o => o.OrdenAtencionId == _ordenModal.OrdenAtencionId);
            if (refOrd != null) _ordenModal = refOrd;
        }
        catch (Exception ex)
        {
            _mensajeModal = ex.Message;
        }
        finally
        {
            _guardandoChecksModal = false;
        }
    }

    private async Task CerrarModalModulos()
    {
        _ordenModal = null;
        _mensajeModal = null;
        _confirmarDesactivarCirugia = false;
        await CargarColaAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_abrirDialogIngreso && _ordenSeleccionada is not null)
        {
            _abrirDialogIngreso = false;
            await JS.InvokeVoidAsync("hosvetDialog.open", _dialogIngreso);
        }

        if (_inicializarEditorModal && _mostrarModalConsentimiento)
        {
            _inicializarEditorModal = false;
            await JS.InvokeVoidAsync("hosvetDialog.open", _dialogConsentimiento);
            await JS.InvokeVoidAsync("hosvetEditor.setContent", "editorConsentimientoHosp", _htmlConsentimiento);
        }
    }

    private async Task InsertarCampoConsentimientoAsync(string token)
    {
        if (_ordenSeleccionada is null) return;
        var campos = await ConsultaService.ObtenerCamposDocumentoAsync(_ordenSeleccionada.Nhcl);
        await JS.InvokeVoidAsync("hosvetEditor.insertToken", "editorConsentimientoHosp", token, campos[token]);
    }

    private async Task CargarConsentimientoOrdenAsync(int idOrden, int nhcl)
    {
        var autorizaciones = await ConsultaService.ObtenerAutorizacionesPacienteAsync(nhcl);
        foreach (var item in _docsIngreso.Values)
        {
            var existente = autorizaciones.FirstOrDefault(a =>
                a.Orden == idOrden &&
                (item.NombreContiene != null
                    ? a.Documento.Contains(item.NombreContiene, StringComparison.OrdinalIgnoreCase)
                    : (a.Tipo.Equals(item.Tipo, StringComparison.OrdinalIgnoreCase)
                       || a.Documento.Contains(item.Tipo == "CIRUGIA" ? "Cirug" : "Hospitaliz", StringComparison.OrdinalIgnoreCase))));

            if (existente != null)
            {
                item.Autorizacion = existente;
                item.Titulo = existente.Documento;
                item.Html = existente.DetalleHtml;
            }
            else
            {
                item.Autorizacion = null;
                var plantilla = await ConsultaService.ObtenerPlantillaPorTipoONombreAsync(item.Tipo, item.NombreContiene);
                item.Titulo = plantilla?.FormNombre ?? item.Clave switch
                {
                    "anest" => "Autorizacion de Anestesia",
                    "cir" => "Consentimiento Informado de Cirugía",
                    _ => "Consentimiento Informado de Hospitalización"
                };
                item.Html = plantilla != null
                    ? await ConsultaService.ProcesarPlantillaConDatosPacienteAsync(plantilla.FormId, nhcl)
                    : string.Empty;
            }
        }
    }

    private async Task<AutorizacionClinicaDto?> AsegurarAutorizacionGuardadaAsync(string clave)
    {
        if (_ordenSeleccionada is null || !_docsIngreso.TryGetValue(clave, out var doc)) return null;
        if (doc.Autorizacion?.AutorizacionId > 0) return doc.Autorizacion;

        var cab = await KardexService.ObtenerCabeceraPacienteAsync(_ordenSeleccionada.OrdenAtencionId, _ordenSeleccionada.Nhcl);
        var nueva = new AutorizacionClinicaDto
        {
            Nhcl = _ordenSeleccionada.Nhcl,
            Orden = _ordenSeleccionada.OrdenAtencionId,
            Cliente = cab?.ClienteCodigo ?? 0,
            IdUser = Session.CurrentUser?.UserNumero ?? Session.IdUser,
            Documento = doc.Titulo,
            Tipo = doc.Tipo,
            DetalleHtml = doc.Html
        };

        await ConsultaService.GuardarAutorizacionAsync(nueva);
        await CargarConsentimientoOrdenAsync(_ordenSeleccionada.OrdenAtencionId, _ordenSeleccionada.Nhcl);
        return doc.Autorizacion;
    }

    private async Task ImprimirConsentimientoAsync(string clave)
    {
        if (_ordenSeleccionada is null || !_docsIngreso.TryGetValue(clave, out var doc)) return;
        _procesandoConsentimiento = true;
        try
        {
            await AsegurarAutorizacionGuardadaAsync(clave);
            await JS.InvokeVoidAsync("hosvetEditor.printDocument", doc.Titulo, doc.Html);
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al imprimir documento: {ex.Message}";
        }
        finally
        {
            _procesandoConsentimiento = false;
        }
    }

    private void AbrirModalEditorConsentimientoAsync(string clave)
    {
        if (!_docsIngreso.TryGetValue(clave, out var doc)) return;
        _mensajeAlerta = null;
        _claveDocEditando = clave;
        _tituloConsentimiento = doc.Titulo;
        _htmlConsentimiento = doc.Html;
        _mostrarModalConsentimiento = true;
        _inicializarEditorModal = true;
    }

    private Task CancelarConsentimientoAsync() => _procesandoConsentimiento
        ? Task.CompletedTask
        : CerrarModalEditorConsentimientoAsync();

    private async Task CerrarModalEditorConsentimientoAsync()
    {
        await JS.InvokeVoidAsync("hosvetDialog.close", _dialogConsentimiento);
        _mostrarModalConsentimiento = false;
        _inicializarEditorModal = false;
    }

    private async Task GuardarConsentimientoDesdeModalAsync()
    {
        if (_ordenSeleccionada is null || !_docsIngreso.TryGetValue(_claveDocEditando, out var doc)) return;
        _procesandoConsentimiento = true;
        _mensajeAlerta = null;
        _esError = false;
        try
        {
            var html = await JS.InvokeAsync<string>("hosvetEditor.getContent", "editorConsentimientoHosp");
            if (!string.IsNullOrWhiteSpace(html))
            {
                _htmlConsentimiento = html;
            }

            doc.Titulo = _tituloConsentimiento;
            doc.Html = _htmlConsentimiento;

            if (doc.Autorizacion?.AutorizacionId > 0)
            {
                await ConsultaService.ActualizarDetalleAutorizacionAsync(doc.Autorizacion.AutorizacionId, doc.Titulo, doc.Html);
                await CargarConsentimientoOrdenAsync(_ordenSeleccionada.OrdenAtencionId, _ordenSeleccionada.Nhcl);
            }
            else
            {
                await AsegurarAutorizacionGuardadaAsync(_claveDocEditando);
            }

            await CerrarModalEditorConsentimientoAsync();
            _mensajeAlerta = $"Documento '{doc.Titulo}' guardado correctamente.";
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al guardar documento: {ex.Message}";
        }
        finally
        {
            _procesandoConsentimiento = false;
        }
    }

    private async Task SubirImagenEditorModalAsync(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file is null || file.Size > 5 * 1024 * 1024) return;

            var uploadsFolder = Path.Combine(Env.WebRootPath, "imagenes", "documentos");
            if (!Directory.Exists(uploadsFolder)) Directory.CreateDirectory(uploadsFolder);

            var ext = Path.GetExtension(file.Name);
            if (string.IsNullOrWhiteSpace(ext)) ext = ".png";
            var fileName = $"doc_img_{Guid.NewGuid():N}{ext}";
            var filePath = Path.Combine(uploadsFolder, fileName);

            await using (var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024))
            await using (var fs = new FileStream(filePath, FileMode.Create))
            {
                await stream.CopyToAsync(fs);
            }

            await JS.InvokeVoidAsync("hosvetEditor.insertImage", "editorConsentimientoHosp", $"/imagenes/documentos/{fileName}");
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"No se pudo insertar la imagen: {ex.Message}";
        }
    }

    private async Task SubirConsentimientoFirmadoAsync(InputFileChangeEventArgs e, string clave)
    {
        if (_ordenSeleccionada is null || !_docsIngreso.TryGetValue(clave, out var doc)) return;
        _procesandoConsentimiento = true;
        _mensajeAlerta = null;
        _esError = false;
        try
        {
            var file = e.File;
            if (file is null) return;
            if (file.Size > 25 * 1024 * 1024)
            {
                _esError = true;
                _mensajeAlerta = "El archivo firmado no puede superar los 25MB.";
                return;
            }

            var auth = await AsegurarAutorizacionGuardadaAsync(clave);
            if (auth is null || auth.AutorizacionId <= 0)
            {
                _esError = true;
                _mensajeAlerta = "No se pudo registrar el documento para adjuntar el escaneo.";
                return;
            }

            var uploadsFolder = Path.Combine(Env.WebRootPath, "archivosPacientes", _ordenSeleccionada.Nhcl.ToString(), "autorizaciones");
            if (!Directory.Exists(uploadsFolder)) Directory.CreateDirectory(uploadsFolder);

            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (string.IsNullOrWhiteSpace(ext)) ext = ".pdf";
            var fileName = $"Firmado_{auth.AutorizacionId}_{clave}_{DateTime.Now:yyyyMMddHHmmss}{ext}";
            var filePath = Path.Combine(uploadsFolder, fileName);

            await using (var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024))
            await using (var fs = new FileStream(filePath, FileMode.Create))
            {
                await stream.CopyToAsync(fs);
            }

            var fileUrl = $"/archivosPacientes/{_ordenSeleccionada.Nhcl}/autorizaciones/{fileName}";
            var ok = await ConsultaService.ActualizarArchivoAutorizacionAsync(auth.AutorizacionId, fileUrl, file.Name);
            if (ok)
            {
                await CargarConsentimientoOrdenAsync(_ordenSeleccionada.OrdenAtencionId, _ordenSeleccionada.Nhcl);
                _mensajeAlerta = $"Documento firmado '{file.Name}' subido y vinculado correctamente.";
            }
            else
            {
                _esError = true;
                _mensajeAlerta = "No se pudo vincular el archivo firmado en la base de datos.";
            }
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al subir documento firmado: {ex.Message}";
        }
        finally
        {
            _procesandoConsentimiento = false;
        }
    }

    private async Task GuardarIngresoAsync()
    {
        if (_ordenSeleccionada is null || IngresoOcupado || _falloCargaIngreso) return;

        _mensajeAlerta = null;
        _esError = false;

        if (_ordenSeleccionada.RequiereHospitalizacion)
        {
            var tieneJaula = _ingreso.IdJaula is > 0 || !string.IsNullOrWhiteSpace(_ingreso.UbicacionJaula);
            if (!tieneJaula)
            {
                _esError = true;
                _mensajeAlerta = "Debes seleccionar una jaula o especificar la ubicación del paciente antes de guardar.";
                return;
            }
        }

        foreach (var doc in DocumentosIngresoVisibles)
        {
            if (doc.Autorizacion is null || string.IsNullOrWhiteSpace(doc.Autorizacion.ArchivoUrl))
            {
                _esError = true;
                _mensajeAlerta = $"Debes subir el documento firmado (PDF o imagen) de '{doc.Titulo}' antes de guardar.";
                return;
            }
        }

        _guardando = true;
        try
        {
            if (_ingreso.IdJaula is > 0)
            {
                var jaulaElegida = _jaulas.FirstOrDefault(j => j.Id == _ingreso.IdJaula.Value);
                if (jaulaElegida != null && string.IsNullOrWhiteSpace(_ingreso.UbicacionJaula))
                {
                    _ingreso.UbicacionJaula = jaulaElegida.Codigo;
                }
            }

            var pacienteNombre = _ordenSeleccionada.Paciente;
            var ordenId = _ordenSeleccionada.OrdenAtencionId;

            await HospService.GuardarIngresoHospitalizacionAsync(_ingreso, Session.IdUser);
            await Task.WhenAll(CargarColaAsync(), CargarJaulasAsync());

            await CerrarPanelIngresoAsync();
            _mensajeAlerta = $"Ingreso guardado para {pacienteNombre} (Orden #{ordenId}).";
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al guardar ingreso: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }

    private static string ClaseTipoAtencion(OrdenHospitalizacionColaDto item) => (item.RequiereCirugia, item.RequiereHospitalizacion) switch
    {
        (true, true) => "text-bg-primary",
        (true, false) => "text-bg-warning",
        (false, true) => "text-bg-info",
        _ => "text-bg-secondary"
    };

    private static string InicialPaciente(string nombre) =>
        string.IsNullOrWhiteSpace(nombre) ? "P" : nombre.Trim()[0].ToString().ToUpperInvariant();

    private string ObtenerFotoPaciente(int nhcl)
    {
        if (nhcl <= 0) return string.Empty;
        var directorio = Path.Combine(Env.WebRootPath, "PacientesFotos");
        if (!Directory.Exists(directorio)) return string.Empty;
        var archivo = Directory.EnumerateFiles(directorio, $"{nhcl}.*").FirstOrDefault();
        return archivo is null ? string.Empty : SessionControl.FirmarFotoUrl(nhcl, File.GetLastWriteTimeUtc(archivo).Ticks);
    }
}
