@page "/kardex/ordenes"
@inject IHospitalizacionService HospService
@inject IGestionMigradaService GestionService
@inject SessionStateService Session
@inject IWebHostEnvironment Env
@inject SessionControlService SessionControl

<PageTitle>e-ForVets - Bandeja de Órdenes de Hospitalización</PageTitle>

<div class="container-fluid py-3 hosp-bandeja-page">
    <div class="card shadow-sm border-0 mb-3 bg-white">
        <div class="card-body py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 text-primary"><i class="bi bi-hospital-fill"></i></span>
                <div>
                    <h1 class="h5 mb-0 fw-bold text-dark">Bandeja de Órdenes — Hospitalización 24h</h1>
                    <small class="text-muted">Pacientes derivados desde SOAP para hospitalización. Inicia su ingreso, asigna ubicación/jaula e indicaciones.</small>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-outline-secondary" href="/dashboard"><i class="bi bi-house-door-fill me-1"></i>Panel Principal</a>
                @if (Permisos.Permite("/hospitalizacion/ficha"))
                {
                    <a class="btn btn-sm btn-outline-primary" href="/hospitalizacion/ficha"><i class="bi bi-file-earmark-text me-1"></i>Ficha 24h</a>
                }
            </div>
        </div>
    </div>

    <section class="card shadow-sm border-0 mb-3" aria-label="Cola de órdenes para hospitalización">
        <div class="card-header bg-white d-flex flex-wrap gap-2 justify-content-between align-items-center py-2">
            <div class="d-flex align-items-center gap-2">
                <h2 class="h6 mb-0 fw-bold">Cola de hospitalización</h2>
                <span class="badge text-bg-secondary">@_ordenes.Count</span>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="input-group input-group-sm" style="width: 280px;">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input class="form-control" autocomplete="off" @bind="_filtro" @bind:event="oninput" @bind:after="BuscarMientrasEscribeAsync" placeholder="Buscar paciente, tutor, orden o NHCL..." />
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CargarColaAsync" disabled="@_cargando">
                    <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            @if (_cargando)
            {
                <div class="p-3 text-muted small d-flex align-items-center gap-2" role="status">
                    <span class="spinner-border spinner-border-sm"></span> Cargando órdenes derivadas a hospitalización...
                </div>
            }
            else if (_ordenes.Count == 0)
            {
                <div class="p-4 text-center text-muted small">
                    No hay pacientes marcados para hospitalización desde SOAP en este momento.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Fecha / Hora</th>
                                <th scope="col">Orden</th>
                                <th scope="col">Paciente</th>
                                <th scope="col">Especie</th>
                                <th scope="col">Tutor</th>
                                <th scope="col">Médico / Especialidad</th>
                                <th scope="col">Ubicación / Jaula</th>
                                <th scope="col">Estado</th>
                                <th scope="col" class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _ordenes)
                            {
                                var seleccionado = _ordenSeleccionada?.OrdenAtencionId == item.OrdenAtencionId;
                                <tr class="@(seleccionado ? "table-primary" : null)">
                                    <td class="small text-nowrap">
                                        @item.FechaOrden.ToString("dd/MM/yyyy")<br />
                                        <span class="text-muted">@item.FechaOrden.ToString("HH:mm")</span>
                                    </td>
                                    <td class="fw-semibold text-primary">#@item.OrdenAtencionId</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="hosp-avatar">
                                                @if (!string.IsNullOrEmpty(ObtenerFotoPaciente(item.Nhcl)))
                                                {
                                                    <img src="@ObtenerFotoPaciente(item.Nhcl)" alt="Foto de @item.Paciente" />
                                                }
                                                else
                                                {
                                                    <b>@InicialPaciente(item.Paciente)</b>
                                                }
                                            </span>
                                            <div>
                                                <div class="fw-semibold">@item.Paciente</div>
                                                <small class="text-muted">NHCL #@item.Nhcl · @item.Sexo</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="small">@item.Especie</td>
                                    <td class="small">@item.Cliente</td>
                                    <td class="small">
                                        <div>@item.Medico</div>
                                        <span class="text-muted">@item.Especialidad</span>
                                    </td>
                                    <td class="small">
                                        @if (!string.IsNullOrWhiteSpace(item.JaulaCodigo))
                                        {
                                            <span class="badge text-bg-info">@item.JaulaCodigo</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin asignar</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.YaIngresado)
                                        {
                                            <span class="badge text-bg-success">Hospitalizado</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-warning">Pendiente de ingreso</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <button type="button"
                                                class="btn btn-sm @(item.YaIngresado ? "btn-outline-primary" : "btn-primary")"
                                                @onclick="() => SeleccionarParaIngresoAsync(item)">
                                            @(item.YaIngresado ? "Editar ingreso" : "Iniciar hospitalización")
                                        </button>
                                        @if (item.YaIngresado)
                                        {
                                            @if (Permisos.Permite("/hospitalizacion/ficha"))
                                            {
                                                <a class="btn btn-sm btn-outline-secondary ms-1" href="/hospitalizacion/ficha/@item.OrdenAtencionId/@item.Nhcl">Ficha 24h</a>
                                            }
                                            @if (Permisos.Permite("/kardex/enfermeria"))
                                            {
                                                <a class="btn btn-sm btn-outline-secondary ms-1" href="/kardex/enfermeria?orden=@item.OrdenAtencionId&nhcl=@item.Nhcl">Kardex</a>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_mensajeAlerta))
    {
        <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small shadow-sm" role="alert">
            <i class="bi @(_esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@_mensajeAlerta
            <button type="button" class="btn-close py-2" @onclick="() => _mensajeAlerta = null"></button>
        </div>
    }

    @if (_cargandoIngreso)
    {
        <div class="card shadow-sm border-0 py-5 text-center text-primary">
            <div class="card-body">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                <span class="small fw-semibold">Cargando ficha de ingreso a hospitalización...</span>
            </div>
        </div>
    }
    else if (_ordenSeleccionada is null)
    {
        <div class="card shadow-sm border-0 py-5 text-center text-muted">
            <div class="card-body">
                <span class="fs-1 d-block mb-2 text-secondary">🐾</span>
                <h5>Ningún paciente seleccionado para hospitalización</h5>
                <p class="small text-muted mb-0">
                    Selecciona una orden en la cola superior y haz clic en <strong>Iniciar hospitalización</strong>.
                </p>
            </div>
        </div>
    }
    else
    {
        <section class="card shadow-sm border-0" aria-label="Ingreso a hospitalización">
            <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
                <div>
                    <h3 class="h6 mb-0 fw-bold text-primary">
                        <i class="bi bi-hospital me-1"></i>Ingreso a Hospitalización — @_ordenSeleccionada.Paciente
                    </h3>
                    <small class="text-muted">
                        Orden #@_ordenSeleccionada.OrdenAtencionId · NHCL #@_ordenSeleccionada.Nhcl · @_ordenSeleccionada.Especie · Tutor: @_ordenSeleccionada.Cliente · Médico: @_ordenSeleccionada.Medico
                    </small>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CerrarPanelIngreso">Cerrar</button>
            </div>

            <form class="card-body" @onsubmit="GuardarIngresoAsync" @onsubmit:preventDefault>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="selJaula">Ubicación / Jaula</label>
                        <select id="selJaula" class="form-select form-select-sm" @bind="_ingreso.IdJaula">
                            <option value="">-- Seleccionar jaula --</option>
                            @foreach (var jaula in JaulasParaSeleccion)
                            {
                                var etiqueta = string.IsNullOrWhiteSpace(jaula.Piso)
                                    ? jaula.Codigo
                                    : $"{jaula.Codigo} ({jaula.Piso} / {jaula.Consultorio})";
                                <option value="@jaula.Id">@etiqueta @(jaula.Ocupada && jaula.OrdenActual != _ordenSeleccionada.OrdenAtencionId ? "— Ocupada" : "")</option>
                            }
                        </select>
                        @if (_jaulas.Count == 0)
                        {
                            <small class="text-muted d-block mt-1">
                                No hay jaulas registradas aún; cuando se cree el módulo de jaulas aparecerán aquí automáticamente.
                            </small>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="txtUbicacionManual">Detalle / Referencia de ubicación (opcional)</label>
                        <input id="txtUbicacionManual" class="form-control form-control-sm" @bind="_ingreso.UbicacionJaula"
                               placeholder="Ej. Área Caninos, Jaula J-01, Cuidados intensivos..." maxlength="150" />
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold" for="txtIndicaciones">Indicaciones de hospitalización</label>
                        <textarea id="txtIndicaciones" class="form-control form-control-sm" rows="3" @bind="_ingreso.Indicaciones"
                                  placeholder="Medicación inicial, frecuencia de controles, monitoreo requerido, alertas clínicas..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="txtHidratacion">Hidratación / Fluidoterapia</label>
                        <textarea id="txtHidratacion" class="form-control form-control-sm" rows="3" @bind="_ingreso.HidratacionFluidoterapia"
                                  placeholder="Solución, vía, velocidad de infusión (mL/h), suplementos..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="txtDieta">Dieta y cuidados</label>
                        <textarea id="txtDieta" class="form-control form-control-sm" rows="3" @bind="_ingreso.DietaCuidados"
                                  placeholder="Tipo de alimento, frecuencia, ayuno, cuidados de confort/aseo..."></textarea>
                    </div>

                    <div class="col-12">
                        <div class="border rounded p-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h4 class="h6 mb-1 fw-bold text-dark"><i class="bi bi-file-earmark-check me-1"></i>Consentimiento de hospitalización</h4>
                                    <p class="small text-muted mb-0">Espacio reservado para vincular el consentimiento de hospitalización en el siguiente paso.</p>
                                </div>
                                <span class="badge text-bg-secondary">Pendiente de vincular</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-3 border-top">
                    <div class="d-flex flex-wrap gap-2">
                        @if (_ordenSeleccionada.YaIngresado)
                        {
                            @if (Permisos.Permite("/hospitalizacion/ficha"))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="/hospitalizacion/ficha/@_ordenSeleccionada.OrdenAtencionId/@_ordenSeleccionada.Nhcl">Ir a Ficha 24h</a>
                            }
                            @if (Permisos.Permite("/kardex/enfermeria"))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="/kardex/enfermeria?orden=@_ordenSeleccionada.OrdenAtencionId&nhcl=@_ordenSeleccionada.Nhcl">Ir a Kardex</a>
                            }
                            @if (Permisos.Permite("/kardex/signos"))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="/kardex/signos/@_ordenSeleccionada.OrdenAtencionId/@_ordenSeleccionada.Nhcl">Ir a Signos</a>
                            }
                        }
                    </div>
                    <button type="submit" class="btn btn-primary" disabled="@_guardando">
                        @if (_guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-1"></i>
                            <span>@(_ordenSeleccionada.YaIngresado ? "Actualizar ingreso" : "Guardar e iniciar hospitalización")</span>
                        }
                    </button>
                </div>
            </form>
        </section>
    }
</div>

<style>
    .hosp-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e9f2ff;
        color: #1d5fb8;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex: 0 0 32px;
        font-size: 12px;
    }

    .hosp-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);

    private List<OrdenHospitalizacionColaDto> _ordenes = [];
    private List<JaulaClinicaDto> _jaulas = [];
    private OrdenHospitalizacionColaDto? _ordenSeleccionada;
    private IngresoHospitalizacionDto _ingreso = new();

    private string _filtro = string.Empty;
    private bool _cargando;
    private bool _cargandoIngreso;
    private bool _guardando;
    private string? _mensajeAlerta;
    private bool _esError;
    private int _versionBusqueda;

    private IEnumerable<JaulaClinicaDto> JaulasParaSeleccion => _jaulas
        .Where(j => !j.Ocupada || j.OrdenActual == _ordenSeleccionada?.OrdenAtencionId || j.Id == _ingreso.IdJaula);

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarColaAsync(), CargarJaulasAsync());
    }

    private async Task CargarJaulasAsync()
    {
        try
        {
            _jaulas = await GestionService.ObtenerJaulasAsync(soloActivas: true, idLocalidad: Session.Localidad > 0 ? Session.Localidad : null);
        }
        catch
        {
            _jaulas = [];
        }
    }

    private async Task CargarColaAsync()
    {
        _cargando = true;
        try
        {
            _ordenes = await HospService.ObtenerColaHospitalizacionAsync(_filtro, Session.Localidad > 0 ? Session.Localidad : null);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task BuscarMientrasEscribeAsync()
    {
        var version = ++_versionBusqueda;
        await Task.Delay(250);
        if (version != _versionBusqueda) return;
        await CargarColaAsync();
    }

    private async Task SeleccionarParaIngresoAsync(OrdenHospitalizacionColaDto item)
    {
        _mensajeAlerta = null;
        _esError = false;
        _ordenSeleccionada = item;
        _cargandoIngreso = true;
        try
        {
            await CargarJaulasAsync();
            _ingreso = await HospService.ObtenerIngresoHospitalizacionAsync(item.OrdenAtencionId, item.Nhcl);
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"No se pudo cargar el ingreso: {ex.Message}";
        }
        finally
        {
            _cargandoIngreso = false;
        }
    }

    private void CerrarPanelIngreso()
    {
        _ordenSeleccionada = null;
        _ingreso = new();
    }

    private async Task GuardarIngresoAsync()
    {
        if (_ordenSeleccionada is null) return;

        _mensajeAlerta = null;
        _esError = false;
        _guardando = true;
        try
        {
            if (_ingreso.IdJaula is > 0)
            {
                var jaulaElegida = _jaulas.FirstOrDefault(j => j.Id == _ingreso.IdJaula.Value);
                if (jaulaElegida != null && string.IsNullOrWhiteSpace(_ingreso.UbicacionJaula))
                {
                    _ingreso.UbicacionJaula = jaulaElegida.Codigo;
                }
            }

            await HospService.GuardarIngresoHospitalizacionAsync(_ingreso, Session.IdUser);
            await Task.WhenAll(CargarColaAsync(), CargarJaulasAsync());

            var actualizada = _ordenes.FirstOrDefault(o => o.OrdenAtencionId == _ordenSeleccionada.OrdenAtencionId);
            if (actualizada != null)
            {
                _ordenSeleccionada = actualizada;
            }
            else
            {
                _ordenSeleccionada.YaIngresado = true;
            }

            _mensajeAlerta = $"Hospitalización iniciada/actualizada para {_ordenSeleccionada.Paciente} (Orden #{_ordenSeleccionada.OrdenAtencionId}).";
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensajeAlerta = $"Error al guardar ingreso: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }

    private static string InicialPaciente(string nombre) =>
        string.IsNullOrWhiteSpace(nombre) ? "P" : nombre.Trim()[0].ToString().ToUpperInvariant();

    private string ObtenerFotoPaciente(int nhcl)
    {
        if (nhcl <= 0) return string.Empty;
        var directorio = Path.Combine(Env.WebRootPath, "PacientesFotos");
        if (!Directory.Exists(directorio)) return string.Empty;
        var archivo = Directory.EnumerateFiles(directorio, $"{nhcl}.*").FirstOrDefault();
        return archivo is null ? string.Empty : SessionControl.FirmarFotoUrl(nhcl, File.GetLastWriteTimeUtc(archivo).Ticks);
    }
}
