@page "/dashboard"
@using Microsoft.EntityFrameworkCore
@inject IKardexService KardexService
@inject IAdmisionFacturacionService AdmisionService
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<Simetric.Data.AppDbContext> DbFactory
@inject Simetric.Services.EmisorCertificadoValidator FirmaValidator

@inject ILogger<Home> Logger

<PageTitle>e-ForVets - Panel Principal</PageTitle>

<div class="vet-dashboard" aria-busy="@_cargando">
    <div class="dashboard-top">
        <section class="dashboard-hero">
            <i class="bi bi-heart-pulse hero-decoration" aria-hidden="true"></i>
            <div class="hero-copy">
                <span>Bienvenido/a</span>
                <h1>Panel Principal <strong>e-ForVets</strong></h1>
                <p>Gestiona de forma integral la atención, hospitalización, quirófano, inventario y facturación veterinaria.</p>
            </div>
        </section>

        <section class="dashboard-panel shortcuts">
            <header class="panel-heading">
                <h2><i class="bi bi-rocket-takeoff-fill" aria-hidden="true"></i> Accesos Rápidos</h2>
                <button class="panel-link" type="button" @onclick="() => _personalizando = !_personalizando" aria-expanded="@_personalizando.ToString().ToLowerInvariant()">
                    <i class="bi bi-gear" aria-hidden="true"></i> Personalizar
                </button>
            </header>
            @if (_personalizando)
            {
                <div class="shortcut-settings">
                    @foreach (var acceso in Accesos.Where(a => Puede(a.Ruta)))
                    {
                        <label><input type="checkbox" checked="@(!_accesosOcultos.Contains(acceso.Ruta))" @onchange="() => AlternarAccesoAsync(acceso.Ruta)" /> @acceso.Nombre</label>
                    }
                </div>
            }
            <div class="shortcut-grid">
                @foreach (var acceso in Accesos.Where(a => Puede(a.Ruta) && !_accesosOcultos.Contains(a.Ruta)))
                {
                    <a class="shortcut" href="@acceso.Ruta">
                        <i class="bi @acceso.Icono" aria-hidden="true"></i><span>@acceso.Nombre</span>
                    </a>
                }
            </div>
        </section>
    </div>

    @if (_cargando)
    {
        <span class="visually-hidden" role="status">Cargando indicadores del panel</span>
    }
    @if (_mensajeAccesoRapido.Length > 0)
    {
        <div class="alert alert-warning mb-0" role="status">@_mensajeAccesoRapido</div>
    }

    <div class="dashboard-metrics">
        @foreach (var indicador in Indicadores.Where(i => Puede(i.Ruta)))
        {
            <a class="dashboard-panel metric @indicador.Color" href="@indicador.Ruta">
                <i class="bi @indicador.Icono metric-icon" aria-hidden="true"></i>
                <span><b>@indicador.Nombre</b><strong>@(_cargando ? "…" : indicador.Valor)</strong></span>
            </a>
        }
        @if (Puede("facturacion/configuracion/firma"))
        {
            <a class="dashboard-panel metric signature orange" href="/facturacion/configuracion/firma" title="@_firmaError">
                <i class="bi bi-pen-fill metric-icon" aria-hidden="true"></i>
                <span><b>Vigencia de Firma</b><strong>@(_cargando ? "…" : _firmaResumen)</strong>
                    @if (_firmaExpiracion is DateTime fecha)
                    {
                        <small>Hasta @fecha.ToString("dd/MM/yyyy")</small>
                    }
                </span>
                <i class="bi bi-chevron-right ms-auto" aria-hidden="true"></i>
            </a>
        }
    </div>

    <div class="dashboard-middle">
        @if (Puede("kardex/ordenes"))
        {
            <section class="dashboard-panel">
                <header class="panel-heading">
                    <h2><i class="bi bi-activity" aria-hidden="true"></i> Atenciones por Área</h2>
                    <select class="period-select" aria-label="Período de atenciones" @bind="_periodo">
                        <option value="7">Últimos 7 días</option>
                        <option value="14">Últimos 14 días</option>
                        <option value="30">Últimos 30 días</option>
                    </select>
                </header>
                @{
                    var desde = _hoy.AddDays(1 - _periodo);
                    var atenciones = _atenciones.Where(a => a.Fecha >= desde).ToList();
                    var grupos = Areas.Select((area, index) => (area.Nombre, area.Color, Total: atenciones.Where(a => a.Area == index).Sum(a => a.Total))).ToList();
                    var total = grupos.Sum(g => g.Total);
                    var dias = Enumerable.Range(0, _periodo).Select(n => desde.AddDays(n))
                        .Select(fecha => (Fecha: fecha, Total: atenciones.Where(a => a.Fecha == fecha).Sum(a => a.Total))).ToList();
                    var paso = Math.Max(1, (int)Math.Ceiling(dias.Max(d => d.Total) / 4d));
                    var porcentaje = 0d;
                    var segmentos = new List<string>();
                    foreach (var grupo in grupos)
                    {
                        var siguiente = porcentaje + (total == 0 ? 0 : 100d * grupo.Total / total);
                        segmentos.Add($"{grupo.Color} {CssNumero(porcentaje)}% {CssNumero(siguiente)}%");
                        porcentaje = siguiente;
                    }
                    var fondo = total == 0 ? "#e1edf9" : $"conic-gradient({string.Join(", ", segmentos)})";
                }
                @if (_errorAtenciones)
                {
                    <p class="dashboard-empty">No se pudieron consultar las atenciones.</p>
                }
                else
                {
                    <div class="chart-layout">
                        <div class="chart-summary">
                            <div class="chart-donut" style="--donut:@fondo">
                                <div><strong>@total</strong><span>Atenciones<br />totales</span></div>
                            </div>
                            <ul class="chart-legend">
                                @foreach (var grupo in grupos)
                                {
                                    <li><i style="background:@grupo.Color"></i><span>@grupo.Nombre</span><b>@(total == 0 ? "0%" : ((double)grupo.Total / total).ToString("P0"))</b></li>
                                }
                            </ul>
                        </div>
                        <div class="chart-series">
                            <div class="chart-scale" aria-hidden="true">
                                @for (var nivel = 4; nivel >= 0; nivel--)
                                {
                                    <span>@(nivel * paso)</span>
                                }
                            </div>
                            <div class="chart-columns" style="--columns:@_periodo">
                                @foreach (var dia in dias)
                                {
                                    <div class="chart-column" title="@($"{dia.Fecha:dd/MM/yyyy}: {dia.Total} atenciones")">
                                        <div class="chart-bar" style="--height:@CssNumero(100d * dia.Total / (4 * paso))%"></div>
                                        @if (_periodo == 7)
                                        {
                                            <span>@dia.Fecha.ToString("ddd", Ecuador).TrimEnd('.')</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </section>
        }
        @if (Puede("admision/citas"))
        {
            <section class="dashboard-panel">
                <header class="panel-heading">
                    <h2><i class="bi bi-calendar3" aria-hidden="true"></i> Agenda de Hoy</h2>
                    <a class="panel-link" href="/admision/citas">Ver agenda completa <i class="bi bi-arrow-right"></i></a>
                </header>
                <div class="agenda-list">
                    @foreach (var cita in _citasHoy.Take(3))
                    {
                        var (estado, tono) = EstadoCita(cita.CiEstadoCita);
                        <div class="agenda-row @tono">
                            <time>@cita.CiHora</time>
                            <span class="pet-icon"><i class="bi bi-heart-fill" aria-hidden="true"></i></span>
                            <span class="agenda-patient"><b>@cita.CiNombreMas</b><small>Prop. @cita.CiNombre</small></span>
                            <span class="dashboard-pill blue"><i class="bi bi-heart-pulse"></i> @ServicioCita(cita)</span>
                            <span class="dashboard-pill @tono">@estado</span>
                        </div>
                    }
                    @if (_citasHoy.Count == 0 && !_cargando)
                    {
                        <p class="dashboard-empty">No hay citas agendadas para hoy.</p>
                    }
                </div>
            </section>
        }
    </div>

    <div class="dashboard-bottom">
        @if (Puede("kardex/ordenes"))
        {
            <section class="dashboard-panel">
                <header class="panel-heading">
                    <h2><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i> Órdenes Recientes en Atención</h2>
                    <a class="panel-link" href="/kardex/ordenes">Ver todas las órdenes <i class="bi bi-arrow-right"></i></a>
                </header>
                @if (_pacientesRecientes.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="dashboard-table">
                            <thead><tr><th>N.º Orden</th><th>Paciente</th><th>Especie / Sexo</th><th>Propietario</th><th>Servicio</th><th>Estado</th><th><span class="visually-hidden">Ver orden</span></th></tr></thead>
                            <tbody>
                                @foreach (var paciente in _pacientesRecientes.Take(3))
                                {
                                    <tr>
                                        <td><b>@paciente.OrdenAtencionId</b></td>
                                        <td><span class="table-patient"><span class="pet-icon"><i class="bi bi-heart-fill"></i></span><b>@paciente.Paciente</b></span></td>
                                        <td>@paciente.Especie / @paciente.Sexo</td>
                                        <td>@paciente.Cliente</td>
                                        <td>@(string.IsNullOrWhiteSpace(paciente.Especialidad) ? paciente.Etapa : paciente.Especialidad)</td>
                                        <td><span class="dashboard-pill @(paciente.Estado == "E" ? "green" : "purple")">@EstadoOrden(paciente)</span></td>
                                        <td><a class="order-link" href="@UrlOrden(paciente)" aria-label="@($"Ver orden {paciente.OrdenAtencionId}")"><i class="bi bi-eye"></i></a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (!_cargando)
                {
                    <p class="dashboard-empty">No hay órdenes activas registradas.</p>
                }
            </section>
        }

        @if (PuedeAlguno("contabilidad/inventarios", "admision/citas") || _notificacionesClinicas.Habilitado)
        {
            <section class="dashboard-panel">
                <header class="panel-heading">
                    <h2>
                        <i class="bi bi-bell-fill alert-bell" aria-hidden="true"></i> Recordatorios y Alertas
                        @if (_notificacionesClinicas.Items.Count > 0)
                        {
                            <span class="dashboard-notif-count @(_notificacionesClinicas.Items.Any(n => n.EsEmergencia) ? "emergency" : "")">
                                @_notificacionesClinicas.Items.Count nueva(s)
                            </span>
                        }
                    </h2>
                </header>
                <div class="reminder-list">
                    @foreach (var notif in _notificacionesClinicas.Items.Take(5))
                    {
                        var tonoNotif = notif.EsEmergencia ? "red notif-emergency-card" : (notif.Tipo == "CITA" ? "orange" : "blue");
                        var iconoNotif = notif.EsEmergencia ? "bi-exclamation-triangle-fill" : (notif.Tipo == "CITA" ? "bi-calendar2-check-fill" : "bi-clipboard2-pulse-fill");
                        <a class="reminder @tonoNotif" href="@notif.RutaDestino">
                            <i class="bi @iconoNotif reminder-icon" aria-hidden="true"></i>
                            <span>
                                <b>
                                    @notif.Titulo
                                    @if (notif.EsEmergencia)
                                    {
                                        <span class="dashboard-emergency-tag">EMERGENCIA</span>
                                    }
                                </b>
                                <small>@notif.Paciente @(!string.IsNullOrWhiteSpace(notif.Detalle) ? $"· {notif.Detalle}" : "")</small>
                            </span>
                            <i class="bi bi-chevron-right ms-auto" aria-hidden="true"></i>
                        </a>
                    }
                    @foreach (var aviso in Alertas.Where(a => Puede(a.Ruta)))
                    {
                        <a class="reminder @aviso.Color" href="@aviso.Ruta">
                            <i class="bi @aviso.Icono reminder-icon" aria-hidden="true"></i>
                            <span><b>@aviso.Nombre</b><small>@aviso.Detalle</small></span>
                            <i class="bi bi-chevron-right ms-auto" aria-hidden="true"></i>
                        </a>
                    }
                </div>
            </section>
        }
    </div>

    @if (TieneAccesosDirectos || TieneModulosAdicionales)
    {
        <details class="dashboard-panel extra-modules">
            <summary>Más módulos y acceso por orden</summary>
            @if (TieneAccesosDirectos)
            {
                <section class="direct-access" aria-labelledby="direct-access-title">
                    <h2 id="direct-access-title"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Acceso por orden</h2>
                    <div class="direct-access-controls">
                        <label>N.º de orden <input type="number" class="form-control" @bind="_ordenManual" /></label>
                        <label>NHCL de la mascota <input type="number" class="form-control" @bind="_nhclManual" /></label>
                        <div class="direct-access-buttons">
                            @foreach (var accion in AccionesPorOrden.Where(a => Puede(a.Ruta)))
                            {
                                <button type="button" class="btn @accion.Modulo" @onclick="() => IrModuloManual(accion.Modulo)">
                                    <i class="bi @accion.Icono" aria-hidden="true"></i> @accion.Nombre
                                </button>
                            }
                        </div>
                    </div>
                </section>
            }

<!-- Módulos del Sistema (Estilo vt_principal / Tarjetas Modernas) -->
<h5 class="fw-bold text-dark mb-3">Módulos y Servicios del Sistema</h5>
<div class="row g-3 mb-4">
    <!-- Módulo 1: Admisión y Recepción -->
    @if (PuedeAlguno("/admision/clientes-pacientes", "/admision/ordenes", "/admision/citas"))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card module-card h-100">
                <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-people module-icon" aria-hidden="true"></i>
                        <div>
                            <h6 class="module-title">Admisión y Recepción</h6>
                            <small class="text-muted">Gestión de pacientes y citas</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-3">
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                        @if (Puede("/admision/clientes-pacientes"))
                        {
                            <li>
                                <a href="/admision/clientes-pacientes" class="module-link">
                                    <span>Registro de Clientes y Pacientes</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @if (Puede("/admision/ordenes"))
                        {
                            <li>
                                <a href="/admision/ordenes" class="module-link">
                                    <span>Recepción y Nuevas Órdenes</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @if (Puede("/admision/citas"))
                        {
                            <li>
                                <a href="/admision/citas" class="module-link">
                                    <span>Agenda y Programación de Citas</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- Módulo 2: Núcleo Kardex de Enfermería -->
    @if (PuedeAlguno("/kardex/ordenes", "/kardex/enfermeria", "/kardex/signos"))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card module-card h-100">
                <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-journal-medical module-icon" aria-hidden="true"></i>
                        <div>
                            <h6 class="module-title">Kardex y Enfermería</h6>
                            <small class="text-muted">Administración de fármacos y signos</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-3">
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                        @if (Puede("/kardex/ordenes"))
                        {
                            <li>
                                <a href="/kardex/ordenes" class="module-link">
                                    <span>Bandeja de Órdenes Clínicas</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @if (Puede("/kardex/enfermeria"))
                        {
                            <li>
                                <a href="/kardex/enfermeria" class="module-link">
                                    <span>Sábana de Kardex (5 Días)</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @if (Puede("/kardex/signos"))
                        {
                            <li>
                                <a href="/kardex/signos" class="module-link">
                                    <span>Signos Vitales y Balance Hídrico</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- Módulo 3: Hospitalización 24 Horas -->
    @if (PuedeAlguno("/hospitalizacion/ficha", "/hospitalizacion/monitoreo"))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card module-card h-100">
                <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-hospital module-icon" aria-hidden="true"></i>
                        <div>
                            <h6 class="module-title">Hospitalización 24h</h6>
                            <small class="text-muted">Seguimiento y cuidados críticos</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-3">
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                        @if (Puede("/hospitalizacion/ficha"))
                        {
                            <li>
                                <a href="/hospitalizacion/ficha" class="module-link">
                                    <span>Ficha de Hospitalización 24 Horas</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @if (Puede("/hospitalizacion/monitoreo"))
                        {
                            <li>
                                <a href="/hospitalizacion/monitoreo" class="module-link">
                                    <span>Monitoreo Clínico de Pacientes</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- Módulo 4: Quirófano y Anestesiología -->
    @if (PuedeAlguno("/quirofano/preanestesia", "/quirofano/anestesia", "/quirofano/protocolo", "/quirofano/recuperacion"))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card module-card h-100">
                <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-scissors module-icon" aria-hidden="true"></i>
                        <div>
                            <h6 class="module-title">Quirófano y Anestesia</h6>
                            <small class="text-muted">Cirugía y cuidados anestésicos</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-3">
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                        @if (Puede("/quirofano/preanestesia"))
                        {
                            <li>
                                <a href="/quirofano/preanestesia" class="module-link">
                                    <span>Pre-Anestesia y Evaluación ASA</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @if (Puede("/quirofano/anestesia"))
                        {
                            <li>
                                <a href="/quirofano/anestesia" class="module-link">
                                    <span>Hoja de Anestesia Transoperatoria</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @if (Puede("/quirofano/protocolo"))
                        {
                            <li>
                                <a href="/quirofano/protocolo" class="module-link">
                                    <span>Protocolo y Reporte Quirúrgico</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @if (Puede("/quirofano/recuperacion"))
                        {
                            <li>
                                <a href="/quirofano/recuperacion" class="module-link">
                                    <span>Sala de Recuperación Post-Quirúrgica</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- Módulo 5: Consulta Externa y Recetario -->
    @if (PuedeAlguno("/consulta/fichamedica", "/consulta/evoluciones", "/consulta/recetario", "/consulta/autorizaciones"))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card module-card h-100">
                <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-clipboard2-pulse module-icon" aria-hidden="true"></i>
                        <div>
                            <h6 class="module-title">Atención Médica SOAP</h6>
                            <small class="text-muted">Historia clínica y prescripción</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-3">
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2 small">
                        @if (Puede("/consulta/fichamedica"))
                        {
                            <li>
                                <a href="/consulta/fichamedica" class="module-link">
                                    <span>Historia Clínica SOAP</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @if (Puede("/consulta/evoluciones"))
                        {
                            <li>
                                <a href="/consulta/evoluciones" class="module-link">
                                    <span>Notas de Evolución Médica</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @if (Puede("/consulta/recetario"))
                        {
                            <li>
                                <a href="/consulta/recetario" class="module-link">
                                    <span>Recetario Médico Electrónico</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                        @if (Puede("/consulta/autorizaciones"))
                        {
                            <li>
                                <a href="/consulta/autorizaciones" class="module-link">
                                    <span>Consentimientos y Plan de Alta</span>
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- Módulo 6: Diagnóstico y Facturación -->
    @if (PuedeAlguno("/diagnostico/laboratorio", "/diagnostico/imagenologia", "/diagnostico/bandeja", "/facturacion/proformas"))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card module-card h-100">
                <div class="card-header bg-white border-bottom-0 pt-3 pb-0">
                    <div class="d-flex align-items-center gap-2">
