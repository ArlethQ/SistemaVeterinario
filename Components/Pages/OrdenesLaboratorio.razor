@page "/diagnostico/laboratorio"
@page "/diagnostico/laboratorio/{IdOrden:int}/{Nhcl:int}"
@inject ILaboratorioImagenService LabService
@inject IConsultaExternaService ConsultaService
@inject IKardexService KardexService
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>e-ForVets - Órdenes y Despacho de Laboratorio Clínico</PageTitle>

<div class="container-fluid py-3">
    <!-- Encabezado y Acciones -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm border-start border-4 border-primary">
        <div>
            <h4 class="mb-0 text-primary fw-bold">
                <i class="bi bi-eyedropper me-2"></i>Órdenes y Despacho de Laboratorio Clínico (16 Áreas)
            </h4>
            <small class="text-muted">Solicitud y procesamiento de pruebas de laboratorio clínico por especialidad diagnóstica.</small>
        </div>
        <div class="d-flex gap-2 align-items-center mt-2 mt-md-0">
            <select class="form-select form-select-sm" style="width: 280px;" value="@IdOrden" @onchange="SeleccionarOrdenActivaAsync">
                <option value="0">-- Seleccionar paciente / orden --</option>
                @foreach (var orden in OrdenesActivas)
                {
                    <option value="@orden.IdOrdenAtencion">#@orden.IdOrdenAtencion | @orden.Paciente (NHCL @orden.Nhcl)</option>
                }
            </select>
            <div class="input-group input-group-sm" style="width: 260px;">
                <span class="input-group-text bg-light fw-semibold">Orden / NHCL</span>
                <input type="number" class="form-control" placeholder="Orden" @bind="IdOrdenInput" />
                <input type="number" class="form-control" placeholder="NHCL" @bind="NhclInput" />
                <button class="btn btn-primary" @onclick="CargarPorInputAsync">
                    <i class="bi bi-search"></i>
                </button>
            </div>
            <button class="btn btn-sm btn-success" @onclick="GuardarCambiosOrdenAsync" disabled="@(!OrdenesActuales.Any())">
                <i class="bi bi-floppy-fill me-1"></i>Guardar y Procesar Orden
            </button>
            <button class="btn btn-sm btn-danger" @onclick="ExportarPdfAsync" disabled="@(!OrdenesActuales.Any())">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>Pedido PDF + QR
            </button>
            <button class="btn btn-sm btn-outline-dark" @onclick='() => Nav.NavigateTo($"/diagnostico/bandeja/{IdOrden}/{Nhcl}")'>
                <i class="bi bi-inbox-fill me-1"></i>Bandeja Resultados
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(MensajeAlerta))
    {
        <div class="alert @(EsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2">
            <i class="bi @(EsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@MensajeAlerta
            <button type="button" class="btn-close py-2" @onclick="() => MensajeAlerta = null"></button>
        </div>
    }

    @if (CargandoInicial)
    {
        <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="fw-semibold small">Cargando catálogo y órdenes de laboratorio clínico...</span>
        </div>
    }

    @if (Paciente != null)
    {
        <div class="card shadow-sm border-0 mb-3 bg-primary bg-opacity-10">
            <div class="card-body py-2 px-3 small">
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <strong>Paciente:</strong> @Paciente.PacienteNombre (@Paciente.Especie - @Paciente.Raza - @Paciente.Sexo)
                        <span class="badge bg-dark ms-1">NHCL #@Paciente.Nhcl</span>
                    </div>
                    <div class="col-md-4">
                        <strong>Propietario:</strong> @Paciente.PropietarioNombre (C.I.: @Paciente.ClienteCedula)
                    </div>
                    <div class="col-md-4 text-md-end">
                        <strong>Médico Solicitante:</strong> @Paciente.MedicoResponsable | <strong>Orden:</strong> #@IdOrden
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-3">
        <!-- Columna Izquierda: Selector de los 16 Grupos de Laboratorio y Catálogo -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-grid-3x3-gap-fill me-1"></i>Catálogo por Áreas de Laboratorio Clínico</span>
                    <span class="badge bg-primary">@CatalogoPruebas.Count pruebas</span>
                </div>
                <div class="card-body">
                    <!-- Botonera de los 16 Grupos Oficiales (Reemplaza rbt_hemato .. rbt_drogas) -->
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        @foreach (var g in GruposLaboratorio)
                        {
                            <button type="button"
                                    class="btn btn-xs @(GrupoSeleccionado == g.GrupoId ? "btn-primary fw-bold" : "btn-outline-secondary") py-1 px-2"
                                    style="font-size: 0.75rem;"
                                    @onclick="() => SeleccionarGrupoAsync(g.GrupoId)">
                                @g.NombreGrupo
                            </button>
                        }
                    </div>

                    <!-- Buscador por texto -->
                    <div class="input-group input-group-sm mb-2">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Filtrar prueba por nombre o código..."
                               @bind="FiltroTexto" @bind:event="oninput" @bind:after="CargarCatalogoAsync" />
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-8">
                            <input type="text" class="form-control form-control-sm" @bind="ObservacionMuestraDefault"
                                   placeholder="Observación general / Tipo de muestra (ej: Sangre EDTA, Ayuno)..." />
                        </div>
                        <div class="col-md-4">
                            <select class="form-select form-select-sm" @bind="PrioridadDefault">
                                <option value="Rutina">Prioridad: Rutina</option>
                                <option value="Emergente">🚨 Emergente</option>
                            </select>
                        </div>
                    </div>

                    <!-- Lista de Selección Múltiple de Pruebas -->
                    <div class="border rounded p-2 bg-light mb-2" style="max-height: 310px; overflow-y: auto;">
                        @if (!CatalogoPruebas.Any())
                        {
                            <div class="text-center text-muted py-3 small">No se encontraron pruebas en este grupo.</div>
                        }
                        @foreach (var p in CatalogoPruebas)
                        {
                            <div class="form-check py-1 border-bottom d-flex justify-content-between align-items-center small">
                                <div>
                                    <input class="form-check-input me-2" type="checkbox" id="chk_@p.CodigoProd" @bind="p.Seleccionado" />
                                    <label class="form-check-label fw-semibold" for="chk_@p.CodigoProd">
                                        [@p.CodigoProd] @p.Descripcion
                                    </label>
                                </div>
                                <span class="badge bg-white text-dark border">$@p.PrecioUnitario.ToString("N2")</span>
                            </div>
                        }
                    </div>

                    <button class="btn btn-sm btn-primary w-100" @onclick="AgregarPruebasSeleccionadasAsync">
                        <i class="bi bi-plus-circle-fill me-1"></i>Agregar Pruebas Seleccionadas a la Orden (@CatalogoPruebas.Count(x => x.Seleccionado))
                    </button>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Pruebas solicitadas en la orden y facturación -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-list-check me-1"></i>Pruebas de Laboratorio Solicitadas en la Orden #@IdOrden</span>
                    <span class="badge bg-success fs-6">Total Estimado: $@OrdenesActuales.Sum(x => x.Precio * x.Cantidad).ToString("N2")</span>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle small">
                            <thead class="table-light">
                                <tr>
                                    <th>Código</th>
                                    <th>Prueba de Laboratorio</th>
                                    <th style="width: 120px;">Prioridad</th>
                                    <th style="width: 190px;">Observación / Muestra</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-end">Precio</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!OrdenesActuales.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            Seleccione una o más pruebas del catálogo izquierdo para anexarlas a la orden #@IdOrden.
                                        </td>
                                    </tr>
                                }
                                @foreach (var item in OrdenesActuales)
                                {
                                    <tr class="@(item.Prioridad == "Emergente" ? "table-danger" : "")">
                                        <td class="fw-bold">@item.CodigoProd</td>
                                        <td class="fw-semibold">@item.DescripcionExamen</td>
                                        <td>
                                            <select class="form-select form-select-sm py-0" @bind="item.Prioridad">
                                                <option value="Rutina">Rutina</option>
                                                <option value="Emergente">🚨 Emergente</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm py-0" @bind="item.Observaciones" />
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(item.Estado == "REALIZADO" ? "bg-success" : "bg-warning text-dark")">
                                                @item.Estado
                                            </span>
                                        </td>
                                        <td class="text-end fw-semibold">$@item.Precio.ToString("N2")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => EliminarPruebaOrdenAsync(item.Sec)" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (DiagnosticosOrden.Any())
                    {
                        <div class="mt-3 p-2 bg-light rounded border small">
                            <strong class="text-primary d-block mb-1"><i class="bi bi-tags me-1"></i>Diagnósticos CIE-10 vinculados al pedido:</strong>
                            @foreach (var d in DiagnosticosOrden)
                            {
                                <span class="badge bg-secondary me-1">[@d.CodigoDiag] @d.NombreCie10 (@d.TipoDiag)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }

    private int IdOrdenInput { get; set; }
    private int NhclInput { get; set; }
    private int GrupoSeleccionado { get; set; } = 1;
    private string FiltroTexto { get; set; } = string.Empty;
    private string ObservacionMuestraDefault { get; set; } = string.Empty;
    private string PrioridadDefault { get; set; } = "Rutina";
    private bool CargandoInicial { get; set; } = true;
    private string? MensajeAlerta { get; set; }
    private bool EsError { get; set; }

    private PacienteHeaderDto? Paciente { get; set; }
    private List<OrdenActivaResumenDto> OrdenesActivas { get; set; } = new();
    private List<GrupoLaboratorioCatalogoDto> GruposLaboratorio { get; set; } = GrupoLaboratorioCatalogoDto.ObtenerGruposOficiales();
    private List<PruebaCatalogoDto> CatalogoPruebas { get; set; } = new();
    private List<OrdenLaboratorioItemDto> OrdenesActuales { get; set; } = new();
    private List<DiagnosticoCie10Dto> DiagnosticosOrden { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        CargandoInicial = true;
        await Task.Yield();

        OrdenesActivas = await KardexService.ObtenerOrdenesActivasAsync();

        if (IdOrden <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
        {
            IdOrden = Session.OrdenActiva.Value;
            Nhcl = Session.NhclActivo ?? 0;
        }
        else if (IdOrden <= 0)
        {
            if (OrdenesActivas.Count > 0)
            {
                IdOrden = OrdenesActivas[0].IdOrdenAtencion;
                Nhcl = OrdenesActivas[0].Nhcl;
            }
        }

        var tCat = CargarCatalogoAsync();
        if (IdOrden > 0)
        {
            IdOrdenInput = IdOrden;
            NhclInput = Nhcl;
            var tOrd = CargarDatosOrdenAsync();
            await Task.WhenAll(tCat, tOrd);
        }
        else
        {
            await tCat;
        }
        CargandoInicial = false;
    }

    private async Task CargarPorInputAsync()
    {
        if (IdOrdenInput > 0)
        {
            IdOrden = IdOrdenInput;
            Nhcl = NhclInput;
            await CargarDatosOrdenAsync();
        }
    }

    private async Task SeleccionarOrdenActivaAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var idOrden) || idOrden <= 0)
            return;

        var orden = OrdenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == idOrden);
        if (orden == null)
            return;

        CargandoInicial = true;
        IdOrden = orden.IdOrdenAtencion;
        Nhcl = orden.Nhcl;
        IdOrdenInput = IdOrden;
        NhclInput = Nhcl;
        CatalogoPruebas.ForEach(x => x.Seleccionado = false);
        ObservacionMuestraDefault = string.Empty;
        try
        {
            await CargarDatosOrdenAsync();
            EsError = false;
            MensajeAlerta = $"Paciente {orden.Paciente} cargado correctamente.";
        }
        finally
        {
            CargandoInicial = false;
        }
    }

    private async Task SeleccionarGrupoAsync(int grupoId)
    {
        GrupoSeleccionado = grupoId;
        await CargarCatalogoAsync();
    }

    private async Task CargarCatalogoAsync()
    {
        CatalogoPruebas = await LabService.ObtenerCatalogoLaboratorioAsync(GrupoSeleccionado, FiltroTexto, Session.Apostrofe);
    }

    private async Task CargarDatosOrdenAsync()
    {
        Paciente = await KardexService.ObtenerEncabezadoPacienteAsync(IdOrden, Nhcl);
        if (Paciente != null && Nhcl <= 0)
        {
            Nhcl = Paciente.Nhcl;
            NhclInput = Nhcl;
        }
        Session.SeleccionarOrden(IdOrden, Nhcl, Paciente?.PacienteNombre);

        var tOrd = LabService.ObtenerOrdenesLaboratorioAsync(IdOrden, Nhcl);
        var tDiag = ConsultaService.ObtenerDiagnosticosOrdenAsync(IdOrden);
        await Task.WhenAll(tOrd, tDiag);

        OrdenesActuales = await tOrd;
        DiagnosticosOrden = await tDiag;
    }

    private async Task AgregarPruebasSeleccionadasAsync()
    {
        if (IdOrden <= 0)
        {
            EsError = true;
            MensajeAlerta = "Seleccione primero una Orden de Atención válida.";
            return;
        }

        var seleccionadas = CatalogoPruebas.Where(x => x.Seleccionado).ToList();
        if (!seleccionadas.Any()) return;

        foreach (var p in seleccionadas)
        {
            await LabService.AgregarOrdenLaboratorioAsync(new OrdenLaboratorioItemDto
            {
                IdOrden = IdOrden,
                Nhcl = Nhcl,
                CodigoProd = p.CodigoProd,
                DescripcionExamen = p.Descripcion,
                Observaciones = ObservacionMuestraDefault,
                Cantidad = 1,
                Prioridad = PrioridadDefault,
                Estado = "POR REALIZAR",
                Fecha = DateTime.Now,
                Iva = p.GrupoIva,
                IdEfact = p.IdEfact,
                Medida = p.UnidadMedida,
                Precio = p.PrecioUnitario
            });
            p.Seleccionado = false;
        }

        ObservacionMuestraDefault = string.Empty;
        OrdenesActuales = await LabService.ObtenerOrdenesLaboratorioAsync(IdOrden, Nhcl);
        EsError = false;
        MensajeAlerta = $"Se agregaron {seleccionadas.Count} prueba(s) a la Orden #{IdOrden}.";
    }

    private async Task GuardarCambiosOrdenAsync()
    {
        int idUser = Session.CurrentUser?.UserNumero ?? 1;
        await LabService.ActualizarOrdenesLaboratorioAsync(IdOrden, OrdenesActuales, idUser);
        EsError = false;
        MensajeAlerta = $"Orden de Laboratorio #{IdOrden} actualizada y marcada como Procesada.";
    }

    private async Task EliminarPruebaOrdenAsync(int sec)
    {
        await LabService.EliminarOrdenLaboratorioAsync(sec);
        OrdenesActuales = await LabService.ObtenerOrdenesLaboratorioAsync(IdOrden, Nhcl);
    }

    private async Task ExportarPdfAsync()
    {
        var pac = Paciente;
        if (pac is null || pac.Nhcl <= 0)
        {
            EsError = true;
            MensajeAlerta = "No se pudo generar el PDF: faltan los datos reales del paciente.";
            return;
        }
        var pdfBytes = ReportService.GenerarOrdenLaboratorioPdf(pac, OrdenesActuales, DiagnosticosOrden);
        await JS.InvokeVoidAsync("descargarArchivoBase64", $"PedidoLaboratorio_Orden_{IdOrden}.pdf", "application/pdf", Convert.ToBase64String(pdfBytes));
    }
}
