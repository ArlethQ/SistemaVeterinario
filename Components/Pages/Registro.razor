@page "/registro"
@layout Layout.PublicLayout
<PageTitle>Crear cuenta | e-ForVets</PageTitle>
<div class="account-page"><a class="account-brand" href="/"><img src="/favicon.png" alt="" /><strong>e-ForVets</strong></a><section class="account-card">
    <div class="account-heading"><span>Nuevo acceso</span><h1>Crear una cuenta</h1><p>Deja listo tu registro para cuando el servicio de cuentas esté conectado.</p></div>
    @if (!string.IsNullOrEmpty(_mensaje)) { <div class="info-message" role="status">@_mensaje</div> }
    <form @onsubmit="Enviar" @onsubmit:preventDefault>
        <div class="form-grid"><label>Nombre completo<input required autocomplete="name" @bind="_nombre" /></label><label>Correo electrónico<input required type="email" autocomplete="email" @bind="_correo" /></label><label>Contraseña<span class="password-wrap"><input required minlength="8" type="@(_verClave ? "text" : "password")" autocomplete="new-password" @bind="_clave" /><button type="button" @onclick="() => _verClave = !_verClave">@(_verClave ? "Ocultar" : "Mostrar")</button></span></label><label>Confirmar contraseña<span class="password-wrap"><input required minlength="8" type="@(_verConfirmacion ? "text" : "password")" autocomplete="new-password" @bind="_confirmacion" /><button type="button" @onclick="() => _verConfirmacion = !_verConfirmacion">@(_verConfirmacion ? "Ocultar" : "Mostrar")</button></span></label></div>
        <small class="password-help">Usa al menos 8 caracteres. La contraseña y su confirmación deben coincidir.</small>
        <label class="terms"><input type="checkbox" required @bind="_acepta" /> Acepto los términos y la política de privacidad cuando estén disponibles.</label><button class="submit-button" type="submit">Crear cuenta</button>
    </form><p class="account-footer">¿Ya tienes una cuenta? <a href="/login">Iniciar sesión</a></p>
</section></div>
@code { private string _nombre="",_correo="",_clave="",_confirmacion="",_mensaje=""; private bool _verClave,_verConfirmacion,_acepta; private void Enviar(){ _mensaje=_clave!=_confirmacion?"Las contraseñas no coinciden.":"El registro requiere un servicio de servidor que todavía no está configurado. No se creó ninguna cuenta."; } }
