@page "/login"
@layout Layout.PublicLayout
@inject IAuthService AuthService
@inject NavigationManager Nav

<PageTitle>e-ForVets - Iniciar sesión</PageTitle>

<div class="auth-page">
    <a class="back-link" href="/">← Volver al inicio</a>
    <section class="auth-card">
        <div class="auth-welcome">
            <a class="auth-brand" href="/"><img src="/favicon.png" alt="" /><div><strong>e-ForVets</strong><small>Gestión veterinaria</small></div></a>
            <div><span class="auth-kicker">Gestión clínica integral</span><h1>La gestión de tu veterinaria comienza aquí.</h1><p>Accede a la información y módulos habilitados para tu equipo desde un solo lugar.</p></div>
            <div class="welcome-detail"><span>🐾</span><div><strong>Atención coordinada</strong><small>Información segura para decisiones oportunas.</small></div></div>
        </div>
        <div class="auth-form-panel">
            <div class="form-heading"><span>Bienvenido de nuevo</span><h2>Iniciar sesión</h2><p>Ingresa tus credenciales para continuar.</p></div>
            @if (!string.IsNullOrWhiteSpace(_mensajeError)) { <div class="auth-alert">@_mensajeError</div> }
            <form @onsubmit="IngresarAsync" @onsubmit:preventDefault>
                <label>Usuario o correo electrónico<input autocomplete="username" @bind="_username" placeholder="Ingresa tu usuario" /></label>
                <label>Contraseña<span class="password-control"><input type="@(_mostrarClave ? "text" : "password")" autocomplete="current-password" @bind="_password" placeholder="Ingresa tu contraseña" /><button type="button" @onclick="() => _mostrarClave = !_mostrarClave">@(_mostrarClave ? "Ocultar" : "Mostrar")</button></span></label>
                <div class="form-options"><span></span><a href="/olvide-contrasena">¿Olvidaste tu contraseña?</a></div>
                <label>Localidad / Sucursal<select @bind="_localidad"><option value="1">Hospital de Especialidades Veterinarias</option><option value="2">Clínica Equina / Fauna Silvestre</option></select></label>
                <button type="submit" disabled="@_cargando">@(_cargando ? "Validando credenciales..." : "Ingresar")</button>
            </form>
            <p class="register-prompt">¿Aún no tienes una cuenta? <a href="/registro">Regístrate</a></p>
        </div>
    </section>
</div>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private int _localidad = 1;
    private string? _mensajeError;
    private bool _cargando;
    private bool _mostrarClave;
    private async Task IngresarAsync() {
        _mensajeError = null; _cargando = true;
        try { var resultado = await AuthService.LoginAsync(_username, _password, _localidad); if (!resultado.Exito) { _mensajeError = resultado.Mensaje; return; } Nav.NavigateTo("/dashboard"); }
        catch (Exception ex) { _mensajeError = $"Error al conectar con el servidor: {ex.Message}"; }
        finally { _cargando = false; }
    }
}
