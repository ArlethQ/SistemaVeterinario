    };

    private async Task AgregarItemRecetaAsync()
    {
        if (NuevoItem.Cantidad <= 0)
        {
            EsError = true;
            MensajeAlerta = "La cantidad debe ser mayor a cero.";
            return;
        }
        if (string.IsNullOrWhiteSpace(NuevoItem.Descripcionamento) || string.IsNullOrWhiteSpace(NuevoItem.Indicaciones))
        {
            EsError = true;
            MensajeAlerta = "Ingrese el medicamento y sus indicaciones posológicas.";
            return;
        }
        if (string.IsNullOrWhiteSpace(NuevoItem.CodigoProd))
        {
            var exacto = _catalogoEFact.FirstOrDefault(p =>
                string.Equals(p.Descripcion.Trim(), NuevoItem.Descripcionamento.Trim(), StringComparison.OrdinalIgnoreCase));
            if (exacto != null)
            {
                NuevoItem.CodigoProd = exacto.Id.ToString();
            }
        }
        NuevoItem.IdOrden = IdOrden;
        NuevoItem.Nhcl = Nhcl;
        int idUser = Session.CurrentUser?.UserNumero ?? 1;
        var ok = await ConsultaService.AgregarMedicamentoRecetaAsync(NuevoItem, idUser, Session.Localidad);
        if (!ok)
        {
            EsError = true;
            MensajeAlerta = "No se pudo guardar el medicamento en la receta.";
            return;
        }
        NuevoItem = new RecetaMedicamentoItemDto();
        ItemsReceta = await ConsultaService.ObtenerRecetaOrdenAsync(IdOrden);
        EsError = false;
        MensajeAlerta = "Medicamento agregado a la receta.";
    }

    private async Task EliminarItemRecetaAsync(int sec)
    {
        await ConsultaService.EliminarMedicamentoRecetaAsync(sec);
        ItemsReceta = await ConsultaService.ObtenerRecetaOrdenAsync(IdOrden);
    }

    private async Task GuardarIndicacionesGeneralesAsync()
    {
        await ConsultaService.GuardarIndicacionesGeneralesAsync(IdOrden, Nhcl, IndicacionesGenerales);
        MensajeAlerta = "Indicaciones generales de receta actualizadas.";
    }

    private async Task ExportarRecetaPdfAsync()
    {
        var pac = Paciente;
        if (pac is null || pac.Nhcl <= 0)
        {
            EsError = true;
            MensajeAlerta = "No se pudo generar el PDF: faltan los datos reales del paciente.";
            return;
        }
        var indicacionesPdf = EsRecetaHistorica
            ? $"{AvisoRecetaHistorica}\n\n{IndicacionesGenerales}"
            : IndicacionesGenerales;
        var avisosVigentes = _advertencias
            .Where(aviso => aviso.EstaVigente(HoyClinica) && ItemsReceta.Any(aviso.AplicaA))
            .Select(aviso => $"No administrar {aviso.Medicamento}. {aviso.Motivo}");
        indicacionesPdf = string.Join("\n\n", avisosVigentes.Append(indicacionesPdf).Where(texto => !string.IsNullOrWhiteSpace(texto)));
        var pdfBytes = ReportService.GenerarRecetaMedicaPdf(pac, ItemsReceta, DiagnosticosOrden, indicacionesPdf);
        await JS.InvokeVoidAsync("descargarArchivoBase64", $"Receta_e-ForVets_Orden_{IdOrden}.pdf", "application/pdf", Convert.ToBase64String(pdfBytes));
    }
}
