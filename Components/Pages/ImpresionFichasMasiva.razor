@page "/consulta/imprimir-fichas"
@page "/consulta/imprimir-fichas/{NhclParam:int}"
@page "/reportes/imprimir-fichas"
@inject SessionStateService Session
@inject IConsultaExternaService ConsultaService
@inject IKardexService KardexService
@inject IAdmisionFacturacionService AdmisionService
@inject IReportExportService ReportService
@inject IJSRuntime JS
@inject NavigationManager Nav
<PageTitle>Expediente de Fichas Médicas por Mascota | e-ForVets</PageTitle>

@if (_autorizado)
{
    <div class="container-fluid py-3">
        <!-- ENCABEZADO -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <small class="text-primary fw-bold text-uppercase">Expediente Clínico &amp; Reclamo de Seguros</small>
                <h3 class="fw-bold mb-0 text-dark">Expediente de Fichas Médicas por Mascota</h3>
                <small class="text-muted">Elija el animal en el dropbox y filtre por orden o fecha para generar el expediente consolidado en PDF</small>
            </div>
            <div class="d-flex gap-2">
                @if (AtencionesFiltradas.Any(x => x.Seleccionado))
                {
                    <button class="btn btn-danger fw-semibold d-flex align-items-center gap-2 shadow-sm"
                            disabled="@_generandoPdf"
                            @onclick="GenerarExpedienteConsolidadoPdfAsync">
                        @if (_generandoPdf)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Generando PDF...</span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
                            <span>Descargar Expediente Consolidado (@AtencionesFiltradas.Count(x => x.Seleccionado))</span>
                        }
                    </button>
                }
                <a class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" href="/consulta/fichamedica">
                    <i class="bi bi-journal-medical"></i>
                    <span>Ir a Historia SOAP</span>
                </a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_mensaje))
        {
            <div class="alert @(_mensajeEsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small shadow-sm" role="alert">
                <i class="bi @(_mensajeEsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-1"></i>
                @_mensaje
                <button type="button" class="btn-close py-2" @onclick="() => _mensaje = string.Empty"></button>
            </div>
        }

        <!-- SELECTOR UNIFICADO: ANIMAL / ORDEN / FECHA -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-3">
                <div class="row g-3 align-items-end">
                    <!-- 1. Elegir Animal / Mascota -->
                    <div class="col-12 col-md-5">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-heart-pulse-fill text-primary me-1"></i> Animal / Mascota:
                        </label>
                        <select class="form-select fw-semibold" value="@_nhclInput" @onchange="OnMascotaDropdownChangedAsync">
                            <option value="0">-- Seleccione una mascota (@_listaMascotas.Count registradas) --</option>
                            @foreach (var m in _listaMascotas)
                            {
                                <option value="@m.MasNhcl">@m.MasNombre (NHCL: #@m.MasNhcl) · Tutor: @m.ClienteNombre (@m.EspecieDescripcion)</option>
                            }
                        </select>
                    </div>

                    <!-- 2. Filtrar por Orden de la Mascota -->
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-funnel-fill text-primary me-1"></i> Orden de Atención:
                        </label>
                        <select class="form-select fw-semibold @(_ordenFiltro > 0 ? "border-primary text-primary bg-primary-subtle" : "")"
                                value="@_ordenFiltro"
                                @onchange="OnOrdenFiltroDropdownChanged"
                                disabled="@(_atenciones.Count == 0)">
                            <option value="0">-- Todas las órdenes de @(_paciente?.PacienteNombre ?? "la mascota") (@_atenciones.Count) --</option>
                            @foreach (var atenc in _atenciones.OrderByDescending(x => x.Fecha))
                            {
                                <option value="@atenc.Orden">Orden #@atenc.Orden · @atenc.Fecha.ToString("dd/MM/yyyy HH:mm") · @(string.IsNullOrWhiteSpace(atenc.Motivo) ? "Sin motivo" : atenc.Motivo)</option>
                            }
                        </select>
                    </div>

                    <!-- 3. Historias por Fecha / Día -->
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-calendar-event text-primary me-1"></i> Historias por Fecha / Día:
                        </label>
                        <div class="input-group">
                            <input type="date" class="form-control" @bind="_filtroFechaEspecifica" />
                            @if (_filtroFechaEspecifica.HasValue)
                            {
                                <button class="btn btn-outline-secondary" @onclick="() => _filtroFechaEspecifica = null" title="Ver todas las fechas">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TARJETA INFORMATIVA DEL ANIMAL SELECCIONADO -->
        @if (_paciente != null)
        {
            <div class="card border-0 shadow-sm mb-3 bg-white border-start border-4 border-primary">
                <div class="card-body py-2 px-3">
                    <div class="row align-items-center g-2">
                        <div class="col-md-5">
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 44px; height: 44px; font-size: 1.1rem;">
                                    @Iniciales(_paciente.PacienteNombre)
                                </div>
                                <div>
                                    <h4 class="mb-0 fw-bold text-dark">@_paciente.PacienteNombre</h4>
                                    <span class="badge bg-primary me-1">@_paciente.Especie</span>
                                    <span class="badge bg-secondary">@_paciente.Raza</span>
                                    <small class="text-muted ms-1">(@_paciente.Sexo · @_paciente.EdadTexto)</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <small class="text-muted d-block">Tutor / Propietario:</small>
                            <span class="fw-semibold text-dark">@_paciente.PropietarioNombre</span>
                            <small class="text-muted ms-1">C.I.: @_paciente.ClienteCedula</small>
                        </div>
                        <div class="col-md-3 text-md-end">
                            <div class="badge bg-dark py-1 px-3 fs-6 shadow-sm">NHCL: #@_paciente.Nhcl</div>
                            @if (_ordenFiltro > 0)
                            {
                                <div class="mt-1">
                                    <span class="badge bg-primary-subtle text-primary border border-primary">
                                        <i class="bi bi-funnel-fill me-1"></i> Filtrada por Orden #@_ordenFiltro
                                    </span>
                                    <button class="btn btn-xs btn-link text-decoration-none py-0 text-muted" @onclick="() => _ordenFiltro = 0" title="Ver todas las órdenes">
                                        (Ver todas)
                                    </button>
                                </div>
                            }
                            else if (_filtroFechaEspecifica.HasValue)
                            {
                                <div class="mt-1">
                                    <span class="badge bg-info-subtle text-dark border">
                                        <i class="bi bi-calendar-date me-1"></i> Día: @_filtroFechaEspecifica.Value.ToString("dd/MM/yyyy")
                                    </span>
                                    <button class="btn btn-xs btn-link text-decoration-none py-0 text-muted" @onclick="() => _filtroFechaEspecifica = null">
                                        (Ver todas)
                                    </button>
                                </div>
                            }
                            else
                            {
                                <small class="d-block text-primary fw-bold mt-1">@_atenciones.Count orden(es) registradas en total</small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- TABLA DE ÓRDENES Y ATENCIONES CON BUSCADOR POR PALABRAS CLAVE -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-2">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-dark fs-6">
                            <i class="bi bi-card-checklist text-primary me-1"></i> Órdenes y Atenciones Clínicas de @(_paciente?.PacienteNombre ?? "la Mascota")
                        </span>
                        @if (_ordenFiltro > 0)
                        {
                            <span class="badge bg-primary">Orden #@_ordenFiltro</span>
                            <button class="btn btn-xs btn-outline-secondary py-0 px-2" @onclick="() => _ordenFiltro = 0">
                                <i class="bi bi-arrow-repeat me-1"></i> Ver todas las órdenes (@_atenciones.Count)
                            </button>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">@_atenciones.Count total</span>
                            <span class="badge bg-primary">@AtencionesFiltradas.Count(x => x.Seleccionado) seleccionadas</span>
                        }
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <button class="btn btn-xs btn-outline-secondary py-1 px-2 small" @onclick="ToggleSeleccionarTodas">
                            <i class="bi bi-check2-all me-1"></i>
                            @(AtencionesFiltradas.Any() && AtencionesFiltradas.All(x => x.Seleccionado) ? "Deseleccionar todas" : "Seleccionar todas")
                        </button>
                        @if (AtencionesFiltradas.Any(x => x.Seleccionado))
                        {
                            <button class="btn btn-sm btn-danger py-1 px-3 fw-semibold shadow-sm"
                                    disabled="@_generandoPdf"
                                    @onclick="GenerarExpedienteConsolidadoPdfAsync">
                                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Descargar Expediente Consolidado (@AtencionesFiltradas.Count(x => x.Seleccionado))
                            </button>
                        }
                    </div>
                </div>

                <!-- BUSCADOR POR PALABRAS CLAVE Y FILTROS RÁPIDOS -->
                @if (_atenciones.Count > 0)
                {
                    <div class="p-2 bg-light rounded border border-light-subtle">
                        <div class="row g-2 align-items-center">
                            <!-- Búsqueda unificada por palabras clave -->
                            <div class="col-12 col-md-8">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white"><i class="bi bi-search text-secondary"></i></span>
                                    <input class="form-control"
                                           placeholder="Buscar por palabras clave: N° orden (#55419), motivo, diagnóstico, médico o fecha..."
                                           @bind="_filtroTextoAtenciones"
                                           @bind:event="oninput" />
                                    @if (!string.IsNullOrWhiteSpace(_filtroTextoAtenciones))
                                    {
                                        <button class="btn btn-outline-secondary" @onclick="() => _filtroTextoAtenciones = string.Empty">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Botones rápidos de fecha -->
                            <div class="col-12 col-md-4 text-md-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button class="btn btn-outline-secondary py-1 px-2 @(EsFiltroTodas ? "active fw-bold" : "")" @onclick="FiltroRangoTodas">Todas</button>
                                    <button class="btn btn-outline-secondary py-1 px-2 @(EsFiltroHoy ? "active fw-bold" : "")" @onclick="FiltroRangoHoy">Hoy</button>
                                    <button class="btn btn-outline-secondary py-1 px-2 @(EsFiltroEsteMes ? "active fw-bold" : "")" @onclick="FiltroRangoEsteMes">Este mes</button>
                                    <button class="btn btn-outline-secondary py-1 px-2 @(EsFiltroEsteAnio ? "active fw-bold" : "")" @onclick="FiltroRangoEsteAnio">Este año</button>
                                    @if (TieneFiltrosActivos || _ordenFiltro > 0 || _filtroFechaEspecifica.HasValue)
                                    {
                                        <button class="btn btn-outline-danger py-1 px-2" title="Restablecer todos los filtros" @onclick="LimpiarTodosLosFiltros">
                                            <i class="bi bi-x-circle"></i> Limpiar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th style="width: 40px;" class="text-center">
                                <input type="checkbox" class="form-check-input"
                                       checked="@(AtencionesFiltradas.Any() && AtencionesFiltradas.All(x => x.Seleccionado))"
                                       @onchange="OnMasterCheckboxChanged" title="Seleccionar/Deseleccionar órdenes visibles" />
                            </th>
                            <th style="width: 130px;">Fecha / Hora</th>
                            <th style="width: 85px;" class="text-center">Orden</th>
                            <th style="width: 180px;">Médico / Especialidad</th>
                            <th style="min-width: 200px;">Motivo de Consulta</th>
                            <th style="min-width: 220px;">Diagnósticos CIE-10</th>
                            <th style="width: 140px;" class="text-center">Constantes</th>
                            <th style="width: 130px;" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_cargando)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    <span>Cargando órdenes y fichas médicas del paciente...</span>
                                </td>
                            </tr>
                        }
                        else if (_atenciones.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                    <span>No se encontraron atenciones registradas para el animal consultado.</span>
                                </td>
                            </tr>
                        }
                        else if (!AtencionesFiltradas.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-funnel fs-3 d-block mb-1 text-secondary"></i>
                                    <span>No hay órdenes que coincidan con los filtros aplicados.</span>
                                    <button class="btn btn-sm btn-link" @onclick="LimpiarTodosLosFiltros">Ver todas las órdenes de la mascota</button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in AtencionesFiltradas)
                            {
                                <tr class="@(item.Seleccionado ? "table-active" : "")">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input"
                                               @bind="item.Seleccionado" />
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.Fecha.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@item.Fecha.ToString("HH:mm")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(_ordenFiltro == item.Orden ? "bg-primary" : "bg-secondary") fw-bold">#@item.Orden</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(item.Medico) ? "Médico Tratante" : item.Medico)</div>
                                        <small class="text-muted">@(string.IsNullOrWhiteSpace(item.Especialidad) ? "Consulta General" : item.Especialidad)</small>
                                    </td>
                                    <td>
                                        <span class="text-dark">@item.Motivo</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Diagnosticos))
                                        {
                                            <span class="small text-secondary">
                                                <i class="bi bi-tag-fill text-primary me-1"></i>@item.Diagnosticos
                                            </span>
                                        }
                                        else
                                        {
                                            <small class="text-muted fst-italic">Sin diagnóstico codificado</small>
                                        }
                                    </td>
                                    <td class="text-center small">
                                        @if (item.Peso.HasValue && item.Peso > 0)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@item.Peso kg</span>
                                        }
                                        @if (item.Temperatura.HasValue && item.Temperatura > 0)
                                        {
                                            <span class="badge bg-light text-dark border">@item.Temperatura °C</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-xs btn-outline-danger py-1 px-2 me-1"
                                                title="Descargar Ficha Médica Individual (PDF)"
                                                @onclick="() => DescargarFichaIndividualPdfAsync(item)">
                                            <i class="bi bi-file-earmark-pdf"></i> PDF
                                        </button>
                                        <a class="btn btn-xs btn-outline-primary py-1 px-2"
                                           title="Ver y editar en Historia Clínica SOAP"
                                           href="/consulta/fichamedica/@item.Orden/@item.Nhcl">
                                           <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (_atenciones.Count > 0)
            {
                <div class="card-footer bg-light d-flex flex-wrap justify-content-between align-items-center py-2 gap-2">
                    <small class="text-muted">
                        Mostrando <strong>@AtencionesFiltradas.Count()</strong> de <strong>@_atenciones.Count</strong> órdenes registradas bajo <strong>@(_paciente?.PacienteNombre ?? "el animal")</strong>.
                        @if (_ordenFiltro > 0)
                        {
                            <span class="text-primary fw-bold ms-1">(Filtrado a la Orden #@_ordenFiltro)</span>
                        }
                        @if (_filtroFechaEspecifica.HasValue)
                        {
                            <span class="text-primary fw-bold ms-1">(Fecha: @_filtroFechaEspecifica.Value.ToString("dd/MM/yyyy"))</span>
                        }
                    </small>
                    @if (AtencionesFiltradas.Any(x => x.Seleccionado))
                    {
                        <button class="btn btn-sm btn-danger fw-semibold shadow-sm"
                                disabled="@_generandoPdf"
                                @onclick="GenerarExpedienteConsolidadoPdfAsync">
                            <i class="bi bi-file-earmark-pdf-fill me-1"></i>
                            Exportar @AtencionesFiltradas.Count(x => x.Seleccionado) Orden(es) en Expediente Consolidado (PDF)
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int NhclParam { get; set; }

    private bool _autorizado;
    private bool _cargando;
    private bool _generandoPdf;
    private string _mensaje = string.Empty;
    private bool _mensajeEsError;

    private int _ordenFiltro;
    private int? _nhclInput;
    private DateTime? _filtroFechaEspecifica;

    // Filtros sobre la tabla de órdenes de la mascota
    private string _filtroTextoAtenciones = string.Empty;
    private DateTime? _filtroFechaDesde;
    private DateTime? _filtroFechaHasta;

    private PacienteHeaderDto? _paciente;
    private List<PacienteMascotaDto> _listaMascotas = [];
    private List<FichaMedicaResumenLoteDto> _atenciones = [];

    private IEnumerable<FichaMedicaResumenLoteDto> AtencionesFiltradas
    {
        get
        {
            var query = _atenciones.AsEnumerable();

            // 1. Filtro exacto por número de orden (si se eligió una orden en el selector)
            if (_ordenFiltro > 0)
            {
                query = query.Where(x => x.Orden == _ordenFiltro);
            }

            // 2. Filtro por fecha específica del día
            if (_filtroFechaEspecifica.HasValue)
            {
                query = query.Where(x => x.Fecha.Date == _filtroFechaEspecifica.Value.Date);
            }

            // 3. Filtro de texto libre (motivo, médico, diagnóstico, número de orden o fecha en texto)
            if (!string.IsNullOrWhiteSpace(_filtroTextoAtenciones))
            {
                var f = _filtroTextoAtenciones.Trim().ToLowerInvariant();
                query = query.Where(x =>
                    x.Orden.ToString().Contains(f) ||
                    x.Fecha.ToString("dd/MM/yyyy").Contains(f) ||
                    (x.Motivo != null && x.Motivo.ToLowerInvariant().Contains(f)) ||
                    (x.Medico != null && x.Medico.ToLowerInvariant().Contains(f)) ||
                    (x.Diagnosticos != null && x.Diagnosticos.ToLowerInvariant().Contains(f)) ||
                    (x.Especialidad != null && x.Especialidad.ToLowerInvariant().Contains(f)));
            }

            // 4. Filtros de rango de fechas
            if (_filtroFechaDesde.HasValue)
            {
                query = query.Where(x => x.Fecha.Date >= _filtroFechaDesde.Value.Date);
            }

            if (_filtroFechaHasta.HasValue)
            {
                query = query.Where(x => x.Fecha.Date <= _filtroFechaHasta.Value.Date);
            }

            return query;
        }
    }

    private bool TieneFiltrosActivos =>
        !string.IsNullOrWhiteSpace(_filtroTextoAtenciones) || _filtroFechaDesde.HasValue || _filtroFechaHasta.HasValue;

    private bool EsFiltroTodas => !_filtroFechaDesde.HasValue && !_filtroFechaHasta.HasValue && !_filtroFechaEspecifica.HasValue;

    private bool EsFiltroHoy =>
        _filtroFechaEspecifica.HasValue && _filtroFechaEspecifica.Value.Date == DateTime.Today;

    private bool EsFiltroEsteMes =>
        _filtroFechaDesde.HasValue && _filtroFechaDesde.Value == new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private bool EsFiltroEsteAnio =>
        _filtroFechaDesde.HasValue && _filtroFechaDesde.Value == new DateTime(DateTime.Today.Year, 1, 1);

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }
        _autorizado = true;

        try
        {
            _listaMascotas = await AdmisionService.BuscarMascotasAsync(string.Empty);
        }
        catch { }

        int nhclACargar = NhclParam > 0 ? NhclParam : (Session.NhclActivo ?? 0);

        if (nhclACargar <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
        {
            var ordActiva = _listaMascotas.FirstOrDefault(x => x.MasNhcl == Session.NhclActivo);
            if (ordActiva != null) nhclACargar = ordActiva.MasNhcl;
        }
        else if (nhclACargar <= 0 && _listaMascotas.Count > 0)
        {
            nhclACargar = _listaMascotas[0].MasNhcl;
        }

        if (nhclACargar > 0)
        {
            _nhclInput = nhclACargar;
            await ConsultarAtencionesAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (NhclParam > 0 && NhclParam != _nhclInput)
        {
            _nhclInput = NhclParam;
            _ordenFiltro = 0; // Si navega por NHCL, muestra todas sus órdenes
            _filtroFechaEspecifica = null;
            await ConsultarAtencionesAsync();
        }
    }

    private async Task OnMascotaDropdownChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int nhcl) && nhcl > 0)
        {
            _nhclInput = nhcl;
            _ordenFiltro = 0; // Al elegir solo la mascota, muestra TODO
            _filtroFechaEspecifica = null;
            await ConsultarAtencionesAsync();
        }
    }

    private void OnOrdenFiltroDropdownChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int ordenId))
        {
            _ordenFiltro = ordenId;
        }
        else
        {
            _ordenFiltro = 0;
        }
    }

    private async Task ConsultarAtencionesAsync()
    {
        _mensaje = string.Empty;
        _mensajeEsError = false;

        int nhclConsultar = _nhclInput ?? 0;

        if (nhclConsultar <= 0)
        {
            _mensaje = "Por favor seleccione una mascota en el dropbox.";
            _mensajeEsError = true;
            return;
        }

        _cargando = true;
        _nhclInput = nhclConsultar;

        try
        {
            var tPac = KardexService.ObtenerCabeceraPacienteAsync(0, nhclConsultar);
            var tAtenc = ConsultaService.ObtenerAtencionesParaImpresionLoteAsync(nhclConsultar);
            await Task.WhenAll(tPac, tAtenc);

            _paciente = await tPac;
            _atenciones = await tAtenc;

            if (_paciente == null)
            {
                var petLista = _listaMascotas.FirstOrDefault(x => x.MasNhcl == nhclConsultar);
                _paciente = new PacienteHeaderDto
                {
                    Nhcl = nhclConsultar,
                    PacienteNombre = petLista?.MasNombre ?? _atenciones.FirstOrDefault()?.Paciente ?? $"Mascota #{nhclConsultar}",
                    ClienteNombre = petLista?.ClienteNombre ?? _atenciones.FirstOrDefault()?.Cliente ?? "Propietario Registrado",
                    Especie = petLista?.EspecieDescripcion ?? "Canino / Felino",
                    Raza = petLista?.RazaDescripcion ?? "Mestizo",
                    Sexo = petLista?.SexoDescripcion ?? "N/D"
                };
            }

            // Asegura que la mascota esté en el dropdown si no estaba
            if (!_listaMascotas.Any(x => x.MasNhcl == nhclConsultar))
            {
                _listaMascotas.Insert(0, new PacienteMascotaDto
                {
                    MasNhcl = nhclConsultar,
                    MasNombre = _paciente.PacienteNombre,
                    ClienteNombre = _paciente.ClienteNombre,
                    ClienteCedula = _paciente.ClienteCedula,
                    EspecieDescripcion = _paciente.Especie,
                    RazaDescripcion = _paciente.Raza,
                    SexoDescripcion = _paciente.Sexo
                });
            }

            Session.SeleccionarOrden(_paciente.OrdenAtencionId, _paciente.Nhcl, _paciente.PacienteNombre);

            if (_atenciones.Count == 0)
            {
                _mensaje = $"El animal {_paciente.PacienteNombre} (NHCL #{nhclConsultar}) no tiene fichas médicas registradas.";
                _mensajeEsError = false;
            }
        }
        catch (Exception ex)
        {
            _mensaje = $"Error al consultar historial de la mascota: {ex.Message}";
            _mensajeEsError = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private void ToggleSeleccionarTodas()
    {
        bool estadoNuevo = !AtencionesFiltradas.All(x => x.Seleccionado);
        foreach (var item in AtencionesFiltradas)
        {
            item.Seleccionado = estadoNuevo;
        }
    }

    private void OnMasterCheckboxChanged(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        foreach (var item in AtencionesFiltradas)
        {
            item.Seleccionado = isChecked;
        }
    }

