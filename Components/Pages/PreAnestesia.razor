@page "/quirofano/preanestesia"
@page "/quirofano/preanestesia/{IdOrden:int}/{Nhcl:int}"
@implements IDisposable
@inject IKardexService KardexService
@inject IQuirofanoService QuirofanoService
@inject IInventarioService InventarioService
@inject IFarmaciaService FarmaciaService
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Evaluación Pre-Anestésica - e-ForVets</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="mb-0 fw-bold text-primary">Evaluación Pre-Anestésica y Pre-Medicación</h4>
        <small class="text-muted">Valoración de riesgo anestésico ASA, examen físico por sistemas y pre-medicación.</small>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center">
        <!-- Selector Dropbox de Órdenes -->
        <div class="d-flex align-items-center gap-1">
            <label class="small fw-bold text-secondary text-nowrap mb-0">Órdenes:</label>
            <select class="form-select form-select-sm" style="min-width: 280px; max-width: 360px;"
                    value="@IdOrden" @onchange="OnOrdenSelectChangedAsync">
                <option value="0">-- Seleccionar Orden Activa --</option>
                @foreach (var ord in ordenesActivas)
                {
                    <option value="@ord.IdOrdenAtencion">#@ord.IdOrdenAtencion | NHCL:@ord.Nhcl - @ord.Paciente (@ord.Cliente)</option>
                }
            </select>
        </div>

        <!-- Búsqueda Manual por Orden / NHCL con autocomplete -->
        <BuscadorOrdenClinica @bind-Orden="ordenInput" @bind-Nhcl="nhclInput" OnBuscar="CargarPorInputAsync" />

        @if (paciente != null)
        {
            <SaveButton class="btn btn-sm btn-success fw-semibold" OnClick="GuardarPreAnestesiaAsync" Disabled="@guardando">
                @(guardando ? "Guardando..." : "Guardar Evaluación")
            </SaveButton>
            <button class="btn btn-sm btn-danger" @onclick="ExportarPdfAsync">Exportar PDF</button>
            @if (Permisos.Permite("quirofano/anestesia"))
            {
                <a class="btn btn-sm btn-outline-primary" href="/quirofano/anestesia/@IdOrden/@Nhcl">Ir a Hoja Anestesia</a>
            }
            @if (Permisos.Permite("quirofano/protocolo"))
            {
                <a class="btn btn-sm btn-outline-secondary" href="/quirofano/protocolo/@IdOrden/@Nhcl">Protocolo</a>
            }
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small" role="alert">
        @mensajeAlerta
        <button type="button" class="btn-close py-2" @onclick="() => mensajeAlerta = string.Empty"></button>
    </div>
}

@if (cargandoInicial)
{
    <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span class="fw-semibold small">Cargando evaluación pre-anestésica y pre-medicación...</span>
    </div>
}
else
{
    @if (paciente is null)
    {
        <div class="alert alert-info shadow-sm">Vista previa de la evaluación pre-anestésica. Seleccione un paciente para habilitar el formulario.</div>
    }
    <fieldset disabled="@(paciente is null)" class="m-0 p-0 border-0">
    <!-- Cabecera del Paciente -->
    <div class="card shadow-sm border-0 mb-3 bg-primary-subtle">
        <div class="card-body py-2 px-3">
            <div class="row g-2 align-items-center small">
                <div class="col-md-3">
                    <span class="text-muted">Orden / NHCL:</span>
                    <strong class="ms-1 text-primary">#@pacienteVista.OrdenAtencionId / @pacienteVista.Nhcl</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted">Paciente:</span>
                    <strong class="ms-1">@(pacienteVista.PacienteNombre.Length > 0 ? pacienteVista.PacienteNombre : "—")</strong> @(paciente is null ? "" : $"({pacienteVista.Especie} - {pacienteVista.Raza})")
                </div>
                <div class="col-md-3">
                    <span class="text-muted">Edad / Sexo:</span>
                    <strong class="ms-1">@(paciente is null ? "—" : $"{pacienteVista.EdadTexto} / {pacienteVista.Sexo}")</strong>
                </div>
                <div class="col-md-3">
                    <span class="text-muted">Propietario:</span>
                    <strong class="ms-1">@(pacienteVista.PropietarioNombre.Length > 0 ? pacienteVista.PropietarioNombre : "—")</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Columna Izquierda: Clasificación ASA, Sistemas y Regiones -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-white fw-bold text-primary">
                    1. Clasificación de Riesgo Anestésico (ASA) y Estado Clínico
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Clasificación ASA (I a V)</label>
                            <div class="btn-group w-100" role="group">
                                @for (int asa = 1; asa <= 5; asa++)
                                {
                                    int currentAsa = asa;
                                    <button type="button"
                                            class="btn btn-sm @(preDto.Riesgo == currentAsa ? "btn-primary fw-bold" : "btn-outline-primary")"
                                            @onclick="() => preDto.Riesgo = currentAsa">
                                        ASA @currentAsa
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Estado General Pre-Operatorio</label>
                            <div class="d-flex gap-3 pt-1 small">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkBueno"
                                           checked="@(preDto.Ebueno == 1)"
                                           @onchange="e => preDto.Ebueno = (bool)(e.Value ?? false) ? 1 : 0" />
                                    <label class="form-check-label" for="chkBueno">Bueno</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkDeprimido"
                                           checked="@(preDto.Edeprimido == 1)"
                                           @onchange="e => preDto.Edeprimido = (bool)(e.Value ?? false) ? 1 : 0" />
                                    <label class="form-check-label" for="chkDeprimido">Deprimido</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkInsuf"
                                           checked="@(preDto.Einsuficiente == 1)"
                                           @onchange="e => preDto.Einsuficiente = (bool)(e.Value ?? false) ? 1 : 0" />
                                    <label class="form-check-label" for="chkInsuf">Insuficiente</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Grupo Sanguíneo</label>
                            <input type="text" class="form-control form-control-sm" @bind="preDto.GrupoSanguineo" placeholder="Ej: DEA 1.1+ / Tipo A" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Última Ingestión</label>
                            <input type="datetime-local" class="form-control form-control-sm" @bind="preDto.UltimaIngestion" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Anestesiólogo / Firma</label>
                            <input type="text" class="form-control form-control-sm" @bind="preDto.Firma" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold mb-1">Información Especial / Alertas Alérgicas</label>
                            <input type="text" class="form-control form-control-sm" @bind="preDto.InformacionEspecial" placeholder="Alergias, precauciones de vía aérea o hemodinámicas..." />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-white fw-bold text-primary">
                    2. Evaluación por Sistemas y Exámenes Pre-Quirúrgicos
                </div>
                <div class="card-body">
                    <div class="row g-2 small">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold mb-1">Hematológico</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="preDto.Hematologico"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold mb-1">Química Sanguínea</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="preDto.QuimicaSanguinea"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold mb-1">Uroanálisis</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="preDto.Uroanalisis"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold mb-1">Sistema Respiratorio</label>
                            <input type="text" class="form-control form-control-sm" @bind="preDto.SistemaRespiratorio" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold mb-1">Sistema Circulatorio / Cardiovascular</label>
                            <input type="text" class="form-control form-control-sm" @bind="preDto.SistemaCirculatorio" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold mb-1">Sistema Nervioso</label>
                            <input type="text" class="form-control form-control-sm" @bind="preDto.SistemaNervioso" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold mb-1">Otros Sistemas</label>
                            <input type="text" class="form-control form-control-sm" @bind="preDto.SistemasOtros" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold mb-1">Anestesias Anteriores</label>
                            <input type="text" class="form-control form-control-sm" @bind="preDto.AnestesiasAnteriores" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold mb-1">Terapia Farmacológica Previa</label>
                            <input type="text" class="form-control form-control-sm" @bind="preDto.TerapiaAnterior" />
                        </div>
                    </div>

                    <hr class="my-3" />
                    <label class="form-label small fw-bold text-secondary mb-2">Regiones Anatómicas / Bloqueos Regionales Planificados</label>
                    <div class="row g-2 small">
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckCabeza" /> Cabeza</label></div>
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckSentidos" /> Órganos Sentidos</label></div>
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckCuello" /> Cuello</label></div>
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckEndoscopias" /> Endoscopías</label></div>
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckIntratoraxica" /> Intratorácica</label></div>
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckExtratoraxica" /> Extratorácica</label></div>
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckAbdomen" /> Abdomen</label></div>
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckExtremidades" /> Extremidades</label></div>
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckIntradural" /> Intradural</label></div>
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckExtradural" /> Extradural</label></div>
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckObstetricas" /> Obstétricas</label></div>
                        <div class="col-6 col-md-3"><label><input type="checkbox" class="form-check-input me-1" @bind="preDto.CheckPerineales" /> Perineales</label></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Medicación Pre-Anestésica y stock -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="fw-bold text-primary">3. Medicación Pre-Anestésica (Cola de Farmacia · @NombreSedeActiva)</span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary border">@catalogoStockSede.Count en stock</span>
                        <a href="/farmacia" class="btn btn-xs btn-outline-primary py-0 px-2 fw-semibold">Ver Cola Farmacia</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="input-group input-group-sm mb-2">
                        <input type="text" class="form-control" autocomplete="off" placeholder="Buscar por nombre o código..."
                               @bind="filtroProd" @bind:event="oninput" @bind:after="BuscarStockAutoAsync" @onkeydown="OnFiltroProdKeyDown" />
                        @if (!string.IsNullOrWhiteSpace(filtroProd))
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltroStock">×</button>
                        }
                    </div>

                    @if (resultadosStock.Any())
                    {
                        <div class="table-responsive mb-2 border rounded" style="max-height: 185px;">
                            <table class="table table-sm table-hover align-middle mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th>Código</th>
                                        <th>Producto</th>
                                        <th>Stock disponible</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in resultadosStock)
                                    {
                                        <tr>
                                            <td><code>@item.Number</code></td>
                                            <td>
                                                <div class="fw-semibold">@item.DisplayName</div>
                                                <small class="text-muted">@item.Location</small>
                                            </td>
                                            <td>
                                                <span class="fw-bold text-success">@item.Available.ToString("0.##") @UnidadDeItem(item)</span>
                                                @if (item.FactorConversion > 1m)
                                                {
                                                    <div class="text-muted" style="font-size:.72rem;">@FormatearPaquetesStock(item.Available, item.FactorConversion, UnidadDeItem(item))</div>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-xs btn-primary py-0 px-2" @onclick="() => SeleccionarProducto(item)">Elegir</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="row g-2 small bg-light p-2 rounded border mb-3">
                        <div class="col-12">
                            <label class="form-label mb-1 fw-semibold">Producto Seleccionado (en stock en @NombreSedeActiva)</label>
                            <select class="form-select form-select-sm"
                                    value="@(itemSeleccionadoStock?.Id ?? string.Empty)"
                                    @onchange="OnSelectProductoStockChanged">
                                <option value="">-- Seleccione un producto en stock (@ProductosEnStockFiltrados.Count()) --</option>
                                @foreach (var item in ProductosEnStockFiltrados)
                                {
                                    <option value="@item.Id">@item.DisplayName (@item.Number) · Disp: @FormatearResumenStock(item)</option>
                                }
                            </select>
                            @if (catalogoStockSede.Count == 0 && !buscandoStock)
                            {
                                <small class="text-warning-emphasis d-block mt-1">No hay productos con stock disponible en <strong>@NombreSedeActiva</strong>.</small>
                            }
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label mb-1">Cantidad @(FactorSeleccionado > 1m ? "(Paquetes / Unidad)" : $"({UnidadSeleccionada})")</label>
                            <div class="input-group input-group-sm">
                                <input type="number" min="0.01" step="0.01"
                                       class="form-control" @bind="nuevoProd.CantProd" />
                                @if (FactorSeleccionado > 1m)
                                {
                                    <select class="form-select"
                                            style="max-width: 155px;"
                                            value="@(ingresarPorPaquete ? "paquete" : "unidad")"
                                            @onchange='e => ingresarPorPaquete = string.Equals(e.Value?.ToString(), "paquete", StringComparison.Ordinal)'>
                                        <option value="unidad">@UnidadSeleccionada</option>
                                        <option value="paquete">Paq. (×@FactorSeleccionado.ToString("G29") @UnidadSeleccionada)</option>
                                    </select>
                                }
                                else
                                {
                                    <span class="input-group-text">@UnidadSeleccionada</span>
                                }
                            </div>
                            @if (itemSeleccionadoStock is not null)
                            {
                                @if (FactorSeleccionado > 1m && ingresarPorPaquete)
                                {
                                    <small class="text-primary d-block mt-1 fw-semibold">
                                        @nuevoProd.CantProd.ToString("0.##") paq. × @FactorSeleccionado.ToString("G29") @UnidadSeleccionada = @CantidadBaseCalculada.ToString("0.##") @UnidadSeleccionada
                                        <span class="text-muted fw-normal">· Disp: @FormatearResumenStock(itemSeleccionadoStock)</span>
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted d-block mt-1">
                                        Disp: <strong>@FormatearResumenStock(itemSeleccionadoStock)</strong>
                                    </small>
                                }
                            }
                        </div>

                        <div class="col-6">
                            <label class="form-label mb-1">Vía</label>
                            <select class="form-select form-select-sm" @bind="nuevoProd.Via">
                                @foreach (var v in catalogoVias)
                                {
                                    <option value="@v.Via">@v.Via</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label mb-1">Observaciones / Indicaciones</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" @bind="nuevoProd.IndicacionesProd" placeholder="Ej.: administrar 30 min antes de la operación" />
                                <SaveButton class="btn btn-primary" OnClick="AgregarProductoPreAnestesiaAsync">Agregar</SaveButton>
                            </div>
                        </div>
                    </div>

                    <h6 class="small fw-bold text-secondary mb-2">Medicamentos de preanestesia (@listaPremedicacion.Count)</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Fármaco</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-center">Vía</th>
                                    <th>Observaciones / Indicaciones</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!listaPremedicacion.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-3">Sin pre-medicación registrada para esta orden.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var p in listaPremedicacion)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@p.ProdDescripcion</td>
                                            <td class="text-center">@p.CantProd.ToString("N1")</td>
                                            <td class="text-center"><span class="badge bg-info text-dark">@p.Via</span></td>
                                            <td>@p.IndicacionesProd</td>
                                            <td class="text-center">
                                                <button class="btn btn-xs btn-outline-danger py-0 px-1"
                                                        @onclick="() => EliminarProductoAsync(p)">×</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </fieldset>
}

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }

    private int ordenInput;
    private int nhclInput;
    private List<OrdenActivaResumenDto> ordenesActivas = new();
    private PacienteHeaderDto? paciente;
    private PacienteHeaderDto pacienteVista => paciente ?? new();
    private PreAnestesiaDto preDto = new();
    private List<ProductoQuirofanoDto> listaPremedicacion = new();
    private List<ViaAdministracionDto> catalogoVias = new();

    private string filtroProd = string.Empty;
    private bool buscandoStock;
    private List<FarmacoStockDto> catalogoStockSede = new();
    private List<FarmacoStockDto> resultadosStock = new();
    private FarmacoStockDto? itemSeleccionadoStock;
    private bool ingresarPorPaquete;
    private int localidadCargadaStock;
    private ProductoQuirofanoDto nuevoProd = new() { Modulo = "PreAnestesia" };

    private int SedeActivaId => Session.Localidad > 0 ? Session.Localidad : (Session.CurrentUser?.IdLocalidad ?? 1);
    private string NombreSedeActiva => string.IsNullOrWhiteSpace(Session.LocalidadDescripcion) ? "Sede actual" : Session.LocalidadDescripcion;
    private string UnidadSeleccionada => itemSeleccionadoStock is not null ? UnidadDeItem(itemSeleccionadoStock) : "UNIDAD";
    private decimal FactorSeleccionado => itemSeleccionadoStock is { FactorConversion: > 1m } ? itemSeleccionadoStock.FactorConversion : 1m;
    private decimal CantidadBaseCalculada => ingresarPorPaquete && FactorSeleccionado > 1m
        ? Math.Round(nuevoProd.CantProd * FactorSeleccionado, 4)
        : nuevoProd.CantProd;

    private IEnumerable<FarmacoStockDto> ProductosEnStockFiltrados =>
        string.IsNullOrWhiteSpace(filtroProd)
            ? catalogoStockSede
            : catalogoStockSede.Where(x =>
                x.DisplayName.Contains(filtroProd.Trim(), StringComparison.OrdinalIgnoreCase) ||
                x.Number.Contains(filtroProd.Trim(), StringComparison.OrdinalIgnoreCase) ||
                x.Id.Contains(filtroProd.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool cargandoInicial = true;
    private bool guardando;
    private string mensajeAlerta = string.Empty;
    private bool esError;

    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged;
    }

    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        if (localidadCargadaStock != SedeActivaId)
        {
            _ = InvokeAsync(async () =>
            {
                await CargarCatalogoStockSedeAsync();
                StateHasChanged();
            });
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        cargandoInicial = true;
        await Task.Yield();

        var tVias = KardexService.ObtenerViasAdministracionAsync();
        var tOrdenes = KardexService.ObtenerOrdenesActivasAsync();
        var tStock = CargarCatalogoStockSedeAsync();
        await Task.WhenAll(tVias, tOrdenes, tStock);

        catalogoVias = await tVias;
        ordenesActivas = await tOrdenes;

        if (IdOrden <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
        {
            IdOrden = Session.OrdenActiva.Value;
            Nhcl = Session.NhclActivo ?? 0;
        }
        else if (IdOrden <= 0 && ordenesActivas.Count > 0)
        {
            IdOrden = ordenesActivas[0].IdOrdenAtencion;
            Nhcl = ordenesActivas[0].Nhcl;
        }

        if (IdOrden > 0 || Nhcl > 0)
        {
            ordenInput = IdOrden;
            nhclInput = Nhcl;
            await CargarDatosAsync();
        }
        cargandoInicial = false;
    }

    private async Task OnOrdenSelectChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selOrden) && selOrden > 0)
        {
            var ord = ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == selOrden);
            IdOrden = selOrden;
            Nhcl = ord?.Nhcl ?? 0;
            ordenInput = IdOrden;
            nhclInput = Nhcl;
            await CargarDatosAsync();
            Nav.NavigateTo($"/quirofano/preanestesia/{IdOrden}/{Nhcl}", replace: true);
        }
    }

    private async Task CargarPorInputAsync()
    {
        if (ordenInput <= 0 && nhclInput > 0)
        {
            var matchNhcl = ordenesActivas.FirstOrDefault(x => x.Nhcl == nhclInput);
            if (matchNhcl != null) ordenInput = matchNhcl.IdOrdenAtencion;
        }

        if (ordenInput > 0 || nhclInput > 0)
        {
            IdOrden = ordenInput;
            Nhcl = nhclInput;
            var match = ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == IdOrden);
            if (match != null && Nhcl <= 0) Nhcl = match.Nhcl;
            await CargarDatosAsync();
            Nav.NavigateTo($"/quirofano/preanestesia/{IdOrden}/{Nhcl}", replace: true);
        }
    }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CargarPorInputAsync();
        }
    }

    private async Task CargarDatosAsync()
    {
        mensajeAlerta = string.Empty;
        esError = false;
        var p = await KardexService.ObtenerCabeceraPacienteAsync(IdOrden, Nhcl);
        if (p != null)
        {
            Nhcl = p.Nhcl;
            Session.SeleccionarOrden(IdOrden, Nhcl, p.PacienteNombre);
            var tPre = QuirofanoService.ObtenerPreAnestesiaAsync(IdOrden, Nhcl);
            var tProd = QuirofanoService.ObtenerProductosQuirofanoAsync(IdOrden, "PreAnestesia");
            await Task.WhenAll(tPre, tProd);

            preDto = await tPre;
            if (string.IsNullOrWhiteSpace(preDto.Firma))
                preDto.Firma = Session.CurrentUser?.NombreCompleto ?? "Dr. Anestesiólogo";

            listaPremedicacion = await tProd;
            paciente = p;
        }
        else
        {
            paciente = null;
            esError = true;
            mensajeAlerta = $"No se encontró la Orden #{IdOrden}.";
        }
    }

    private async Task GuardarPreAnestesiaAsync()
    {
        if (paciente == null) return;
        guardando = true;
        preDto.Orden = IdOrden;
        preDto.Nhcl = Nhcl;

        var ok = await QuirofanoService.GuardarPreAnestesiaAsync(
            preDto,
            Session.CurrentUser?.IdUsuario ?? 1,
            Session.CurrentUser?.NombreCompleto ?? "Anestesiólogo");

        guardando = false;
        esError = !ok;
        mensajeAlerta = ok
            ? $"Evaluación Pre-Anestésica (ASA {preDto.Riesgo}) guardada exitosamente."
            : "Ocurrió un error al guardar la Evaluación Pre-Anestésica.";
        if (ok && OnGuardado.HasDelegate)
            await OnGuardado.InvokeAsync();
    }

    private async Task CargarCatalogoStockSedeAsync()
    {
        buscandoStock = true;
        localidadCargadaStock = SedeActivaId;
        catalogoStockSede = await InventarioService.BuscarMedicamentosConStockAsync(
            string.Empty,
            SedeActivaId,
            Session.Apostrofe);
        if (itemSeleccionadoStock is not null)
        {
            itemSeleccionadoStock = catalogoStockSede.FirstOrDefault(x => x.Id == itemSeleccionadoStock.Id);
            if (itemSeleccionadoStock is null)
            {
                nuevoProd.CodigoProd = string.Empty;
                nuevoProd.ProdDescripcion = string.Empty;
                ingresarPorPaquete = false;
            }
        }
        buscandoStock = false;
    }

    private static string UnidadDeItem(FarmacoStockDto item) =>
        string.IsNullOrWhiteSpace(item.BaseUnitOfMeasureCode) ? "UNIDAD" : item.BaseUnitOfMeasureCode.Trim().ToUpperInvariant();

    private static string FormatearPaquetesStock(decimal stockBase, decimal factor, string unidad)
    {
        if (factor <= 1m) return string.Empty;
        var paquetes = Math.Round(stockBase / factor, 2, MidpointRounding.AwayFromZero);
        var paqTxt = paquetes == Math.Truncate(paquetes) ? paquetes.ToString("0") : paquetes.ToString("0.##");
        var facTxt = factor == Math.Truncate(factor) ? factor.ToString("0") : factor.ToString("G29");
        return $"{paqTxt} {(paquetes == 1m ? "paquete" : "paquetes")} (×{facTxt} {unidad})";
    }

    private static string FormatearResumenStock(FarmacoStockDto item)
    {
        var unidad = UnidadDeItem(item);
        var baseTxt = $"{item.Available:0.##} {unidad}";
        return item.FactorConversion > 1m
            ? $"{baseTxt} · {FormatearPaquetesStock(item.Available, item.FactorConversion, unidad)}"
            : baseTxt;
    }

    private void LimpiarFiltroStock()
    {
        filtroProd = string.Empty;
        resultadosStock.Clear();
    }

    private void OnSelectProductoStockChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        var item = catalogoStockSede.FirstOrDefault(x => x.Id == id);
        if (item is not null)
        {
            SeleccionarProducto(item);
        }
        else
        {
            itemSeleccionadoStock = null;
            nuevoProd.CodigoProd = string.Empty;
            nuevoProd.ProdDescripcion = string.Empty;
            ingresarPorPaquete = false;
        }
    }

    private async Task OnFiltroProdKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarStockBcAsync();
        }
    }

    private async Task BuscarStockAutoAsync()
    {
        if (string.IsNullOrWhiteSpace(filtroProd))
        {
            resultadosStock.Clear();
            return;
        }
        if (catalogoStockSede.Count == 0 || localidadCargadaStock != SedeActivaId)
            await CargarCatalogoStockSedeAsync();

        resultadosStock = ProductosEnStockFiltrados.Take(30).ToList();
    }

    private async Task BuscarStockBcAsync()
    {
        if (string.IsNullOrWhiteSpace(filtroProd))
        {
            resultadosStock.Clear();
            return;
        }
        await CargarCatalogoStockSedeAsync();
        resultadosStock = ProductosEnStockFiltrados.Take(30).ToList();

        if (resultadosStock.Count == 0)
        {
            esError = false;
            mensajeAlerta = $"No se encontraron productos con stock en {NombreSedeActiva} para '{filtroProd.Trim()}'.";
        }
    }

    private void SeleccionarProducto(FarmacoStockDto item)
    {
        itemSeleccionadoStock = item;
        nuevoProd.CodigoProd = !string.IsNullOrWhiteSpace(item.Number) ? item.Number : item.Id;
        nuevoProd.ProdDescripcion = item.DisplayName;
        nuevoProd.PrecioProd = item.UnitPrice;
        nuevoProd.StockProd = (int)Math.Ceiling(item.Available);
        nuevoProd.MedBodega = item.Location;
        nuevoProd.MedMedida = UnidadDeItem(item);
        nuevoProd.MedIva = item.TaxGroupCode;
        nuevoProd.MedIdDinamics = item.Id;
        ingresarPorPaquete = item.FactorConversion > 1m;
        resultadosStock.Clear();
    }

    private async Task AgregarProductoPreAnestesiaAsync()
    {
        if (itemSeleccionadoStock is null || string.IsNullOrWhiteSpace(nuevoProd.CodigoProd) || string.IsNullOrWhiteSpace(nuevoProd.ProdDescripcion))
        {
            esError = true;
            mensajeAlerta = $"Seleccione un fármaco o insumo con stock disponible en {NombreSedeActiva}.";
            return;
        }

        var cantidadBase = CantidadBaseCalculada;
        var disponibleBase = itemSeleccionadoStock.Available;
        if (cantidadBase <= 0 || (disponibleBase > 0 && cantidadBase > disponibleBase))
        {
            esError = true;
            mensajeAlerta = cantidadBase <= 0
                ? "Ingrese una cantidad mayor que cero."
                : $"La cantidad solicitada ({cantidadBase:0.##} {UnidadSeleccionada}) supera el stock disponible en {NombreSedeActiva} ({FormatearResumenStock(itemSeleccionadoStock)}).";
            return;
        }

        var cantOriginal = nuevoProd.CantProd;
        nuevoProd.CantProd = cantidadBase;
        nuevoProd.StockProd = (int)Math.Ceiling(disponibleBase);
        if (FactorSeleccionado > 1m && ingresarPorPaquete)
        {
            var detallePaq = $"[{cantOriginal:0.##} paq. × {FactorSeleccionado:G29} {UnidadSeleccionada} = {cantidadBase:0.##} {UnidadSeleccionada}]";
            if (string.IsNullOrWhiteSpace(nuevoProd.IndicacionesProd))
                nuevoProd.IndicacionesProd = detallePaq;
            else if (!nuevoProd.IndicacionesProd.Contains(detallePaq, StringComparison.OrdinalIgnoreCase))
                nuevoProd.IndicacionesProd = $"{detallePaq} {nuevoProd.IndicacionesProd.Trim()}";
        }

        nuevoProd.OrdenId = IdOrden;
        nuevoProd.Nhcl = Nhcl;
        nuevoProd.Modulo = "PreAnestesia";
        nuevoProd.Iniciales = Session.CurrentUser?.Iniciales ?? "AN";
        nuevoProd.Funcion = "Anestesiólogo";
        nuevoProd.Funcionario = Session.CurrentUser?.NombreCompleto ?? "Anestesiólogo";

        var ok = await QuirofanoService.AgregarProductoQuirofanoAsync(
            nuevoProd,
            Session.CurrentUser?.IdUsuario ?? 1,
            SedeActivaId,
            "PRE");

        if (ok)
        {
            await FarmaciaService.ReservarStockDirectoAsync(
                itemSeleccionadoStock.Id,
                nuevoProd.CodigoProd,
                cantidadBase,
                SedeActivaId,
                IdOrden,
                Nhcl,
                Session.CurrentUser?.IdUsuario ?? 1,
                "PreAnestesia",
                nuevoProd.MedBodega);

            itemSeleccionadoStock = null;
            ingresarPorPaquete = false;
            filtroProd = string.Empty;
            nuevoProd = new ProductoQuirofanoDto { Modulo = "PreAnestesia", Via = "IV" };
            await CargarCatalogoStockSedeAsync();
            listaPremedicacion = await QuirofanoService.ObtenerProductosQuirofanoAsync(IdOrden, "PreAnestesia");
            esError = false;
            mensajeAlerta = "Pre-medicación enviada a la cola de Farmacia y reservada del stock disponible.";
        }
        else
        {
            esError = true;
            mensajeAlerta = "No se pudo registrar el producto seleccionado.";
        }
    }

    private async Task EliminarProductoAsync(ProductoQuirofanoDto p)
    {
        await FarmaciaService.LiberarStockDirectoAsync(
            p.CodigoProd,
            p.CantProd,
            SedeActivaId,
            IdOrden,
            Session.CurrentUser?.IdUsuario ?? 1,
            "PreAnestesia");
        await QuirofanoService.EliminarProductoQuirofanoAsync(p.Id, p.CodigoProd, IdOrden, "PRE");
        await CargarCatalogoStockSedeAsync();
        listaPremedicacion = await QuirofanoService.ObtenerProductosQuirofanoAsync(IdOrden, "PreAnestesia");
    }

    private async Task ExportarPdfAsync()
    {
        if (paciente == null) return;
        var bytes = ReportService.GenerarPreAnestesiaPdf(paciente, preDto, listaPremedicacion);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"PreAnestesia_Orden_{IdOrden}.pdf", "application/pdf", Convert.ToBase64String(bytes));
    }
}
