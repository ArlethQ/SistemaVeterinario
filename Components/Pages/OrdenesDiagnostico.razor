@page "/diagnostico/laboratorio"
@page "/diagnostico/laboratorio/{IdOrden:int}/{Nhcl:int}"
@page "/diagnostico/imagenologia"
@page "/diagnostico/imagenologia/{IdOrden:int}/{Nhcl:int}"
@inject NavigationManager Navigation

@if (!ModoModal)
{
    <PageTitle>e-ForVets - Órdenes de diagnóstico</PageTitle>
}

<div class="@(ModoModal ? "py-2" : "container-fluid py-3")">
    <nav class="nav diagnostic-tabs mb-3" aria-label="Órdenes de diagnóstico">
        @if (Permisos.Permite("diagnostico/laboratorio"))
        {
            @if (ModoModal)
            {
                <button type="button" class="nav-link @(!EsImagenologia ? "active" : "")"
                        aria-pressed="@(!EsImagenologia)" @onclick="() => _imagenologiaModal = false">
                    <i class="bi bi-eyedropper me-1" aria-hidden="true"></i>Laboratorio
                </button>
            }
            else
            {
                <NavLink class="nav-link" href="diagnostico/laboratorio">
                    <i class="bi bi-eyedropper me-1" aria-hidden="true"></i>Laboratorio
                </NavLink>
            }
        }
        @if (Permisos.Permite("diagnostico/imagenologia"))
        {
            @if (ModoModal)
            {
                <button type="button" class="nav-link @(EsImagenologia ? "active" : "")"
                        aria-pressed="@(EsImagenologia)" @onclick="() => _imagenologiaModal = true">
                    <i class="bi bi-lungs me-1" aria-hidden="true"></i>Rayos X / Ecografía
                </button>
            }
            else
            {
                <NavLink class="nav-link" href="diagnostico/imagenologia">
                    <i class="bi bi-lungs me-1" aria-hidden="true"></i>Rayos X / Ecografía
                </NavLink>
            }
        }
    </nav>

    @if (EsImagenologia && Permisos.Permite("diagnostico/imagenologia"))
    {
        <OrdenesImagenologia IdOrden="IdOrden" Nhcl="Nhcl" />
    }
    else if (!EsImagenologia && Permisos.Permite("diagnostico/laboratorio"))
    {
        <OrdenesLaboratorio IdOrden="IdOrden" Nhcl="Nhcl" />
    }
</div>

@code {
    [CascadingParameter] public PermisosNavegacion Permisos { get; set; } = new(0, []);
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }

    [Parameter] public bool ModoModal { get; set; }

    private bool _imagenologiaModal;
    private bool EsImagenologia => ModoModal
        ? Permisos.Permite("diagnostico/imagenologia") &&
          (_imagenologiaModal || !Permisos.Permite("diagnostico/laboratorio"))
        : Navigation.ToBaseRelativePath(Navigation.Uri)
        .Split('/', '?', '#')
        .ElementAtOrDefault(1)
        ?.Equals("imagenologia", StringComparison.OrdinalIgnoreCase) == true;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        IdOrden = 0;
        Nhcl = 0;
        return base.SetParametersAsync(parameters);
    }
}
