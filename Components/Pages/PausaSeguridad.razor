@page "/quirofano/pausa-seguridad"
@page "/quirofano/pausa-seguridad/{IdOrden:int}/{Nhcl:int}"
@using System.Text.Json
@inject IKardexService KardexService
@inject IQuirofanoService QuirofanoService
@inject SessionStateService Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Pausa de Seguridad Quirúrgica - e-ForVets</PageTitle>

<div class="pausa-view @(ModoModal ? "pausa-embedded" : "")">
    <header class="pausa-hero">
        <div class="pausa-heading">
            <i class="bi bi-shield-check" aria-hidden="true"></i>
            <div>
                <h1>Pausa de seguridad quirúrgica</h1>
                <p>Checklist OMS · Entrada, pausa quirúrgica y salida.</p>
            </div>
        </div>
    </header>

    <div class="pausa-panel pausa-toolbar">
        @if (!ModoModal)
        {
            <div class="pausa-order">
                <select class="form-select form-select-sm" aria-label="Orden activa" value="@IdOrden" @onchange="OnOrdenSelectChangedAsync">
                    <option value="0">-- Seleccionar Orden Activa --</option>
                    @foreach (var ord in ordenesActivas)
                    {
                        <option value="@ord.IdOrdenAtencion">#@ord.IdOrdenAtencion | NHCL:@ord.Nhcl - @ord.Paciente (@ord.Cliente)</option>
                    }
                </select>

                <BuscadorOrdenClinica @bind-Orden="ordenInput" @bind-Nhcl="nhclInput" OnBuscar="CargarPorInputAsync" />
            </div>
        }

        @if (paciente != null)
        {
            <div class="pausa-actions" role="group" aria-label="Acciones de la pausa de seguridad">
                <SaveButton class="app-workflow-action app-workflow-save" OnClick="GuardarPausaAsync" Disabled="@guardando">
                    <i class="bi bi-floppy" aria-hidden="true"></i> @(guardando ? "Guardando..." : "Guardar pausa")
                </SaveButton>
                @if (!ModoModal)
                {
                    @if (Permisos.Permite("quirofano/preanestesia/checklist"))
                    {
                        <a class="app-workflow-action app-workflow-checklist" href="/quirofano/preanestesia/checklist/@IdOrden/@Nhcl"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Checklist preoperatorio</a>
                    }
                    @if (Permisos.Permite("quirofano/anestesia"))
                    {
                        <a class="app-workflow-action app-workflow-anesthesia" href="/quirofano/anestesia/@IdOrden/@Nhcl"><i class="bi bi-activity" aria-hidden="true"></i> Hoja Anestesia</a>
                    }
                    @if (Permisos.Permite("quirofano/protocolo"))
                    {
                        <a class="app-workflow-action app-workflow-protocol" href="/quirofano/protocolo/@IdOrden/@Nhcl"><i class="bi bi-journal-text" aria-hidden="true"></i> Protocolo</a>
                    }
                    @if (Permisos.Permite("quirofano/recuperacion"))
                    {
                        <a class="app-workflow-action app-workflow-recovery" href="/quirofano/recuperacion/@IdOrden/@Nhcl"><i class="bi bi-heart-pulse" aria-hidden="true"></i> Recuperación</a>
                    }
                }
            </div>
        }
    </div>

@if (_borradorRecuperado)
{
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center py-2 px-3 mb-2 small" role="alert">
        <span>📝 <strong>Borrador recuperado automáticamente.</strong> Presiona <strong>Guardar pausa</strong> para confirmarlo en el sistema.</span>
        <button type="button" class="btn btn-sm btn-outline-dark py-0" @onclick="DescartarBorradorAsync">Descartar borrador</button>
    </div>
}

@if (!string.IsNullOrEmpty(mensajeAlerta))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small" role="alert">
        @mensajeAlerta
        <button type="button" class="btn-close py-2" @onclick="() => mensajeAlerta = string.Empty"></button>
    </div>
}

@if (cargandoInicial)
{
    <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span class="fw-semibold small">Cargando verificación de pausa de seguridad quirúrgica...</span>
    </div>
}
else if (paciente != null)
{
    <SelectorCirugiaOperacion Cirugias="_cirugiasOrden"
                              IdCirugiaSeleccionada="_idCirugiaActiva"
                              ModuloClave="pausa"
                              OnCirugiaCambiada="CambiarCirugiaActivaAsync" />

    <section class="pausa-panel pausa-patient" aria-label="Datos del paciente">
        <div>
            <i class="bi bi-clipboard" aria-hidden="true"></i>
            <div><small>Orden / Historia (NHCL)</small><strong>#@paciente.OrdenAtencionId / @paciente.Nhcl</strong></div>
        </div>
        <div>
            <i class="bi bi-heart-pulse" aria-hidden="true"></i>
            <div>
                <small>Paciente / Especie</small>
                <strong class="pausa-name">@paciente.PacienteNombre</strong>
                <span class="pausa-chip">@paciente.Especie</span>
                <small>@paciente.Raza</small>
            </div>
        </div>
        <div>
            <i class="bi bi-gender-ambiguous" aria-hidden="true"></i>
            <div>
                <small>Edad / Sexo</small>
                <strong>@(paciente.FechaNacimiento.HasValue ? paciente.EdadTexto : "Sin registrar") / @paciente.Sexo</strong>
            </div>
        </div>
        <div>
            <i class="bi bi-person" aria-hidden="true"></i>
            <div><small>Propietario</small><strong>@paciente.PropietarioNombre</strong></div>
        </div>
    </section>

    <!-- 3 FASES DE LA PAUSA DE SEGURIDAD (OMS) -->
    <div class="row g-3">
        <!-- FASE 1: ENTRADA (Antes de la inducción) -->
        <div class="col-lg-4">
            <div class="card pausa-panel pausa-step pausa-step-entry h-100">
                <div class="card-header pausa-section">
                    <span class="badge bg-primary mb-1">1. ENTRADA</span>
                    <h2>Antes de la Inducción de Anestesia</h2>
                    <small>Con el enfermero y el anestesista, como mínimo</small>
                </div>
                <div class="card-body small d-flex flex-column gap-3">
                    <div>
                        <label class="form-label mb-1 fw-semibold">1. ¿Ha confirmado la identidad del paciente, sitio quirúrgico, procedimiento y consentimiento?</label>
                        <select class="form-select form-select-sm" @bind="pausaDto.Rpta1" @bind:after="GuardarBorradorAutoAsync">
                            <option value="S">SÍ</option>
                            <option value="N">NO</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label mb-1 fw-semibold">2. ¿Se ha marcado el sitio quirúrgico?</label>
                        <select class="form-select form-select-sm" @bind="pausaDto.Rpta2" @bind:after="GuardarBorradorAutoAsync">
                            <option value="S">SÍ</option>
                            <option value="N">NO PROCEDE</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label mb-1 fw-semibold">3. ¿Se ha completado la comprobación de los aparatos y la medicación anestésica?</label>
                        <select class="form-select form-select-sm" @bind="pausaDto.Rpta3" @bind:after="GuardarBorradorAutoAsync">
                            <option value="S">SÍ</option>
                            <option value="N">NO</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label mb-1 fw-semibold">4. ¿Se ha colocado el pulsioxímetro al paciente y funciona?</label>
                        <select class="form-select form-select-sm" @bind="pausaDto.Rpta4" @bind:after="GuardarBorradorAutoAsync">
                            <option value="S">SÍ</option>
                            <option value="N">NO</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label mb-1 fw-semibold">5. ¿Tiene el paciente alergias conocidas?</label>
                        <select class="form-select form-select-sm" @bind="pausaDto.Rpta5" @bind:after="GuardarBorradorAutoAsync">
                            <option value="N">NO</option>
                            <option value="S">SÍ</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label mb-1 fw-semibold">6. ¿Vía aérea difícil / riesgo de aspiración?</label>
                        <select class="form-select form-select-sm" @bind="pausaDto.Rpta6" @bind:after="GuardarBorradorAutoAsync">
                            <option value="N">NO</option>
                            <option value="S">SÍ (Equipos y ayuda disponible)</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label mb-1 fw-semibold">7. ¿Riesgo de hemorragia > 500 ml (7 ml/kg)?</label>
                        <select class="form-select form-select-sm" @bind="pausaDto.Rpta7" @bind:after="GuardarBorradorAutoAsync">
                            <option value="N">NO</option>
                            <option value="S">SÍ (Líquidos y accesos previstos)</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- FASE 2: PAUSA QUIRÚRGICA (Antes de la incisión) -->
        <div class="col-lg-4">
            <div class="card pausa-panel pausa-step pausa-step-pause h-100">
                <div class="card-header pausa-section">
                    <span class="badge bg-warning text-dark mb-1">2. PAUSA QUIRÚRGICA</span>
                    <h2>Antes de la Incisión Cutánea</h2>
                    <small>Con el enfermero, el anestesista y el cirujano</small>
                </div>
                <div class="card-body small d-flex flex-column gap-2">
                    <div>
                        <label class="form-label mb-1 fw-semibold">8. ¿Todos los miembros se han presentado por nombre y función?</label>
                        <select class="form-select form-select-sm" @bind="pausaDto.Rpta8" @bind:after="GuardarBorradorAutoAsync">
                            <option value="S">SÍ</option>
                            <option value="N">NO</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label mb-1 fw-semibold">9. ¿Confirmar identidad, sitio quirúrgico y procedimiento?</label>
                        <select class="form-select form-select-sm" @bind="pausaDto.Rpta9" @bind:after="GuardarBorradorAutoAsync">
                            <option value="S">SÍ</option>
                            <option value="N">NO</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label mb-1 fw-semibold">10. ¿Profilaxis antibiótica en los últimos 60 minutos?</label>
                        <select class="form-select form-select-sm" @bind="pausaDto.Rpta10" @bind:after="GuardarBorradorAutoAsync">
                            <option value="S">SÍ</option>
                            <option value="N">NO PROCEDE</option>
                        </select>
                    </div>

                    <div class="bg-light p-2 rounded">
                        <strong class="text-primary d-block mb-1">Previsión de Eventos Críticos - Cirujano:</strong>
                        <div class="mb-1">
                            <label class="form-label mb-0">Pasos críticos o imprevistos:</label>
                            <input type="text" class="form-control form-control-sm" @bind="pausaDto.EventosCriticos" @bind:event="oninput" @bind:after="GuardarBorradorAutoAsync" placeholder="Descripción pasos críticos..." />
                        </div>
                        <div class="row g-1">
                            <div class="col-6">
                                <label class="form-label mb-0">Duración estimada:</label>
                                <input type="text" class="form-control form-control-sm" @bind="pausaDto.TiempoOperacion" @bind:event="oninput" @bind:after="GuardarBorradorAutoAsync" placeholder="Ej: 90 min" />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-0">Pérdida sangre:</label>
                                <input type="text" class="form-control form-control-sm" @bind="pausaDto.PerdidaSangre" @bind:event="oninput" @bind:after="GuardarBorradorAutoAsync" placeholder="Ej: 50 ml" />
                            </div>
                        </div>
                    </div>

                    <div class="bg-light p-2 rounded">
                        <strong class="text-primary d-block mb-1">Equipo de Anestesia:</strong>
                        <div class="row g-1 align-items-center">
                            <div class="col-5">
                                <label class="form-label mb-0">¿Problema específico?</label>
                                <select class="form-select form-select-sm" @bind="pausaDto.Rpta14" @bind:after="GuardarBorradorAutoAsync">
                                    <option value="N">NO</option>
                                    <option value="S">SÍ</option>
                                </select>
                            </div>
                            <div class="col-7">
                                <label class="form-label mb-0">Detalle:</label>
                                <input type="text" class="form-control form-control-sm" @bind="pausaDto.ProblemaEspecifico" @bind:event="oninput" @bind:after="GuardarBorradorAutoAsync" placeholder="Detalle problema..." />
                            </div>
                        </div>
                    </div>

                    <div class="bg-light p-2 rounded">
                        <strong class="text-primary d-block mb-1">Equipo de Enfermería:</strong>
                        <div class="mb-1">
                            <label class="form-label mb-0">¿Esterilidad confirmada (indicadores)?</label>
                            <select class="form-select form-select-sm" @bind="pausaDto.Rpta15" @bind:after="GuardarBorradorAutoAsync">
                                <option value="S">SÍ</option>
                                <option value="N">NO</option>
                            </select>
                        </div>
                        <div class="row g-1 align-items-center">
                            <div class="col-5">
                                <label class="form-label mb-0">¿Dudas instrumental?</label>
                                <select class="form-select form-select-sm" @bind="pausaDto.Rpta16" @bind:after="GuardarBorradorAutoAsync">
                                    <option value="N">NO</option>
                                    <option value="S">SÍ</option>
                                </select>
                            </div>
                            <div class="col-7">
                                <label class="form-label mb-0">Detalle dudas:</label>
                                <input type="text" class="form-control form-control-sm" @bind="pausaDto.ProblemasInstrumental" @bind:event="oninput" @bind:after="GuardarBorradorAutoAsync" placeholder="Detalle dudas..." />
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="form-label mb-1 fw-semibold">17. ¿Imágenes diagnósticas esenciales visualizables?</label>
                        <select class="form-select form-select-sm" @bind="pausaDto.Rpta17" @bind:after="GuardarBorradorAutoAsync">
                            <option value="S">SÍ</option>
                            <option value="N">NO PROCEDE</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- FASE 3: SALIDA (Antes de salir de quirófano) -->
        <div class="col-lg-4">
            <div class="card pausa-panel pausa-step pausa-step-exit h-100">
                <div class="card-header pausa-section">
                    <span class="badge bg-success mb-1">3. SALIDA</span>
                    <h2>Antes de Salir de Quirófano</h2>
                    <small>Con el enfermero, el anestesista y el cirujano</small>
                </div>
                <div class="card-body small d-flex flex-column gap-3">
                    <div class="bg-light p-2 rounded">
                        <strong class="text-success d-block mb-2">El enfermero confirma verbalmente:</strong>

                        <div class="mb-2">
                            <label class="form-label mb-1 fw-semibold">18. Nombre del procedimiento realizado:</label>
                            <select class="form-select form-select-sm" @bind="pausaDto.Rpta18" @bind:after="GuardarBorradorAutoAsync">
                                <option value="S">SÍ (Confirmado)</option>
                                <option value="N">NO</option>
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="form-label mb-1 fw-semibold">19. Recuento de instrumentos, gasas y agujas:</label>
                            <select class="form-select form-select-sm" @bind="pausaDto.Rpta19" @bind:after="GuardarBorradorAutoAsync">
                                <option value="S">SÍ (Completo)</option>
                                <option value="N">NO / DISCREPANCIA</option>
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="form-label mb-1 fw-semibold">20. Etiquetado de muestras en voz alta:</label>
                            <select class="form-select form-select-sm" @bind="pausaDto.Rpta20" @bind:after="GuardarBorradorAutoAsync">
                                <option value="S">SÍ (Correcto)</option>
                                <option value="N">NO PROCEDE / NO</option>
                            </select>
                        </div>

                        <div>
                            <label class="form-label mb-1 fw-semibold">21. Problemas de instrumental a resolver:</label>
                            <select class="form-select form-select-sm" @bind="pausaDto.Rpta21" @bind:after="GuardarBorradorAutoAsync">
                                <option value="N">NO</option>
                                <option value="S">SÍ</option>
                            </select>
                        </div>
                    </div>

                    <div class="bg-light p-2 rounded">
                        <strong class="text-success d-block mb-1">Cirujano, Anestesista y Enfermero:</strong>
                        <label class="form-label mb-1 fw-semibold">Aspectos críticos de recuperación y tratamiento:</label>
                        <textarea class="form-control form-control-sm" rows="4" @bind="pausaDto.AspectosRecuperacion" @bind:event="oninput" @bind:after="GuardarBorradorAutoAsync" placeholder="Detalle analgesia post-op, fluidos, monitoreo, posición..."></textarea>
                    </div>

                    <div class="mt-auto d-grid">
                        <SaveButton class="app-workflow-action app-workflow-save" OnClick="GuardarPausaAsync" Disabled="@guardando">
                            <i class="bi bi-floppy" aria-hidden="true"></i> @(guardando ? "Guardando..." : "✓ Registrar Pausa de Seguridad")
                        </SaveButton>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

</div>

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }
    [Parameter] public int IdCirugia { get; set; }
    [Parameter] public bool ModoModal { get; set; }
    [Parameter] public EventCallback OnGuardado { get; set; }
    [Parameter] public EventCallback<int> OnCirugiaCambiada { get; set; }

    private int ordenInput;
    private int nhclInput;
    private List<OrdenActivaResumenDto> ordenesActivas = new();
    private List<CirugiaOperacionResumenDto> _cirugiasOrden = [];
    private int _idCirugiaActiva;
    private PacienteHeaderDto? paciente;
    private PausaSeguridadDto pausaDto = new();

    private bool cargandoInicial = true;
    private bool guardando;
    private bool _borradorRecuperado;
    private bool _borradorPendienteRestaurar;
    private string _jsonInicial = string.Empty;
    private string mensajeAlerta = string.Empty;
    private bool esError;

    private string ClaveBorrador => $"hosvet_draft_pausa_{IdOrden}_{_idCirugiaActiva}";

    protected override async Task OnParametersSetAsync()
    {
        cargandoInicial = true;
        await Task.Yield();

        var cargarOrdenesPrimero = !ModoModal && IdOrden <= 0 && Session.OrdenActiva is not > 0;
        if (cargarOrdenesPrimero)
        {
            ordenesActivas = await KardexService.ObtenerOrdenesActivasAsync();
        }

        if (IdOrden <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
        {
            IdOrden = Session.OrdenActiva.Value;
            Nhcl = Session.NhclActivo ?? 0;
        }
        else if (!ModoModal && IdOrden <= 0 && ordenesActivas.Count > 0)
        {
            IdOrden = ordenesActivas[0].IdOrdenAtencion;
            Nhcl = ordenesActivas[0].Nhcl;
        }

        if (IdOrden > 0)
        {
            ordenInput = IdOrden;
            nhclInput = Nhcl;
            await CargarDatosAsync(navegar: false);
        }
        cargandoInicial = false;

        if (!ModoModal && !cargarOrdenesPrimero)
        {
            StateHasChanged();
            ordenesActivas = await KardexService.ObtenerOrdenesActivasAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_borradorPendienteRestaurar && paciente != null)
        {
            _borradorPendienteRestaurar = false;
            await IntentarRestaurarBorradorAsync();
        }
    }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CargarPorInputAsync();
        }
    }

    private async Task OnOrdenSelectChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selOrden) && selOrden > 0)
        {
            mensajeAlerta = string.Empty;
            esError = false;
            var ord = ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == selOrden);
            IdOrden = selOrden;
            Nhcl = ord?.Nhcl ?? 0;
            ordenInput = IdOrden;
            nhclInput = Nhcl;
            await CargarDatosAsync();
        }
    }

    private async Task CargarPorInputAsync()
    {
        mensajeAlerta = string.Empty;
        esError = false;

        if (ordenInput > 0)
        {
            IdOrden = ordenInput;
            var match = ordenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == IdOrden);
            if (match != null)
            {
                Nhcl = match.Nhcl;
                nhclInput = Nhcl;
            }
        }
        else if (nhclInput > 0)
        {
            Nhcl = nhclInput;
            var match = ordenesActivas.FirstOrDefault(x => x.Nhcl == Nhcl);
            if (match != null)
            {
                IdOrden = match.IdOrdenAtencion;
                ordenInput = IdOrden;
            }
        }
        else if (ordenesActivas.Count > 0)
        {
            IdOrden = ordenesActivas[0].IdOrdenAtencion;
            Nhcl = ordenesActivas[0].Nhcl;
            ordenInput = IdOrden;
            nhclInput = Nhcl;
        }

        if (IdOrden <= 0 && Nhcl <= 0) return;
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync(bool navegar = true)
    {
        var p = await KardexService.ObtenerCabeceraPacienteAsync(IdOrden, Nhcl);
        if (p != null)
        {
            Nhcl = p.Nhcl;
            nhclInput = Nhcl;
            ordenInput = IdOrden;
            Session.SeleccionarOrden(IdOrden, Nhcl, p.PacienteNombre);
            _cirugiasOrden = await QuirofanoService.ObtenerResumenCirugiasOrdenAsync(IdOrden, Nhcl);
            if (IdCirugia > 0 && _cirugiasOrden.Any(c => c.IdCirugia == IdCirugia))
                _idCirugiaActiva = IdCirugia;
            else if (_idCirugiaActiva <= 0 || !_cirugiasOrden.Any(c => c.IdCirugia == _idCirugiaActiva))
                _idCirugiaActiva = _cirugiasOrden.FirstOrDefault()?.IdCirugia ?? 0;

            pausaDto = await QuirofanoService.ObtenerPausaSeguridadAsync(IdOrden, Nhcl, _idCirugiaActiva);
            _jsonInicial = JsonSerializer.Serialize(pausaDto);
            _borradorRecuperado = false;
            _borradorPendienteRestaurar = true;
            paciente = p;
            var ruta = $"/quirofano/pausa-seguridad/{IdOrden}/{Nhcl}";
            if (!ModoModal && navegar && Nav.Uri != Nav.ToAbsoluteUri(ruta).AbsoluteUri)
            {
                Nav.NavigateTo(ruta);
            }
        }
        else
        {
            paciente = null;
            esError = true;
            mensajeAlerta = $"No se encontró la Orden #{IdOrden}.";
        }
    }

    private async Task GuardarBorradorAutoAsync()
    {
        if (IdOrden <= 0 || paciente == null) return;
        try
        {
            var json = JsonSerializer.Serialize(pausaDto);
            if (json == _jsonInicial)
            {
                await JS.InvokeVoidAsync("hosvetDraft.remove", ClaveBorrador);
                return;
            }
            await JS.InvokeVoidAsync("hosvetDraft.save", ClaveBorrador, json);
        }
        catch { }
    }

    private async Task IntentarRestaurarBorradorAsync()
    {
        if (IdOrden <= 0) return;
        try
        {
            var json = await JS.InvokeAsync<string?>("hosvetDraft.load", ClaveBorrador);
            if (string.IsNullOrWhiteSpace(json)) return;
            var borrador = JsonSerializer.Deserialize<PausaSeguridadDto>(json);
            if (borrador == null) return;
            var jsonNormalizado = JsonSerializer.Serialize(borrador);
            if (jsonNormalizado == _jsonInicial)
            {
                await JS.InvokeVoidAsync("hosvetDraft.remove", ClaveBorrador);
                _borradorRecuperado = false;
                return;
            }
            pausaDto = borrador;
            _borradorRecuperado = true;
            StateHasChanged();
        }
        catch { }
    }

    private async Task CambiarCirugiaActivaAsync(int nuevoIdCirugia)
    {
        _idCirugiaActiva = nuevoIdCirugia;
        IdCirugia = nuevoIdCirugia;
        mensajeAlerta = string.Empty;
        if (OnCirugiaCambiada.HasDelegate)
            await OnCirugiaCambiada.InvokeAsync(nuevoIdCirugia);
        await CargarDatosAsync(navegar: false);
    }

    private async Task DescartarBorradorAsync()
    {
        try { await JS.InvokeVoidAsync("hosvetDraft.remove", ClaveBorrador); } catch { }
        _borradorRecuperado = false;
        pausaDto = await QuirofanoService.ObtenerPausaSeguridadAsync(IdOrden, Nhcl, _idCirugiaActiva);
        _jsonInicial = JsonSerializer.Serialize(pausaDto);
    }

    private async Task GuardarPausaAsync()
    {
        if (paciente == null) return;
        guardando = true;
        pausaDto.IdOrden = IdOrden;
        pausaDto.IdCirugia = _idCirugiaActiva;
        pausaDto.Nhcl = Nhcl;

        var result = await QuirofanoService.GuardarPausaSeguridadAsync(
            pausaDto,
            Session.CurrentUser?.IdUsuario ?? 1,
            Session.CurrentUser?.IdLocalidad ?? 1);

        guardando = false;
        esError = !result.Ok;
        mensajeAlerta = result.Ok
            ? "Pausa de Seguridad Quirúrgica guardada correctamente."
            : $"Error al guardar la Pausa de Seguridad: {result.Mensaje}";
        if (result.Ok)
        {
            _jsonInicial = JsonSerializer.Serialize(pausaDto);
            _borradorRecuperado = false;
            try { await JS.InvokeVoidAsync("hosvetDraft.remove", ClaveBorrador); } catch { }
            _cirugiasOrden = await QuirofanoService.ObtenerResumenCirugiasOrdenAsync(IdOrden, Nhcl);
            if (OnGuardado.HasDelegate)
                await OnGuardado.InvokeAsync();
        }
    }
}
