@page "/diagnostico/bandeja"
@page "/diagnostico/bandeja/{IdOrden:int}/{Nhcl:int}"
@inject ILaboratorioImagenService LabService
@inject IConsultaExternaService ConsultaService
@inject IKardexService KardexService
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

<PageTitle>e-ForVets - Bandeja Central de Resultados e Informes Diagnósticos</PageTitle>

<div class="container-fluid py-3">
    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm border-start border-4 border-success">
        <div>
            <h4 class="mb-0 text-primary fw-bold">
                <i class="bi bi-clipboard2-data-fill me-2"></i>Bandeja Central de Trabajo e Informes Diagnósticos
            </h4>
            <small class="text-muted">Recepción de órdenes diagnósticas, redacción de informes especializados y carga de resultados.</small>
        </div>
        <div class="d-flex gap-2 align-items-center mt-2 mt-md-0">
            <BuscadorOrdenClinica @bind-Orden="IdOrdenInput" @bind-Nhcl="NhclInput" OnBuscar="CargarPacientePorInputAsync" MostrarTextoBoton="false" />
            <button class="btn btn-sm btn-outline-success" @onclick="ExportarBandejaExcelAsync">
                <i class="bi bi-file-earmark-excel-fill me-1"></i>Exportar Bandeja Excel
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(MensajeAlerta))
    {
        <div class="alert alert-success alert-dismissible fade show py-2">
            <i class="bi bi-check-circle-fill me-2"></i>@MensajeAlerta
            <button type="button" class="btn-close py-2" @onclick="() => MensajeAlerta = null"></button>
        </div>
    }

    @if (CargandoInicial)
    {
        <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="fw-semibold small">Cargando bandeja de resultados e informes diagnósticos...</span>
        </div>
    }

    <!-- Pestañas -->
    <ul class="nav nav-tabs mb-3 fw-semibold">
        <li class="nav-item">
            <button class="nav-link @(TabActiva == 1 ? "active text-primary" : "text-secondary")" @onclick="() => TabActiva = 1">
                <i class="bi bi-inbox-fill me-1"></i>1. Bandeja Operativa de Órdenes (@BandejaItems.Count)
                @if (BandejaItems.Any(x => x.Prioridad == "Emergente" && x.Estado != "REALIZADO"))
                {
                    <span class="badge bg-danger ms-1">🚨 @BandejaItems.Count(x => x.Prioridad == "Emergente" && x.Estado != "REALIZADO") Urgente(s)</span>
                }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(TabActiva == 2 ? "active text-primary" : "text-secondary")" @onclick="() => TabActiva = 2">
                <i class="bi bi-file-earmark-medical-fill me-1"></i>2. Emisión de Informes y Carga de Archivos (@InformesPaciente.Count)
            </button>
        </li>
    </ul>

    <!-- TAB 1: BANDEJA OPERATIVA DE LABORATORIO E IMAGENOLOGÍA -->
    @if (TabActiva == 1)
    {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">Desde</label>
                        <input type="date" class="form-control form-control-sm" @bind="FechaDesde" @bind:after="CargarBandejaAsync" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">Hasta</label>
                        <input type="date" class="form-control form-control-sm" @bind="FechaHasta" @bind:after="CargarBandejaAsync" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">Área Diagnóstica</label>
                        <select class="form-select form-select-sm" @bind="AreaFiltro" @bind:after="CargarBandejaAsync">
                            <option value="TODOS">Todas (LAB + RX/Eco)</option>
                            <option value="LAB">Laboratorio Clínico</option>
                            <option value="RX">Imagenología (RX/Eco)</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">Filtrar Por</label>
                        <select class="form-select form-select-sm" @bind="CriterioFiltro" @bind:after="CargarBandejaAsync">
                            <option value="">Todos los Campos</option>
                            <option value="PACIENTE">Paciente</option>
                            <option value="CLIENTE">Propietario / Cliente</option>
                            <option value="MEDICO">Médico Solicitante</option>
                            <option value="ORDEN">N° Orden</option>
                            <option value="NHCL">N° Historia (NHCL)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Valor Búsqueda</label>
                        <input type="text" class="form-control form-control-sm" autocomplete="off" @bind="ValorFiltro" @bind:event="oninput" @bind:after="CargarBandejaAsync" placeholder="Escriba para filtrar..." />
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="table-responsive" style="max-height: 540px; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle small mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Área</th>
                            <th>Fecha</th>
                            <th>Orden / NHCL</th>
                            <th>Paciente / Propietario</th>
                            <th>Examen / Estudio Solicitado</th>
                            <th class="text-center">Prioridad</th>
                            <th>Médico Solicitante</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones Operativas</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!BandejaItems.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    No se encontraron órdenes de Laboratorio o Imagenología con los filtros actuales.
                                </td>
                            </tr>
                        }
                        @foreach (var item in BandejaItems)
                        {
                            <tr class="@(item.Prioridad == "Emergente" && item.Estado != "REALIZADO" ? "table-danger" : "")">
                                <td>
                                    <span class="badge @(item.AreaOrigen == "LAB" ? "bg-primary" : "bg-info text-dark")">@item.AreaOrigen</span>
                                </td>
                                <td>@item.FechaTexto</td>
                                <td>
                                    <strong>#@item.IdOrden</strong>
                                    <span class="badge bg-dark ms-1">NHCL #@item.Nhcl</span>
                                </td>
                                <td>
                                    <strong class="text-primary">@item.Paciente</strong>
                                    <div class="text-muted" style="font-size: 0.72rem;">@item.Cliente</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.Examen</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Observaciones))
                                    {
                                        <small class="text-muted"><i class="bi bi-chat-left-text me-1"></i>@item.Observaciones</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @(item.Prioridad == "Emergente" ? "bg-danger" : "bg-secondary")">
                                        @item.Prioridad
                                    </span>
                                </td>
                                <td>
                                    <div>@item.Medico</div>
                                    <small class="text-muted">@item.Especialidad</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(item.Estado == "REALIZADO" ? "bg-success" : "bg-warning text-dark")">
                                        @item.Estado
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (item.Estado != "REALIZADO")
                                        {
                                            <button class="btn btn-outline-success py-0 px-2"
                                                    @onclick="() => MarcarComoRealizadoAsync(item)"
                                                    title="Marcar Examen como Realizado">
                                                <i class="bi bi-check2-circle"></i> Atendido
                                            </button>
                                        }
                                        <button class="btn btn-primary py-0 px-2"
                                                @onclick="() => AbrirSubidaInformeAsync(item)"
                                                title="Subir PDF o Redactar Informe">
                                            <i class="bi bi-cloud-arrow-up-fill me-1"></i>Subir Resultado
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- TAB 2: EMISIÓN DE INFORMES Y CARGA DE RESULTADOS -->
    @if (TabActiva == 2)
    {
        <div class="row g-3">
            <!-- Columna Izquierda: Editor de Informe y Subida de Archivo -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-file-earmark-plus-fill me-1"></i>Registrar Informe o Subir Resultado Adjunto</span>
                        @if (Paciente != null)
                        {
                            <span class="badge bg-primary">@Paciente.PacienteNombre (NHCL #@Nhcl)</span>
                        }
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-md-5">
                                <label class="form-label small fw-semibold">Categoría de Informe</label>
                                <select class="form-select form-select-sm" @bind="NuevoInforme.TipoInforme" @bind:after="CargarPlantillasPorTipoAsync">
                                    <option value="Laboratorio">Laboratorio Clínico</option>
                                    <option value="Imagen">Rayos X / Imagen</option>
                                    <option value="Ecografia">Ecografía / Eco Doppler</option>
                                    <option value="Endoscopia">Endoscopía</option>
                                    <option value="Medicos">Informes Médicos</option>
                                </select>
                            </div>
                            <div class="col-md-7">
                                <label class="form-label small fw-semibold">Plantilla de Formato</label>
                                <select class="form-select form-select-sm" @bind="NuevoInforme.IdFormato" @bind:after="AplicarPlantillaSeleccionadaAsync">
                                    <option value="0">-- Plantilla estándar e-ForVets --</option>
                                    @foreach (var f in PlantillasDisponibles)
                                    {
                                        <option value="@f.FormId">@f.FormNombre</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Subida de Archivo PDF o Imagen a wwwroot/InformesUpload/{Tipo}/ -->
                        <div class="mb-3 p-2 bg-light rounded border">
                            <label class="form-label small fw-bold text-primary mb-1">
                                <i class="bi bi-paperclip me-1"></i>Adjuntar Archivo de Resultado (PDF, Imagen o Excel)
                            </label>
                            <InputFile OnChange="SubirArchivoResultadoAsync" class="form-control form-control-sm" accept=".pdf,.png,.jpg,.jpeg,.xlsx" />
                            @if (!string.IsNullOrWhiteSpace(NuevoInforme.RutaArchivo))
                            {
                                <div class="small text-success mt-1 fw-semibold">
                                    <i class="bi bi-check-circle-fill me-1"></i>Archivo listo: <code>@NuevoInforme.RutaArchivo</code>
                                </div>
                            }
                        </div>

                        <!-- Redactor de Contenido del Informe -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold d-flex justify-content-between">
                                <span>Desarrollo del Informe Diagnóstico (Hallazgos y Conclusiones)</span>
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" @onclick="() => VistaPreviaHtml = !VistaPreviaHtml">
                                    @(VistaPreviaHtml ? "Editar Texto/HTML" : "Vista Previa")
                                </button>
                            </label>
                            @if (VistaPreviaHtml)
                            {
                                <div class="border rounded p-3 bg-white small" style="min-height: 220px; max-height: 280px; overflow-y: auto;">
                                    @((MarkupString)NuevoInforme.ContenidoHtml)
                                </div>
                            }
                            else
                            {
                                <textarea class="form-control form-control-sm font-monospace" rows="9" @bind="NuevoInforme.ContenidoHtml"></textarea>
                            }
                        </div>

                        <button class="btn btn-sm btn-success w-100" @onclick="GuardarInformeAsync">
                            <i class="bi bi-floppy-fill me-1"></i>Guardar Informe y Marcar Orden como Realizada
                        </button>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Historial de Informes del Paciente -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-folder2-open me-1"></i>Repositorio de Informes del Paciente (NHCL #@Nhcl)</span>
                        <span class="badge bg-secondary">@InformesPaciente.Count informe(s)</span>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Categoría</th>
                                        <th>Fecha</th>
                                        <th>Formato / Archivo</th>
                                        <th>Especialista</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!InformesPaciente.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">
                                                No existen informes diagnósticos registrados para este paciente.
                                            </td>
                                        </tr>
                                    }
                                    @foreach (var inf in InformesPaciente)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-info text-dark">@inf.TipoInforme</span>
                                            </td>
                                            <td>@inf.FechaMod.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>
                                                <div class="fw-semibold">@inf.NombreFormato</div>
                                                @if (!string.IsNullOrWhiteSpace(inf.RutaArchivo))
                                                {
                                                    <a href="/@inf.RutaArchivo" target="_blank" class="small text-decoration-none">
                                                        <i class="bi bi-file-earmark-arrow-down me-1"></i>Abrir adjunto
                                                    </a>
                                                }
                                            </td>
                                            <td>@inf.NombreUsuario</td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary py-0 px-2" @onclick="() => SeleccionarInformeExistente(inf)" title="Ver Contenido">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger py-0 px-2" @onclick="() => ExportarInformePdfAsync(inf)" title="Descargar PDF">
                                                        <i class="bi bi-file-earmark-pdf"></i>
                                                    </button>
                                                    <button class="btn btn-outline-secondary py-0 px-2" @onclick="() => AnularInformeAsync(inf)" title="Anular">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }

    private int IdOrdenInput { get; set; }
    private int NhclInput { get; set; }
    private int TabActiva { get; set; } = 1;
    private bool VistaPreviaHtml { get; set; } = true;
    private bool CargandoInicial { get; set; } = true;
    private string? MensajeAlerta { get; set; }

    private DateTime FechaDesde { get; set; } = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime FechaHasta { get; set; } = DateTime.Today;
    private string AreaFiltro { get; set; } = "TODOS";
    private string CriterioFiltro { get; set; } = string.Empty;
    private string ValorFiltro { get; set; } = string.Empty;

    private PacienteHeaderDto? Paciente { get; set; }
    private List<BandejaTrabajoDiagnosticoDto> BandejaItems { get; set; } = new();
    private List<FormatoPlantillaDto> PlantillasDisponibles { get; set; } = new();
    private List<InformeDiagnosticoDto> InformesPaciente { get; set; } = new();
    private InformeDiagnosticoDto NuevoInforme { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        CargandoInicial = true;
        await Task.Yield();

        try
        {
            if (IdOrden <= 0 && Session.OrdenActiva.HasValue)
            {
                IdOrden = Session.OrdenActiva.Value;
                Nhcl = Session.NhclActivo ?? 0;
            }

            var tBandeja = CargarBandejaAsync();
            var tPlantillas = CargarPlantillasPorTipoAsync();
            await Task.WhenAll(tBandeja, tPlantillas);

            if (IdOrden > 0 || Nhcl > 0)
            {
                IdOrdenInput = IdOrden;
                NhclInput = Nhcl;
                await CargarDatosPacienteAsync();
            }
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Aviso al cargar bandeja: {ex.Message}";
        }
        finally
        {
            CargandoInicial = false;
        }
    }

    private async Task CargarPacientePorInputAsync()
    {
        IdOrden = IdOrdenInput;
        Nhcl = NhclInput;
        try
        {
            await CargarDatosPacienteAsync();
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Aviso al buscar paciente: {ex.Message}";
        }
    }

    private async Task CargarBandejaAsync()
    {
        try
        {
            BandejaItems = await LabService.ObtenerBandejaTrabajoAsync(FechaDesde, FechaHasta, AreaFiltro, CriterioFiltro, ValorFiltro);
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Aviso al consultar órdenes: {ex.Message}";
        }
    }

    private async Task CargarDatosPacienteAsync()
    {
        try
        {
            if (IdOrden > 0)
            {
                Paciente = await KardexService.ObtenerEncabezadoPacienteAsync(IdOrden, Nhcl);
                if (Paciente != null && Nhcl <= 0)
                {
                    Nhcl = Paciente.Nhcl;
                    NhclInput = Nhcl;
                }
                Session.SeleccionarOrden(IdOrden, Nhcl, Paciente?.PacienteNombre);
            }

            if (Nhcl > 0)
            {
                InformesPaciente = await LabService.ObtenerInformesPacienteAsync(Nhcl);
                await AplicarPlantillaSeleccionadaAsync();
            }
        }
        catch (Exception ex)
        {
            MensajeAlerta = $"Aviso al cargar datos del paciente: {ex.Message}";
        }
    }

    private async Task CargarPlantillasPorTipoAsync()
    {
        PlantillasDisponibles = await ConsultaService.ObtenerPlantillasFormatosAsync();
    }

    private async Task AplicarPlantillaSeleccionadaAsync()
    {
        string usuario = Session.NombreUsuario;
        NuevoInforme.ContenidoHtml = await LabService.ProcesarPlantillaInformeAsync(NuevoInforme.IdFormato, Nhcl, usuario);
    }

    private async Task MarcarComoRealizadoAsync(BandejaTrabajoDiagnosticoDto item)
    {
        int idUser = Session.CurrentUser?.UserNumero ?? 1;
        await LabService.MarcarExamenRealizadoAsync(item.Secuencial, item.IdOrden, item.CodigoProd, item.AreaOrigen, idUser);
        MensajeAlerta = $"Examen '{item.Examen}' de la Orden #{item.IdOrden} marcado como REALIZADO.";
        await CargarBandejaAsync();
    }

    private async Task AbrirSubidaInformeAsync(BandejaTrabajoDiagnosticoDto item)
    {
        IdOrden = item.IdOrden;
        Nhcl = item.Nhcl;
        IdOrdenInput = IdOrden;
        NhclInput = Nhcl;

        NuevoInforme = new InformeDiagnosticoDto
        {
            Nhcl = item.Nhcl,
            IdOrden = item.IdOrden,
            SecOrden = item.Secuencial,
            CodigoProducto = item.CodigoProd,
            TipoInforme = item.AreaOrigen == "LAB" ? "Laboratorio" : "Imagen",
            NombreFormato = item.Examen
        };

        await CargarDatosPacienteAsync();
        TabActiva = 2;
    }

    private async Task SubirArchivoResultadoAsync(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo == null) return;

        string carpetaTipo = NuevoInforme.TipoInforme switch
        {
            "Laboratorio" => "Laboratorio",
            "Imagen" => "Imagen",
            "Ecografia" => "Ecografia",
            "Endoscopia" => "Endoscopia",
            _ => "Medicos"
        };

        string dirRelativo = $"InformesUpload/{carpetaTipo}";
        string dirFisico = Path.Combine(Env.WebRootPath, "InformesUpload", carpetaTipo);
        Directory.CreateDirectory(dirFisico);

        string nombreSeguro = $"{DateTime.Now:yyyyMMddHHmmss}_{IdOrden}_{Path.GetFileName(archivo.Name)}";
        string rutaFisica = Path.Combine(dirFisico, nombreSeguro);

        await using var stream = archivo.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
        await using var fs = new FileStream(rutaFisica, FileMode.Create);
        await stream.CopyToAsync(fs);

        NuevoInforme.RutaArchivo = $"{dirRelativo}/{nombreSeguro}";
    }

    private async Task GuardarInformeAsync()
    {
        if (Nhcl <= 0) return;
        NuevoInforme.Nhcl = Nhcl;
        NuevoInforme.IdOrden = IdOrden;
        NuevoInforme.IdUser = Session.CurrentUser?.UserNumero ?? 1;
        NuevoInforme.Localidad = Session.Localidad;

        await LabService.GuardarInformeDiagnosticoAsync(NuevoInforme);
        InformesPaciente = await LabService.ObtenerInformesPacienteAsync(Nhcl);
        await CargarBandejaAsync();
        MensajeAlerta = $"Informe de {NuevoInforme.TipoInforme} registrado exitosamente para NHCL #{Nhcl}.";
    }

    private void SeleccionarInformeExistente(InformeDiagnosticoDto inf)
    {
        NuevoInforme = new InformeDiagnosticoDto
        {
            IdInforme = inf.IdInforme,
            TipoInforme = inf.TipoInforme,
            Nhcl = inf.Nhcl,
            IdFormato = inf.IdFormato,
            NombreFormato = inf.NombreFormato,
            RutaArchivo = inf.RutaArchivo,
            ContenidoHtml = inf.ContenidoHtml
        };
        VistaPreviaHtml = true;
    }

    private async Task AnularInformeAsync(InformeDiagnosticoDto inf)
    {
        await LabService.AnularInformeDiagnosticoAsync(inf.IdInforme, inf.TipoInforme);
        InformesPaciente = await LabService.ObtenerInformesPacienteAsync(Nhcl);
    }

    private async Task ExportarInformePdfAsync(InformeDiagnosticoDto inf)
    {
        var pac = Paciente;
        if (pac is null || pac.Nhcl <= 0)
        {
            MensajeAlerta = "No se pudo generar el PDF: faltan los datos reales del paciente.";
            return;
        }
        var pdfBytes = ReportService.GenerarInformeDiagnosticoPdf(pac, inf);
        await JS.InvokeVoidAsync("descargarArchivoBase64", $"Informe_{inf.TipoInforme}_{inf.IdInforme}.pdf", "application/pdf", Convert.ToBase64String(pdfBytes));
    }

    private async Task ExportarBandejaExcelAsync()
    {
        var xlsxBytes = ReportService.GenerarBandejaLaboratorioExcel(BandejaItems, FechaDesde, FechaHasta);
        await JS.InvokeVoidAsync("descargarArchivoBase64", $"BandejaDiagnostica_{FechaDesde:yyyyMMdd}_{FechaHasta:yyyyMMdd}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(xlsxBytes));
    }
}
