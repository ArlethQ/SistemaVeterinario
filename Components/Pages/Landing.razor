@page "/"
@layout Layout.PublicLayout
<PageTitle>e-ForVets | Software de gestión veterinaria</PageTitle>

<div class="landing-page">
    <header class="public-header">
        <a class="brand" href="/" aria-label="e-ForVets, inicio"><img src="/favicon.png" alt="" /><span><strong>e-ForVets</strong><small>Gestión veterinaria</small></span></a>
        <nav aria-label="Navegación principal"><a href="#inicio">Inicio</a><a href="#funcionalidades">Funcionalidades</a><a href="#beneficios">Beneficios</a><a href="#planes">Planes</a><a href="#contacto">Contacto</a></nav>
        <div class="header-actions"><a class="login-link" href="/login">Iniciar sesión</a></div>
    </header>

    <main>
        <section id="inicio" class="hero">
            <div class="hero-copy">
                <span class="eyebrow">Software de gestión veterinaria</span>
                <h1>Cuida de ellos. <span>Nosotros te ayudamos</span> a gestionar todo.</h1>
                <p>Organiza la operación de tu clínica, centraliza la información de tus pacientes y acompaña cada atención desde una plataforma clara y segura.</p>
                <div class="hero-actions"><a class="secondary-button" href="#funcionalidades">Explorar funcionalidades</a></div>
                <p class="hero-note"><span>✓</span> Diseñado para equipos veterinarios</p>
            </div>
            <div class="hero-visual" aria-label="Vista conceptual del software e-ForVets">
                <div class="software-preview"><div class="preview-sidebar"><img src="/favicon.png" alt="" /><i></i><i></i><i></i><i></i></div><div class="preview-content"><div class="preview-top"></div><div class="preview-title"></div><div class="preview-cards"><i></i><i></i><i></i></div><div class="preview-chart"><span></span><span></span><span></span><span></span><span></span></div></div></div>
                <div class="pet-badge dog">🐶</div><div class="pet-badge cat">🐱</div><div class="floating-note"><span>✚</span><div><strong>Información organizada</strong><small>Para una atención más ágil</small></div></div>
            </div>
        </section>

        <section id="funcionalidades" class="section features">
            <div class="section-heading"><span class="eyebrow">Funcionalidades</span><h2>Una plataforma para organizar tu veterinaria</h2><p>Presentación de las áreas que e-ForVets puede centralizar según la configuración y módulos disponibles.</p></div>
            <div class="feature-grid">
                @foreach (var feature in Features) { <article><span class="feature-icon">@feature.Icon</span><h3>@feature.Title</h3><p>@feature.Description</p></article> }
            </div>
        </section>

        <section id="beneficios" class="section benefits">
            <div class="benefit-visual"><div class="rings"><img src="/favicon.png" alt="Icono de e-ForVets" /></div></div>
            <div class="benefit-copy"><span class="eyebrow">Beneficios</span><h2>Más orden para dedicar más tiempo a tus pacientes</h2><div class="benefit-list"><div><b>01</b><span><strong>Información centralizada</strong><small>Consulta datos clínicos y administrativos desde un mismo entorno.</small></span></div><div><b>02</b><span><strong>Procesos conectados</strong><small>Facilita la coordinación entre recepción, consulta y atención clínica.</small></span></div><div><b>03</b><span><strong>Seguimiento claro</strong><small>Mantén el contexto de cada paciente disponible para tu equipo.</small></span></div></div></div>
        </section>

        <section class="section steps"><div class="section-heading centered"><span class="eyebrow">Cómo funciona</span><h2>Empieza de forma simple</h2></div><div class="steps-grid"><article><b>1</b><h3>Registra tu clínica</h3><p>Solicita el acceso inicial para tu organización.</p></article><article><b>2</b><h3>Organiza la información</h3><p>Configura los datos necesarios para tu operación.</p></article><article><b>3</b><h3>Gestiona la atención</h3><p>Trabaja con los módulos habilitados para tu equipo.</p></article></div></section>

        <section id="planes" class="section plans-section"><SubscriptionPlansTable /></section>

        <section class="final-cta"><div><span>Todo tu equipo, mejor conectado</span><h2>Da el siguiente paso con e-ForVets.</h2><p>Una experiencia moderna para la gestión diaria de tu veterinaria.</p></div></section>
    </main>

    <footer id="contacto"><div class="brand footer-brand"><img src="/favicon.png" alt="" /><span><strong>e-ForVets</strong><small>Gestión veterinaria</small></span></div><nav aria-label="Enlaces del pie"><a href="#funcionalidades">Funcionalidades</a><a href="#beneficios">Beneficios</a><a href="/login">Iniciar sesión</a></nav><small>© @DateTime.Now.Year e-ForVets.</small></footer>
</div>

@code {
    private static readonly (string Icon, string Title, string Description)[] Features = [
        ("🐾", "Gestión de mascotas", "Organiza la información principal de cada paciente."), ("▣", "Agenda de citas", "Visualiza y coordina la atención programada."), ("♡", "Historial clínico", "Mantén el contexto clínico disponible para el equipo."), ("✚", "Vacunación", "Presentación para el seguimiento preventivo."), ("♙", "Tutores", "Relaciona pacientes con sus responsables."), ("▦", "Inventario", "Presentación para el control de insumos y productos."), ("▥", "Reportes", "Presentación para consultar información de gestión.")
    ];
}
