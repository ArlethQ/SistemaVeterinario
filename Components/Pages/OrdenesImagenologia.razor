@inject ILaboratorioImagenService LabService
@inject IConsultaExternaService ConsultaService
@inject IKardexService KardexService
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="diagnostic-orders">
    <!-- Encabezado y Acciones -->
    <header class="diagnostic-orders-hero">
        <div class="diagnostic-orders-heading">
            <i class="bi bi-lungs-fill" aria-hidden="true"></i>
            <div>
                <h1>Órdenes y Despacho de Imagenología (Rayos X y Ecografía)</h1>
                <p>Solicitud y despacho de estudios de radiología digital y ecografía diagnóstica.</p>
            </div>
        </div>
        <div class="diagnostic-orders-toolbar">
            <div class="diagnostic-orders-order-select">
                <label for="orden-activa-imagenologia">Orden / Historia (NHCL)</label>
                <select id="orden-activa-imagenologia" class="form-select form-select-sm" value="@IdOrden" @onchange="SeleccionarOrdenActivaAsync" disabled="@CargandoInicial">
                    <option value="0" disabled>Seleccione paciente / orden</option>
                    @if (IdOrden > 0 && !OrdenesActivas.Any(x => x.IdOrdenAtencion == IdOrden))
                    {
                        <option value="@IdOrden">#@IdOrden | @Paciente?.PacienteNombre (NHCL @Nhcl)</option>
                    }
                    @foreach (var orden in OrdenesActivas)
                    {
                        <option value="@orden.IdOrdenAtencion">#@orden.IdOrdenAtencion | @orden.Paciente (NHCL @orden.Nhcl)</option>
                    }
                </select>
            </div>
            <div class="diagnostic-orders-actions">
                <SaveButton class="btn btn-sm btn-success" OnClick="GuardarCambiosOrdenAsync" Disabled="@(CargandoInicial || !OrdenesActuales.Any())">
                    <i class="bi bi-floppy-fill me-1"></i>Guardar Orden RX/Eco
                </SaveButton>
                <button class="btn btn-sm btn-danger app-doc-action app-doc-pdf" @onclick="ExportarPdfAsync" disabled="@(CargandoInicial || !OrdenesActuales.Any())">
                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>Pedido Imagen PDF + QR
                </button>
                <button class="btn btn-sm btn-outline-dark" disabled="@CargandoInicial" @onclick='() => Nav.NavigateTo($"/diagnostico/bandeja/{IdOrden}/{Nhcl}")'>
                    <i class="bi bi-inbox-fill me-1"></i>Bandeja e Informes
                </button>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(MensajeAlerta))
    {
        <div class="alert @(EsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2">
            <i class="bi @(EsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@MensajeAlerta
            <button type="button" class="btn-close py-2" @onclick="() => MensajeAlerta = null"></button>
        </div>
    }

    @if (CargandoInicial)
    {
        <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="fw-semibold small">Cargando estudios de Rayos X y Ecografía...</span>
        </div>
    }

    <section class="diagnostic-orders-panel diagnostic-orders-patient mb-3" aria-label="Datos de la orden y del paciente">
        <div class="diagnostic-orders-patient-field">
            <i class="bi bi-clipboard" aria-hidden="true"></i>
            <div>
                <span>Orden / Historia (NHCL)</span>
                <BuscadorOrdenClinica @bind-Orden="IdOrdenInput" @bind-Nhcl="NhclInput" OnBuscar="CargarPorInputAsync" MostrarTextoBoton="false" />
                @if (Paciente != null)
                {
                    <small>Orden #@IdOrden · NHCL #@Paciente.Nhcl</small>
                }
            </div>
        </div>
        @if (Paciente != null)
        {
            <div class="diagnostic-orders-patient-field">
                <i class="bi bi-person" aria-hidden="true"></i>
                <div>
                    <span>Propietario (Cliente)</span>
                    <strong>@Paciente.PropietarioNombre</strong>
                    <small>C.I. @Paciente.ClienteCedula</small>
                </div>
            </div>
            <div class="diagnostic-orders-patient-field">
                <i class="bi bi-heart-pulse" aria-hidden="true"></i>
                <div>
                    <span>Paciente / Especie</span>
                    <strong class="diagnostic-orders-patient-name">@Paciente.PacienteNombre</strong>
                    <span class="diagnostic-orders-chip">@Paciente.Especie</span>
                    <small>@Paciente.Raza · @Paciente.Sexo</small>
                </div>
            </div>
            <div class="diagnostic-orders-patient-field">
                <i class="bi bi-person-badge" aria-hidden="true"></i>
                <div>
                    <span>Médico solicitante</span>
                    <strong>@Paciente.MedicoResponsable</strong>
                </div>
            </div>
        }
    </section>

    <div class="row g-3">
        <!-- Columna Izquierda: Selector de Modalidad (Rayos X / Ecografía / Todos) -->
        <div class="col-lg-4">
            <div class="diagnostic-orders-panel h-100">
                <div class="diagnostic-orders-section">
                    <h2><i class="bi bi-camera-reels-fill me-1"></i>Catálogo de Estudios Radiológicos y Ecográficos</h2>
                    <span class="badge bg-info text-dark">@CatalogoEstudios.Count estudios</span>
                </div>
                <div class="diagnostic-orders-body">
                    <label class="form-label small fw-semibold mb-1" for="categoria-OrdenesImagenologia">Categoría</label>
                    <select id="categoria-OrdenesImagenologia" class="form-select form-select-sm mb-2" @bind="ModalidadSeleccionada" @bind:after="CambiarCategoriaAsync">
                        <option value="">Seleccione una categoría</option>
                        @foreach (var categoria in SubcategoriasImagenologia)
                        {
                            <option value="@(categoria.GrupoId > 0 ? categoria.GrupoId.ToString() : "TODOS")">@categoria.NombreGrupo</option>
                        }
                    </select>

                    <div class="input-group input-group-sm mb-2">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Filtrar estudio por nombre o código..."
                               @bind="FiltroTexto" @bind:event="oninput" @bind:after="CargarCatalogoAsync" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-1">Proyecciones / Región Anatómica / Indicación Clínica</label>
                        <input type="text" class="form-control form-control-sm" @bind="ObservacionDefault"
                               placeholder="Ej: Proyección LL derecha + VD de tórax, sospecha de metástasis / cuerpo extraño..." />
                    </div>

                    <div class="diagnostic-orders-catalog mb-2" style="max-height: 300px; overflow-y: auto;">
                        @if (CatalogoEstudios.Count == 0)
                        {
                            <div class="text-center text-muted py-3 small">@(string.IsNullOrEmpty(ModalidadSeleccionada) ? "Seleccione una categoría para ver sus estudios." : "No se encontraron estudios para esta categoría.")</div>
                        }
                        @foreach (var est in CatalogoEstudios)
                        {
                            <div class="form-check diagnostic-orders-item small">
                                <div>
                                    <input class="form-check-input me-2" type="checkbox" id="chk_rx_@est.CodigoProd" @bind="est.Seleccionado" />
                                    <label class="form-check-label fw-semibold" for="chk_rx_@est.CodigoProd">
                                        <span class="badge @(est.Categoria == "ECOS" ? "bg-info text-dark" : "bg-secondary") me-1">@est.Categoria</span>
                                        [@est.CodigoProd] @est.Descripcion
                                    </label>
                                </div>
                                <span class="badge bg-white text-dark border">$@est.PrecioUnitario.ToString("N2")</span>
                            </div>
                        }
                    </div>

                    <button class="btn btn-sm btn-primary w-100" @onclick="AgregarEstudiosSeleccionadosAsync" disabled="@(CargandoInicial || !CatalogoEstudios.Any(x => x.Seleccionado))">
                        <i class="bi bi-plus-circle-fill me-1"></i>Agregar Estudios Seleccionados (@CatalogoEstudios.Count(x => x.Seleccionado))
                    </button>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Estudios Solicitados en la Orden -->
        <div class="col-lg-8">
            <div class="diagnostic-orders-panel h-100">
                <div class="diagnostic-orders-section">
                    <h2><i class="bi bi-card-checklist me-1"></i>Estudios de Imagenología en la Orden #@IdOrden</h2>
                    <span class="badge diagnostic-orders-total">Total Estimado: $@OrdenesActuales.Sum(x => x.Precio * x.Cantidad).ToString("N2")</span>
                </div>
                <div class="diagnostic-orders-body">
                    <div class="table-responsive diagnostic-orders-table-wrap">
                        <table class="table table-hover align-middle mb-0 diagnostic-orders-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Código</th>
                                    <th>Estudio Solicitado</th>
                                    <th style="width: 80px;" class="text-center">Cant.</th>
                                    <th style="width: 220px;">Proyecciones / Observaciones</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-end">Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!OrdenesActuales.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted py-4">
                                            Seleccione uno o más estudios radiológicos o ecográficos del panel izquierdo.
                                        </td>
                                    </tr>
                                }
                                @foreach (var item in OrdenesActuales)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.CodigoProd</td>
                                        <td class="fw-semibold">@item.DescripcionEstudio</td>
                                        <td>
                                            <input type="number" min="1" class="form-control form-control-sm py-0 text-center" @bind="item.Cantidad" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm py-0" @bind="item.Observaciones" />
                                        </td>
                                        <td class="text-center">
                                            <span class="badge @(item.Estado == "REALIZADO" ? "bg-success" : "bg-warning text-dark")">
                                                @item.Estado
                                            </span>
                                        </td>
                                        <td class="text-end fw-semibold">$@((item.Precio * item.Cantidad).ToString("N2"))</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => EliminarEstudioOrdenAsync(item.Sec)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (DiagnosticosOrden.Any())
                    {
                        <div class="diagnostic-orders-diagnoses mt-3 small">
                            <strong class="text-primary d-block mb-1"><i class="bi bi-tags me-1"></i>Diagnósticos CIE-10 vinculados:</strong>
                            @foreach (var d in DiagnosticosOrden)
                            {
                                <span class="badge diagnostic-orders-chip me-1">[@d.CodigoDiag] @d.NombreCie10 (@d.TipoDiag)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }

    private int IdOrdenInput { get; set; }
    private int NhclInput { get; set; }
    private string ModalidadSeleccionada { get; set; } = string.Empty;
    private string FiltroTexto { get; set; } = string.Empty;
    private string ObservacionDefault { get; set; } = string.Empty;
    private bool CargandoInicial { get; set; } = true;
    private string? MensajeAlerta { get; set; }
    private bool EsError { get; set; }

    private PacienteHeaderDto? Paciente { get; set; }
    private List<OrdenActivaResumenDto> OrdenesActivas { get; set; } = new();
    private List<GrupoLaboratorioCatalogoDto> SubcategoriasImagenologia { get; set; } = new();
    private List<PruebaCatalogoDto> CatalogoEstudios { get; set; } = new();
    private List<OrdenImagenItemDto> OrdenesActuales { get; set; } = new();
    private List<DiagnosticoCie10Dto> DiagnosticosOrden { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        CargandoInicial = true;
        await Task.Yield();

        if (!SubcategoriasImagenologia.Any())
        {
            SubcategoriasImagenologia = await LabService.ObtenerSubcategoriasImagenologiaAsync();
        }

        OrdenesActivas = await KardexService.ObtenerOrdenesActivasAsync();

        if (IdOrden <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
        {
            IdOrden = Session.OrdenActiva.Value;
            Nhcl = Session.NhclActivo ?? 0;
        }
        else if (IdOrden <= 0)
        {
            if (OrdenesActivas.Count > 0)
            {
                IdOrden = OrdenesActivas[0].IdOrdenAtencion;
                Nhcl = OrdenesActivas[0].Nhcl;
            }
        }

        var tCat = CargarCatalogoAsync();
        if (IdOrden > 0)
        {
            IdOrdenInput = IdOrden;
            NhclInput = Nhcl;
            var tOrd = CargarDatosOrdenAsync();
            await Task.WhenAll(tCat, tOrd);
        }
        else
        {
            await tCat;
        }
        CargandoInicial = false;
    }

    private async Task CargarPorInputAsync()
    {
        if (IdOrdenInput > 0)
        {
            IdOrden = IdOrdenInput;
            Nhcl = NhclInput;
            await CargarDatosOrdenAsync();
        }
    }

    private async Task SeleccionarOrdenActivaAsync(ChangeEventArgs e)
    {
        if (CargandoInicial || !int.TryParse(e.Value?.ToString(), out var idOrden) || idOrden <= 0)
            return;

        var orden = OrdenesActivas.FirstOrDefault(x => x.IdOrdenAtencion == idOrden);
        if (orden == null)
            return;

        CargandoInicial = true;
        IdOrden = orden.IdOrdenAtencion;
        Nhcl = orden.Nhcl;
        IdOrdenInput = IdOrden;
        NhclInput = Nhcl;
        CatalogoEstudios.ForEach(x => x.Seleccionado = false);
        ObservacionDefault = string.Empty;
        try
        {
            await CargarDatosOrdenAsync();
            EsError = false;
            MensajeAlerta = $"Paciente {orden.Paciente} cargado correctamente.";
        }
        finally
        {
            CargandoInicial = false;
        }
    }

    private int _versionCatalogo;

    private Task CambiarCategoriaAsync()
    {
        CatalogoEstudios = new();
        return CargarCatalogoAsync();
    }

    private async Task CargarCatalogoAsync()
    {
        var version = ++_versionCatalogo;
        List<PruebaCatalogoDto> resultados = !string.IsNullOrEmpty(ModalidadSeleccionada)
            ? await LabService.ObtenerCatalogoImagenologiaAsync(ModalidadSeleccionada, FiltroTexto, Session.Apostrofe)
            : [];

        if (version == _versionCatalogo)
            CatalogoEstudios = resultados;
    }

    private async Task CargarDatosOrdenAsync()
    {
        Paciente = await KardexService.ObtenerEncabezadoPacienteAsync(IdOrden, Nhcl);
        if (Paciente != null && Nhcl <= 0)
        {
            Nhcl = Paciente.Nhcl;
            NhclInput = Nhcl;
        }
        Session.SeleccionarOrden(IdOrden, Nhcl, Paciente?.PacienteNombre);

        var tOrd = LabService.ObtenerOrdenesImagenAsync(IdOrden, Nhcl);
        var tDiag = ConsultaService.ObtenerDiagnosticosOrdenAsync(IdOrden);
        await Task.WhenAll(tOrd, tDiag);

        OrdenesActuales = await tOrd;
        DiagnosticosOrden = await tDiag;
    }

    private async Task AgregarEstudiosSeleccionadosAsync()
    {
        if (IdOrden <= 0)
        {
            EsError = true;
            MensajeAlerta = "Seleccione primero una Orden de Atención válida.";
            return;
        }

        var seleccionados = CatalogoEstudios.Where(x => x.Seleccionado).ToList();
        if (!seleccionados.Any()) return;

        foreach (var est in seleccionados)
        {
            await LabService.AgregarOrdenImagenAsync(new OrdenImagenItemDto
            {
                IdOrden = IdOrden,
                Nhcl = Nhcl,
                CodigoProd = est.CodigoProd,
                DescripcionEstudio = est.Descripcion,
                Observaciones = ObservacionDefault,
                Cantidad = 1,
                Estado = "Por Facturar",
                Fecha = DateTime.Now,
                Iva = est.GrupoIva,
                IdEfact = est.IdEfact,
                Medida = est.UnidadMedida,
                Precio = est.PrecioUnitario
            });
            est.Seleccionado = false;
        }

        ObservacionDefault = string.Empty;
        OrdenesActuales = await LabService.ObtenerOrdenesImagenAsync(IdOrden, Nhcl);
        EsError = false;
        MensajeAlerta = $"Se agregaron {seleccionados.Count} estudio(s) de imagen a la Orden #{IdOrden}.";
    }

    private async Task GuardarCambiosOrdenAsync()
    {
        int idUser = Session.CurrentUser?.UserNumero ?? 1;
        await LabService.ActualizarOrdenesImagenAsync(IdOrden, OrdenesActuales, idUser);
        EsError = false;
        MensajeAlerta = $"Orden de Imagenología #{IdOrden} actualizada correctamente.";
    }

    private async Task EliminarEstudioOrdenAsync(int sec)
    {
        await LabService.EliminarOrdenImagenAsync(sec);
        OrdenesActuales = await LabService.ObtenerOrdenesImagenAsync(IdOrden, Nhcl);
    }

    private async Task ExportarPdfAsync()
    {
        var pac = Paciente;
        if (pac is null || pac.Nhcl <= 0)
        {
            EsError = true;
            MensajeAlerta = "No se pudo generar el PDF: faltan los datos reales del paciente.";
            return;
        }
        var pdfBytes = ReportService.GenerarOrdenImagenPdf(pac, OrdenesActuales, DiagnosticosOrden);
        await JS.InvokeVoidAsync("descargarArchivoBase64", $"PedidoImagenologia_Orden_{IdOrden}.pdf", "application/pdf", Convert.ToBase64String(pdfBytes));
    }
}
