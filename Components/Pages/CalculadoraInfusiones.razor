@page "/hospitalizacion/calculadora-infusiones"

<PageTitle>Calculadora de infusiones — e-ForVets</PageTitle>

<div class="container py-3">
    <div class="card border-danger shadow-sm mb-3">
        <div class="card-header bg-danger text-white fw-bold">Calculadora de infusión continua</div>
        <div class="card-body">
            <div class="alert alert-warning">
                Herramienta de apoyo matemático. La prescripción, concentración comercial, compatibilidad, estabilidad,
                límites de velocidad y resultado deben verificarse de forma independiente antes de preparar o administrar.
                No contiene dosis sugeridas.
            </div>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label fw-semibold">Paciente/prescripción</label><input class="form-control" @bind="Paciente" placeholder="Identificación o referencia" /></div>
                <div class="col-md-3"><label class="form-label fw-semibold">Peso (kg) *</label><input type="number" min="0.01" step="0.01" class="form-control" @bind="PesoKg" /></div>
                <div class="col-md-3"><label class="form-label fw-semibold">Volumen final (ml) *</label><input type="number" min="0.01" step="0.01" class="form-control" @bind="VolumenFinalMl" /></div>
                <div class="col-md-3"><label class="form-label fw-semibold">Velocidad de infusión (ml/h) *</label><input type="number" min="0.01" step="0.01" class="form-control" @bind="VelocidadMlHora" /></div>
                <div class="col-md-3"><label class="form-label fw-semibold">Dosis prescrita *</label><input type="number" min="0" step="0.0001" class="form-control" @bind="Dosis" /></div>
                <div class="col-md-3"><label class="form-label fw-semibold">Unidad de dosis *</label><select class="form-select" @bind="UnidadDosis"><option value="mcg/kg/min">mcg/kg/min</option><option value="mcg/kg/h">mcg/kg/h</option><option value="mg/kg/h">mg/kg/h</option><option value="mg/kg/día">mg/kg/día</option><option value="mEq/kg/h">mEq/kg/h</option></select></div>
                <div class="col-md-3"><label class="form-label fw-semibold">Concentración comercial *</label><input type="number" min="0" step="0.0001" class="form-control" @bind="Concentracion" /></div>
                <div class="col-md-3"><label class="form-label fw-semibold">Unidad concentración *</label><select class="form-select" @bind="UnidadConcentracion"><option value="mcg/ml">mcg/ml</option><option value="mg/ml">mg/ml</option><option value="mEq/ml">mEq/ml</option></select></div>
                <div class="col-md-4"><label class="form-label fw-semibold">Fármaco/soluto</label><input class="form-control" @bind="Farmaco" /></div>
                <div class="col-md-4"><label class="form-label fw-semibold">Diluyente/vehículo</label><input class="form-control" @bind="Diluyente" /></div>
                <div class="col-md-4"><label class="form-label fw-semibold">Prescriptor</label><input class="form-control" @bind="Prescriptor" /></div>
            </div>
            <div class="mt-3 d-flex gap-2"><button class="btn btn-danger" @onclick="Calcular">Calcular</button><button class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button></div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error)) { <div class="alert alert-danger">@Error</div> }
    @if (Resultado is not null)
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-bold">Resultado matemático para verificación</div>
            <div class="card-body">
                <div class="row g-3 text-center">
                    <div class="col-md-3"><div class="border rounded p-3"><small>Duración de la mezcla</small><div class="fs-4 fw-bold">@Resultado.DuracionHoras.ToString("0.##") h</div></div></div>
                    <div class="col-md-3"><div class="border rounded p-3"><small>Cantidad total de principio activo</small><div class="fs-4 fw-bold">@Resultado.CantidadActiva.ToString("0.####") @Resultado.UnidadActiva</div></div></div>
                    <div class="col-md-3"><div class="border border-danger rounded p-3"><small>Volumen del fármaco</small><div class="fs-4 fw-bold text-danger">@Resultado.VolumenFarmacoMl.ToString("0.####") ml</div></div></div>
                    <div class="col-md-3"><div class="border rounded p-3"><small>Volumen aproximado de diluyente</small><div class="fs-4 fw-bold">@Resultado.VolumenDiluyenteMl.ToString("0.####") ml</div></div></div>
                </div>
                <div class="alert alert-light border mt-3 mb-0">
                    <strong>Preparación calculada:</strong> retirar/medir @Resultado.VolumenFarmacoMl.ToString("0.####") ml de @Farmaco,
                    completar hasta @VolumenFinalMl.ToString("0.##") ml con @Diluyente y administrar a @VelocidadMlHora.ToString("0.##") ml/h.
                    Etiquetar con concentración final, fecha/hora, paciente y responsables.
                </div>
                <div class="form-check mt-3"><input class="form-check-input" type="checkbox" @bind="VerificacionIndependiente" id="verif" /><label class="form-check-label fw-bold" for="verif">Cálculo, unidades y presentación verificados independientemente por un segundo profesional.</label></div>
                @if (!VerificacionIndependiente) { <div class="text-danger small mt-1">Resultado no liberado para preparación hasta completar la doble verificación.</div> }
            </div>
        </div>
    }
</div>

@code {
    private string Paciente="",Farmaco="",Diluyente="",Prescriptor="",UnidadDosis="mcg/kg/h",UnidadConcentracion="mcg/ml",Error="";
    private decimal PesoKg,VolumenFinalMl,VelocidadMlHora,Dosis,Concentracion; private bool VerificacionIndependiente; private CalculoResultado? Resultado;
    private sealed record CalculoResultado(decimal DuracionHoras,decimal CantidadActiva,string UnidadActiva,decimal VolumenFarmacoMl,decimal VolumenDiluyenteMl);

    private void Calcular()
    {
        Error="";Resultado=null;VerificacionIndependiente=false;
        if(PesoKg<=0||VolumenFinalMl<=0||VelocidadMlHora<=0||Dosis<=0||Concentracion<=0){Error="Todos los valores numéricos deben ser mayores que cero.";return;}
        bool dosisEq=UnidadDosis.StartsWith("mEq",StringComparison.Ordinal); bool concEq=UnidadConcentracion.StartsWith("mEq",StringComparison.Ordinal);
        if(dosisEq!=concEq){Error="La dosis en mEq debe utilizar una concentración en mEq/ml. Las dosis en mg o mcg requieren mg/ml o mcg/ml.";return;}
        decimal horas=VolumenFinalMl/VelocidadMlHora;
        decimal cantidadPorHora=Dosis*PesoKg;
        if(UnidadDosis.EndsWith("/min",StringComparison.Ordinal)) cantidadPorHora*=60m;
        if(UnidadDosis.EndsWith("/día",StringComparison.Ordinal)) cantidadPorHora/=24m;
        decimal cantidadBase=cantidadPorHora*horas;
        string unidad;
        decimal concentracionBase;
        if(dosisEq){unidad="mEq";concentracionBase=Concentracion;}
        else { cantidadBase*=UnidadDosis.StartsWith("mg",StringComparison.Ordinal)?1000m:1m; concentracionBase=Concentracion*(UnidadConcentracion.StartsWith("mg",StringComparison.Ordinal)?1000m:1m); unidad="mcg"; }
        decimal volumenFarmaco=cantidadBase/concentracionBase;
        if(volumenFarmaco>VolumenFinalMl){Error="El volumen calculado del fármaco supera el volumen final. Revise dosis, concentración, unidades y volumen de la mezcla.";return;}
        Resultado=new(horas,cantidadBase,unidad,volumenFarmaco,VolumenFinalMl-volumenFarmaco);
    }
    private void Limpiar(){Paciente=Farmaco=Diluyente=Prescriptor=Error="";PesoKg=VolumenFinalMl=VelocidadMlHora=Dosis=Concentracion=0;Resultado=null;VerificacionIndependiente=false;}
}
