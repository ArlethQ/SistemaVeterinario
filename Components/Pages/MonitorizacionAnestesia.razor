    private async Task BuscarServiciosAsync(string? texto)
    {
        try
        {
            var filtro = (texto ?? string.Empty).Trim();
            var idxComa = filtro.LastIndexOf(',');
            if (idxComa >= 0) filtro = filtro[(idxComa + 1)..].Trim();
            _sugerenciasServicios = (await GestionService.BuscarProcedimientosAsync(filtro)).Take(15).ToList();
        }
        catch { _sugerenciasServicios = []; }
    }

    private async Task AbrirSugerenciasProcPrincipalAsync() { await BuscarServiciosAsync(_dto.Procedimiento); _mostrarSugProcPrincipal = true; }
    private async Task OnProcPrincipalInputAsync() { _procDesdeProgramacion = false; await BuscarServiciosAsync(_dto.Procedimiento); _mostrarSugProcPrincipal = true; await GuardarBorradorAutoAsync(); }
    private async Task CerrarSugerenciasProcPrincipalAsync()
    {
        await Task.Delay(180);
        _mostrarSugProcPrincipal = false;
        if (_mostrarModalCambioProc) return;
        var actual = (_dto.Procedimiento ?? string.Empty).Trim();
        if (_idCirugiaActiva > 0 && !string.IsNullOrWhiteSpace(_procProgramadoOriginal) &&
            !string.IsNullOrWhiteSpace(actual) &&
            !string.Equals(actual, _procProgramadoOriginal.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            _procPendienteTexto = actual;
            _procPendienteId = null;
            _mostrarModalCambioProc = true;
            StateHasChanged();
        }
    }

    private async Task SeleccionarProcPrincipalAsync(SelectorClinicoDto s)
    {
        _mostrarSugProcPrincipal = false;
        var nuevo = (s.Descripcion ?? string.Empty).Trim();
        if (_idCirugiaActiva > 0 && !string.IsNullOrWhiteSpace(_procProgramadoOriginal) &&
            !string.Equals(nuevo, _procProgramadoOriginal.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            _dto.Procedimiento = nuevo;
            _procPendienteTexto = nuevo;
            _procPendienteId = s.Id > 0 ? s.Id : null;
            _mostrarModalCambioProc = true;
            return;
        }
        _dto.Procedimiento = nuevo;
        _procDesdeProgramacion = string.Equals(nuevo, _procProgramadoOriginal.Trim(), StringComparison.OrdinalIgnoreCase);
        await GuardarBorradorAutoAsync();
    }

    private async Task CancelarCambioProcAsync()
    {
        _mostrarModalCambioProc = false;
        _procPendienteTexto = string.Empty;
        _procPendienteId = null;
        if (!string.IsNullOrWhiteSpace(_procProgramadoOriginal))
        {
            _dto.Procedimiento = _procProgramadoOriginal;
            _procDesdeProgramacion = true;
            await GuardarBorradorAutoAsync();
        }
    }

    private async Task ConfirmarCambioProcAsync()
    {
        if (string.IsNullOrWhiteSpace(_procPendienteTexto)) { _mostrarModalCambioProc = false; return; }
        _cambiandoProc = true;
        var ok = await QuirofanoService.ActualizarProcedimientoCirugiaAsync(
            IdOrden,
            _idCirugiaActiva,
            _procPendienteId,
            _procPendienteTexto,
            Session.CurrentUser?.IdUsuario ?? 1);
        _cambiandoProc = false;
        _mostrarModalCambioProc = false;

        if (ok)
        {
            _dto.Procedimiento = _procPendienteTexto;
            _procProgramadoOriginal = _procPendienteTexto;
            _procDesdeProgramacion = true;
            _cirugiasOrden = await QuirofanoService.ObtenerResumenCirugiasOrdenAsync(IdOrden, Nhcl);
            _esError = false;
            _mensajeAlerta = $"Procedimiento actualizado a \"{_procPendienteTexto}\" en toda la operación.";
            await GuardarBorradorAutoAsync();
            if (OnGuardado.HasDelegate)
                await OnGuardado.InvokeAsync();
        }
        else
        {
            _esError = true;
            _mensajeAlerta = "No se pudo actualizar el procedimiento en la programación de cirugía.";
        }
    }

    private async Task AbrirSugerenciasProcAdicionalAsync() { await BuscarServiciosAsync(_dto.ProcedimientosAdicionales); _mostrarSugProcAdicional = true; }
    private async Task OnProcAdicionalInputAsync() { await BuscarServiciosAsync(_dto.ProcedimientosAdicionales); _mostrarSugProcAdicional = true; await GuardarBorradorAutoAsync(); }
    private async Task CerrarSugerenciasProcAdicionalAsync() { await Task.Delay(160); _mostrarSugProcAdicional = false; }
    private async Task SeleccionarProcAdicionalAsync(SelectorClinicoDto s)
    {
        var actual = (_dto.ProcedimientosAdicionales ?? string.Empty).Trim();
        var idxComa = actual.LastIndexOf(',');
        _dto.ProcedimientosAdicionales = idxComa >= 0
            ? $"{actual[..(idxComa + 1)].Trim()} {s.Descripcion}"
            : s.Descripcion;
        _mostrarSugProcAdicional = false;
        await GuardarBorradorAutoAsync();
    }

    private async Task AutollenarHoras5MinAsync()
    {
        if (_dto.Intervalos.Count == 0) return;
        var baseHora = TimeSpan.TryParse(_dto.Intervalos[0].Hora, out var parsed)
            ? parsed
            : new TimeSpan(DateTime.Now.Hour, (DateTime.Now.Minute / 5) * 5, 0);

        for (int i = 0; i < _dto.Intervalos.Count; i++)
        {
            var h = baseHora.Add(TimeSpan.FromMinutes(i * 5));
            _dto.Intervalos[i].Hora = $"{h.Hours:D2}:{h.Minutes:D2}";
        }
        await GuardarBorradorAutoAsync();
    }

