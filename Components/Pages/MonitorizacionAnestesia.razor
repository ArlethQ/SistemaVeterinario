    private static double MapY(decimal valor, int topPad, int rowH)
    {
        var v = Math.Clamp((double)valor, 0.0, 200.0);
        for (int i = 0; i < EscalaAva.Length - 1; i++)
        {
            double hi = EscalaAva[i];
            double lo = EscalaAva[i + 1];
            if (v <= hi && v >= lo)
            {
                double frac = (hi - v) / (hi - lo);
                return topPad + (i + frac) * rowH;
            }
        }
        return topPad + (EscalaAva.Length - 1) * rowH;
    }

    private string BuildPolylinePoints(Func<int, decimal?> selector, int leftPad, int colW, int topPad, int rowH)
    {
        var pts = new List<string>();
        for (int i = 0; i < _dto.Intervalos.Count; i++)
        {
            var v = selector(i);
            if (!v.HasValue) continue;
            var cx = leftPad + i * colW + colW / 2.0;
            var y = MapY(v.Value, topPad, rowH);
            pts.Add($"{F(cx)},{F(y)}");
        }
        return pts.Count >= 2 ? string.Join(" ", pts) : string.Empty;
    }

    private static string F(double v) => v.ToString("0.0", CultureInfo.InvariantCulture);
