@page "/contabilidad/inventarios/asignar-stock"
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.DTOs.EContax
@using Simetric.Services.EContax
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@attribute [AllowAnonymous]

<PageTitle>Asignar stock a productos | E-Contax</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <span class="text-uppercase text-primary fw-bold small">E-Contax · Carga de existencias</span>
            <h2 class="mb-0">Asignar stock a productos</h2>
            <small class="text-muted">Solo se muestran ítems categorizados como producto (sin servicios). Seleccione los que desee y cargue su existencia inicial.</small>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="IrAInventarios">
                <i class="bi bi-arrow-left me-1"></i>Inventario y kardex
            </button>
            <button type="button" class="btn btn-primary btn-sm fw-bold" @onclick="GuardarSeleccionadosAsync" disabled="@(_guardando || _cargando || !_puedeEditar || SeleccionadosCount == 0)">
                <i class="bi bi-floppy-fill me-1"></i>@(_guardando ? "Guardando..." : $"Guardar stock seleccionado ({SeleccionadosCount})")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="alert alert-success py-2">@_mensaje</div>
    }

    @if (_cargando)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <span class="spinner-border text-primary me-2"></span>
                <strong>Cargando productos disponibles...</strong>
            </div>
        </div>
    }
    else if (!_puedeEditar)
    {
        <div class="alert alert-warning">
            <i class="bi bi-lock-fill me-1"></i>Solo el administrador de la empresa puede inicializar o modificar el stock.
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Sucursal</label>
                        <select class="form-select form-select-sm" value="@_sucursalId" @onchange="CambiarSucursalAsync">
                            @foreach (var s in _sucursales)
                            {
                                <option value="@s.IdSucursal">@s.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Buscar producto</label>
                        <input class="form-control form-control-sm" placeholder="Nombre o código..." @bind="_filtroTexto" @bind:event="oninput" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Categoría</label>
                        <select class="form-select form-select-sm" @bind="_filtroCategoria">
                            <option value="">Todas las categorías</option>
                            @foreach (var cat in CategoriasDisponibles)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Estado de existencia</label>
                        <select class="form-select form-select-sm" @bind="_filtroExistencia">
                            <option value="TODOS">Todos los productos (@_filas.Count)</option>
                            <option value="SIN_EXISTENCIA">Sin existencia creada (@_filas.Count(f => !f.TieneExistencia))</option>
                            <option value="STOCK_CERO">Con stock en 0 (@_filas.Count(f => f.StockActual <= 0))</option>
                            <option value="CON_STOCK">Con stock &gt; 0 (@_filas.Count(f => f.StockActual > 0))</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:38px;" class="text-center">
                                <input type="checkbox" class="form-check-input" checked="@TodosVisiblesSeleccionados" @onchange="ToggleTodosVisibles" title="Seleccionar visibles" />
                            </th>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th class="text-end">Stock actual</th>
                            <th style="width:115px;">Cantidad (+)</th>
                            <th style="width:115px;">Costo unit.</th>
                            <th style="width:95px;">Mínimo</th>
                            <th style="width:95px;">Máximo</th>
                            <th style="width:120px;">Lote</th>
                            <th style="width:135px;">Vencimiento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilasFiltradas.Any())
                        {
                            <tr>
                                <td colspan="11" class="text-center text-muted py-4">No se encontraron productos con los filtros actuales.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var fila in FilasFiltradas)
                            {
                                <tr class="@(fila.Seleccionado ? "table-primary" : "")">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input" @bind="fila.Seleccionado" />
                                    </td>
                                    <td class="font-monospace small">@(string.IsNullOrWhiteSpace(fila.CodigoPrincipal) ? $"#{fila.CodigoProducto}" : fila.CodigoPrincipal)</td>
                                    <td>
                                        <div class="fw-semibold">@fila.NombreProducto</div>
                                        @if (!fila.TieneExistencia)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border" style="font-size:0.68rem;">Sin existencia</span>
                                        }
                                    </td>
                                    <td class="small text-muted">@fila.Categoria</td>
                                    <td class="text-end fw-bold @(fila.StockActual <= 0 ? "text-danger" : "text-success")">@fila.StockActual.ToString("N2")</td>
                                    <td>
                                        <input type="number" min="0" step="0.01" class="form-control form-control-sm text-end"
                                               value="@fila.Cantidad"
                                               @onchange="e => ActualizarCantidad(fila, e.Value)" />
                                    </td>
                                    <td>
                                        <input type="number" min="0" step="0.0001" class="form-control form-control-sm text-end"
                                               value="@fila.CostoUnitario"
                                               @onchange="e => ActualizarDecimal(e.Value, v => { fila.CostoUnitario = v; fila.Seleccionado = true; })" />
                                    </td>
                                    <td>
                                        <input type="number" min="0" step="0.01" class="form-control form-control-sm text-end"
                                               value="@fila.StockMinimo"
                                               @onchange="e => ActualizarDecimal(e.Value, v => { fila.StockMinimo = v; fila.Seleccionado = true; })" />
                                    </td>
                                    <td>
                                        <input type="number" min="0" step="0.01" class="form-control form-control-sm text-end"
                                               value="@fila.StockMaximo"
                                               @onchange="e => ActualizarDecimal(e.Value, v => { fila.StockMaximo = v; fila.Seleccionado = true; })" />
                                    </td>
                                    <td>
                                        <input type="text" maxlength="80" class="form-control form-control-sm" placeholder="Opcional"
                                               @bind="fila.NumeroLote" @bind:after="() => fila.Seleccionado = true" />
                                    </td>
                                    <td>
                                        <input type="date" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" class="form-control form-control-sm"
                                               @bind="fila.FechaVencimiento" @bind:after="() => fila.Seleccionado = true" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "productoId")] public int? ProductoId { get; set; }

    private int _usuarioId;
    private int _sucursalId;
    private bool _cargando = true;
    private bool _guardando;
    private bool _puedeEditar;
    private string? _error;
    private string? _mensaje;

    private string _filtroTexto = "";
    private string _filtroCategoria = "";
    private string _filtroExistencia = "TODOS";

    private List<EContaxSucursalDto> _sucursales = [];
    private List<FilaProductoStock> _filas = [];

    private int SeleccionadosCount => _filas.Count(f => f.Seleccionado);

    private IEnumerable<string> CategoriasDisponibles =>
        _filas.Select(f => f.Categoria)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c);

    private IEnumerable<FilaProductoStock> FilasFiltradas =>
        _filas.Where(f =>
            (string.IsNullOrWhiteSpace(_filtroTexto) ||
             (f.NombreProducto?.Contains(_filtroTexto.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
             (f.CodigoPrincipal?.Contains(_filtroTexto.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
             f.CodigoProducto.ToString().Contains(_filtroTexto.Trim())) &&
            (string.IsNullOrWhiteSpace(_filtroCategoria) ||
             string.Equals(f.Categoria, _filtroCategoria, StringComparison.OrdinalIgnoreCase)) &&
            (_filtroExistencia switch
            {
                "SIN_EXISTENCIA" => !f.TieneExistencia,
                "STOCK_CERO" => f.StockActual <= 0,
                "CON_STOCK" => f.StockActual > 0,
                _ => true
            }));

    private bool TodosVisiblesSeleccionados
    {
        get
        {
            var visibles = FilasFiltradas.ToList();
            return visibles.Count > 0 && visibles.All(f => f.Seleccionado);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _usuarioId = int.TryParse(user.FindFirst("IdUsuario")?.Value ?? user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : 0;
        if (_usuarioId <= 0)
        {
            _error = "Sesión no válida.";
            _cargando = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await CargarProductosAsync();
        if (ProductoId is > 0)
        {
            var objetivo = _filas.FirstOrDefault(f => f.CodigoProducto == ProductoId.Value);
            if (objetivo is not null)
            {
                _filtroTexto = string.IsNullOrWhiteSpace(objetivo.CodigoPrincipal)
                    ? objetivo.NombreProducto ?? objetivo.CodigoProducto.ToString()
                    : objetivo.CodigoPrincipal;
                objetivo.Seleccionado = true;
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarProductosAsync()
    {
        if (_usuarioId <= 0) return;
        _cargando = true;
        _error = null;
        try
        {
            var url = $"api/e-contax/inventarios/productos-disponibles?userId={_usuarioId}";
            if (_sucursalId > 0) url += $"&sucursalId={_sucursalId}";
            var resp = await Http.GetFromJsonAsync<EContaxProductosParaStockRespuestaDto>(url) ?? new();
            _puedeEditar = resp.PuedeEditar;
            _sucursales = resp.Sucursales;
            _sucursalId = resp.IdSucursalActiva;
            _filas = resp.Productos.Select(p => new FilaProductoStock
            {
                CodigoProducto = p.CodigoProducto,
                CodigoPrincipal = p.CodigoPrincipal,
                NombreProducto = p.NombreProducto,
                Categoria = p.Categoria ?? "General",
                StockActual = p.StockActual,
                StockMinimo = p.StockMinimo,
                StockMaximo = p.StockMaximo,
                CostoUnitario = p.CostoReferencia,
                TieneExistencia = p.TieneExistencia
            }).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CambiarSucursalAsync(ChangeEventArgs e)
    {
        _sucursalId = int.TryParse(e.Value?.ToString(), out int id) ? id : 0;
        await CargarProductosAsync();
    }

    private void ToggleTodosVisibles(ChangeEventArgs e)
    {
        bool marcar = e.Value is bool b && b;
        foreach (var fila in FilasFiltradas)
            fila.Seleccionado = marcar;
    }

    private static void ActualizarCantidad(FilaProductoStock fila, object? val)
    {
        if (decimal.TryParse(val?.ToString(), out decimal cant) && cant >= 0)
        {
            fila.Cantidad = cant;
            if (cant > 0) fila.Seleccionado = true;
        }
    }

    private static void ActualizarDecimal(object? val, Action<decimal> asignar)
    {
        if (decimal.TryParse(val?.ToString(), out decimal num) && num >= 0)
            asignar(num);
    }

    private async Task GuardarSeleccionadosAsync()
    {
        var seleccionados = _filas.Where(f => f.Seleccionado).ToList();
        if (seleccionados.Count == 0)
        {
            _error = "Seleccione al menos un producto.";
            return;
        }

        _guardando = true;
        _error = null;
        _mensaje = null;
        try
        {
            var payload = seleccionados.Select(f => new EContaxInicializarStockItemDto
            {
                CodigoProducto = f.CodigoProducto,
                IdSucursal = _sucursalId,
                Cantidad = f.Cantidad,
                CostoUnitario = f.CostoUnitario,
                StockMinimo = f.StockMinimo,
                StockMaximo = f.StockMaximo,
                NumeroLote = string.IsNullOrWhiteSpace(f.NumeroLote) ? null : f.NumeroLote.Trim(),
                FechaVencimiento = f.FechaVencimiento,
                Observacion = "Asignación de stock desde catálogo de productos"
            }).ToList();

            var response = await Http.PostAsJsonAsync($"api/e-contax/inventarios/inicializar-stock?userId={_usuarioId}", payload);
            if (!response.IsSuccessStatusCode)
            {
                _error = await response.Content.ReadAsStringAsync();
                return;
            }

            var procesados = await response.Content.ReadFromJsonAsync<int>();
            _mensaje = $"Stock actualizado correctamente para {procesados} producto(s).";
            await CargarProductosAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private void IrAInventarios() => NavManager.NavigateTo(EContaxRoutes.Inventarios);

    private sealed class FilaProductoStock
    {
        public bool Seleccionado { get; set; }
        public int CodigoProducto { get; set; }
        public string? CodigoPrincipal { get; set; }
        public string? NombreProducto { get; set; }
        public string Categoria { get; set; } = "General";
        public decimal StockActual { get; set; }
        public decimal Cantidad { get; set; }
        public decimal CostoUnitario { get; set; }
        public decimal StockMinimo { get; set; }
        public decimal StockMaximo { get; set; }
        public string? NumeroLote { get; set; }
        public DateTime? FechaVencimiento { get; set; }
        public bool TieneExistencia { get; set; }
    }
}
