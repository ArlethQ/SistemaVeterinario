                                    table.Cell().Element(Td).AlignRight().Text(m.EsEntrada ? $"+{m.Cantidad:N2}" : "").FontSize(7).FontColor("#15803d");
                                    table.Cell().Element(Td).AlignRight().Text(!m.EsEntrada ? $"-{m.Cantidad:N2}" : "").FontSize(7).FontColor("#b91c1c");
                                    table.Cell().Element(Td).AlignRight().Text(m.SaldoCantidad.ToString("N2")).Bold().FontSize(7);
                                    table.Cell().Element(Td).Text(string.IsNullOrWhiteSpace(m.Observacion) ? "-" : m.Observacion).FontSize(7).FontColor("#475569");
                                }
                            });
                        }

                        // Bloque de firmas
                        col.Item().PaddingTop(24).Row(row =>
                        {
                            row.Spacing(40);
                            row.RelativeItem().Column(c =>
                            {
                                c.Item().BorderBottom(1).BorderColor("#475569").Height(24);
                                c.Item().PaddingTop(3).AlignCenter().Text("Responsable de Farmacia / Bodega").Bold().FontSize(8);
                                c.Item().AlignCenter().Text($"Emitido por: {emisor}").FontSize(7).FontColor("#64748b");
                            });
                            row.RelativeItem().Column(c =>
                            {
                                c.Item().BorderBottom(1).BorderColor("#475569").Height(24);
                                c.Item().PaddingTop(3).AlignCenter().Text("Director Técnico / Médico Veterinario Responsable").Bold().FontSize(8);
                                c.Item().AlignCenter().Text("Firma y Sello · Control ARCSA").FontSize(7).FontColor("#64748b");
                            });
                        });
                    });

                    page.Footer().AlignRight().Text(t =>
                    {
                        t.Span("Informe de Medicamentos Sujetos a Fiscalización · Página ").FontSize(7.5f).FontColor("#64748b");
                        t.CurrentPageNumber().FontSize(7.5f).FontColor("#334155").Bold();
                        t.Span(" de ").FontSize(7.5f).FontColor("#64748b");
                        t.TotalPages().FontSize(7.5f).FontColor("#334155").Bold();
                    });
                });
            }).GeneratePdf();

            var nombre = $"Informe_Fiscalizacion_{_desde:yyyyMMdd}_{_hasta:yyyyMMdd}.pdf";
            await JS.InvokeVoidAsync("hosvetDownloadFile", nombre, "application/pdf", Convert.ToBase64String(pdfBytes));
        }
        catch (Exception ex)
        {
            _error = $"No se pudo generar el informe PDF: {ex.Message}";
        }
    }
}
