                                    table.Cell().Element(Td).Text(m.Sucursal).FontSize(7).FontColor("#475569");
                                    table.Cell().Element(Td).Text(m.TipoMovimiento).Bold().FontSize(7).FontColor(m.EsEntrada ? "#15803d" : "#b91c1c");
                                    table.Cell().Element(Td).Text(loteTxt).FontSize(7);
