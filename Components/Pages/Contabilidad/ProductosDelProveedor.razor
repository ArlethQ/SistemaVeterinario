@using Simetric.Services.EContax
@using Simetric.DTOs
@using Simetric.DTOs.EContax
@inject EContaxCatalogService Catalogo
@inject ILogger<ProductosDelProveedor> Logger
@implements IDisposable

<section class="border rounded p-3 my-3">
    <h5>Productos que vende el proveedor</h5>
    <div class="row g-2 mb-3">
        <div class="col-md-8">
            <label class="form-label">Buscar producto del catálogo</label>
            <input class="form-control" @bind="_busqueda" @bind:event="oninput" disabled="@Deshabilitado" placeholder="Nombre, código interno o código comercial" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="button" class="btn btn-outline-primary" disabled="@(_buscando || Deshabilitado)" @onclick="BuscarAsync">
                @(_buscando ? "Buscando…" : "Buscar")
            </button>
        </div>
    </div>
    @if (_mensaje is not null)
    {
        <p class="@(_error ? "text-danger" : "text-muted")" role="status">@_mensaje</p>
    }
    @foreach (var item in Items)
    {
        <div @key="item" class="row g-2 border rounded p-2 mb-2">
            <div class="col-12">
                <label class="form-label">Producto</label>
                <select class="form-select" @bind="item.ProductoId" @bind:after="() => Seleccionar(item)" disabled="@Deshabilitado">
                    <option value="0">Seleccione un producto</option>
                    @if (item.ProductoId > 0 && !_resultados.Any(p => p.Codproducto == item.ProductoId))
                    {
                        <option value="@item.ProductoId">#@item.ProductoId — @item.Nombre</option>
                    }
                    @foreach (var producto in _resultados)
                    {
                        <option value="@producto.Codproducto">#@producto.Codproducto · @producto.Codprincipal — @producto.Descripcion</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Código del proveedor</label>
                <input class="form-control" maxlength="100" @bind="item.CodigoProveedor" disabled="@Deshabilitado" />
            </div>
            <div class="col-md-5">
                <label class="form-label">Precio de compra (USD)</label>
                <input type="number" class="form-control" min="0" max="99999999999999.9999" step="0.0001" @bind="item.PrecioCompra" disabled="@Deshabilitado" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-danger" disabled="@Deshabilitado" @onclick="() => Items.Remove(item)">Quitar</button>
            </div>
        </div>
    }
    <button type="button" class="btn btn-outline-primary" disabled="@Deshabilitado" @onclick="Agregar">Agregar otro producto</button>
    <p class="small text-muted mt-2 mb-0">Los productos y precios se guardan al guardar el proveedor.</p>
</section>

@code {
    [Parameter, EditorRequired] public List<EContaxProductoOfrecidoDto> Items { get; set; } = default!;
    [Parameter, EditorRequired] public int UsuarioId { get; set; }
    [Parameter] public bool Deshabilitado { get; set; }

    private List<ProductoLookupDetalleDto> _resultados = [];
    private string _busqueda = "";
    private bool _buscando;
    private bool _error;
    private bool _disposed;
    private string? _mensaje;

    protected override async Task OnInitializedAsync()
    {
        if (Items.Count == 0) Agregar();
        await BuscarAsync();
    }

    private void Agregar() => Items.Add(new EContaxProductoOfrecidoDto());

    private void Seleccionar(EContaxProductoOfrecidoDto item)
    {
        item.Nombre = _resultados.FirstOrDefault(p => p.Codproducto == item.ProductoId)?.Descripcion;
    }

    private async Task BuscarAsync()
    {
        _buscando = true;
        _error = false;
        _mensaje = null;
        try
        {
            var resultados = await Catalogo.BuscarProductosFiltroAsync(UsuarioId, _busqueda.Trim());
            if (_disposed) return;
            _resultados = resultados;
            _mensaje = resultados.Count == 0
                ? "No se encontraron productos. Revise el nombre o código y que el producto esté activo en el catálogo de esta empresa."
                : null;
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            Logger.LogWarning(ex, "No se pudo buscar el catálogo de productos del proveedor.");
            _error = true;
            _mensaje = "No se pudo cargar el catálogo. Vuelva a pulsar Buscar.";
        }
        finally { _buscando = false; }
    }

    public void Dispose() => _disposed = true;
}
