@page "/contabilidad/libros/estado-resultados"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Simetric.Services
@using Simetric.Services.EContax
@attribute [Authorize]
@inject EContaxContabilidadService ContabilidadService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Estado de Resultados | e-ForVets</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h4 class="mb-0 fw-bold"><i class="bi bi-graph-up me-2 text-primary"></i>Estado de Resultados (Pérdidas y Ganancias)</h4>
            <small class="text-muted">Ingresos operacionales, costos, gastos y utilidad neta del período.</small>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <input type="date" class="form-control form-control-sm" @bind="desde" />
            <input type="date" class="form-control form-control-sm" @bind="hasta" />
            <button class="btn btn-primary btn-sm" @onclick="CargarAsync">Consultar</button>
            <button class="btn btn-outline-success btn-sm app-doc-action app-doc-excel" @onclick="ExportarExcelAsync"><i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>Excel</button>
        </div>
    </div>

    @if (data is not null)
    {
        <div class="row g-3 mb-3">
            <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Ingresos</small><h5 class="mb-0 text-success fw-bold">$@data.TotalIngresos.ToString("N2")</h5></div></div></div>
            <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Costos</small><h5 class="mb-0 text-warning fw-bold">$@data.TotalCostos.ToString("N2")</h5></div></div></div>
            <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Gastos</small><h5 class="mb-0 text-danger fw-bold">$@data.TotalGastos.ToString("N2")</h5></div></div></div>
            <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><small class="text-muted">Utilidad / Pérdida Neta</small><h5 class="mb-0 @(data.UtilidadNeta >= 0 ? "text-primary" : "text-danger") fw-bold">$@data.UtilidadNeta.ToString("N2")</h5></div></div></div>
        </div>

        <div class="card border-0 shadow-sm">
            <table class="table table-sm mb-0">
                <thead class="table-light"><tr><th>Grupo</th><th>Código</th><th>Cuenta</th><th class="text-end">Valor</th></tr></thead>
                <tbody>
                    @foreach (var r in data.Ingresos)
                    {
                        <tr><td><span class="badge bg-success-subtle text-success">INGRESO</span></td><td><code>@r.Codigo</code></td><td>@r.Nombre</td><td class="text-end">$@r.Saldo.ToString("N2")</td></tr>
                    }
                    @foreach (var r in data.Costos)
                    {
                        <tr><td><span class="badge bg-warning-subtle text-warning">COSTO</span></td><td><code>@r.Codigo</code></td><td>@r.Nombre</td><td class="text-end">$@r.Saldo.ToString("N2")</td></tr>
                    }
                    @foreach (var r in data.Gastos)
                    {
                        <tr><td><span class="badge bg-danger-subtle text-danger">GASTO</span></td><td><code>@r.Codigo</code></td><td>@r.Nombre</td><td class="text-end">$@r.Saldo.ToString("N2")</td></tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr><td colspan="3" class="text-end">UTILIDAD NETA DEL PERÍODO:</td><td class="text-end @(data.UtilidadNeta >= 0 ? "text-success" : "text-danger")">$@data.UtilidadNeta.ToString("N2")</td></tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@code {
    private int currentUserId;
    private DateTime desde = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime hasta = DateTime.Today;
    private EContaxContabilidadService.EstadoResultadosResultDto? data;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id) ? id : 0;
        if (currentUserId <= 0) { Navigation.NavigateTo("/login", true); return; }
        await CargarAsync();
    }

    private async Task CargarAsync() => data = await ContabilidadService.ObtenerEstadoResultadosAsync(currentUserId, desde, hasta);

    private async Task ExportarExcelAsync()
    {
        if (data is null) return;
        var filas = data.Ingresos.Concat(data.Costos).Concat(data.Gastos)
            .Select(r => new Dictionary<string, object?> { ["Tipo"] = r.TipoCuenta, ["Codigo"] = r.Codigo, ["Cuenta"] = r.Nombre, ["Valor"] = r.Saldo })
            .ToList();
        filas.Add(new Dictionary<string, object?> { ["Tipo"] = "RESULTADO", ["Codigo"] = "NETO", ["Cuenta"] = "Utilidad / Pérdida Neta", ["Valor"] = data.UtilidadNeta });
        using var ms = new MemoryStream();
        await MiniExcelLibs.MiniExcel.SaveAsAsync(ms, filas);
        await JS.InvokeVoidAsync("hosvetDownloadFile", $"EstadoResultados_{desde:yyyyMMdd}_{hasta:yyyyMMdd}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(ms.ToArray()));
    }
}
