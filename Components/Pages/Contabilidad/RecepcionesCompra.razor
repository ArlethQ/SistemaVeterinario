@page "/contabilidad/compras/recepciones"
@page "/contabilidad/compras/recepciones/nueva"
@using System.Net.Http.Json
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Simetric.DTOs.EContax
@using Simetric.Services
@using Simetric.Services.EContax
@using HosvetKardex.Web.Services
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject ISimpleExcelExportService ExcelExportService
@inject EContaxInventarioService InventarioService
@inject EContaxBodegaService BodegaService
@inject SessionStateService Session

<PageTitle>Recepciones de compra | E-Contax</PageTitle>
<link rel="stylesheet" href="/_content/Simetric/css/econtax-compras.css?v=20261023-compras-buttons" />
<style>
    .homol-backdrop {
        position: fixed;
        inset: 0;
        z-index: 2990;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: .75rem;
        background: rgba(15, 23, 42, .56);
        backdrop-filter: blur(4px);
    }

    .homol-modal {
        width: min(1480px, calc(100vw - 1.5rem));
        max-height: calc(100vh - 1.5rem);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 24px 60px rgba(15, 23, 42, .30);
        border: 1px solid #dbe6f2;
    }

    .homol-modal *, .homol-modal *::before, .homol-modal *::after {
        box-sizing: border-box;
    }

    .homol-header {
        flex: 0 0 auto;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: .95rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(180deg, #ffffff, #f8fbff);
    }

    .homol-toolbar {
        flex: 0 0 auto;
        display: grid;
        grid-template-columns: minmax(180px, 240px) minmax(0, 1fr) auto;
        gap: .9rem;
        align-items: start;
        padding: .85rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: #f1f6fb;
    }

    .homol-toolbar > div { min-width: 0; }

    .homol-body {
        flex: 1 1 auto;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 1rem 1.35rem;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        gap: .9rem;
    }

    .homol-card {
        background: #ffffff;
        border: 1px solid #dbe5f0;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .04);
        overflow: hidden;
    }

    .homol-card-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: .65rem 1rem;
        padding: .65rem 1rem;
        background: #f8fbff;
        border-bottom: 1px solid #e2e8f0;
    }

    .homol-card-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .65rem;
        min-width: 0;
    }

    .homol-item-bodega {
        display: flex;
        align-items: center;
        gap: .4rem;
        min-width: 220px;
        max-width: 300px;
    }

    .homol-item-bodega select {
        min-width: 0;
        width: 100%;
    }

    .homol-mode-group {
        display: inline-flex;
        flex-wrap: nowrap;
        flex: 0 0 auto;
    }

    .homol-mode-group .btn {
        white-space: nowrap;
        font-size: .8rem;
        padding: .32rem .68rem;
    }

    .homol-card-body {
        padding: .9rem 1rem;
        display: flex;
        flex-direction: column;
        gap: .85rem;
    }

    .homol-compare-grid {
        display: grid;
        grid-template-columns: minmax(260px, 4.5fr) minmax(0, 7.5fr);
        gap: .9rem;
        align-items: stretch;
    }

    .homol-compare-grid > div { min-width: 0; }

    .homol-box {
        height: 100%;
        padding: .85rem 1rem;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        min-width: 0;
    }

    .homol-box-invoice { background: #f8fafc; }
    .homol-box-target { background: #ffffff; }

    .homol-box-label {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: .45rem;
    }

    .homol-new-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
        gap: .65rem .8rem;
        align-items: start;
    }

    .homol-new-grid > div { min-width: 0; }

    .homol-stock-grid {
        display: grid;
        grid-template-columns: minmax(150px, 1.2fr) minmax(125px, 1fr) minmax(125px, 1fr) minmax(135px, 1fr) minmax(155px, 1.1fr);
        gap: .75rem;
        align-items: start;
        padding-top: .8rem;
        border-top: 1px solid #e2e8f0;
    }

    .homol-stock-grid > div { min-width: 0; }

    .homol-field-label {
        display: block;
        font-size: .72rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: .3rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .homol-modal .form-control,
    .homol-modal .form-select {
        width: 100%;
        max-width: 100%;
        min-height: 36px;
        font-size: .85rem;
    }

    .homol-footer {
        flex: 0 0 auto;
        border-top: 1px solid #e2e8f0;
        background: #ffffff;
        padding: .85rem 1.35rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    @@media (max-width: 1024px) {
        .homol-toolbar { grid-template-columns: 1fr; }
        .homol-compare-grid { grid-template-columns: 1fr; }
        .homol-stock-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media (max-width: 640px) {
        .homol-new-grid,
        .homol-stock-grid { grid-template-columns: 1fr; }
        .homol-item-bodega { width: 100%; max-width: none; }
    }
</style>

<div class="container-fluid py-4 purchase-receptions-page purchase-flow-shell">
    <header class="purchase-hero">
        <div class="purchase-hero-copy">
            <div class="purchase-hero-icon purchase-hero-icon-reception"><i class="ri-inbox-archive-line"></i></div>
            <div>
                <span class="purchase-eyebrow">ABASTECIMIENTO · E-CONTAX · <strong class="text-primary">SUCURSAL: @NombreSucursalActiva.ToUpperInvariant()</strong></span>
                <h1>Recepciones de compra</h1>
                <p>Registra lo recibido, homologa facturas a tus productos y controla la bodega de ingreso en la sucursal activa.</p>
            </div>
        </div>
        <div class="purchase-hero-actions">
            <button class="purchase-secondary-btn" type="button" @onclick='() => NavManager.NavigateTo("/contabilidad/compras/ordenes")'><i class="ri-file-list-3-line"></i><span>Órdenes</span></button>
            <button class="purchase-primary-btn" type="button" @onclick="AbrirNuevaAsync" disabled="@cargando"><i class="ri-add-line"></i><span>Nueva recepción</span></button>
        </div>
    </header>

    <nav class="purchase-flow-steps" aria-label="Flujo de compras">
        <button type="button" class="purchase-flow-step is-done" @onclick='() => NavManager.NavigateTo("/contabilidad/proveedores")'><span>1</span><strong>Proveedores</strong></button>
        <i class="ri-arrow-right-line"></i>
        <button type="button" class="purchase-flow-step is-done" @onclick='() => NavManager.NavigateTo("/contabilidad/compras/ordenes")'><span>2</span><strong>Orden de compra</strong></button>
        <i class="ri-arrow-right-line"></i>
        <button type="button" class="purchase-flow-step is-active" aria-current="step" disabled><span>3</span><strong>Recepción</strong></button>
    </nav>

    <section class="purchase-kpis" aria-label="Resumen de recepciones">
        <article class="purchase-kpi"><span><i class="ri-draft-line"></i>Por homologar</span><strong>@comprasPendientes.Count</strong><small>Facturas pendientes de ingreso</small></article>
        <article class="purchase-kpi purchase-kpi-success"><span><i class="ri-checkbox-circle-line"></i>Ingresadas / Completas</span><strong>@(TotalCompletas + comprasIngresadas.Count)</strong><small>@comprasIngresadas.Count factura(s) · @TotalCompletas orden(es)</small></article>
        <article class="purchase-kpi purchase-kpi-info"><span><i class="ri-pie-chart-line"></i>Borradores / Parciales</span><strong>@(TotalBorradores + TotalParciales)</strong><small>Órdenes pendientes o parciales</small></article>
        <article class="purchase-kpi purchase-kpi-total"><span><i class="ri-inbox-line"></i>Unidades recibidas</span><strong>@((TotalRecibido + comprasIngresadas.Sum(x => x.TotalCantidad)).ToString("0.####"))</strong><small>@(recepciones.Count + comprasIngresadas.Count) ingreso(s)</small></article>
    </section>

    @if (!mostrarEditor && !string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="card shadow-sm mb-3 purchase-filter-card">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-6 col-lg-5">
                    <label class="form-label">Buscar</label>
                    <input class="form-control" @bind="filtro" @bind:event="oninput" placeholder="Recepción, orden o proveedor" />
                </div>
                <div class="col-md-3 col-lg-2">
                    <label class="form-label">Estado</label>
                    <select class="form-select" @bind="estadoFiltro">
                        <option value="">Todos</option>
                        <option value="BORRADOR">Borrador</option>
                        <option value="RECIBIDA_PARCIAL">Recibida parcial</option>
                        <option value="RECIBIDA_COMPLETA">Recibida completa</option>
                        <option value="ANULADA">Anulada</option>
                    </select>
                </div>
                <div class="col-md-3 col-lg-2">
                    <label class="form-label">Desde</label>
                    <input class="form-control" type="date" @bind="fechaDesde" />
                </div>
                <div class="col-md-3 col-lg-2">
                    <label class="form-label">Hasta</label>
                    <input class="form-control" type="date" @bind="fechaHasta" />
                </div>
                <div class="col-md-3 col-lg-2">
                    <label class="form-label">Ordenar por</label>
                    <select class="form-select" @bind="ordenListado" @bind:after="ReiniciarPaginacion">
                        <option value="fecha-desc">Más recientes</option>
                        <option value="fecha-asc">Más antiguas</option>
                        <option value="cantidad-desc">Mayor cantidad</option>
                        <option value="cantidad-asc">Menor cantidad</option>
                        <option value="estado">Estado</option>
                    </select>
                </div>
                <div class="col-md-3 col-lg-2">
                    <button class="purchase-secondary-btn purchase-filter-btn" type="button" @onclick="CargarAsync" disabled="@cargando">
                        <i class="ri-search-line"></i><span>Consultar</span>
                    </button>
                </div>
                <div class="col-md-3 col-lg-2">
                    <button class="purchase-primary-btn purchase-filter-btn" type="button" @onclick="ExportarExcelAsync" disabled="@(cargando || recepciones.Count == 0)"><i class="ri-file-excel-2-line"></i><span>Excel</span></button>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-pills gap-2 mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button type="button"
                    class="btn @(tabActiva == "pendientes" ? "btn-primary" : "btn-outline-secondary") d-inline-flex align-items-center gap-2"
                    @onclick='() => tabActiva = "pendientes"'>
                <i class="ri-links-line"></i>
                <span>Facturas por homologar</span>
                <span class="badge @(tabActiva == "pendientes" ? "bg-white text-primary" : "bg-secondary-subtle text-dark")">@ComprasPendientesFiltradas.Count()</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button"
                    class="btn @(tabActiva == "registradas" ? "btn-primary" : "btn-outline-secondary") d-inline-flex align-items-center gap-2"
                    @onclick='() => tabActiva = "registradas"'>
                <i class="ri-inbox-archive-line"></i>
                <span>Recepciones registradas</span>
                <span class="badge @(tabActiva == "registradas" ? "bg-white text-primary" : "bg-secondary-subtle text-dark")">@(recepciones.Count + ComprasIngresadasFiltradas.Count())</span>
            </button>
        </li>
    </ul>

    @if (tabActiva == "pendientes")
    {
        <div class="card shadow-sm purchase-table-card">
            <div class="purchase-table-heading">
                <div>
                    <span>COMPRAS REGISTRADAS · SUCURSAL @NombreSucursalActiva.ToUpperInvariant() · PENDIENTES DE INGRESO</span>
                    <h2>Facturas por homologar</h2>
                </div>
                <span class="purchase-count">@ComprasPendientesFiltradas.Count() pendiente@(ComprasPendientesFiltradas.Count() == 1 ? string.Empty : "s")</span>
            </div>
            <div class="px-3 pt-2 pb-2 border-bottom bg-light-subtle">
                <input class="form-control form-control-sm" @bind="filtroComprasPendientes" @bind:event="oninput" placeholder="Buscar factura, proveedor o RUC..." />
            </div>
            @if (!string.IsNullOrWhiteSpace(mensajeHomologacion))
            {
                <div class="alert alert-success m-3 mb-0 py-2" role="alert">@mensajeHomologacion</div>
            }
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 purchase-data-table">
                    <thead>
                        <tr><th>Factura</th><th>Fecha</th><th>Proveedor</th><th>RUC</th><th class="text-center">Ítems</th><th class="text-end">Total</th><th class="text-end">Acción</th></tr>
                    </thead>
                    <tbody>
                        @if (cargandoComprasPendientes)
                        {
                            <tr><td colspan="7"><div class="purchase-table-state"><i class="ri-loader-4-line"></i><span>Cargando compras pendientes...</span></div></td></tr>
                        }
                        else if (!ComprasPendientesFiltradas.Any())
                        {
                            <tr><td colspan="7"><div class="purchase-table-state is-empty"><i class="ri-checkbox-circle-line"></i><span>No hay compras registradas pendientes de ingreso en @NombreSucursalActiva.</span></div></td></tr>
                        }
                        else
                        {
                            @foreach (var compra in ComprasPendientesFiltradas)
                            {
                                <tr @key="compra.CodFactura">
                                    <td>
                                        <strong class="font-monospace">@compra.NumeroDocumento</strong>
                                        @if (facturasConBorrador.Contains(compra.CodFactura))
                                        {
                                            <span class="badge bg-warning-subtle text-dark border ms-1" title="Tienes cambios guardados en borrador"><i class="ri-draft-line me-1"></i>Borrador</span>
                                        }
                                    </td>
                                    <td>@(compra.FechaEmision?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td>@compra.Proveedor</td>
                                    <td class="font-monospace">@compra.RucProveedor</td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@compra.Detalles.Count ítem(s)</span></td>
                                    <td class="text-end fw-semibold">$@compra.ValorTotal.ToString("N2")</td>
                                    <td class="text-end text-nowrap">
                                        <button class="purchase-table-btn is-primary" type="button" @onclick="() => AbrirHomologacionAsync(compra)">
                                            <i class="ri-links-line"></i><span>Homologar e ingresar</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm purchase-table-card mb-3">
            <div class="purchase-table-heading">
                <div>
                    <span>FACTURAS HOMOLOGADAS · INGRESADAS A INVENTARIO (@NombreSucursalActiva.ToUpperInvariant())</span>
                    <h2>Compras ingresadas a inventario</h2>
                </div>
                <span class="purchase-count">@ComprasIngresadasFiltradas.Count() ingreso@(ComprasIngresadasFiltradas.Count() == 1 ? string.Empty : "s")</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 purchase-data-table">
                    <thead>
                        <tr><th>Factura</th><th>Proveedor</th><th>Fecha</th><th>Bodega(s)</th><th class="text-end">Cant.</th><th class="text-end">Total</th><th>Estado</th><th class="text-end">Detalle</th></tr>
                    </thead>
                    <tbody>
                        @if (cargandoComprasPendientes)
                        {
                            <tr><td colspan="8"><div class="purchase-table-state"><i class="ri-loader-4-line"></i><span>Cargando compras ingresadas...</span></div></td></tr>
                        }
                        else if (!ComprasIngresadasFiltradas.Any())
                        {
                            <tr><td colspan="8"><div class="purchase-table-state is-empty"><i class="ri-inbox-line"></i><span>Aún no hay facturas homologadas e ingresadas para los filtros actuales.</span></div></td></tr>
                        }
                        else
                        {
                            @foreach (var compIng in ComprasIngresadasFiltradas)
                            {
                                <tr @key="compIng.CodFactura">
                                    <td><strong class="font-monospace">@compIng.NumeroDocumento</strong></td>
                                    <td>
                                        <div>@compIng.Proveedor</div>
                                        <small class="text-muted font-monospace">@compIng.RucProveedor</small>
                                    </td>
                                    <td>@(compIng.FechaEmision?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td><span class="badge bg-info-subtle text-info-emphasis border">@compIng.BodegaResumen</span></td>
                                    <td class="text-end">@compIng.TotalCantidad.ToString("0.####")</td>
                                    <td class="text-end fw-semibold">$@compIng.ValorTotal.ToString("N2")</td>
                                    <td><span class="badge text-bg-success">Ingresada</span></td>
                                    <td class="text-end">
                                        <button type="button" class="purchase-table-btn is-primary" @onclick="() => ToggleDetalleCompraIngresada(compIng.CodFactura)">
                                            <i class="ri-eye-line"></i><span>@(compraIngresadaExpandidaId == compIng.CodFactura ? "Ocultar" : "Ver detalle")</span>
                                        </button>
                                    </td>
                                </tr>
                                @if (compraIngresadaExpandidaId == compIng.CodFactura)
                                {
                                    <tr>
                                        <td colspan="8" class="bg-light p-3">
                                            <div class="table-responsive">
                                                <table class="table table-sm mb-0 bg-white border rounded">
                                                    <thead class="table-light">
                                                        <tr><th>Ítem factura</th><th>Producto homologado en inventario</th><th>Bodega</th><th class="text-end">Cant.</th><th class="text-end">Costo unit.</th><th class="text-end">Total</th></tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var det in compIng.Detalles)
                                                        {
                                                            <tr @key="det.CodLinea">
                                                                <td>@det.DescripcionFactura</td>
                                                                <td>@det.ProductoInventario</td>
                                                                <td>@(string.IsNullOrWhiteSpace(det.Bodega) ? "—" : det.Bodega)</td>
                                                                <td class="text-end">@det.Cantidad.ToString("0.####")</td>
                                                                <td class="text-end">$@det.PrecioUnitario.ToString("N4")</td>
                                                                <td class="text-end">$@det.ValorTotal.ToString("N2")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm purchase-table-card">
            <div class="purchase-table-heading"><div><span>TRAZABILIDAD DE ÓRDENES DE COMPRA</span><h2>Recepciones de órdenes registradas</h2></div><span class="purchase-count">@recepciones.Count registro@(recepciones.Count == 1 ? string.Empty : "s")</span></div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 purchase-data-table">
                    <thead>
                        <tr><th>Recepción</th><th>Orden</th><th>Proveedor</th><th>Fecha</th><th>Estado</th><th class="text-end">Cantidad</th><th class="text-end">Acciones</th></tr>
                    </thead>
                    <tbody>
                        @if (cargando)
                        {
                            <tr><td colspan="7"><div class="purchase-table-state" aria-live="polite"><i class="ri-loader-4-line"></i><span>Cargando recepciones...</span></div></td></tr>
                        }
                        else if (recepciones.Count == 0)
                        {
                            <tr><td colspan="7"><div class="purchase-table-state is-empty" aria-live="polite"><i class="ri-inbox-line"></i><span>No hay recepciones de órdenes para los filtros seleccionados.</span></div></td></tr>
                        }
                        else
                        {
                            @foreach (var recepcion in RecepcionesPagina)
                            {
                                <tr @key="recepcion.IdRecepcion">
                                    <td><strong>@recepcion.NumeroRecepcion</strong><small class="d-block text-muted">@recepcion.Lineas línea(s)</small></td>
                                    <td>@recepcion.NumeroOrden</td>
                                    <td>@recepcion.NombreProveedor</td>
                                    <td>@recepcion.FechaRecepcion.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge @ClaseEstado(recepcion.Estado)">@TextoEstado(recepcion.Estado)</span></td>
                                    <td class="text-end">@recepcion.TotalRecibido.ToString("0.####")</td>
                                    <td class="text-end text-nowrap"><div class="purchase-table-actions">
                                        <button class="purchase-table-btn is-primary" type="button" @onclick="() => EditarAsync(recepcion.IdRecepcion)"><i class="ri-eye-line"></i><span>Ver / editar</span></button>
                                        @if (recepcion.Estado == "BORRADOR")
                                        {
                                            <button class="purchase-table-btn is-success" type="button" @onclick="() => ConfirmarAsync(recepcion.IdRecepcion)"><i class="ri-checkbox-circle-line"></i><span>Confirmar</span></button>
                                        }
                                        @if (recepcion.Estado is "BORRADOR" or "RECIBIDA_PARCIAL" or "RECIBIDA_COMPLETA")
                                        {
                                            <button class="purchase-table-btn is-danger" type="button" @onclick="() => AnularAsync(recepcion.IdRecepcion)"><i class="ri-close-circle-line"></i><span>Anular</span></button>
                                        }
                                    </div></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (!cargando && recepciones.Count > 0)
            {
                <div class="purchase-pagination" aria-label="Paginación de recepciones">
                    <span>Mostrando @PrimerRegistroPagina–@UltimoRegistroPagina de @recepciones.Count</span>
                    <div class="purchase-pagination-actions">
                        <button type="button" class="purchase-table-btn is-neutral" @onclick="() => CambiarPagina(-1)" disabled="@(PaginaActualSegura == 1)"><i class="ri-arrow-left-s-line"></i><span>Anterior</span></button>
                        <strong>Página @PaginaActualSegura de @TotalPaginas</strong>
                        <button type="button" class="purchase-table-btn is-neutral" @onclick="() => CambiarPagina(1)" disabled="@(PaginaActualSegura == TotalPaginas)"><span>Siguiente</span><i class="ri-arrow-right-s-line"></i></button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (mostrarHomologacion && compraSeleccionadaHomologar is not null)
{
    var cntExistentes = lineasHomologacion.Count(l => !l.CrearNuevoProducto && l.CodigoProducto > 0);
    var cntNuevos = lineasHomologacion.Count(l => l.CrearNuevoProducto);
    var cntOmitidos = lineasHomologacion.Count(l => !l.CrearNuevoProducto && l.CodigoProducto == 0);

    <div class="homol-backdrop" @onclick="CerrarHomologacionAsync">
        <section class="homol-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="homologacion-modal-title"
                 @onclick:stopPropagation="true">
            <header class="homol-header">
                <div style="min-width:0;">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <span class="badge bg-primary-subtle text-primary border">HOMOLOGACIÓN A INVENTARIO</span>
                        <span class="badge bg-info-subtle text-dark border"><i class="ri-building-line me-1"></i>@NombreSucursalActiva</span>
                        @if (!cargandoHomologacion && lineasHomologacion.Count > 0)
                        {
                            <span class="badge bg-success-subtle text-success border">@cntExistentes existentes</span>
                            <span class="badge bg-primary-subtle text-primary border">@cntNuevos nuevos</span>
                            <span class="badge bg-secondary-subtle text-secondary border">@cntOmitidos omitidos</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(horaBorradorHomologacion))
                        {
                            <span class="badge bg-warning-subtle text-dark border"><i class="ri-save-3-line me-1"></i>@(borradorRestaurado ? "Borrador restaurado" : "Borrador guardado") (@horaBorradorHomologacion)</span>
                        }
                    </div>
                    <h2 id="homologacion-modal-title" class="h5 fw-bold mb-1">Factura @compraSeleccionadaHomologar.NumeroDocumento</h2>
                    <p class="mb-0 text-muted small">@compraSeleccionadaHomologar.Proveedor (@compraSeleccionadaHomologar.RucProveedor) · Total <strong>$@compraSeleccionadaHomologar.ValorTotal.ToString("N2")</strong> · @compraSeleccionadaHomologar.Detalles.Count ítem(s)</p>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;" aria-label="Cerrar" @onclick="CerrarHomologacionAsync" disabled="@guardandoHomologacion">
                    <i class="ri-close-line fs-5"></i>
                </button>
            </header>

            @if (!cargandoHomologacion)
            {
                <div class="homol-toolbar">
                    <div>
                        <label class="homol-field-label">Sucursal activa</label>
                        <div class="form-control bg-white fw-semibold d-flex align-items-center gap-2">
                            <i class="ri-map-pin-2-line text-primary"></i>
                            <span class="text-truncate">@NombreSucursalActiva</span>
                        </div>
                    </div>
                    <div>
                        <label class="homol-field-label">Bodega general de ingreso (aplica a todos los ítems)</label>
                        @if (bodegasSucursal.Count > 0)
                        {
                            <select class="form-select"
                                    value="@bodegaGeneralHomologacionId"
                                    @onchange="CambiarBodegaGeneralHomologacionAsync"
                                    disabled="@guardandoHomologacion">
                                @foreach (var bod in bodegasSucursal)
                                {
                                    <option value="@bod.IdBodega">@bod.Nombre (@bod.Codigo)</option>
                                }
                            </select>
                            <small class="text-muted d-block mt-1">Al cambiar esta bodega se actualiza en todos los productos; también puedes ajustarla en cada ítem antes de homologar.</small>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 px-3 mb-0 small d-flex justify-content-between align-items-center gap-2">
                                <span>No hay bodegas activas creadas para <strong>@NombreSucursalActiva</strong>.</span>
                                <a class="btn btn-sm btn-outline-primary text-nowrap" href="/contabilidad/inventarios/bodegas">Crear bodega</a>
                            </div>
                        }
                    </div>
                    <div class="d-flex flex-column align-items-end">
                        <label class="homol-field-label">Borrador local</label>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary text-nowrap"
                                style="min-height:36px;"
                                title="Descartar cambios guardados en borrador y recargar desde la factura"
                                @onclick="RestablecerBorradorHomologacionAsync"
                                disabled="@(guardandoHomologacion || string.IsNullOrWhiteSpace(horaBorradorHomologacion))">
                            <i class="ri-refresh-line me-1"></i>Restablecer
                        </button>
                    </div>
                </div>
            }

            <div class="homol-body">
                @if (!string.IsNullOrWhiteSpace(errorHomologacion))
                {
                    <div class="alert alert-danger mb-0" role="alert">@errorHomologacion</div>
                }

                @if (cargandoHomologacion)
                {
                    <div class="text-center py-5 my-4">
                        <div class="spinner-border text-primary mb-3" role="status"></div>
                        <div class="fw-semibold text-dark">Cargando bodegas de @NombreSucursalActiva y catálogo de productos...</div>
                        <small class="text-muted">Esto puede tardar unos segundos la primera vez mientras se sincroniza el inventario.</small>
                    </div>
                }
                else
                {
                    @for (var idx = 0; idx < lineasHomologacion.Count; idx++)
                    {
                        var linea = lineasHomologacion[idx];
                        var prodSel = !linea.CrearNuevoProducto && linea.CodigoProducto > 0
                            ? productosInventario.FirstOrDefault(p => p.CodigoProducto == linea.CodigoProducto)
                            : null;
                        var factorActivo = linea.CrearNuevoProducto
                            ? (linea.NuevoFactorConversion > 0 ? linea.NuevoFactorConversion : 1m)
                            : (prodSel?.FactorConversion ?? 1m);
                        var unidadActiva = linea.CrearNuevoProducto
                            ? (string.IsNullOrWhiteSpace(linea.NuevaUnidadMedida) ? "UNIDAD" : linea.NuevaUnidadMedida)
                            : (prodSel?.UnidadMedida ?? "UNIDAD");
                        var ingresaStock = linea.CrearNuevoProducto || linea.CodigoProducto > 0;
                        var esOmitido = !linea.CrearNuevoProducto && !linea.ModoForzadoExistente && linea.CodigoProducto == 0;

                        <div @key="linea.CodLinea" class="homol-card">
                            <div class="homol-card-header">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge bg-dark-subtle text-dark border">#@(idx + 1)</span>
                                    @if (linea.CrearNuevoProducto)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border"><i class="ri-add-circle-line me-1"></i>Se creará producto nuevo</span>
                                    }
                                    else if (linea.CodigoProducto > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border"><i class="ri-link me-1"></i>Homologado a inventario</span>
                                    }
                                    else if (linea.ModoForzadoExistente)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border"><i class="ri-search-eye-line me-1"></i>Pendiente de seleccionar producto</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border"><i class="ri-forbid-line me-1"></i>Omitido (no inventariar)</span>
                                    }
                                </div>

                                <div class="homol-card-controls">
                                    <div class="homol-item-bodega" title="Bodega donde ingresará este producto">
                                        <i class="ri-store-2-line text-primary flex-shrink-0"></i>
                                        @if (bodegasSucursal.Count > 0)
                                        {
                                            <select class="form-select form-select-sm"
                                                    style="min-height:32px;font-size:.8rem;"
                                                    value="@linea.IdBodega"
                                                    @onchange="e => CambiarBodegaLineaAsync(linea, e.Value)"
                                                    disabled="@(guardandoHomologacion || esOmitido)">
                                                @foreach (var bod in bodegasSucursal)
                                                {
                                                    <option value="@bod.IdBodega">@bod.Nombre (@bod.Codigo)</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="small text-muted">Sin bodega</span>
                                        }
                                    </div>

                                    <div class="btn-group btn-group-sm homol-mode-group" role="group" aria-label="Acción para línea">
                                        <button type="button"
                                                class="btn @(!linea.CrearNuevoProducto && (linea.CodigoProducto > 0 || linea.ModoForzadoExistente) ? "btn-success" : "btn-outline-secondary")"
                                                @onclick="() => CambiarModoHomologacionAsync(linea, ModoHomologacion.Existente)"
                                                disabled="@guardandoHomologacion">
                                            <i class="ri-search-line me-1"></i>Elegir existente
                                        </button>
                                        <button type="button"
                                                class="btn @(linea.CrearNuevoProducto ? "btn-primary" : "btn-outline-primary")"
                                                @onclick="() => CambiarModoHomologacionAsync(linea, ModoHomologacion.CrearNuevo)"
                                                disabled="@guardandoHomologacion">
                                            <i class="ri-add-line me-1"></i>Crear nuevo
                                        </button>
                                        <button type="button"
                                                class="btn @(esOmitido ? "btn-secondary" : "btn-outline-secondary")"
                                                @onclick="() => CambiarModoHomologacionAsync(linea, ModoHomologacion.Omitir)"
                                                disabled="@guardandoHomologacion">
                                            Omitir
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="homol-card-body">
                                <div class="homol-compare-grid">
                                    <div class="homol-box homol-box-invoice">
                                        <div class="homol-box-label text-muted">En factura del proveedor</div>
                                        <div class="fw-bold text-dark mb-1" style="word-break:break-word;">@linea.DescripcionFactura</div>
                                        <div class="small text-muted font-monospace mb-2">Código XML: @(string.IsNullOrWhiteSpace(linea.CodPrincipalFactura) ? "Sin código" : linea.CodPrincipalFactura)</div>
                                        <div class="d-flex flex-wrap gap-3 small">
                                            <span><strong>Cant.:</strong> @linea.CantidadFactura.ToString("0.####")</span>
                                            <span><strong>Costo:</strong> $@linea.PrecioFactura.ToString("N4")</span>
                                        </div>
                                    </div>

                                    <div class="homol-box homol-box-target">
                                        @if (linea.CrearNuevoProducto)
                                        {
                                            <div class="homol-box-label text-primary">Nuevo producto en tu inventario</div>
                                            <div class="homol-new-grid">
                                                <div>
                                                    <label class="homol-field-label">Nombre del producto <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control" @bind="linea.NuevoNombreProducto" @bind:after="GuardarBorradorHomologacionAsync" disabled="@guardandoHomologacion" />
                                                </div>
                                                <div>
                                                    <label class="homol-field-label">Código principal</label>
                                                    <input type="text" class="form-control font-monospace" @bind="linea.NuevoCodigoPrincipal" @bind:after="GuardarBorradorHomologacionAsync" placeholder="Opcional" disabled="@guardandoHomologacion" />
                                                </div>
                                                <div>
                                                    <label class="homol-field-label">Unidad de medida</label>
                                                    <select class="form-select" @bind="linea.NuevaUnidadMedida" @bind:after="GuardarBorradorHomologacionAsync" disabled="@guardandoHomologacion">
                                                        @foreach (var u in UnidadesMedidaHomologacion)
                                                        {
                                                            <option value="@u">@u</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="homol-field-label">Factor de conversión</label>
                                                    <input type="number" min="1" step="0.0001" class="form-control text-end" @bind="linea.NuevoFactorConversion" @bind:after="GuardarBorradorHomologacionAsync" disabled="@guardandoHomologacion" />
                                                </div>
                                            </div>
                                        }
                                        else if (linea.CodigoProducto > 0 || linea.ModoForzadoExistente)
                                        {
                                            <div class="homol-box-label text-success">Comparar y elegir producto existente</div>
                                            <div class="d-flex flex-column gap-2">
                                                <input class="form-control" @bind="linea.FiltroProducto" @bind:event="oninput" placeholder="Buscar en tu inventario por nombre o código..." disabled="@guardandoHomologacion" />
                                                <select class="form-select"
                                                        value="@linea.CodigoProducto"
                                                        @onchange="e => SeleccionarProductoHomologacionAsync(linea, e.Value)"
                                                        disabled="@guardandoHomologacion">
                                                    <option value="0">-- Selecciona un producto de tu inventario --</option>
                                                    @foreach (var p in ProductosFiltradosParaLinea(linea))
                                                    {
                                                        <option value="@p.CodigoProducto">@p.NombreProducto @(string.IsNullOrWhiteSpace(p.CodigoPrincipal) ? "" : $"({p.CodigoPrincipal})") · Stock: @p.StockActual.ToString("N2") @p.UnidadMedida@(p.FactorConversion > 1 ? $" (×{p.FactorConversion:G29})" : "")</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted small d-flex align-items-center h-100">
                                                <span><i class="ri-information-line me-1"></i>Esta línea no ingresará al inventario (útil para servicios, fletes o gastos). Usa <strong>Elegir existente</strong> o <strong>Crear nuevo</strong> si sí es mercadería.</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (ingresaStock)
                                {
                                    <div class="homol-stock-grid">
                                        <div>
                                            <label class="homol-field-label">Modo ingreso</label>
                                            @if (factorActivo > 1)
                                            {
                                                <select class="form-select"
                                                        value="@(linea.PorEnvase ? "envase" : "directo")"
                                                        @onchange="e => CambiarModoIngresoLineaAsync(linea, e.Value)"
                                                        disabled="@guardandoHomologacion">
                                                    <option value="envase">Envases (×@factorActivo.ToString("G29"))</option>
                                                    <option value="directo">Directo (@unidadActiva)</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <div class="form-control bg-light text-muted d-flex align-items-center">Directo (@unidadActiva)</div>
                                            }
                                        </div>
                                        <div>
                                            <label class="homol-field-label">Cantidad (+)</label>
                                            <input type="number" min="0" step="0.0001" class="form-control text-end" @bind="linea.CantidadIngreso" @bind:after="GuardarBorradorHomologacionAsync" disabled="@guardandoHomologacion" />
                                            @if (factorActivo > 1 && linea.PorEnvase && linea.CantidadIngreso > 0)
                                            {
                                                <small class="text-primary d-block text-end mt-1 fw-semibold">= @((linea.CantidadIngreso * factorActivo).ToString("N2")) @unidadActiva</small>
                                            }
                                        </div>
                                        <div>
                                            <label class="homol-field-label">Costo unit.</label>
                                            <input type="number" min="0" step="0.0001" class="form-control text-end" @bind="linea.CostoUnitario" @bind:after="GuardarBorradorHomologacionAsync" disabled="@guardandoHomologacion" />
                                        </div>
                                        <div>
                                            <label class="homol-field-label">Lote</label>
                                            <input type="text" maxlength="80" class="form-control" placeholder="Opcional" @bind="linea.NumeroLote" @bind:after="GuardarBorradorHomologacionAsync" disabled="@guardandoHomologacion" />
                                        </div>
                                        <div>
                                            <label class="homol-field-label">Vencimiento</label>
                                            <input type="date" min="@FechaMinimaLote" class="form-control" @bind="linea.FechaVencimiento" @bind:after="GuardarBorradorHomologacionAsync" disabled="@guardandoHomologacion" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <footer class="homol-footer">
                <span class="small text-muted"><i class="ri-shield-check-line me-1 text-primary"></i>Tus cambios se guardan automáticamente como borrador en este navegador. Al confirmar, los ítems homologados suman stock al kardex.</span>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarHomologacionAsync" disabled="@guardandoHomologacion">Guardar borrador y cerrar</button>
                    <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" @onclick="ConfirmarHomologacionAsync" disabled="@(cargandoHomologacion || guardandoHomologacion)">
                        <i class="ri-check-double-line"></i><span>@(guardandoHomologacion ? "Ingresando..." : "Confirmar ingreso a inventario")</span>
                    </button>
                </div>
            </footer>
        </section>
    </div>
}

@if (mostrarEditor)
{
    <div class="purchase-modal-backdrop reception-modal-backdrop"
         style="position:fixed;inset:0;z-index:2990;display:flex;align-items:center;justify-content:center;padding:1rem;background:rgba(15,23,42,.55);backdrop-filter:blur(4px);"
         @onclick="CerrarEditorAsync">
        <section class="reception-modal purchase-modal" role="dialog" aria-modal="true" aria-labelledby="recepcion-compra-modal-title" @onclick:stopPropagation="true">
            <header class="purchase-modal-header">
                <div>
                    <span class="purchase-eyebrow">RECEPCIÓN DE COMPRA</span>
                    <h2 id="recepcion-compra-modal-title">@(editor.Id == 0 ? "Nueva recepción" : editor.NumeroRecepcion)</h2>
                    <p>Confirma las cantidades entregadas y documenta cualquier diferencia.</p>
                    @if (TieneCambiosSinGuardar)
                    {
                        <span class="purchase-dirty-indicator"><i class="ri-save-3-line"></i>Cambios sin guardar</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(editor.NumeroOrden))
                    {
                        <small class="text-muted">Orden @editor.NumeroOrden · @editor.NombreProveedor</small>
                    }
                </div>
                <button type="button" class="purchase-modal-close" aria-label="Cerrar" @onclick="CerrarEditorAsync"><i class="ri-close-line"></i></button>
            </header>

            <div class="purchase-modal-body p-4 overflow-auto">
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }
                <div class="purchase-editor-card mb-3">
                    <div class="purchase-section-heading"><div><span>CABECERA</span><h3>Documento de recepción</h3></div><i class="ri-inbox-archive-line"></i></div>
                    <div class="row g-3 p-3">
                    <div class="col-md-8">
                        <label class="form-label">Orden de compra <span class="text-danger">*</span></label>
                        <select class="form-select @(MostrarErrorOrden ? "is-invalid" : string.Empty)" @bind="editor.IdOrdenCompra" @bind:after="CargarOrdenSeleccionadaAsync" required disabled="@(guardando || editor.Id > 0)">
                            <option value="0">Seleccione una orden aprobada o enviada</option>
                            @foreach (var orden in ordenesDisponibles)
                            {
                                <option value="@orden.IdOrdenCompra">@orden.NumeroOrden · @orden.NombreProveedor</option>
                            }
                        </select>
                        @if (MostrarErrorOrden)
                        {
                            <small class="purchase-field-error">Selecciona una orden con cantidades pendientes.</small>
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fecha de recepción <span class="text-danger">*</span></label>
                        <input class="form-control @(MostrarErrorFecha ? "is-invalid" : string.Empty)" type="date" @bind="editor.FechaRecepcion" required disabled="@(guardando || !PuedeEditar)" />
                        @if (MostrarErrorFecha)
                        {
                            <small class="purchase-field-error">Indica la fecha de recepción.</small>
                        }
                    </div>
                    <div class="col-12">
                        <label class="form-label">Observación general</label>
                        <input class="form-control" @bind="editor.Observacion" maxlength="1000" disabled="@(guardando || !PuedeEditar)" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Factura del proveedor</label>
                        <input class="form-control" @bind="editor.NumeroFacturaProveedor" maxlength="50" disabled="@(guardando || !PuedeEditar)" placeholder="001-001-000000001" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Clave de acceso</label>
                        <input class="form-control" @bind="editor.ClaveAccesoProveedor" maxlength="60" disabled="@(guardando || !PuedeEditar)" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Bodega de ingreso · @NombreSucursalActiva (aplicar a todos los ítems)</label>
                        @if (bodegasSucursal.Count > 0)
                        {
                            <select class="form-select" value="@editorBodegaGeneralId" @onchange="CambiarBodegaGeneralEditor" disabled="@(guardando || !PuedeEditar)">
                                @foreach (var bod in bodegasSucursal)
                                {
                                    <option value="@bod.IdBodega">@bod.Nombre (@bod.Codigo)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 px-3 mb-0 small d-flex justify-content-between align-items-center">
                                <span>No hay bodegas activas en <strong>@NombreSucursalActiva</strong>.</span>
                                <a class="btn btn-sm btn-outline-primary" href="/contabilidad/inventarios/bodegas">Crear bodega</a>
                            </div>
                        }
                    </div>
                    </div>
                </div>

                @if (editor.Detalles.Count == 0)
                {
                    <div class="alert alert-light border">Selecciona una orden para consultar sus cantidades pendientes.</div>
                }
                else
                {
                    <div class="purchase-editor-card">
                    <div class="purchase-section-heading"><div><span>CONTROL DE ENTREGA</span><h3>Verificación de la recepción</h3></div><div class="purchase-section-heading-actions"><span class="purchase-count">@editor.Detalles.Count línea(s)</span>@if (PuedeEditar) { <button type="button" class="purchase-table-btn purchase-section-action" @onclick="MarcarTodoVerificado" disabled="@guardando"><i class="ri-checkbox-multiple-line"></i><span>Marcar todo verificado</span></button><button type="button" class="purchase-table-btn purchase-section-action" @onclick="RecibirTodoPendiente" disabled="@guardando"><i class="ri-check-double-line"></i><span>Recibir todo pendiente</span></button> }</div></div>
                        <div class="reception-editor-summary" aria-label="Resumen de recepción">
                            <div><span>PENDIENTE</span><strong>@TotalPendienteEditor.ToString("0.####")</strong></div>
                            <div><span>RECIBIR AHORA</span><strong>@TotalRecibirEditor.ToString("0.####")</strong></div>
                            <div><span>CON DIFERENCIA</span><strong>@LineasConDiferencia</strong></div>
                            <div><span>VERIFICADAS</span><strong>@LineasVerificadas/@editor.Detalles.Count</strong></div>
                        </div>
                        <div class="row g-2 align-items-end px-3 pt-3">
                            <div class="col-lg-6">
                                <label class="form-label" for="codigo-barras-recepcion"><i class="ri-barcode-line me-1"></i>Escanear código de barras</label>
                                <input id="codigo-barras-recepcion"
                                       class="form-control"
                                       @bind="codigoBarrasRecepcion"
                                       @bind:event="oninput"
                                       @onkeydown="ProcesarCodigoBarrasRecepcionAsync"
                                       placeholder="Escanea el producto y presiona Enter"
                                       autocomplete="off"
                                       disabled="@(guardando || !PuedeEditar)" />
                                <small class="text-muted">Cada lectura suma una unidad a la línea pendiente.</small>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(mensajeEscaneoRecepcion))
                        {
                            <div class="alert alert-info py-2 mx-3 mt-3 mb-0">@mensajeEscaneoRecepcion</div>
                        }
                        @if (MostrarErrorSinCantidad)
                        {
                            <div class="purchase-inline-error">Registra al menos una cantidad recibida antes de guardar.</div>
                        }
                        <div class="table-responsive p-3">
                        <table class="table table-sm align-middle mb-0 purchase-lines-table">
                            <thead><tr><th>Producto</th><th style="width: 175px">Bodega</th><th style="width: 135px">Verificación</th><th class="text-end">Ordenado</th><th class="text-end">Ya recibido</th><th class="text-end">Pendiente</th><th class="text-end">Costo orden</th><th class="text-end">Variación</th><th style="width: 145px">Recibir ahora</th><th style="width: 145px">Costo real</th><th style="width: 210px">Lote</th><th style="width: 150px">Vencimiento</th><th style="width: 220px">Novedad / observación</th></tr></thead>
                            <tbody>
                                @foreach (var linea in editor.Detalles)
                                {
                                    <tr @key="linea.IdDetalleOrdenCompra">
                                        <td>@linea.Descripcion<small class="d-block text-muted">@linea.CodigoPrincipal</small><span class="reception-line-state @ClaseEstadoLinea(linea)">@TextoEstadoLinea(linea)</span></td>
                                        <td>
                                            @if (bodegasSucursal.Count > 0)
                                            {
                                                <select class="form-select form-select-sm" @bind="linea.IdBodega" disabled="@(guardando || !PuedeEditar)">
                                                    @foreach (var bod in bodegasSucursal)
                                                    {
                                                        <option value="@bod.IdBodega">@bod.Nombre</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <span class="small text-muted">Sin bodega</span>
                                            }
                                        </td>
                                        <td>
                                            <label class="purchase-check-control @(linea.Verificado ? "is-checked" : string.Empty)">
                                                <input type="checkbox" @bind="linea.Verificado" disabled="@(guardando || !PuedeEditar)" />
                                                <span>@(linea.Verificado ? "Revisado" : "Pendiente")</span>
                                            </label>
                                        </td>
                                        <td class="text-end">@linea.CantidadOrdenada.ToString("0.####")</td>
                                        <td class="text-end">@linea.CantidadYaRecibida.ToString("0.####")</td>
                                        <td class="text-end"><strong>@PendienteDespues(linea).ToString("0.####")</strong></td>
                                        <td class="text-end">@linea.PrecioUnitarioOrden.ToString("C2")</td>
                                        <td class="text-end">@TextoVariacionCosto(linea)</td>
                                        <td><input class="form-control form-control-sm @(MostrarErrorCantidad(linea) ? "is-invalid" : string.Empty)" type="number" min="0" max="@linea.CantidadPendiente" step="0.0001" @bind="linea.CantidadRecibida" @bind:event="oninput" disabled="@(guardando || !PuedeEditar)" />@if (MostrarErrorCantidad(linea)) { <small class="purchase-field-error">No puede superar lo pendiente.</small> }</td>
                                        <td><input class="form-control form-control-sm @(MostrarErrorCosto(linea) ? "is-invalid" : string.Empty)" type="number" min="0" step="0.0001" @bind="linea.CostoUnitario" disabled="@(guardando || !PuedeEditar)" />@if (MostrarErrorCosto(linea)) { <small class="purchase-field-error">No puede ser negativo.</small> }</td>
                                        <td><input class="form-control form-control-sm" @bind="linea.NumeroLote" maxlength="80" disabled="@(guardando || !PuedeEditar)" /></td>
                                        <td><input class="form-control form-control-sm" type="date" min="@FechaMinimaLote" @bind="linea.FechaVencimiento" disabled="@(guardando || !PuedeEditar)" /></td>
                                        <td>
                                            <input class="form-control form-control-sm" @bind="linea.Observacion" maxlength="500" disabled="@(guardando || !PuedeEditar)" placeholder="Faltante, daño, empaque..." />
                                            <small class="text-muted">Diferencia: @Diferencia(linea).ToString("0.####")</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    </div>
                }
            </div>

            <footer class="purchase-modal-footer">
                <span><i class="ri-information-line"></i>Confirma la recepción cuando hayas validado la entrega física.</span>
                <div>
                @if (editor.Id > 0)
                {
                    <button type="button" class="purchase-secondary-btn" @onclick="ImprimirAsync" disabled="@guardando"><i class="ri-printer-line"></i> Imprimir / PDF</button>
                }
                <button type="button" class="purchase-secondary-btn" @onclick="CerrarEditorAsync" disabled="@guardando">Cerrar</button>
                @if (PuedeEditar)
                {
                    <SaveButton Type="button" class="purchase-primary-btn" OnClick="GuardarAsync" Disabled="@guardando">@(guardando ? "Guardando..." : "Guardar borrador")</SaveButton>
                }
                </div>
            </footer>
        </section>
    </div>
}

@code {
    private const string ApiUrl = "api/e-contax/compras/recepciones";
    private const string Borrador = "BORRADOR";
    private readonly List<EContaxRecepcionCompraListaDto> recepciones = new();
    private readonly List<EContaxRecepcionOrdenDto> ordenesDisponibles = new();
    private readonly List<EContaxInventarioService.CompraPendienteRecepcionDto> comprasPendientes = new();
    private readonly List<EContaxInventarioService.CompraIngresadaRecepcionDto> comprasIngresadas = new();
    private List<EContaxBodegaDto> bodegasSucursal = new();
    private List<EContaxProductoParaStockDto> productosInventario = new();
    private string tabActiva = "pendientes";
    private int? compraIngresadaExpandidaId;
    private string filtroComprasPendientes = string.Empty;
    private bool cargandoComprasPendientes;
    private bool mostrarHomologacion;
    private bool cargandoHomologacion;
    private bool guardandoHomologacion;
    private string? errorHomologacion;
    private string? mensajeHomologacion;
    private int bodegaGeneralHomologacionId;
    private int editorBodegaGeneralId;
    private EContaxInventarioService.CompraPendienteRecepcionDto? compraSeleccionadaHomologar;
    private List<HomologacionLineaModel> lineasHomologacion = new();
    private readonly HashSet<int> facturasConBorrador = new();
    private bool borradorRestaurado;
    private string? horaBorradorHomologacion;
    private bool jsDisponible;
    private int? SucursalActivaId => Session.Localidad > 0 ? Session.Localidad : null;
    private string NombreSucursalActiva => string.IsNullOrWhiteSpace(Session.LocalidadDescripcion) ? "Sucursal actual" : Session.LocalidadDescripcion;
    private string filtro = string.Empty;
    private string estadoFiltro = string.Empty;
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private string? error;
    private bool cargando;
    private bool guardando;
    private string codigoBarrasRecepcion = string.Empty;
    private string? mensajeEscaneoRecepcion;
    private bool procesandoCodigoBarrasRecepcion;
    private bool mostrarEditor;
    private bool mostrarErrores;
    private int usuarioId;
    private EditorModel editor = new();
    private string? editorSnapshot;
    private string ordenListado = "fecha-desc";
    private int paginaActual = 1;
    private const int RegistrosPorPagina = 10;
    private bool PuedeEditar => editor.Id == 0 || editor.Estado == Borrador;
    private string FechaMinimaLote => DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
    private int TotalBorradores => recepciones.Count(x => x.Estado == "BORRADOR");
    private int TotalCompletas => recepciones.Count(x => x.Estado == "RECIBIDA_COMPLETA");
    private int TotalParciales => recepciones.Count(x => x.Estado == "RECIBIDA_PARCIAL");
    private decimal TotalRecibido => recepciones.Sum(x => x.TotalRecibido);
    private IEnumerable<EContaxRecepcionCompraListaDto> RecepcionesOrdenadas => ordenListado switch
    {
        "fecha-asc" => recepciones.OrderBy(x => x.FechaRecepcion).ThenBy(x => x.NumeroRecepcion),
        "cantidad-desc" => recepciones.OrderByDescending(x => x.TotalRecibido).ThenByDescending(x => x.FechaRecepcion),
        "cantidad-asc" => recepciones.OrderBy(x => x.TotalRecibido).ThenByDescending(x => x.FechaRecepcion),
        "estado" => recepciones.OrderBy(x => x.Estado).ThenByDescending(x => x.FechaRecepcion),
        _ => recepciones.OrderByDescending(x => x.FechaRecepcion).ThenByDescending(x => x.IdRecepcion)
    };
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(recepciones.Count / (double)RegistrosPorPagina));
    private int PaginaActualSegura => Math.Min(paginaActual, TotalPaginas);
    private IEnumerable<EContaxRecepcionCompraListaDto> RecepcionesPagina => RecepcionesOrdenadas.Skip((PaginaActualSegura - 1) * RegistrosPorPagina).Take(RegistrosPorPagina);
    private int PrimerRegistroPagina => recepciones.Count == 0 ? 0 : ((PaginaActualSegura - 1) * RegistrosPorPagina) + 1;
    private int UltimoRegistroPagina => Math.Min(PaginaActualSegura * RegistrosPorPagina, recepciones.Count);
    private bool TieneCambiosSinGuardar => mostrarEditor && editorSnapshot is not null && editorSnapshot != JsonSerializer.Serialize(editor);
    private bool MostrarErrorOrden => mostrarErrores && editor.IdOrdenCompra <= 0;
    private bool MostrarErrorFecha => mostrarErrores && editor.FechaRecepcion == default;
    private bool MostrarErrorSinCantidad => mostrarErrores && (editor.IdOrdenCompra > 0 && editor.Detalles.All(x => x.CantidadRecibida <= 0));
    private decimal TotalPendienteEditor => editor.Detalles.Sum(x => x.CantidadPendiente);
    private decimal TotalRecibirEditor => editor.Detalles.Sum(x => x.CantidadRecibida);
    private int LineasConDiferencia => editor.Detalles.Count(x => Math.Abs(x.CantidadPendiente - x.CantidadRecibida) > 0.0001m);
    private int LineasVerificadas => editor.Detalles.Count(x => x.Verificado);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst("IdUsuario")?.Value ?? state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(claim, out usuarioId);
        await CargarAsync();
        if (NavManager.Uri.TrimEnd('/').EndsWith("/nueva", StringComparison.OrdinalIgnoreCase))
            await AbrirNuevaAsync();
    }

    private async Task CargarAsync()
    {
        if (usuarioId <= 0)
        {
            error = "No se pudo identificar la sesión actual.";
            return;
        }

        cargando = true;
        cargandoComprasPendientes = true;
        error = null;
        paginaActual = 1;
        recepciones.Clear();
        comprasPendientes.Clear();
        comprasIngresadas.Clear();
        try
        {
            var url = $"{ApiUrl}?userId={usuarioId}&search={Uri.EscapeDataString(filtro)}&estado={Uri.EscapeDataString(estadoFiltro)}" +
                $"&fechaDesde={Uri.EscapeDataString(fechaDesde?.ToString("yyyy-MM-dd") ?? string.Empty)}&fechaHasta={Uri.EscapeDataString(fechaHasta?.ToString("yyyy-MM-dd") ?? string.Empty)}" +
                (SucursalActivaId is > 0 ? $"&sucursalId={SucursalActivaId.Value}" : string.Empty);

            var tRecepciones = Http.GetFromJsonAsync<List<EContaxRecepcionCompraListaDto>>(url);
            var tPendientes = InventarioService.ListarComprasPendientesRecepcionAsync(usuarioId, SucursalActivaId);
            var tIngresadas = InventarioService.ListarComprasIngresadasRecepcionAsync(usuarioId, SucursalActivaId);
            var tBodegas = CargarBodegasSucursalActivaAsync();

            await Task.WhenAll(tRecepciones, tPendientes, tIngresadas, tBodegas);

            recepciones.Clear();
            recepciones.AddRange(await tRecepciones ?? new());
            comprasPendientes.AddRange(await tPendientes);
            comprasIngresadas.AddRange(await tIngresadas);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            cargandoComprasPendientes = false;
        }

        if (jsDisponible)
            await ActualizarIndicadoresBorradorAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsDisponible = true;
            await ActualizarIndicadoresBorradorAsync();
            StateHasChanged();
        }
    }

    private IEnumerable<EContaxInventarioService.CompraPendienteRecepcionDto> ComprasPendientesFiltradas =>
        comprasPendientes.Where(c =>
            string.IsNullOrWhiteSpace(filtroComprasPendientes) ||
            c.NumeroDocumento.Contains(filtroComprasPendientes.Trim(), StringComparison.OrdinalIgnoreCase) ||
            c.Proveedor.Contains(filtroComprasPendientes.Trim(), StringComparison.OrdinalIgnoreCase) ||
            c.RucProveedor.Contains(filtroComprasPendientes.Trim(), StringComparison.OrdinalIgnoreCase));

    private IEnumerable<EContaxInventarioService.CompraIngresadaRecepcionDto> ComprasIngresadasFiltradas =>
        comprasIngresadas.Where(c =>
            (string.IsNullOrWhiteSpace(filtro) ||
             c.NumeroDocumento.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase) ||
             c.Proveedor.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase) ||
             c.RucProveedor.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase) ||
             c.BodegaResumen.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase)) &&
            (!fechaDesde.HasValue || (c.FechaEmision.HasValue && c.FechaEmision.Value.Date >= fechaDesde.Value.Date)) &&
            (!fechaHasta.HasValue || (c.FechaEmision.HasValue && c.FechaEmision.Value.Date <= fechaHasta.Value.Date)));

    private void ToggleDetalleCompraIngresada(int codFactura)
    {
        compraIngresadaExpandidaId = compraIngresadaExpandidaId == codFactura ? null : codFactura;
    }

    private async Task CargarBodegasSucursalActivaAsync()
    {
        var lista = await BodegaService.ListarAsync(usuarioId, SucursalActivaId);
        bodegasSucursal = lista
            .Where(b => b.Estado && (!SucursalActivaId.HasValue || b.IdSucursal == SucursalActivaId.Value))
            .OrderBy(b => b.Nombre)
            .ToList();
    }

    private string ObtenerClaveBorradorHomologacion(int codFactura) =>
        $"hosvet_homol_draft_v1_{usuarioId}_{SucursalActivaId ?? 0}_{codFactura}";

    private async Task ActualizarIndicadoresBorradorAsync()
    {
        facturasConBorrador.Clear();
        if (!jsDisponible || usuarioId <= 0 || comprasPendientes.Count == 0)
            return;

        foreach (var c in comprasPendientes)
        {
            try
            {
                var raw = await JS.InvokeAsync<string?>("localStorage.getItem", ObtenerClaveBorradorHomologacion(c.CodFactura));
                if (!string.IsNullOrWhiteSpace(raw))
                    facturasConBorrador.Add(c.CodFactura);
            }
            catch
            {
                break;
            }
        }
    }

    private async Task GuardarBorradorHomologacionAsync()
    {
        if (!jsDisponible || compraSeleccionadaHomologar is null || cargandoHomologacion || lineasHomologacion.Count == 0)
            return;

        try
        {
            var ahora = DateTime.Now;
            var borrador = new HomologacionBorradorDto
            {
                GuardadoEnIso = ahora.ToString("O"),
                BodegaGeneralId = bodegaGeneralHomologacionId,
                Lineas = lineasHomologacion.Select(l => new HomologacionBorradorLineaDto
                {
                    CodLinea = l.CodLinea,
                    CodigoProducto = l.CodigoProducto,
                    IdBodega = l.IdBodega,
                    ModoForzadoExistente = l.ModoForzadoExistente,
                    CrearNuevoProducto = l.CrearNuevoProducto,
                    NuevoNombreProducto = l.NuevoNombreProducto,
                    NuevoCodigoPrincipal = l.NuevoCodigoPrincipal,
                    NuevaUnidadMedida = l.NuevaUnidadMedida,
                    NuevoFactorConversion = l.NuevoFactorConversion,
                    PorEnvase = l.PorEnvase,
                    CantidadIngreso = l.CantidadIngreso,
                    CostoUnitario = l.CostoUnitario,
                    NumeroLote = l.NumeroLote,
                    FechaVencimiento = l.FechaVencimiento
                }).ToList()
            };

            var json = JsonSerializer.Serialize(borrador);
            await JS.InvokeVoidAsync("localStorage.setItem", ObtenerClaveBorradorHomologacion(compraSeleccionadaHomologar.CodFactura), json);
            facturasConBorrador.Add(compraSeleccionadaHomologar.CodFactura);
            borradorRestaurado = false;
            horaBorradorHomologacion = ahora.ToString("HH:mm");
        }
        catch
        {
            // Ignorar si localStorage no está disponible en el navegador
        }
    }

    private async Task RestaurarBorradorHomologacionAsync(int codFactura)
    {
        borradorRestaurado = false;
        horaBorradorHomologacion = null;
        if (!jsDisponible) return;

        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", ObtenerClaveBorradorHomologacion(codFactura));
            if (string.IsNullOrWhiteSpace(raw)) return;

            var borrador = JsonSerializer.Deserialize<HomologacionBorradorDto>(raw);
            if (borrador is null) return;

            if (borrador.BodegaGeneralId > 0 && bodegasSucursal.Any(b => b.IdBodega == borrador.BodegaGeneralId))
                bodegaGeneralHomologacionId = borrador.BodegaGeneralId;

            var mapa = borrador.Lineas.ToDictionary(x => x.CodLinea);
            foreach (var linea in lineasHomologacion)
            {
                if (!mapa.TryGetValue(linea.CodLinea, out var saved)) continue;

                linea.CodigoProducto = saved.CodigoProducto;
                if (saved.IdBodega > 0 && bodegasSucursal.Any(b => b.IdBodega == saved.IdBodega))
                    linea.IdBodega = saved.IdBodega;
                else
                    linea.IdBodega = bodegaGeneralHomologacionId;

                linea.ModoForzadoExistente = saved.ModoForzadoExistente;
                linea.CrearNuevoProducto = saved.CrearNuevoProducto;
                if (!string.IsNullOrWhiteSpace(saved.NuevoNombreProducto))
                    linea.NuevoNombreProducto = saved.NuevoNombreProducto;
                linea.NuevoCodigoPrincipal = saved.NuevoCodigoPrincipal ?? string.Empty;
                if (!string.IsNullOrWhiteSpace(saved.NuevaUnidadMedida))
                    linea.NuevaUnidadMedida = saved.NuevaUnidadMedida;
                if (saved.NuevoFactorConversion > 0)
                    linea.NuevoFactorConversion = saved.NuevoFactorConversion;
                linea.PorEnvase = saved.PorEnvase;
                linea.CantidadIngreso = saved.CantidadIngreso;
                linea.CostoUnitario = saved.CostoUnitario;
                linea.NumeroLote = saved.NumeroLote;
                linea.FechaVencimiento = saved.FechaVencimiento;
            }

            borradorRestaurado = true;
            horaBorradorHomologacion = DateTime.TryParse(borrador.GuardadoEnIso, out var dt)
                ? dt.ToString("dd/MM HH:mm")
                : "recuperado";
            facturasConBorrador.Add(codFactura);
        }
        catch
        {
            // Ignorar borrador corrupto
        }
    }

    private async Task EliminarBorradorHomologacionAsync(int codFactura)
    {
        facturasConBorrador.Remove(codFactura);
        borradorRestaurado = false;
        horaBorradorHomologacion = null;
        if (!jsDisponible) return;

        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", ObtenerClaveBorradorHomologacion(codFactura));
        }
        catch
        {
            // Ignorar
        }
    }

    private async Task RestablecerBorradorHomologacionAsync()
    {
        if (compraSeleccionadaHomologar is null || guardandoHomologacion) return;
        var compra = compraSeleccionadaHomologar;
        await EliminarBorradorHomologacionAsync(compra.CodFactura);
        ConstruirLineasHomologacionPorDefecto(compra);
    }

    private void ConstruirLineasHomologacionPorDefecto(EContaxInventarioService.CompraPendienteRecepcionDto compra)
    {
        bodegaGeneralHomologacionId = bodegasSucursal.FirstOrDefault()?.IdBodega ?? 0;

        lineasHomologacion = compra.Detalles.Select(d =>
        {
            var match = productosInventario.FirstOrDefault(p =>
                d.CodProductoActual > 0 && p.CodigoProducto == d.CodProductoActual)
                ?? productosInventario.FirstOrDefault(p =>
                    !string.IsNullOrWhiteSpace(d.CodPrincipal) &&
                    string.Equals(p.CodigoPrincipal, d.CodPrincipal, StringComparison.OrdinalIgnoreCase))
                ?? productosInventario.FirstOrDefault(p =>
                    !string.IsNullOrWhiteSpace(d.Descripcion) &&
                    string.Equals(p.NombreProducto?.Trim(), d.Descripcion.Trim(), StringComparison.OrdinalIgnoreCase));

            return new HomologacionLineaModel
            {
                CodLinea = d.CodLinea,
                CodPrincipalFactura = d.CodPrincipal,
                DescripcionFactura = d.Descripcion,
                CantidadFactura = d.Cantidad,
                PrecioFactura = d.PrecioUnitario,
                CodigoProducto = match?.CodigoProducto ?? 0,
                IdBodega = bodegaGeneralHomologacionId,
                ModoForzadoExistente = true,
                NuevoNombreProducto = d.Descripcion,
                NuevoCodigoPrincipal = d.CodPrincipal,
                NuevaUnidadMedida = "UNIDAD",
                NuevoFactorConversion = 1m,
                PorEnvase = match is not null && match.FactorConversion > 1,
                CantidadIngreso = d.Cantidad,
                CostoUnitario = d.PrecioUnitario
            };
        }).ToList();
    }

    private async Task CambiarBodegaGeneralHomologacionAsync(ChangeEventArgs e)
    {
        bodegaGeneralHomologacionId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        foreach (var linea in lineasHomologacion)
            linea.IdBodega = bodegaGeneralHomologacionId;
        await GuardarBorradorHomologacionAsync();
    }

    private async Task CambiarBodegaLineaAsync(HomologacionLineaModel linea, object? value)
    {
        linea.IdBodega = int.TryParse(value?.ToString(), out var id) ? id : 0;
        await GuardarBorradorHomologacionAsync();
    }

    private async Task CambiarModoIngresoLineaAsync(HomologacionLineaModel linea, object? value)
    {
        linea.PorEnvase = string.Equals(value?.ToString(), "envase", StringComparison.Ordinal);
        await GuardarBorradorHomologacionAsync();
    }

    private void CambiarBodegaGeneralEditor(ChangeEventArgs e)
    {
        editorBodegaGeneralId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        foreach (var linea in editor.Detalles)
            linea.IdBodega = editorBodegaGeneralId;
    }

    private async Task AbrirHomologacionAsync(EContaxInventarioService.CompraPendienteRecepcionDto compra)
    {
        errorHomologacion = null;
        mensajeHomologacion = null;
        borradorRestaurado = false;
        horaBorradorHomologacion = null;
        compraSeleccionadaHomologar = compra;
        lineasHomologacion = new();
        cargandoHomologacion = true;
        mostrarHomologacion = true;

        try
        {
            if (productosInventario.Count == 0)
            {
                var tBodegas = CargarBodegasSucursalActivaAsync();
                var tProductos = InventarioService.GetProductosParaStockAsync(usuarioId, SucursalActivaId, null);
                await Task.WhenAll(tBodegas, tProductos);
                productosInventario = (await tProductos).Productos;
            }
            else
            {
                await CargarBodegasSucursalActivaAsync();
            }

            ConstruirLineasHomologacionPorDefecto(compra);
            await RestaurarBorradorHomologacionAsync(compra.CodFactura);
        }
        catch (Exception ex)
        {
            errorHomologacion = ex.GetBaseException().Message;
        }
        finally
        {
            cargandoHomologacion = false;
        }
    }

    private async Task CerrarHomologacionAsync()
    {
        if (guardandoHomologacion) return;
        await GuardarBorradorHomologacionAsync();
        mostrarHomologacion = false;
        compraSeleccionadaHomologar = null;
        lineasHomologacion.Clear();
        errorHomologacion = null;
        borradorRestaurado = false;
        horaBorradorHomologacion = null;
