    private string? ConstruirObservacionConBodega(string? observacion, int idBodega)
    {
        var limpia = LimpiarPrefijoBodega(observacion);
        var bodega = bodegasSucursal.FirstOrDefault(b => b.IdBodega == idBodega);
        if (bodega is null)
            return limpia;

        var prefijo = $"[Bodega: {bodega.Nombre} ({bodega.Codigo})]";
        var combinada = string.IsNullOrWhiteSpace(limpia) ? prefijo : $"{prefijo} {limpia}";
        return combinada.Length <= 500 ? combinada : combinada[..500];
    }

    private static (int IdBodega, string? Observacion) ExtraerBodegaDeObservacion(
        string? observacion,
        IReadOnlyList<EContaxBodegaDto> bodegas,
        int bodegaPredeterminadaId)
    {
        if (string.IsNullOrWhiteSpace(observacion))
            return (bodegaPredeterminadaId, observacion);

        var limpia = LimpiarPrefijoBodega(observacion);
        var match = bodegas.FirstOrDefault(b =>
            observacion.Contains($"[Bodega: {b.Nombre} ({b.Codigo})]", StringComparison.OrdinalIgnoreCase) ||
            observacion.Contains($"Bodega: {b.Nombre}", StringComparison.OrdinalIgnoreCase));
        return (match?.IdBodega ?? bodegaPredeterminadaId, limpia);
    }

    private static string? LimpiarPrefijoBodega(string? observacion)
    {
        if (string.IsNullOrWhiteSpace(observacion))
            return observacion;

        var texto = observacion.Trim();
        while (texto.StartsWith("[Bodega:", StringComparison.OrdinalIgnoreCase))
        {
            var cierre = texto.IndexOf(']');
            if (cierre < 0)
                break;
            texto = texto[(cierre + 1)..].Trim();
        }
        return string.IsNullOrWhiteSpace(texto) ? null : texto;
    }

    private sealed class EditorDetail
    {
        public int IdDetalleOrdenCompra { get; set; }
        public int CodigoProducto { get; set; }
        public string? CodigoPrincipal { get; set; }
