    private IEnumerable<EContaxProductoParaStockDto> ProductosFiltradosParaLinea(HomologacionLineaModel linea)
    {
        if (string.IsNullOrWhiteSpace(linea.FiltroProducto))
            return productosInventario.Take(150);

        var texto = linea.FiltroProducto.Trim();
        var filtrados = productosInventario.Where(p =>
            (p.NombreProducto?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.CodigoPrincipal?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
            p.CodigoProducto.ToString().Contains(texto));

        if (linea.CodigoProducto > 0 && !filtrados.Any(p => p.CodigoProducto == linea.CodigoProducto))
        {
            var actual = productosInventario.FirstOrDefault(p => p.CodigoProducto == linea.CodigoProducto);
            if (actual is not null)
                return filtrados.Prepend(actual).Take(150);
        }

        return filtrados.Take(150);
    }

