    ];

    private enum ModoHomologacion { Existente, CrearNuevo, Omitir }

    private async Task CambiarModoHomologacionAsync(HomologacionLineaModel linea, ModoHomologacion modo)
    {
        switch (modo)
        {
            case ModoHomologacion.Existente:
                linea.CrearNuevoProducto = false;
                linea.ModoForzadoExistente = true;
                break;
            case ModoHomologacion.CrearNuevo:
                linea.CrearNuevoProducto = true;
                linea.ModoForzadoExistente = false;
                if (string.IsNullOrWhiteSpace(linea.NuevoNombreProducto))
                    linea.NuevoNombreProducto = linea.DescripcionFactura;
                if (string.IsNullOrWhiteSpace(linea.NuevoCodigoPrincipal))
                    linea.NuevoCodigoPrincipal = linea.CodPrincipalFactura;
                linea.PorEnvase = linea.NuevoFactorConversion > 1;
                break;
            case ModoHomologacion.Omitir:
                linea.CrearNuevoProducto = false;
                linea.ModoForzadoExistente = false;
                linea.CodigoProducto = 0;
                break;
        }

        await GuardarBorradorHomologacionAsync();
    }

    private async Task SeleccionarProductoHomologacionAsync(HomologacionLineaModel linea, object? value)
    {
        linea.CodigoProducto = int.TryParse(value?.ToString(), out var id) ? id : 0;
        linea.CrearNuevoProducto = false;
        linea.ModoForzadoExistente = true;
        var prod = productosInventario.FirstOrDefault(p => p.CodigoProducto == linea.CodigoProducto);
        linea.PorEnvase = prod is not null && prod.FactorConversion > 1;
        await GuardarBorradorHomologacionAsync();
    }

    private async Task ConfirmarHomologacionAsync()
    {
        if (compraSeleccionadaHomologar is null) return;
        guardandoHomologacion = true;
        errorHomologacion = null;
        try
        {
            var payload = lineasHomologacion.Select(l => new EContaxInventarioService.HomologacionCompraLineaDto
            {
                CodLinea = l.CodLinea,
                CodigoProducto = l.CodigoProducto,
                IdBodega = l.IdBodega > 0 ? l.IdBodega : null,
                CrearNuevoProducto = l.CrearNuevoProducto,
                NuevoNombreProducto = l.NuevoNombreProducto,
                NuevoCodigoPrincipal = l.NuevoCodigoPrincipal,
                NuevaUnidadMedida = l.NuevaUnidadMedida,
                NuevoFactorConversion = l.NuevoFactorConversion,
                CantidadIngreso = l.CantidadIngreso,
                CostoUnitario = l.CostoUnitario,
                PorEnvase = l.PorEnvase,
                NumeroLote = l.NumeroLote,
                FechaVencimiento = l.FechaVencimiento
            }).ToList();

            var creoNuevos = lineasHomologacion.Any(l => l.CrearNuevoProducto);
            var ingresadas = await InventarioService.HomologarEIngresarCompraAsync(
                usuarioId,
                compraSeleccionadaHomologar.CodFactura,
                SucursalActivaId,
                payload);

            if (creoNuevos)
                productosInventario.Clear();

            var codFacturaConfirmada = compraSeleccionadaHomologar.CodFactura;
            var numDoc = compraSeleccionadaHomologar.NumeroDocumento;
            await EliminarBorradorHomologacionAsync(codFacturaConfirmada);
            mostrarHomologacion = false;
            compraSeleccionadaHomologar = null;
            lineasHomologacion.Clear();

            mensajeHomologacion = ingresadas > 0
                ? $"Factura {numDoc} homologada: se ingresaron {ingresadas} línea(s) al inventario."
                : $"Factura {numDoc} marcada como revisada sin ingreso de stock.";

            await CargarAsync();
        }
        catch (Exception ex)
        {
            errorHomologacion = ex.GetBaseException().Message;
        }
        finally
        {
            guardandoHomologacion = false;
        }
    }

