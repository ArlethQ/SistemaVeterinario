@page "/contabilidad/compras/nueva-factura"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Simetric.Components
@using Simetric.DTOs
@using Simetric.Services
@using Simetric.Services.EContax
@using Simetric.ViewModels
@using System.Globalization
@attribute [AllowAnonymous]
@inject FacturaCompraManualService FacturaCompraService
@inject ComprasXmlService ComprasXmlService
@inject CedulaLookupService CedulaLookup
@inject LiquidacionCompraService LiquidacionCompraService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject SweetAlertService AlertService

<link rel="stylesheet" href="/_content/Simetric/css/nueva-factura-shared.css?v=20261023-invoice-parity" />
<PageTitle>Nueva factura de compra | E-Contax</PageTitle>

<div class="container-fluid py-3 px-3 px-md-4 bg-light-modern docs-unified-page">
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger border-0 rounded-3 mb-3">@error</div>
    }

    <section class="docs-form-hero" data-tour="invoice.hero">
        <div class="docs-form-hero-body">
            <div class="docs-form-hero-copy invoice-heading-card">
                <div class="invoice-heading-head">
                    <span class="invoice-heading-icon"><i class="bi bi-bag-check"></i></span>
                    <span class="docs-form-kicker">Compras · E-Contax</span>
                </div>
                <h2 class="docs-form-title">Nueva factura de compra</h2>
                <p class="docs-form-text">Registra el documento del proveedor con el mismo flujo de detalle, impuestos y pago de una factura.</p>
                <div class="invoice-heading-meter"><span></span></div>
            </div>
            <div class="docs-form-toolbar">
                <div class="n-invoice-id-strip">
                    <div class="n-invoice-id-pill"><span>Documento</span><strong>Interno</strong></div>
                    <div class="n-invoice-id-pill"><span>SRI</span><strong>No aplica</strong></div>
                </div>
                <label class="n-btn n-btn-secondary n-xml-upload-btn">
                    <i class="bi bi-filetype-xml me-2"></i>@(cargandoLoteXml ? "Leyendo XML..." : "Importar XML (1 o varios)")
                    <InputFile multiple OnChange="OnXmlSelected" accept=".xml,text/xml,application/xml" disabled="@(cargandoLoteXml || importandoLoteXml)" />
                </label>
                @if (xmlCargado)
                {
                    <span class="n-xml-loaded-badge"><i class="bi bi-check-circle me-1"></i>XML cargado</span>
                }
                <a class="n-btn n-btn-secondary" href="@EContaxRoutes.CuentasPorPagarMisCompras"><i class="bi bi-bag-check me-2"></i>Mis compras</a>
                <a class="n-btn n-btn-secondary" href="@EContaxRoutes.CuentasPorPagar"><i class="bi bi-wallet2 me-2"></i>Cuentas por pagar</a>
                <button type="button" class="n-btn n-btn-secondary" @onclick="LimpiarFormulario"><i class="bi bi-arrow-clockwise me-2"></i>Limpiar pantalla</button>
            </div>
        </div>
    </section>

    @if (xmlLote.Count > 0)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-3 pb-2 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <span class="text-uppercase text-primary fw-bold" style="font-size:0.72rem;letter-spacing:.06em;">Carga masiva · Máximo @MaxXmlBatch archivos</span>
                    <h5 class="mb-0 fw-bold">XMLs cargados en lista (@xmlLote.Count)</h5>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success border">Listos: @xmlLote.Count(x => x.PuedeImportar)</span>
                    <span class="badge bg-warning-subtle text-warning-emphasis border">Duplicados: @xmlLote.Count(x => x.Estado == EstadoLoteXml.Duplicado)</span>
                    <span class="badge bg-danger-subtle text-danger border">Errores: @xmlLote.Count(x => x.Estado == EstadoLoteXml.Error)</span>
                    <span class="badge bg-primary-subtle text-primary border">Total selec.: $@TotalLoteSeleccionado.ToString("N2")</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LimpiarLoteXml" disabled="@importandoLoteXml">
                        <i class="bi bi-trash me-1"></i>Limpiar lista
                    </button>
                    <button type="button" class="btn btn-sm btn-primary fw-semibold" @onclick="ImportarLoteXmlAsync" disabled="@(importandoLoteXml || SeleccionadosLoteCount == 0)">
                        <i class="bi bi-cloud-check me-1"></i>@(importandoLoteXml ? "Importando..." : $"Importar seleccionadas ({SeleccionadosLoteCount})")
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensajeLote))
            {
                <div class="px-4 pt-2">
                    <div class="alert @(loteEsError ? "alert-warning" : "alert-success") border-0 rounded-3 mb-0 py-2">
                        @mensajeLote
                    </div>
                </div>
            }

            <div class="card-body px-4 pt-2 pb-3">
                <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width:36px;" class="text-center">
                                    <input type="checkbox" class="form-check-input" checked="@TodosLoteSeleccionados" @onchange="ToggleTodosLote" disabled="@importandoLoteXml" title="Seleccionar todos los válidos" />
                                </th>
                                <th>Archivo</th>
                                <th>Proveedor / RUC</th>
                                <th>Factura / Emisión</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-end">IVA</th>
                                <th class="text-end">Total</th>
                                <th>Estado</th>
                                <th style="width:48px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in xmlLote)
                            {
                                <tr @key="item.Id" class="@(item.Seleccionado ? "table-primary" : "")">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input" @bind="item.Seleccionado" disabled="@(!item.PuedeImportar || importandoLoteXml)" />
                                    </td>
                                    <td class="small font-monospace text-truncate" style="max-width:190px;" title="@item.NombreArchivo">@item.NombreArchivo</td>
                                    <td>
                                        <div class="fw-semibold small">@(string.IsNullOrWhiteSpace(item.Proveedor) ? "—" : item.Proveedor)</div>
                                        <small class="text-muted font-monospace">@item.RucProveedor</small>
                                    </td>
                                    <td>
                                        <div class="small font-monospace">@item.NumeroFactura</div>
                                        <small class="text-muted">@item.FechaEmisionTexto</small>
                                    </td>
                                    <td class="text-end small">$@item.Subtotal.ToString("N2")</td>
                                    <td class="text-end small">$@item.Iva.ToString("N2")</td>
                                    <td class="text-end fw-semibold small">$@item.Total.ToString("N2")</td>
                                    <td>
                                        @switch (item.Estado)
                                        {
                                            case EstadoLoteXml.Listo:
                                                <span class="badge bg-success-subtle text-success border">Listo</span>
                                                break;
                                            case EstadoLoteXml.Importado:
                                                <span class="badge bg-primary-subtle text-primary border">@item.DetalleEstado</span>
                                                break;
                                            case EstadoLoteXml.Duplicado:
                                                <span class="badge bg-warning-subtle text-warning-emphasis border">@item.DetalleEstado</span>
                                                break;
                                            case EstadoLoteXml.Error:
                                                <span class="badge bg-danger-subtle text-danger border text-wrap text-start" style="max-width:220px;">@item.DetalleEstado</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" title="Quitar de la lista" @onclick="() => QuitarItemLote(item)" disabled="@importandoLoteXml">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <section class="n-client-search-strip" data-tour="invoice.client-search">
        <div class="n-client-search-strip-copy">
            <span class="n-client-search-eyebrow">Buscador de proveedor</span>
            <strong>Encuentra el proveedor que emitió la factura</strong>
        </div>
        <div class="n-client-search-input position-relative">
            <div class="n-input-wrapper">
                <i class="bi bi-search n-input-icon"></i>
                <input type="text" class="n-input n-input-with-icon" value="@proveedorBusqueda" @oninput="BuscarProveedorAsync" placeholder="Buscar por identificación o razón social" autocomplete="off" disabled="@guardando" />
            </div>
            @if (EsRucCompleto(proveedorBusqueda.Trim()))
            {
                <button type="button" class="btn btn-sm btn-outline-primary mt-2"
                        disabled="@(consultandoRuc || guardando)" @onclick="ConsultarProveedorSriAsync">
                    @(consultandoRuc ? "Consultando SRI…" : "Consultar RUC en el SRI")
                </button>
            }
            @if (!string.IsNullOrEmpty(mensajeSri))
            {
                <small class="d-block mt-2" role="status">@mensajeSri</small>
            }
            @if (sugerencias.Any())
            {
                <ul class="n-suggestions">
                    @foreach (var item in sugerencias)
                    {
                        <li @key="item.CodCliente" @onclick="() => SeleccionarProveedor(item)">
                            <strong>@item.RazonSocial</strong><br /><small>@item.Identificacion</small>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    @if (mostrarOpcionesProveedor)
    {
        <div class="n-client-create-notice n-client-create-notice-inline @(continuarConProveedor ? "is-continued" : "")" role="status">
            <span class="n-client-create-icon"><i class="bi bi-person-plus"></i></span>
            <div>
                <strong>Proveedor no registrado</strong>
                <small>@(continuarConProveedor
                    ? "El proveedor se registrará al guardar la factura."
                    : "Agrega el proveedor ahora o continúa con los datos de esta factura.")</small>
            </div>
            <div class="n-client-create-actions">
                <button type="button" class="n-client-create-check" @onclick="AbrirRegistroProveedor" disabled="@guardando">
                    <i class="bi bi-person-plus"></i><span>Agregar ahora</span>
                </button>
                <button type="button" class="n-client-continue-check @(continuarConProveedor ? "is-active" : "")"
                        @onclick="() => continuarConProveedor = !continuarConProveedor" disabled="@guardando">
                    <i class="bi @(continuarConProveedor ? "bi-x-circle" : "bi-arrow-right-circle")"></i>
                    <span>@(continuarConProveedor ? "Desmarcar" : "Continuar")</span>
                </button>
            </div>
        </div>
    }

    <div class="n-card mb-4" data-tour="invoice.client-section">
        <div class="n-card-header"><h5><i class="bi bi-person-vcard me-2"></i> Información del proveedor / emisor</h5><small class="d-none d-sm-flex"><i class="bi bi-arrow-repeat me-1"></i> Los datos se actualizarán automáticamente</small></div>
        <div class="n-card-body n-client-card-body">
            <div class="row g-3 n-client-block n-client-main-grid">
                <div class="col-lg-3 col-md-6">
                    <label class="n-label" for="tipo-persona-proveedor">Tipo de persona</label>
                    <div class="n-select-shell">
                        <select id="tipo-persona-proveedor" class="n-select" @bind="TipoPersonaProveedor">
                            <option value="natural">Persona natural</option>
                            <option value="juridica">Persona jurídica (empresa)</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6"><label class="n-label">Tipo identificación</label><div class="n-select-shell"><select class="n-select" @bind="model.TipoIdentificacion"><option value="">-- Seleccione --</option><option value="04">RUC</option><option value="05">Cédula</option><option value="06">Pasaporte</option></select></div></div>
                <div class="col-lg-3 col-md-6"><label class="n-label">Número de identificación *</label><div class="n-input-wrapper"><i class="bi bi-person-badge n-input-icon"></i><input class="n-input n-input-with-icon" @bind="model.RucProveedor" @bind:event="oninput" @bind:after="VerificarProveedorAsync" maxlength="13" /></div></div>
                <div class="col-lg-3 col-md-6"><label class="n-label">Obligado a llevar contabilidad</label><div class="n-select-shell"><select class="n-select" @bind="model.ObligadoContabilidad"><option value="NO">No</option><option value="SI">Sí</option></select></div></div>
                @if (EsPersonaNatural)
                {
                    <div class="col-lg-3 col-md-6"><label class="n-label">Nombres</label><input class="n-input" @bind="model.Nombres" maxlength="100" /></div>
                    <div class="col-lg-3 col-md-6"><label class="n-label">Apellidos</label><input class="n-input" @bind="model.Apellidos" maxlength="100" /></div>
                }
                else
                {
                    <div class="col-lg-3 col-md-6"><label class="n-label">Razón social *</label><input class="n-input" @bind="model.Proveedor" maxlength="150" /></div>
                    <div class="col-lg-3 col-md-6"><label class="n-label">Nombre comercial</label><input class="n-input" @bind="model.NombreComercial" maxlength="100" /></div>
                }
                <div class="col-lg-3 col-md-6"><label class="n-label">Fecha de emisión *</label><input class="n-input" type="date" @bind="model.FechaEmision" /></div>
            </div>

            <div class="n-client-block n-client-contact-modern">
                <div class="n-contact-field">
                    <label class="n-label">Dirección (Max 100)</label>
                    <div class="n-input-wrapper"><i class="bi bi-geo-alt n-input-icon"></i><input class="n-input n-input-with-icon" @bind="model.Direccion" maxlength="100" placeholder="Av. Principal y Calle Secundaria..." /></div>
                    <div class="n-payment-card n-payment-card-inline" data-tour="invoice.payment-section">
                        <div class="n-card-body"><div class="n-payment-layout">
                            <div class="n-payment-copy"><span class="n-payment-kicker">Cierre de compra</span><h6>Forma de pago del comprobante</h6><p>Selecciona cómo se registra esta factura en cuentas por pagar.</p></div>
                            <div class="n-payment-control">
                                <label class="n-label"><i class="bi bi-credit-card me-2"></i>Forma de pago</label>
                                <select class="n-select n-payment-select" @bind="model.FormaPago" @bind:after="OnFormaPagoChanged"><option value="">-- Seleccione --</option>@foreach (var forma in formasPago) { <option value="@forma.Codigo">@forma.Codigo - @forma.Descripcion</option> }</select>
                                <div class="mt-2"><label class="n-label d-flex align-items-center gap-2"><input type="checkbox" class="form-check-input mt-0" @bind="creditoSeleccionado" @bind:after="OnCreditoChanged" /><span>Es una factura a crédito</span></label></div>
                                @if (creditoSeleccionado)
                                {
                                    <div class="mt-2"><label class="n-label"><i class="bi bi-calendar3 me-2"></i>Días de crédito</label><input class="n-input" type="number" min="1" @bind="model.PlazoCredito" /></div>
                                }
                            </div>
                        </div></div>
                    </div>
                </div>
                <div class="n-contact-field n-contact-phone-field"><label class="n-label">Teléfono (Opcional)</label><div class="n-input-wrapper"><i class="bi bi-phone n-input-icon"></i><input class="n-input n-input-with-icon" @bind="model.Telefono" maxlength="30" placeholder="+593 99 123 4567" /></div></div>
                <div class="n-contact-field n-email-main-field"><div class="n-email-main-head"><label class="n-label mb-0">Correo electrónico principal</label></div><div class="n-email-primary-row"><div class="n-input-wrapper"><i class="bi bi-envelope n-input-icon"></i><input class="n-input n-input-with-icon" type="email" @bind="model.Correo" maxlength="150" placeholder="proveedor@ejemplo.com" /></div></div></div>
                <div class="n-contact-reference"><div class="d-flex justify-content-between align-items-end mb-2"><label class="n-label mb-0">Referencia (Max 100 palabras)</label></div><textarea class="n-textarea" rows="2" maxlength="500" @bind="model.Referencia" placeholder="Ingrese notas adicionales sobre el proveedor aquí..."></textarea></div>
            </div>
        </div>
    </div>

    <div class="n-card n-invoice-detail-card mb-4" data-tour="invoice.detail-section">
        <div class="n-card-header n-header-dark"><div class="invoice-detail-head"><h5 class="mb-0"><i class="bi bi-cart4 me-2"></i>Detalle de Factura</h5></div></div>
        <div class="n-card-body">
            <div class="table-responsive n-table-container"><table class="table table-hover align-middle mb-0">
                <thead class="n-table-header bg-light"><tr><th style="width:80px">Cód.</th><th style="min-width:180px">Concepto</th><th style="min-width:260px">Detalle</th><th class="text-center" style="width:80px">Cant.</th><th class="text-end" style="width:100px">Precio</th><th class="text-center" style="width:168px">Descuento</th><th class="text-end" style="width:100px">Base Imp.</th><th class="text-end" style="width:120px">IVA</th><th class="text-end" style="width:110px">Total</th><th class="text-center" style="width:40px"></th></tr></thead>
                <tbody>
                    @foreach (var detalle in model.Detalles)
                    {
                        <tr @key="detalle">
                            <td><input class="n-input-sm text-center fw-bold" @bind="detalle.Codigo" maxlength="50" placeholder="Código" /></td>
                            <td><input class="n-input-sm n-detail-concept-input" @bind="detalle.Descripcion" maxlength="150" placeholder="Producto o servicio" /></td>
                            <td><textarea class="n-input-sm n-detail-extra-input" rows="2" @bind="detalle.Detalle" maxlength="250" placeholder="Detalle adicional"></textarea></td>
                            <td><input class="n-input-sm text-center fw-bold" type="number" min="0.01" step="0.01" @bind="detalle.Cantidad" @bind:event="oninput" /></td>
                            <td><input class="n-input-sm text-end" type="number" min="0" step="0.01" @bind="detalle.PrecioUnitario" @bind:event="oninput" /></td>
                            <td><input class="n-input-sm text-end" type="number" min="0" step="0.01" @bind="detalle.Descuento" @bind:event="oninput" /></td>
                            <td class="text-end fw-medium">$ @detalle.Base.ToString("N2")</td>
                            <td><select class="form-select form-select-sm text-center" @bind="detalle.Tarifa"><option value="0">0%</option><option value="5">5%</option><option value="8">8%</option><option value="12">12%</option><option value="15">15%</option></select></td>
                            <td class="text-end fw-bold" style="color:var(--n-blue)">$ @((detalle.Base + detalle.Iva).ToString("N2"))</td>
                            <td class="text-center"><button type="button" class="n-btn-primary p-0" style="height:30px;width:30px;border-radius:6px" @onclick="() => QuitarDetalle(detalle)"><i class="bi bi-trash3"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table></div>

            <div class="n-detail-table-actions">
                <button type="button" class="n-table-add-product-btn" @onclick="AgregarDetalle"><i class="bi bi-plus-circle"></i><span>Agregar línea de detalle</span></button>
            </div>

            <div class="n-detail-bottom-layout">
                <div class="n-detail-assist-column">
                    <div class="n-frequent-concepts n-client-concepts-panel">
                        <div class="n-frequent-concepts-head"><div><span>Detalle de compra</span><small>Completa los conceptos y valores de la factura del proveedor.</small></div></div>
                        <div class="n-frequent-concepts-grid">
                            <div class="n-frequent-concept-card"><span class="n-frequent-concept-icon"><i class="bi bi-box-seam"></i></span><span><strong>Compra manual</strong><small>Documento interno sin emisión al SRI</small></span></div>
                            <div class="n-frequent-concept-card"><span class="n-frequent-concept-icon"><i class="bi bi-wallet2"></i></span><span><strong>Cuentas por pagar</strong><small>El crédito se registra automáticamente</small></span></div>
                        </div>
                    </div>
                </div>
                <div class="n-summary-column">
                    <div class="n-summary-top-grid"><div class="docs-total-card" data-tour="invoice.totals-section"><div class="docs-total-card-header"><span>Resumen</span><h6>Totales del comprobante</h6></div><div class="docs-total-fiscal-list">
                        <div class="docs-total-fiscal-row"><span>SUBTOTAL BASE GRAVADA</span><strong>$ @SubtotalGravado.ToString("N2")</strong></div>
                        <div class="docs-total-fiscal-row"><span>SUBTOTAL BASE 0%</span><strong>$ @SubtotalCero.ToString("N2")</strong></div>
                        <div class="docs-total-fiscal-row"><span>SUBTOTAL NO OBJETO IVA</span><strong>$ 0.00</strong></div>
                        <div class="docs-total-fiscal-row"><span>SUBTOTAL EXENTO IVA</span><strong>$ 0.00</strong></div>
                        <div class="docs-total-fiscal-row docs-total-fiscal-discount"><span>DESCUENTO</span><strong>$ @TotalDescuento.ToString("N2")</strong></div>
                        <div class="docs-total-fiscal-row"><span>SUBTOTAL CON DESCUENTO</span><strong>$ @model.Subtotal.ToString("N2")</strong></div>
                        <div class="docs-total-fiscal-row"><span>ICE</span><strong>$ 0.00</strong></div>
                        @foreach (var tarifa in TarifasConIva)
                        {
                            <div class="docs-total-fiscal-row docs-total-fiscal-tax"><span>IVA TARIFA @tarifa.ToString("0.##", CultureInfo.InvariantCulture)%</span><strong>$ @IvaPorTarifa(tarifa).ToString("N2")</strong></div>
                        }
                        <div class="docs-total-fiscal-row"><span>SERVICIO 10%</span><strong>$ 0.00</strong></div>
                        <div class="docs-total-fiscal-row"><span>IRBPNR</span><strong>$ 0.00</strong></div>
                        <div class="docs-total-fiscal-row docs-total-fiscal-total"><span>TOTAL</span><strong>$ @model.Total.ToString("N2")</strong></div>
                    </div></div></div>
                </div>
            </div>

            @if (model.EsCredito)
            {
                <div class="alert alert-warning border-0 rounded-3 mt-4 mb-0"><i class="bi bi-wallet2 me-2"></i>Esta factura se agregará a cuentas por pagar con vencimiento a @Math.Max(model.PlazoCredito, 1) días.</div>
            }
            <div class="n-detail-actions-row"><a class="n-btn-link" href="@EContaxRoutes.CuentasPorPagar">Cancelar / volver</a><button type="button" class="n-btn-primary" @onclick="GuardarAsync" disabled="@guardando"><i class="bi bi-check2-circle fs-5 me-2"></i>@(guardando ? "Guardando..." : "Guardar factura de compra")</button></div>
        </div>
    </div>
</div>

<DocumentWorkspaceModal Visible="@(proveedorPrefill is not null)"
                        Eyebrow="Proveedores"
                        Title="Registrar proveedor"
                        ModalClass="docs-client-workspace-modal"
                        OnClose="@(() => proveedorPrefill = null)">
    <div class="docs-client-crud-frame">
        <HosvetKardex.Web.Components.Pages.Contabilidad.Clientes ClientePrefill="@proveedorPrefill"
                                                                 EsModoProveedores="true"
                                                                 PersonaNaturalPrefill="@EsPersonaNatural"
                                                                 OnClienteGuardado="ProveedorGuardadoAsync" />
    </div>
</DocumentWorkspaceModal>

@code {
    private const int MaxXmlBatch = 50;
    private FacturaCompraManualVM model = new() { Detalles = new() { new() } };
    private List<LiquidacionProveedorLookupDto> sugerencias = new();
    private List<LiquidacionCatalogoOptionDto> formasPago = new();
    private List<ItemLoteXml> xmlLote = new();
    private string proveedorBusqueda = "";
    private int currentUserId;
    private bool guardando;
    private bool mostrarOpcionesProveedor;
    private bool continuarConProveedor;
    private int revisionProveedor;
    private Simetric.Models.Cliente? proveedorPrefill;
    private bool cargandoLoteXml;
    private bool importandoLoteXml;
    private bool creditoSeleccionado;
    private bool xmlCargado;
    private string error = "";
    private string mensajeLote = "";
    private bool loteEsError;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = int.TryParse(auth.User.FindFirst("IdUsuario")?.Value, out var id) ? id : 0;
        if (currentUserId <= 0) { Navigation.NavigateTo("/login", true); return; }
        try
        {
            formasPago = await LiquidacionCompraService.ObtenerFormasPagoCompraAsync();
        }
        catch (Exception ex)
        {
            error = $"No se pudieron cargar las formas de pago: {ex.Message}";
        }
    }

    private async Task BuscarProveedorAsync(ChangeEventArgs e)
    {
        RestablecerAvisoProveedor();
        var revision = revisionProveedor;
        mensajeSri = null;
        proveedorBusqueda = e.Value?.ToString() ?? "";
        var filtro = proveedorBusqueda.Trim();
        error = "";
        sugerencias.Clear();
        if (currentUserId <= 0 || filtro.Length == 0)
            return;

        try
        {
            var coincidencias = await LiquidacionCompraService.BuscarProveedoresAsync(filtro, currentUserId);
            if (revision != revisionProveedor)
                return;

            sugerencias = coincidencias;
            if (EsIdentificacionCompleta(filtro) && !coincidencias.Any(x => x.Identificacion == filtro))
            {
                if (!string.IsNullOrWhiteSpace(model.RucProveedor) && model.RucProveedor.Trim() != filtro)
                {
                    model.Proveedor = "";
                    model.EsPersonaNatural = null;
                    model.NombreComercial = "";
                    model.Nombres = "";
                    model.Apellidos = "";
                    model.Direccion = "";
                    model.Telefono = "";
                    model.Correo = "";
                    model.Referencia = "";
                    model.ObligadoContabilidad = "NO";
                }

                model.CodCliente = null;
                model.RucProveedor = filtro;
                model.TipoIdentificacion = EsRucCompleto(filtro) ? "04" : "05";
                mostrarOpcionesProveedor = true;
            }
        }
        catch (Exception ex)
        {
            if (revision == revisionProveedor)
                error = $"No se pudo buscar el proveedor: {ex.Message}";
        }
    }

    private bool consultandoRuc;
    private string? mensajeSri;

    private static bool EsRucCompleto(string valor) =>
        valor.Length == 13 && valor.All(c => c is >= '0' and <= '9');

    private static bool EsIdentificacionCompleta(string valor) =>
        valor.Length is 10 or 13 && valor.All(char.IsAsciiDigit);

    private void RestablecerAvisoProveedor()
    {
        revisionProveedor++;
        mostrarOpcionesProveedor = false;
        continuarConProveedor = false;
    }

    private async Task VerificarProveedorAsync()
    {
        RestablecerAvisoProveedor();
        model.CodCliente = null;
        var revision = revisionProveedor;
        var identificacion = model.RucProveedor.Trim();
        if (currentUserId <= 0 || !EsIdentificacionCompleta(identificacion))
            return;

        try
        {
            var coincidencias = await LiquidacionCompraService.BuscarProveedoresAsync(identificacion, currentUserId);
            if (revision == revisionProveedor)
                mostrarOpcionesProveedor = !coincidencias.Any(x => x.Identificacion == identificacion);
        }
        catch (Exception)
        {
            if (revision == revisionProveedor)
                error = "No se pudo verificar si el proveedor está registrado.";
        }
    }

    private async Task ConsultarProveedorSriAsync()
    {
        var ruc = proveedorBusqueda.Trim();
        if (currentUserId <= 0 || consultandoRuc || guardando || !EsRucCompleto(ruc))
            return;

        var modeloConsultado = model;
        var identificacionOriginal = model.RucProveedor;
        var proveedorOriginal = model.Proveedor;
        consultandoRuc = true;
        mensajeSri = null;
        try
        {
            var datos = await CedulaLookup.ConsultarAsync(ruc);
            if (model != modeloConsultado || model.RucProveedor != identificacionOriginal ||
                model.Proveedor != proveedorOriginal || proveedorBusqueda.Trim() != ruc || guardando)
                return;

            if (!datos.Success || !datos.Found || string.IsNullOrWhiteSpace(datos.RazonSocial))
            {
                mensajeSri = datos.Mensaje ?? "El SRI no devolvió datos para este RUC.";
                return;
            }

            if (model.RucProveedor != ruc)
            {
                model.CodCliente = null;
                model.Telefono = model.Correo = model.Nombres = model.Apellidos = "";
            }

            model.RucProveedor = ruc;
            model.TipoIdentificacion = "04";
            if (TipoClienteClasificacion.EsNatural(datos.TipoContribuyente))
                model.EsPersonaNatural = true;
            else if (TipoClienteClasificacion.EsJuridica(datos.TipoContribuyente))
                model.EsPersonaNatural = false;
            model.Proveedor = datos.RazonSocial;
            if (EsPersonaNatural && string.IsNullOrWhiteSpace(model.Nombres) && string.IsNullOrWhiteSpace(model.Apellidos))
                model.Nombres = datos.RazonSocial;
            model.NombreComercial = datos.NombreComercial ?? datos.RazonSocial;
            model.ObligadoContabilidad = datos.ObligadoLlevarContabilidad ?? "NO";
            model.Direccion = datos.DireccionMatriz ?? datos.DireccionEstablecimiento ?? "";
            sugerencias.Clear();
            mensajeSri = "Datos del proveedor cargados desde el SRI.";
            await VerificarProveedorAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
            if (proveedorBusqueda.Trim() == ruc)
                mensajeSri = "No se pudo consultar el SRI. Puedes completar los datos manualmente.";
        }
        finally
        {
            consultandoRuc = false;
        }
    }

    private void SeleccionarProveedor(LiquidacionProveedorLookupDto proveedor)
    {
        RestablecerAvisoProveedor();
        mensajeSri = null;
        model.CodCliente = proveedor.CodCliente;
        model.RucProveedor = proveedor.Identificacion;
        model.Proveedor = proveedor.RazonSocial;
        model.TipoIdentificacion = string.IsNullOrWhiteSpace(proveedor.TipoIdentificacion) ? model.TipoIdentificacion : proveedor.TipoIdentificacion;
        model.EsPersonaNatural = proveedor.EsPersonaNatural;
        model.NombreComercial = proveedor.NombreComercial;
        model.Nombres = proveedor.Nombres;
        model.Apellidos = proveedor.Apellidos;
        if (EsPersonaNatural && string.IsNullOrWhiteSpace(model.Nombres) && string.IsNullOrWhiteSpace(model.Apellidos))
            model.Nombres = proveedor.RazonSocial;
        model.Direccion = proveedor.Direccion;
        model.Telefono = string.IsNullOrWhiteSpace(proveedor.TelefonoMovil) ? proveedor.TelefonoFijo : proveedor.TelefonoMovil;
        model.Correo = proveedor.Correo;
        model.FormaPago = string.IsNullOrWhiteSpace(proveedor.FormaPago) ? model.FormaPago : proveedor.FormaPago;
        model.PlazoCredito = proveedor.PlazoPago ?? 0;
        creditoSeleccionado = model.FormaPago == "19" || model.PlazoCredito > 0;
        proveedorBusqueda = proveedor.RazonSocial;
        sugerencias.Clear();
    }

    private int SeleccionadosLoteCount => xmlLote.Count(x => x.Seleccionado && x.PuedeImportar);
    private decimal TotalLoteSeleccionado => xmlLote.Where(x => x.Seleccionado && x.PuedeImportar).Sum(x => x.Total);
    private bool TodosLoteSeleccionados => xmlLote.Any(x => x.PuedeImportar) && xmlLote.Where(x => x.PuedeImportar).All(x => x.Seleccionado);

    private void ToggleTodosLote(ChangeEventArgs e)
    {
        var marcar = e.Value is bool b && b;
        foreach (var item in xmlLote.Where(x => x.PuedeImportar))
            item.Seleccionado = marcar;
    }

    private void QuitarItemLote(ItemLoteXml item) => xmlLote.Remove(item);

    private void LimpiarLoteXml()
    {
        xmlLote.Clear();
        mensajeLote = "";
        loteEsError = false;
    }

    private async Task OnXmlSelected(InputFileChangeEventArgs e)
    {
        error = "";
        mensajeLote = "";
        loteEsError = false;

        var archivos = e.GetMultipleFiles(MaxXmlBatch);
        if (archivos.Count == 0)
        {
            error = "No se seleccionó ningún archivo XML.";
            return;
        }

        if (archivos.Count == 1 && xmlLote.Count == 0)
        {
            xmlCargado = false;
            try
            {
                var file = archivos[0];
                if (file.Size > 10 * 1024 * 1024)
                    throw new InvalidOperationException("El archivo XML supera el máximo permitido de 10 MB.");

                using var stream = file.OpenReadStream(10 * 1024 * 1024);
                using var reader = new StreamReader(stream);
                var preview = await ComprasXmlService.LeerCompraDesdeXmlAsync(await reader.ReadToEndAsync(), permitirFactura: true);
                CargarPreviewEnFormulario(preview);
                await VerificarProveedorAsync();
            }
            catch (Exception ex)
            {
                error = $"No se pudo cargar el XML: {ex.GetBaseException().Message}";
            }
            return;
        }

        cargandoLoteXml = true;
        try
        {
            var clavesEnLote = new HashSet<string>(
                xmlLote.Where(x => !string.IsNullOrWhiteSpace(x.ClaveAcceso)).Select(x => x.ClaveAcceso!),
                StringComparer.OrdinalIgnoreCase);

            var disponibles = MaxXmlBatch - xmlLote.Count;
            if (disponibles <= 0)
            {
                mensajeLote = $"Ya alcanzaste el máximo de {MaxXmlBatch} archivos en la lista. Limpia o importa los actuales primero.";
                loteEsError = true;
                return;
            }

            foreach (var file in archivos.Take(disponibles))
            {
                var item = new ItemLoteXml { NombreArchivo = file.Name };
                try
                {
                    if (file.Size > 10 * 1024 * 1024)
                        throw new InvalidOperationException("Supera 10 MB.");

                    using var stream = file.OpenReadStream(10 * 1024 * 1024);
                    using var reader = new StreamReader(stream);
                    var preview = await ComprasXmlService.LeerCompraDesdeXmlAsync(await reader.ReadToEndAsync(), permitirFactura: true);
                    if (preview.CodDocumentoSustento != "01")
                        throw new InvalidOperationException("No es una factura electrónica (01).");

                    item.Preview = preview;
                    item.ClaveAcceso = preview.ClaveAcceso;
                    item.Proveedor = string.IsNullOrWhiteSpace(preview.RazonSocialProveedor) ? preview.RucProveedor : preview.RazonSocialProveedor;
                    item.RucProveedor = preview.RucProveedor;
                    item.NumeroFactura = $"{preview.Estab}-{preview.PtoEmi}-{preview.Secuencial}".Trim('-');
                    item.FechaEmisionTexto = preview.FechaEmision?.ToString("dd/MM/yyyy") ?? "—";
                    item.Subtotal = preview.TotalSinImpuestos;
                    item.Total = preview.ImporteTotal;
                    item.Iva = Math.Max(0m, preview.ImporteTotal - preview.TotalSinImpuestos);

                    if (preview.YaImportado)
                    {
                        item.Estado = EstadoLoteXml.Duplicado;
                        item.DetalleEstado = "Ya registrada";
                        item.Seleccionado = false;
                    }
                    else if (!string.IsNullOrWhiteSpace(preview.ClaveAcceso) && !clavesEnLote.Add(preview.ClaveAcceso))
                    {
                        item.Estado = EstadoLoteXml.Duplicado;
                        item.DetalleEstado = "Repetida en lista";
                        item.Seleccionado = false;
                    }
                    else
                    {
                        item.Estado = EstadoLoteXml.Listo;
                        item.DetalleEstado = "Listo";
                        item.Seleccionado = true;
                    }
                }
                catch (Exception ex)
                {
                    item.Estado = EstadoLoteXml.Error;
                    item.DetalleEstado = ex.GetBaseException().Message;
                    item.Seleccionado = false;
                }

                xmlLote.Add(item);
            }

            if (e.FileCount > MaxXmlBatch || archivos.Count > disponibles)
            {
                mensajeLote = $"Se cargaron hasta el límite máximo de {MaxXmlBatch} archivos en la lista.";
                loteEsError = true;
            }
        }
        finally
        {
            cargandoLoteXml = false;
        }
    }

    private void CargarPreviewEnFormulario(CompraXmlPreviewDto preview)
    {
        var tarifasPermitidas = new[] { 0, 5, 8, 12, 15 };
        model = new FacturaCompraManualVM
        {
            RucProveedor = preview.RucProveedor,
            Proveedor = preview.RazonSocialProveedor,
            TipoIdentificacion = preview.RucProveedor.Count(char.IsDigit) == 13 ? "04" : "05",
            NombreComercial = preview.RazonSocialProveedor,
            Direccion = preview.DireccionProveedor,
            Telefono = preview.TelefonoProveedor,
            Correo = preview.EmailProveedor,
            FechaEmision = preview.FechaEmision?.Date ?? DateTime.Today,
            FormaPago = formasPago.Any(x => x.Codigo == preview.FormaPago) ? preview.FormaPago : "20",
            Referencia = $"Importada desde XML {preview.Estab}-{preview.PtoEmi}-{preview.Secuencial}".Trim('-'),
            Observacion = "Factura de compra cargada desde XML.",
            Detalles = preview.Detalles.Select(x => new FacturaCompraManualDetalleVM
            {
                Codigo = string.IsNullOrWhiteSpace(x.CodPrincipal) ? x.CodAuxiliar : x.CodPrincipal,
                Descripcion = x.Descripcion,
                Detalle = "Importado desde XML",
                Cantidad = x.Cantidad > 0 ? x.Cantidad : 1m,
                PrecioUnitario = x.PrecioUnitario,
                Descuento = x.Descuento,
                Tarifa = tarifasPermitidas.Contains(x.Tarifa) ? x.Tarifa : 0
            }).ToList()
        };

        if (model.Detalles.Count == 0)
            model.Detalles.Add(new());

        if (EsPersonaNatural)
            model.Nombres = preview.RazonSocialProveedor;

        creditoSeleccionado = model.FormaPago == "19";
        model.PlazoCredito = creditoSeleccionado ? 30 : 0;
        proveedorBusqueda = model.Proveedor;
        sugerencias.Clear();
        xmlCargado = true;
    }

    private async Task ImportarLoteXmlAsync()
    {
        var seleccionados = xmlLote.Where(x => x.Seleccionado && x.PuedeImportar && x.Preview is not null).ToList();
        if (seleccionados.Count == 0)
            return;

        importandoLoteXml = true;
        mensajeLote = "";
        loteEsError = false;
        int importadas = 0;
        int duplicadas = 0;
        int errores = 0;

        try
        {
            foreach (var item in seleccionados)
            {
                try
                {
                    var (codFactura, duplicada) = await FacturaCompraService.ImportarFacturaXmlEContaxAsync(currentUserId, item.Preview!);
                    item.Seleccionado = false;
                    if (duplicada)
                    {
                        item.Estado = EstadoLoteXml.Duplicado;
                        item.DetalleEstado = $"Duplicada (#{codFactura})";
                        duplicadas++;
                    }
                    else
                    {
                        item.Estado = EstadoLoteXml.Importado;
                        item.DetalleEstado = $"Importada #{codFactura}";
                        importadas++;
                    }
                }
                catch (Exception ex)
                {
                    item.Estado = EstadoLoteXml.Error;
                    item.DetalleEstado = ex.GetBaseException().Message;
                    item.Seleccionado = false;
                    errores++;
                }
            }

            mensajeLote = $"Proceso completado: {importadas} importada(s), {duplicadas} duplicada(s), {errores} con error.";
            loteEsError = errores > 0 && importadas == 0;
            if (importadas > 0)
                await AlertService.ShowSuccessAsync($"Se importaron {importadas} factura(s) de compra correctamente.");
        }
        finally
        {
            importandoLoteXml = false;
        }
    }

    private void AgregarDetalle() => model.Detalles.Add(new());
    private void QuitarDetalle(FacturaCompraManualDetalleVM detalle) { if (model.Detalles.Count > 1) model.Detalles.Remove(detalle); }

    private void OnFormaPagoChanged()
    {
        if (model.FormaPago == "19")
        {
            creditoSeleccionado = true;
            model.PlazoCredito = Math.Max(model.PlazoCredito, 30);
        }
    }

    private void OnCreditoChanged()
    {
        if (creditoSeleccionado)
        {
            model.PlazoCredito = Math.Max(model.PlazoCredito, 30);
            if (model.FormaPago != "19") model.FormaPago = "19";
        }
        else
        {
            model.PlazoCredito = 0;
            if (model.FormaPago == "19") model.FormaPago = "20";
        }
    }

    private decimal SubtotalGravado => model.Detalles.Where(x => x.Tarifa > 0).Sum(x => x.Base);
    private decimal SubtotalCero => model.Detalles.Where(x => x.Tarifa == 0).Sum(x => x.Base);
    private decimal TotalDescuento => model.Detalles.Sum(x => x.Descuento);
    private IEnumerable<decimal> TarifasConIva => model.Detalles.Where(x => x.Tarifa > 0 && x.Iva > 0).Select(x => x.Tarifa).Distinct().OrderBy(x => x);
    private decimal IvaPorTarifa(decimal tarifa) => model.Detalles.Where(x => x.Tarifa == tarifa).Sum(x => x.Iva);

    private void LimpiarFormulario()
    {
        RestablecerAvisoProveedor();
        model = new() { Detalles = new() { new() } };
        proveedorBusqueda = "";
        sugerencias.Clear();
        creditoSeleccionado = false;
        xmlCargado = false;
        LimpiarLoteXml();
    }

    private void AbrirRegistroProveedor()
    {
        continuarConProveedor = false;
        var identificacion = model.RucProveedor.Trim();
        proveedorPrefill = new()
        {
            Numeroidentificacion = identificacion,
            Tipoidentificacion = EsRucCompleto(identificacion) ? "04" : "05",
            Nombrerazonsocial = EsPersonaNatural ? null : NombreProveedorFactura,
            Nombrecomercial = EsPersonaNatural ? null : model.NombreComercial,
            Nombres = EsPersonaNatural ? model.Nombres : null,
            Apellidos = EsPersonaNatural ? model.Apellidos : null,
            Direccion = model.Direccion,
            Telefonoconvencional = model.Telefono,
            Correo = model.Correo,
            Observaciones = model.Referencia,
            Oblgconta = model.ObligadoContabilidad,
            DiasCredito = model.PlazoCredito
        };
    }

    private async Task ProveedorGuardadoAsync(string identificacion)
    {
        proveedorPrefill = null;
        RestablecerAvisoProveedor();
        model.RucProveedor = identificacion;
        try
        {
            var proveedores = await LiquidacionCompraService.BuscarProveedoresAsync(identificacion, currentUserId);
            var proveedor = proveedores.FirstOrDefault(x => x.Identificacion == identificacion);
            if (proveedor is null)
                return;

            var formaPago = model.FormaPago;
            var plazoCredito = model.PlazoCredito;
            var modoCredito = creditoSeleccionado;
            SeleccionarProveedor(proveedor);
            model.FormaPago = formaPago;
            model.PlazoCredito = plazoCredito;
            creditoSeleccionado = modoCredito;
        }
        catch (Exception ex)
        {
            error = $"Se guardó el proveedor, pero no se pudieron actualizar sus datos en la factura: {ex.Message}";
        }
    }

    private bool EsPersonaNatural => model.EsPersonaNatural ?? (model.TipoIdentificacion is "05" or "06");

    private string TipoPersonaProveedor
    {
        get => EsPersonaNatural ? "natural" : "juridica";
        set => model.EsPersonaNatural = value == "natural";
    }

    private string NombreProveedorFactura => EsPersonaNatural
        ? $"{model.Nombres.Trim()} {model.Apellidos.Trim()}".Trim()
        : model.Proveedor.Trim();

    private async Task GuardarAsync()
    {
        if (guardando)
            return;

        guardando = true;
        var razonSocial = model.Proveedor;
        var personaNatural = model.EsPersonaNatural;
        try
        {
            model.Proveedor = NombreProveedorFactura;
            model.EsPersonaNatural = EsPersonaNatural;
            var id = await FacturaCompraService.GuardarAsync(currentUserId, model, continuarConProveedor);
            await AlertService.ShowSuccessAsync($"Factura de compra guardada. Código interno: {id}");
            Navigation.NavigateTo(EContaxRoutes.CuentasPorPagar);
        }
        catch (ProveedorCompraNoRegistradoException) { mostrarOpcionesProveedor = true; }
        catch (InvalidOperationException ex) { await AlertService.ShowErrorAsync(ex.Message); }
        catch (Exception ex) { error = $"No se pudo guardar la factura: {ex.Message}"; }
        finally
        {
            model.Proveedor = razonSocial;
            model.EsPersonaNatural = personaNatural;
            guardando = false;
        }
    }

    private enum EstadoLoteXml
    {
        Listo,
        Importado,
        Duplicado,
        Error
    }

    private sealed class ItemLoteXml
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string NombreArchivo { get; set; } = "";
        public string? ClaveAcceso { get; set; }
        public string Proveedor { get; set; } = "";
        public string RucProveedor { get; set; } = "";
        public string NumeroFactura { get; set; } = "";
        public string FechaEmisionTexto { get; set; } = "—";
        public decimal Subtotal { get; set; }
        public decimal Iva { get; set; }
        public decimal Total { get; set; }
        public bool Seleccionado { get; set; }
        public EstadoLoteXml Estado { get; set; } = EstadoLoteXml.Listo;
        public string DetalleEstado { get; set; } = "";
        public CompraXmlPreviewDto? Preview { get; set; }
        public bool PuedeImportar => Estado == EstadoLoteXml.Listo && Preview is not null;
    }
}
