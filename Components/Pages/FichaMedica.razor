    private FichaMedicaCompletaDto Ficha { get; set; } = new();
    private List<DiagnosticoCie10Dto> Diagnosticos { get; set; } = new();
    private List<CatalogoCie10ItemDto> ResultadosCie10 { get; set; } = new();
