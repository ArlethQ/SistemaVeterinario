    private async Task AgregarServicioOrdenAsync()
    {
        try
        {
            int ordenTarget = Ficha.MedOrden > 0 ? Ficha.MedOrden : IdOrden;
            int nhclTarget = Ficha.MedNhcl > 0 ? Ficha.MedNhcl : Nhcl;

            if (ordenTarget <= 0 || nhclTarget <= 0)
            {
                EsError = true;
                MensajeAlerta = "No hay una orden activa válida para registrar servicios.";
                return;
            }

            if (_cantidadServicio <= 0)
            {
                EsError = true;
                MensajeAlerta = "La cantidad del servicio debe ser mayor a cero.";
                return;
            }

            var listaActual = _cacheServiciosPorCategoria.TryGetValue(_categoriaServicio, out var cache)
                ? cache
                : [];

            var servicio = !string.IsNullOrWhiteSpace(_codigoServicioSeleccionado)
                ? listaActual.FirstOrDefault(s => s.Codigo == _codigoServicioSeleccionado)
                : listaActual.FirstOrDefault(s => string.Equals(s.Descripcion.Trim(), _filtroServicio.Trim(), StringComparison.OrdinalIgnoreCase));

            if (servicio is null)
            {
                EsError = true;
                MensajeAlerta = $"Seleccione un servicio válido del catálogo de {_categoriaServicio}.";
                return;
            }

            string obs = string.IsNullOrWhiteSpace(_observacionServicio) ? servicio.Descripcion : _observacionServicio.Trim();

            switch (_categoriaServicio)
            {
                case "Laboratorio":
                    await LabImagenService.AgregarOrdenLaboratorioAsync(new OrdenLaboratorioItemDto
                    {
                        IdOrden = ordenTarget,
                        Nhcl = nhclTarget,
                        CodigoProd = servicio.Codigo,
                        DescripcionExamen = servicio.Descripcion,
                        Observaciones = obs,
                        Cantidad = (int)Math.Max(1, Math.Round(_cantidadServicio)),
                        Prioridad = _prioridadServicio,
                        Estado = "POR REALIZAR",
                        Fecha = DateTime.Now,
                        Precio = servicio.Precio
                    });
                    OrdenesLab = await LabImagenService.ObtenerOrdenesLaboratorioAsync(ordenTarget, nhclTarget);
                    break;

                case "Imagenología":
                    await LabImagenService.AgregarOrdenImagenAsync(new OrdenImagenItemDto
                    {
                        IdOrden = ordenTarget,
                        Nhcl = nhclTarget,
                        CodigoProd = servicio.Codigo,
                        DescripcionEstudio = servicio.Descripcion,
                        Observaciones = obs,
                        Cantidad = (int)Math.Max(1, Math.Round(_cantidadServicio)),
                        Estado = "Por Facturar",
                        Fecha = DateTime.Now,
                        Precio = servicio.Precio
                    });
                    OrdenesImagen = await LabImagenService.ObtenerOrdenesImagenAsync(ordenTarget, nhclTarget);
                    break;

                case "Fisioterapia":
                    if (!int.TryParse(servicio.Codigo, out int idProdFisio) || idProdFisio <= 0)
                    {
                        EsError = true;
                        MensajeAlerta = "No se pudo identificar el código de producto de fisioterapia.";
                        return;
                    }
                    await AdminClinicaService.GuardarFisioterapiaAsync(new FisioterapiaOrdenDto
                    {
                        IdOrden = ordenTarget,
                        Nhcl = nhclTarget,
                        IdProducto = idProdFisio,
                        Descripcion = servicio.Descripcion,
                        Observaciones = obs,
                        Cantidad = _cantidadServicio,
                        Precio = servicio.Precio,
                        Fecha = DateTime.Now
                    });
                    OrdenesFisio = await AdminClinicaService.ObtenerFisioterapiaAsync(ordenTarget, nhclTarget);
                    break;
            }

            _codigoServicioSeleccionado = string.Empty;
            _filtroServicio = string.Empty;
            _observacionServicio = string.Empty;
            _cantidadServicio = 1;
            _mostrarSugerenciasServicio = false;
            FiltrarServiciosCategoria();

            EsError = false;
            MensajeAlerta = $"Servicio de {_categoriaServicio} agregado a la orden #{ordenTarget}.";
        }
        catch (Exception ex)
        {
            EsError = true;
            MensajeAlerta = $"Error al agregar servicio: {ex.Message}";
        }
    }

    private async Task EliminarServicioPorCategoriaAsync(string categoria, int sec)
    {
        try
        {
            int ordenTarget = Ficha.MedOrden > 0 ? Ficha.MedOrden : IdOrden;
            int nhclTarget = Ficha.MedNhcl > 0 ? Ficha.MedNhcl : Nhcl;

            switch (categoria)
            {
                case "Laboratorio":
                    await LabImagenService.EliminarOrdenLaboratorioAsync(sec);
                    OrdenesLab = await LabImagenService.ObtenerOrdenesLaboratorioAsync(ordenTarget, nhclTarget);
                    break;
                case "Imagenología":
                    await LabImagenService.EliminarOrdenImagenAsync(sec);
                    OrdenesImagen = await LabImagenService.ObtenerOrdenesImagenAsync(ordenTarget, nhclTarget);
                    break;
                case "Fisioterapia":
                    await AdminClinicaService.EliminarFisioterapiaAsync(sec);
                    OrdenesFisio = await AdminClinicaService.ObtenerFisioterapiaAsync(ordenTarget, nhclTarget);
                    break;
            }

            EsError = false;
            MensajeAlerta = null;
        }
        catch (Exception ex)
        {
            EsError = true;
            MensajeAlerta = $"Error al eliminar servicio: {ex.Message}";
        }
    }

    private bool ValidarPacienteParaPdf(out PacienteHeaderDto pac)
    {
        if (Paciente is null || Paciente.Nhcl <= 0)
        {
            pac = null!;
            EsError = true;
            MensajeAlerta = "No se pudo generar el PDF: faltan los datos reales del paciente.";
            return false;
        }
        pac = Paciente;
        return true;
    }

    private async Task DescargarPdfDocumentoAsync(byte[] pdfBytes, string nombreArchivo)
    {
        await JS.InvokeVoidAsync("descargarArchivoBase64", nombreArchivo, "application/pdf", Convert.ToBase64String(pdfBytes));
    }

    private async Task ImprimirRecetaMedicaPdfAsync()
    {
        if (!ValidarPacienteParaPdf(out var pac)) return;
        if (!RecetaItems.Any())
        {
            EsError = true;
            MensajeAlerta = "Agregue al menos un medicamento antes de imprimir la receta médica.";
            return;
        }
        int ordenTarget = Ficha.MedOrden > 0 ? Ficha.MedOrden : IdOrden;
        var pdfBytes = ReportService.GenerarRecetaMedicaPdf(pac, RecetaItems, Diagnosticos, Ficha.IndicacionesGeneralesReceta ?? "");
        await DescargarPdfDocumentoAsync(pdfBytes, $"Receta_Medica_Orden_{ordenTarget}.pdf");
    }

