    private int _versionCambios;
    private int _versionGuardada;
    private readonly SemaphoreSlim _guardadoAutomatico = new(1, 1);

    private async Task RegistrarCambioSoapAsync()
    {
        if (!FichaEditable || Guardando)
            return;

        var ficha = Ficha;
        var version = ++_versionCambios;
        await Task.Delay(450);
        if (ReferenceEquals(ficha, Ficha) && version == _versionCambios && !Guardando)
            await GuardarCambiosSoapAsync();
    }

    private async Task<bool> GuardarCambiosSoapAsync()
    {
        await _guardadoAutomatico.WaitAsync();
        try
        {
            while (_versionGuardada != _versionCambios)
            {
                var version = _versionCambios;
                if (!FichaEditable || Ficha.Peso < 0 || Ficha.Temperatura < 0 ||
                    Ficha.FrecuenciaCardiaca < 0 || Ficha.FrecuenciaRespiratoria < 0 ||
                    Ficha.TiempoLlenadoCapilar < 0 || Ficha.Deshidratacion is < 0 or > 100 ||
                    !await AdmisionService.PuedeConsultarOrdenAsync(IdOrden, Nhcl) ||
                    !await ConsultaService.GuardarFichaMedicaAsync(Ficha, Session.IdUser, cerrarOrden: false))
                {
                    EsError = true;
                    MensajeAlerta = ErrorGuardadoAutomatico;
                    return false;
                }

                _versionGuardada = version;
            }

            if (MensajeAlerta == ErrorGuardadoAutomatico)
            {
                MensajeAlerta = null;
                EsError = false;
            }
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar cambios de la ficha SOAP de la orden {Orden}", IdOrden);
        }
        finally
        {
            _guardadoAutomatico.Release();
        }

        EsError = true;
        MensajeAlerta = ErrorGuardadoAutomatico;
        return false;
    }

    private const string ErrorGuardadoAutomatico =
        "No se guardaron los cambios de la ficha SOAP. Revisa los valores ingresados e inténtalo nuevamente.";

    private async Task AntesDeNavegarAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext contexto)
    {
        if (Guardando || !await GuardarCambiosSoapAsync())
        {
            contexto.PreventNavigation();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GuardarFichaCompletaAsync()
    {
        if (!FichaEditable || Guardando)
            return;

        if (!await AdmisionService.PuedeConsultarOrdenAsync(IdOrden, Nhcl))
        {
            EsError = true;
            MensajeAlerta = "No tienes acceso a esta orden en las sucursales asignadas.";
            return;
        }

        if (Ficha.MedOrden <= 0) Ficha.MedOrden = IdOrden;
        if (Ficha.MedNhcl <= 0) Ficha.MedNhcl = Nhcl;
        if (Ficha.MedCliente <= 0 && Paciente != null) Ficha.MedCliente = Paciente.ClienteCodigo;
        if (string.IsNullOrEmpty(Ficha.MedEspecie) && Paciente != null) Ficha.MedEspecie = Paciente.Especie;
        var faltantes = new List<string>();
        if (string.IsNullOrWhiteSpace(Ficha.MedMotivo))
            faltantes.Add("Motivo principal de consulta");
        if (Diagnosticos.Count == 0)
            faltantes.Add("al menos un diagnóstico CIE-10 (pestaña 3. Diagnósticos & Receta)");
        if (string.IsNullOrWhiteSpace(Ficha.MedTipoConsulta))
            faltantes.Add("Tipo de consulta");

        if (!_ordenActualCerrada && faltantes.Count > 0)
        {
            EsError = true;
            MensajeAlerta = $"No se puede guardar la ficha SOAP. Complete los campos obligatorios: {string.Join(", ", faltantes)}.";
            return;
        }

        if (Ficha.Peso < 0 || Ficha.Temperatura < 0 || Ficha.FrecuenciaCardiaca < 0 ||
            Ficha.FrecuenciaRespiratoria < 0 || Ficha.TiempoLlenadoCapilar < 0 || Ficha.Deshidratacion < 0)
        {
            EsError = true;
            MensajeAlerta = "Los valores de constantes fisiológicas no pueden ser menores a 0.";
            return;
        }

        // Asegurar valores normalizados >= 0
        Ficha.Peso = Math.Max(0, Ficha.Peso);
        Ficha.Temperatura = Math.Max(0, Ficha.Temperatura);
        Ficha.FrecuenciaCardiaca = Math.Max(0, Ficha.FrecuenciaCardiaca);
        Ficha.FrecuenciaRespiratoria = Math.Max(0, Ficha.FrecuenciaRespiratoria);
        Ficha.TiempoLlenadoCapilar = Math.Max(0, Ficha.TiempoLlenadoCapilar);
        Ficha.Deshidratacion = Math.Clamp(Ficha.Deshidratacion, 0, 100);

        if (!_ordenActualCerrada && Ficha.MedFechaControl.HasValue && Ficha.MedFechaControl.Value.Date < DateTime.Today)
        {
            EsError = true;
            MensajeAlerta = "La fecha de próximo control sugerido no puede ser anterior al día de hoy.";
            return;
        }

        Guardando = true;
        if (!await GuardarCambiosSoapAsync())
        {
            Guardando = false;
            return;
        }

        int idUser = Session.IdUser;
        int ordenCerrada = Ficha.MedOrden;
        bool ok = await ConsultaService.GuardarFichaMedicaAsync(Ficha, idUser);
        if (ok)
        {
            KardexService.InvalidarCacheOrdenesActivas();
            if (Session.OrdenActiva == ordenCerrada)
                Session.LimpiarOrdenActiva();
            _ordenesActivas.RemoveAll(o => o.IdOrdenAtencion == ordenCerrada);

            if (_colaOrdenes is not null)
            {
                await _colaOrdenes.RefrescarAsync();
            }

            _estadoOrden = "T";
            _finConsultaUtc = DateTime.UtcNow;
            _ordenActualCerrada = true;
            var ordenGuardada = _historialOrdenes.FirstOrDefault(orden => orden.IdOrden == ordenCerrada);
            if (ordenGuardada != null)
                ordenGuardada.Estado = "T";
        }
        Guardando = false;

        EsError = !ok;
        MensajeAlerta = ok
            ? $"Historia Clínica SOAP de la Orden #{ordenCerrada} guardada y cerrada exitosamente."
            : "Ocurrió un error al guardar la Ficha Médica.";
    }

