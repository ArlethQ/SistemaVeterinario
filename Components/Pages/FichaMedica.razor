    private async Task AgregarMedicamentoAsync()
    {
        if (!FichaEditable || Guardando) return;

        try
        {
            int ordenTarget = Ficha.MedOrden > 0 ? Ficha.MedOrden : IdOrden;
            int nhclTarget = Ficha.MedNhcl > 0 ? Ficha.MedNhcl : Nhcl;

            if (ordenTarget <= 0 || nhclTarget <= 0)
            {
                EsError = true;
                MensajeAlerta = "No hay una orden activa válida para agregar medicamentos.";
                return;
            }
            if (NuevoMedicamento.Cantidad <= 0)
            {
                EsError = true;
                MensajeAlerta = "La cantidad del medicamento debe ser mayor a cero.";
                return;
            }
            if (string.IsNullOrWhiteSpace(NuevoMedicamento.Descripcionamento) || string.IsNullOrWhiteSpace(NuevoMedicamento.Indicaciones))
            {
                EsError = true;
                MensajeAlerta = "Ingrese el medicamento y sus indicaciones posológicas.";
                return;
            }

            if (string.IsNullOrWhiteSpace(NuevoMedicamento.CodigoProd))
            {
                var exacto = _catalogoMedicamentos.FirstOrDefault(p =>
                    string.Equals(p.Descripcion.Trim(), NuevoMedicamento.Descripcionamento.Trim(), StringComparison.OrdinalIgnoreCase));
                if (exacto != null)
                {
                    NuevoMedicamento.CodigoProd = exacto.Id.ToString();
                }
            }

            NuevoMedicamento.IdOrden = ordenTarget;
            NuevoMedicamento.Nhcl = nhclTarget;
            int idUser = Session.CurrentUser?.UserNumero ?? 1;
            var ok = await ConsultaService.AgregarMedicamentoRecetaAsync(NuevoMedicamento, idUser, Session.Localidad);
            if (!ok)
            {
                EsError = true;
                MensajeAlerta = "No se pudo guardar el medicamento en la receta.";
                return;
            }

            NuevoMedicamento = new RecetaMedicamentoItemDto();
            _mostrarSugerenciasMed = false;
            RecetaItems = await ConsultaService.ObtenerRecetaOrdenAsync(ordenTarget);
            EsError = false;
            MensajeAlerta = "Medicamento agregado a la receta.";
        }
        catch (Exception ex)
        {
            EsError = true;
            MensajeAlerta = $"Error al agregar medicamento: {ex.Message}";
        }
    }

