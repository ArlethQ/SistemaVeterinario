                        </div>
                    </div>
                </div>
            </div>

            <!-- Carnet de Vacunación y Desparasitación -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary">
                        <i class="bi bi-eyedropper me-1"></i>Carnet de Vacunación e Inmunización
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Tipo</label>
                                <select class="form-select form-select-sm" @bind="NuevaVacuna.Tipo">
                                    <option value="Vacunación">Vacunación</option>
                                    <option value="Desparasitación">Desparasitación</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Biológico / Producto</label>
                                <select class="form-select form-select-sm" @bind="NuevaVacuna.IdProducto">
                                    <option value="0">Seleccione</option>
                                    @foreach (var producto in CatalogoVacunas)
                                    {
                                        <option value="@producto.Id">@producto.Descripcion</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Próx. Refuerzo</label>
                                <input type="date" class="form-control form-control-sm"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       value="@(NuevaVacuna.FechaRevacunacion?.ToString("yyyy-MM-dd"))"
                                       @onchange="OnFechaRevacunacionChanged" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-sm btn-success w-100" @onclick="AgregarVacunaAsync">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>
                        <input type="text" class="form-control form-control-sm mb-3" maxlength="500" @bind="NuevaVacuna.ObservacionVacuna" placeholder="Observaciones, lote o reacción (opcional)" />

                        <div class="table-responsive">
                            <table class="table table-sm table-hover small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Aplicación</th>
                                        <th>Tipo</th>
                                        <th>Vacuna / Producto</th>
                                        <th>Revacunación</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in Vacunas)
                                    {
                                        <tr>
                                            <td>@v.Fecha.ToString("yyyy-MM-dd")</td>
                                            <td><span class="badge bg-info text-dark">@v.Tipo</span></td>
                                            <td><strong>@(string.IsNullOrWhiteSpace(v.NombreVacuna) ? "Sin producto asociado" : v.NombreVacuna)</strong>@if (!string.IsNullOrWhiteSpace(v.ObservacionVacuna)){<small class="d-block text-muted">@v.ObservacionVacuna</small>}</td>
                                            <td>@(v.FechaRevacunacion?.ToString("yyyy-MM-dd") ?? "-")</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => EliminarVacunaAsync(v.VacunaId)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int IdOrden { get; set; }
