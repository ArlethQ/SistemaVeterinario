    private AntecedenteClinicoDto NuevoAntecedente { get; set; } = new();
    private VacunaPacienteDto NuevaVacuna { get; set; } = new();

    // Prescripción médica inline (Tab 3)
    private List<CatalogoOperativoDto> _catalogoMedicamentos = new();
    private List<CatalogoOperativoDto> _sugerenciasMedicamento = new();
    private bool _mostrarSugerenciasMed;
    private RecetaMedicamentoItemDto NuevoMedicamento { get; set; } = new();

    // Órdenes de Servicio (Laboratorio, Imagenología, Fisioterapia desde PRODUCTO)
    private sealed record ServicioCatalogoItem(string Codigo, string Descripcion, decimal Precio);

    private string _categoriaServicio = "Laboratorio";
    private readonly Dictionary<string, List<ServicioCatalogoItem>> _cacheServiciosPorCategoria = new();
    private List<ServicioCatalogoItem> _serviciosFiltrados = new();
    private string _filtroServicio = string.Empty;
    private string _codigoServicioSeleccionado = string.Empty;
    private bool _mostrarSugerenciasServicio;
    private decimal _cantidadServicio = 1;
    private string _prioridadServicio = "Rutina";
    private string _observacionServicio = string.Empty;

    private List<OrdenLaboratorioItemDto> OrdenesLab { get; set; } = new();
    private List<OrdenImagenItemDto> OrdenesImagen { get; set; } = new();
    private List<FisioterapiaOrdenDto> OrdenesFisio { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        CargandoInicial = true;
        await Task.Yield();

        if (_ordenesActivas.Count == 0)
        {
            _ordenesActivas = await KardexService.ObtenerOrdenesActivasAsync(top: 50);
            if (Session.TipoUser == 2)
            {
                _ordenesActivas = _ordenesActivas.Where(o => o.IdMedico == Session.IdUser).ToList();
            }
        }

        if (IdOrden <= 0 && Nhcl > 0)
        {
            var ordenPaciente = _ordenesActivas.FirstOrDefault(o => o.Nhcl == Nhcl);
            if (ordenPaciente != null)
            {
                IdOrden = ordenPaciente.IdOrdenAtencion;
            }
        }
        else if (IdOrden <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
        {
            IdOrden = Session.OrdenActiva.Value;
            Nhcl = Session.NhclActivo ?? 0;
        }
        else if (IdOrden <= 0)
        {
            if (_ordenesActivas.Count > 0)
            {
                IdOrden = _ordenesActivas[0].IdOrdenAtencion;
                Nhcl = _ordenesActivas[0].Nhcl;
            }
        }

        if (IdOrden > 0 || Nhcl > 0)
        {
            IdOrdenInput = IdOrden;
            NhclInput = Nhcl;
            await CargarDatosCompletosAsync();

            if (Paciente != null && !_ordenesActivas.Any(o => o.IdOrdenAtencion == IdOrden))
            {
                _ordenesActivas.Insert(0, new OrdenActivaResumenDto
                {
                    OrdenAtencionId = IdOrden,
                    Nhcl = Nhcl,
                    Paciente = Paciente.PacienteNombre,
                    Cliente = Paciente.PropietarioNombre,
                    Especie = Paciente.Especie,
                    Sexo = Paciente.Sexo
                });
            }
        }
        CargandoInicial = false;
    }

    private async Task CargarPorInputAsync()
    {
        if (IdOrdenInput <= 0 && NhclInput > 0)
        {
            var ordenPaciente = _ordenesActivas.FirstOrDefault(o => o.Nhcl == NhclInput);
            if (ordenPaciente != null)
            {
                IdOrdenInput = ordenPaciente.IdOrdenAtencion;
            }
        }

        if (IdOrdenInput > 0 || NhclInput > 0)
        {
            IdOrden = IdOrdenInput;
            Nhcl = NhclInput;
            CargandoInicial = true;
            await Task.Yield();
            await CargarDatosCompletosAsync();

            if (Paciente != null && !_ordenesActivas.Any(o => o.IdOrdenAtencion == IdOrden))
            {
                _ordenesActivas.Insert(0, new OrdenActivaResumenDto
                {
                    OrdenAtencionId = IdOrden,
                    Nhcl = Nhcl,
                    Paciente = Paciente.PacienteNombre,
                    Cliente = Paciente.PropietarioNombre,
                    Especie = Paciente.Especie,
                    Sexo = Paciente.Sexo
                });
            }

            CargandoInicial = false;
            Nav.NavigateTo($"/consulta/fichamedica/{IdOrden}/{Nhcl}", replace: true);
        }
    }

    private async Task OnOrdenSelectChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var ordenId) && ordenId > 0)
        {
            var ord = _ordenesActivas.FirstOrDefault(o => o.IdOrdenAtencion == ordenId);
            IdOrden = ordenId;
            IdOrdenInput = ordenId;
            Nhcl = ord?.Nhcl ?? 0;
            NhclInput = Nhcl;

            CargandoInicial = true;
            await Task.Yield();
            await CargarDatosCompletosAsync();
            CargandoInicial = false;
            Nav.NavigateTo($"/consulta/fichamedica/{IdOrden}/{Nhcl}", replace: true);
        }
    }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CargarPorInputAsync();
        }
    }

    private void SeleccionarTab(int tab)
    {
        TabActiva = tab;
        MensajeAlerta = null;
        EsError = false;
    }

    private async Task CargarDatosCompletosAsync()
    {
        MensajeAlerta = null;
        EsError = false;
        _historialOrdenes = [];
        _errorHistorialOrdenes = false;
        Paciente = await KardexService.ObtenerEncabezadoPacienteAsync(IdOrden, Nhcl);
        if (Paciente != null && Nhcl <= 0)
        {
            Nhcl = Paciente.Nhcl;
            NhclInput = Nhcl;
        }
        if (Paciente is not null)
        {
            try
            {
                _historialOrdenes = await AdmisionService.ObtenerOrdenesPacienteAsync(Paciente.Nhcl);
                if (IdOrden <= 0 && _historialOrdenes.FirstOrDefault(o => o.Estado.Trim() != "I") is { } ultimaOrden)
                {
                    IdOrden = IdOrdenInput = ultimaOrden.IdOrden;
                    Paciente = await KardexService.ObtenerEncabezadoPacienteAsync(IdOrden, Nhcl);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error al cargar el historial de órdenes de la mascota {Nhcl}", Nhcl);
                _errorHistorialOrdenes = true;
            }
        }
        Session.SeleccionarOrden(IdOrden, Nhcl, Paciente?.PacienteNombre);

        var tFicha = ConsultaService.ObtenerFichaMedicaAsync(IdOrden, Nhcl);
        var tDiag = ConsultaService.ObtenerDiagnosticosOrdenAsync(IdOrden);
        var tRec = ConsultaService.ObtenerRecetaOrdenAsync(IdOrden);
        var tAnt = ConsultaService.ObtenerAntecedentesPacienteAsync(Nhcl);
        var tVac = ConsultaService.ObtenerVacunasPacienteAsync(Nhcl);
        var tCatalogoVac = ConsultaService.ObtenerCatalogoVacunasAsync();
        var tTiposConsulta = ConsultaService.ObtenerTiposConsultaCatalogoAsync(Session.Localidad);
        var tLab = LabImagenService.ObtenerOrdenesLaboratorioAsync(IdOrden, Nhcl);
        var tImg = LabImagenService.ObtenerOrdenesImagenAsync(IdOrden, Nhcl);
        var tFisio = AdminClinicaService.ObtenerFisioterapiaAsync(IdOrden, Nhcl);
        await Task.WhenAll(tFicha, tDiag, tRec, tAnt, tVac, tCatalogoVac, tTiposConsulta, tLab, tImg, tFisio);

        Ficha = await tFicha;
        if (Ficha.MedOrden <= 0) Ficha.MedOrden = IdOrden;
        if (Ficha.MedNhcl <= 0) Ficha.MedNhcl = Nhcl;
        if (Ficha.MedCliente <= 0 && Paciente != null) Ficha.MedCliente = Paciente.ClienteCodigo;
        if (string.IsNullOrEmpty(Ficha.MedEspecie) && Paciente != null) Ficha.MedEspecie = Paciente.Especie;
        Diagnosticos = await tDiag;
        RecetaItems = await tRec;
        Antecedentes = await tAnt;
        Vacunas = await tVac;
        CatalogoVacunas = await tCatalogoVac;
        TiposConsultaCatalogo = await tTiposConsulta;
        OrdenesLab = await tLab;
        OrdenesImagen = await tImg;
        OrdenesFisio = await tFisio;

        if (_catalogoMedicamentos.Count == 0)
        {
            try
            {
                var prods = await EFactCatalog.ObtenerProductosAsync();
                _catalogoMedicamentos = prods.Where(p => p.Estado == "A" && !p.EsServicio).ToList();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "No se pudo cargar el catálogo de medicamentos para prescripción inline.");
            }
        }

        await CargarCatalogoServicioCategoriaAsync(_categoriaServicio);
    }

    private void OnFechaControlChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            if (dt.Date < DateTime.Today)
            {
                EsError = true;
                MensajeAlerta = "La fecha de próximo control sugerido no puede ser anterior al día de hoy.";
                Ficha.MedFechaControl = DateTime.Today;
            }
            else
            {
                Ficha.MedFechaControl = dt.Date;
                MensajeAlerta = null;
            }
        }
        else
        {
            Ficha.MedFechaControl = null;
        }
    }

    private void OnFechaRevacunacionChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            if (dt.Date < DateTime.Today)
            {
                EsError = true;
                MensajeAlerta = "La fecha de próximo refuerzo no puede ser anterior al día de hoy.";
                NuevaVacuna.FechaRevacunacion = DateTime.Today;
            }
            else
            {
                NuevaVacuna.FechaRevacunacion = dt.Date;
                MensajeAlerta = null;
            }
        }
        else
        {
            NuevaVacuna.FechaRevacunacion = null;
        }
    }

    private void SeleccionarTemperamento(string temperamento, string rutaImagen)
    {
        Ficha.Temperamento = temperamento;
        Ficha.ColorTriaje = rutaImagen;
    }

    private static string ObtenerTextoTemperamento(string? temperamento) => temperamento?.Trim().ToUpperInvariant() switch
    {
        "NERVIOSO" => "Tímido",
        "A LA DEFENSIVA" => "Defensivo",
        "AGRESIVO" => "Agresivo",
        _ => "Sociable"
    };

    private string ObtenerClaseBadgeTemperamento(string temp) => temp?.ToUpper() switch
    {
        "NERVIOSO" => "bg-success",
        "A LA DEFENSIVA" => "bg-warning text-dark",
        "AGRESIVO" => "bg-danger",
        _ => "bg-secondary"
    };

    private async Task GuardarFichaCompletaAsync()
    {
        if (Ficha.MedOrden <= 0) Ficha.MedOrden = IdOrden;
        if (Ficha.MedNhcl <= 0) Ficha.MedNhcl = Nhcl;
        if (Ficha.MedCliente <= 0 && Paciente != null) Ficha.MedCliente = Paciente.ClienteCodigo;
        if (string.IsNullOrEmpty(Ficha.MedEspecie) && Paciente != null) Ficha.MedEspecie = Paciente.Especie;
        var faltantes = new List<string>();
        if (string.IsNullOrWhiteSpace(Ficha.MedMotivo))
            faltantes.Add("Motivo principal de consulta");
        if (Diagnosticos.Count == 0)
            faltantes.Add("al menos un diagnóstico CIE-10 (pestaña 3. Diagnósticos & Receta)");
        if (string.IsNullOrWhiteSpace(Ficha.MedTipoConsulta))
            faltantes.Add("Tipo de consulta");

        if (faltantes.Count > 0)
        {
            EsError = true;
            MensajeAlerta = $"No se puede guardar la ficha SOAP. Complete los campos obligatorios: {string.Join(", ", faltantes)}.";
            return;
        }

        if (Ficha.Peso < 0 || Ficha.Temperatura < 0 || Ficha.FrecuenciaCardiaca < 0 ||
            Ficha.FrecuenciaRespiratoria < 0 || Ficha.TiempoLlenadoCapilar < 0 || Ficha.Deshidratacion < 0)
        {
            EsError = true;
            MensajeAlerta = "Los valores de constantes fisiológicas no pueden ser menores a 0.";
            return;
        }

        // Asegurar valores normalizados >= 0
        Ficha.Peso = Math.Max(0, Ficha.Peso);
        Ficha.Temperatura = Math.Max(0, Ficha.Temperatura);
        Ficha.FrecuenciaCardiaca = Math.Max(0, Ficha.FrecuenciaCardiaca);
        Ficha.FrecuenciaRespiratoria = Math.Max(0, Ficha.FrecuenciaRespiratoria);
        Ficha.TiempoLlenadoCapilar = Math.Max(0, Ficha.TiempoLlenadoCapilar);
        Ficha.Deshidratacion = Math.Clamp(Ficha.Deshidratacion, 0, 100);

        if (Ficha.MedFechaControl.HasValue && Ficha.MedFechaControl.Value.Date < DateTime.Today)
        {
            EsError = true;
            MensajeAlerta = "La fecha de próximo control sugerido no puede ser anterior al día de hoy.";
            return;
        }

        Guardando = true;
        int idUser = Session.CurrentUser?.UserNumero ?? 1;
        bool ok = await ConsultaService.GuardarFichaMedicaAsync(Ficha, idUser);
        Guardando = false;

        EsError = !ok;
        MensajeAlerta = ok
            ? $"Historia Clínica SOAP de la Orden #{Ficha.MedOrden} guardada exitosamente."
            : "Ocurrió un error al guardar la Ficha Médica.";
    }

    private async Task BuscarCie10AutoAsync()
    {
        if (string.IsNullOrWhiteSpace(FiltroCie10))
        {
            ResultadosCie10.Clear();
            return;
        }
        await BuscarCie10Async();
    }

    private async Task BuscarCie10Async()
    {
        ResultadosCie10 = await ConsultaService.BuscarCatalogoCie10Async(FiltroCie10);
    }

    private void SeleccionarCie10(CatalogoCie10ItemDto item)
    {
        NuevoDiagnostico.CodigoDiag = item.CieCodigo.ToString();
        NuevoDiagnostico.DescripcionObservacion = item.CieDiagnostico;
        ResultadosCie10.Clear();
    }

    private async Task AgregarDiagnosticoAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(NuevoDiagnostico.CodigoDiag))
            {
                EsError = true;
                MensajeAlerta = "Por favor seleccione o ingrese un código de diagnóstico CIE-10.";
                return;
            }

            int ordenTarget = Ficha.MedOrden > 0 ? Ficha.MedOrden : IdOrden;
            int nhclTarget = Ficha.MedNhcl > 0 ? Ficha.MedNhcl : Nhcl;

            if (ordenTarget <= 0)
            {
                EsError = true;
                MensajeAlerta = "No hay una orden activa seleccionada para vincular el diagnóstico.";
                return;
            }

            NuevoDiagnostico.IdOrden = ordenTarget;
            NuevoDiagnostico.Nhcl = nhclTarget;
            await ConsultaService.AgregarDiagnosticoOrdenAsync(NuevoDiagnostico);
            NuevoDiagnostico = new DiagnosticoCie10Dto { TipoDiag = "Definitivo" };
            Diagnosticos = await ConsultaService.ObtenerDiagnosticosOrdenAsync(ordenTarget);
            EsError = false;
            MensajeAlerta = null;
        }
        catch (Exception ex)
        {
            EsError = true;
            MensajeAlerta = $"Error al registrar diagnóstico: {ex.Message}";
        }
    }

    private async Task EliminarDiagnosticoAsync(int sec)
    {
        try
        {
            int ordenTarget = Ficha.MedOrden > 0 ? Ficha.MedOrden : IdOrden;
            await ConsultaService.EliminarDiagnosticoOrdenAsync(sec);
            Diagnosticos = await ConsultaService.ObtenerDiagnosticosOrdenAsync(ordenTarget);
            EsError = false;
            MensajeAlerta = null;
        }
        catch (Exception ex)
        {
            EsError = true;
            MensajeAlerta = $"Error al eliminar diagnóstico: {ex.Message}";
        }
    }

    private async Task AgregarAntecedenteAsync()
    {
        if (string.IsNullOrWhiteSpace(NuevoAntecedente.Descripcion)) return;
        int nhclTarget = Ficha.MedNhcl > 0 ? Ficha.MedNhcl : Nhcl;
        int ordenTarget = Ficha.MedOrden > 0 ? Ficha.MedOrden : IdOrden;
        int clienteTarget = Ficha.MedCliente > 0 ? Ficha.MedCliente : (Paciente?.ClienteCodigo ?? 0);

        NuevoAntecedente.Nhcl = nhclTarget;
        NuevoAntecedente.Orden = ordenTarget;
        int idUser = Session.CurrentUser?.UserNumero ?? 1;
        await ConsultaService.AgregarAntecedenteAsync(NuevoAntecedente, idUser, clienteTarget);
        NuevoAntecedente = new AntecedenteClinicoDto();
        Antecedentes = await ConsultaService.ObtenerAntecedentesPacienteAsync(nhclTarget);
        EsError = false;
        MensajeAlerta = null;
    }

    private async Task AgregarVacunaAsync()
    {
        if (NuevaVacuna.IdProducto <= 0)
        {
            EsError = true;
            MensajeAlerta = "Seleccione la vacuna o producto aplicado.";
            return;
        }

        if (NuevaVacuna.FechaRevacunacion.HasValue && NuevaVacuna.FechaRevacunacion.Value.Date < DateTime.Today)
        {
            EsError = true;
            MensajeAlerta = "La fecha de próximo refuerzo no puede ser anterior al día de hoy.";
            return;
        }

        int nhclTarget = Ficha.MedNhcl > 0 ? Ficha.MedNhcl : Nhcl;
        int ordenTarget = Ficha.MedOrden > 0 ? Ficha.MedOrden : IdOrden;
        int clienteTarget = Ficha.MedCliente > 0 ? Ficha.MedCliente : (Paciente?.ClienteCodigo ?? 0);

