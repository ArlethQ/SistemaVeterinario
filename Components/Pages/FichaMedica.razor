@page "/consulta/fichamedica"
@page "/consulta/fichamedica/{IdOrden:int}/{Nhcl:int}"
@page "/consulta/fichamedica/paciente/{Nhcl:int}"
@inject IConsultaExternaService ConsultaService
@inject IKardexService KardexService
@inject IAdmisionFacturacionService AdmisionService
@inject ILaboratorioImagenService LabImagenService
@inject IAdministracionClinicaService AdminClinicaService
@inject IEFactCatalogService EFactCatalog
@inject ILogger<FichaMedica> Logger
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>e-ForVets - Historia Clínica SOAP y Ficha Médica</PageTitle>

<div class="container-fluid py-3">
    <!-- Encabezado y Acciones -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-3 rounded shadow-sm border-start border-4 border-primary">
        <div>
            <h4 class="mb-0 text-primary fw-bold">
                <i class="bi bi-clipboard2-pulse-fill me-2"></i>Historia Clínica Electrónica & Evaluación SOAP
            </h4>
            <small class="text-muted">Examen físico general, metodología clínica orientada a problemas (SOAP), diagnósticos CIE-10, antecedentes y vacunación.</small>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center mt-2 mt-xl-0">
            <!-- Selector Dropbox de Órdenes -->
            <div class="d-flex align-items-center gap-1">
                <label class="small fw-bold text-secondary text-nowrap mb-0">Órdenes:</label>
                <select class="form-select form-select-sm" style="min-width: 280px; max-width: 360px;"
                        value="@IdOrden" @onchange="OnOrdenSelectChangedAsync">
                    <option value="0">-- Seleccionar Orden --</option>
                    @foreach (var ord in OrdenesVisibles)
                    {
                        <option value="@ord.IdOrdenAtencion">#@ord.IdOrdenAtencion | @ord.Paciente | Dr(a). @ord.Medico</option>
                    }
                </select>
            </div>

            <!-- Búsqueda Manual por Orden / NHCL con autocomplete -->
            <BuscadorOrdenClinica @bind-Orden="IdOrdenInput" @bind-Nhcl="NhclInput" OnBuscar="CargarPorInputAsync" />
            <button class="btn btn-sm btn-success" @onclick="GuardarFichaCompletaAsync" disabled="@Guardando">
                <i class="bi bi-floppy-fill me-1"></i>@(Guardando ? "Guardando..." : "Guardar Ficha SOAP")
            </button>
<button class="btn btn-sm btn-outline-danger" @onclick="ExportarPdfAsync">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>PDF Historia
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => Nav.NavigateTo($"/consulta/imprimir-fichas/{Ficha.MedNhcl}")'>
                <i class="bi bi-collection-fill me-1"></i>Lotes / Seguros
            </button>
            <button class="btn btn-sm btn-outline-primary" @onclick='() => Nav.NavigateTo($"/consulta/recetario/{Ficha.MedOrden}/{Ficha.MedNhcl}")'>
                <i class="bi bi-prescription2 me-1"></i>Ir a Recetario
            </button>
        </div>
    </div>

    <ColaOrdenesClinicas OrdenSeleccionada="@IdOrden" />

    @if (!string.IsNullOrEmpty(MensajeAlerta))
    {
        <div class="alert @(EsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2" role="alert">
            <i class="bi @(EsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@MensajeAlerta
            <button type="button" class="btn-close py-2" @onclick="() => MensajeAlerta = null"></button>
        </div>
    }

    @if (CargandoInicial)
    {
        <div class="d-flex align-items-center gap-2 text-primary py-3 px-2">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="fw-semibold small">Cargando historia clínica SOAP y antecedentes...</span>
        </div>
    }

    @if (Paciente != null && !CargandoInicial)
    {
        <details class="card shadow-sm border-0 mb-3 p-3" open>
            <summary class="fw-semibold text-primary">Historial de órdenes de @Paciente.PacienteNombre</summary>
            @if (_errorHistorialOrdenes)
            {
                <p class="text-danger mt-2 mb-0">No se pudo cargar el historial de órdenes.</p>
            }
            else if (_historialOrdenes.Count == 0)
            {
                <p class="text-muted mt-2 mb-0">Esta mascota aún no tiene órdenes.</p>
            }
            else
            {
                <div class="table-responsive mt-2">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Orden</th><th>Fecha</th><th>Especialidad</th><th>Médico</th><th>Ficha SOAP</th></tr></thead>
                        <tbody>
                            @foreach (var orden in _historialOrdenes)
                            {
                                <tr @key="orden.IdOrden" class="@(orden.IdOrden == IdOrden ? "table-active" : null)">
                                    <td>#@orden.IdOrden</td>
                                    <td>@orden.Fecha.ToString("dd/MM/yyyy") @orden.Hora</td>
                                    <td>@orden.Especialidad</td>
                                    <td>@orden.Medico</td>
                                    <td>
                                        @if (orden.Estado.Trim() == "I")
                                        {
                                            <span class="text-muted">Anulada</span>
                                        }
                                        else if (orden.IdOrden == IdOrden)
                                        {
                                            <span class="text-muted">Abierta</span>
                                        }
                                        else
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="/consulta/fichamedica/@orden.IdOrden/@Paciente.Nhcl">Abrir</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </details>
    }

    <!-- Cinta de Identificación del Paciente y Semáforo de Temperamento -->
    @if (Paciente != null)
    {
        <div class="card shadow-sm border-0 mb-3 bg-primary bg-opacity-10">
            <div class="card-body py-2 px-3">
                <div class="row align-items-center g-2 small">
                    <div class="col-md-3">
                        <span class="text-muted d-block">PACIENTE / NHCL</span>
                        <strong class="fs-6 text-primary">@Paciente.PacienteNombre</strong>
                        <span class="badge bg-dark ms-1">NHCL #@Paciente.Nhcl</span>
                        <span class="badge bg-secondary ms-1">Orden #@Ficha.MedOrden</span>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted d-block">ESPECIE / RAZA / SEXO / EDAD</span>
                        <strong>@Paciente.Especie — @Paciente.Raza (@Paciente.Sexo) | @Paciente.EdadTexto</strong>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted d-block">PROPIETARIO / CONTACTO</span>
                        <strong>@Paciente.PropietarioNombre (@Paciente.ClienteCedula)</strong>
                    </div>
                    <div class="col-md-3 text-md-end">
                        <span class="text-muted d-block">TRIAJE TEMPERAMENTO / ESTERILIZADO</span>
                        <span class="badge @ObtenerClaseBadgeTemperamento(Ficha.Temperamento) fs-6">
                            <i class="bi bi-shield-fill-exclamation me-1"></i>@ObtenerTextoTemperamento(Ficha.Temperamento)
                        </span>
                        <span class="badge @(Ficha.Esterilizado == "S" ? "bg-info text-dark" : "bg-light text-dark border") ms-1">
                            @(Ficha.Esterilizado == "S" ? "Esterilizado: SÍ" : "Esterilizado: NO")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Navegación por Pestañas Clínicas -->
    <ul class="nav nav-tabs mb-3 fw-semibold">
        <li class="nav-item">
            <button class="nav-link @(TabActiva == 1 ? "active text-primary border-bottom-0" : "text-secondary")" @onclick="() => SeleccionarTab(1)">
                <i class="bi bi-heart-pulse me-1"></i>1. Examen Físico, Constantes y Temperamento
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(TabActiva == 2 ? "active text-primary border-bottom-0" : "text-secondary")" @onclick="() => SeleccionarTab(2)">
                <i class="bi bi-journal-medical me-1"></i>2. Evaluación Clínica SOAP & Plan
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(TabActiva == 3 ? "active text-primary border-bottom-0" : "text-secondary")" @onclick="() => SeleccionarTab(3)">
                <i class="bi bi-tags-fill me-1"></i>3. Diagnósticos CIE-10 (@Diagnosticos.Count) y Prescripción (@RecetaItems.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(TabActiva == 4 ? "active text-primary border-bottom-0" : "text-secondary")" @onclick="() => SeleccionarTab(4)">
                <i class="bi bi-shield-plus me-1"></i>4. Antecedentes (@Antecedentes.Count) y Carnet Vacunas (@Vacunas.Count)
            </button>
        </li>
    </ul>

    <!-- TAB 1: EXAMEN FÍSICO, CONSTANTES FISIOLÓGICAS Y TRIAJE -->
    @if (TabActiva == 1)
    {
        <div class="row g-3">
            <!-- Panel Izquierdo: Constantes Vitales y Semáforo de Temperamento -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary">
                        <i class="bi bi-thermometer-half me-1"></i>Constantes Fisiológicas y Triaje de Temperamento
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Esterilizado</label>
                                <select class="form-select form-select-sm" @bind="Ficha.Esterilizado">
                                    <option value="S">SÍ</option>
                                    <option value="N">NO</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Sede / Tipo</label>
                                <select class="form-select form-select-sm" @bind="Ficha.MedTipo">
                                    <option value="HDEV">Doméstico (Mascotas)</option>
                                    <option value="TUERI">Silvestre (Fauna)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Selector Visual de Temperamento (Semáforo Legacy: blanco, verde, amarillo, rojo) -->
                        <label class="form-label small fw-semibold d-block">Semáforo de Temperamento del Paciente</label>
                        <div class="btn-group w-100 mb-3" role="group">
                            <button type="button" class="btn btn-sm @(Ficha.Temperamento == "TRANQUILO" ? "btn-dark" : "btn-outline-secondary")"
                                    @onclick='() => SeleccionarTemperamento("TRANQUILO", "imagenes/temperamento/blanco.png")'>
                                ⚪ Sociable
                            </button>
                            <button type="button" class="btn btn-sm @(Ficha.Temperamento == "NERVIOSO" ? "btn-success" : "btn-outline-success")"
                                    @onclick='() => SeleccionarTemperamento("NERVIOSO", "imagenes/temperamento/verde.png")'>
                                🟢 Tímido
                            </button>
                            <button type="button" class="btn btn-sm @(Ficha.Temperamento == "A LA DEFENSIVA" ? "btn-warning text-dark fw-bold" : "btn-outline-warning text-dark")"
                                    @onclick='() => SeleccionarTemperamento("A LA DEFENSIVA", "imagenes/temperamento/amarillo.png")'>
                                🟡 Defensivo
                            </button>
                            <button type="button" class="btn btn-sm @(Ficha.Temperamento == "AGRESIVO" ? "btn-danger" : "btn-outline-danger")"
                                    @onclick='() => SeleccionarTemperamento("AGRESIVO", "imagenes/temperamento/rojo.png")'>
                                🔴 Agresivo
                            </button>
                        </div>

                        <div class="row g-2">
                            <div class="col-4">
                                <label class="form-label small fw-semibold">Peso (kg)</label>
                                <input type="number" step="0.01" min="0" class="form-control form-control-sm fw-bold text-primary" @bind="Ficha.Peso" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold">Temp (°C)</label>
                                <input type="number" step="0.1" min="0" class="form-control form-control-sm" @bind="Ficha.Temperatura" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold">FC (lpm)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="Ficha.FrecuenciaCardiaca" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold">FR (rpm)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="Ficha.FrecuenciaRespiratoria" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold">TLLC (seg)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="Ficha.TiempoLlenadoCapilar" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold">Deshidratación (%)</label>
                                <input type="number" min="0" max="100" class="form-control form-control-sm" @bind="Ficha.Deshidratacion" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Condición Corporal (ICC 1-9)</label>
                                <input type="range" class="form-range" min="1" max="9" @bind="Ficha.IndiceCondicionCorporal" />
                                <div class="text-center small fw-bold text-primary">ICC: @Ficha.IndiceCondicionCorporal / 9</div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Pulso / CP</label>
                                <input type="text" class="form-control form-control-sm" @bind="Ficha.Cp" placeholder="Fuerte, simétrico, concordante" />
                            </div>
                            <div class="col-12 mt-1">
                                <label class="form-label small fw-semibold">Observaciones triaje <small class="text-muted fw-normal">(opcional)</small></label>
                                <textarea class="form-control form-control-sm" rows="2" placeholder="Observaciones o notas de triaje..." @bind="Ficha.MedApuntes"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Panel Derecho: Exploración Física Regional -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary">
                        <i class="bi bi-bandaid me-1"></i>Exploración Clínica por Órganos y Sistemas
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Membranas Mucosas</label>
                                <input type="text" class="form-control form-control-sm" @bind="Ficha.Mucosas" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Reflejo Tusígeno / Traqueal</label>
                                <input type="text" class="form-control form-control-sm" @bind="Ficha.ReflejoTusigeno" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Auscultación Cardiopulmonar</label>
                                <input type="text" class="form-control form-control-sm" @bind="Ficha.Auscultacion" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Linfonodos Superficiales</label>
                                <input type="text" class="form-control form-control-sm" @bind="Ficha.Linfonodos" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Palpación Abdominal</label>
                                <input type="text" class="form-control form-control-sm" @bind="Ficha.PalpacionAbdominal" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Palpación Tiroides / Cuello</label>
                                <input type="text" class="form-control form-control-sm" @bind="Ficha.PalpacionTiroides" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Piel, Pelaje y Anexos</label>
                                <input type="text" class="form-control form-control-sm" @bind="Ficha.PielYAnexos" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Cavidad Oral y Piezas Dentales</label>
                                <input type="text" class="form-control form-control-sm" @bind="Ficha.CavidadOral" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Otros Hallazgos del Examen Físico</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="Ficha.Otros"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TAB 2: EVALUACIÓN CLÍNICA SOAP Y PLAN -->
    @if (TabActiva == 2)
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center">
                <span><i class="bi bi-file-medical-fill me-1"></i>Metodología Clínica Orientada a Problemas (SOAP)</span>
                <span class="badge bg-primary bg-opacity-10 text-primary">Pronóstico: @Ficha.MedPronostico</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-primary">Motivo Principal de Consulta *</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="Ficha.MedMotivo" placeholder="Motivo por el que acude el propietario..."></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-primary">Antecedentes Médicos Relevantes de la Consulta</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="Ficha.MedAntecedente" placeholder="Enfermedades previas, alergias, cirugías..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-indigo">S — SUBJETIVO / ANAMNESIS</label>
                        <textarea class="form-control form-control-sm" rows="4" @bind="Ficha.MedAnamnesis" placeholder="Relato cronológico de signos clínicos, apetito, consumo de agua, micción, defecación..."></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-indigo">O — OBJETIVO (Hallazgos Clínicos y Lista de Problemas)</label>
                        <textarea class="form-control form-control-sm" rows="4" @bind="Ficha.MedObjetivo" placeholder="Alteraciones detectadas en el examen físico y lista depurada de problemas..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-indigo">A — ANÁLISIS (Diagnósticos Diferenciales)</label>
                        <textarea class="form-control form-control-sm" rows="4" @bind="Ficha.MedAnalisis" placeholder="Diagnósticos diferenciales ordenados por probabilidad fisiopatológica..."></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-indigo">P — PLAN DIAGNÓSTICO (Pruebas Complementarias)</label>
                        <textarea class="form-control form-control-sm" rows="4" @bind="Ficha.MedPlan" placeholder="Exámenes de laboratorio, citología, radiografía, ecografía, interconsultas..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-success">PLAN TERAPÉUTICO / TRATAMIENTO INSTAURADO</label>
                        <textarea class="form-control form-control-sm" rows="3" @bind="Ficha.Tratamiento" placeholder="Terapia intrahospitalaria o ambulatoria..."></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-success">OBSERVACIONES, RECOMENDACIONES Y APUNTES</label>
                        <textarea class="form-control form-control-sm" rows="3" @bind="Ficha.ObservacionesYRecomendaciones" placeholder="Recomendaciones generales y signos de alarma..."></textarea>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Pronóstico Clínico</label>
                        <select class="form-select form-select-sm" @bind="Ficha.MedPronostico">
                            <option value="Bueno">Bueno / Favorable</option>
                            <option value="Reservado">Reservado</option>
                            <option value="Grave">Grave / Desfavorable</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">¿Candidato a Procedimiento Quirúrgico?</label>
                        <select class="form-select form-select-sm" @bind="Ficha.RequiereCirugia">
                            <option value="N">No requiere cirugía</option>
                            <option value="S">Sí requiere cirugía</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Estado de alerta clínica</label>
                        <select class="form-select form-select-sm" @bind="Ficha.EstadoParte" disabled="@(Ficha.RequiereCirugia != "S")">
                            <option value="PENDIENTE">Pendiente</option>
                            <option value="REALIZADO">Realizado</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Próximo Control Sugerido</label>
                        <input type="date" class="form-control form-control-sm"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               value="@(Ficha.MedFechaControl?.ToString("yyyy-MM-dd"))"
                               @onchange="OnFechaControlChanged" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Tipo de Consulta *</label>
                        <select class="form-select form-select-sm" @bind="Ficha.MedTipoConsulta">
                            <option value="">-- Seleccione tipo de consulta --</option>
                            @foreach (var tipo in TiposConsultaDisponibles)
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="chkRequiereHospitalizacion" @bind="Ficha.RequiereHospitalizacion" />
                            <label class="form-check-label small fw-semibold" for="chkRequiereHospitalizacion">
                                ¿Debe quedarse en hospitalización?
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TAB 3: DIAGNÓSTICOS CIE-10 Y PRESCRIPCIÓN RÁPIDA -->
    @if (TabActiva == 3)
    {
        <div class="row g-3">
            <!-- Diagnósticos CIE-10 -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary">
                        <i class="bi bi-journal-code me-1"></i>Codificación Diagnóstica CIE-10
                    </div>
                    <div class="card-body">
                        <div class="input-group input-group-sm mb-2">
                            <input type="text" class="form-control" autocomplete="off" placeholder="Buscar código o patología CIE-10..." @bind="FiltroCie10" @bind:event="oninput" @bind:after="BuscarCie10AutoAsync" />
                        </div>

                        @if (ResultadosCie10.Any())
                        {
                            <div class="border rounded p-2 mb-3 bg-light" style="max-height: 150px; overflow-y: auto;">
                                @foreach (var item in ResultadosCie10)
                                {
                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom small">
                                        <span><strong>[@item.CieCodigo]</strong> @item.CieDiagnostico <em class="text-muted">(@item.GrupoDescripcion)</em></span>
                                        <button class="btn btn-xs btn-primary py-0 px-2" @onclick="() => SeleccionarCie10(item)">Elegir</button>
                                    </div>
                                }
                            </div>
                        }

                        <div class="row g-2 mb-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Código</label>
                                <input type="text" class="form-control form-control-sm" @bind="NuevoDiagnostico.CodigoDiag" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Tipo</label>
                                <select class="form-select form-select-sm" @bind="NuevoDiagnostico.TipoDiag">
                                    <option value="Definitivo">Definitivo</option>
                                    <option value="Presuntivo">Presuntivo</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Detalle / Observación</label>
                                <input type="text" class="form-control form-control-sm" @bind="NuevoDiagnostico.DescripcionObservacion" />
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-sm btn-primary w-100" @onclick="AgregarDiagnosticoAsync">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Código</th>
                                        <th>Diagnóstico CIE-10</th>
                                        <th>Tipo</th>
                                        <th>Observación</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Diagnosticos.Any())
                                    {
                                        <tr><td colspan="5" class="text-center text-muted py-3">Sin diagnósticos registrados en esta orden.</td></tr>
                                    }
                                    @foreach (var d in Diagnosticos)
                                    {
                                        <tr>
                                            <td class="fw-bold">@d.CodigoDiag</td>
                                            <td>@d.NombreCie10</td>
                                            <td>
                                                <span class="badge @(d.TipoDiag == "Definitivo" ? "bg-success" : "bg-warning text-dark")">@d.TipoDiag</span>
                                            </td>
                                            <td>@d.DescripcionObservacion</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => EliminarDiagnosticoAsync(d.Sec)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sección 1: Prescripción Médica -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-capsule me-1"></i>Prescripción Médica</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success">@RecetaItems.Count ítem(s)</span>
                            <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2" @onclick="ImprimirRecetaMedicaPdfAsync"
                                    title="Imprimir Receta Médica">
                                <i class="bi bi-printer me-1"></i>Imprimir Receta
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-primary py-0" @onclick='() => Nav.NavigateTo($"/consulta/recetario/{Ficha.MedOrden}/{Ficha.MedNhcl}")'>
                                Abrir Recetario Completo
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Formulario rápido para agregar prescripción médica -->
                        <div class="row g-2 mb-3 p-2 bg-light rounded border">
                            <div class="col-md-6 position-relative">
                                <label class="form-label small fw-semibold">Medicamento / Producto *</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" autocomplete="off"
                                           @bind="NuevoMedicamento.Descripcionamento"
                                           @bind:event="oninput"
                                           @bind:after="OnMedicamentoInputChanged"
                                           @onfocus="OnMedicamentoFocus"
                                           placeholder="Escriba medicamento del catálogo..." />
                                    @if (!string.IsNullOrWhiteSpace(NuevoMedicamento.Descripcionamento))
                                    {
                                        <button type="button" class="btn btn-outline-secondary" title="Limpiar" @onclick="LimpiarSeleccionMedicamento">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    }
                                </div>
                                @if (_mostrarSugerenciasMed && _sugerenciasMedicamento.Any())
                                {
                                    <div class="list-group position-absolute w-100 shadow-sm mt-1" style="z-index: 1050; max-height: 190px; overflow-y: auto;">
                                        @foreach (var prod in _sugerenciasMedicamento)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action py-1 px-2 small d-flex justify-content-between align-items-center"
                                                    @onclick="() => SeleccionarMedicamento(prod)">
                                                <span><strong>[@prod.Id]</strong> @prod.Descripcion</span>
                                                <span class="text-muted ms-2">$@(prod.Precio?.ToString("F2") ?? "0.00")</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Cant.</label>
                                <input type="number" min="1" step="1" class="form-control form-control-sm" onkeydown="return event.key !== '-'"
                                       @bind="NuevoMedicamento.Cantidad" @bind:after="ActualizarCantidadLetras" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">En Letras</label>
                                <input type="text" class="form-control form-control-sm" @bind="NuevoMedicamento.CantidadLetras" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Tipo</label>
                                <select class="form-select form-select-sm" @bind="NuevoMedicamento.Tipo">
                                    <option value="M">Receta (M)</option>
                                    <option value="I">Insumo (I)</option>
                                </select>
                            </div>
                            <div class="col-md-9">
                                <label class="form-label small fw-semibold">Indicaciones Posológicas (Dosis, Frecuencia y Duración) *</label>
                                <input type="text" class="form-control form-control-sm" @bind="NuevoMedicamento.Indicaciones"
                                       placeholder="Ej: Administrar 1 tableta vía oral cada 12 horas por 7 días." />
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="button" class="btn btn-sm btn-success w-100" @onclick="AgregarMedicamentoAsync">
                                    <i class="bi bi-plus-circle me-1"></i>Agregar
                                </button>
                            </div>
                        </div>

                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-semibold mb-0">Indicaciones Generales de Receta</label>
                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" @onclick="GuardarIndicacionesGeneralesTab3Async">
                                    <i class="bi bi-save me-1"></i>Guardar indicaciones
                                </button>
                            </div>
                            <textarea class="form-control form-control-sm" rows="2" @bind="Ficha.IndicacionesGeneralesReceta" placeholder="Cuidados generales para imprimir en la receta..."></textarea>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Medicamento</th>
                                        <th class="text-center">Cant.</th>
                                        <th>Indicaciones Posológicas</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!RecetaItems.Any())
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-3">Sin medicamentos en la receta actual.</td></tr>
                                    }
                                    @foreach (var m in RecetaItems)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@m.Descripcionamento <span class="badge bg-light text-dark border">@m.Tipo</span></td>
                                            <td class="text-center">@m.Cantidad.ToString("N0") (@m.CantidadLetras)</td>
                                            <td>@m.Indicaciones</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0" title="Eliminar medicamento"
                                                        @onclick="() => EliminarMedicamentoAsync(m.Sec)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sección 2: Órdenes de Servicio (Laboratorio, Imagenología, Fisioterapia desde PRODUCTO) -->
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white fw-bold text-primary d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span><i class="bi bi-clipboard2-check me-1"></i>Servicios Médicos (Laboratorio, Imagenología y Fisioterapia)</span>
                        <div class="d-flex flex-wrap gap-1 small">
                            <span class="badge bg-info text-dark">Lab: @OrdenesLab.Count</span>
                            <span class="badge bg-warning text-dark">Imagen: @OrdenesImagen.Count</span>
                            <span class="badge bg-success">Fisio: @OrdenesFisio.Count</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3 p-2 bg-light rounded border align-items-end">
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Categoría de Servicio *</label>
                                <select class="form-select form-select-sm" @bind="_categoriaServicio" @bind:after="OnCategoriaServicioChangedAsync">
                                    <option value="Laboratorio">Laboratorio</option>
                                    <option value="Imagenología">Imagenología</option>
                                    <option value="Fisioterapia">Fisioterapia</option>
                                </select>
                            </div>
                            <div class="col-md-4 position-relative">
                                <label class="form-label small fw-semibold">Tipo de Servicio (Catálogo PRODUCTO) *</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" autocomplete="off"
                                           @bind="_filtroServicio"
                                           @bind:event="oninput"
                                           @bind:after="OnFiltroServicioInputChanged"
                                           @onfocus="() => _mostrarSugerenciasServicio = true"
                                           placeholder="Buscar o elegir servicio de @_categoriaServicio..." />
                                    @if (!string.IsNullOrWhiteSpace(_filtroServicio))
                                    {
                                        <button type="button" class="btn btn-outline-secondary" title="Limpiar filtro" @onclick="LimpiarSeleccionServicio">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn btn-outline-secondary" title="Mostrar lista" @onclick="ToggleSugerenciasServicio">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                </div>
                                @if (_mostrarSugerenciasServicio)
                                {
                                    <div class="list-group position-absolute w-100 shadow-sm mt-1" style="z-index: 1050; max-height: 220px; overflow-y: auto;">
                                        @if (!_serviciosFiltrados.Any())
                                        {
                                            <div class="list-group-item small text-muted py-2">No hay servicios coincidentes en @_categoriaServicio.</div>
                                        }
                                        else
                                        {
                                            @foreach (var srv in _serviciosFiltrados.Take(40))
                                            {
                                                <button type="button"
                                                        class="list-group-item list-group-item-action py-1 px-2 small d-flex justify-content-between align-items-center @(srv.Codigo == _codigoServicioSeleccionado ? "active" : "")"
                                                        @onclick="() => SeleccionarServicio(srv)">
                                                    <span><strong>[@srv.Codigo]</strong> @srv.Descripcion</span>
                                                    <span class="ms-2 @(srv.Codigo == _codigoServicioSeleccionado ? "" : "text-muted")">$@srv.Precio.ToString("N2")</span>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                            <div class="col-md-1">
                                <label class="form-label small fw-semibold">Cant.</label>
                                <input type="number" min="1" step="1" class="form-control form-control-sm" onkeydown="return event.key !== '-'" @bind="_cantidadServicio" />
                            </div>
                            @if (_categoriaServicio == "Laboratorio")
                            {
                                <div class="col-md-1">
                                    <label class="form-label small fw-semibold">Prioridad</label>
                                    <select class="form-select form-select-sm" @bind="_prioridadServicio">
                                        <option value="Rutina">Rutina</option>
                                        <option value="Emergente">Emergente</option>
                                    </select>
                                </div>
                            }
                            <div class="@(_categoriaServicio == "Laboratorio" ? "col-md-2" : "col-md-3")">
                                <label class="form-label small fw-semibold">Observaciones</label>
                                <input type="text" class="form-control form-control-sm" @bind="_observacionServicio" placeholder="Indicaciones o detalle opcional..." />
                            </div>
                            <div class="col-md-1">
                                <button type="button" class="btn btn-sm btn-primary w-100" @onclick="AgregarServicioOrdenAsync">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>

                        <!-- 3 órdenes distintas por servicio, cada una con su impresión individual -->
                        <div class="row g-3">
                            <!-- 1. Orden de Laboratorio -->
                            <div class="col-12">
                                <div class="border rounded">
                                    <div class="bg-info bg-opacity-10 px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary small">
                                            <i class="bi bi-droplet-half me-1"></i>Orden de Laboratorio
                                            <span class="badge bg-info text-dark ms-1">@OrdenesLab.Count</span>
                                        </span>
                                        <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2"
                                                @onclick="ImprimirOrdenLaboratorioPdfAsync">
                                            <i class="bi bi-printer me-1"></i>Imprimir Orden de Laboratorio
                                        </button>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle small mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Prueba / Examen</th>
                                                    <th class="text-center">Prioridad</th>
                                                    <th class="text-center">Cant.</th>
                                                    <th>Observaciones</th>
                                                    <th class="text-end">Precio</th>
                                                    <th>Estado</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (!OrdenesLab.Any())
                                                {
                                                    <tr><td colspan="7" class="text-center text-muted py-2">Sin pruebas de laboratorio en esta orden.</td></tr>
                                                }
                                                @foreach (var lab in OrdenesLab)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">[@lab.CodigoProd] @lab.DescripcionExamen</td>
                                                        <td class="text-center">
                                                            <span class="badge @(lab.Prioridad == "Emergente" ? "bg-danger" : "bg-secondary")">@lab.Prioridad</span>
                                                        </td>
                                                        <td class="text-center">@lab.Cantidad</td>
                                                        <td>@lab.Observaciones</td>
                                                        <td class="text-end">$@lab.Precio.ToString("N2")</td>
                                                        <td><span class="badge bg-light text-dark border">@lab.Estado</span></td>
                                                        <td class="text-end">
                                                            <button type="button" class="btn btn-sm btn-link text-danger p-0" title="Eliminar examen"
                                                                    @onclick='() => EliminarServicioPorCategoriaAsync("Laboratorio", lab.Sec)'>
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. Orden de Imagenología -->
                            <div class="col-12">
                                <div class="border rounded">
                                    <div class="bg-warning bg-opacity-10 px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary small">
                                            <i class="bi bi-radioactive me-1"></i>Orden de Imagenología
                                            <span class="badge bg-warning text-dark ms-1">@OrdenesImagen.Count</span>
                                        </span>
                                        <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2"
                                                @onclick="ImprimirOrdenImagenPdfAsync">
                                            <i class="bi bi-printer me-1"></i>Imprimir Orden de Imagenología
                                        </button>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle small mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Estudio de Imagenología</th>
                                                    <th class="text-center">Cant.</th>
                                                    <th>Proyecciones / Observaciones</th>
                                                    <th class="text-end">Precio</th>
                                                    <th>Estado</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (!OrdenesImagen.Any())
                                                {
                                                    <tr><td colspan="6" class="text-center text-muted py-2">Sin estudios de imagenología en esta orden.</td></tr>
                                                }
                                                @foreach (var img in OrdenesImagen)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">[@img.CodigoProd] @img.DescripcionEstudio</td>
                                                        <td class="text-center">@img.Cantidad</td>
                                                        <td>@img.Observaciones</td>
                                                        <td class="text-end">$@img.Precio.ToString("N2")</td>
                                                        <td><span class="badge bg-light text-dark border">@img.Estado</span></td>
                                                        <td class="text-end">
                                                            <button type="button" class="btn btn-sm btn-link text-danger p-0" title="Eliminar estudio"
                                                                    @onclick='() => EliminarServicioPorCategoriaAsync("Imagenología", img.Sec)'>
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- 3. Orden de Fisioterapia -->
                            <div class="col-12">
                                <div class="border rounded">
                                    <div class="bg-success bg-opacity-10 px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary small">
                                            <i class="bi bi-heart-pulse me-1"></i>Orden de Fisioterapia
                                            <span class="badge bg-success ms-1">@OrdenesFisio.Count</span>
                                        </span>
                                        <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2"
                                                @onclick="ImprimirOrdenFisioterapiaPdfAsync">
                                            <i class="bi bi-printer me-1"></i>Imprimir Orden de Fisioterapia
                                        </button>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle small mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Servicio de Fisioterapia</th>
                                                    <th class="text-center">Cant.</th>
                                                    <th>Observaciones del Tratamiento</th>
                                                    <th class="text-end">Precio</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (!OrdenesFisio.Any())
                                                {
                                                    <tr><td colspan="5" class="text-center text-muted py-2">Sin sesiones de fisioterapia en esta orden.</td></tr>
                                                }
                                                @foreach (var fisio in OrdenesFisio)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">[@fisio.IdProducto] @fisio.Descripcion</td>
                                                        <td class="text-center">@fisio.Cantidad.ToString("0.##")</td>
                                                        <td>@fisio.Observaciones</td>
                                                        <td class="text-end">$@fisio.Precio.ToString("N2")</td>
                                                        <td class="text-end">
                                                            <button type="button" class="btn btn-sm btn-link text-danger p-0" title="Eliminar sesión"
                                                                    @onclick='() => EliminarServicioPorCategoriaAsync("Fisioterapia", fisio.Sec)'>
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TAB 4: ANTECEDENTES CLÍNICOS Y CARNET DE VACUNACIÓN -->
    @if (TabActiva == 4)
    {
        <div class="row g-3">
            <!-- Antecedentes Clínicos -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold text-primary">
                        <i class="bi bi-clock-history me-1"></i>Historial de Antecedentes Clínicos
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Alimentación Habitual</label>
                                <input type="text" class="form-control form-control-sm" @bind="NuevoAntecedente.Alimentacion" placeholder="Balanceado, dieta casera..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Convivencia con Otras Mascotas</label>
                                <input type="text" class="form-control form-control-sm" @bind="NuevoAntecedente.ContactoMascotas" placeholder="Perros, gatos..." />
                            </div>
                            <div class="col-md-9">
                                <label class="form-label small fw-semibold">Descripción de Antecedente</label>
                                <input type="text" class="form-control form-control-sm" @bind="NuevoAntecedente.Descripcion" placeholder="Alergias, cirugías o patologías crónicas..." />
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button class="btn btn-sm btn-primary w-100" @onclick="AgregarAntecedenteAsync">
                                    <i class="bi bi-plus-circle me-1"></i>Agregar
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive">
