                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Biológico / Producto</label>
                                <input type="text" class="form-control form-control-sm" @bind="NuevaVacuna.ObservacionVacuna" placeholder=" Séxtuple, Rabia, Bravecto..." />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Próx. Refuerzo</label>
                                <input type="date" class="form-control form-control-sm" @bind="NuevaVacuna.FechaRevacunacion" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-sm btn-success w-100" @onclick="AgregarVacunaAsync">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-hover small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Aplicación</th>
                                        <th>Tipo</th>
                                        <th>Vacuna / Producto</th>
