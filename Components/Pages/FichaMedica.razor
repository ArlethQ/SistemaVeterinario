        await CargarCatalogoServicioCategoriaAsync(_categoriaServicio);
    }

    private async Task CargarCatalogoServicioCategoriaAsync(string categoria)
    {
        if (!_cacheServiciosPorCategoria.TryGetValue(categoria, out var lista))
        {
            try
            {
                lista = categoria switch
                {
                    "Laboratorio" => (await LabImagenService.ObtenerCatalogoLaboratorioAsync(0))
                        .Select(x => new ServicioCatalogoItem(x.CodigoProd, x.Descripcion, x.PrecioUnitario))
                        .ToList(),
                    "Imagenología" => (await LabImagenService.ObtenerCatalogoImagenologiaAsync("TODOS"))
                        .Select(x => new ServicioCatalogoItem(x.CodigoProd, x.Descripcion, x.PrecioUnitario))
                        .ToList(),
                    "Fisioterapia" => (await AdminClinicaService.ObtenerCatalogoFisioterapiaAsync())
                        .Select(x => new ServicioCatalogoItem(x.IdProducto.ToString(), x.Descripcion, x.Precio))
                        .ToList(),
                    _ => []
                };
                _cacheServiciosPorCategoria[categoria] = lista;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error al cargar el catálogo de servicios para {Categoria}", categoria);
                lista = [];
            }
        }

        _serviciosFiltrados = lista;
    }

    private void OnFiltroServicioInputChanged()
    {
        _codigoServicioSeleccionado = string.Empty;
        _mostrarSugerenciasServicio = true;
        FiltrarServiciosCategoria();
    }

    private void FiltrarServiciosCategoria()
    {
        var lista = _cacheServiciosPorCategoria.TryGetValue(_categoriaServicio, out var cache)
            ? cache
            : [];

        var texto = _filtroServicio?.Trim() ?? string.Empty;
        _serviciosFiltrados = string.IsNullOrWhiteSpace(texto)
            ? lista
            : lista.Where(s => s.Descripcion.Contains(texto, StringComparison.OrdinalIgnoreCase)
                            || s.Codigo.Contains(texto, StringComparison.OrdinalIgnoreCase))
                   .ToList();
    }

    private void ToggleSugerenciasServicio()
    {
        if (!_mostrarSugerenciasServicio)
        {
            FiltrarServiciosCategoria();
        }
        _mostrarSugerenciasServicio = !_mostrarSugerenciasServicio;
    }

    private void LimpiarSeleccionServicio()
    {
        _codigoServicioSeleccionado = string.Empty;
