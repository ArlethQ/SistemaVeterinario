    private void ActualizarSugerenciasMedicamento()
    {
        var texto = NuevoMedicamento.Descripcionamento?.Trim() ?? string.Empty;
        _sugerenciasMedicamento = string.IsNullOrWhiteSpace(texto)
            ? _catalogoMedicamentos.Take(15).ToList()
            : _catalogoMedicamentos
                .Where(p => p.Descripcion.Contains(texto, StringComparison.OrdinalIgnoreCase)
                         || p.Codigo.Contains(texto, StringComparison.OrdinalIgnoreCase)
                         || p.Id.ToString().Contains(texto, StringComparison.OrdinalIgnoreCase))
                .Take(20)
                .ToList();
    }

