@code {
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }
    [SupplyParameterFromQuery(Name = "ver")] public bool? Ver { get; set; }
    private bool SoloVer => Ver == true;

    private List<OrdenActivaResumenDto> _ordenesActivas = new();
    private HistorialOrdenesSoap? _historialSoap;
    private SelectorClinicoDto? _mascotaConsultada;
    private string _nombreMascotaHistorial = "";
    private List<SelectorClinicoDto>? _mascotasHistorial;
    private int _versionBusquedaMascota;
    private bool _errorBusquedaMascota;

    private async Task BuscarMascotasHistorialAsync()
    {
        var version = ++_versionBusquedaMascota;
        var nombre = _nombreMascotaHistorial.Trim();
        _mascotasHistorial = null;
        _errorBusquedaMascota = false;
        if (nombre.Length == 0)
            return;

        await Task.Delay(250);
        if (version != _versionBusquedaMascota)
            return;

        try
        {
            var mascotas = await AdmisionService.BuscarMascotasConOrdenesVisiblesAsync(nombre);
            if (version == _versionBusquedaMascota)
                _mascotasHistorial = mascotas;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al buscar mascotas para el historial SOAP");
            if (version == _versionBusquedaMascota)
                _errorBusquedaMascota = true;
        }
    }

    private async Task AbrirHistorialMascotaAsync(SelectorClinicoDto mascota)
    {
        _versionBusquedaMascota++;
        _mascotasHistorial = null;
        _nombreMascotaHistorial = mascota.Descripcion;
        _mascotaConsultada = mascota;
        if (!FichaEditable && !CargandoInicial && (!FichaCargada || Paciente?.Nhcl != mascota.Id))
        {
            _verHistorial = false;
            Nav.NavigateTo($"/consulta/fichamedica/paciente/{mascota.Id}");
            return;
        }

        if (_historialSoap != null)
            await _historialSoap.VerOrdenesAsync(mascota);
    }

    private OrdenPacienteResumenDto? OrdenActualResumen => _historialOrdenes.FirstOrDefault(o => o.IdOrden == IdOrden);
    private int _ordenActualAsignadaA => OrdenActualResumen?.IdMedico ?? 0;
    private bool FichaCargada => Paciente != null && IdOrden > 0 && !CargandoInicial;
    private bool FichaEditable => !SoloVer && FichaCargada &&
        (Session.TipoUser == 1
            ? ((_estadoOrden is ("A" or "E") && (_inicioConsultaUtc.HasValue || _triajeMedicoPendiente)) || _estadoOrden == "T")
            : (OrdenActualResumen is { } ord
                && ord.IdMedico == Session.IdUser
                && ord.EnVentanaEdicion24h
                && ((_estadoOrden is ("A" or "E") && (_inicioConsultaUtc.HasValue || _triajeMedicoPendiente)) || _estadoOrden == "T")));
    private DateTime? _inicioConsultaUtc;
    private bool _triajeMedicoPendiente;
    private DateTime? _finConsultaUtc;
    private string? _estadoOrden;
    private bool _verHistorial;
    private int TabActiva { get; set; } = 1;
    private bool CargandoInicial { get; set; } = true;
    private bool Guardando { get; set; }
    private string? MensajeAlerta { get; set; }
    private bool EsError { get; set; }

    private PacienteHeaderDto? Paciente { get; set; }
    private ColaOrdenesClinicas? _colaOrdenes;
    private List<OrdenPacienteResumenDto> _historialOrdenes = [];
    private bool _errorHistorialOrdenes;
    private FichaMedicaCompletaDto Ficha { get; set; } = new();
    private List<DiagnosticoCie10Dto> Diagnosticos { get; set; } = new();
    private List<CatalogoCie10ItemDto> ResultadosCie10 { get; set; } = new();
    private List<RecetaMedicamentoItemDto> RecetaItems { get; set; } = new();
    private List<AntecedenteClinicoDto> Antecedentes { get; set; } = new();
    private List<VacunaPacienteDto> Vacunas { get; set; } = new();
    private List<CatalogoItemGenericoDto> CatalogoVacunas { get; set; } = new();
    private List<string> TiposConsultaCatalogo { get; set; } = new();
    private IEnumerable<string> TiposConsultaDisponibles =>
        !string.IsNullOrWhiteSpace(Ficha.MedTipoConsulta) &&
        !TiposConsultaCatalogo.Any(x => string.Equals(x, Ficha.MedTipoConsulta, StringComparison.OrdinalIgnoreCase))
            ? TiposConsultaCatalogo.Append(Ficha.MedTipoConsulta)
            : TiposConsultaCatalogo;

    private string FiltroCie10 { get; set; } = string.Empty;
    private DiagnosticoCie10Dto NuevoDiagnostico { get; set; } = new();
    private AntecedenteClinicoDto NuevoAntecedente { get; set; } = new();
    private VacunaPacienteDto NuevaVacuna { get; set; } = new();

    // Prescripción médica inline (Tab 3)
    private List<CatalogoOperativoDto> _catalogoMedicamentos = new();
    private List<CatalogoOperativoDto> _sugerenciasMedicamento = new();
    private bool _mostrarSugerenciasMed;
    private RecetaMedicamentoItemDto NuevoMedicamento { get; set; } = new();

    // Órdenes de Servicio (Laboratorio, Imagenología, Fisioterapia desde PRODUCTO)
    private sealed record ServicioCatalogoItem(string Codigo, string Descripcion, decimal Precio, string? CodigoBusqueda = null, int IdSubcategoria = 0, string? Subcategoria = null);

    private int _versionProcedimientos;
    private int _subcategoriaProcedimiento;
    private IEnumerable<ServicioCatalogoItem> SubcategoriasProcedimientos =>
        ServiciosCategoria.Where(s => s.IdSubcategoria > 0 && !string.IsNullOrWhiteSpace(s.Subcategoria))
            .DistinctBy(s => s.IdSubcategoria).OrderBy(s => s.Subcategoria);
    private List<ServicioCatalogoItem> ServiciosCategoria =>
        _cacheServiciosPorCategoria.TryGetValue(_categoriaServicio, out var lista) ? lista : [];
    private IEnumerable<ServicioCatalogoItem> ServiciosEnSubcategoria =>
        _categoriaServicio == "Procedimientos" && _subcategoriaProcedimiento > 0
            ? ServiciosCategoria.Where(s => s.IdSubcategoria == _subcategoriaProcedimiento)
            : ServiciosCategoria;
    private string _categoriaServicio = "Laboratorio";
    private readonly Dictionary<string, List<ServicioCatalogoItem>> _cacheServiciosPorCategoria = new();
    private List<ServicioCatalogoItem> _serviciosFiltrados = new();
    private string _filtroServicio = string.Empty;
    private string _codigoServicioSeleccionado = string.Empty;
    private bool _mostrarSugerenciasServicio;
    private decimal _cantidadServicio = 1;
    private string _prioridadServicio = "Rutina";
    private string _observacionServicio = string.Empty;

    private List<OrdenLaboratorioItemDto> OrdenesLab { get; set; } = new();
    private List<OrdenImagenItemDto> OrdenesImagen { get; set; } = new();
    private List<FisioterapiaOrdenDto> OrdenesFisio { get; set; } = new();

    private bool _ordenActualCerrada;

    protected override async Task OnParametersSetAsync()
    {
        _ordenActualCerrada = false;
        _estadoOrden = null;
        _versionCambios = _versionGuardada = 0;

        CargandoInicial = true;
        Paciente = null;
        Ficha = new();
        Diagnosticos = [];
        RecetaItems = [];
        Antecedentes = [];
        Vacunas = [];
        _mensajeServicio = null;
        OrdenesLab = [];
        OrdenesImagen = [];
        OrdenesFisio = [];
        _cacheServiciosPorCategoria.Remove("Procedimientos");
        _subcategoriaProcedimiento = 0;
        if (_categoriaServicio == "Procedimientos")
        {
            _codigoServicioSeleccionado = string.Empty;
            _filtroServicio = string.Empty;
            _observacionServicio = string.Empty;
            _cantidadServicio = 1;
            _mostrarSugerenciasServicio = false;
        }
        if (TabActiva == 3)
            TabActiva = 1;

        await Task.Yield();

        try
        {
            if (_ordenesActivas.Count == 0)
            {
                _ordenesActivas = (await KardexService.ObtenerOrdenesActivasAsync(top: 50))
                    .Where(o => o.Estado.Trim() != "T" && o.Estado.Trim() != "I")
                    .ToList();
                if (Session.TipoUser == 2)
                {
                    _ordenesActivas = _ordenesActivas.Where(o => o.IdMedico == Session.IdUser).ToList();
                }
            }

            if (IdOrden <= 0 && Nhcl <= 0 && Session.OrdenActiva.HasValue && Session.OrdenActiva.Value > 0)
            {
                var activa = _ordenesActivas.FirstOrDefault(o => o.IdOrdenAtencion == Session.OrdenActiva.Value);
                if (activa != null)
                {
                    IdOrden = activa.IdOrdenAtencion;
                    Nhcl = activa.Nhcl;
                }
                else
                {
                    Session.LimpiarOrdenActiva();
                }
            }

            if (IdOrden > 0 || Nhcl > 0)
            {
                await CargarDatosCompletosAsync();

                if (Paciente != null && !_ordenesActivas.Any(o => o.IdOrdenAtencion == IdOrden))
                {
                    _ordenesActivas.Insert(0, new OrdenActivaResumenDto
                    {
                        OrdenAtencionId = IdOrden,
                        Nhcl = Nhcl,
                        Paciente = Paciente.PacienteNombre,
                        Cliente = Paciente.PropietarioNombre,
                        Especie = Paciente.Especie,
                        Sexo = Paciente.Sexo
                    });
                }
            }
            else
            {
                Paciente = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "No se pudo cargar la ficha SOAP de la orden {Orden} para NHCL {Nhcl}", IdOrden, Nhcl);
            Paciente = null;
            EsError = true;
            MensajeAlerta = "No se pudo cargar la ficha SOAP. Recarga la página para intentarlo de nuevo.";
        }
        finally
        {
            CargandoInicial = false;
        }
    }

    private async Task AbrirOrdenHistorialAsync((int IdOrden, int Nhcl, bool Editar) orden)
    {
        if (!await GuardarCambiosSoapAsync()) return;

        _verHistorial = false;
        Nav.NavigateTo($"/consulta/fichamedica/{orden.IdOrden}/{orden.Nhcl}" + (orden.Editar ? "" : "?ver=true"));
    }

    private async Task VerHistorialAsync()
    {
        if (await GuardarCambiosSoapAsync())
            _verHistorial = true;
    }

    private async Task SeleccionarTabAsync(int tab)
    {
        if (!await GuardarCambiosSoapAsync()) return;

        TabActiva = tab;
        MensajeAlerta = null;
        EsError = false;
        if (tab == 3 && FichaEditable)
            await CargarCatalogosPrescripcionAsync();
    }

    private Task ContinuarConsultaTrasTriajeAsync(FichaMedicaCompletaDto ficha) =>
        ficha.MedOrden == IdOrden && ficha.MedNhcl == Nhcl ? CargarDatosCompletosAsync() : Task.CompletedTask;

    private async Task CargarDatosCompletosAsync()
    {
        _triajeMedicoPendiente = false;
        _inicioConsultaUtc = null;
        _finConsultaUtc = null;
        MensajeAlerta = null;
        EsError = false;
        _historialOrdenes = [];
        _errorHistorialOrdenes = false;
        if (IdOrden > 0 && !await AdmisionService.PuedeConsultarOrdenAsync(IdOrden, Nhcl))
        {
            EsError = true;
            MensajeAlerta = "No tienes acceso a esta orden en las sucursales asignadas.";
            return;
        }

        if (IdOrden > 0)
        {
            Paciente = await KardexService.ObtenerEncabezadoPacienteAsync(IdOrden, Nhcl);
            if (Paciente != null)
                Nhcl = Paciente.Nhcl;
        }

        if (Nhcl > 0)
        {
            try
            {
                _historialOrdenes = await AdmisionService.ObtenerOrdenesPacienteAsync(Nhcl);
                if (IdOrden <= 0 && _historialOrdenes.FirstOrDefault(orden => orden.Estado.Trim() != "I") is { } ultimaOrden)
                {
                    IdOrden = ultimaOrden.IdOrden;
                    Paciente = await KardexService.ObtenerEncabezadoPacienteAsync(IdOrden, Nhcl);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error al cargar el historial de órdenes de la mascota {Nhcl}", Nhcl);
                _errorHistorialOrdenes = true;
            }
        }

        _estadoOrden = _historialOrdenes.FirstOrDefault(orden => orden.IdOrden == IdOrden)?.Estado.Trim().ToUpperInvariant();
        _ordenActualCerrada = _estadoOrden == "T";
        if (!SoloVer && !_ordenActualCerrada)
            Session.SeleccionarOrden(IdOrden, Nhcl, Paciente?.PacienteNombre);

        if (Paciente == null || IdOrden <= 0)
            return;

        if (!SoloVer && _estadoOrden is ("A" or "E"))
        {
            _inicioConsultaUtc = await AdmisionService.IniciarAtencionClinicaAsync(IdOrden, Nhcl, triaje: false);
            if (!_inicioConsultaUtc.HasValue)
            {
                _triajeMedicoPendiente = Session.TipoUser == 2 &&
                    (await AdmisionService.ObtenerColaClinicaAsync(triaje: true, idOrden: IdOrden)).Any();
                if (!_triajeMedicoPendiente)
                    MensajeAlerta = "La consulta estará disponible cuando se complete el triaje requerido.";
            }
        }

        var tFicha = ConsultaService.ObtenerFichaMedicaAsync(IdOrden, Nhcl);
        var tDiag = ConsultaService.ObtenerDiagnosticosOrdenAsync(IdOrden);
        var tRec = ConsultaService.ObtenerRecetaOrdenAsync(IdOrden);
        var tAnt = ConsultaService.ObtenerAntecedentesPacienteAsync(Nhcl);
        var tVac = ConsultaService.ObtenerVacunasPacienteAsync(Nhcl);
        var tCatalogoVac = ConsultaService.ObtenerCatalogoVacunasAsync();
        var tTiposConsulta = ConsultaService.ObtenerTiposConsultaCatalogoAsync(Session.Localidad);
        var tLab = LabImagenService.ObtenerOrdenesLaboratorioAsync(IdOrden, Nhcl);
        var tImg = LabImagenService.ObtenerOrdenesImagenAsync(IdOrden, Nhcl);
        var tFisio = AdminClinicaService.ObtenerFisioterapiaAsync(IdOrden, Nhcl);
        await Task.WhenAll(tFicha, tDiag, tRec, tAnt, tVac, tCatalogoVac, tTiposConsulta, tLab, tImg, tFisio);

        Ficha = await tFicha;
        if (Ficha.MedOrden <= 0) Ficha.MedOrden = IdOrden;
        if (Ficha.MedNhcl <= 0) Ficha.MedNhcl = Nhcl;
