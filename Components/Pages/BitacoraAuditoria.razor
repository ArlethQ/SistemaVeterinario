@page "/administracion/bitacora"
@inject IGestionMigradaService Service
@inject SessionStateService Session
@inject NavigationManager Nav
<PageTitle>Bitácora | e-ForVets</PageTitle>
@if(_autorizado){<div class="container-fluid py-3"><div class="d-flex justify-content-between align-items-end"><div><small class="text-primary fw-bold">SEGURIDAD</small><h2>Bitácora de auditoría</h2></div></div><div class="card my-3"><div class="card-body row g-2"><div class="col-md-2"><label>Desde</label><input type="date" class="form-control" @bind="_desde" @bind:after="Cargar"/></div><div class="col-md-2"><label>Hasta</label><input type="date" class="form-control" @bind="_hasta" @bind:after="Cargar"/></div><div class="col-md-5"><label>Usuario o detalle</label><input class="form-control" autocomplete="off" placeholder="Escriba usuario o detalle para filtrar..." @bind="_filtro" @bind:event="oninput" @bind:after="Cargar"/></div></div></div>@if(!string.IsNullOrEmpty(_error)){<div class="alert alert-danger">@_error</div>}<div class="table-responsive card"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Fecha</th><th>Usuario</th><th>Detalle</th><th>IP</th><th>Equipo</th></tr></thead><tbody>@foreach(var x in _items){<tr><td>@x.Fecha.ToString("g")</td><td>@x.Usuario <small class="d-block">#@x.IdUsuario</small></td><td>@x.Detalle</td><td>@x.Ip</td><td>@x.Equipo</td></tr>}</tbody></table></div></div>}
@code{bool _autorizado;string _filtro="",_error="";DateTime _desde=DateTime.Today.AddMonths(-1),_hasta=DateTime.Today;List<BitacoraDto> _items=[];protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated||Session.TipoUser!=1){Nav.NavigateTo("/dashboard");return;}_autorizado=true;await Cargar();}async Task Cargar(){try{_error="";_items=await Service.ObtenerBitacoraAsync(_desde,_hasta,_filtro);}catch(Exception){_error="No se pudo consultar la bitácora.";}}}
