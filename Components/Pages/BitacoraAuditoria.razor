@page "/administracion/bitacora"
@inject IGestionMigradaService Service
@inject SessionStateService Session
@inject NavigationManager Nav

<PageTitle>Bitácora | e-ForVets</PageTitle>

@if (_autorizado)
{
    <div class="container-fluid py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2">
            <div>
                <small class="text-primary fw-bold">SEGURIDAD</small>
                <h2 class="mb-0">Bitácora de auditoría</h2>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 position-relative">
                <button type="button" class="btn btn-outline-danger btn-sm dropdown-toggle" @onclick="() => _mostrarMenuDepurar = !_mostrarMenuDepurar" disabled="@_depurando">
                    <i class="bi bi-trash3 me-1"></i>Borrar anteriores a...
                </button>
                @if (_mostrarMenuDepurar)
                {
                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1030;" @onclick="() => _mostrarMenuDepurar = false"></div>
                    <div class="dropdown-menu dropdown-menu-end show shadow-sm position-absolute end-0 top-100 mt-1" style="z-index: 1040; min-width: 280px;">
                        <h6 class="dropdown-header small">Depuración segura (conserva hoy y órdenes activas)</h6>
                        <button type="button" class="dropdown-item small" @onclick='() => AbrirModalDepuracionAsync(DateTime.Today.AddDays(-7), "anteriores a 1 semana")'>
                            <i class="bi bi-calendar-week me-2 text-primary"></i>Anteriores a 1 semana
                        </button>
                        <button type="button" class="dropdown-item small" @onclick='() => AbrirModalDepuracionAsync(DateTime.Today.AddMonths(-1), "anteriores a 1 mes")'>
                            <i class="bi bi-calendar-month me-2 text-primary"></i>Anteriores a 1 mes
                        </button>
                        <button type="button" class="dropdown-item small" @onclick='() => AbrirModalDepuracionAsync(DateTime.Today.AddYears(-1), "anteriores a 1 año")'>
                            <i class="bi bi-calendar3 me-2 text-primary"></i>Anteriores a 1 año
                        </button>
                        <hr class="dropdown-divider" />
                        <button type="button" class="dropdown-item small text-danger fw-semibold" @onclick='() => AbrirModalDepuracionAsync(DateTime.Today, "todo lo anterior a hoy")'>
                            <i class="bi bi-exclamation-octagon me-2"></i>Todo (excepto hoy y órdenes en curso)
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="card my-3">
            <div class="card-body row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small mb-1">Desde</label>
                    <input type="date" class="form-control form-control-sm" @bind="_desde" @bind:after="BuscarPrimeraPaginaAsync" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1">Hasta</label>
                    <input type="date" class="form-control form-control-sm" @bind="_hasta" @bind:after="BuscarPrimeraPaginaAsync" />
                </div>
                <div class="col-md-5">
                    <label class="form-label small mb-1">Usuario o detalle</label>
                    <input class="form-control form-control-sm" autocomplete="off" placeholder="Escriba usuario o detalle para filtrar..." @bind="_filtro" @bind:event="oninput" @bind:after="BuscarPrimeraPaginaAsync" />
                </div>
                <div class="col-md-3 text-md-end">
                    <small class="text-muted">Total: <strong>@_totalRegistros.ToString("N0")</strong> registro(s)</small>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_mensajeExito))
        {
            <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@_mensajeExito
                <button type="button" class="btn-close" @onclick="() => _mensajeExito = string.Empty"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2 small">@_error</div>
        }

        <div class="table-responsive card">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Usuario</th>
                        <th>Detalle</th>
                        <th>IP</th>
                        <th>Equipo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_items.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No se encontraron registros en el rango seleccionado.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var x in _items)
                        {
                            <tr>
                                <td class="text-nowrap">@x.Fecha.ToString("g")</td>
                                <td>@x.Usuario <small class="d-block text-muted">#@x.IdUsuario</small></td>
                                <td>@x.Detalle</td>
                                <td class="text-nowrap">@x.Ip</td>
                                <td class="text-nowrap">@x.Equipo</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (_totalRegistros > 0)
            {
                var inicio = ((_pagina - 1) * TamanoPagina) + 1;
                var fin = Math.Min(_pagina * TamanoPagina, _totalRegistros);
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-top bg-light">
                    <small class="text-muted">
                        Mostrando <strong>@inicio–@fin</strong> de <strong>@_totalRegistros.ToString("N0")</strong> · Página <strong>@_pagina</strong> de <strong>@TotalPaginas</strong>
                    </small>
                    @if (TotalPaginas > 1)
                    {
                        <nav aria-label="Paginación de bitácora">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(_pagina <= 1 ? "disabled" : "")">
                                    <button type="button" class="page-link" @onclick="() => IrAPaginaAsync(_pagina - 1)" disabled="@(_pagina <= 1)">Anterior</button>
                                </li>
                                @foreach (var p in PaginasVisibles)
                                {
                                    if (p == -1)
                                    {
                                        <li class="page-item disabled"><span class="page-link">…</span></li>
                                    }
                                    else
                                    {
                                        var num = p;
                                        <li class="page-item @(num == _pagina ? "active" : "")">
                                            <button type="button" class="page-link" @onclick="() => IrAPaginaAsync(num)">@num</button>
                                        </li>
                                    }
                                }
                                <li class="page-item @(_pagina >= TotalPaginas ? "disabled" : "")">
                                    <button type="button" class="page-link" @onclick="() => IrAPaginaAsync(_pagina + 1)" disabled="@(_pagina >= TotalPaginas)">Siguiente</button>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        </div>
    </div>

    @if (_mostrarModalDepurar)
    {
        <div class="modal-backdrop fade show" style="z-index: 1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" role="dialog" style="z-index: 1055;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-3">
                    <div class="modal-header bg-danger text-white py-2 px-3">
                        <h6 class="modal-title fw-bold mb-0">
                            <i class="bi bi-shield-check me-2"></i>Confirmar depuración segura de bitácora
                        </h6>
                        <button type="button" class="btn-close btn-close-white" disabled="@_depurando" @onclick="CerrarModalDepuracion"></button>
                    </div>
                    <div class="modal-body p-3">
                        @if (_cargandoPreview)
                        {
                            <div class="d-flex align-items-center gap-2 py-3 justify-content-center text-muted">
                                <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                                <span>Calculando registros a depurar...</span>
                            </div>
                        }
                        else
                        {
                            <p class="mb-2">
                                Vas a eliminar registros de auditoría <strong>@_etiquetaDepuracion</strong> (anteriores al <strong>@_fechaCorteDepuracion.ToString("dd/MM/yyyy")</strong>).
                            </p>
                            <div class="alert alert-light border small mb-3">
                                <div><strong>Registros a eliminar:</strong> <span class="text-danger fw-bold">@_previewEliminables.ToString("N0")</span></div>
                                <div class="mt-1"><strong>Registros protegidos (se conservarán):</strong> <span class="text-success fw-bold">@_previewProtegidos.ToString("N0")</span></div>
                                <div class="text-muted mt-2">
                                    <i class="bi bi-lock-fill me-1 text-success"></i>
                                    Se conservan automáticamente todos los registros del <strong>día de hoy</strong> y los asociados a <strong>órdenes aún abiertas o en curso</strong>.
                                </div>
                            </div>
                            @if (_previewEliminables == 0)
                            {
                                <div class="alert alert-info py-2 small mb-0">
                                    No existen registros antiguos eliminables para este período.
                                </div>
                            }
                        }
                    </div>
                    <div class="modal-footer py-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_depurando" @onclick="CerrarModalDepuracion">Cancelar</button>
                        <button type="button" class="btn btn-danger btn-sm fw-semibold"
                                disabled="@(_cargandoPreview || _depurando || _previewEliminables == 0)"
                                @onclick="ConfirmarDepuracionAsync">
                            @if (_depurando)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Depurando...</span>
                            }
                            else
                            {
                                <i class="bi bi-trash3 me-1"></i>
                                <span>Eliminar @_previewEliminables.ToString("N0") registro(s)</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private const int TamanoPagina = 50;
    bool _autorizado;
    string _filtro = "", _error = "", _mensajeExito = "";
    DateTime _desde = DateTime.Today.AddMonths(-1), _hasta = DateTime.Today;
    List<BitacoraDto> _items = [];
    int _pagina = 1;
    int _totalRegistros;
    int TotalPaginas => Math.Max(1, (int)Math.Ceiling(_totalRegistros / (double)TamanoPagina));

    IEnumerable<int> PaginasVisibles
    {
        get
        {
            var paginas = new List<int>();
            int total = TotalPaginas;
            if (total <= 7)
            {
                for (int i = 1; i <= total; i++) paginas.Add(i);
                return paginas;
            }
            paginas.Add(1);
            int desde = Math.Max(2, _pagina - 1);
            int hasta = Math.Min(total - 1, _pagina + 1);
            if (desde > 2) paginas.Add(-1);
            for (int i = desde; i <= hasta; i++) paginas.Add(i);
            if (hasta < total - 1) paginas.Add(-1);
            paginas.Add(total);
            return paginas;
        }
    }

    bool _mostrarMenuDepurar;
    bool _mostrarModalDepurar;
    bool _cargandoPreview;
    bool _depurando;
    DateTime _fechaCorteDepuracion;
    string _etiquetaDepuracion = "";
    int _previewEliminables;
    int _previewProtegidos;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || Session.TipoUser != 1)
        {
            Nav.NavigateTo("/dashboard");
            return;
        }
        _autorizado = true;
        await Cargar();
    }

    async Task BuscarPrimeraPaginaAsync()
    {
        _pagina = 1;
        await Cargar();
    }

    async Task IrAPaginaAsync(int nuevaPagina)
    {
        int destino = Math.Clamp(nuevaPagina, 1, TotalPaginas);
        if (destino == _pagina) return;
        _pagina = destino;
        await Cargar();
    }

    async Task Cargar()
    {
        try
        {
            _error = "";
            var (items, total) = await Service.ObtenerBitacoraPaginadaAsync(_desde, _hasta, _filtro, _pagina, TamanoPagina);
            _items = items;
            _totalRegistros = total;
            if (_pagina > TotalPaginas)
            {
                _pagina = TotalPaginas;
                var retry = await Service.ObtenerBitacoraPaginadaAsync(_desde, _hasta, _filtro, _pagina, TamanoPagina);
                _items = retry.Items;
                _totalRegistros = retry.Total;
            }
        }
        catch (Exception)
        {
            _error = "No se pudo consultar la bitácora.";
        }
    }

    async Task AbrirModalDepuracionAsync(DateTime fechaCorte, string etiqueta)
    {
        _mostrarMenuDepurar = false;
        _fechaCorteDepuracion = fechaCorte.Date > DateTime.Today ? DateTime.Today : fechaCorte.Date;
        _etiquetaDepuracion = etiqueta;
        _previewEliminables = 0;
        _previewProtegidos = 0;
        _mostrarModalDepurar = true;
        _cargandoPreview = true;
        _error = "";
        StateHasChanged();

        try
        {
            var (eliminables, protegidos) = await Service.PrevisualizarDepuracionBitacoraAsync(_fechaCorteDepuracion);
            _previewEliminables = eliminables;
            _previewProtegidos = protegidos;
        }
        catch (Exception)
        {
            _error = "No se pudo calcular la cantidad de registros a depurar.";
            _mostrarModalDepurar = false;
        }
        finally
        {
            _cargandoPreview = false;
        }
    }

    void CerrarModalDepuracion()
    {
        if (_depurando) return;
        _mostrarModalDepurar = false;
    }

    async Task ConfirmarDepuracionAsync()
    {
        if (_depurando || _previewEliminables <= 0) return;
        _depurando = true;
        _error = "";
        _mensajeExito = "";
        try
        {
            int eliminados = await Service.DepurarBitacoraAsync(_fechaCorteDepuracion, _etiquetaDepuracion, Session.IdUser);
            _mostrarModalDepurar = false;
            _mensajeExito = $"Depuración completada con éxito: se eliminaron {eliminados:N0} registro(s) antiguos. Los registros de hoy y de órdenes activas permanecen intactos.";
            await Cargar();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo completar la depuración de bitácora: {ex.Message}";
            _mostrarModalDepurar = false;
        }
        finally
        {
            _depurando = false;
        }
    }
}
