@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        string relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        string returnUrl = string.IsNullOrWhiteSpace(relative) ? string.Empty : $"?returnUrl=/{Uri.EscapeDataString(relative)}";
        Navigation.NavigateTo($"/login{returnUrl}", replace: true);
    }
}
