@using HosvetKardex.Web.Components.Pages
@inject IConsultaExternaService ConsultaService
@inject ILaboratorioImagenService LabImagenService
@inject IAdministracionClinicaService AdminClinicaService
@inject IAdmisionFacturacionService AdmisionService
@inject IEFactCatalogService EFactCatalog
@inject IFarmaciaService FarmaciaService
@inject IReportExportService ReportService
@inject SessionStateService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<OrdenesClinicasSoapPanel> Logger

@if (IdOrden > 0 && Nhcl > 0)
{
    <!-- Switch de carga de datos desde Anamnesis / SOAP -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2 mt-3 mb-2 rounded border @(_cargarDatosAnamnesis ? "bg-primary-subtle border-primary-subtle" : "bg-light") small">
        <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
            <input class="form-check-input mt-0" type="checkbox" role="switch" id="chkCargarAnamnesisEvol"
                   checked="@_cargarDatosAnamnesis"
                   @onchange="OnToggleCargarAnamnesis" />
            <label class="form-check-label fw-bold text-dark mb-0" for="chkCargarAnamnesisEvol">
                Cargar datos de la anamnesis (SOAP)
            </label>
        </div>
        <span class="text-muted">
            @if (_cargarDatosAnamnesis)
            {
                <span>Mostrando prescripción, insumos y servicios cargados del SOAP. Si lo desactivas, se limpia esta vista sin borrar el SOAP.</span>
            }
            else
            {
                <span>Vista limpia (sin datos de anamnesis). Actívalo nuevamente si deseas recuperar lo cargado en el SOAP.</span>
            }
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="alert @(_esError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small mb-3" role="alert">
            <i class="bi @(_esError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-2"></i>@_mensaje
            <button type="button" class="btn-close py-2" @onclick="() => _mensaje = null"></button>
        </div>
    }

    <div class="row g-3">
        <!-- 1. PRESCRIPCIÓN MÉDICA / MEDICINAS DE LA EVOLUCIÓN -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold text-primary d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span><i class="bi bi-capsule me-1"></i>Prescripción Médica / Medicinas</span>
                        @if (_medicinasTrabajo.Count > 0)
                        {
                            <span class="badge bg-warning text-dark fw-normal" style="font-size:.72rem;"
                                  title="Al presionar Registrar Nota de Evolución, estas medicinas se descargarán directamente del inventario y pasarán a factura.">
                                <i class="bi bi-arrow-right-circle me-1"></i>Se descargan y facturan al registrar nota de evolución
                            </span>
                        }
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-success">@_medicinasTrabajo.Count ítem(s)</span>
                        <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2"
                                @onclick="CargarDeEvolucionAnteriorAsync"
                                disabled="@_cargandoEvolucionAnterior"
                                title="Cargar las medicinas registradas en la evolución médica anterior">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>@(_cargandoEvolucionAnterior ? "Cargando..." : "Cargar de evolución anterior")
                        </button>
                        <div class="app-prescription-actions">
                            <a href="/farmacia" class="btn app-doc-action app-pharmacy-action" title="Ver receta en Cola de Farmacia">
                                <i class="ri-medicine-bottle-line me-1"></i>Cola Farmacia
                            </a>
                            <button type="button" class="btn app-doc-action app-doc-print"
                                    @onclick="ImprimirRecetaMedicaPdfAsync" title="Imprimir Receta Médica">
                                <i class="bi bi-printer" aria-hidden="true"></i>Imprimir Receta
                            </button>
                            <button type="button" class="btn app-doc-action app-prescription-action"
                                    @onclick='() => Nav.NavigateTo($"/consulta/recetario/{IdOrden}/{Nhcl}")'>
                                <i class="bi bi-prescription2" aria-hidden="true"></i>Abrir Recetario
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3 p-2 bg-light rounded border">
                        <div class="col-md-5 position-relative">
                            <label class="form-label small fw-semibold">Medicamento / Producto *</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" autocomplete="off"
                                       @bind="_nuevoMedicamento.Descripcionamento"
                                       @bind:event="oninput"
                                       @bind:after="OnMedicamentoInputChanged"
                                       @onfocus="OnMedicamentoFocus"
                                       placeholder="Buscar por nombre o código..." />
                                @if (!string.IsNullOrWhiteSpace(_nuevoMedicamento.Descripcionamento))
                                {
                                    <button type="button" class="btn btn-outline-secondary" title="Limpiar" @onclick="LimpiarSeleccionMedicamento">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                            @if (_mostrarSugerenciasMed && _sugerenciasMedicamento.Any())
                            {
                                <div class="list-group position-absolute w-100 shadow-sm mt-1" style="z-index: 1050; max-height: 190px; overflow-y: auto;">
                                    @foreach (var prod in _sugerenciasMedicamento)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action py-1 px-2 small d-flex justify-content-between align-items-center"
                                                @onclick="() => SeleccionarMedicamento(prod)">
                                            <span>
                                                <strong>[@prod.Id] @prod.Codigo</strong> @prod.Descripcion
                                                <small class="text-muted ms-1">(@prod.UnidadMedida@(prod.FactorConversion > 1m ? $" · Paq. ×{prod.FactorConversion:G29}" : ""))</small>
                                            </span>
                                            <span class="text-muted ms-2">$@(prod.Precio?.ToString("F2") ?? "0.00")</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Cant. y Presentación</label>
                            <div class="input-group input-group-sm">
                                <input type="number" min="1" step="1" class="form-control" style="max-width: 72px;" onkeydown="return event.key !== '-'"
                                       @bind="_nuevoMedicamento.Cantidad" @bind:after="ActualizarCantidadLetras" />
                                <select class="form-select" @bind="_modoDespachoReceta" @bind:after="ActualizarCantidadLetras">
                                    <option value="UNIDAD">@UnidadProductoReceta</option>
                                    <option value="PAQUETE">@(FactorProductoReceta > 1m ? $"Paquete (×{FactorProductoReceta:G29} {UnidadProductoReceta})" : "Paquete")</option>
                                </select>
                            </div>
                            @if (_modoDespachoReceta == "PAQUETE" && FactorProductoReceta > 1m)
                            {
                                <small class="text-primary d-block mt-1 fw-semibold" style="font-size:.72rem;">
                                    = @CantidadBaseRecetaCalculada.ToString("0.##") @UnidadProductoReceta
                                </small>
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">En Letras</label>
                            <input type="text" class="form-control form-control-sm" @bind="_nuevoMedicamento.CantidadLetras" />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label small fw-semibold">Indicaciones Posológicas (Dosis, Frecuencia y Duración) *</label>
                            <input type="text" class="form-control form-control-sm" @bind="_nuevoMedicamento.Indicaciones"
                                   placeholder="Ej: Administrar 1 tableta vía oral cada 12 horas por 7 días." />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <SaveButton Type="button" class="btn btn-sm btn-success w-100" OnClick="AgregarMedicamentoTrabajo">
                                <i class="bi bi-plus-circle me-1"></i>Agregar
                            </SaveButton>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold mb-0">Indicaciones Generales de Receta</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="_indicacionesGeneralesReceta"
                                  placeholder="Cuidados generales para imprimir en la receta..."></textarea>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Medicamento</th>
                                    <th class="text-center" style="width:110px;">Cant.</th>
                                    <th>Indicaciones Posológicas</th>
                                    <th style="width:120px;">Origen</th>
                                    <th style="width:40px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!_medicinasTrabajo.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-3">Sin medicamentos pendientes por confirmar en esta evolución.</td></tr>
                                }
                                @foreach (var item in _medicinasTrabajo)
                                {
                                    <tr @key="item.IdTemp">
                                        <td class="fw-semibold">@item.Item.Descripcionamento</td>
                                        <td class="text-center">
                                            <input type="number" min="0.01" step="1" class="form-control form-control-sm text-center"
                                                   @bind="item.Item.Cantidad" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   @bind="item.Item.Indicaciones" />
                                        </td>
                                        <td>
                                            @if (item.Origen == "ANAMNESIS")
                                            {
                                                <span class="badge bg-info-subtle text-primary border">Anamnesis SOAP</span>
                                            }
                                            else if (item.Origen == "EVOLUCION_ANT")
                                            {
                                                <span class="badge bg-secondary-subtle text-dark border">Evol. anterior</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border">Nuevo</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0" title="Quitar de esta evolución"
                                                    @onclick="() => QuitarMedicinaTrabajo(item.IdTemp)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. MEDICACIÓN / INSUMOS ADMINISTRADOS (EN FACTURA) -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold text-primary d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span><i class="bi bi-eyedropper me-1"></i>Medicación / Insumos Administrados</span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary">@AplicadosVisibles.Count ítem(s)</span>
                        <small class="text-muted fw-normal">Va directo al cobro en factura (no se puede borrar)</small>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3 p-2 bg-light rounded border align-items-end">
                        <div class="col-md-5 position-relative">
                            <label class="form-label small fw-semibold">Medicamento / Insumo en stock *</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" autocomplete="off"
                                       @bind="_filtroAplicado"
                                       @bind:event="oninput"
                                       @bind:after="OnAplicadoInputChanged"
                                       @onfocus="OnAplicadoFocus"
                                       placeholder="Buscar producto con stock en la sucursal..." />
                                @if (!string.IsNullOrWhiteSpace(_filtroAplicado))
                                {
                                    <button type="button" class="btn btn-outline-secondary" title="Limpiar" @onclick="LimpiarProductoAplicado">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                            @if (_mostrarSugerenciasAplicado && _sugerenciasAplicado.Any())
                            {
                                <div class="list-group position-absolute w-100 shadow-sm mt-1" style="z-index: 1050; max-height: 190px; overflow-y: auto;">
                                    @foreach (var prod in _sugerenciasAplicado)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action py-1 px-2 small d-flex justify-content-between align-items-center"
                                                @onclick="() => SeleccionarProductoAplicado(prod)">
                                            <span>
                                                <strong>[@prod.CodigoPrincipal]</strong> @prod.NombreProducto
                                                @if (!prod.ControlaInventario)
                                                {
                                                    <small class="text-info ms-1">(Sin control de inventario · @prod.UnidadMedida)</small>
                                                }
                                                else
                                                {
                                                    <small class="text-success ms-1">(Disp: @prod.StockLibre.ToString("0.##") @prod.UnidadMedida@(prod.FactorConversion > 1m ? $" · Paq. ×{prod.FactorConversion:G29}" : ""))</small>
                                                }
                                            </span>
                                            <span class="text-muted ms-2">$@prod.PrecioUnitario.ToString("F2")</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Cant. y Presentación</label>
                            <div class="input-group input-group-sm">
                                <input type="number" min="1" step="1" class="form-control" style="max-width: 72px;" onkeydown="return event.key !== '-'"
                                       @bind="_cantidadAplicado" />
                                <select class="form-select" @bind="_modoAplicado">
                                    <option value="UNIDAD">@UnidadProductoAplicado</option>
                                    @if (FactorProductoAplicado > 1m)
                                    {
                                        <option value="PAQUETE">Paquete (×@FactorProductoAplicado.ToString("G29") @UnidadProductoAplicado)</option>
                                    }
                                </select>
                            </div>
                            @if (_modoAplicado == "PAQUETE" && FactorProductoAplicado > 1m)
                            {
                                <small class="text-primary d-block mt-1 fw-semibold" style="font-size:.72rem;">
                                    = @CantidadBaseAplicadoCalculada.ToString("0.##") @UnidadProductoAplicado a descontar
                                </small>
                            }
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold">Vía / Detalle</label>
                            <input type="text" class="form-control form-control-sm" @bind="_indicacionAplicado"
                                   placeholder="Ej: IV 2 ml en evolución" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <SaveButton Type="button" class="btn btn-sm btn-primary w-100" OnClick="AgregarAplicadoConsultaAsync">
                                <i class="bi bi-check2-circle me-1"></i>Aplicar
                            </SaveButton>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Medicamento / Insumo</th>
                                    <th class="text-center">Cant.</th>
                                    <th>Vía / Detalle</th>
                                    <th>Fecha</th>
                                    <th class="text-end">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!AplicadosVisibles.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-3">Sin medicación o insumos aplicados para mostrar.</td></tr>
                                }
                                @foreach (var ap in AplicadosVisibles)
                                {
                                    <tr>
                                        <td class="fw-semibold">@ap.Descripcionamento</td>
                                        <td class="text-center fw-bold">@ap.Cantidad.ToString("0.##")</td>
                                        <td>@ap.Indicaciones</td>
                                        <td class="text-muted">@ap.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <span class="badge bg-light text-secondary border" title="Administrado (no se puede eliminar)">
                                                <i class="bi bi-lock-fill me-1"></i>En factura
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. SERVICIOS MÉDICOS -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold text-primary d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span><i class="bi bi-clipboard2-check me-1"></i>Servicios Médicos</span>
                    <div class="d-flex flex-wrap gap-1 small">
                        <span class="badge bg-info text-dark">Lab: @OrdenesLabVisibles.Count</span>
                        <span class="badge bg-warning text-dark">Imagen: @OrdenesImagenVisibles.Count</span>
                        <span class="badge bg-success">Fisio: @OrdenesFisioVisibles.Count</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3 p-2 bg-light rounded border align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Categoría de Servicio *</label>
                            <select class="form-select form-select-sm" @bind="_categoriaServicio" @bind:after="OnCategoriaServicioChangedAsync">
                                <option value="Laboratorio">Laboratorio</option>
                                <option value="Imagenología">Imagenología</option>
                                <option value="Fisioterapia">Fisioterapia</option>
                                <option value="Procedimientos">Procedimientos</option>
                            </select>
                        </div>
                        @if (_categoriaServicio == "Procedimientos")
                        {
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Subcategoría</label>
                                <select class="form-select form-select-sm" @bind="_subcategoriaProcedimiento" @bind:after="LimpiarSeleccionServicio">
                                    <option value="0">Todas las subcategorías</option>
                                    @foreach (var grupo in SubcategoriasProcedimientos)
                                    {
                                        <option value="@grupo.IdSubcategoria">@grupo.Subcategoria</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="col-md-4 position-relative">
                            <label class="form-label small fw-semibold">Tipo de Servicio (Catálogo PRODUCTO) *</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" autocomplete="off"
                                       @bind="_filtroServicio"
                                       @bind:event="oninput"
                                       @bind:after="OnFiltroServicioInputChanged"
                                       @onfocus="() => _mostrarSugerenciasServicio = true"
                                       placeholder="Buscar o elegir servicio de @_categoriaServicio..." />
                                @if (!string.IsNullOrWhiteSpace(_filtroServicio))
                                {
                                    <button type="button" class="btn btn-outline-secondary" title="Limpiar filtro" @onclick="LimpiarSeleccionServicio">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                                <button type="button" class="btn btn-outline-secondary" title="Mostrar lista" @onclick="ToggleSugerenciasServicio">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            </div>
                            @if (_mostrarSugerenciasServicio)
                            {
                                <div class="list-group position-absolute w-100 shadow-sm mt-1" style="z-index: 1050; max-height: 220px; overflow-y: auto;">
                                    @if (!_serviciosFiltrados.Any())
                                    {
                                        <div class="list-group-item small text-muted py-2">No hay servicios coincidentes en @_categoriaServicio.</div>
                                    }
                                    else
                                    {
                                        @foreach (var srv in _serviciosFiltrados.Take(40))
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action py-1 px-2 small d-flex justify-content-between align-items-center @(srv.Codigo == _codigoServicioSeleccionado ? "active" : "")"
                                                    @onclick="() => SeleccionarServicio(srv)">
                                                <span><strong>[@(srv.CodigoBusqueda ?? srv.Codigo)]</strong> @srv.Descripcion</span>
                                                @if (_categoriaServicio != "Procedimientos")
                                                {
                                                    <span class="ms-2 @(srv.Codigo == _codigoServicioSeleccionado ? "" : "text-muted")">$@srv.Precio.ToString("N2")</span>
                                                }
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small fw-semibold">Cant.</label>
                            <input type="number" min="1" step="1" class="form-control form-control-sm" onkeydown="return event.key !== '-'" @bind="_cantidadServicio" />
                        </div>
                        @if (_categoriaServicio == "Laboratorio")
                        {
                            <div class="col-md-1">
                                <label class="form-label small fw-semibold">Prioridad</label>
                                <select class="form-select form-select-sm" @bind="_prioridadServicio">
                                    <option value="Rutina">Rutina</option>
                                    <option value="Emergente">Emergente</option>
                                </select>
                            </div>
                        }
                        <div class="@(_categoriaServicio == "Laboratorio" ? "col-md-2" : "col-md-3")">
                            <label class="form-label small fw-semibold">Observaciones</label>
                            <input type="text" class="form-control form-control-sm" maxlength="@(_categoriaServicio == "Procedimientos" ? 250 : (int?)null)" @bind="_observacionServicio" placeholder="Indicaciones o detalle opcional..." />
                        </div>
                        <div class="col-md-1">
                            <SaveButton Type="button" class="btn btn-sm btn-primary w-100" OnClick="AgregarServicioOrdenAsync" Disabled="@_agregandoServicio">
                                <i class="bi bi-plus-lg"></i>
                            </SaveButton>
                        </div>
                    </div>
                    @if (_mensajeServicio is not null)
                    {
                        <p class="small @(_errorServicio ? "text-danger" : "text-success")" role="status">@_mensajeServicio</p>
                    }

                    <div class="row g-3">
                        <div class="col-12">
                            <ProcedimientosTriaje @key="(IdOrden, Nhcl, _versionProcedimientos)"
                                                 IdOrden="@IdOrden" Nhcl="@Nhcl" SoloLectura="true" />
                        </div>
                        <div class="col-12">
                            <div class="border rounded">
                                <div class="bg-info bg-opacity-10 px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-primary small">
                                        <i class="bi bi-droplet-half me-1"></i>Orden de Laboratorio
                                        <span class="badge bg-info text-dark ms-1">@OrdenesLabVisibles.Count</span>
                                    </span>
                                    <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2 app-doc-action app-doc-print"
                                            @onclick="ImprimirOrdenLaboratorioPdfAsync">
                                        <i class="bi bi-printer" aria-hidden="true"></i>Imprimir Orden de Laboratorio
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle small mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Prueba / Examen</th>
                                                <th class="text-center">Prioridad</th>
                                                <th class="text-center">Cant.</th>
                                                <th>Observaciones</th>
                                                <th class="text-end">Precio</th>
                                                <th>Estado</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!OrdenesLabVisibles.Any())
