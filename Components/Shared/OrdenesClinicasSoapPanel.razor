    private async Task AgregarServicioOrdenAsync()
    {
        if (_agregandoServicio || IdOrden <= 0 || Nhcl <= 0) return;
        _agregandoServicio = true;
        _mensajeServicio = null;

        try
        {
            if (_cantidadServicio <= 0)
            {
                _errorServicio = true;
                _mensajeServicio = "La cantidad del servicio debe ser mayor a cero.";
                return;
            }

            var listaActual = ServiciosEnSubcategoria;
            var servicio = !string.IsNullOrWhiteSpace(_codigoServicioSeleccionado)
                ? listaActual.FirstOrDefault(s => s.Codigo == _codigoServicioSeleccionado)
                : listaActual.FirstOrDefault(s => string.Equals(s.Descripcion.Trim(), _filtroServicio.Trim(), StringComparison.OrdinalIgnoreCase));

            if (servicio is null)
            {
                _errorServicio = true;
                _mensajeServicio = $"Seleccione un servicio válido del catálogo de {_categoriaServicio}.";
                return;
            }

            string obs = string.IsNullOrWhiteSpace(_observacionServicio) ? servicio.Descripcion : _observacionServicio.Trim();

            switch (_categoriaServicio)
            {
                case "Laboratorio":
                    if (!await LabImagenService.AgregarOrdenLaboratorioAsync(new OrdenLaboratorioItemDto
                    {
                        IdOrden = IdOrden,
                        Nhcl = Nhcl,
                        CodigoProd = servicio.Codigo,
                        DescripcionExamen = servicio.Descripcion,
                        Observaciones = obs,
                        Cantidad = (int)Math.Max(1, Math.Round(_cantidadServicio)),
                        Prioridad = _prioridadServicio,
                        Estado = "POR REALIZAR",
                        Fecha = DateTime.Now,
                        Precio = servicio.Precio
                    }))
                        throw new InvalidOperationException("El servicio no se guardó.");
                    _ordenesLab = await LabImagenService.ObtenerOrdenesLaboratorioAsync(IdOrden, Nhcl);
                    break;

                case "Imagenología":
                    if (!await LabImagenService.AgregarOrdenImagenAsync(new OrdenImagenItemDto
                    {
                        IdOrden = IdOrden,
                        Nhcl = Nhcl,
                        CodigoProd = servicio.Codigo,
                        DescripcionEstudio = servicio.Descripcion,
                        Observaciones = obs,
                        Cantidad = (int)Math.Max(1, Math.Round(_cantidadServicio)),
                        Estado = "Por Facturar",
                        Fecha = DateTime.Now,
                        Precio = servicio.Precio
                    }))
                        throw new InvalidOperationException("El servicio no se guardó.");
                    _ordenesImagen = await LabImagenService.ObtenerOrdenesImagenAsync(IdOrden, Nhcl);
                    break;

                case "Procedimientos":
                    if (!int.TryParse(servicio.Codigo, out int idProcedimiento) ||
                        !await AdmisionService.AgregarProcedimientoTriajeAsync(IdOrden, Nhcl,
                            idProcedimiento, (int)Math.Max(1, Math.Round(_cantidadServicio)),
                            _observacionServicio.Trim(), desdeHistorial: false, desdeSoap: true))
                        throw new InvalidOperationException("El procedimiento no se guardó.");
                    _versionProcedimientos++;
                    break;

                case "Fisioterapia":
                    if (!int.TryParse(servicio.Codigo, out int idProdFisio) || idProdFisio <= 0)
                    {
                        _errorServicio = true;
                        _mensajeServicio = "No se pudo identificar el código de producto de fisioterapia.";
                        return;
                    }
                    if (!await AdminClinicaService.GuardarFisioterapiaAsync(new FisioterapiaOrdenDto
                    {
                        IdOrden = IdOrden,
                        Nhcl = Nhcl,
                        IdProducto = idProdFisio,
                        Descripcion = servicio.Descripcion,
                        Observaciones = obs,
                        Cantidad = _cantidadServicio,
                        Precio = servicio.Precio,
                        Fecha = DateTime.Now
                    }))
                        throw new InvalidOperationException("El servicio no se guardó.");
                    _ordenesFisio = await AdminClinicaService.ObtenerFisioterapiaAsync(IdOrden, Nhcl);
                    break;
            }

            _codigoServicioSeleccionado = string.Empty;
            _filtroServicio = string.Empty;
            _observacionServicio = string.Empty;
            _cantidadServicio = 1;
            _mostrarSugerenciasServicio = false;
            FiltrarServiciosCategoria();

            _errorServicio = false;
            _mensajeServicio = $"Servicio de {_categoriaServicio} agregado a la orden #{IdOrden}.";
            await OnOrdenesActualizadas.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al agregar servicio a la orden {Orden}", IdOrden);
            _errorServicio = true;
            _mensajeServicio = "No se pudo completar el registro del servicio.";
        }
        finally
        {
            _agregandoServicio = false;
        }
    }

    private async Task EliminarServicioPorCategoriaAsync(string categoria, int sec)
    {
        switch (categoria)
        {
            case "Laboratorio":
                await LabImagenService.EliminarOrdenLaboratorioAsync(sec);
                _ordenesLab = await LabImagenService.ObtenerOrdenesLaboratorioAsync(IdOrden, Nhcl);
                break;
            case "Imagenología":
                await LabImagenService.EliminarOrdenImagenAsync(sec);
                _ordenesImagen = await LabImagenService.ObtenerOrdenesImagenAsync(IdOrden, Nhcl);
                break;
            case "Fisioterapia":
                await AdminClinicaService.EliminarFisioterapiaAsync(sec);
                _ordenesFisio = await AdminClinicaService.ObtenerFisioterapiaAsync(IdOrden, Nhcl);
                break;
        }
        await OnOrdenesActualizadas.InvokeAsync();
    }

    private async Task ImprimirRecetaMedicaPdfAsync()
    {
        if (Paciente is null || Paciente.Nhcl <= 0) return;
        var paraImprimir = _medicinasTrabajo.Select(x => x.Item).ToList();
        if (paraImprimir.Count == 0) paraImprimir = _aplicadosItems;
        if (!paraImprimir.Any())
        {
            _esError = true;
            _mensaje = "Agregue al menos un medicamento antes de imprimir la receta médica.";
            return;
        }
        var pdfBytes = ReportService.GenerarRecetaMedicaPdf(Paciente, paraImprimir, _diagnosticos, _indicacionesGeneralesReceta);
        await JS.InvokeVoidAsync("descargarArchivoBase64", $"Receta_Medica_Orden_{IdOrden}.pdf", "application/pdf", Convert.ToBase64String(pdfBytes));
    }

