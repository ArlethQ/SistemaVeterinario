    private async Task AgregarAplicadoConsultaAsync()
    {
        if (IdOrden <= 0 || Nhcl <= 0) return;

        if (_productoAplicadoSeleccionado is null)
        {
            var texto = (_filtroAplicado ?? string.Empty).Trim();
            _productoAplicadoSeleccionado = _stockAplicadoSede.FirstOrDefault(p =>
                string.Equals(p.NombreProducto.Trim(), texto, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(p.CodigoPrincipal.Trim(), texto, StringComparison.OrdinalIgnoreCase) ||
                p.CodigoProducto.ToString() == texto);
        }

        if (_productoAplicadoSeleccionado is null)
        {
            _esError = true;
            _mensaje = "Selecciona un producto con stock disponible en la sucursal actual.";
            return;
        }

        if (_cantidadAplicado <= 0)
        {
            _esError = true;
            _mensaje = "La cantidad aplicada debe ser mayor a cero.";
            return;
        }

        decimal cantidadBase = CantidadBaseAplicadoCalculada;
        if (_productoAplicadoSeleccionado.ControlaInventario && cantidadBase > _productoAplicadoSeleccionado.StockLibre)
        {
            _esError = true;
            _mensaje = $"Stock insuficiente: disponible {_productoAplicadoSeleccionado.StockLibre:0.##} {_productoAplicadoSeleccionado.UnidadMedida}.";
            return;
        }

        var nuevoAplicado = new RecetaMedicamentoItemDto
        {
            IdOrden = IdOrden,
            Nhcl = Nhcl,
            CodigoProd = _productoAplicadoSeleccionado.CodigoProducto.ToString(),
            Descripcionamento = _productoAplicadoSeleccionado.NombreProducto,
            Cantidad = cantidadBase,
            CantidadLetras = $"{cantidadBase:0.##} {UnidadProductoAplicado}",
            Indicaciones = string.IsNullOrWhiteSpace(_indicacionAplicado) ? "Aplicado en evolución" : _indicacionAplicado.Trim(),
            Tipo = "C"
        };

        int idUser = Session.CurrentUser?.UserNumero ?? 1;
        var res = await ConsultaService.AgregarAplicadoConsultaAsync(nuevoAplicado, idUser, Session.Localidad);
        _esError = !res.Exito;
        _mensaje = res.Mensaje;
        if (res.Exito)
        {
            LimpiarProductoAplicado();
            _aplicadosItems = await ConsultaService.ObtenerAplicadosConsultaOrdenAsync(IdOrden);
            await RecargarStockAplicadoSedeAsync();
            await OnOrdenesActualizadas.InvokeAsync();
        }
    }

