@code {
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }
    [Parameter] public PacienteHeaderDto? Paciente { get; set; }
    [Parameter] public EventCallback OnOrdenesActualizadas { get; set; }

    private sealed class MedicinaTrabajoRow
    {
        public Guid IdTemp { get; } = Guid.NewGuid();
        public string Origen { get; set; } = "NUEVO"; // ANAMNESIS, EVOLUCION_ANT, NUEVO
        public RecetaMedicamentoItemDto Item { get; set; } = new();
    }

    private int _ordenCargada;
    private int _nhclCargado;
    private string? _mensaje;
    private bool _esError;

    // Switch de carga desde Anamnesis / SOAP (activado por defecto)
    private bool _cargarDatosAnamnesis = true;
    private bool _cargandoEvolucionAnterior;

    private List<DiagnosticoCie10Dto> _diagnosticos = [];
    private List<RecetaMedicamentoItemDto> _recetaSoapPendiente = [];
    private List<MedicinaTrabajoRow> _medicinasTrabajo = [];

    private List<RecetaMedicamentoItemDto> _aplicadosItems = [];
    private HashSet<int> _aplicadosAnamnesisSecs = [];
    private List<OrdenLaboratorioItemDto> _ordenesLab = [];
    private HashSet<int> _labAnamnesisSecs = [];
    private List<OrdenImagenItemDto> _ordenesImagen = [];
    private HashSet<int> _imagenAnamnesisSecs = [];
    private List<FisioterapiaOrdenDto> _ordenesFisio = [];
    private HashSet<int> _fisioAnamnesisSecs = [];

    private List<RecetaMedicamentoItemDto> AplicadosVisibles =>
        _cargarDatosAnamnesis ? _aplicadosItems : _aplicadosItems.Where(x => !_aplicadosAnamnesisSecs.Contains(x.Sec)).ToList();
    private List<OrdenLaboratorioItemDto> OrdenesLabVisibles =>
        _cargarDatosAnamnesis ? _ordenesLab : _ordenesLab.Where(x => !_labAnamnesisSecs.Contains(x.Sec)).ToList();
    private List<OrdenImagenItemDto> OrdenesImagenVisibles =>
        _cargarDatosAnamnesis ? _ordenesImagen : _ordenesImagen.Where(x => !_imagenAnamnesisSecs.Contains(x.Sec)).ToList();
    private List<FisioterapiaOrdenDto> OrdenesFisioVisibles =>
        _cargarDatosAnamnesis ? _ordenesFisio : _ordenesFisio.Where(x => !_fisioAnamnesisSecs.Contains(x.Sec)).ToList();

    public bool HayReservasSoapPendientes => _recetaSoapPendiente.Count > 0;
    public List<RecetaMedicamentoItemDto> ObtenerMedicinasParaConfirmar() =>
        _medicinasTrabajo.Where(x => x.Item.Cantidad > 0 && !string.IsNullOrWhiteSpace(x.Item.Descripcionamento))
            .Select(x => x.Item)
            .ToList();

    private List<CatalogoOperativoDto> _catalogoMedicamentos = [];
    private List<CatalogoOperativoDto> _sugerenciasMedicamento = [];
    private bool _mostrarSugerenciasMed;
    private CatalogoOperativoDto? _productoRecetaSeleccionado;
    private string _modoDespachoReceta = "UNIDAD";
    private string _indicacionesGeneralesReceta = string.Empty;
    private string _indicacionesGeneralesAnamnesis = string.Empty;
    private RecetaMedicamentoItemDto _nuevoMedicamento = new() { Cantidad = 1 };

    private string UnidadProductoReceta => string.IsNullOrWhiteSpace(_productoRecetaSeleccionado?.UnidadMedida)
        ? "UNIDAD"
        : _productoRecetaSeleccionado!.UnidadMedida.Trim().ToUpperInvariant();
    private decimal FactorProductoReceta => _productoRecetaSeleccionado is { FactorConversion: > 1m } p ? p.FactorConversion : 1m;
    private decimal CantidadBaseRecetaCalculada => _modoDespachoReceta == "PAQUETE" && FactorProductoReceta > 1m
        ? Math.Round(_nuevoMedicamento.Cantidad * FactorProductoReceta, 4)
        : _nuevoMedicamento.Cantidad;

    private List<FarmaciaStockSedeItemDto> _stockAplicadoSede = [];
    private List<FarmaciaStockSedeItemDto> _sugerenciasAplicado = [];
    private bool _mostrarSugerenciasAplicado;
    private FarmaciaStockSedeItemDto? _productoAplicadoSeleccionado;
    private string _filtroAplicado = string.Empty;
    private string _modoAplicado = "UNIDAD";
    private decimal _cantidadAplicado = 1m;
    private string _indicacionAplicado = string.Empty;

    private string UnidadProductoAplicado => string.IsNullOrWhiteSpace(_productoAplicadoSeleccionado?.UnidadMedida)
        ? "UNIDAD"
        : _productoAplicadoSeleccionado!.UnidadMedida.Trim().ToUpperInvariant();
    private decimal FactorProductoAplicado => _productoAplicadoSeleccionado is { FactorConversion: > 1m } p ? p.FactorConversion : 1m;
    private decimal CantidadBaseAplicadoCalculada => _modoAplicado == "PAQUETE" && FactorProductoAplicado > 1m
        ? Math.Round(_cantidadAplicado * FactorProductoAplicado, 4)
        : _cantidadAplicado;

    private sealed record ServicioCatalogoItem(string Codigo, string Descripcion, decimal Precio, string? CodigoBusqueda = null, int IdSubcategoria = 0, string? Subcategoria = null);
    private int _versionProcedimientos;
    private int _subcategoriaProcedimiento;
    private string _categoriaServicio = "Laboratorio";
    private readonly Dictionary<string, List<ServicioCatalogoItem>> _cacheServiciosPorCategoria = new();
    private List<ServicioCatalogoItem> _serviciosFiltrados = [];
    private string _filtroServicio = string.Empty;
    private string _codigoServicioSeleccionado = string.Empty;
    private bool _mostrarSugerenciasServicio;
    private decimal _cantidadServicio = 1;
    private string _prioridadServicio = "Rutina";
    private string _observacionServicio = string.Empty;
    private bool _agregandoServicio;
    private bool _errorServicio;
    private string? _mensajeServicio;

    private List<ServicioCatalogoItem> ServiciosCategoria =>
        _cacheServiciosPorCategoria.TryGetValue(_categoriaServicio, out var lista) ? lista : [];
    private IEnumerable<ServicioCatalogoItem> SubcategoriasProcedimientos =>
        ServiciosCategoria.Where(s => s.IdSubcategoria > 0 && !string.IsNullOrWhiteSpace(s.Subcategoria))
            .DistinctBy(s => s.IdSubcategoria).OrderBy(s => s.Subcategoria);
    private IEnumerable<ServicioCatalogoItem> ServiciosEnSubcategoria =>
        _categoriaServicio == "Procedimientos" && _subcategoriaProcedimiento > 0
            ? ServiciosCategoria.Where(s => s.IdSubcategoria == _subcategoriaProcedimiento)
            : ServiciosCategoria;

    protected override async Task OnParametersSetAsync()
    {
        if (IdOrden <= 0 || Nhcl <= 0)
            return;

        if (_ordenCargada == IdOrden && _nhclCargado == Nhcl)
            return;

        _ordenCargada = IdOrden;
        _nhclCargado = Nhcl;
        _cargarDatosAnamnesis = true;
        _cacheServiciosPorCategoria.Remove("Procedimientos");
        _subcategoriaProcedimiento = 0;
        ActualizarCantidadLetras();
        await CargarTodoAsync(esCargaInicial: true);
    }

    public async Task RefrescarAsync()
    {
        _medicinasTrabajo.Clear();
        await CargarTodoAsync(esCargaInicial: true);
        StateHasChanged();
    }

    private async Task CargarTodoAsync(bool esCargaInicial = false)
    {
        try
        {
            var tFicha = ConsultaService.ObtenerFichaMedicaAsync(IdOrden, Nhcl);
            var tDiag = ConsultaService.ObtenerDiagnosticosOrdenAsync(IdOrden);
            var tRecPend = ConsultaService.ObtenerRecetaPendienteOrdenAsync(IdOrden);
            var tApl = ConsultaService.ObtenerAplicadosConsultaOrdenAsync(IdOrden);
            var tLab = LabImagenService.ObtenerOrdenesLaboratorioAsync(IdOrden, Nhcl);
            var tImg = LabImagenService.ObtenerOrdenesImagenAsync(IdOrden, Nhcl);
            var tFisio = AdminClinicaService.ObtenerFisioterapiaAsync(IdOrden, Nhcl);

            await Task.WhenAll(tFicha, tDiag, tRecPend, tApl, tLab, tImg, tFisio);

            var ficha = await tFicha;
            _indicacionesGeneralesAnamnesis = ficha.IndicacionesGeneralesReceta ?? string.Empty;
            _indicacionesGeneralesReceta = _cargarDatosAnamnesis ? _indicacionesGeneralesAnamnesis : string.Empty;
            _diagnosticos = await tDiag;
            _recetaSoapPendiente = await tRecPend;
            _aplicadosItems = await tApl;
            _ordenesLab = await tLab;
            _ordenesImagen = await tImg;
            _ordenesFisio = await tFisio;

            if (esCargaInicial)
            {
                _aplicadosAnamnesisSecs = _aplicadosItems.Select(x => x.Sec).ToHashSet();
                _labAnamnesisSecs = _ordenesLab.Select(x => x.Sec).ToHashSet();
                _imagenAnamnesisSecs = _ordenesImagen.Select(x => x.Sec).ToHashSet();
                _fisioAnamnesisSecs = _ordenesFisio.Select(x => x.Sec).ToHashSet();
                ReconstruirMedicinasDesdeAnamnesis();
            }

            if (_catalogoMedicamentos.Count == 0)
            {
                var prods = await EFactCatalog.ObtenerProductosAsync();
                _catalogoMedicamentos = prods.Where(p => p.Estado == "A" && !p.EsServicio).ToList();
            }
            if (_stockAplicadoSede.Count == 0)
            {
                await RecargarStockAplicadoSedeAsync();
            }
            await CargarCatalogoServicioCategoriaAsync(_categoriaServicio);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error cargando órdenes clínicas en evolución médica para Orden {Orden}", IdOrden);
        }
    }

    private void ReconstruirMedicinasDesdeAnamnesis()
    {
        _medicinasTrabajo.RemoveAll(x => x.Origen == "ANAMNESIS");
        if (_cargarDatosAnamnesis && _recetaSoapPendiente.Count > 0)
        {
            var precargadas = _recetaSoapPendiente.Select(m => new MedicinaTrabajoRow
            {
                Origen = "ANAMNESIS",
                Item = new RecetaMedicamentoItemDto
                {
                    Sec = m.Sec,
                    IdOrden = IdOrden,
                    Nhcl = Nhcl,
                    CodigoProd = m.CodigoProd,
                    Descripcionamento = m.Descripcionamento,
                    Cantidad = m.Cantidad,
                    CantidadLetras = m.CantidadLetras,
                    Indicaciones = m.Indicaciones,
                    Tipo = m.Tipo
                }
            }).ToList();
            _medicinasTrabajo.InsertRange(0, precargadas);
        }
    }

    private void OnToggleCargarAnamnesis(ChangeEventArgs e)
    {
        _cargarDatosAnamnesis = e.Value is bool b && b;
        _indicacionesGeneralesReceta = _cargarDatosAnamnesis ? _indicacionesGeneralesAnamnesis : string.Empty;
        ReconstruirMedicinasDesdeAnamnesis();
    }

    private async Task CargarDeEvolucionAnteriorAsync()
    {
        if (_cargandoEvolucionAnterior || Nhcl <= 0) return;
        _cargandoEvolucionAnterior = true;
        _mensaje = null;
        try
        {
            var anteriores = await ConsultaService.ObtenerMedicinasUltimaEvolucionAsync(Nhcl, IdOrden);
            if (anteriores.Count == 0)
            {
                _esError = false;
                _mensaje = "No hay medicinas registradas en una evolución médica anterior para este paciente.";
                return;
            }

            _medicinasTrabajo.RemoveAll(x => x.Origen == "EVOLUCION_ANT");
            foreach (var m in anteriores)
            {
                _medicinasTrabajo.Add(new MedicinaTrabajoRow
                {
                    Origen = "EVOLUCION_ANT",
                    Item = new RecetaMedicamentoItemDto
                    {
                        IdOrden = IdOrden,
                        Nhcl = Nhcl,
                        CodigoProd = m.CodigoProd,
                        Descripcionamento = m.Descripcionamento,
                        Cantidad = m.Cantidad,
                        CantidadLetras = m.CantidadLetras,
                        Indicaciones = m.Indicaciones,
                        Tipo = "M"
                    }
                });
            }

            _esError = false;
            _mensaje = $"Se cargaron {anteriores.Count} medicamento(s) de la evolución médica anterior. Revisa o ajusta y presiona Registrar Nota de Evolución.";
        }
        catch (Exception ex)
        {
            _esError = true;
            _mensaje = $"No se pudo cargar la evolución anterior: {ex.Message}";
        }
        finally
        {
            _cargandoEvolucionAnterior = false;
        }
    }

    private async Task RecargarStockAplicadoSedeAsync()
    {
        try
        {
            int sede = Session.Localidad > 0 ? Session.Localidad : 1;
            _stockAplicadoSede = (await FarmaciaService.ObtenerStockSedeDetalladoAsync(sede, incluirSinInventario: true))
                .Where(x => !x.ControlaInventario || x.StockLibre > 0)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo cargar el stock disponible de la sucursal.");
        }
    }

    private void OnMedicamentoFocus()
    {
        ActualizarSugerenciasMedicamento();
        _mostrarSugerenciasMed = _sugerenciasMedicamento.Any();
    }

    private void OnMedicamentoInputChanged()
    {
        _nuevoMedicamento.CodigoProd = string.Empty;
        _productoRecetaSeleccionado = null;
        ActualizarSugerenciasMedicamento();
        _mostrarSugerenciasMed = _sugerenciasMedicamento.Any();
        ActualizarCantidadLetras();
    }

    private void ActualizarSugerenciasMedicamento()
    {
        var texto = _nuevoMedicamento.Descripcionamento?.Trim() ?? string.Empty;
        _sugerenciasMedicamento = string.IsNullOrWhiteSpace(texto)
            ? _catalogoMedicamentos.Take(15).ToList()
            : _catalogoMedicamentos
                .Where(p => p.Descripcion.Contains(texto, StringComparison.OrdinalIgnoreCase)
                         || p.Codigo.Contains(texto, StringComparison.OrdinalIgnoreCase)
                         || p.Id.ToString().Contains(texto, StringComparison.OrdinalIgnoreCase))
                .Take(20)
                .ToList();
    }

    private void SeleccionarMedicamento(CatalogoOperativoDto prod)
    {
        _productoRecetaSeleccionado = prod;
        _modoDespachoReceta = "UNIDAD";
        _nuevoMedicamento.CodigoProd = prod.Id.ToString();
        _nuevoMedicamento.Descripcionamento = prod.Descripcion;
        _nuevoMedicamento.Precio = prod.Precio ?? 0m;
        _mostrarSugerenciasMed = false;
        ActualizarCantidadLetras();
    }

    private void LimpiarSeleccionMedicamento()
    {
        _productoRecetaSeleccionado = null;
        _modoDespachoReceta = "UNIDAD";
        _nuevoMedicamento.CodigoProd = string.Empty;
        _nuevoMedicamento.Descripcionamento = string.Empty;
        _nuevoMedicamento.Precio = 0m;
        _sugerenciasMedicamento.Clear();
        _mostrarSugerenciasMed = false;
        ActualizarCantidadLetras();
    }

    private void ActualizarCantidadLetras()
    {
        int n = Math.Max(1, (int)Math.Round(_nuevoMedicamento.Cantidad));
        _nuevoMedicamento.CantidadLetras = FichaMedica.FormatearCantidadEnLetras(n, _modoDespachoReceta, UnidadProductoReceta, FactorProductoReceta);
    }

    private Task AgregarMedicamentoTrabajo()
    {
        if (IdOrden <= 0 || Nhcl <= 0) return Task.CompletedTask;
        if (_nuevoMedicamento.Cantidad <= 0)
        {
            _esError = true;
            _mensaje = "La cantidad del medicamento debe ser mayor a cero.";
            return Task.CompletedTask;
        }
        if (string.IsNullOrWhiteSpace(_nuevoMedicamento.Descripcionamento) || string.IsNullOrWhiteSpace(_nuevoMedicamento.Indicaciones))
        {
            _esError = true;
            _mensaje = "Ingrese el medicamento y sus indicaciones posológicas.";
            return Task.CompletedTask;
        }

        if (string.IsNullOrWhiteSpace(_nuevoMedicamento.CodigoProd))
        {
            var exacto = _catalogoMedicamentos.FirstOrDefault(p =>
                string.Equals(p.Descripcion.Trim(), _nuevoMedicamento.Descripcionamento.Trim(), StringComparison.OrdinalIgnoreCase)
                || string.Equals(p.Codigo, _nuevoMedicamento.Descripcionamento.Trim(), StringComparison.OrdinalIgnoreCase)
                || p.Id.ToString() == _nuevoMedicamento.Descripcionamento.Trim());
            if (exacto != null)
            {
                _productoRecetaSeleccionado = exacto;
                _nuevoMedicamento.CodigoProd = exacto.Id.ToString();
                _nuevoMedicamento.Descripcionamento = exacto.Descripcion;
            }
        }

        if (string.IsNullOrWhiteSpace(_nuevoMedicamento.CantidadLetras) || int.TryParse(_nuevoMedicamento.CantidadLetras.Trim(), out _))
            ActualizarCantidadLetras();

        _medicinasTrabajo.Add(new MedicinaTrabajoRow
        {
            Origen = "NUEVO",
            Item = new RecetaMedicamentoItemDto
            {
                IdOrden = IdOrden,
                Nhcl = Nhcl,
                CodigoProd = _nuevoMedicamento.CodigoProd,
                Descripcionamento = _nuevoMedicamento.Descripcionamento.Trim(),
                Cantidad = CantidadBaseRecetaCalculada,
                CantidadLetras = _nuevoMedicamento.CantidadLetras,
                Indicaciones = _nuevoMedicamento.Indicaciones.Trim(),
                Tipo = "M"
            }
        });

        _nuevoMedicamento = new RecetaMedicamentoItemDto { Cantidad = 1 };
        _productoRecetaSeleccionado = null;
        _modoDespachoReceta = "UNIDAD";
        ActualizarCantidadLetras();
        _mostrarSugerenciasMed = false;
        _esError = false;
        _mensaje = "Medicamento agregado a la lista. Presiona Registrar Nota de Evolución para descargarlo del inventario y enviarlo a factura.";
        return Task.CompletedTask;
    }

    private void QuitarMedicinaTrabajo(Guid idTemp)
    {
        _medicinasTrabajo.RemoveAll(x => x.IdTemp == idTemp);
    }

