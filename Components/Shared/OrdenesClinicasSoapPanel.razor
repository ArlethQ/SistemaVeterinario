    private void FiltrarSugerenciasAplicado()
    {
        var texto = (_filtroAplicado ?? string.Empty).Trim();
        _sugerenciasAplicado = string.IsNullOrWhiteSpace(texto)
            ? _stockAplicadoSede.Take(15).ToList()
            : _stockAplicadoSede
                .Where(p => p.NombreProducto.Contains(texto, StringComparison.OrdinalIgnoreCase)
                         || p.CodigoPrincipal.Contains(texto, StringComparison.OrdinalIgnoreCase)
