@inject IAdmisionFacturacionService AdmisionService
@inject ILogger<HistorialOrdenesSoap> Logger

<section class="card shadow-sm border-0 mb-3 p-3">
    @if (_ocupado)
    {
        <p class="text-muted mt-2 mb-0" role="status">Cargando...</p>
    }

    else if (NhclHistorial <= 0)
    {
        <p class="text-muted mb-0">Selecciona una mascota para consultar sus órdenes.</p>
    }
    else
    {
        <h5 class="mt-3">Historial de órdenes de @(_mascota?.Descripcion ?? NombreActual)</h5>
        @if (_mascota != null && NhclActual > 0)
        {
            <button type="button" class="btn btn-sm btn-outline-primary align-self-start mb-2" disabled="@_ocupado"
                    @onclick="() => _mascota = null">Ver mascota de la ficha SOAP</button>
        }
        <div class="btn-group align-self-start mb-2" role="group" aria-label="Período de las órdenes">
            <button type="button" class="btn btn-sm btn-outline-primary @(!_antiguas ? "active" : null)"
                    aria-pressed="@(!_antiguas)" @onclick="() => _antiguas = false">Nuevas (desde hoy)</button>
            <button type="button" class="btn btn-sm btn-outline-primary @(_antiguas ? "active" : null)"
                    aria-pressed="@_antiguas" @onclick="() => _antiguas = true">Antiguas</button>
        </div>

        @if (ErrorHistorial)
        {
            <p class="text-danger mt-2 mb-0">No se pudo cargar el historial de órdenes.</p>
        }
        else if (!OrdenesVisibles.Any())
        {
            <p class="text-muted mt-2 mb-0">No hay órdenes en este período.</p>
        }
        else
        {
            <div class="table-responsive mt-2">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Orden</th><th>Fecha</th><th>Especialidad</th><th>Médico</th><th>Estado</th><th>Ficha SOAP</th></tr></thead>
                    <tbody>
                        @foreach (var orden in OrdenesVisibles)
                        {
                            var estadoOrd = OrdenActualCerrada && orden.IdOrden == OrdenActual ? "T" : orden.Estado.Trim();
                            <tr @key="orden.IdOrden" class="@(orden.IdOrden == OrdenActual ? "table-active" : null)">
                                <td>#@orden.IdOrden</td>
                                <td>@orden.Fecha.ToString("dd/MM/yyyy") @orden.Hora</td>
                                <td>@orden.Especialidad</td>
                                <td>@orden.Medico</td>
                                <td>
                                    @if (estadoOrd == "T")
                                    {
                                        <span class="badge bg-success">Finalizada</span>
                                    }
                                    else if (estadoOrd == "E")
                                    {
                                        <span class="badge bg-primary">En atención</span>
                                    }
                                    else if (estadoOrd == "I")
                                    {
                                        <span class="badge bg-secondary">Anulada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">En espera</span>
                                    }
                                </td>
                                <td>
                                    @if (estadoOrd == "I")
                                    {
                                        <span class="text-muted">Anulada</span>
                                    }
                                    else if (orden.IdOrden == OrdenActual)
                                    {
                                        <span class="text-muted">@(OrdenActualCerrada ? "Guardada" : "Abierta")</span>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="/consulta/fichamedica/@orden.IdOrden/@NhclHistorial" target="_blank" rel="noopener">Abrir en otra pestaña</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@code {
    [Parameter] public int NhclActual { get; set; }
    [Parameter] public string? NombreActual { get; set; }
    [Parameter] public int OrdenActual { get; set; }
    [Parameter] public bool OrdenActualCerrada { get; set; }
    [Parameter] public IReadOnlyList<OrdenPacienteResumenDto> OrdenesActuales { get; set; } = [];
    [Parameter] public bool ErrorActual { get; set; }

    private SelectorClinicoDto? _mascota;
    private List<OrdenPacienteResumenDto> _ordenes = [];
    private bool _antiguas;
    private bool _ocupado;
    private int _versionCarga;
    private bool _errorOrdenes;

    private int NhclHistorial => _mascota?.Id ?? NhclActual;
    private bool ErrorHistorial => _mascota == null ? ErrorActual : _errorOrdenes;

    private IEnumerable<OrdenPacienteResumenDto> OrdenesVisibles
    {
        get
        {
            var hoy = DateTime.Today;
            return (_mascota == null ? OrdenesActuales : _ordenes)
                .Where(orden => (orden.Fecha.Date < hoy) == _antiguas);
        }
    }

    public async Task VerOrdenesAsync(SelectorClinicoDto mascota)
    {
        var version = ++_versionCarga;
        _ocupado = true;
        _errorOrdenes = false;
        StateHasChanged();
        try
        {
            var ordenes = await AdmisionService.ObtenerOrdenesPacienteAsync(mascota.Id);
            if (version == _versionCarga)
                _ordenes = ordenes;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error al cargar las órdenes de la mascota {Nhcl}", mascota.Id);
            if (version != _versionCarga)
                return;

            _ordenes = [];
            _errorOrdenes = true;
        }
        finally
        {
            if (version == _versionCarga)
            {
                _mascota = mascota;
                _antiguas = _ordenes.Count > 0 && _ordenes.All(orden => orden.Fecha.Date < DateTime.Today);
                _ocupado = false;
                StateHasChanged();
            }
        }
    }
}
