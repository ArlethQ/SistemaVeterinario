                                                            <td>@s.PresionMedia</td>
                                                            <td>@s.Respiracion</td>
                                                            <td>@s.Temperatura.ToString("0.0")</td>
                                                            <td>@s.Oxigeno.ToString("0.#")</td>
                                                            <td>@s.Saturacion%</td>
                                                            <td class="text-muted small">@s.NombreUsuario</td>
