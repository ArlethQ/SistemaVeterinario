    private static bool EsMotivoTriaje(string? motivo) =>
        string.Equals((motivo ?? string.Empty).Trim(), "Triaje y signos vitales", StringComparison.OrdinalIgnoreCase);

    private bool EsFichaSoloTriaje(FichaMedicaCompletaDto? fm) =>
        fm is not null && fm.Sec > 0
        && EsMotivoTriaje(fm.MedMotivo)
        && !TieneDatosHospitalizacionCargados
        && fm.RequiereCirugia != "S"
        && !fm.RequiereHospitalizacion
        && _diagnosticos.Count == 0
        && string.IsNullOrWhiteSpace(fm.MedAnamnesis)
        && string.IsNullOrWhiteSpace(fm.MedObjetivo)
        && string.IsNullOrWhiteSpace(fm.MedAnalisis)
        && string.IsNullOrWhiteSpace(fm.MedPlan)
        && string.IsNullOrWhiteSpace(fm.Tratamiento)
        && string.IsNullOrWhiteSpace(fm.ObservacionesYRecomendaciones)
        && string.IsNullOrWhiteSpace(fm.MedApuntes);

    // Si hay ficha médica y es hospitalización (o tiene datos de SOAP), siempre se muestra como Historia SOAP
    private bool TieneSoapReal =>
        (_ordenActiva?.TieneSoap == true)
        || (_fichaMedica is not null && _fichaMedica.Sec > 0 && (!EsFichaSoloTriaje(_fichaMedica) || TieneDatosHospitalizacionCargados));

    private (string Fuente, List<SignoVitalTile> Items) ObtenerSignosVitalesConsolidados()
    {
        var items = new List<SignoVitalTile>();

        // 1. Fuente principal: Ficha Médica / Triaje (vt_fichamedica)
        if (_fichaMedica is not null && _fichaMedica.Sec > 0)
        {
            var fm = _fichaMedica;
            if (fm.Peso > 0) items.Add(new("Peso", fm.Peso.ToString("0.##"), "kg"));
            if (fm.Temperatura > 0) items.Add(new("Temperatura", fm.Temperatura.ToString("0.0"), "°C"));
            if (fm.FrecuenciaCardiaca > 0) items.Add(new("Frec. Cardíaca", fm.FrecuenciaCardiaca.ToString("0"), "lpm"));
            if (fm.FrecuenciaRespiratoria > 0) items.Add(new("Frec. Respiratoria", fm.FrecuenciaRespiratoria.ToString("0"), "rpm"));
            if (fm.TiempoLlenadoCapilar > 0) items.Add(new("TLLC", fm.TiempoLlenadoCapilar.ToString(), "seg"));
            if (fm.Deshidratacion > 0) items.Add(new("Deshidratación", fm.Deshidratacion.ToString(), "%"));
            if (fm.IndiceCondicionCorporal > 0) items.Add(new("Condición Corp.", fm.IndiceCondicionCorporal.ToString(), "/ 9"));
            if (!string.IsNullOrWhiteSpace(fm.Cp)) items.Add(new("Pulso / CP", fm.Cp, "", EsTexto: true));
            if (items.Count > 0)
                return (TieneSoapReal ? "Consulta SOAP" : "Triaje de ingreso", items);
        }

        // 2. Fallback: Monitorización de Anestesia AVA (examen preanestésico)
        if (_monAnestesia is not null && _monAnestesia.Id > 0)
        {
            var ma = _monAnestesia;
            if (ma.PesoKg is > 0) items.Add(new("Peso", ma.PesoKg.Value.ToString("0.##"), "kg"));
            if (!string.IsNullOrWhiteSpace(ma.ExamenTemp)) items.Add(new("Temperatura", ma.ExamenTemp, "°C"));
            if (!string.IsNullOrWhiteSpace(ma.ExamenPulso)) items.Add(new("Pulso / FC", ma.ExamenPulso, "lpm"));
            if (!string.IsNullOrWhiteSpace(ma.ExamenResp)) items.Add(new("Frec. Resp.", ma.ExamenResp, "rpm"));
            if (ma.ExamenSistolica.HasValue || ma.ExamenDiastolica.HasValue)
                items.Add(new("Presión Art.", $"{ma.ExamenSistolica?.ToString() ?? "-"}/{ma.ExamenDiastolica?.ToString() ?? "-"}", "mmHg"));
            if (ma.ExamenSaturacion is > 0) items.Add(new("SpO2", ma.ExamenSaturacion.Value.ToString(), "%"));
            if (ma.CondicionCorporal is > 0) items.Add(new("Condición Corp.", ma.CondicionCorporal.Value.ToString(), "/ 9"));
            if (items.Count > 0)
                return ("Evaluación Preanestésica AVA", items);
        }

        // 3. Fallback: Checklist Preoperatorio
        if (_checklistPreop is not null && _checklistPreop.Id > 0)
        {
            var cp = _checklistPreop;
            if (cp.Peso > 0) items.Add(new("Peso", cp.Peso.ToString("0.##"), "kg"));
            if (cp.Pulso > 0) items.Add(new("Pulso / FC", cp.Pulso.ToString(), "lpm"));
            if (cp.PresionSistolica > 0 || cp.PresionDiastolica > 0)
                items.Add(new("Presión Art.", $"{cp.PresionSistolica}/{cp.PresionDiastolica}", "mmHg"));
            if (cp.Saturacion > 0) items.Add(new("SpO2", cp.Saturacion.ToString(), "%"));
            if (items.Count > 0)
                return ("Recepción Preoperatoria", items);
        }

        // 4. Fallback: Signos Vitales de Enfermería
        if (_signosEnf is not null)
        {
            var ultimo = _signosEnf.SignosVitales.Where(TieneValorSigno).OrderByDescending(x => x.Orden).FirstOrDefault();
            var ultPeso = _signosEnf.Mediciones.Where(m => m.Peso.HasValue).OrderByDescending(m => m.Orden).FirstOrDefault()?.Peso;
            if (ultPeso is > 0) items.Add(new("Peso", ultPeso.Value.ToString("0.##"), "kg"));
            if (ultimo?.Temperatura is > 0) items.Add(new("Temperatura", ultimo.Temperatura.Value.ToString("0.0"), "°C"));
            if (ultimo?.Pulso is > 0) items.Add(new("Pulso / FC", ultimo.Pulso.Value.ToString(), "lpm"));
            if (ultimo?.FrecuenciaRespiratoria is > 0) items.Add(new("Frec. Resp.", ultimo.FrecuenciaRespiratoria.Value.ToString(), "rpm"));
            if (ultimo?.PresionSistolica is > 0 || ultimo?.PresionDiastolica is > 0)
                items.Add(new("Presión Art.", $"{ultimo.PresionSistolica?.ToString() ?? "-"}/{ultimo.PresionDiastolica?.ToString() ?? "-"}", "mmHg"));
            if (items.Count > 0)
                return ("Signos de Enfermería", items);
        }

        // 5. Fallback: Monitoreo Hospitalario 24h
        var monUltimos = ObtenerResumenMonitoreoUltimoValor();
        if (monUltimos.Count > 0)
        {
            foreach (var m in monUltimos.Take(8))
                items.Add(new(m.Parametro, m.Valor, m.Unidad));
            return ("Monitoreo 24h", items);
        }

        // 6. Fallback: Sala de Recuperación
        var rec = _signosRecuperacion.FirstOrDefault();
        if (rec is not null)
        {
            if (rec.Temperatura > 0) items.Add(new("Temperatura", rec.Temperatura.ToString("0.0"), "°C"));
            if (rec.Pulso > 0) items.Add(new("Pulso / FC", rec.Pulso.ToString(), "lpm"));
            if (rec.Respiracion > 0) items.Add(new("Frec. Resp.", rec.Respiracion.ToString(), "rpm"));
            if (rec.Sistolica > 0 || rec.Diastolica > 0) items.Add(new("Presión Art.", $"{rec.Sistolica}/{rec.Diastolica}", "mmHg"));
            if (rec.Saturacion > 0) items.Add(new("SpO2", rec.Saturacion.ToString(), "%"));
            if (items.Count > 0)
                return ($"Sala de Recuperación ({rec.Hora})", items);
        }

        return ("", items);
    }

    private static List<HallazgoFisicoItem> ObtenerHallazgosExamenFisico(FichaMedicaCompletaDto? fm)
    {
        var lista = new List<HallazgoFisicoItem>();
        if (fm is null || fm.Sec <= 0) return lista;

        if (!string.IsNullOrWhiteSpace(fm.Mucosas)) lista.Add(new("Mucosas", fm.Mucosas));
        if (!string.IsNullOrWhiteSpace(fm.Auscultacion)) lista.Add(new("Auscultación cardiopulmonar", fm.Auscultacion));
        if (!string.IsNullOrWhiteSpace(fm.PalpacionAbdominal)) lista.Add(new("Palpación abdominal", fm.PalpacionAbdominal));
        if (!string.IsNullOrWhiteSpace(fm.Linfonodos)) lista.Add(new("Linfonodos superficiales", fm.Linfonodos));
        if (!string.IsNullOrWhiteSpace(fm.ReflejoTusigeno)) lista.Add(new("Reflejo tusígeno", fm.ReflejoTusigeno));
        if (!string.IsNullOrWhiteSpace(fm.PalpacionTiroides)) lista.Add(new("Tiroides / cuello", fm.PalpacionTiroides));
        if (!string.IsNullOrWhiteSpace(fm.PielYAnexos)) lista.Add(new("Piel, pelaje y anexos", fm.PielYAnexos));
        if (!string.IsNullOrWhiteSpace(fm.CavidadOral)) lista.Add(new("Cavidad oral", fm.CavidadOral));
        if (!string.IsNullOrWhiteSpace(fm.Otros)) lista.Add(new("Otros hallazgos del examen físico", fm.Otros, EsAncho: true));
        return lista;
    }

    private List<FarmacoAnestesiaItem> ObtenerFarmacosAnestesiaResumen()
    {
        var lista = new List<FarmacoAnestesiaItem>();
        if (_monAnestesia is not null && _monAnestesia.Id > 0)
        {
            foreach (var p in _monAnestesia.Premedicacion.Where(x => !string.IsNullOrWhiteSpace(x.Farmaco)))
                lista.Add(new("Premedicación", p.Farmaco, $"{p.Dosis} {p.Ruta} {p.Hora}".Trim()));
            foreach (var i in _monAnestesia.Induccion.Where(x => !string.IsNullOrWhiteSpace(x.Farmaco)))
                lista.Add(new("Inducción", i.Farmaco, $"{i.Dosis} {i.Ruta} {i.Hora}".Trim()));
            if (_monAnestesia.UsaAnestesiaInhalatoria && !string.IsNullOrWhiteSpace(_monAnestesia.NombreProductoAnestesia))
                lista.Add(new("Inhalatoria", _monAnestesia.NombreProductoAnestesia, ""));
            foreach (var fl in _monAnestesia.Fluidos.Where(x => !string.IsNullOrWhiteSpace(x.TipoFluido)))
                lista.Add(new("Fluido", fl.TipoFluido, string.IsNullOrWhiteSpace(fl.VelocidadMlKgH) ? "" : $"{fl.VelocidadMlKgH} ml/kg/h"));
            if (!string.IsNullOrWhiteSpace(_monAnestesia.FarmacosAntagonistas))
                lista.Add(new("Antagonistas", _monAnestesia.FarmacosAntagonistas, ""));
        }
        return lista;
    }

    private List<MonitoreoResumenItem> ObtenerResumenMonitoreoUltimoValor()
    {
        var lista = new List<MonitoreoResumenItem>();
        if (_monitoreoHosp is null) return lista;

        foreach (var fila in _monitoreoHosp.FilasMonitoreo)
        {
            string? ultimoVal = null;
            int ultimaHora = 0;
            foreach (var h in Matriz24HorasBaseDto.HorasOrden)
            {
                var v = fila.GetValorHora(h);
                if (!string.IsNullOrWhiteSpace(v))
                {
                    ultimoVal = v;
                    ultimaHora = h;
                }
            }
            if (!string.IsNullOrWhiteSpace(ultimoVal))
            {
                var nombre = fila.EsParametroPersonalizado && !string.IsNullOrWhiteSpace(fila.Item)
                    ? fila.Item
                    : fila.ParametroLabel;
                lista.Add(new(nombre, ultimoVal, fila.UnidadLabel, $"{ultimaHora:00}h"));
            }
        }
        return lista;
    }

    private static List<KeyValuePair<string, string>> FormatearParesIStat(IStatDto x)
    {
        var list = new List<KeyValuePair<string, string>>();
        void Add(string k, string? v) { if (!string.IsNullOrWhiteSpace(v)) list.Add(new(k, v.Trim())); }
        Add("pH", x.Ph); Add("pCO2", x.Pressure); Add("pO2", x.Oxygen); Add("HCO3", x.Bicarbonato);
        Add("TCO2", x.Carbon); Add("BE", x.Base); Add("sO2", x.Saturation); Add("Lactato", x.Lactato);
        Add("Na+", x.Sodio); Add("K+", x.Potasio); Add("Cl-", x.Chloride); Add("iCa", x.Ionized); Add("AnGap", x.Gap);
        Add("Hto", x.Hematocrito); Add("Hb", x.Hemoglobina); Add("Glu", x.Glucosa); Add("BUN/Urea", x.Urea); Add("Crea", x.Creatinina);
        return list;
    }

    private string ObtenerModalidadDetalle()
    {
        if (_ordenActiva is null) return "Atención clínica";
        return (TieneDatosCirugiaCargados, TieneDatosHospitalizacionCargados, TieneSoapReal, _ordenActiva.EsProcedimiento, _fichaMedica?.Sec > 0, _vacunasOrden.Count > 0) switch
        {
            (true, true, _, _, _, _) => "Cirugía + Hospitalización",
            (true, false, false, _, _, _) => "Cirugía ambulatoria",
            (true, false, true, _, _, _) => "Consulta + Cirugía",
            (false, true, _, _, _, _) => "Hospitalización",
            (false, false, true, _, _, _) => "Consulta SOAP",
            (false, false, false, true, true, _) => "Procedimiento con triaje",
            (false, false, false, true, false, _) => "Procedimiento",
            (false, false, false, false, true, _) => "Triaje / Atención directa",
            (false, false, false, false, false, true) => "Vacunación",
            _ => _ordenActiva.ModalidadAtencion
        };
    }

    private bool TieneDatosHospitalizacionCargados =>
        (_ingresoHosp is not null && _ingresoHosp.Id > 0 && (
            !string.IsNullOrWhiteSpace(_ingresoHosp.Indicaciones)
            || !string.IsNullOrWhiteSpace(_ingresoHosp.HidratacionFluidoterapia)
            || !string.IsNullOrWhiteSpace(_ingresoHosp.DietaCuidados)
            || _ordenActiva?.TieneHospitalizacion == true))
        || _kardexProductos.Count > 0
        || FichaHospTieneContenido(_fichaHosp)
        || SignosEnfTieneContenido(_signosEnf)
        || MonitoreoTieneContenido(_monitoreoHosp);

    private bool RecuperacionTieneContenido =>
        (_postOperatorio is not null && _postOperatorio.Id > 0)
        || _signosRecuperacion.Count > 0
        || _liquidosRecupIng.Count > 0
        || _liquidosRecupEgr.Count > 0
        || _obsRecuperacion.Count > 0;

    private bool TieneDatosCirugiaCargados =>
        _ordenesCirugia.Count > 0
        || _cirugiasProgramadas.Count > 0
        || (_checklistPreop is not null && _checklistPreop.Id > 0)
        || (_preAnestesia is not null && _preAnestesia.IdPreAnestesico > 0)
        || (_pausaSeguridad is not null && _pausaSeguridad.Id > 0)
        || (_monAnestesia is not null && _monAnestesia.Id > 0)
        || (_hojaAnestesia is not null && _hojaAnestesia.IdRegistro > 0)
        || (_protocolo is not null && (_protocolo.IdProtocolo > 0 || _protocolo.Equipo.Count > 0))
        || RecuperacionTieneContenido;

    private bool TieneAltaMedica =>
        _formularioAlta is not null && (
            _formularioAlta.Id > 0
            || !string.IsNullOrWhiteSpace(_formularioAlta.CuidadosGenerales)
            || !string.IsNullOrWhiteSpace(_formularioAlta.Permitido)
            || !string.IsNullOrWhiteSpace(_formularioAlta.NoPermitido)
            || !string.IsNullOrWhiteSpace(_formularioAlta.Dieta)
            || !string.IsNullOrWhiteSpace(_formularioAlta.Medicacion));

    private bool TieneAlgunContenidoResumen =>
        (_fichaMedica is not null && _fichaMedica.Sec > 0)
        || TieneSoapReal
        || _diagnosticos.Count > 0
        || _antecedentesOrden.Count > 0
        || _receta.Count > 0
        || _aplicadosConsulta.Count > 0
        || _kardexProductos.Count > 0
        || _vacunasOrden.Count > 0
        || _istatDia.Count > 0
        || !string.IsNullOrWhiteSpace(_indicacionesGenerales)
        || _procedimientos.Count > 0
        || _fisioterapias.Count > 0
        || _ordenesLab.Count > 0
        || _ordenesImagen.Count > 0
        || _informes.Count > 0
        || TieneDatosCirugiaCargados
        || TieneDatosHospitalizacionCargados
        || _evoluciones.Count > 0
        || _autorizaciones.Count > 0
        || TieneAltaMedica;

    private static bool TieneHoras(Matriz24HorasBaseDto row) =>
        Matriz24HorasBaseDto.HorasOrden.Any(h => !string.IsNullOrWhiteSpace(row.GetValorHora(h)));

    private static string FormatearResumenHoras(Matriz24HorasBaseDto row)
    {
        var pares = Matriz24HorasBaseDto.HorasOrden
            .Select(h => (Hora: h, Val: row.GetValorHora(h)))
            .Where(x => !string.IsNullOrWhiteSpace(x.Val))
            .Select(x => $"{x.Hora:00}h: {x.Val}")
            .ToList();
        return pares.Count == 0 ? "—" : string.Join(" · ", pares);
    }

    private static bool FichaHospTieneContenido(FichaHospitalizacionSheetDto? sheet)
    {
        if (sheet is null) return false;
        return sheet.Bloque1Medicacion.Any(x => !string.IsNullOrWhiteSpace(x.Medicacion) || TieneHoras(x))
            || sheet.Bloque2Alimentacion.Any(x => !string.IsNullOrWhiteSpace(x.Alimentacion) || TieneHoras(x))
            || sheet.Bloque3Fluidoterapia.Any(x => !string.IsNullOrWhiteSpace(x.Fluidoterapia) || TieneHoras(x))
            || sheet.NotasImportantes.Count > 0
            || sheet.ObservacionesGenerales.Count > 0;
    }

    private static List<int> ObtenerDiasSignosConDatos(FormularioSignosEnfermeriaDto dto)
    {
        var dias = new List<int>();
        for (int dia = 1; dia <= 9; dia++)
        {
            var f = dto.Fechas.FirstOrDefault(x => x.Orden == dia);
            var am = dto.SignosVitales.FirstOrDefault(x => x.Orden == (dia * 2) - 1);
            var pm = dto.SignosVitales.FirstOrDefault(x => x.Orden == dia * 2);
            var bal = dto.BalanceHidrico.FirstOrDefault(x => x.Orden == dia);
            var med = dto.Mediciones.FirstOrDefault(x => x.Orden == dia);

            bool hay = f?.Fecha is not null
                || TieneValorSigno(am) || TieneValorSigno(pm)
                || (bal is not null && (bal.TotalIngresos != 0 || bal.TotalEliminaciones != 0))
                || (med is not null && (med.Peso.HasValue || !string.IsNullOrWhiteSpace(med.DietaIndicada)));

            if (hay) dias.Add(dia);
        }
        return dias;
    }

    private static bool SignosEnfTieneContenido(FormularioSignosEnfermeriaDto? dto) =>
        dto is not null && ObtenerDiasSignosConDatos(dto).Count > 0;

    private static bool TieneValorSigno(SignoVitalSlotDto? s) =>
        s is not null && (s.Pulso.HasValue || s.Temperatura.HasValue || s.FrecuenciaRespiratoria.HasValue || s.PresionSistolica.HasValue || s.PresionDiastolica.HasValue);

    private static string FormatearSlotSigno(SignoVitalSlotDto? s)
    {
        if (!TieneValorSigno(s)) return "—";
        var partes = new List<string>();
        if (s!.Pulso.HasValue) partes.Add($"FC {s.Pulso}");
        if (s.Temperatura.HasValue) partes.Add($"T {s.Temperatura:0.0}°C");
        if (s.FrecuenciaRespiratoria.HasValue) partes.Add($"FR {s.FrecuenciaRespiratoria}");
        if (s.PresionSistolica.HasValue || s.PresionDiastolica.HasValue)
            partes.Add($"PA {s.PresionSistolica?.ToString() ?? "-"}/{s.PresionDiastolica?.ToString() ?? "-"}");
        return string.Join(" · ", partes);
    }

    private static bool MonitoreoTieneContenido(MonitoreoHospitalarioSheetDto? sheet)
    {
        if (sheet is null) return false;
        return sheet.FilasMonitoreo.Any(TieneHoras)
            || sheet.ObservacionesPorHora.Count > 0
            || sheet.NotasChequeoQuirurgico.Count > 0;
    }

