                                                    <span class="ho-mini-chip @(l.Tipo == "I" ? "chip-hosp" : "chip-neutral") me-1">@(l.Tipo == "I" ? "Ingreso" : "Egreso")</span>
                                                    <strong>@l.Hora</strong> · @l.Descripcion
                                                    @if (!string.IsNullOrWhiteSpace(l.Observaciones))
                                                    {
                                                        <span class="text-muted"> — @l.Observaciones</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (_obsRecuperacion.Count > 0)
                                    {
                                        <div>
                                            <div class="ho-mini-title">Observaciones de recuperación</div>
                                            @foreach (var o in _obsRecuperacion)
                                            {
                                                <div class="ho-note-line">
                                                    <strong>@o.Fecha.ToString("dd/MM") @o.Hora</strong> — @o.Observacion
                                                    <span class="text-muted small">(@o.NombreUsuario)</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_subtabActiva == "consentimientos")
                {
                    <div class="d-flex flex-column gap-3">
                        @if (_autorizaciones.Count > 0)
                        {
                            <div class="ho-section-card">
