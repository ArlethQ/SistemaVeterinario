                                        var expandido = _docsExpandidos.Contains(claveAuth);
                                        <div class="ho-doc-row">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                <div>
                                                    <div class="fw-bold text-dark small">@auth.Documento</div>
                                                    <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                                                        <span class="text-muted" style="font-size:.76rem;">@auth.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                                                        @if (!string.IsNullOrWhiteSpace(auth.NombreMedico))
                                                        {
                                                            <span class="text-muted" style="font-size:.76rem;">· @auth.NombreMedico</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(auth.ArchivoUrl))
                                                        {
                                                            <span class="ho-mini-chip chip-evol">Firmado / Escaneado</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="ho-mini-chip chip-hosp">Emitido</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="d-flex flex-wrap gap-1">
                                                    @if (!string.IsNullOrWhiteSpace(auth.ArchivoUrl))
                                                    {
                                                        <a class="btn btn-outline-success btn-sm py-0 px-2" href="@auth.ArchivoUrl" target="_blank" rel="noopener">
                                                            <i class="bi bi-file-earmark-image me-1"></i>Ver escaneo
                                                        </a>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(auth.DetalleHtml))
                                                    {
                                                        <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" @onclick="() => ToggleExpandido(_docsExpandidos, claveAuth)">
                                                            <i class="bi @(expandido ? "bi-eye-slash" : "bi-eye") me-1"></i>@(expandido ? "Ocultar" : "Vista previa")
                                                        </button>
                                                        <button type="button" class="btn btn-outline-dark btn-sm py-0 px-2" @onclick="() => ImprimirHtmlAsync(auth.Documento, auth.DetalleHtml)">
                                                            <i class="bi bi-printer me-1"></i>Imprimir
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            @if (expandido && !string.IsNullOrWhiteSpace(auth.DetalleHtml))
                                            {
                                                <div class="ho-html-preview mt-2">
                                                    @((MarkupString)auth.DetalleHtml)
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (TieneAltaMedica)
                        {
                            <div class="ho-section-card">
                                <div class="ho-section-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="ho-icon-bubble tone-evol"><i class="bi bi-box-arrow-right"></i></span>
                                        <span class="fw-bold text-dark small">Formulario de Alta Médica</span>
                                    </div>
                                    <span class="ho-mini-chip chip-evol">@_formularioAlta!.FechaIng.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="ho-section-body">
                                    <div class="ho-kv-grid">
                                        @if (!string.IsNullOrWhiteSpace(_formularioAlta.CuidadosGenerales))
                                        {
                                            <div class="ho-kv-item ho-kv-wide"><span class="ho-kv-label">Cuidados generales</span><span class="ho-kv-val ho-prose">@_formularioAlta.CuidadosGenerales</span></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_formularioAlta.Permitido))
                                        {
                                            <div class="ho-kv-item"><span class="ho-kv-label">Permitido</span><span class="ho-kv-val ho-prose">@_formularioAlta.Permitido</span></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_formularioAlta.NoPermitido))
                                        {
                                            <div class="ho-kv-item"><span class="ho-kv-label">No permitido</span><span class="ho-kv-val ho-prose">@_formularioAlta.NoPermitido</span></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_formularioAlta.Dieta))
                                        {
                                            <div class="ho-kv-item"><span class="ho-kv-label">Dieta</span><span class="ho-kv-val ho-prose">@_formularioAlta.Dieta</span></div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_formularioAlta.Medicacion))
                                        {
                                            <div class="ho-kv-item ho-kv-wide"><span class="ho-kv-label">Medicación al alta</span><span class="ho-kv-val ho-prose">@_formularioAlta.Medicacion</span></div>
                                        }
