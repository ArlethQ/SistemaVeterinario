                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var nf in _signosEnf.FormulariosDisponibles)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm py-0 px-2 @(nf == _formSignosActivo ? "btn-primary" : "btn-outline-secondary")"
                                                        @onclick="() => CambiarFormSignosAsync(nf)">
                                                    Form #@nf
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="table-responsive">
                                    <table class="ho-table">
                                        <thead>
                                            <tr>
                                                <th>Día / Fecha</th>
                                                <th>Signos AM</th>
                                                <th>Signos PM</th>
                                                <th>Balance Hídrico</th>
                                                <th>Peso / Dieta</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var dia in diasConDatos)
                                            {
                                                var f = _signosEnf.Fechas.FirstOrDefault(x => x.Orden == dia);
                                                var am = _signosEnf.SignosVitales.FirstOrDefault(x => x.Orden == (dia * 2) - 1);
                                                var pm = _signosEnf.SignosVitales.FirstOrDefault(x => x.Orden == dia * 2);
                                                var bal = _signosEnf.BalanceHidrico.FirstOrDefault(x => x.Orden == dia);
                                                var med = _signosEnf.Mediciones.FirstOrDefault(x => x.Orden == dia);
                                                <tr>
                                                    <td class="text-nowrap">
                                                        <div class="fw-semibold text-dark">Día @dia</div>
                                                        @if (f?.Fecha is not null)
                                                        {
                                                            <div class="text-muted small">@f.Fecha.Value.ToString("dd/MM/yyyy")</div>
                                                        }
                                                    </td>
                                                    <td class="small">@FormatearSlotSigno(am)</td>
                                                    <td class="small">@FormatearSlotSigno(pm)</td>
                                                    <td class="small">
                                                        @if (bal is not null && (bal.TotalIngresos != 0 || bal.TotalEliminaciones != 0))
                                                        {
                                                            <span>Ing: <strong>@bal.TotalIngresos.ToString("0.##")</strong> · Egr: <strong>@bal.TotalEliminaciones.ToString("0.##")</strong> · Neto: <strong>@bal.BalanceNeto.ToString("+0.##;-0.##;0")</strong></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">—</span>
                                                        }
                                                    </td>
                                                    <td class="small">
                                                        @(med?.Peso is not null ? $"{med.Peso:0.##} kg" : "")
                                                        @if (!string.IsNullOrWhiteSpace(med?.DietaIndicada))
                                                        {
                                                            <span class="text-muted"> · @med.DietaIndicada</span>
                                                        }
                                                        @if (med?.Peso is null && string.IsNullOrWhiteSpace(med?.DietaIndicada))
                                                        {
                                                            <span class="text-muted">—</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

