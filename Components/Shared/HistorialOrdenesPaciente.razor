                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public int Nhcl { get; set; }
    [Parameter] public int? OrdenInicial { get; set; }
    [Parameter] public EventCallback OnOrdenInicialConsumida { get; set; }

    private sealed record SignoVitalTile(string Etiqueta, string Valor, string Unidad = "", bool EsTexto = false, bool EsAncho = false);
    private sealed record HallazgoFisicoItem(string Sistema, string Hallazgo, bool EsAncho = false);
    private sealed record FarmacoAnestesiaItem(string Fase, string Nombre, string Detalle);
    private sealed record MonitoreoResumenItem(string Parametro, string Valor, string Unidad, string Hora);

    private int _nhclCargado;
    private bool _cargandoLista = true;
    private bool _cargandoDetalle;
    private string _error = string.Empty;

    private List<OrdenHistorialClinicoResumenDto> _ordenes = [];
    private string _filtroTexto = string.Empty;
    private string _filtroModulo = "todas";

    private OrdenHistorialClinicoResumenDto? _ordenActiva;
    private string _subtabActiva = "resumen";
    private List<(string Id, string Icono, string Titulo, string Badge)> _subtabsDisponibles = [];

    // Datos cargados de la orden activa (solo lectura)
    private FichaMedicaCompletaDto? _fichaMedica;
    private List<DiagnosticoCie10Dto> _diagnosticos = [];
    private List<AntecedenteClinicoDto> _antecedentesOrden = [];
    private List<VacunaPacienteDto> _vacunasOrden = [];
    private List<IStatDto> _istatDia = [];
    private List<EvolucionMedicaDto> _evoluciones = [];
    private List<RecetaMedicamentoItemDto> _receta = [];
    private List<RecetaMedicamentoItemDto> _aplicadosConsulta = [];
    private string _indicacionesGenerales = string.Empty;
    private List<OrdenLaboratorioItemDto> _ordenesLab = [];
    private List<OrdenImagenItemDto> _ordenesImagen = [];
    private List<FisioterapiaOrdenDto> _fisioterapias = [];
    private List<ProcedimientoOrdenResumenDto> _procedimientos = [];
    private List<InformeDiagnosticoDto> _informes = [];
    private IngresoHospitalizacionDto? _ingresoHosp;
    private List<ProductoUtilizadoDto> _kardexProductos = [];
    private FichaHospitalizacionSheetDto? _fichaHosp;
    private int _hojaFichaActiva = 1;
    private FormularioSignosEnfermeriaDto? _signosEnf;
    private int _formSignosActivo = 1;
    private MonitoreoHospitalarioSheetDto? _monitoreoHosp;
    private int _hojaMonitoreoActiva = 1;
    private List<OrdenCirugiaItemDto> _ordenesCirugia = [];
    private List<CirugiaOperacionResumenDto> _cirugiasProgramadas = [];
    private int _idCirugiaActiva;
    private ChecklistPreoperatorioDto? _checklistPreop;
    private PreAnestesiaDto? _preAnestesia;
    private PausaSeguridadDto? _pausaSeguridad;
    private MonitorizacionAnestesiaDto? _monAnestesia;
    private HojaAnestesiaCompletaDto? _hojaAnestesia;
    private ProtocoloQuirurgicoCompletoDto? _protocolo;
    private PostOperatorioChecklistDto? _postOperatorio;
    private List<RecuperacionSignoVitalDto> _signosRecuperacion = [];
    private List<LiquidoRecuperacionDto> _liquidosRecupIng = [];
    private List<LiquidoRecuperacionDto> _liquidosRecupEgr = [];
    private List<ObservacionRecuperacionDto> _obsRecuperacion = [];
    private List<AutorizacionClinicaDto> _autorizaciones = [];
    private FormularioAltaMedicaDto? _formularioAlta;

    private readonly HashSet<string> _informesExpandidos = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _docsExpandidos = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        if (Nhcl > 0 && Nhcl != _nhclCargado)
        {
            _nhclCargado = Nhcl;
            _ordenActiva = null;
            _filtroTexto = string.Empty;
            _filtroModulo = "todas";
            await CargarListaOrdenesAsync();
        }

        if (OrdenInicial is int idOrdenInicial && idOrdenInicial > 0 && !_cargandoLista)
        {
            await NavegarAOrdenPorIdAsync(idOrdenInicial);

            if (OnOrdenInicialConsumida.HasDelegate)
            {
                await OnOrdenInicialConsumida.InvokeAsync();
            }
        }
    }

    private async Task NavegarAOrdenPorIdAsync(int idOrden)
    {
        var objetivo = _ordenes.FirstOrDefault(o => o.IdOrden == idOrden)
            ?? new OrdenHistorialClinicoResumenDto
            {
                IdOrden = idOrden,
                Nhcl = Nhcl,
                Fecha = DateTime.Today,
                Medico = "Médico",
                Especialidad = "Atención Clínica"
            };

        if (_ordenActiva?.IdOrden != objetivo.IdOrden)
        {
            await AbrirDetalleOrdenAsync(objetivo);
        }
    }

    private async Task CargarListaOrdenesAsync()
    {
        _cargandoLista = true;
        _error = string.Empty;
        try
        {
            _ordenes = await AdminService.ObtenerHistorialOrdenesPacienteAsync(Nhcl);
        }
        catch (Exception ex)
        {
            _ordenes = [];
            _error = $"No se pudo cargar el historial de órdenes: {ex.Message}";
        }
        finally
        {
            _cargandoLista = false;
        }
    }

    private IEnumerable<OrdenHistorialClinicoResumenDto> OrdenesFiltradas
    {
        get
        {
            var q = _ordenes.AsEnumerable();
            q = _filtroModulo switch
            {
                "soap" => q.Where(o => o.TieneSoap),
                "triaje" => q.Where(o => o.TieneTriaje),
                "vacunas" => q.Where(o => o.TieneVacunas),
                "evoluciones" => q.Where(o => o.TieneEvoluciones),
                "receta" => q.Where(o => o.TieneReceta),
                "diagnostico" => q.Where(o => o.TieneDiagnosticosComplementarios),
                "hospitalizacion" => q.Where(o => o.TieneHospitalizacion),
                "cirugia" => q.Where(o => o.TieneCirugia),
                "consentimientos" => q.Where(o => o.TieneConsentimientos),
                _ => q
            };

            if (!string.IsNullOrWhiteSpace(_filtroTexto))
            {
                var term = _filtroTexto.Trim();
                q = q.Where(o =>
                    o.IdOrden.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                    || o.Medico.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || o.Especialidad.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || o.ModalidadAtencion.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || o.Motivo.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || o.Diagnosticos.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return q;
        }
    }

    private void LimpiarFiltros()
    {
        _filtroTexto = string.Empty;
        _filtroModulo = "todas";
    }

    private void VolverAListado()
    {
        _ordenActiva = null;
        _subtabActiva = "resumen";
        _subtabsDisponibles.Clear();
    }

    private async Task OnCambiarOrdenRapidoAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idOrden))
        {
            await NavegarAOrdenPorIdAsync(idOrden);
        }
    }

    private async Task AbrirDetalleOrdenAsync(OrdenHistorialClinicoResumenDto orden)
    {
        _ordenActiva = orden;
        _cargandoDetalle = true;
        _error = string.Empty;
        _informesExpandidos.Clear();
        _docsExpandidos.Clear();
        _hojaFichaActiva = 1;
        _formSignosActivo = 1;
        _hojaMonitoreoActiva = 1;
        LimpiarDatosDetalle();
        StateHasChanged();

        int idOrden = orden.IdOrden;
        try
        {
            var tFicha = SafeNullableAsync(() => ConsultaService.ObtenerFichaMedicaAsync(idOrden, Nhcl, historica: true));
            var tDiag = SafeAsync(() => ConsultaService.ObtenerDiagnosticosOrdenAsync(idOrden), new List<DiagnosticoCie10Dto>());
            var tAntAll = SafeAsync(() => ConsultaService.ObtenerAntecedentesPacienteAsync(Nhcl), new List<AntecedenteClinicoDto>());
            var tVacAll = SafeAsync(() => ConsultaService.ObtenerVacunasPacienteAsync(Nhcl), new List<VacunaPacienteDto>());
            var tIstatAll = SafeAsync(() => AdminService.ObtenerIStatAsync(Nhcl), new List<IStatDto>());
            var tEvol = SafeAsync(() => ConsultaService.ObtenerEvolucionesPacienteAsync(Nhcl, idOrden), new List<EvolucionMedicaDto>());
            var tReceta = SafeAsync(() => ConsultaService.ObtenerRecetaOrdenAsync(idOrden), new List<RecetaMedicamentoItemDto>());
            var tAplicados = SafeAsync(() => ConsultaService.ObtenerAplicadosConsultaOrdenAsync(idOrden), new List<RecetaMedicamentoItemDto>());
            var tIndic = SafeAsync(() => ConsultaService.ObtenerIndicacionesGeneralesAsync(idOrden), string.Empty);
            var tLab = SafeAsync(() => LabImagenService.ObtenerOrdenesLaboratorioAsync(idOrden, Nhcl), new List<OrdenLaboratorioItemDto>());
            var tImg = SafeAsync(() => LabImagenService.ObtenerOrdenesImagenAsync(idOrden, Nhcl), new List<OrdenImagenItemDto>());
            var tFisio = SafeAsync(() => AdminService.ObtenerFisioterapiaAsync(idOrden, Nhcl), new List<FisioterapiaOrdenDto>());
            var tProc = SafeAsync(() => AdminService.ObtenerProcedimientosOrdenAsync(idOrden, Nhcl), new List<ProcedimientoOrdenResumenDto>());
            var tInf = SafeAsync(() => LabImagenService.ObtenerInformesPacienteAsync(Nhcl, null, idOrden), new List<InformeDiagnosticoDto>());
            var tIngHosp = SafeNullableAsync(() => HospService.ObtenerIngresoHospitalizacionAsync(idOrden, Nhcl));
            var tKardex = SafeAsync(() => KardexService.ObtenerProductosUtilizadosAsync(idOrden, string.Empty), new List<ProductoUtilizadoDto>());
            var tFichaHosp = SafeNullableAsync(() => HospService.CargarFichaHospitalizacionAsync(idOrden, Nhcl, 1));
            var tSignos = SafeNullableAsync(() => HospService.CargarSignosEnfermeriaAsync(idOrden, Nhcl, 1));
            var tMonit = SafeNullableAsync(() => HospService.CargarMonitoreoHospitalarioAsync(idOrden, Nhcl, 1));
            var tOrdCir = SafeAsync(() => ConsultaService.ObtenerOrdenesCirugiaAsync(idOrden, Nhcl), new List<OrdenCirugiaItemDto>());
            var tCirProg = SafeAsync(() => QuirofanoService.ObtenerResumenCirugiasOrdenAsync(idOrden, Nhcl), new List<CirugiaOperacionResumenDto>());
            var tPreop = SafeNullableAsync(() => QuirofanoService.ObtenerChecklistPreoperatorioAsync(idOrden, Nhcl));
            var tSignosRec = SafeAsync(() => QuirofanoService.ObtenerSignosRecuperacionAsync(idOrden), new List<RecuperacionSignoVitalDto>());
            var tLiqIng = SafeAsync(() => QuirofanoService.ObtenerLiquidosRecuperacionAsync(idOrden, "I"), new List<LiquidoRecuperacionDto>());
            var tLiqEgr = SafeAsync(() => QuirofanoService.ObtenerLiquidosRecuperacionAsync(idOrden, "E"), new List<LiquidoRecuperacionDto>());
            var tObsRec = SafeAsync(() => QuirofanoService.ObtenerObservacionesRecuperacionAsync(idOrden), new List<ObservacionRecuperacionDto>());
            var tAuthAll = SafeAsync(() => ConsultaService.ObtenerAutorizacionesPacienteAsync(Nhcl), new List<AutorizacionClinicaDto>());
            var tAlta = SafeNullableAsync(() => ConsultaService.ObtenerFormularioAltaAsync(idOrden, Nhcl));

            await Task.WhenAll(
                tFicha, tDiag, tAntAll, tVacAll, tIstatAll,
                tEvol, tReceta, tAplicados, tIndic,
                tLab, tImg, tFisio, tProc, tInf,
                tIngHosp, tKardex, tFichaHosp, tSignos, tMonit,
                tOrdCir, tCirProg, tPreop, tSignosRec, tLiqIng, tLiqEgr, tObsRec,
                tAuthAll, tAlta);

            _fichaMedica = await tFicha;
            _diagnosticos = await tDiag;
            _antecedentesOrden = (await tAntAll).Where(a => a.Orden == idOrden).ToList();
            _vacunasOrden = (await tVacAll).Where(v => v.Orden == idOrden).ToList();
            _istatDia = (await tIstatAll).Where(x => x.Fecha.Date == orden.Fecha.Date).ToList();
            _evoluciones = await tEvol;
            _receta = await tReceta;
            _aplicadosConsulta = await tAplicados;
            _indicacionesGenerales = await tIndic;
            _ordenesLab = await tLab;
            _ordenesImagen = await tImg;
            _fisioterapias = await tFisio;
            _procedimientos = await tProc;
            _informes = await tInf;
            _ingresoHosp = await tIngHosp;
            _kardexProductos = await tKardex;
            _fichaHosp = await tFichaHosp;
            _signosEnf = await tSignos;
            _monitoreoHosp = await tMonit;
            _ordenesCirugia = await tOrdCir;
            _checklistPreop = await tPreop;
            _signosRecuperacion = await tSignosRec;
            _liquidosRecupIng = await tLiqIng;
            _liquidosRecupEgr = await tLiqEgr;
            _obsRecuperacion = await tObsRec;
            _autorizaciones = (await tAuthAll).Where(a => a.Orden == idOrden).ToList();
            _formularioAlta = await tAlta;

            // Solo vincular cirugías que pertenezcan explícitamente a esta orden
            // (o cirugías legacy sin id_orden SOLO si coinciden con la fecha exacta de la orden)
            var todasCir = await tCirProg;
            var cirDeEstaOrden = todasCir.Where(c => c.IdOrden == idOrden).ToList();
            if (cirDeEstaOrden.Count == 0)
            {
                cirDeEstaOrden = todasCir
                    .Where(c => (!c.IdOrden.HasValue || c.IdOrden == 0) && c.Fecha.Date == orden.Fecha.Date)
                    .ToList();
            }
            _cirugiasProgramadas = cirDeEstaOrden;

            _idCirugiaActiva = _cirugiasProgramadas.FirstOrDefault()?.IdCirugia ?? 0;
            await CargarDatosQuirurgicosPorCirugiaAsync(idOrden, _idCirugiaActiva);

            ConstruirSubtabsDisponibles();
        }
        catch (Exception ex)
        {
            _error = $"Error al cargar el detalle de la orden #{idOrden}: {ex.Message}";
        }
        finally
        {
            _cargandoDetalle = false;
        }
    }

    private async Task CargarDatosQuirurgicosPorCirugiaAsync(int idOrden, int idCirugia)
    {
        var tPre = SafeNullableAsync(() => QuirofanoService.ObtenerPreAnestesiaAsync(idOrden, Nhcl, idCirugia));
        var tPausa = SafeNullableAsync(() => QuirofanoService.ObtenerPausaSeguridadAsync(idOrden, Nhcl, idCirugia));
        var tMonA = SafeNullableAsync(() => QuirofanoService.ObtenerMonitorizacionAnestesiaAsync(idOrden, Nhcl, idCirugia));
        var tHojaA = SafeNullableAsync(() => QuirofanoService.ObtenerHojaAnestesiaAsync(idOrden, Nhcl, 1, idCirugia));
        var tProt = SafeNullableAsync(() => QuirofanoService.ObtenerProtocoloQuirurgicoAsync(idOrden, Nhcl, idCirugia));
        var tPost = SafeNullableAsync(() => QuirofanoService.ObtenerPostOperatorioChecklistAsync(idOrden, Nhcl, idCirugia));

        await Task.WhenAll(tPre, tPausa, tMonA, tHojaA, tProt, tPost);

        _preAnestesia = await tPre;
        _pausaSeguridad = await tPausa;
        _monAnestesia = await tMonA;
        _hojaAnestesia = await tHojaA;
        _protocolo = await tProt;
        _postOperatorio = await tPost;
    }

