    private void ConstruirSubtabsDisponibles()
    {
        _subtabsDisponibles.Clear();
        if (_ordenActiva is null) return;

        // 1. Resumen Ejecutivo SIEMPRE primero y por defecto
        _subtabsDisponibles.Add(("resumen", "bi-journal-medical", "Resumen de la Orden", ""));

        if (_evoluciones.Count > 0)
            _subtabsDisponibles.Add(("evoluciones", "bi-activity", "Evoluciones", _evoluciones.Count.ToString()));

        int totalReceta = _receta.Count + _aplicadosConsulta.Count + _vacunasOrden.Count;
        if (totalReceta > 0 || !string.IsNullOrWhiteSpace(_indicacionesGenerales))
            _subtabsDisponibles.Add(("receta", "bi-capsule", "Receta y Medicinas", totalReceta > 0 ? totalReceta.ToString() : ""));

        int totalDiag = _ordenesLab.Count + _ordenesImagen.Count + _fisioterapias.Count + _procedimientos.Count + _informes.Count;
        if (totalDiag > 0)
            _subtabsDisponibles.Add(("diagnostico", "bi-eyedropper", "Lab, Imagen y Proc.", totalDiag.ToString()));

        if (TieneDatosHospitalizacionCargados)
            _subtabsDisponibles.Add(("hospitalizacion", "bi-hospital", "Hospitalización", ""));

        if (TieneDatosCirugiaCargados)
            _subtabsDisponibles.Add(("cirugia", "bi-scissors", "Cirugía y Quirófano", ""));

        int totalDocs = _autorizaciones.Count + (TieneAltaMedica ? 1 : 0);
        if (totalDocs > 0)
            _subtabsDisponibles.Add(("consentimientos", "bi-file-earmark-check", "Consentimientos y Alta", totalDocs.ToString()));

        _subtabActiva = "resumen";
    }

