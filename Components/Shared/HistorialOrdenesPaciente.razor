    private static string TextoSiNo(string? val) =>
        string.Equals(val?.Trim(), "S", StringComparison.OrdinalIgnoreCase) ? "Sí" :
        string.Equals(val?.Trim(), "N", StringComparison.OrdinalIgnoreCase) ? "No" :
        string.IsNullOrWhiteSpace(val) ? "—" : val;

