@using HosvetKardex.Web.Components.Pages
@inject IAdministracionClinicaService AdminService
@inject IConsultaExternaService ConsultaService
@inject ILaboratorioImagenService LabImagenService
@inject IHospitalizacionService HospService
@inject IKardexService KardexService
@inject IQuirofanoService QuirofanoService
@inject IJSRuntime JS

<div class="ho-root">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2 small mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_error
        </div>
    }

    @if (_cargandoLista)
    {
        <div class="ho-loading-box">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            <span>Cargando historial de órdenes del paciente...</span>
        </div>
    }
    else if (_ordenActiva is null)
    {
        var filtradas = OrdenesFiltradas.ToList();

        <!-- BARRA DE FILTROS MAESTRO -->
        <div class="ho-toolbar">
            <div class="ho-toolbar-top">
                <div class="ho-search-wrap">
                    <i class="bi bi-search ho-search-icon"></i>
                    <input type="text"
                           class="form-control form-control-sm ho-search-input"
                           placeholder="Buscar por #orden, médico, especialidad, motivo, modalidad o diagnóstico..."
                           @bind="_filtroTexto"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_filtroTexto))
                    {
                        <button type="button" class="ho-search-clear" @onclick='() => _filtroTexto = ""' title="Limpiar búsqueda">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>
                <span class="ho-count-pill">
                    <i class="bi bi-receipt-cutoff me-1"></i>@filtradas.Count @(filtradas.Count == 1 ? "orden" : "órdenes")
                </span>
            </div>

            <div class="ho-filter-pills">
                <button type="button" class="ho-pill @(_filtroModulo == "todas" ? "active" : "")" @onclick='() => _filtroModulo = "todas"'>
                    Todas <span class="ho-pill-num">@_ordenes.Count</span>
                </button>
                @if (_ordenes.Any(o => o.TieneSoap))
                {
                    <button type="button" class="ho-pill @(_filtroModulo == "soap" ? "active" : "")" @onclick='() => _filtroModulo = "soap"'>
                        <i class="bi bi-file-earmark-medical"></i> SOAP <span class="ho-pill-num">@_ordenes.Count(o => o.TieneSoap)</span>
                    </button>
                }
                @if (_ordenes.Any(o => o.TieneTriaje))
                {
                    <button type="button" class="ho-pill @(_filtroModulo == "triaje" ? "active" : "")" @onclick='() => _filtroModulo = "triaje"'>
                        <i class="bi bi-heart-pulse"></i> Triaje <span class="ho-pill-num">@_ordenes.Count(o => o.TieneTriaje)</span>
                    </button>
                }
                @if (_ordenes.Any(o => o.TieneCirugia))
                {
                    <button type="button" class="ho-pill @(_filtroModulo == "cirugia" ? "active" : "")" @onclick='() => _filtroModulo = "cirugia"'>
                        <i class="bi bi-scissors"></i> Cirugía <span class="ho-pill-num">@_ordenes.Count(o => o.TieneCirugia)</span>
                    </button>
                }
                @if (_ordenes.Any(o => o.TieneHospitalizacion))
                {
                    <button type="button" class="ho-pill @(_filtroModulo == "hospitalizacion" ? "active" : "")" @onclick='() => _filtroModulo = "hospitalizacion"'>
                        <i class="bi bi-hospital"></i> Hospitalización <span class="ho-pill-num">@_ordenes.Count(o => o.TieneHospitalizacion)</span>
                    </button>
                }
                @if (_ordenes.Any(o => o.TieneReceta))
                {
                    <button type="button" class="ho-pill @(_filtroModulo == "receta" ? "active" : "")" @onclick='() => _filtroModulo = "receta"'>
                        <i class="bi bi-capsule"></i> Receta <span class="ho-pill-num">@_ordenes.Count(o => o.TieneReceta)</span>
                    </button>
                }
                @if (_ordenes.Any(o => o.TieneDiagnosticosComplementarios))
                {
                    <button type="button" class="ho-pill @(_filtroModulo == "diagnostico" ? "active" : "")" @onclick='() => _filtroModulo = "diagnostico"'>
                        <i class="bi bi-eyedropper"></i> Lab / Imagen / Proc. <span class="ho-pill-num">@_ordenes.Count(o => o.TieneDiagnosticosComplementarios)</span>
                    </button>
                }
                @if (_ordenes.Any(o => o.TieneVacunas))
                {
                    <button type="button" class="ho-pill @(_filtroModulo == "vacunas" ? "active" : "")" @onclick='() => _filtroModulo = "vacunas"'>
                        <i class="bi bi-shield-plus"></i> Vacunas <span class="ho-pill-num">@_ordenes.Count(o => o.TieneVacunas)</span>
                    </button>
                }
                @if (_ordenes.Any(o => o.TieneEvoluciones))
                {
                    <button type="button" class="ho-pill @(_filtroModulo == "evoluciones" ? "active" : "")" @onclick='() => _filtroModulo = "evoluciones"'>
                        <i class="bi bi-activity"></i> Evoluciones <span class="ho-pill-num">@_ordenes.Count(o => o.TieneEvoluciones)</span>
                    </button>
                }
                @if (_ordenes.Any(o => o.TieneConsentimientos))
                {
                    <button type="button" class="ho-pill @(_filtroModulo == "consentimientos" ? "active" : "")" @onclick='() => _filtroModulo = "consentimientos"'>
                        <i class="bi bi-file-earmark-check"></i> Docs / Alta <span class="ho-pill-num">@_ordenes.Count(o => o.TieneConsentimientos)</span>
                    </button>
                }
            </div>
        </div>

        @if (_ordenes.Count == 0)
        {
            <div class="ho-empty-card">
                <i class="bi bi-clock-history fs-2 text-muted"></i>
                <div class="fw-bold text-dark mt-2">Sin órdenes registradas</div>
                <div class="small text-muted">Este paciente todavía no registra órdenes de atención en el sistema.</div>
            </div>
        }
        else if (filtradas.Count == 0)
        {
            <div class="ho-empty-card">
                <i class="bi bi-funnel fs-2 text-muted"></i>
                <div class="fw-bold text-dark mt-2">Sin coincidencias</div>
                <div class="small text-muted mb-2">No se encontraron órdenes con los criterios seleccionados.</div>
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="LimpiarFiltros">Mostrar todas las órdenes</button>
            </div>
        }
        else
        {
            <div class="ho-order-list">
                @foreach (var ord in filtradas)
                {
                    <div class="ho-order-card" role="button" tabindex="0" @onclick="() => AbrirDetalleOrdenAsync(ord)">
                        <div class="ho-order-card-head">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="ho-order-num">Orden #@ord.IdOrden</span>
                                <span class="ho-date-tag">
                                    <i class="bi bi-calendar3"></i> @ord.Fecha.ToString("dd/MM/yyyy")
                                    @if (!string.IsNullOrWhiteSpace(ord.Hora))
                                    {
                                        <span class="text-muted">· @FormatearHoraCorta(ord.Hora)</span>
                                    }
                                </span>
                                <span class="ho-modality-badge @ClaseModalidad(ord)">
                                    <i class="bi @IconoModalidad(ord)"></i> @ord.ModalidadAtencion
                                </span>
                                <span class="ho-state-badge @ClaseEstadoOrden(ord.Estado)">@TextoEstadoOrden(ord.Estado, ord.Etapa)</span>
                            </div>
                            <span class="ho-open-cue">
                                Ver resumen <i class="bi bi-arrow-right"></i>
                            </span>
                        </div>

                        <div class="ho-order-meta">
                            <span><i class="bi bi-person-badge text-primary me-1"></i><strong>@ord.Medico</strong></span>
                            <span class="text-muted">·</span>
                            <span><i class="bi bi-bookmark-heart text-secondary me-1"></i>@ord.Especialidad</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(ord.Motivo) && !EsMotivoTriaje(ord.Motivo))
                        {
                            <div class="ho-order-snippet">
                                <span class="ho-snippet-label">Motivo:</span> @ord.Motivo
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(ord.Diagnosticos))
                        {
                            <div class="ho-order-diag">
                                <i class="bi bi-clipboard2-pulse me-1"></i><strong>CIE-10:</strong> @ord.Diagnosticos
                            </div>
                        }

                        <div class="ho-modules-row">
                            @if (ord.TieneSoap)
                            {
                                <span class="ho-mod-badge tone-soap"><i class="bi bi-file-earmark-medical"></i> Historia SOAP</span>
                            }
                            @if (ord.TieneTriaje)
                            {
                                <span class="ho-mod-badge tone-triaje"><i class="bi bi-heart-pulse"></i> Triaje</span>
                            }
                            @if (ord.TieneEvoluciones)
                            {
                                <span class="ho-mod-badge tone-evol"><i class="bi bi-activity"></i> Evoluciones</span>
                            }
                            @if (ord.TieneReceta)
                            {
                                <span class="ho-mod-badge tone-rx"><i class="bi bi-capsule"></i> Receta</span>
                            }
                            @if (ord.TieneVacunas)
                            {
                                <span class="ho-mod-badge tone-vac"><i class="bi bi-shield-plus"></i> Vacunas</span>
                            }
                            @if (ord.TieneDiagnosticosComplementarios)
                            {
                                <span class="ho-mod-badge tone-lab"><i class="bi bi-eyedropper"></i> Lab / Imagen / Proc.</span>
                            }
                            @if (ord.TieneHospitalizacion)
                            {
                                <span class="ho-mod-badge tone-hosp"><i class="bi bi-hospital"></i> Hospitalización</span>
                            }
                            @if (ord.TieneCirugia)
                            {
                                <span class="ho-mod-badge tone-cir"><i class="bi bi-scissors"></i> Cirugía / Quirófano</span>
                            }
                            @if (ord.TieneConsentimientos)
                            {
                                <span class="ho-mod-badge tone-doc"><i class="bi bi-file-earmark-check"></i> Docs / Alta</span>
                            }
                            @if (!ord.TieneAlgunModulo)
                            {
                                <span class="ho-mod-badge tone-empty"><i class="bi bi-dash-circle"></i> Solo registro de orden</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        var modalidadDetalle = ObtenerModalidadDetalle();

        <!-- CABECERA DETALLE DE ORDEN (SOLO LECTURA) -->
        <div class="ho-detail-bar">
            <div class="ho-detail-bar-left">
                <button type="button" class="btn btn-sm btn-outline-secondary ho-back-btn" @onclick="VolverAListado">
                    <i class="bi bi-arrow-left me-1"></i>Todas las órdenes
                </button>
                <div class="ho-detail-title-group">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="ho-order-num">Orden #@_ordenActiva.IdOrden</span>
                        <span class="ho-modality-badge @ClaseModalidadTexto(modalidadDetalle)">
                            <i class="bi @IconoModalidadTexto(modalidadDetalle)"></i> @modalidadDetalle
                        </span>
                        <span class="ho-readonly-pill"><i class="bi bi-lock-fill me-1"></i>Solo lectura</span>
                        <span class="ho-state-badge @ClaseEstadoOrden(_ordenActiva.Estado)">@TextoEstadoOrden(_ordenActiva.Estado, _ordenActiva.Etapa)</span>
                    </div>
                    <div class="small text-muted mt-1">
                        <i class="bi bi-calendar3 me-1"></i>@_ordenActiva.Fecha.ToString("dd/MM/yyyy")
                        @if (!string.IsNullOrWhiteSpace(_ordenActiva.Hora))
                        {
                            <span> · @FormatearHoraCorta(_ordenActiva.Hora)</span>
                        }
                        <span class="mx-1">·</span>
                        <strong>@_ordenActiva.Medico</strong> (@_ordenActiva.Especialidad)
                    </div>
                </div>
            </div>

            @if (_ordenes.Count > 1)
            {
                <div class="ho-switcher-wrap">
                    <label class="ho-switcher-label">Cambiar orden</label>
                    <select class="form-select form-select-sm" value="@_ordenActiva.IdOrden" @onchange="OnCambiarOrdenRapidoAsync">
                        @foreach (var o in _ordenes)
                        {
                            <option value="@o.IdOrden">#@o.IdOrden · @o.Fecha.ToString("dd/MM/yyyy") — @o.ModalidadAtencion</option>
                        }
                    </select>
                </div>
            }
        </div>

        @if (_cargandoDetalle)
        {
            <div class="ho-loading-box mt-2">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span>Consolidando resumen clínico de la orden #@_ordenActiva.IdOrden...</span>
            </div>
        }
        else
        {
            <!-- SUB-PESTAÑAS DINÁMICAS (RESUMEN SIEMPRE PRIMERO + MÓDULOS CON DATOS) -->
            <div class="ho-subtabs" role="tablist">
                @foreach (var tab in _subtabsDisponibles)
                {
                    <button type="button"
                            role="tab"
                            class="ho-subtab @(_subtabActiva == tab.Id ? "active" : "")"
                            @onclick="() => _subtabActiva = tab.Id">
                        <i class="bi @tab.Icono"></i>
                        <span>@tab.Titulo</span>
                        @if (!string.IsNullOrWhiteSpace(tab.Badge))
                        {
                            <span class="ho-subtab-badge">@tab.Badge</span>
                        }
                    </button>
                }
            </div>

            <div class="ho-detail-content">
                @if (_subtabActiva == "resumen")
                {
                    var signosConsolidados = ObtenerSignosVitalesConsolidados();

                    <!-- ========================================================= -->
                    <!-- RESUMEN EJECUTIVO COMPLETO DE LA ORDEN                    -->
                    <!-- ========================================================= -->
                    <div class="ho-exec-wrap">

                        @if (!TieneSoapReal && _ordenActiva.IdOrdenOrigenCirugia is int idOrig && idOrig > 0)
                        {
                            <div class="d-flex justify-content-end">
                                <button type="button" class="ho-origin-link" @onclick="() => NavegarAOrdenPorIdAsync(idOrig)">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Ver consulta previa que indicó esta cirugía (Orden #@idOrig)
                                </button>
                            </div>
                        }

                        @if (!TieneAlgunContenidoResumen && signosConsolidados.Items.Count == 0)
                        {
                            <div class="ho-empty-card">
                                <i class="bi bi-journal-text fs-2 text-muted"></i>
                                <div class="fw-bold text-dark mt-2">Sin registros clínicos detallados</div>
                                <div class="small text-muted">
                                    La orden #@_ordenActiva.IdOrden solo contiene su cabecera de admisión (Fecha @_ordenActiva.Fecha.ToString("dd/MM/yyyy") · @_ordenActiva.Medico · @_ordenActiva.Especialidad).
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- 1. CONSTANTES VITALES, TRIAJE Y EXPLORACIÓN FÍSICA COMPLETA -->
                            @if (signosConsolidados.Items.Count > 0 || (_fichaMedica is not null && _fichaMedica.Sec > 0))
                            {
                                var fm = _fichaMedica;
                                var hallazgosFisicos = ObtenerHallazgosExamenFisico(fm);

                                <div class="ho-section-card">
                                    <div class="ho-section-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="ho-icon-bubble @(TieneSoapReal ? "tone-soap" : "tone-triaje")">
                                                <i class="bi bi-heart-pulse-fill"></i>
                                            </span>
                                            <div>
                                                <span class="fw-bold text-dark small">Signos Vitales y Examen Físico</span>
                                                <span class="ho-source-tag ms-2">@signosConsolidados.Fuente</span>
                                                @if (fm is not null && fm.Sec > 0 && !string.IsNullOrWhiteSpace(fm.NombreMedico))
                                                {
                                                    <span class="text-muted small ms-1">· @fm.NombreMedico</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            @if (fm is not null && fm.Sec > 0 && !string.IsNullOrWhiteSpace(fm.Temperamento))
                                            {
                                                <span class="ho-mini-chip @ClaseTemperamento(fm.Temperamento)">
                                                    <i class="bi bi-shield-fill-check me-1"></i>@fm.Temperamento
                                                </span>
                                            }
                                            @if (fm is not null && fm.Sec > 0 && !string.IsNullOrWhiteSpace(fm.Esterilizado))
                                            {
                                                <span class="ho-mini-chip chip-neutral">
                                                    Esterilizado: @(fm.Esterilizado == "S" ? "Sí" : fm.Esterilizado == "N" ? "No" : fm.Esterilizado)
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="ho-section-body d-flex flex-column gap-3">
                                        @if (signosConsolidados.Items.Count > 0)
                                        {
                                            <div class="ho-vitals-grid">
                                                @foreach (var sv in signosConsolidados.Items)
                                                {
                                                    <div class="ho-vital-tile @(sv.EsAncho ? "ho-vital-wide" : "")">
                                                        <span class="ho-vital-label">@sv.Etiqueta</span>
                                                        <strong class="@(sv.EsTexto ? "ho-vital-val-sm" : "ho-vital-val")">
                                                            @sv.Valor
                                                            @if (!string.IsNullOrWhiteSpace(sv.Unidad))
                                                            {
                                                                <small> @sv.Unidad</small>
                                                            }
                                                        </strong>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (hallazgosFisicos.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title">Exploración clínica por sistemas</div>
                                                <div class="ho-exam-grid">
                                                    @foreach (var h in hallazgosFisicos)
                                                    {
                                                        <div class="ho-exam-item @(h.EsAncho ? "ho-kv-wide" : "")">
                                                            <span class="ho-kv-label">@h.Sistema</span>
                                                            <span class="ho-kv-val @(h.EsAncho ? "ho-prose" : "")">@h.Hallazgo</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- 2. HISTORIA CLÍNICA SOAP, ANTECEDENTES Y DIAGNÓSTICOS -->
                            @if (TieneSoapReal || _diagnosticos.Count > 0 || _antecedentesOrden.Count > 0)
                            {
                                var fm = _fichaMedica;
                                bool hayCamposSoap = fm is not null && fm.Sec > 0 && (
                                    (!string.IsNullOrWhiteSpace(fm.MedMotivo) && !EsMotivoTriaje(fm.MedMotivo))
                                    || !string.IsNullOrWhiteSpace(fm.MedTipoConsulta)
                                    || !string.IsNullOrWhiteSpace(fm.MedAntecedente)
                                    || !string.IsNullOrWhiteSpace(fm.MedAnamnesis)
                                    || !string.IsNullOrWhiteSpace(fm.MedObjetivo)
                                    || !string.IsNullOrWhiteSpace(fm.MedAnalisis)
                                    || !string.IsNullOrWhiteSpace(fm.MedPlan)
                                    || !string.IsNullOrWhiteSpace(fm.Tratamiento)
                                    || !string.IsNullOrWhiteSpace(fm.ObservacionesYRecomendaciones)
                                    || !string.IsNullOrWhiteSpace(fm.MedApuntes)
                                    || fm.RequiereCirugia == "S"
                                    || fm.RequiereHospitalizacion);

                                <div class="ho-section-card">
                                    <div class="ho-section-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="ho-icon-bubble tone-soap"><i class="bi bi-file-earmark-medical-fill"></i></span>
                                            <span class="fw-bold text-dark small">Historia Clínica SOAP y Diagnósticos</span>
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            @if (fm is not null && fm.Sec > 0 && fm.RequiereCirugia == "S")
                                            {
                                                <span class="ho-mini-chip chip-cir"><i class="bi bi-scissors me-1"></i>Requiere Cirugía</span>
                                            }
                                            @if (fm is not null && fm.Sec > 0 && fm.RequiereHospitalizacion)
                                            {
                                                <span class="ho-mini-chip chip-hosp"><i class="bi bi-hospital me-1"></i>Requiere Hospitalización</span>
                                            }
                                            @if (fm is not null && fm.Sec > 0 && !string.IsNullOrWhiteSpace(fm.MedPronostico) && TieneSoapReal)
                                            {
                                                <span class="ho-mini-chip chip-neutral">Pronóstico: @fm.MedPronostico</span>
                                            }
                                            @if (fm?.MedFechaControl is not null)
                                            {
                                                <span class="ho-mini-chip chip-hosp"><i class="bi bi-calendar-event me-1"></i>Control: @fm.MedFechaControl.Value.ToString("dd/MM/yyyy")</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="ho-section-body d-flex flex-column gap-3">
                                        @if (_diagnosticos.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title">Diagnósticos CIE-10 (@_diagnosticos.Count)</div>
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var d in _diagnosticos)
                                                    {
                                                        <div class="ho-diag-pill">
                                                            <span class="ho-diag-code">@d.CodigoDiag</span>
                                                            <span class="fw-bold">@d.NombreCie10</span>
                                                            @if (!string.IsNullOrWhiteSpace(d.TipoDiag))
                                                            {
                                                                <span class="ho-diag-type">@d.TipoDiag</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(d.DescripcionObservacion))
                                                            {
                                                                <span class="text-muted small">— @d.DescripcionObservacion</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (hayCamposSoap && fm is not null)
                                        {
                                            <div class="ho-kv-grid">
                                                @if (!string.IsNullOrWhiteSpace(fm.MedTipoConsulta))
                                                {
                                                    <div class="ho-kv-item">
                                                        <span class="ho-kv-label">Tipo de consulta</span>
                                                        <span class="ho-kv-val fw-semibold">@fm.MedTipoConsulta</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fm.MedMotivo) && !EsMotivoTriaje(fm.MedMotivo))
                                                {
                                                    <div class="ho-kv-item ho-kv-wide">
                                                        <span class="ho-kv-label">Motivo de consulta</span>
                                                        <span class="ho-kv-val fw-semibold ho-prose">@fm.MedMotivo</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fm.MedAntecedente))
                                                {
                                                    <div class="ho-kv-item ho-kv-wide">
                                                        <span class="ho-kv-label">Antecedentes referidos</span>
                                                        <span class="ho-kv-val ho-prose">@fm.MedAntecedente</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fm.MedAnamnesis))
                                                {
                                                    <div class="ho-kv-item">
                                                        <span class="ho-kv-label">Subjetivo / Anamnesis</span>
                                                        <span class="ho-kv-val ho-prose">@fm.MedAnamnesis</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fm.MedObjetivo))
                                                {
                                                    <div class="ho-kv-item">
                                                        <span class="ho-kv-label">Objetivo / Hallazgos</span>
                                                        <span class="ho-kv-val ho-prose">@fm.MedObjetivo</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fm.MedAnalisis))
                                                {
                                                    <div class="ho-kv-item">
                                                        <span class="ho-kv-label">Análisis / Impresión diagnóstica</span>
                                                        <span class="ho-kv-val ho-prose">@fm.MedAnalisis</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fm.MedPlan))
                                                {
                                                    <div class="ho-kv-item">
                                                        <span class="ho-kv-label">Plan terapéutico</span>
                                                        <span class="ho-kv-val ho-prose">@fm.MedPlan</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fm.Tratamiento))
                                                {
                                                    <div class="ho-kv-item ho-kv-wide">
                                                        <span class="ho-kv-label">Tratamiento indicado</span>
                                                        <span class="ho-kv-val ho-prose">@fm.Tratamiento</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fm.ObservacionesYRecomendaciones))
                                                {
                                                    <div class="ho-kv-item ho-kv-wide">
                                                        <span class="ho-kv-label">Observaciones y recomendaciones</span>
                                                        <span class="ho-kv-val ho-prose">@fm.ObservacionesYRecomendaciones</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(fm.MedApuntes))
                                                {
                                                    <div class="ho-kv-item ho-kv-wide">
                                                        <span class="ho-kv-label">Apuntes clínicos</span>
                                                        <span class="ho-kv-val ho-prose">@fm.MedApuntes</span>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (_antecedentesOrden.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title">Antecedentes registrados en esta orden (@_antecedentesOrden.Count)</div>
                                                @foreach (var ant in _antecedentesOrden)
                                                {
                                                    <div class="ho-note-line">
                                                        <div>@ant.Descripcion</div>
                                                        @if (!string.IsNullOrWhiteSpace(ant.Alimentacion) || !string.IsNullOrWhiteSpace(ant.ContactoMascotas))
                                                        {
                                                            <div class="small text-muted mt-1">
                                                                @if (!string.IsNullOrWhiteSpace(ant.Alimentacion)) { <span><strong>Alimentación:</strong> @ant.Alimentacion </span> }
                                                                @if (!string.IsNullOrWhiteSpace(ant.ContactoMascotas)) { <span>· <strong>Contacto mascotas:</strong> @ant.ContactoMascotas</span> }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- 3. MEDICACIÓN: RECETA, APLICADOS, KARDEX, QUIRÓFANO Y VACUNAS -->
                            var farmacosAnestesiaResumen = ObtenerFarmacosAnestesiaResumen();
                            @if (_receta.Count > 0 || _aplicadosConsulta.Count > 0 || _kardexProductos.Count > 0 || _vacunasOrden.Count > 0 || farmacosAnestesiaResumen.Count > 0 || !string.IsNullOrWhiteSpace(_indicacionesGenerales))
                            {
                                var kardexAgrupado = _kardexProductos
                                    .GroupBy(k => new { Nombre = k.Producto.Trim(), Via = k.Via.Trim() })
                                    .Select(g => new
                                    {
                                        Producto = g.Key.Nombre,
                                        Via = g.Key.Via,
                                        Tomas = g.Count(),
                                        CantidadTotal = g.Sum(x => x.Cantidad),
                                        Indicacion = g.Select(x => x.Indicaciones).FirstOrDefault(s => !string.IsNullOrWhiteSpace(s)) ?? "",
                                        Ultima = g.OrderByDescending(x => x.FechaRaw).ThenByDescending(x => x.Hora).First()
                                    })
                                    .ToList();

                                <div class="ho-section-card">
                                    <div class="ho-section-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="ho-icon-bubble tone-rx"><i class="bi bi-capsule-pill"></i></span>
                                            <span class="fw-bold text-dark small">Medicación: Recetados, Administrados y Vacunas</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (_receta.Count > 0 || _aplicadosConsulta.Count > 0 || _vacunasOrden.Count > 0)
                                            {
                                                <button type="button" class="ho-jump-btn" @onclick='() => _subtabActiva = "receta"'>
                                                    Ver detalle de receta <i class="bi bi-arrow-right"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <div class="ho-section-body d-flex flex-column gap-3">
                                        @if (_receta.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title"><i class="bi bi-prescription2 me-1 text-primary"></i>Receta médica para casa (@_receta.Count)</div>
                                                <div class="table-responsive">
                                                    <table class="ho-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Medicamento / Insumo</th>
                                                                <th style="width:85px;">Cant.</th>
                                                                <th>Indicaciones / Posología</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var item in _receta)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <span class="fw-semibold text-dark">@item.Descripcionamento</span>
                                                                        @if (item.Tipo == "I")
                                                                        {
                                                                            <span class="ho-mini-chip chip-neutral ms-1">Insumo</span>
                                                                        }
                                                                    </td>
                                                                    <td class="fw-semibold">@item.Cantidad.ToString("0.##")</td>
                                                                    <td>
                                                                        @(string.IsNullOrWhiteSpace(item.Indicaciones) ? "—" : item.Indicaciones)
                                                                        @if (!string.IsNullOrWhiteSpace(item.Observaciones))
                                                                        {
                                                                            <div class="text-muted small">@item.Observaciones</div>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(_indicacionesGenerales))
                                        {
                                            <div class="ho-callout-info">
                                                <div class="fw-bold small text-primary mb-1"><i class="bi bi-info-circle-fill me-1"></i>Indicaciones generales de receta</div>
                                                <div class="ho-prose small text-dark">@_indicacionesGenerales</div>
                                            </div>
                                        }

                                        @if (_aplicadosConsulta.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title"><i class="bi bi-eyedropper me-1 text-success"></i>Administrados en consulta / procedimiento (@_aplicadosConsulta.Count)</div>
                                                <div class="ho-med-chips-grid">
                                                    @foreach (var ap in _aplicadosConsulta)
                                                    {
                                                        <div class="ho-med-row-item">
                                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                                <strong class="small text-dark">@ap.Descripcionamento</strong>
                                                                <span class="ho-mini-chip chip-evol">Cant: @ap.Cantidad.ToString("0.##")</span>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(ap.Indicaciones) || !string.IsNullOrWhiteSpace(ap.Observaciones))
                                                            {
                                                                <div class="small text-muted mt-1">@ap.Indicaciones @ap.Observaciones</div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (kardexAgrupado.Count > 0)
                                        {
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <div class="ho-mini-title mb-0"><i class="bi bi-clipboard2-check me-1 text-info"></i>Administrados en hospitalización / Kardex (@_kardexProductos.Count dosis)</div>
                                                    <button type="button" class="ho-jump-btn" @onclick='() => _subtabActiva = "hospitalizacion"'>Ver Kardex completo <i class="bi bi-arrow-right"></i></button>
                                                </div>
                                                <div class="table-responsive">
                                                    <table class="ho-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Medicamento / Producto</th>
                                                                <th style="width:90px;">Vía</th>
                                                                <th style="width:120px;">Total / Tomas</th>
                                                                <th>Indicaciones</th>
                                                                <th style="width:130px;">Última toma</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var kg in kardexAgrupado)
                                                            {
                                                                <tr>
                                                                    <td class="fw-semibold text-dark">@kg.Producto</td>
                                                                    <td>@(string.IsNullOrWhiteSpace(kg.Via) ? "—" : kg.Via)</td>
                                                                    <td><strong>@kg.CantidadTotal.ToString("0.##")</strong> <span class="text-muted small">(@kg.Tomas @(kg.Tomas == 1 ? "vez" : "veces"))</span></td>
                                                                    <td class="text-muted">@(string.IsNullOrWhiteSpace(kg.Indicacion) ? "—" : kg.Indicacion)</td>
                                                                    <td class="text-nowrap small">@kg.Ultima.Fecha @kg.Ultima.Hora</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        }

                                        @if (farmacosAnestesiaResumen.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title"><i class="bi bi-lungs me-1 text-purple"></i>Fármacos y fluidos en Anestesia / Quirófano (@farmacosAnestesiaResumen.Count)</div>
                                                <div class="ho-med-chips-grid">
                                                    @foreach (var fa in farmacosAnestesiaResumen)
                                                    {
                                                        <div class="ho-med-row-item">
                                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                                <strong class="small text-dark">@fa.Nombre</strong>
                                                                <span class="ho-mini-chip chip-cir">@fa.Fase</span>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(fa.Detalle))
                                                            {
                                                                <div class="small text-muted mt-1">@fa.Detalle</div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (_vacunasOrden.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title"><i class="bi bi-shield-plus me-1 text-success"></i>Vacunas aplicadas en esta orden (@_vacunasOrden.Count)</div>
                                                <div class="ho-med-chips-grid">
                                                    @foreach (var vac in _vacunasOrden)
                                                    {
                                                        <div class="ho-med-row-item">
                                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                                <strong class="small text-dark">@vac.NombreVacuna</strong>
                                                                @if (vac.FechaRevacunacion.HasValue)
                                                                {
                                                                    <span class="ho-mini-chip chip-evol">Refuerzo: @vac.FechaRevacunacion.Value.ToString("dd/MM/yyyy")</span>
                                                                }
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(vac.ObservacionVacuna))
                                                            {
                                                                <div class="small text-muted mt-1">@vac.ObservacionVacuna</div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- 4. PROCEDIMIENTOS, EXÁMENES, i-STAT E INFORMES DIAGNÓSTICOS -->
                            @if (_procedimientos.Count > 0 || _fisioterapias.Count > 0 || _ordenesLab.Count > 0 || _ordenesImagen.Count > 0 || _informes.Count > 0 || _istatDia.Count > 0)
                            {
                                <div class="ho-section-card">
                                    <div class="ho-section-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="ho-icon-bubble tone-lab"><i class="bi bi-eyedropper"></i></span>
                                            <span class="fw-bold text-dark small">Procedimientos, Exámenes y Resultados</span>
                                        </div>
                                        @if (_procedimientos.Count > 0 || _fisioterapias.Count > 0 || _ordenesLab.Count > 0 || _ordenesImagen.Count > 0 || _informes.Count > 0)
                                        {
                                            <button type="button" class="ho-jump-btn" @onclick='() => _subtabActiva = "diagnostico"'>
                                                Ver detalle completo <i class="bi bi-arrow-right"></i>
                                            </button>
                                        }
                                    </div>
                                    <div class="ho-section-body d-flex flex-column gap-3">
                                        @if (_procedimientos.Count > 0 || _fisioterapias.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title">Procedimientos y Fisioterapia</div>
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var p in _procedimientos)
                                                    {
                                                        <div class="ho-exec-tag-card">
                                                            <span class="ho-mini-chip chip-cir">Procedimiento</span>
                                                            <strong class="small text-dark">@p.Descripcion</strong>
                                                            @if (p.Cantidad > 1)
                                                            {
                                                                <span class="text-muted small">x@p.Cantidad.ToString("0.##")</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(p.Observaciones))
                                                            {
                                                                <span class="text-muted small">· @p.Observaciones</span>
                                                            }
                                                        </div>
                                                    }
                                                    @foreach (var f in _fisioterapias)
                                                    {
                                                        <div class="ho-exec-tag-card">
                                                            <span class="ho-mini-chip chip-evol">Fisioterapia</span>
                                                            <strong class="small text-dark">@f.Descripcion</strong>
                                                            @if (f.Cantidad > 1)
                                                            {
                                                                <span class="text-muted small">x@f.Cantidad.ToString("0.##")</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (_ordenesLab.Count > 0 || _ordenesImagen.Count > 0)
                                        {
                                            <div class="row g-3">
                                                @if (_ordenesLab.Count > 0)
                                                {
                                                    <div class="@(_ordenesImagen.Count > 0 ? "col-md-6" : "col-12")">
                                                        <div class="ho-mini-title">Laboratorio (@_ordenesLab.Count)</div>
                                                        <div class="d-flex flex-column gap-1">
                                                            @foreach (var l in _ordenesLab)
                                                            {
                                                                <div class="ho-compact-line">
                                                                    <div>
                                                                        <span class="fw-semibold text-dark small">@l.DescripcionExamen</span>
                                                                        @if (!string.IsNullOrWhiteSpace(l.Observaciones))
                                                                        {
                                                                            <div class="text-muted" style="font-size:.73rem;">@l.Observaciones</div>
                                                                        }
                                                                    </div>
                                                                    <span class="ho-mini-chip chip-lab">@l.Estado</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                @if (_ordenesImagen.Count > 0)
                                                {
                                                    <div class="@(_ordenesLab.Count > 0 ? "col-md-6" : "col-12")">
                                                        <div class="ho-mini-title">Imagenología RX / Eco (@_ordenesImagen.Count)</div>
                                                        <div class="d-flex flex-column gap-1">
                                                            @foreach (var im in _ordenesImagen)
                                                            {
                                                                <div class="ho-compact-line">
                                                                    <div>
                                                                        <span class="fw-semibold text-dark small">@im.DescripcionEstudio</span>
                                                                        @if (!string.IsNullOrWhiteSpace(im.Observaciones))
                                                                        {
                                                                            <div class="text-muted" style="font-size:.73rem;">@im.Observaciones</div>
                                                                        }
                                                                    </div>
                                                                    <span class="ho-mini-chip chip-img">@im.Estado</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (_istatDia.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title">Gasometría / i-STAT del día (@_istatDia.Count)</div>
                                                @foreach (var ist in _istatDia)
                                                {
                                                    var paresIstat = FormatearParesIStat(ist);
                                                    if (paresIstat.Count > 0)
                                                    {
                                                        <div class="ho-doc-row mb-1">
                                                            <div class="small text-muted mb-1">
                                                                <strong>@ist.Fecha.ToString("dd/MM/yyyy HH:mm")</strong>
                                                                @if (!string.IsNullOrWhiteSpace(ist.QuienIngresa)) { <span> · @ist.QuienIngresa</span> }
                                                            </div>
                                                            <div class="d-flex flex-wrap gap-1">
                                                                @foreach (var kv in paresIstat)
                                                                {
                                                                    <span class="ho-istat-pill"><strong>@kv.Key:</strong> @kv.Value</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }

                                        @if (_informes.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title">Informes y Resultados emitidos (@_informes.Count)</div>
                                                <div class="d-flex flex-column gap-2">
                                                    @foreach (var inf in _informes)
                                                    {
                                                        <div class="ho-doc-row d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                            <div>
                                                                <span class="ho-mini-chip chip-lab me-1">@inf.TipoInforme</span>
                                                                <strong class="small text-dark">@inf.NombreFormato</strong>
                                                                <span class="text-muted small ms-1">· @inf.FechaMod.ToString("dd/MM/yyyy")</span>
                                                            </div>
                                                            <div class="d-flex gap-1">
                                                                @if (!string.IsNullOrWhiteSpace(inf.RutaArchivo))
                                                                {
                                                                    <a class="btn btn-outline-success btn-sm py-0 px-2" href="@NormalizarRutaArchivo(inf.RutaArchivo)" target="_blank" rel="noopener">
                                                                        <i class="bi bi-paperclip me-1"></i>Archivo
                                                                    </a>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(inf.ContenidoHtml))
                                                                {
                                                                    <button type="button" class="btn btn-outline-dark btn-sm py-0 px-2" @onclick="() => ImprimirHtmlAsync(inf.NombreFormato, inf.ContenidoHtml)">
                                                                        <i class="bi bi-printer me-1"></i>Imprimir
                                                                    </button>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- 5. HOSPITALIZACIÓN: INGRESO, FICHA 24H, SIGNOS/BALANCE, MONITOREO Y EVOLUCIONES -->
                            @if (TieneDatosHospitalizacionCargados || _evoluciones.Count > 0)
                            {
                                var b1Resumen = _fichaHosp?.Bloque1Medicacion.Where(x => !string.IsNullOrWhiteSpace(x.Medicacion)).ToList() ?? [];
                                var b2Resumen = _fichaHosp?.Bloque2Alimentacion.Where(x => !string.IsNullOrWhiteSpace(x.Alimentacion)).ToList() ?? [];
                                var b3Resumen = _fichaHosp?.Bloque3Fluidoterapia.Where(x => !string.IsNullOrWhiteSpace(x.Fluidoterapia)).ToList() ?? [];
                                var diasSignosResumen = _signosEnf is not null ? ObtenerDiasSignosConDatos(_signosEnf) : [];
                                var monitoreoResumen = ObtenerResumenMonitoreoUltimoValor();

                                <div class="ho-section-card">
                                    <div class="ho-section-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="ho-icon-bubble tone-hosp"><i class="bi bi-hospital-fill"></i></span>
                                            <span class="fw-bold text-dark small">Hospitalización, Signos de Enfermería y Evoluciones</span>
                                        </div>
                                        <div class="d-flex flex-wrap gap-2">
                                            @if (TieneDatosHospitalizacionCargados)
                                            {
                                                <button type="button" class="ho-jump-btn" @onclick='() => _subtabActiva = "hospitalizacion"'>
                                                    Ver hospitalización completa <i class="bi bi-arrow-right"></i>
                                                </button>
                                            }
                                            @if (_evoluciones.Count > 0)
                                            {
                                                <button type="button" class="ho-jump-btn" @onclick='() => _subtabActiva = "evoluciones"'>
                                                    Ver evoluciones (@_evoluciones.Count) <i class="bi bi-arrow-right"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <div class="ho-section-body d-flex flex-column gap-3">
                                        @if (_ingresoHosp is not null && _ingresoHosp.Id > 0)
                                        {
                                            <div class="ho-kv-grid">
                                                @if (!string.IsNullOrWhiteSpace(_ingresoHosp.UbicacionJaula))
                                                {
                                                    <div class="ho-kv-item"><span class="ho-kv-label">Ubicación / Jaula</span><span class="ho-kv-val fw-semibold">@_ingresoHosp.UbicacionJaula</span></div>
                                                }
                                                @if (_ingresoHosp.FechaIngreso.HasValue)
                                                {
                                                    <div class="ho-kv-item"><span class="ho-kv-label">Fecha de ingreso</span><span class="ho-kv-val">@_ingresoHosp.FechaIngreso.Value.ToString("dd/MM/yyyy HH:mm")</span></div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(_ingresoHosp.Indicaciones))
                                                {
                                                    <div class="ho-kv-item ho-kv-wide"><span class="ho-kv-label">Indicaciones de hospitalización</span><span class="ho-kv-val ho-prose">@_ingresoHosp.Indicaciones</span></div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(_ingresoHosp.HidratacionFluidoterapia))
                                                {
                                                    <div class="ho-kv-item"><span class="ho-kv-label">Hidratación / Fluidoterapia</span><span class="ho-kv-val">@_ingresoHosp.HidratacionFluidoterapia</span></div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(_ingresoHosp.DietaCuidados))
                                                {
                                                    <div class="ho-kv-item"><span class="ho-kv-label">Dieta y cuidados</span><span class="ho-kv-val">@_ingresoHosp.DietaCuidados</span></div>
                                                }
                                            </div>
                                        }

                                        @if (b1Resumen.Count > 0 || b2Resumen.Count > 0 || b3Resumen.Count > 0 || (_fichaHosp?.NotasImportantes.Count ?? 0) > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title">Plan de Ficha 24h (Hoja @_fichaHosp!.Hoja · @_fichaHosp.HojasDisponibles.Count hoja(s) registradas)</div>
                                                <div class="ho-kv-grid">
                                                    @if (b1Resumen.Count > 0)
                                                    {
                                                        <div class="ho-kv-item">
                                                            <span class="ho-kv-label">Medicación en Ficha 24h</span>
                                                            <span class="ho-kv-val small">@string.Join(" · ", b1Resumen.Select(x => $"{x.Medicacion}{(x.Ml.HasValue ? $" ({x.Ml:0.##} ml)" : "")}"))</span>
                                                        </div>
                                                    }
                                                    @if (b3Resumen.Count > 0)
                                                    {
                                                        <div class="ho-kv-item">
                                                            <span class="ho-kv-label">Fluidoterapia 24h</span>
                                                            <span class="ho-kv-val small">@string.Join(" · ", b3Resumen.Select(x => $"{x.Fluidoterapia}{(!string.IsNullOrWhiteSpace(x.MlH) ? $" ({x.MlH} ml/h)" : "")}"))</span>
                                                        </div>
                                                    }
                                                    @if (b2Resumen.Count > 0)
                                                    {
                                                        <div class="ho-kv-item">
                                                            <span class="ho-kv-label">Alimentación 24h</span>
                                                            <span class="ho-kv-val small">@string.Join(" · ", b2Resumen.Select(x => $"{x.Alimentacion}{(!string.IsNullOrWhiteSpace(x.Gr) ? $" ({x.Gr} g)" : "")}"))</span>
                                                        </div>
                                                    }
                                                </div>
                                                @if (_fichaHosp.NotasImportantes.Count > 0)
                                                {
                                                    <div class="mt-2">
                                                        @foreach (var n in _fichaHosp.NotasImportantes.Take(3))
                                                        {
                                                            <div class="ho-note-line">
                                                                <span class="ho-mini-chip chip-danger me-1">Nota importante</span>
                                                                <span class="text-muted small">@n.Fecha.ToString("dd/MM") @n.Hora —</span> @n.Observacion
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (diasSignosResumen.Count > 0 && _signosEnf is not null)
                                        {
                                            <div>
                                                <div class="ho-mini-title">Signos Vitales y Balance Hídrico de Enfermería (@diasSignosResumen.Count día(s))</div>
                                                <div class="table-responsive">
                                                    <table class="ho-table ho-matrix-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Día / Fecha</th>
                                                                <th>Signos AM</th>
                                                                <th>Signos PM</th>
                                                                <th>Balance Hídrico</th>
                                                                <th>Peso / Dieta</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var dia in diasSignosResumen.Take(4))
                                                            {
                                                                var f = _signosEnf.Fechas.FirstOrDefault(x => x.Orden == dia);
                                                                var am = _signosEnf.SignosVitales.FirstOrDefault(x => x.Orden == (dia * 2) - 1);
                                                                var pm = _signosEnf.SignosVitales.FirstOrDefault(x => x.Orden == dia * 2);
                                                                var bal = _signosEnf.BalanceHidrico.FirstOrDefault(x => x.Orden == dia);
                                                                var med = _signosEnf.Mediciones.FirstOrDefault(x => x.Orden == dia);
                                                                <tr>
                                                                    <td class="text-nowrap fw-semibold">Día @dia @(f?.Fecha is not null ? $"({f.Fecha.Value:dd/MM})" : "")</td>
                                                                    <td>@FormatearSlotSigno(am)</td>
                                                                    <td>@FormatearSlotSigno(pm)</td>
                                                                    <td>
                                                                        @if (bal is not null && (bal.TotalIngresos != 0 || bal.TotalEliminaciones != 0))
                                                                        {
                                                                            <span>Ing @bal.TotalIngresos.ToString("0.##") / Egr @bal.TotalEliminaciones.ToString("0.##") (Neto @bal.BalanceNeto.ToString("+0.##;-0.##;0"))</span>
                                                                        }
                                                                        else { <span class="text-muted">—</span> }
                                                                    </td>
                                                                    <td>@(med?.Peso is not null ? $"{med.Peso:0.##} kg" : "") @(!string.IsNullOrWhiteSpace(med?.DietaIndicada) ? $"· {med.DietaIndicada}" : (med?.Peso is null ? "—" : ""))</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        }

                                        @if (monitoreoResumen.Count > 0 || (_monitoreoHosp?.ObservacionesPorHora.Count ?? 0) > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title">Monitoreo Hospitalario 24h — Últimos valores registrados (@(_monitoreoHosp?.HojasDisponibles.Count ?? 1) hoja(s))</div>
                                                @if (monitoreoResumen.Count > 0)
                                                {
                                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                                        @foreach (var m in monitoreoResumen)
                                                        {
                                                            <span class="ho-istat-pill">
                                                                <strong>@m.Parametro:</strong> @m.Valor @m.Unidad <span class="text-muted">(@m.Hora)</span>
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                                @if (_monitoreoHosp?.ObservacionesPorHora.Count > 0)
                                                {
                                                    @foreach (var obs in _monitoreoHosp.ObservacionesPorHora.Take(3))
                                                    {
                                                        <div class="ho-note-line">
                                                            <strong>@obs.Hora</strong> — @obs.Observacion
                                                            @if (!string.IsNullOrWhiteSpace(obs.Responsable)) { <span class="text-muted small">(@obs.Responsable)</span> }
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        }

                                        @if (_evoluciones.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title">Evoluciones médicas (@(_evoluciones.Count > 5 ? $"últimas 5 de {_evoluciones.Count}" : _evoluciones.Count.ToString()))</div>
                                                @foreach (var ev in _evoluciones.Take(5))
                                                {
                                                    <div class="ho-note-line">
                                                        <div class="d-flex flex-wrap justify-content-between gap-1 mb-1">
                                                            <strong class="small text-dark">@ev.Fecha.ToString("dd/MM/yyyy") @ev.Hora · @ev.NombreMedico</strong>
                                                            <span class="text-muted" style="font-size:.72rem;">Evolución #@ev.IdEvolucion</span>
                                                        </div>
                                                        <div class="ho-prose small">@ev.Descripcion</div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- 6. CIRUGÍA Y QUIRÓFANO -->
                            @if (TieneDatosCirugiaCargados)
                            {
                                var ultimoSignoRec = _signosRecuperacion.FirstOrDefault();
                                <div class="ho-section-card">
                                    <div class="ho-section-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="ho-icon-bubble tone-cir"><i class="bi bi-scissors"></i></span>
                                            <span class="fw-bold text-dark small">Cirugía y Quirófano</span>
                                        </div>
                                        <button type="button" class="ho-jump-btn" @onclick='() => _subtabActiva = "cirugia"'>
                                            Ver expediente quirúrgico <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                    <div class="ho-section-body d-flex flex-column gap-3">
                                        @if (_cirugiasProgramadas.Count > 0 || _ordenesCirugia.Count > 0)
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var cp in _cirugiasProgramadas)
                                                {
                                                    <div class="ho-doc-row d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                        <div>
                                                            <strong class="small text-dark">@cp.Procedimiento</strong>
                                                            <div class="text-muted small">
                                                                Cirujano: <strong>@(string.IsNullOrWhiteSpace(cp.Medico) ? "Sin asignar" : cp.Medico)</strong>
                                                                @if (!string.IsNullOrWhiteSpace(cp.Anestesiologo))
                                                                {
                                                                    <span> · Anestesiólogo: <strong>@cp.Anestesiologo</strong></span>
                                                                }
                                                            </div>
                                                        </div>
                                                        <span class="ho-mini-chip chip-cir">@cp.Fecha.ToString("dd/MM/yyyy") · @cp.HoraInicio - @cp.HoraFin</span>
                                                    </div>
                                                }
                                                @foreach (var oc in _ordenesCirugia)
                                                {
                                                    <div class="ho-doc-row d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                        <div>
                                                            <span class="ho-mini-chip chip-cir me-1">Orden de cirugía</span>
                                                            <strong class="small text-dark">@oc.DescripcionCirugia</strong>
                                                            @if (!string.IsNullOrWhiteSpace(oc.Observaciones))
                                                            {
                                                                <span class="text-muted small"> — @oc.Observaciones</span>
                                                            }
                                                        </div>
                                                        <span class="ho-mini-chip chip-neutral">@oc.Estado</span>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="ho-kv-grid">
                                            @if (_checklistPreop is not null && _checklistPreop.Id > 0)
                                            {
                                                <div class="ho-kv-item">
                                                    <span class="ho-kv-label">Recepción / Preoperatorio</span>
                                                    <span class="ho-kv-val">
                                                        @if (_checklistPreop.Pulso > 0) { <span>FC @_checklistPreop.Pulso · </span> }
                                                        @if (_checklistPreop.Saturacion > 0) { <span>SpO2 @_checklistPreop.Saturacion% · </span> }
                                                        @if (_checklistPreop.Peso > 0) { <span>@_checklistPreop.Peso.ToString("0.##") kg</span> }
                                                        @if (!string.IsNullOrWhiteSpace(_checklistPreop.Alergias)) { <div class="small text-danger">Alergias: @_checklistPreop.Alergias</div> }
                                                    </span>
                                                </div>
                                            }
                                            @if (_preAnestesia is not null && _preAnestesia.IdPreAnestesico > 0)
                                            {
                                                <div class="ho-kv-item">
                                                    <span class="ho-kv-label">Preanestesia</span>
                                                    <span class="ho-kv-val">
                                                        ASA @_preAnestesia.Riesgo · @(_preAnestesia.Ebueno == 1 ? "Estado bueno" : _preAnestesia.Edeprimido == 1 ? "Deprimido" : "Evaluado")
                                                        @if (!string.IsNullOrWhiteSpace(_preAnestesia.InformacionEspecial)) { <div class="small text-muted">@_preAnestesia.InformacionEspecial</div> }
                                                    </span>
                                                </div>
                                            }
                                            @if (_pausaSeguridad is not null && _pausaSeguridad.Id > 0)
                                            {
                                                <div class="ho-kv-item">
                                                    <span class="ho-kv-label">Pausa de Seguridad OMS</span>
                                                    <span class="ho-kv-val">Completada (@_pausaSeguridad.Fecha.ToString("dd/MM/yyyy") @_pausaSeguridad.Hora) · Recuento gasas: @TextoSiNo(_pausaSeguridad.Rpta19)</span>
                                                </div>
                                            }
                                            @if (_monAnestesia is not null && _monAnestesia.Id > 0)
                                            {
                                                <div class="ho-kv-item">
                                                    <span class="ho-kv-label">Monitorización Anestesia (AVA)</span>
                                                    <span class="ho-kv-val">
                                                        ASA @_monAnestesia.ClasificacionAsa@(_monAnestesia.EsEmergenciaAsa ? "E" : "")
                                                        @if (!string.IsNullOrWhiteSpace(_monAnestesia.Anestesista)) { <span> · Anest.: @_monAnestesia.Anestesista</span> }
                                                        @if (_monAnestesia.UsaAnestesiaInhalatoria && !string.IsNullOrWhiteSpace(_monAnestesia.NombreProductoAnestesia)) { <span> · @_monAnestesia.NombreProductoAnestesia</span> }
                                                        @if (!string.IsNullOrWhiteSpace(_monAnestesia.PostoperatorioNotas)) { <div class="small text-muted mt-1">@_monAnestesia.PostoperatorioNotas</div> }
                                                    </span>
                                                </div>
                                            }
                                            @if (_protocolo is not null && _protocolo.IdProtocolo > 0)
                                            {
                                                <div class="ho-kv-item ho-kv-wide">
                                                    <span class="ho-kv-label">Protocolo Quirúrgico</span>
                                                    <span class="ho-kv-val">
                                                        <strong>@(!string.IsNullOrWhiteSpace(_protocolo.Principal) ? _protocolo.Principal : _protocolo.TipoCirugia)</strong>
                                                        @if (_protocolo.DuracionMinutos > 0) { <span class="text-muted"> · @_protocolo.DuracionMinutos min</span> }
                                                        <span class="text-muted"> · Sangrado: @_protocolo.Sangrado ml · Complicaciones: @_protocolo.Complicaciones · Destino: @_protocolo.TransferidoA</span>
                                                        @if (!string.IsNullOrWhiteSpace(_protocolo.Hallazgos)) { <div class="ho-prose small mt-1"><strong>Hallazgos:</strong> @_protocolo.Hallazgos</div> }
                                                        @if (!string.IsNullOrWhiteSpace(_protocolo.ProcedimientoQuir)) { <div class="ho-prose small mt-1"><strong>Procedimiento:</strong> @_protocolo.ProcedimientoQuir</div> }
                                                        @if (_protocolo.Equipo.Count > 0)
                                                        {
                                                            <div class="small text-muted mt-1"><strong>Equipo:</strong> @string.Join(" · ", _protocolo.Equipo.Select(m => $"{m.NombreProfesional} ({m.RolFuncion})"))</div>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                            @if (_postOperatorio is not null && _postOperatorio.Id > 0)
                                            {
                                                <div class="ho-kv-item">
                                                    <span class="ho-kv-label">Salida de recuperación</span>
                                                    <span class="ho-kv-val">Destino: <strong>@_postOperatorio.Destino</strong> @(_postOperatorio.FechaHoraSalida.HasValue ? $"({_postOperatorio.FechaHoraSalida.Value:dd/MM HH:mm})" : "")</span>
                                                </div>
                                            }
                                            @if (ultimoSignoRec is not null)
                                            {
                                                <div class="ho-kv-item">
                                                    <span class="ho-kv-label">Último control recuperación (@ultimoSignoRec.Hora)</span>
                                                    <span class="ho-kv-val">FC @ultimoSignoRec.Pulso · PA @ultimoSignoRec.Sistolica/@ultimoSignoRec.Diastolica · FR @ultimoSignoRec.Respiracion · T @ultimoSignoRec.Temperatura.ToString("0.0")°C · SpO2 @ultimoSignoRec.Saturacion%</span>
                                                </div>
                                            }
                                        </div>

                                        @if (_obsRecuperacion.Count > 0)
                                        {
                                            <div>
                                                <div class="ho-mini-title">Observaciones de recuperación</div>
                                                @foreach (var o in _obsRecuperacion.Take(3))
                                                {
                                                    <div class="ho-note-line"><strong>@o.Fecha.ToString("dd/MM") @o.Hora</strong> — @o.Observacion</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- 7. CONSENTIMIENTOS Y ALTA MÉDICA -->
                            @if (_autorizaciones.Count > 0 || TieneAltaMedica)
                            {
                                <div class="ho-section-card">
                                    <div class="ho-section-header">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="ho-icon-bubble tone-doc"><i class="bi bi-file-earmark-check-fill"></i></span>
                                            <span class="fw-bold text-dark small">Consentimientos y Alta Médica</span>
                                        </div>
                                        <button type="button" class="ho-jump-btn" @onclick='() => _subtabActiva = "consentimientos"'>
                                            Ver documentos <i class="bi bi-arrow-right"></i>
                                        </button>
                                    </div>
                                    <div class="ho-section-body d-flex flex-column gap-3">
                                        @if (_autorizaciones.Count > 0)
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var auth in _autorizaciones)
                                                {
                                                    <div class="ho-doc-row d-flex flex-wrap justify-content-between align-items-center gap-2">
                                                        <div>
                                                            <strong class="small text-dark">@auth.Documento</strong>
                                                            @if (!string.IsNullOrWhiteSpace(auth.ArchivoUrl))
                                                            {
                                                                <span class="ho-mini-chip chip-evol ms-1">Firmado / Escaneado</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="ho-mini-chip chip-hosp ms-1">Emitido</span>
                                                            }
                                                        </div>
                                                        <div class="d-flex gap-1">
                                                            @if (!string.IsNullOrWhiteSpace(auth.ArchivoUrl))
                                                            {
                                                                <a class="btn btn-outline-success btn-sm py-0 px-2" href="@auth.ArchivoUrl" target="_blank" rel="noopener">Ver escaneo</a>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(auth.DetalleHtml))
                                                            {
                                                                <button type="button" class="btn btn-outline-dark btn-sm py-0 px-2" @onclick="() => ImprimirHtmlAsync(auth.Documento, auth.DetalleHtml)">
                                                                    <i class="bi bi-printer me-1"></i>Imprimir
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (TieneAltaMedica)
                                        {
                                            <div>
                                                <div class="ho-mini-title"><i class="bi bi-box-arrow-right me-1 text-success"></i>Alta Médica (@_formularioAlta!.FechaIng.ToString("dd/MM/yyyy HH:mm"))</div>
                                                <div class="ho-kv-grid">
                                                    @if (!string.IsNullOrWhiteSpace(_formularioAlta.CuidadosGenerales))
                                                    {
                                                        <div class="ho-kv-item ho-kv-wide"><span class="ho-kv-label">Cuidados generales</span><span class="ho-kv-val ho-prose">@_formularioAlta.CuidadosGenerales</span></div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(_formularioAlta.Medicacion))
                                                    {
                                                        <div class="ho-kv-item ho-kv-wide"><span class="ho-kv-label">Medicación al alta</span><span class="ho-kv-val ho-prose">@_formularioAlta.Medicacion</span></div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(_formularioAlta.Dieta))
                                                    {
                                                        <div class="ho-kv-item"><span class="ho-kv-label">Dieta</span><span class="ho-kv-val ho-prose">@_formularioAlta.Dieta</span></div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(_formularioAlta.Permitido))
                                                    {
                                                        <div class="ho-kv-item"><span class="ho-kv-label">Permitido</span><span class="ho-kv-val ho-prose">@_formularioAlta.Permitido</span></div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(_formularioAlta.NoPermitido))
                                                    {
                                                        <div class="ho-kv-item"><span class="ho-kv-label">No permitido</span><span class="ho-kv-val ho-prose">@_formularioAlta.NoPermitido</span></div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else if (_subtabActiva == "evoluciones")
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var ev in _evoluciones)
                        {
                            <div class="ho-section-card">
                                <div class="ho-section-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="ho-icon-bubble tone-evol"><i class="bi bi-activity"></i></span>
                                        <div>
                                            <div class="fw-bold text-dark small">Evolución #@ev.IdEvolucion · @ev.Fecha.ToString("dd/MM/yyyy") @ev.Hora</div>
                                            <div class="text-muted" style="font-size:.76rem;">Registrado por: @ev.NombreMedico</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="ho-section-body">
                                    <div class="ho-prose">@ev.Descripcion</div>

                                    @if (ev.MedicamentosAsociados.Count > 0 || ev.ExamenesLabAsociados.Count > 0 || ev.ExamenesImagenAsociados.Count > 0)
                                    {
                                        <div class="mt-3 pt-2 border-top d-flex flex-wrap gap-2">
                                            @foreach (var med in ev.MedicamentosAsociados)
                                            {
                                                <span class="ho-mini-chip chip-rx"><i class="bi bi-capsule me-1"></i>@med.ProdDescripcion (@med.CantProd.ToString("0.##"))</span>
                                            }
                                            @foreach (var lab in ev.ExamenesLabAsociados)
                                            {
                                                <span class="ho-mini-chip chip-lab"><i class="bi bi-eyedropper me-1"></i>Lab: @lab.DescripcionExamen</span>
                                            }
                                            @foreach (var img in ev.ExamenesImagenAsociados)
                                            {
                                                <span class="ho-mini-chip chip-img"><i class="bi bi-card-image me-1"></i>Imagen: @img.DescripcionExamen</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_subtabActiva == "receta")
                {
                    <div class="d-flex flex-column gap-3">
                        @if (!string.IsNullOrWhiteSpace(_indicacionesGenerales))
                        {
                            <div class="ho-callout-info">
                                <div class="fw-bold small text-primary mb-1"><i class="bi bi-info-circle-fill me-1"></i>Indicaciones generales de la receta</div>
                                <div class="ho-prose small text-dark">@_indicacionesGenerales</div>
                            </div>
                        }

                        @if (_receta.Count > 0)
                        {
                            <div class="ho-section-card">
                                <div class="ho-section-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="ho-icon-bubble tone-rx"><i class="bi bi-capsule"></i></span>
                                        <span class="fw-bold text-dark small">Prescripción / Receta Médica</span>
                                    </div>
                                    <span class="ho-count-pill">@_receta.Count ítem(s)</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="ho-table">
                                        <thead>
                                            <tr>
                                                <th>Medicamento / Insumo</th>
                                                <th style="width:90px;">Tipo</th>
                                                <th style="width:85px;">Cant.</th>
                                                <th>Indicaciones / Posología</th>
                                                <th>Observaciones</th>
                                                <th style="width:105px;">Fecha</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in _receta)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(item.CodigoProd) && item.CodigoProd != "0")
                                                        {
                                                            <span class="ho-code-chip">@item.CodigoProd</span>
                                                        }
                                                        <span class="fw-semibold text-dark">@item.Descripcionamento</span>
                                                    </td>
                                                    <td>
                                                        <span class="ho-mini-chip @(item.Tipo == "I" ? "chip-neutral" : "chip-rx")">
                                                            @(item.Tipo == "I" ? "Insumo" : "Receta")
                                                        </span>
                                                    </td>
                                                    <td class="fw-semibold">@item.Cantidad.ToString("0.##")</td>
                                                    <td>@(string.IsNullOrWhiteSpace(item.Indicaciones) ? "—" : item.Indicaciones)</td>
                                                    <td class="text-muted">@(string.IsNullOrWhiteSpace(item.Observaciones) ? "—" : item.Observaciones)</td>
                                                    <td class="text-nowrap">@item.Fecha.ToString("dd/MM/yyyy")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        @if (_aplicadosConsulta.Count > 0)
                        {
                            <div class="ho-section-card">
                                <div class="ho-section-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="ho-icon-bubble tone-evol"><i class="bi bi-eyedropper"></i></span>
                                        <span class="fw-bold text-dark small">Aplicados en Consulta</span>
                                    </div>
                                    <span class="ho-count-pill">@_aplicadosConsulta.Count ítem(s)</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="ho-table">
                                        <thead>
                                            <tr>
                                                <th>Medicamento / Insumo</th>
                                                <th style="width:85px;">Cant.</th>
                                                <th>Indicaciones</th>
                                                <th>Observaciones</th>
                                                <th style="width:105px;">Fecha</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in _aplicadosConsulta)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(item.CodigoProd) && item.CodigoProd != "0")
                                                        {
                                                            <span class="ho-code-chip">@item.CodigoProd</span>
