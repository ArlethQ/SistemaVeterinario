    private static string TextoEstadoOrden(string? estado, string? etapa)
    {
        var est = (estado ?? string.Empty).Trim().ToUpperInvariant();
        if (!string.IsNullOrWhiteSpace(etapa))
            return etapa;
        return est switch
        {
            "A" => "Activa",
            "E" => "En atención",
            "T" or "F" or "C" => "Finalizada",
            "I" or "X" => "Anulada",
            _ => string.IsNullOrWhiteSpace(estado) ? "Registrada" : estado
        };
    }

    private static string ClaseEstadoOrden(string? estado) => (estado ?? string.Empty).Trim().ToUpperInvariant() switch
    {
        "A" or "E" => "state-active",
        "T" or "F" or "C" => "state-done",
        "I" or "X" => "state-cancel",
        _ => "state-neutral"
    };

    private static async Task<T> SafeAsync<T>(Func<Task<T>> action, T fallback)
    {
        try
        {
            var res = await action();
            return res is null ? fallback : res;
        }
        catch
        {
            return fallback;
        }
    }

    private static async Task<T?> SafeNullableAsync<T>(Func<Task<T>> action, T? fallback = null) where T : class
    {
        try
        {
            return await action();
        }
        catch
        {
            return fallback;
        }
    }
