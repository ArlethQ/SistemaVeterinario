@inject IAdmisionFacturacionService Admision
@inject ILogger<ProcedimientosTriaje> Logger

<section class="mt-3 pt-3 border-top" style="grid-column: 1 / -1;" aria-label="Procedimientos">
    <h2 class="h6 fw-bold">Procedimientos</h2>

    @if (_errorLista)
    {
        <p class="text-danger small" role="alert">No se pudieron cargar los procedimientos de la orden.</p>
    }
    @if (_mensaje is not null)
    {
        <p class="text-danger small" role="alert">@_mensaje</p>
    }

    @if (!SoloLectura)
    {
        <fieldset class="row g-2 m-0 mb-3 p-2 bg-light border rounded align-items-end" disabled="@(_cargandoCatalogo || _agregando)">
            <label class="col-md-2 small fw-semibold">
                Categoría de servicio
                <input class="form-control form-control-sm" value="Procedimientos" readonly />
            </label>
            <label class="col-md-2 small fw-semibold">
                Subcategoría
                <select class="form-select form-select-sm" @bind="_subcategoria" @bind:after="LimpiarSeleccion">
                    <option value="0">Todas las subcategorías</option>
                    @foreach (var grupo in _subcategorias)
                    {
                        <option value="@grupo.IdSubgrupo">@grupo.Subgrupo</option>
                    }
                </select>
            </label>
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1" for="@($"buscar-procedimiento-{_identificador}")">Tipo de servicio (Catálogo PRODUCTO)</label>
                <div class="input-group input-group-sm">
                    <input id="@($"buscar-procedimiento-{_identificador}")" type="search" class="form-control" placeholder="Buscar por nombre o código"
                           @bind="_busqueda" @bind:event="oninput" @bind:after="AbrirSugerencias" />
                    <button type="button" class="btn btn-outline-secondary" aria-label="Mostrar procedimientos"
                            aria-expanded="@_mostrarSugerencias" @onclick="() => _mostrarSugerencias = !_mostrarSugerencias">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                </div>
                @if (_mostrarSugerencias)
                {
                    <div class="position-relative">
                        <div class="list-group position-absolute start-0 end-0 shadow-sm overflow-auto z-3" style="max-height: 12rem;">
                            @foreach (var procedimiento in Coincidencias)
                            {
                                <button type="button" class="list-group-item list-group-item-action small py-1"
                                        @onclick="() => Seleccionar(procedimiento)">
                                    @procedimiento.Descripcion <small class="text-muted">@procedimiento.Codigo</small>
                                </button>
                            }
                            @if (!Coincidencias.Any())
                            {
                                <div class="list-group-item small text-muted">No se encontraron procedimientos disponibles.</div>
                            }
                        </div>
                    </div>
                }
            </div>
            <label class="col-md-1 small fw-semibold">
                Cant.
                <input type="number" min="1" class="form-control form-control-sm" @bind="_cantidad" />
            </label>
            <label class="col-md-2 small fw-semibold">
                Observaciones
                <input class="form-control form-control-sm" maxlength="250" @bind="_observaciones" />
            </label>
            <div class="col-md-1">
                <button type="button" class="btn btn-sm btn-primary w-100" aria-label="Agregar procedimiento"
                        disabled="@(_cargando || _seleccion is null || _cantidad < 1)" @onclick="AgregarSeleccionAsync">
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>
        </fieldset>
        @if (_cargandoCatalogo)
        {
            <p class="text-muted small" role="status">Cargando catálogo…</p>
        }
        else if (_catalogo.Count == 0 && _mensaje is null)
        {
            <p class="text-muted small">No se encontraron artículos activos de Procedimientos para la sede de esta orden.</p>
        }
    }
    @if (!_errorLista)
    {
        <div class="bg-info-subtle border rounded-top px-2 py-1 text-primary small fw-bold">Procedimientos de la orden (@_registrados.Count)</div>
        <div class="table-responsive border border-top-0 rounded-bottom">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr><th scope="col">Procedimiento</th><th scope="col">Subcategoría</th><th scope="col">Cant.</th><th scope="col">Observaciones</th><th scope="col">Precio unit.</th><th scope="col">Estado</th></tr>
                </thead>
                <tbody>
                    @foreach (var procedimiento in _registrados)
                    {
                        <tr><td>@procedimiento.Descripcion</td><td>@procedimiento.Subgrupo</td><td>@procedimiento.Cantidad</td><td>@procedimiento.Observaciones</td><td>@(procedimiento.Precio?.ToString("N2") ?? "—")</td><td>@procedimiento.Estado</td></tr>
                    }
                    @if (_cargando)
                    {
                        <tr><td colspan="6" class="text-muted" role="status">Cargando procedimientos…</td></tr>
                    }
                    else if (_registrados.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted">Aún no hay procedimientos registrados.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter] public int IdOrden { get; set; }
    [Parameter] public int Nhcl { get; set; }
    [Parameter] public bool DesdeHistorial { get; set; }
    [Parameter] public bool DesdeSoap { get; set; }
    [Parameter] public bool SoloLectura { get; set; }

    private List<CatalogoOperativoDto> _catalogo = [];
    private List<CatalogoOperativoDto> _subcategorias = [];
    private List<ProcedimientoTriajeDto> _registrados = [];
    private bool _cargando = true;
    private bool _cargandoCatalogo = true;
    private bool _agregando;
    private bool _errorLista;
    private string? _mensaje;
    private string _busqueda = "";
    private int _subcategoria;
    private int _cantidad = 1;
    private string _observaciones = "";
    private readonly string _identificador = Guid.NewGuid().ToString("N");
    private bool _mostrarSugerencias;
    private CatalogoOperativoDto? _seleccion;

    private void LimpiarSeleccion()
    {
        _seleccion = null;
        _busqueda = "";
        _mostrarSugerencias = false;
    }

    private void AbrirSugerencias()
    {
        _seleccion = null;
        _mostrarSugerencias = true;
    }

    private void Seleccionar(CatalogoOperativoDto procedimiento)
    {
        _seleccion = procedimiento;
        _busqueda = procedimiento.Descripcion;
        _mostrarSugerencias = false;
    }

    private Task AgregarSeleccionAsync() =>
        _seleccion is { } procedimiento ? AgregarAsync(procedimiento.Id) : Task.CompletedTask;

    private IEnumerable<CatalogoOperativoDto> Coincidencias => _catalogo.Where(p =>
        (_subcategoria == 0 || p.IdSubgrupo == _subcategoria)
        && (p.Descripcion.Contains(_busqueda.Trim(), StringComparison.OrdinalIgnoreCase)
            || p.Codigo.Contains(_busqueda.Trim(), StringComparison.OrdinalIgnoreCase))
        && !_registrados.Any(r => r.Id == p.Id));

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarCatalogoAsync(), CargarRegistradosAsync());
    }

    private async Task CargarCatalogoAsync()
    {
        if (!SoloLectura)
        {
            try
            {
                _catalogo = await Admision.ObtenerCatalogoProcedimientosTriajeAsync(IdOrden, Nhcl);
                _subcategorias = _catalogo.Where(p => p.IdSubgrupo > 0 && !string.IsNullOrWhiteSpace(p.Subgrupo))
                    .DistinctBy(p => p.IdSubgrupo).OrderBy(p => p.Subgrupo).ToList();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error al cargar el catálogo de procedimientos");
                _mensaje = "No se pudo cargar el catálogo de Procedimientos.";
            }
        }
        _cargandoCatalogo = false;
        StateHasChanged();
    }

    private async Task CargarRegistradosAsync()
    {
        try
        {
            _registrados = await Admision.ObtenerProcedimientosTriajeAsync(IdOrden, Nhcl);
            _errorLista = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar los procedimientos de la orden {Orden}", IdOrden);
            _errorLista = true;
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    private async Task AgregarAsync(int idProducto)
    {
        if (SoloLectura || _cargando || _agregando || !Coincidencias.Any(p => p.Id == idProducto))
            return;

        _agregando = true;
        _mensaje = null;
        try
        {
            var agregado = await Admision.AgregarProcedimientoTriajeAsync(IdOrden, Nhcl, idProducto, _cantidad, _observaciones.Trim(), DesdeHistorial, DesdeSoap);
            await CargarRegistradosAsync();
            if (agregado || _registrados.Any(p => p.Id == idProducto))
            {
                LimpiarSeleccion();
                _cantidad = 1;
                _observaciones = "";
            }
            else
                _mensaje = "No se pudo agregar el procedimiento. Verifica que el triaje siga disponible para edición.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al agregar el procedimiento {Producto} a la orden {Orden}", idProducto, IdOrden);
            _mensaje = "No se pudo guardar el procedimiento.";
        }
        finally
        {
            _agregando = false;
        }
    }
}
