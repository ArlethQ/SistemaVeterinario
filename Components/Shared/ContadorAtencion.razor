@implements IDisposable

@if (Destacado)
{
    <span class="atencion-tiempo">
        <span>@Etiqueta</span>
        <strong>@TiempoFormateado</strong>
    </span>
}
else
{
    <span class="badge bg-light text-dark border">@Etiqueta @TiempoFormateado</span>
}

@code {
    [Parameter, EditorRequired] public DateTime InicioUtc { get; set; }
    [Parameter] public DateTime? FinUtc { get; set; }
    [Parameter, EditorRequired] public string Etiqueta { get; set; } = "";
    [Parameter] public bool Destacado { get; set; }

    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(1));
    private TimeSpan Duracion => TimeSpan.FromSeconds(Math.Max(0, ((FinUtc ?? DateTime.UtcNow) - InicioUtc).TotalSeconds));
    private string TiempoFormateado
    {
        get
        {
            var duracion = Duracion;
            return $"{(int)duracion.TotalHours:00}:{duracion.Minutes:00}:{duracion.Seconds:00}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        while (await _timer.WaitForNextTickAsync())
        {
            if (FinUtc.HasValue)
                return;

            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => _timer.Dispose();
}
