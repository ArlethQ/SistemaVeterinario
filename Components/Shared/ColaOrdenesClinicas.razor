@implements IDisposable
@inject IAdmisionFacturacionService AdmisionService
@inject SessionStateService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<ColaOrdenesClinicas> Logger

<section class="card shadow-sm border-0 mb-3" aria-label="Cola de órdenes">
    <div class="card-header bg-white d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <h5 class="mb-0">@(UnificarConTriaje ? "Cola de órdenes" : Triaje ? "Cola de triaje" : "Cola de consulta") <span class="badge text-bg-secondary">@_ordenes.Count</span></h5>
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CambiarSonidoAsync" aria-pressed="@(_sonidoActivo ? "true" : "false")">
            @(_sonidoActivo ? "Silenciar emergencias" : "Activar sonido de emergencias")
        </button>
    </div>
    @if (_error is not null)
    {
        <p class="text-danger small p-3 mb-0" role="status">@_error</p>
    }
    @{ var emergencias = _ordenes.Count(EmergenciaSinConfirmar); }
    <div role="status" aria-live="assertive">
        @if (emergencias > 0)
        {
            <div class="alert alert-danger rounded-0 mb-0">
                <strong>Emergencias en espera (@emergencias)</strong>
            </div>
        }
    </div>
    @if (_ordenes.Count == 0)
    {
        <p class="text-muted p-3 mb-0">@(_cargada ? "No hay órdenes en cola." : "Cargando órdenes…")</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                    <tr><th scope="col">Hora de asignación</th><th scope="col">Orden</th><th scope="col">Paciente</th>@if (Triaje) { <th scope="col">Especie</th><th scope="col">Especialidad</th> }<th scope="col">Asignado a</th>@if (UnificarConTriaje) { <th scope="col">Etapa</th> }<th scope="col">Estado</th><th scope="col">Recepción</th><th scope="col">Acción</th></tr>
                </thead>
                @foreach (var grupo in _ordenes.GroupBy(Prioridad).OrderBy(g => g.Key))
                {
                    <tbody>
                        <tr><th scope="rowgroup" colspan="@(7 + (Triaje ? 2 : 0) + (UnificarConTriaje ? 1 : 0))" class="@ClasePrioridad(grupo.Key)">@TextoPrioridad(grupo.Key) · @grupo.Count(EstaEnEspera) en espera</th></tr>
                        @foreach (var orden in grupo)
                        {
                            <tr @key="orden.IdOrden" class="@(OrdenSeleccionada == orden.IdOrden ? "table-active" : null)">
                                <td>
                                    @if (orden.FechaAsignacion.Date < _dia)
                                    {
                                        <span class="d-block small text-muted">@orden.FechaAsignacion.ToString("dd/MM/yyyy")</span>
                                    }
                                    <span>@orden.FechaAsignacion.ToString("HH:mm:ss")</span>
                                </td>
                                <td>#@orden.IdOrden @orden.Turno</td>
                                <td>@orden.Mascota <small class="text-muted">NHCL #@orden.Nhcl</small></td>
                                @if (Triaje) { <td>@orden.Especie</td><td>@orden.Especialidad</td> }
                                <td>@(EsTriaje(orden) && (!orden.TriajeMedico || orden.EsProcedimiento) ? (string.IsNullOrWhiteSpace(orden.Enfermero) ? "Disponible" : orden.Enfermero) : orden.Medico)</td>
                                @if (UnificarConTriaje) { <td>@(EsTriaje(orden) ? "Triaje" : "Consulta")</td> }
                                <td>
                                    <div class="d-flex flex-column align-items-start gap-1">
                                        <span>@(EstaEnEspera(orden) ? "En espera" : "En atención")</span>
                                        <ContadorAtencion @key="(orden.IdOrden, orden.FechaAsignacion, FinEsperaUtc(orden))"
                                                          Etiqueta="Espera"
                                                          InicioUtc="AClinicaUtc(orden.FechaAsignacion)"
                                                          FinUtc="FinEsperaUtc(orden)" />
                                    </div>
                                </td>
                                <td>
                                    @if (orden.FechaRecepcion is DateTime recepcion)
                                    {
                                        <span>@orden.RecibidaPor <small class="text-muted">@recepcion.ToString("HH:mm:ss")</small></span>
                                    }
                                </td>
                                <td>
                                    @if (orden.PuedeAbrirCola)
                                    {
                                        <div class="d-flex flex-wrap align-items-center gap-1">
                                            <a class="btn btn-sm btn-outline-primary" href="@RutaOrden(orden)">@(TextoAccion(orden)) <span class="visually-hidden">orden #@orden.IdOrden</span></a>
                                            @if (!Triaje && !EstaEnEspera(orden))
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-warning text-dark"
                                                        title="Regresar esta orden a En espera"
                                                        disabled="@_procesandoCola"
                                                        @onclick="() => PasarOrdenAEsperaAsync(orden)">
                                                    En espera
                                                </button>
                                            }
                                            @if (!Triaje)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Eliminar / anular esta orden abierta de la cola"
                                                        disabled="@_procesandoCola"
                                                        @onclick="() => EliminarOrdenColaAsync(orden)">
                                                    Eliminar
                                                </button>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Atiende el responsable asignado</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>
    }
</section>

@code {
    [Parameter] public bool Triaje { get; set; }
    [Parameter] public bool AbrirEnSoap { get; set; }
    [Parameter] public bool UnificarConTriaje { get; set; }
    [Parameter] public int OrdenSeleccionada { get; set; }

    private readonly CancellationTokenSource _cancelacion = new();
    private readonly HashSet<(int Id, DateTime Asignacion)> _vistas = [];
    private List<OrdenAtencionResumenDto> _ordenes = [];
    private bool EsTriaje(OrdenAtencionResumenDto orden) => Triaje || (UnificarConTriaje && orden.FinTriaje is null);
    private DateTime _dia;
    private bool _cargada;
    private bool _sonidoActivo;
    private string? _error;

    private string TextoAccion(OrdenAtencionResumenDto orden)
    {
        if (Triaje) return orden.InicioTriaje is null ? "Iniciar triaje" : "Abrir";
        return orden.InicioConsulta is null ? "Iniciar consulta" : "Abrir";
    }

    private string RutaOrden(OrdenAtencionResumenDto orden) =>
        $"{(Triaje && !AbrirEnSoap ? "/admision/triaje" : "/consulta/fichamedica")}/{orden.IdOrden}/{orden.Nhcl}";

    private static int Prioridad(OrdenAtencionResumenDto orden) => orden.ColorTriaje?.Trim().ToLowerInvariant() switch
    {
        "red" => 0,
        "yellow" => 1,
        _ => 2
    };

    private static string TextoPrioridad(int prioridad) => prioridad switch
    {
        0 => "Emergencia",
        1 => "Prioritario",
        _ => "Estándar"
    };

    private static string ClasePrioridad(int prioridad) => prioridad switch
    {
        0 => "text-bg-danger",
        1 => "text-bg-warning",
        _ => "text-bg-success"
    };

    private bool EstaEnEspera(OrdenAtencionResumenDto orden) =>
        Triaje ? orden.InicioTriaje is null : orden.InicioConsulta is null;

    private static DateTime AClinicaUtc(DateTime fechaClinica) =>
        DateTime.SpecifyKind(fechaClinica.AddHours(5), DateTimeKind.Utc);

    private DateTime? FinEsperaUtc(OrdenAtencionResumenDto orden)
    {
        var finLocal = Triaje ? orden.InicioTriaje : (orden.InicioConsulta ?? orden.FinConsulta);
        if (finLocal is not DateTime fin)
            return null;
        return AClinicaUtc(fin < orden.FechaAsignacion ? orden.FechaAsignacion : fin);
    }

    private bool EmergenciaSinConfirmar(OrdenAtencionResumenDto orden) =>
        Prioridad(orden) == 0 && EstaEnEspera(orden) && orden.FechaRecepcion is null;

    private bool _disposed;
    private bool _actualizando;
    private bool _procesandoCola;

    private async Task PasarOrdenAEsperaAsync(OrdenAtencionResumenDto orden)
    {
        if (_procesandoCola || _disposed) return;
        _procesandoCola = true;
        try
        {
            if (await AdmisionService.PasarOrdenAEsperaAsync(orden.IdOrden))
            {
                await ActualizarAsync(_cancelacion.Token, permitirSonido: false);
                if (OrdenSeleccionada == orden.IdOrden)
                {
                    if (Session.OrdenActiva == orden.IdOrden)
                        Session.LimpiarOrdenActiva();
                    Nav.NavigateTo("/consulta/fichamedica");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo pasar la orden {IdOrden} a espera.", orden.IdOrden);
        }
        finally
        {
            _procesandoCola = false;
        }
    }

    private async Task EliminarOrdenColaAsync(OrdenAtencionResumenDto orden)
    {
        if (_procesandoCola || _disposed) return;
        _procesandoCola = true;
        try
        {
            if (await AdmisionService.AnularOrdenAsync(orden.IdOrden, Session.IdUser > 0 ? Session.IdUser : 1))
            {
                await ActualizarAsync(_cancelacion.Token, permitirSonido: false);
                if (OrdenSeleccionada == orden.IdOrden)
                {
                    if (Session.OrdenActiva == orden.IdOrden)
                        Session.LimpiarOrdenActiva();
                    Nav.NavigateTo("/consulta/fichamedica");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo eliminar/anular la orden {IdOrden} de la cola.", orden.IdOrden);
        }
        finally
        {
            _procesandoCola = false;
        }
    }

    public Task RefrescarAsync()
    {
        if (_disposed) return Task.CompletedTask;
        try
        {
            var token = _cancelacion.Token;
            return token.IsCancellationRequested ? Task.CompletedTask : ActualizarAsync(token);
        }
        catch (ObjectDisposedException)
        {
            return Task.CompletedTask;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (_disposed) return;
        await ActualizarAsync(_cancelacion.Token, permitirSonido: false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;

        CancellationToken token;
        try
        {
            token = _cancelacion.Token;
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        if (token.IsCancellationRequested) return;

        try
        {
            _sonidoActivo = await JS.InvokeAsync<bool>("hosvetColaClinica.obtenerPreferencia");
            if (_disposed || token.IsCancellationRequested) return;
            if (_sonidoActivo)
            {
                await JS.InvokeVoidAsync("hosvetColaClinica.prepararAutoActivacion");
                if (_disposed || token.IsCancellationRequested) return;
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException or TaskCanceledException)
        {
            Logger.LogDebug(ex, "No se pudo restaurar la preferencia de sonido de la cola clínica.");
        }

        if (!_disposed && !token.IsCancellationRequested)
        {
            _ = ActualizarPeriodicamenteAsync(token);
        }
    }

    private async Task ActualizarPeriodicamenteAsync(CancellationToken token)
    {
        using var reloj = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await reloj.WaitForNextTickAsync(token))
            {
                await ActualizarAsync(token, permitirSonido: true);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
    }

    private async Task ActualizarAsync(CancellationToken token, bool permitirSonido = true)
    {
        if (_actualizando) return;
        _actualizando = true;
        bool hayNuevasEmergencias = false;
        try
        {
            var dia = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(-5)).Date;
            var ordenes = await AdmisionService.ObtenerColaClinicaAsync(Triaje);
            token.ThrowIfCancellationRequested();
            if (dia != _dia)
            {
                _vistas.Clear();
                _dia = dia;
            }

            foreach (var orden in ordenes.Where(EmergenciaSinConfirmar))
                hayNuevasEmergencias |= _vistas.Add((orden.IdOrden, orden.FechaAsignacion));

            _ordenes = ordenes;
            hayNuevasEmergencias &= _cargada;
            _cargada = true;
            _error = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "No se pudo actualizar la cola clínica.");
            _error = "No se pudo actualizar la cola. Se volverá a intentar.";
        }
        finally
        {
            _actualizando = false;
        }

        token.ThrowIfCancellationRequested();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        if (permitirSonido && hayNuevasEmergencias && _sonidoActivo)
        {
            try
            {
                await JS.InvokeVoidAsync("hosvetColaClinica.sonar", token);
            }
            catch (JSException ex)
            {
                Logger.LogDebug(ex, "No se pudo reproducir el aviso de la cola clínica.");
            }
        }
    }

    private async Task CambiarSonidoAsync()
    {
        if (_sonidoActivo)
        {
            _sonidoActivo = false;
            try
            {
                await JS.InvokeVoidAsync("hosvetColaClinica.guardarPreferencia", false);
            }
            catch (JSException ex)
            {
                Logger.LogDebug(ex, "No se pudo guardar la preferencia de sonido.");
            }
            return;
        }

        try
        {
            _sonidoActivo = await JS.InvokeAsync<bool>("hosvetColaClinica.activar");
            await JS.InvokeVoidAsync("hosvetColaClinica.guardarPreferencia", _sonidoActivo);
            if (_sonidoActivo)
            {
                await JS.InvokeVoidAsync("hosvetColaClinica.sonar");
            }
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "No se pudo activar el sonido de la cola clínica.");
        }
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        try
        {
            _cancelacion.Cancel();
        }
        catch (ObjectDisposedException) { }
        _cancelacion.Dispose();
    }
}
