@inherits LayoutComponentBase
@inject SessionStateService Session
@inject NavigationManager Nav

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-light border-bottom shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary fs-6">HOSVET USFQ</span>
                <span class="text-secondary fw-semibold small">@Session.LocalidadDescripcion</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="small text-dark">
                    <strong>Usuario:</strong> @Session.NombreUsuario (@Session.Iniciales)
                </span>
                <a href="/login" class="btn btn-sm btn-outline-danger">Cambiar Usuario / Salir</a>
            </div>
        </div>

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado en la aplicación.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
