@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject SessionStateService Session
@inject IAuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page">
    <aside class="sidebar">
        <a class="sidebar-brand" href="/dashboard"><img class="brand-logo" src="/favicon.png" alt="" /><span><strong>e-ForVets</strong><small>Gestión veterinaria</small></span></a>
        <NavMenu />
    </aside>
    <main class="workspace">
        <header class="workspace-header">
            <div class="workspace-brand">
                <span class="mobile-mark">H</span>
                <div>
                    <small>Hospital Veterinario</small>
                    @if (Session.IsAuthenticated && Session.EsAdministrador && _localidades.Count > 1)
                    {
                        <select class="form-select form-select-sm fw-bold mt-1" style="min-width: 170px;" value="@Session.Localidad" @onchange="CambiarSucursalAsync" aria-label="Cambiar sucursal activa">
                            @foreach (var loc in _localidades)
                            {
                                <option value="@loc.Id">@LimpiarNombreSucursal(loc.Descripcion)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <strong>@LimpiarNombreSucursal(Session.LocalidadDescripcion)</strong>
                    }
                </div>
            </div>
            <div class="session-actions"><RelojSistema /><div class="user-avatar">@Session.Iniciales</div><div class="user-copy"><strong>@Session.NombreUsuario</strong><small>@Session.LoginUser</small></div><button type="button" class="logout-button" @onclick="CerrarSesion">Salir</button></div>
        </header>
        <article class="workspace-content">@Body</article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>Ha ocurrido un error inesperado. <a href="." class="reload">Recargar</a><span class="dismiss">🗙</span></div>

@code {
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private List<CatalogoItemGenericoDto> _localidades = [];

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated && Session.EsAdministrador)
        {
            _localidades = await Auth.ObtenerLocalidadesUsuarioAsync();
        }
    }

    private static string LimpiarNombreSucursal(string? nombre) =>
        (nombre ?? string.Empty)
            .Replace(" USFQ", "", StringComparison.OrdinalIgnoreCase)
            .Replace("USFQ", "", StringComparison.OrdinalIgnoreCase)
            .Trim();

    private async Task CambiarSucursalAsync(ChangeEventArgs e)
    {
        if (!Session.EsAdministrador) return;
        if (!int.TryParse(e.Value?.ToString(), out int nuevaLocId) || nuevaLocId <= 0 || nuevaLocId == Session.Localidad)
            return;

        var loc = _localidades.FirstOrDefault(l => l.Id == nuevaLocId);
        if (loc is null) return;

        await Session.CambiarLocalidadAsync(loc.Id, loc.Descripcion);
        InventarioService.InvalidarCache();
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Session.IsAuthenticated)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("hosvetSessionWatcher.iniciar", _dotNetRef);
            }
            catch (JSException) { }
        }
    }

    [JSInvokable]
    public void OnBrowserSessionCleared()
    {
        if (!Session.IsAuthenticated) return;
        Session.ClearFromBrowserWipe();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    private async Task CerrarSesion()
    {
        try { await JS.InvokeVoidAsync("hosvetSessionWatcher.detener"); } catch { }
        await Session.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("hosvetSessionWatcher.detener"); } catch { }
        _dotNetRef?.Dispose();
    }
}
