@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject SessionStateService Session
@inject IAuthService Auth
@inject INotificacionClinicaService NotificacionService
@inject NotificacionClinicaHub NotificacionHub
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page @(_sidebarCollapsed ? "sidebar-collapsed" : "")">
    <aside class="sidebar">
        <a class="sidebar-brand" href="/dashboard"><img class="brand-logo" src="/favicon.png" alt="" /><span><strong>e-ForVets</strong><small>Gestión veterinaria</small></span></a>
        <NavMenu />
    </aside>
    <main class="workspace">
        <header class="workspace-header">
            <button type="button" class="sidebar-toggle" @onclick="() => _sidebarCollapsed = !_sidebarCollapsed" aria-label="Abrir o cerrar menú lateral" aria-expanded="@(!_sidebarCollapsed)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            </button>
            <div class="workspace-brand">
                <span class="mobile-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 21V3h10v18M8 8H3v13h18M11 7h4M11 11h4M11 15h4M12 21v-3h2v3" /></svg></span>
                <div>
                    <small>Hospital Veterinario</small>
                    @if (Session.IsAuthenticated && Session.EsAdministrador && _localidades.Count > 1)
                    {
                        <select class="branch-select" value="@Session.Localidad" @onchange="CambiarSucursalAsync" aria-label="Cambiar sucursal activa">
                            @foreach (var loc in _localidades)
                            {
                                <option value="@loc.Id">@LimpiarNombreSucursal(loc.Descripcion)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <strong>@LimpiarNombreSucursal(Session.LocalidadDescripcion)</strong>
                    }
                </div>
            </div>
            <div class="header-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
                <input aria-label="Buscar sección del sistema" placeholder="Buscar sección del sistema..." @bind="_search" @bind:event="oninput" @onkeydown="BuscarConTeclado" />
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <div class="header-search-results">
                        @foreach (var destino in DestinosEncontrados)
                        {
                            <a href="@destino.Ruta" @onclick="LimpiarBusqueda">@destino.Nombre</a>
                        }
                        @if (!DestinosEncontrados.Any())
                        {
                            <span>No se encontraron secciones.</span>
                        }
                    </div>
                }
            </div>
            <div class="session-actions">
                <div class="header-clock"><RelojSistema Compacto="true" /></div>
                @if (MostrarCampanita)
                {
                    <div class="header-notif">
                        <button type="button"
                                class="header-icon header-notif-btn @(_notificaciones.TotalEmergenciasNoLeidas > 0 ? "is-emergency" : (_notificaciones.TotalNoLeidas > 0 ? "has-unread" : ""))"
                                @onclick="AlternarPanelNotificaciones"
                                aria-label="Notificaciones clínicas"
                                title="@(_notificaciones.TotalEmergenciasNoLeidas > 0 ? $"¡{_notificaciones.TotalEmergenciasNoLeidas} emergencia(s) pendiente(s)!" : (_notificaciones.TotalNoLeidas > 0 ? $"{_notificaciones.TotalNoLeidas} notificación(es) nueva(s)" : "Notificaciones"))">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                                <path d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5" />
                                <path d="M9.5 17a2.5 2.5 0 0 0 5 0" />
                            </svg>
                            @if (_notificaciones.TotalNoLeidas > 0)
                            {
                                <span class="header-notif-badge @(_notificaciones.TotalEmergenciasNoLeidas > 0 ? "emergency" : "")">
                                    @(_notificaciones.TotalNoLeidas > 9 ? "9+" : _notificaciones.TotalNoLeidas.ToString())
                                </span>
                            }
                        </button>
                        @if (_panelNotificacionesAbierto)
                        {
                            <div class="notif-backdrop" @onclick="CerrarPanelNotificaciones"></div>
                            <div class="notif-dropdown" role="dialog" aria-label="Panel de notificaciones">
                                <div class="notif-dropdown-header">
                                    <div>
                                        <strong>Notificaciones</strong>
                                        <small>@(_notificaciones.TotalNoLeidas > 0 ? $"{_notificaciones.TotalNoLeidas} nueva(s)" : "Todo al día")</small>
                                    </div>
                                    <div class="notif-header-actions">
                                        <button type="button" class="notif-icon-action" title="@(_sonidoSilenciado ? "Activar sonido" : "Silenciar sonido")" @onclick="AlternarSilencio">
                                            <i class="bi @(_sonidoSilenciado ? "bi-volume-mute-fill text-muted" : "bi-volume-up-fill text-primary")"></i>
                                        </button>
                                        @if (_notificaciones.TotalNoLeidas > 0)
                                        {
                                            <button type="button" class="notif-mark-all" @onclick="MarcarTodasComoLeidasAsync">Marcar leídas</button>
                                        }
                                    </div>
                                </div>
                                <div class="notif-dropdown-body">
                                    @if (!_notificacionesInicializadas)
                                    {
                                        <div class="notif-empty">
                                            <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                                            <span>Cargando notificaciones...</span>
                                        </div>
                                    }
                                    else if (_notificaciones.Items.Count == 0)
                                    {
                                        <div class="notif-empty">
                                            <i class="bi bi-bell-slash"></i>
                                            <span>No tienes órdenes ni citas asignadas pendientes.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var item in _notificaciones.Items)
                                        {
                                            <button type="button"
                                                    class="notif-item @(item.Leida ? "is-read" : "is-unread") @(item.EsEmergencia ? "is-emergency" : "")"
                                                    @onclick="() => AbrirNotificacionAsync(item)">
                                                <span class="notif-item-icon @(item.EsEmergencia ? "emergency" : (item.Tipo == "CITA" ? "cita" : "orden"))">
                                                    <i class="bi @(item.EsEmergencia ? "bi-exclamation-triangle-fill" : (item.Tipo == "CITA" ? "bi-calendar2-check-fill" : "bi-clipboard2-pulse-fill"))"></i>
                                                </span>
                                                <span class="notif-item-copy">
                                                    <span class="notif-item-top">
                                                        <strong>@item.Titulo</strong>
                                                        @if (item.EsEmergencia)
                                                        {
                                                            <span class="notif-pill-emergencia">EMERGENCIA</span>
                                                        }
                                                        else if (!item.Leida)
                                                        {
                                                            <span class="notif-unread-dot" aria-label="Nueva"></span>
                                                        }
                                                    </span>
                                                    <span class="notif-item-patient">@item.Paciente @(!string.IsNullOrWhiteSpace(item.Propietario) ? $"· {item.Propietario}" : "")</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.Detalle))
                                                    {
                                                        <small>@item.Detalle</small>
                                                    }
                                                    @if (item.EsOtraSede)
                                                    {
                                                        <span class="notif-item-action other-branch" title="Esta orden corresponde a otra sede.">
                                                            <i class="bi bi-geo-alt-fill me-1"></i>@item.TextoAccion
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="notif-item-action">@item.TextoAccion <i class="bi bi-arrow-right-short"></i></span>
                                                    }
                                                </span>
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (Permisos.Permite("admision/citas"))
                {
                    <a class="header-icon" href="/admision/citas" aria-label="Abrir agenda de citas" title="Agenda de citas"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M7 2v6M17 2v6M3 11h18M7 15h3M14 15h3M7 18h3" /></svg></a>
                }
                <details class="header-account">
                    <summary><span class="user-avatar">@Session.Iniciales</span><span class="user-copy"><strong>@Session.NombreUsuario</strong><small>@(Session.EsAdministrador ? "Administrador" : Session.LoginUser)</small></span><svg class="account-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
                    <div class="account-panel"><button type="button" class="logout-button" @onclick="CerrarSesion">Cerrar sesión</button></div>
                </details>
            </div>
        </header>
        <article class="workspace-content">@Body</article>
    </main>
</div>

@if (_toastActivo is not null)
{
    <div class="notif-toast @(_toastActivo.EsEmergencia ? "is-emergency" : "")" role="alert">
        <div class="notif-toast-icon">
            <i class="bi @(_toastActivo.EsEmergencia ? "bi-exclamation-triangle-fill" : (_toastActivo.Tipo == "CITA" ? "bi-calendar2-check-fill" : "bi-bell-fill"))"></i>
        </div>
        <div class="notif-toast-body" @onclick="() => AbrirNotificacionAsync(_toastActivo)">
            <strong>@_toastActivo.Titulo</strong>
            <div>@_toastActivo.Paciente @(!string.IsNullOrWhiteSpace(_toastActivo.Propietario) ? $"· {_toastActivo.Propietario}" : "")</div>
            @if (!string.IsNullOrWhiteSpace(_toastActivo.Detalle))
            {
                <small>@_toastActivo.Detalle</small>
            }
        </div>
        <button type="button" class="notif-toast-close" aria-label="Cerrar aviso" @onclick="() => _toastActivo = null">&times;</button>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>Ha ocurrido un error inesperado. <a href="." class="reload">Recargar</a><span class="dismiss">🗙</span></div>

@code {
    [CascadingParameter] private PermisosNavegacion Permisos { get; set; } = new(0, []);
    private string _search = "";
    private static readonly (string Nombre, string Ruta)[] Destinos =
    [
        ("Dashboard", "/dashboard"),
        ("Clientes, tutores y mascotas", "/admision/clientes-pacientes"),
        ("Recepción de órdenes", "/admision/ordenes"),
        ("Agenda de citas", "/admision/citas"),
        ("Triaje de ingreso", "/admision/triaje"),
        ("Historia clínica", "/consulta/fichamedica"),
        ("Proveedores", "/contabilidad/proveedores"),
        ("Mis compras", "/contabilidad/mis-compras")
    ];
    private IEnumerable<(string Nombre, string Ruta)> DestinosEncontrados => Destinos
        .Where(d => Permisos.Permite(d.Ruta.TrimStart('/')) && d.Nombre.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
    private void LimpiarBusqueda() => _search = "";
    private void BuscarConTeclado(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") LimpiarBusqueda();
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_search) && DestinosEncontrados.FirstOrDefault() is var destino && destino.Ruta is not null)
        {
            LimpiarBusqueda();
            Nav.NavigateTo(destino.Ruta);
        }
    }
    private bool _sidebarCollapsed;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private List<CatalogoItemGenericoDto> _localidades = [];
    private NotificacionClinicaEstadoDto _notificaciones = new();
    private bool _panelNotificacionesAbierto;
    private bool _sonidoSilenciado;
    private bool _notificacionesInicializadas;
    private bool _consultandoNotificaciones;
    private HashSet<string> _clavesConocidas = [];
    private HashSet<string> _clavesLeidas = [];
    private NotificacionClinicaItemDto? _toastActivo;
    private CancellationTokenSource? _notifCts;
    private CancellationTokenSource? _toastCts;

    private bool MostrarCampanita =>
        Session.IsAuthenticated &&
        (_notificaciones.Habilitado || Session.TipoUser is 2 or 11);

    private string ClaveStorageLeidas => $"eForVets.notif.leidas.{Session.IdUser}.{DateTime.UtcNow.AddHours(-5):yyyyMMdd}";

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += ManejarCambioSesion;
        NotificacionHub.OnNuevaActividad += ManejarActividadHub;
        if (Session.IsAuthenticated && Session.EsAdministrador)
        {
            _localidades = await Auth.ObtenerLocalidadesUsuarioAsync();
        }
        if (Session.IsAuthenticated)
        {
            await ActualizarNotificacionesAsync(esCargaInicial: true);
            IniciarPollingNotificaciones();
        }
    }

    private void ManejarCambioSesion()
    {
        if (!Session.IsAuthenticated) return;
        _ = InvokeAsync(async () =>
        {
            if (!_notificacionesInicializadas)
            {
                await ActualizarNotificacionesAsync(esCargaInicial: true);
                IniciarPollingNotificaciones();
            }
        });
    }

    private void IniciarPollingNotificaciones()
    {
        _notifCts?.Cancel();
        _notifCts?.Dispose();
        _notifCts = new CancellationTokenSource();
        var token = _notifCts.Token;
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    await InvokeAsync(() => ActualizarNotificacionesAsync(esCargaInicial: false));
                }
            }
            catch (OperationCanceledException) { }
        }, token);
    }

    private void ManejarActividadHub(int? idUsuarioDestino)
    {
        if (!Session.IsAuthenticated || !_notificaciones.Habilitado) return;
        if (idUsuarioDestino.HasValue && idUsuarioDestino.Value > 0 && idUsuarioDestino.Value != Session.IdUser && !_notificaciones.EsEnfermero)
            return;

        _ = InvokeAsync(() => ActualizarNotificacionesAsync(esCargaInicial: false));
    }

    private async Task ActualizarNotificacionesAsync(bool esCargaInicial)
    {
        if (_consultandoNotificaciones || !Session.IsAuthenticated) return;
        _consultandoNotificaciones = true;
        try
        {
            var nuevoEstado = await NotificacionService.ObtenerNotificacionesActivasAsync();
            foreach (var item in nuevoEstado.Items)
                item.Leida = _clavesLeidas.Contains(item.Clave);

            if (esCargaInicial || !_notificacionesInicializadas)
            {
                _clavesConocidas = nuevoEstado.Items.Select(i => i.Clave).ToHashSet(StringComparer.Ordinal);
                _notificacionesInicializadas = true;
                _notificaciones = nuevoEstado;
                StateHasChanged();
                return;
            }

            var nuevas = nuevoEstado.Items.Where(i => !_clavesConocidas.Contains(i.Clave)).ToList();
            foreach (var n in nuevas)
                _clavesConocidas.Add(n.Clave);

            _notificaciones = nuevoEstado;
            StateHasChanged();

            if (nuevas.Count > 0)
            {
                bool hayEmergencia = nuevas.Any(i => i.EsEmergencia);
                var destacada = nuevas.FirstOrDefault(i => i.EsEmergencia) ?? nuevas[0];
                MostrarToast(destacada);

                if (!_sonidoSilenciado)
                {
                    try { await JS.InvokeVoidAsync("hosvetNotificaciones.reproducirAlerta", hayEmergencia); }
                    catch { }
                }
            }
        }
        finally
        {
            _consultandoNotificaciones = false;
        }
    }

    private void MostrarToast(NotificacionClinicaItemDto item)
    {
        _toastActivo = item;
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        int duracionMs = item.EsEmergencia ? 10000 : 6000;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(duracionMs, token);
                await InvokeAsync(() =>
                {
                    if (_toastActivo?.Clave == item.Clave)
                    {
                        _toastActivo = null;
                        StateHasChanged();
                    }
                });
            }
            catch (OperationCanceledException) { }
        }, token);
    }

    private void AlternarPanelNotificaciones() => _panelNotificacionesAbierto = !_panelNotificacionesAbierto;
    private void CerrarPanelNotificaciones() => _panelNotificacionesAbierto = false;
    private void AlternarSilencio() => _sonidoSilenciado = !_sonidoSilenciado;

    private async Task GuardarLeidasAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("hosvetNotificaciones.guardarLeidas", ClaveStorageLeidas, _clavesLeidas.ToArray());
        }
        catch { }
    }

    private async Task MarcarTodasComoLeidasAsync()
    {
        foreach (var item in _notificaciones.Items)
        {
            item.Leida = true;
            _clavesLeidas.Add(item.Clave);
        }
        await GuardarLeidasAsync();
        StateHasChanged();
    }

    private async Task AbrirNotificacionAsync(NotificacionClinicaItemDto item)
    {
        item.Leida = true;
        _clavesLeidas.Add(item.Clave);
        _panelNotificacionesAbierto = false;
        if (_toastActivo?.Clave == item.Clave) _toastActivo = null;
        await GuardarLeidasAsync();
        if (!item.EsOtraSede && !string.IsNullOrWhiteSpace(item.RutaDestino))
        {
            Nav.NavigateTo(item.RutaDestino);
        }
    }

    private static string LimpiarNombreSucursal(string? nombre) =>
        (nombre ?? string.Empty)
            .Replace(" USFQ", "", StringComparison.OrdinalIgnoreCase)
            .Replace("USFQ", "", StringComparison.OrdinalIgnoreCase)
            .Trim();

    private async Task CambiarSucursalAsync(ChangeEventArgs e)
    {
        if (!Session.EsAdministrador) return;
        if (!int.TryParse(e.Value?.ToString(), out int nuevaLocId) || nuevaLocId <= 0 || nuevaLocId == Session.Localidad)
            return;

        var loc = _localidades.FirstOrDefault(l => l.Id == nuevaLocId);
        if (loc is null) return;

        await Session.CambiarLocalidadAsync(loc.Id, loc.Descripcion);
        InventarioService.InvalidarCache();
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Session.IsAuthenticated)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("hosvetSessionWatcher.iniciar", _dotNetRef);
            }
            catch (JSException) { }

            try
            {
                var leidas = await JS.InvokeAsync<string[]?>("hosvetNotificaciones.obtenerLeidas", ClaveStorageLeidas);
                if (leidas is { Length: > 0 })
                {
                    _clavesLeidas = leidas.ToHashSet(StringComparer.Ordinal);
                    foreach (var item in _notificaciones.Items)
                        item.Leida = _clavesLeidas.Contains(item.Clave);
                    StateHasChanged();
                }
            }
            catch (JSException) { }
        }
    }

    [JSInvokable]
    public void OnBrowserSessionCleared()
    {
        if (!Session.IsAuthenticated) return;
        Session.ClearFromBrowserWipe();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    private async Task CerrarSesion()
    {
        try { await JS.InvokeVoidAsync("hosvetSessionWatcher.detener"); } catch { }
        await Session.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    public async ValueTask DisposeAsync()
    {
        Session.OnChange -= ManejarCambioSesion;
        NotificacionHub.OnNuevaActividad -= ManejarActividadHub;
        _notifCts?.Cancel();
        _notifCts?.Dispose();
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        try { await JS.InvokeVoidAsync("hosvetSessionWatcher.detener"); } catch { }
        _dotNetRef?.Dispose();
    }
}
