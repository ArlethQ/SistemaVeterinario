@inherits LayoutComponentBase
@inject SessionStateService Session
@inject NavigationManager Nav

<div class="page">
    <aside class="sidebar">
        <a class="sidebar-brand" href="/dashboard"><span class="brand-mark">eF</span><span><strong>e-ForVets</strong><small>Gestión veterinaria</small></span></a>
        <div class="clinic-pill"><span>●</span><div><small>Sucursal activa</small><strong>@Session.Apostrofe</strong></div></div>
        <NavMenu />
        <div class="sidebar-footer"><span>🐾</span><div><strong>Cuidado conectado</strong><small>Versión clínica</small></div></div>
    </aside>
    <main class="workspace">
        <header class="workspace-header">
            <div class="workspace-brand"><span class="mobile-mark">H</span><div><small>Hospital Veterinario</small><strong>@Session.LocalidadDescripcion</strong></div></div>
            <div class="session-actions"><div class="user-avatar">@Session.Iniciales</div><div class="user-copy"><strong>@Session.NombreUsuario</strong><small>@Session.LoginUser</small></div><button type="button" class="logout-button" @onclick="CerrarSesion">Salir</button></div>
        </header>
        <article class="workspace-content">@Body</article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>Ha ocurrido un error inesperado. <a href="." class="reload">Recargar</a><span class="dismiss">🗙</span></div>

@code { private void CerrarSesion() { Session.Logout(); Nav.NavigateTo("/login"); } }
