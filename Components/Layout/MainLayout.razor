@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject SessionStateService Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page">
    <aside class="sidebar">
        <a class="sidebar-brand" href="/dashboard"><img class="brand-logo" src="/favicon.png" alt="" /><span><strong>e-ForVets</strong><small>Gestión veterinaria</small></span></a>
        <div class="clinic-pill"><span>●</span><div><small>Sucursal activa</small><strong>@Session.Apostrofe</strong></div></div>
        <NavMenu />
        @if (Session.IsAuthenticated)
        {
            <div class="sidebar-footer"><div class="user-avatar">@Session.Iniciales</div><div><strong>@Session.NombreUsuario</strong><small>@Session.LoginUser</small></div><button type="button" title="Cerrar sesión" aria-label="Cerrar sesión" @onclick="CerrarSesion">↪</button></div>
        }
    </aside>
    <main class="workspace">
        <header class="workspace-header">
            <div class="workspace-brand"><span class="mobile-mark">H</span><div><small>Hospital Veterinario</small><strong>@(Session.LocalidadDescripcion?.Replace(" USFQ", "", StringComparison.OrdinalIgnoreCase).Replace("USFQ", "", StringComparison.OrdinalIgnoreCase).Trim())</strong></div></div>
            <div class="session-actions"><RelojSistema /><div class="user-avatar">@Session.Iniciales</div><div class="user-copy"><strong>@Session.NombreUsuario</strong><small>@Session.LoginUser</small></div><button type="button" class="logout-button" @onclick="CerrarSesion">Salir</button></div>
        </header>
        <article class="workspace-content">@Body</article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>Ha ocurrido un error inesperado. <a href="." class="reload">Recargar</a><span class="dismiss">🗙</span></div>

@code {
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Session.IsAuthenticated)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("hosvetSessionWatcher.iniciar", _dotNetRef);
            }
            catch (JSException) { }
        }
    }

    [JSInvokable]
    public void OnBrowserSessionCleared()
    {
        if (!Session.IsAuthenticated) return;
        Session.ClearFromBrowserWipe();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    private async Task CerrarSesion()
    {
        try { await JS.InvokeVoidAsync("hosvetSessionWatcher.detener"); } catch { }
        await Session.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("hosvetSessionWatcher.detener"); } catch { }
        _dotNetRef?.Dispose();
    }
}
