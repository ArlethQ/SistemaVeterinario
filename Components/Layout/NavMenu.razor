        "programacion/clinica",
        ..RutasLaboratorio
    ];

    private static readonly string[] RutasFacturacion =
    [
        "facturacion/proformas",
        "facturacion/productos",
        "facturacion/nueva",
        "facturas",
        "facturacion/nota-credito",
        "facturacion/notas-credito-generadas",
        "facturacion/nota-debito",
        "facturacion/notas-debito-generadas",
        "facturacion/guia-remision",
        "facturacion/guias-remision-generadas",
        "compras/importar-xml",
        "facturacion/retenciones-generadas",
        "contabilidad/compra-documentos",
        "compras/nueva-liquidacion",
        "compras/liquidaciones-generadas",
        "facturacion/configuracion/emisor",
        "facturacion/configuracion/firma",
        "facturacion/configuracion/caja"
    ];

    private static readonly string[] RutasContabilidad =
    [
        "contabilidad",
        "contabilidad/cuentas-por-cobrar",
        "contabilidad/clientes",
        "contabilidad/proveedores",
        "contabilidad/compras/importar-xml",
        "contabilidad/compras/ordenes",
