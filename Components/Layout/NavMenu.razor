@inject SessionStateService Session
@inject IAuthService AuthService

<div class="nav-shell">
    <input id="menu-toggle" type="checkbox" class="menu-toggle" />
    <label for="menu-toggle" class="menu-toggle-label" aria-label="Abrir o cerrar menú">☰ <span>Menú</span></label>
    <div class="nav-scrollable">
        <nav class="menu-tree" aria-label="Navegación del sistema">
            <span class="menu-section-label">General</span>
            <NavLink class="menu-link" href="dashboard"><MenuIcon Name="dashboard" /><span>Dashboard</span></NavLink>

            <span class="menu-section-label">Gestión</span>
            <details open>
                <summary><MenuIcon Name="admission" /><span>Admisión</span><i>⌄</i></summary>
                <div class="submenu">
                    <NavLink href="admision/clientes-pacientes">Clientes, tutores y mascotas</NavLink>
                    <NavLink href="admision/ordenes">Recepción y triaje</NavLink>
                    <NavLink href="admision/citas">Agenda de citas</NavLink>
                </div>
            </details>

            <span class="menu-section-label">Atención clínica</span>
            <details>
                <summary><MenuIcon Name="kardex" /><span>Kardex clínico</span><i>⌄</i></summary>
                <div class="submenu">
                    <NavLink href="kardex/ordenes">Bandeja de órdenes</NavLink>
                    <NavLink href="kardex/enfermeria">Kardex enfermería</NavLink>
                    <NavLink href="kardex/signos">Signos y balance hídrico</NavLink>
                </div>
            </details>

            <details>
                <summary><MenuIcon Name="hospital" /><span>Hospitalización 24h</span><i>⌄</i></summary>
                <div class="submenu">
                    <NavLink href="hospitalizacion/ficha">Ficha de hospitalización</NavLink>
                    <NavLink href="hospitalizacion/monitoreo">Monitoreo 24 horas</NavLink>
                </div>
            </details>

            <details>
                <summary><MenuIcon Name="surgery" /><span>Quirófano y anestesia</span><i>⌄</i></summary>
                <div class="submenu">
                    <NavLink href="quirofano/preanestesia">Pre-anestesia</NavLink>
                    <NavLink href="quirofano/anestesia">Hoja de anestesia</NavLink>
                    <NavLink href="quirofano/protocolo">Protocolo quirúrgico</NavLink>
                    <NavLink href="quirofano/recuperacion">Sala de recuperación</NavLink>
                </div>
            </details>

            <details>
                <summary><MenuIcon Name="consultation" /><span>Consulta e historia</span><i>⌄</i></summary>
                <div class="submenu">
                    <NavLink href="consulta/fichamedica">Historia clínica SOAP</NavLink>
                    <NavLink href="consulta/evoluciones">Evolución médica</NavLink>
                    <NavLink href="consulta/recetario">Recetario médico</NavLink>
                    <NavLink href="consulta/autorizaciones">Consentimientos y alta</NavLink>
                </div>
            </details>

            <details>
                <summary><MenuIcon Name="diagnostic" /><span>Laboratorio e imagen</span><i>⌄</i></summary>
                <div class="submenu">
                    <NavLink href="diagnostico/laboratorio">Órdenes de laboratorio</NavLink>
                    <NavLink href="diagnostico/imagenologia">Rayos X y ecografía</NavLink>
                    <NavLink href="diagnostico/bandeja">Bandeja de resultados</NavLink>
                </div>
            </details>

            <span class="menu-section-label">Administración</span>
            <NavLink class="menu-link" href="facturacion/proformas"><MenuIcon Name="billing" /><span>Proformas y facturación</span></NavLink>
            @if (_menusAdicionales.Count > 0)
            {
                <span class="menu-section-label">Módulos configurados</span>
                @foreach (var menu in _menusAdicionales)
                {
                    <NavLink class="menu-link" href="@NormalizarRuta(menu.Url!)"><MenuIcon Name="kardex" /><span>@menu.Descripcion</span></NavLink>
                }
            }
            @if (Session.TipoUser == 1)
            {
                <span class="menu-section-label">Sistema</span>
                <details>
                    <summary><MenuIcon Name="security" /><span>Seguridad</span><i>⌄</i></summary>
                    <div class="submenu"><NavLink href="administracion/usuarios">Usuarios</NavLink><NavLink href="administracion/roles">Roles</NavLink><NavLink href="administracion/menus">Menús</NavLink><NavLink href="administracion/roles-permisos">Asignar permisos</NavLink></div>
                </details>
            }
        </nav>
    </div>
</div>

@code {
    private List<MenuItemModel> _menusAdicionales = [];
    private static readonly HashSet<string> RutasFijas = new(StringComparer.OrdinalIgnoreCase)
    {
        "dashboard", "admision/clientes-pacientes", "admision/ordenes", "admision/citas",
        "kardex/ordenes", "kardex/enfermeria", "kardex/signos", "hospitalizacion/ficha",
        "hospitalizacion/monitoreo", "quirofano/preanestesia", "quirofano/anestesia",
        "quirofano/protocolo", "quirofano/recuperacion", "consulta/fichamedica",
        "consulta/evoluciones", "consulta/recetario", "consulta/autorizaciones",
        "diagnostico/laboratorio", "diagnostico/imagenologia", "diagnostico/bandeja", "facturacion/proformas"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated) return;
        var menus = await AuthService.ObtenerMenuUsuarioAsync(Session.IdUser, Session.TipoUser);
        _menusAdicionales = menus.Where(m => !string.IsNullOrWhiteSpace(m.Url) && !RutasFijas.Contains(NormalizarRuta(m.Url!))).ToList();
    }

    private static string NormalizarRuta(string ruta) => ruta.Trim().TrimStart('/');
}
