
@inject IAuthService AuthService
@inject SessionStateService Session
@inject NavigationManager Navigation

<div class="nav-shell">
    <input id="menu-toggle" type="checkbox" class="menu-toggle" />
    <label for="menu-toggle" class="menu-toggle-label" aria-label="Abrir o cerrar menú">☰ <span>Menú</span></label>
    <div class="nav-scrollable">
        <nav class="menu-tree" aria-label="Navegación del sistema">
            @if (_menusPersonalizados.Count > 0)
            {
                @foreach (var grupo in _menusPersonalizados.Where(m => !TienePadreVisible(m)))
                {
                    var hijos = _menusPersonalizados.Where(m => m.PadreNuevoMenu == grupo.SecNuevoMenu).ToList();
                    @if (hijos.Count > 0)
                    {
                        <details>
                            <summary><span>@grupo.Descripcion</span><i>⌄</i></summary>
                            <div class="submenu">
                                @if (!string.IsNullOrWhiteSpace(grupo.Url))
                                {
                                    <NavLink href="@grupo.Url">@grupo.Descripcion</NavLink>
                                }
                                @foreach (var hijo in hijos)
                                {
                                    <NavLink href="@hijo.Url">@hijo.Descripcion</NavLink>
                                }
                            </div>
                        </details>
                    }
                    else if (!string.IsNullOrWhiteSpace(grupo.Url))
                    {
                        <NavLink class="menu-link" href="@grupo.Url">@grupo.Descripcion</NavLink>
                    }
                }
                <NavLink class="menu-link" href="farmacia"><MenuIcon Name="kardex" /><span>Farmacia y despacho</span></NavLink>
            }
            else
            {
            @if (TieneAlguno("dashboard", "suscripciones"))
            {
                <span class="menu-section-label">General</span>
                @if (TienePermiso("dashboard"))
                {
                    <NavLink class="menu-link" href="dashboard"><MenuIcon Name="dashboard" /><span>Dashboard</span></NavLink>
                }
                @if (TienePermiso("suscripciones"))
                {
                    <NavLink class="menu-link" href="suscripciones"><MenuIcon Name="billing" /><span>Planes y suscripciones</span></NavLink>
                }
            }

            @if (TieneAlguno(RutasAdmision) || (Session.TipoUser != 2 && TienePermiso("admision/triaje")))
            {
                <span class="menu-section-label">Gestión</span>
                @if (TieneAlguno(RutasAdmision))
                {
                    <details open>
                        <summary><MenuIcon Name="admission" /><span>Admisión</span><i>⌄</i></summary>
                        <div class="submenu">
                            @if (TienePermiso("admision/clientes-pacientes"))
                            {
                                <NavLink href="admision/clientes-pacientes">Clientes, tutores y mascotas</NavLink>
                            }
                            @if (TienePermiso("admision/ordenes"))
                            {
                                <NavLink href="admision/ordenes">Recepción de órdenes</NavLink>
                            }
                            @if (TienePermiso("admision/citas"))
                            {
                                <NavLink href="admision/citas">Agenda de citas</NavLink>
                            }
                        </div>
                    </details>
                }
                @if (Session.TipoUser != 2 && TienePermiso("admision/triaje"))
                {
                    <details>
                        <summary><MenuIcon Name="kardex" /><span>Enfermería</span><i>⌄</i></summary>
                        <div class="submenu"><NavLink href="admision/triaje">Triaje de ingreso</NavLink></div>
                    </details>
                }
            }

            @if (TieneAlguno(RutasAtencionClinica))
            {
                <span class="menu-section-label">Atención clínica</span>

                @if (TieneAlguno(RutasHospitalizacion))
                {
                    <details>
                        <summary><MenuIcon Name="hospital" /><span>Hospitalización 24h</span><i>⌄</i></summary>
                        <div class="submenu">
                            @if (TienePermiso("kardex/ordenes"))
                            {
                                <NavLink href="kardex/ordenes">Bandeja de órdenes</NavLink>
                            }
                            @if (TienePermiso("kardex/enfermeria"))
                            {
                                <NavLink href="kardex/enfermeria">Kardex enfermería</NavLink>
                            }
                            @if (TienePermiso("kardex/signos"))
                            {
                                <NavLink href="kardex/signos">Signos y balance hídrico</NavLink>
                            }
                            @if (TienePermiso("consulta/evoluciones"))
                            {
                                <NavLink href="consulta/evoluciones">Evolución médica</NavLink>
                            }
                            @if (TienePermiso("hospitalizacion/ficha"))
                            {
                                <NavLink href="hospitalizacion/ficha-actualizada">Ficha de hospitalización y Monitoreo</NavLink>
                            }
                            @if (TienePermiso("hospitalizacion/fichas-complementarias"))
                            {
                                <NavLink href="hospitalizacion/fichas-complementarias">Transfusiones sanguíneas</NavLink>
                            }
                            @if (TienePermiso("hospitalizacion/calculadora-infusiones"))
                            {
                                <NavLink href="hospitalizacion/calculadora-infusiones">Calculadora de infusiones</NavLink>
                            }
                        </div>
                    </details>
                }

                @if (TieneAlguno(RutasQuirofano))
                {
                    <details>
                        <summary><MenuIcon Name="surgery" /><span>Quirófano y anestesia</span><i>⌄</i></summary>
                        <div class="submenu">
                            @if (TienePermiso("programacion/salas-quirofano"))
                            {
                                <NavLink href="programacion/salas-quirofano">Salas de quirófano</NavLink>
                            }
                            @if (TienePermiso("quirofano/preanestesia"))
                            {
                                <NavLink href="quirofano/preanestesia">Pre-anestesia</NavLink>
                            }
                            @if (TienePermiso("quirofano/preanestesia/checklist"))
                            {
                                <NavLink href="quirofano/preanestesia/checklist">Checklist preoperatorio</NavLink>
                            }
                            @if (TienePermiso("quirofano/pausa-seguridad"))
                            {
                                <NavLink href="quirofano/pausa-seguridad">Pausa de seguridad</NavLink>
                            }
                            @if (TienePermiso("quirofano/anestesia"))
                            {
                                <NavLink href="quirofano/anestesia">Hoja de anestesia</NavLink>
                            }
                            @if (TienePermiso("quirofano/anestesia") || TienePermiso("quirofano/preanestesia"))
                            {
                                <NavLink href="quirofano/monitorizacion-anestesia">Monitorización de anestesia</NavLink>
                            }
                            @if (TienePermiso("quirofano/protocolo"))
                            {
                                <NavLink href="quirofano/protocolo">Protocolo quirúrgico</NavLink>
                            }
                            @if (TienePermiso("quirofano/recuperacion"))
                            {
                                <NavLink href="quirofano/recuperacion">Sala de recuperación</NavLink>
                            }
                        </div>
                    </details>
                }

                @if (TieneAlguno(RutasConsulta))
                {
                    <details>
                        <summary><MenuIcon Name="consultation" /><span>Consulta e historia</span><i>⌄</i></summary>
                        <div class="submenu">
                            @if (TienePermiso("consulta/fichamedica"))
                            {
                                <NavLink href="consulta/fichamedica">Historia clínica SOAP</NavLink>
                            }
                        @if (TienePermiso("consulta/historial/apuntes"))
                            {
                                <NavLink href="consulta/historial/apuntes">Apuntes a historias</NavLink>
                            }
                            @if (TienePermiso("consulta/recetario"))
                            {
                                <NavLink href="consulta/recetario">Recetario médico</NavLink>
                            }
                            @if (TienePermiso("consulta/recetario/sin-orden"))
                            {
                                <NavLink href="consulta/recetario/sin-orden">Recetas sin orden</NavLink>
                            }
                            @if (TienePermiso("consulta/autorizaciones"))
                            {
                                <NavLink href="consulta/autorizaciones">Consentimientos y alta</NavLink>
                            }
                            @if (TienePermiso("seguimiento/clinico"))
                            {
                                <NavLink href="seguimiento/clinico">Seguimiento clínico</NavLink>
                            }
                            @if (TienePermiso("consulta/imprimir-fichas"))
                            {
                                <NavLink href="consulta/imprimir-fichas">Expediente / Lotes fichas</NavLink>
                            }
                        </div>
                    </details>
                }

                @if (TienePermiso("farmacia"))
                {
                    <NavLink class="menu-link" href="farmacia"><MenuIcon Name="kardex" /><span>Farmacia y despacho</span></NavLink>
                }

                @if (TienePermiso("operaciones/clinicas"))
                {
                    <NavLink class="menu-link" href="operaciones/clinicas"><MenuIcon Name="hospital" /><span>Operaciones clínicas</span></NavLink>
                }

                @if (TienePermiso("programacion/clinica"))
                {
                    <NavLink class="menu-link" href="programacion/clinica"><MenuIcon Name="surgery" /><span>Programación clínica</span></NavLink>
                }

                @if (TieneAlguno(RutasLaboratorio))
                {
                    <details>
                        <summary><MenuIcon Name="diagnostic" /><span>Laboratorio e imagen</span><i>⌄</i></summary>
                        <div class="submenu">
                            @if (TieneAlguno("diagnostico/laboratorio", "diagnostico/imagenologia"))
                            {
                                <NavLink href="@RutaOrdenesDiagnostico">Órdenes de diagnóstico</NavLink>
                            }
                            @if (TienePermiso("diagnostico/bandeja"))
                            {
                                <NavLink href="diagnostico/bandeja">Bandeja de resultados</NavLink>
                            }
                        </div>
                    </details>
                }
            }

            @if (TieneAlguno(RutasAdministracion))
            {
                <span class="menu-section-label">Administración</span>

                @if (TieneAlguno(RutasFacturacion))
                {
                    <details>
                        <summary><MenuIcon Name="billing" /><span>Facturación</span><i>⌄</i></summary>
                        <div class="submenu">
                            @if (TieneAlguno("facturacion/proformas", "facturacion/nueva", "facturas"))
                            {
                                <details class="submenu-group" open>
                                    <summary><span>Facturas</span><i>⌄</i></summary>
                                    <div class="submenu">
                                        @if (TienePermiso("facturacion/proformas"))
                                        {
                                            <NavLink href="facturacion/proformas">Pre-facturación veterinaria</NavLink>
                                        }
                                        @if (TienePermiso("facturacion/nueva"))
                                        {
                                            <NavLink href="facturacion/nueva">Nueva Factura</NavLink>
                                        }
                                        @if (TienePermiso("facturas"))
                                        {
                                            <NavLink href="facturas">Mis Facturas</NavLink>
                                        }
                                    </div>
                                </details>
                            }

                            @if (TieneAlguno("facturacion/guia-remision", "compras/nueva-liquidacion", "facturacion/nota-credito", "facturacion/nota-debito"))
                            {
                                <details class="submenu-group">
                                    <summary><span>Emisión de otros Documentos</span><i>⌄</i></summary>
                                    <div class="submenu">
                                        @if (TienePermiso("facturacion/guia-remision"))
                                        {
                                            <NavLink href="facturacion/guia-remision">Guía de Remisión</NavLink>
                                        }
                                        @if (TienePermiso("compras/nueva-liquidacion"))
                                        {
                                            <NavLink href="compras/nueva-liquidacion">Liquidación de Compra</NavLink>
                                        }
                                        @if (TienePermiso("facturacion/nota-credito"))
                                        {
                                            <NavLink href="facturacion/nota-credito">Nota de Crédito</NavLink>
                                        }
                                        @if (TienePermiso("facturacion/nota-debito"))
                                        {
                                            <NavLink href="facturacion/nota-debito">Nota de Débito</NavLink>
                                        }
                                    </div>
                                </details>
                            }

                            @if (TieneAlguno("facturacion/notas-credito-generadas", "facturacion/retenciones-generadas", "facturacion/guias-remision-generadas", "compras/liquidaciones-generadas", "facturacion/notas-debito-generadas"))
                            {
                                <details class="submenu-group">
                                    <summary><span>Documentos Generados</span><i>⌄</i></summary>
                                    <div class="submenu">
                                        @if (TienePermiso("facturacion/notas-credito-generadas"))
                                        {
                                            <NavLink href="facturacion/notas-credito-generadas">Mis Notas de Crédito</NavLink>
                                        }
                                        @if (TienePermiso("facturacion/retenciones-generadas"))
                                        {
                                            <NavLink href="facturacion/retenciones-generadas">Mis Retenciones</NavLink>
                                        }
                                        @if (TienePermiso("facturacion/guias-remision-generadas"))
                                        {
                                            <NavLink href="facturacion/guias-remision-generadas">Mis Guías de Remisión</NavLink>
                                        }
                                        @if (TienePermiso("compras/liquidaciones-generadas"))
                                        {
                                            <NavLink href="compras/liquidaciones-generadas">Mis Liquidaciones Compras</NavLink>
                                        }
                                        @if (TienePermiso("facturacion/notas-debito-generadas"))
                                        {
                                            <NavLink href="facturacion/notas-debito-generadas">Mis Notas de Débito</NavLink>
                                        }
                                    </div>
                                </details>
                            }

                            @if (TienePermiso("compras/importar-xml"))
                            {
                                <details class="submenu-group">
                                    <summary><span>Retención de compras</span><i>⌄</i></summary>
                                    <div class="submenu">
                                        <NavLink href="compras/importar-xml">Retención de compra</NavLink>
                                    </div>
                                </details>
                            }

                            @if (TieneAlguno("facturacion/configuracion/emisor", "facturacion/configuracion/firma", "facturacion/configuracion/caja", "contabilidad/compra-documentos"))
                            {
                                <details class="submenu-group">
                                    <summary><span>Configuración</span><i>⌄</i></summary>
                                    <div class="submenu">
                                        @if (TienePermiso("facturacion/configuracion/emisor"))
                                        {
                                            <NavLink href="facturacion/configuracion/emisor">Emisor</NavLink>
                                        }
                                        @if (TienePermiso("facturacion/configuracion/firma"))
                                        {
                                            <NavLink href="facturacion/configuracion/firma">Firma</NavLink>
                                        }
                                        @if (TienePermiso("facturacion/configuracion/caja"))
                                        {
                                            <NavLink href="facturacion/configuracion/caja">Cajas y secuencias</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/compra-documentos"))
                                        {
                                            <NavLink href="contabilidad/compra-documentos">Recargar documentos</NavLink>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    </details>
                }

                @if (TieneAlguno(RutasContabilidad))
                {
                    <details>
                        <summary><MenuIcon Name="billing" /><span>Contabilidad</span><i>⌄</i></summary>
                        <div class="submenu">
                            @if (TieneAlguno("contabilidad/cuentas-por-cobrar", "contabilidad/cuentas-por-pagar", "contabilidad/cuentas-por-pagar/registrar", "contabilidad/cuentas-por-pagar/estado-cuenta", "contabilidad/clientes"))
                            {
                                <details class="submenu-group" open>
                                    <summary><span>Abonos</span><i>⌄</i></summary>
                                    <div class="submenu">
                                        @if (TienePermiso("contabilidad/cuentas-por-cobrar"))
                                        {
                                            <NavLink href="contabilidad/cuentas-por-cobrar">Cuentas Por Cobrar</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/cuentas-por-pagar") || TienePermiso("contabilidad/cuentas-por-cobrar"))
                                        {
                                            <NavLink href="contabilidad/cuentas-por-pagar">Cuentas Por Pagar</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/cuentas-por-pagar/registrar") || TienePermiso("contabilidad/cuentas-por-pagar") || TienePermiso("contabilidad/cuentas-por-cobrar"))
                                        {
                                            <NavLink href="contabilidad/cuentas-por-pagar/registrar">Registrar pago</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/cuentas-por-pagar/estado-cuenta") || TienePermiso("contabilidad/cuentas-por-pagar") || TienePermiso("contabilidad/proveedores"))
                                        {
                                            <NavLink href="contabilidad/cuentas-por-pagar/estado-cuenta">Estado de cuenta proveedores</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/clientes"))
                                        {
                                            <NavLink href="contabilidad/clientes">Clientes / Terceros</NavLink>
                                        }
                                    </div>
                                </details>
                            }

                            @if (TieneAlguno("contabilidad/proveedores", "contabilidad/mis-compras", "contabilidad/compras/nueva-factura", "contabilidad/compras/importar-xml", "contabilidad/compras/ordenes", "contabilidad/compras/recepciones", "contabilidad/facturacion/retenciones-generadas", "contabilidad/compras/nueva-liquidacion", "contabilidad/compras/liquidaciones-generadas", "contabilidad/compras/descargar-sri"))
                            {
                                <details class="submenu-group">
                                    <summary><span>Compras</span><i>⌄</i></summary>
                                    <div class="submenu">
                                        @if (TienePermiso("contabilidad/proveedores"))
                                        {
                                            <NavLink href="contabilidad/proveedores">Proveedores</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/compras/ordenes"))
                                        {
                                            <NavLink href="contabilidad/compras/ordenes">Órdenes de compra</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/compras/nueva-factura"))
                                        {
                                            <NavLink href="contabilidad/compras/nueva-factura">Registrar la compra</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/compras/recepciones"))
                                        {
                                            <NavLink href="contabilidad/compras/recepciones">Recepción de compra</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/mis-compras"))
                                        {
                                            <NavLink href="contabilidad/mis-compras">Mis compras</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/compras/descargar-sri"))
                                        {
                                            <NavLink href="contabilidad/compras/descargar-sri">Descargar compras SRI</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/compras/importar-xml"))
                                        {
                                            <NavLink href="contabilidad/compras/importar-xml">Retenciones de compra</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/facturacion/retenciones-generadas"))
                                        {
                                            <NavLink href="contabilidad/facturacion/retenciones-generadas">Mis Retenciones</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/compras/nueva-liquidacion"))
                                        {
                                            <NavLink href="contabilidad/compras/nueva-liquidacion">Liquidación de Compra</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/compras/liquidaciones-generadas"))
                                        {
                                            <NavLink href="contabilidad/compras/liquidaciones-generadas">Mis Liquidaciones Compras</NavLink>
                                        }
                                    </div>
                                </details>
                            }

                            @if (TieneAlguno("contabilidad/inventarios", "contabilidad/inventarios/asignar-stock", "contabilidad/inventarios/bodegas", "contabilidad/inventarios/operaciones", "contabilidad/inventarios/reportes"))
                            {
                                <details class="submenu-group">
                                    <summary><span>Inventarios</span><i>⌄</i></summary>
                                    <div class="submenu">
                                        @if (TienePermiso("contabilidad/inventarios"))
                                        {
                                            <NavLink href="contabilidad/inventarios" Match="NavLinkMatch.All">Inventarios / Kardex</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/inventarios/asignar-stock") || TienePermiso("contabilidad/inventarios"))
                                        {
                                            <NavLink href="contabilidad/inventarios/asignar-stock">Asignar stock a productos</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/inventarios/bodegas"))
                                        {
                                            <NavLink href="contabilidad/inventarios/bodegas">Bodegas</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/inventarios/operaciones"))
                                        {
                                            <NavLink href="contabilidad/inventarios/operaciones">Operaciones de inventario</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/inventarios/reportes"))
                                        {
                                            <NavLink href="contabilidad/inventarios/reportes">Reportes de inventario</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/inventarios/fiscalizacion") || TienePermiso("contabilidad/inventarios"))
                                        {
                                            <NavLink href="contabilidad/inventarios/fiscalizacion">Productos sujetos a fiscalización</NavLink>
                                        }
                                    </div>
                                </details>
                            }

                            @if (TieneAlguno("contabilidad/libros/plan-cuentas", "contabilidad/libros/asientos", "contabilidad/libros/libro-diario", "contabilidad/libros/libro-mayor", "contabilidad/libros/balance-comprobacion", "contabilidad/libros/balance-general", "contabilidad/libros/estado-resultados", "contabilidad/libros/flujo-efectivo"))
                            {
                                <details class="submenu-group">
                                    <summary><span>Libros y estados financieros</span><i>⌄</i></summary>
                                    <div class="submenu">
                                        @if (TienePermiso("contabilidad/libros/plan-cuentas"))
                                        {
                                            <NavLink href="contabilidad/libros/plan-cuentas">Plan de cuentas</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/libros/asientos"))
                                        {
                                            <NavLink href="contabilidad/libros/asientos">Asientos contables</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/libros/libro-diario"))
                                        {
                                            <NavLink href="contabilidad/libros/libro-diario">Libro diario</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/libros/libro-mayor"))
                                        {
                                            <NavLink href="contabilidad/libros/libro-mayor">Libro mayor</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/libros/balance-comprobacion"))
                                        {
                                            <NavLink href="contabilidad/libros/balance-comprobacion">Balance de comprobación</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/libros/balance-general"))
                                        {
                                            <NavLink href="contabilidad/libros/balance-general">Balance general</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/libros/estado-resultados"))
                                        {
                                            <NavLink href="contabilidad/libros/estado-resultados">Estado de resultados</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/libros/flujo-efectivo"))
                                        {
                                            <NavLink href="contabilidad/libros/flujo-efectivo">Flujo de efectivo</NavLink>
                                        }
                                    </div>
                                </details>
                            }

                            @if (TieneAlguno("contabilidad/bancos", "contabilidad/anticipos"))
                            {
                                <details class="submenu-group">
                                    <summary><span>Bancos y anticipos</span><i>⌄</i></summary>
                                    <div class="submenu">
                                        @if (TienePermiso("contabilidad/bancos"))
                                        {
                                            <NavLink href="contabilidad/bancos">Bancos y conciliación</NavLink>
                                        }
                                        @if (TienePermiso("contabilidad/anticipos"))
                                        {
                                            <NavLink href="contabilidad/anticipos">Anticipos</NavLink>
                                        }
                                    </div>
                                </details>
                            }

